+static void expected_pixel_bindings(const NvD3DState *st, ID3D11PixelShader **ps,
+                                    ID3D11SamplerState *samplers[4])
+{
+    unsigned n;
+    *ps=s_psv[(st->flat_shade?1u:0u)|(st->z_perspective?2u:0u)];
+    for(n=0;n<4;n++) {
+        unsigned mode=st->rc_seen?(st->rc.stage_program>>(n*5))&31u:
+                      n==0&&(st->tex_used&1);
+        samplers[n]=s_linear_clamp;
+        if(mode_needs_texture(mode)&&st->tex[n].addr&&st->tex[n].width&&st->tex[n].height)
+            samplers[n]=sampler(&st->tex[n],1,0); /* Fixtures have one guest mip. */
+    }
+}
+static __declspec(noinline) void legacy_pixel_bind(void)
+{
+    ID3D11PixelShader *ps; ID3D11SamplerState *samplers[4];
+    expected_pixel_bindings(pixel_state,&ps,samplers);
+    s_ctx->lpVtbl->PSSetShader(s_ctx,ps,NULL,0);
+    s_ctx->lpVtbl->PSSetSamplers(s_ctx,0,4,samplers);
+}
+/* Independent original setter sequence for these 64x64 fixture states. No
+ * cached pointers or validity bits are used to produce the reference image. */
+static void expected_pipeline(ID3D11RasterizerState **rs, ID3D11BlendState **blend,
+                              ID3D11DepthStencilState **depth, D3D11_RECT *sc,
+                              float factor[4])
+{
+    const NvD3DState *st=pixel_state;
+    *rs=rs_state(0,st->front_face==0x901,0,0);
+    *blend=blend_state(st->blend_enable,st->blend_sfactor,st->blend_dfactor,
+                       st->blend_equation,7); /* Fixture is X8R8G8B8. */
+    *depth=ds_state(st->depth_test,st->depth_func,st->depth_mask,
+                    st->stencil_test,st->stencil_func,st->stencil_func_mask,
+                    st->stencil_write_mask,st->stencil_fail,st->stencil_zfail,st->stencil_zpass);
+    sc->left=sc->top=0; sc->right=sc->bottom=64;
+    if(st->wclip_mask) {
+        sc->left=st->wclip_h[0]&0xFFF; sc->right=(st->wclip_h[0]>>16)+1;
+        sc->top=st->wclip_v[0]&0xFFF; sc->bottom=(st->wclip_v[0]>>16)+1;
+    }
+    memset(factor,0,4*sizeof *factor);
+    if(st->blend_sfactor==0x8001) unpack4(st->blend_color,factor);
+}
+static void legacy_pipeline_bind(void)
+{
+    ID3D11RasterizerState *rs; ID3D11BlendState *blend; ID3D11DepthStencilState *depth;
+    D3D11_RECT sc; float factor[4];
+    expected_pipeline(&rs,&blend,&depth,&sc,factor);
+    s_ctx->lpVtbl->IASetPrimitiveTopology(s_ctx,D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    s_ctx->lpVtbl->RSSetState(s_ctx,rs);
+    s_ctx->lpVtbl->RSSetScissorRects(s_ctx,1,&sc);
+    s_ctx->lpVtbl->OMSetBlendState(s_ctx,blend,factor,0xFFFFFFFF);
+    s_ctx->lpVtbl->OMSetDepthStencilState(s_ctx,depth,pixel_state->stencil_ref&255);
+}
+static void draw_indexed(ID3D11DeviceContext *c, UINT n, UINT start, INT base)
+{
+    if(reference) legacy_bind();
+    if(pixel_reference) legacy_pixel_bind();
+    if(pipeline_reference) legacy_pipeline_bind();
+    draw_calls++; main_indexed_calls++; c->lpVtbl->DrawIndexed(c,n,start,base);
+}
+static void draw_auxiliary(ID3D11DeviceContext *c, UINT n, UINT start)
+{
+    if(s_bound_vs_valid && s_bound_vs==s_ub_vs) {
+        if(reference) legacy_bind();
+        if(pixel_reference) legacy_pixel_bind();
+        if(pipeline_reference) legacy_pipeline_bind();
+        draw_calls++; main_direct_calls++;
+        if(index_reference || reference || pixel_reference || pipeline_reference) {
+            /* Independent original indexed execution with identical vertex
+             * IDs and pipeline. This does not consume the production ring. */
+            if(!identity_reference_ib) {
+                D3D11_BUFFER_DESC desc={0}; D3D11_SUBRESOURCE_DATA data={0}; unsigned i;
+                uint32_t *identity=(uint32_t *)malloc(IB_BYTES); CHECK(identity);
+                for(i=0;i<IB_BYTES/4;i++) identity[i]=i;
+                desc.ByteWidth=IB_BYTES; desc.Usage=D3D11_USAGE_IMMUTABLE;
+                desc.BindFlags=D3D11_BIND_INDEX_BUFFER; data.pSysMem=identity;
+                CHECK(SUCCEEDED(ID3D11Device_CreateBuffer(s_dev,&desc,&data,&identity_reference_ib)));
+                free(identity);
+            }
+            c->lpVtbl->IASetIndexBuffer(c,identity_reference_ib,DXGI_FORMAT_R32_UINT,0);
+            c->lpVtbl->DrawIndexed(c,n,start,0);
+        } else c->lpVtbl->Draw(c,n,start);
+    } else { auxiliary_draw_calls++; c->lpVtbl->Draw(c,n,start); }
+}
