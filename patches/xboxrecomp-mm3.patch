+/* Unit test of nv2a_black_frame.h without D3D: frame statistics, short dark
+ * runs, odd frames (unlike both sides) and repeated pictures. */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define NV2A_BLACK_FRAME_LOGIC_ONLY
+#include "nv2a_black_frame.h"
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); fails++; } } while (0)
+
+typedef struct { uint32_t first, last; float base; } Ev;
+
+/* Feed a luma sequence (mean only; p98 = mean*1.5 clamp; dark frames below 4 get p98 8). */
+static int run(const float *seq, int n, Ev *ev, int max)
+{
+    BfJudge j;
+    int i, k = 0;
+    memset(&j, 0, sizeof j);
+    for (i = 0; i < n; i++) {
+        BfStats st;
+        uint32_t a, b;
+        float base;
+        if (seq[i] < 0) continue;           /* lost sample */
+        st.mean = seq[i];
+        st.p98 = seq[i] < 4 ? 8u : (unsigned)(seq[i] * 1.5f > 255 ? 255 : seq[i] * 1.5f);
+        st.bright = 0;
+        if (bf_feed(&j, (uint32_t)i + 1, &st, &a, &b, &base) && k < max) {
+            ev[k].first = a; ev[k].last = b; ev[k].base = base; k++;
+        }
+    }
+    return k;
+}
+
+static void dark_run_checks(void)
+{
+    float s[400];
+    Ev ev[8];
+    int i, n;
+
+    /* day, two black frames, back to normal */
+    for (i = 0; i < 60; i++) s[i] = 100.0f + (float)(i % 3);
+    s[30] = 1; s[31] = 2;
+    n = run(s, 60, ev, 8);
+    CHECK(n == 1 && ev[0].first == 31 && ev[0].last == 32 && ev[0].base > 99 && ev[0].base < 103,
+          "day black pair: n=%d first=%u last=%u base=%.1f", n, n ? ev[0].first : 0, n ? ev[0].last : 0, n ? ev[0].base : 0);
+
+    /* night baseline 20, one nearly black frame */
+    for (i = 0; i < 60; i++) s[i] = 20;
+    s[40] = 3;
+    n = run(s, 60, ev, 8);
+    CHECK(n == 1 && ev[0].first == 41 && ev[0].last == 41, "night black: n=%d", n);
+
+    /* fade out over 30 frames, 60 black, fade in: nothing */
+    for (i = 0; i < 20; i++) s[i] = 100;
+    for (i = 0; i < 30; i++) s[20 + i] = 100 - i * 100.0f / 30;
+    for (i = 0; i < 60; i++) s[50 + i] = 0;
+    for (i = 0; i < 30; i++) s[110 + i] = i * 100.0f / 30;
+    for (i = 0; i < 40; i++) s[140 + i] = 100;
+    n = run(s, 180, ev, 8);
+    CHECK(n == 0, "fade/loading reported %d (first %u last %u)", n, n ? ev[0].first : 0, n ? ev[0].last : 0);
+
+    /* tunnel 100 -> 25 for 40 frames -> 100: nothing */
+    for (i = 0; i < 20; i++) s[i] = 100;
+    for (i = 0; i < 40; i++) s[20 + i] = 25;
+    for (i = 0; i < 40; i++) s[60 + i] = 100;
+    n = run(s, 100, ev, 8);
+    CHECK(n == 0, "tunnel reported %d", n);
+
+    /* two frames at 30% of a day baseline (tunnel-lit flicker) */
+    for (i = 0; i < 40; i++) s[i] = 90;
+    s[20] = 25; s[21] = 27;
+    n = run(s, 40, ev, 8);
+    CHECK(n == 1 && ev[0].first == 21 && ev[0].last == 22, "relative dark pair: n=%d", n);
+
+    /* dark then only partial recovery: nothing, and detection resumes later */
+    for (i = 0; i < 80; i++) s[i] = 100;
+    s[20] = 2; s[21] = 2; s[22] = 50; s[23] = 52; s[24] = 51; s[25] = 50; s[26] = 52;
+    for (i = 27; i < 80; i++) s[i] = 50;
+    s[60] = 1;
+    n = run(s, 80, ev, 8);
+    CHECK(n == 1 && ev[0].first == 61, "partial recovery: n=%d first=%u base=%.1f", n, n ? ev[0].first : 0, n ? ev[0].base : 0);
+
+    /* black at start, before a baseline exists: nothing */
+    s[0] = 100; s[1] = 100; s[2] = 0; s[3] = 100; s[4] = 100;
+    n = run(s, 5, ev, 8);
+    CHECK(n == 0, "no baseline reported %d", n);
+
+    /* lost samples inside the run */
+    for (i = 0; i < 40; i++) s[i] = 80;
+    s[20] = 1; s[21] = -1; s[22] = 1;
+    n = run(s, 40, ev, 8);
+    CHECK(n == 1 && ev[0].first == 21 && ev[0].last == 23, "gap in run: n=%d %u-%u", n, n ? ev[0].first : 0, n ? ev[0].last : 0);
+
+    /* twelve dark frames still a flicker, thirteen are not */
+    for (i = 0; i < 60; i++) s[i] = 80;
+    for (i = 20; i < 32; i++) s[i] = 1;
+    n = run(s, 60, ev, 8);
+    CHECK(n == 1 && ev[0].last - ev[0].first == 11, "12-frame run: n=%d", n);
+    for (i = 20; i < 33; i++) s[i] = 1;
+    n = run(s, 60, ev, 8);
+    CHECK(n == 0, "13-frame run reported %d", n);
+}
+
+static void stats_checks(void)
+{
+    static uint8_t img[40][64 * 4 + 16];
+    BfStats st;
+    BfSig sig;
+    int x, y;
+    memset(img, 0, sizeof img);
+    bf_stats(&img[0][0], 64, 40, sizeof img[0], &st);
+    CHECK(st.mean == 0 && st.p98 == 0 && st.bright == 0, "black stats %.2f %u %.2f", st.mean, st.p98, st.bright);
+    for (y = 0; y < 40; y++)
+        for (x = 0; x < 32; x++) img[y][x * 4] = img[y][x * 4 + 1] = img[y][x * 4 + 2] = 255;
+    bf_stats(&img[0][0], 64, 40, sizeof img[0], &st);
+    CHECK(st.mean > 126 && st.mean < 128.5f && st.p98 == 255 && st.bright > 0.49f && st.bright < 0.51f,
+          "half white stats %.2f %u %.2f", st.mean, st.p98, st.bright);
+    /* signature: left half white blocks, right half black; padding ignored */
+    bf_signature(&img[0][0], 64, 40, sizeof img[0], &sig);
+    CHECK(sig.c[0] == 255 && sig.c[(7 * 3) + 2] == 255 && sig.c[8 * 3] == 0 && sig.c[(9 * BF_SIG_W + 15) * 3] == 0,
+          "signature halves %u %u %u %u", sig.c[0], sig.c[7 * 3 + 2], sig.c[8 * 3], sig.c[(9 * BF_SIG_W + 15) * 3]);
+    {
+        BfSig black;
+        memset(&black, 0, sizeof black);
+        CHECK(fabsf(bf_sig_diff(&sig, &black) - 127.5f) < 0.01f, "half white vs black %.2f", bf_sig_diff(&sig, &black));
+        CHECK(bf_sig_diff(&sig, &sig) == 0.0f, "self diff");
+    }
+    /* one 4x4 block averaged, not sampled */
+    memset(img, 0, sizeof img);
+    for (y = 0; y < 4; y++)
+        for (x = 0; x < 2; x++) img[y][x * 4 + 2] = 200;
+    bf_signature(&img[0][0], 64, 40, sizeof img[0], &sig);
+    CHECK(sig.c[2] == 100 && sig.c[0] == 0 && sig.c[5] == 0, "block mean red %u", sig.c[2]);
+    memset(img, 0, sizeof img);
+    for (y = 0; y < 40; y++)
+        for (x = 0; x < 64; x++) img[y][x * 4 + 2] = 200;   /* red 200 */
+    bf_stats(&img[0][0], 64, 40, sizeof img[0], &st);
+    CHECK(st.mean > 41 && st.mean < 43 && st.p98 == 42, "red stats %.2f %u", st.mean, st.p98);
+    /* 1% bright pixels do not lift p98 */
+    memset(img, 0, sizeof img);
+    for (x = 0; x < 25; x++) img[0][x * 4 + 1] = 255;
+    bf_stats(&img[0][0], 64, 40, sizeof img[0], &st);
+    CHECK(st.p98 == 0, "sparse bright p98 %u", st.p98);
+}
+
+static uint8_t clamp8(float v) { return (uint8_t)(v < 0.0f ? 0.0f : v > 255.0f ? 255.0f : v + 0.5f); }
+
+/* A street scrolling past at `speed` blocks per frame; `place` picks the street. */
+static void street(BfSig *s, float t, float speed, int place)
+{
+    unsigned bx, by;
+    for (by = 0; by < BF_SIG_H; by++)
+        for (bx = 0; bx < BF_SIG_W; bx++) {
+            float x = (float)bx + t * speed;
+            float v = 60.0f + 40.0f * sinf(x * 0.9f + (float)place * 1.7f) +
+                      30.0f * cosf((float)by * 0.7f + x * 0.3f + (float)place);
+            uint8_t *c = s->c + (by * BF_SIG_W + bx) * 3;
+            c[0] = clamp8(v * 0.8f); c[1] = clamp8(v); c[2] = clamp8(v * 1.1f);
+        }
+}
+
+typedef struct { int kind; BfOddEvent ev; } OddHit;
+
+/* Feed frames 1..n; NULL entries are lost samples. */
+static int odd_run(BfSig *const *frames, int n, OddHit *hit, int max)
+{
+    BfOdd o;
+    int i, k = 0;
+    memset(&o, 0, sizeof o);
+    for (i = 0; i < n; i++) {
+        BfOddEvent ev;
+        int kind;
+        if (!frames[i]) continue;
+        kind = bf_odd_feed(&o, (uint32_t)i + 1, frames[i], &ev);
+        if (kind != BF_ODD_NONE && k < max) { hit[k].kind = kind; hit[k].ev = ev; k++; }
+    }
+    return k;
+}
+
+#define NF 240
+static BfSig g_sig[NF], g_spare[8];
+static BfSig *g_frames[NF];
+
+/* Frame i (0-based) of a drive at `speed`; frame number is i + 1. */
+static void drive(float speed, int place)
+{
+    int i;
+    for (i = 0; i < NF; i++) { street(&g_sig[i], (float)i, speed, place); g_frames[i] = &g_sig[i]; }
+}
+
+static void odd_checks(void)
+{
+    OddHit hit[16];
+    int n, i;
+    float step;
+
+    /* smooth driving, slow and fast: nothing */
+    drive(0.05f, 0);
+    step = bf_sig_diff(&g_sig[100], &g_sig[101]);
+    CHECK(step > 0.3f && step < 4.0f, "slow street step %.2f", step);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "slow drive reported %d (kind %d first %u)", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0);
+    drive(0.4f, 1);
+    step = bf_sig_diff(&g_sig[100], &g_sig[101]);
+    CHECK(step > 5.0f, "fast street step %.2f", step);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "fast drive reported %d (kind %d first %u)", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0);
+
+    /* one black frame while driving slowly */
+    drive(0.05f, 0);
+    memset(&g_spare[0], 0, sizeof g_spare[0]);
+    g_frames[100] = &g_spare[0];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_RUN && hit[0].ev.first == 101 && hit[0].ev.last == 101 &&
+          hit[0].ev.into > 20.0f && hit[0].ev.around < 4.0f,
+          "black frame: n=%d kind=%d %u-%u into %.1f around %.1f", n, n ? hit[0].kind : 0,
+          n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0, n ? hit[0].ev.into : 0, n ? hit[0].ev.around : 0);
+
+    /* and in a fast turn, where the frames either side differ a lot too */
+    drive(0.4f, 1);
+    g_frames[100] = &g_spare[0];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_RUN && hit[0].ev.first == 101 && hit[0].ev.around > 5.0f,
+          "black frame at speed: n=%d kind=%d first=%u around %.1f", n, n ? hit[0].kind : 0,
+          n ? hit[0].ev.first : 0, n ? hit[0].ev.around : 0);
+
+    /* a stale picture from 40 frames back, at speed */
+    drive(0.25f, 2);
+    g_frames[150] = &g_sig[110];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_RUN && hit[0].ev.first == 151 && hit[0].ev.last == 151,
+          "stale frame: n=%d kind=%d %u-%u", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0);
+
+    /* two wrongly tinted frames */
+    drive(0.05f, 3);
+    for (i = 0; i < 2; i++) {
+        unsigned b;
+        g_spare[i] = g_sig[120 + i];
+        for (b = 0; b < BF_SIG_BYTES; b += 3) { g_spare[i].c[b] = clamp8(g_spare[i].c[b] * 0.3f); g_spare[i].c[b + 2] = clamp8(g_spare[i].c[b + 2] + 60.0f); }
+        g_frames[120 + i] = &g_spare[i];
+    }
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_RUN && hit[0].ev.first == 121 && hit[0].ev.last == 122,
+          "tinted pair: n=%d kind=%d %u-%u", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0);
+
+    /* a camera cut to another street is not odd */
+    drive(0.05f, 0);
+    for (i = 130; i < NF; i++) street(&g_sig[i], (float)i, 0.05f, 5);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "camera cut reported %d", n);
+    /* two cuts in a row: the one frame between them is unlike both sides,
+     * but so are the sides from each other */
+    street(&g_sig[130], 130.0f, 0.05f, 6);
+    for (i = 131; i < NF; i++) street(&g_sig[i], (float)i, 0.05f, 8);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "quick double cut reported %d (%u-%u)", n, n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0);
+
+    /* a picture shown again once, then three more times */
+    drive(0.1f, 4);
+    g_frames[100] = &g_sig[99];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_REPEAT && hit[0].ev.first == 101 && hit[0].ev.last == 101 &&
+          hit[0].ev.around < 0.3f && hit[0].ev.into > 0.8f,
+          "repeat once: n=%d kind=%d %u-%u", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0);
+    drive(0.1f, 4);
+    g_frames[100] = g_frames[101] = g_frames[102] = &g_sig[99];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_REPEAT && hit[0].ev.first == 101 && hit[0].ev.last == 103,
+          "held 3 more: n=%d kind=%d %u-%u", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0);
+
+    /* a still scene (menu, pause): no repeats, a lone flash is odd */
+    for (i = 0; i < NF; i++) g_frames[i] = &g_sig[0];
+    street(&g_sig[0], 0.0f, 0.0f, 6);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "still scene reported %d", n);
+    g_spare[0] = g_sig[0];
+    for (i = 0; i < BF_SIG_BYTES; i++) g_spare[0].c[i] = clamp8(g_spare[0].c[i] + 90.0f);
+    g_frames[100] = &g_spare[0];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_RUN && hit[0].ev.first == 101, "flash in still scene: n=%d", n);
+
+    /* a lost sample restarts the window instead of comparing across it */
+    drive(0.05f, 0);
+    g_frames[100] = NULL;
+    for (i = 101; i < 104; i++) street(&g_sig[i], (float)i + 60.0f, 0.05f, 0);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "lost sample reported %d", n);
+
+    /* a 30 Hz cadence (each picture twice) shows as repeated pictures */
+    drive(0.1f, 7);
+    for (i = 1; i < NF; i += 2) g_frames[i] = &g_sig[i - 1];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 16 && hit[0].kind == BF_ODD_REPEAT, "30 Hz cadence: n=%d kind=%d", n, n ? hit[0].kind : 0);
+
+    /* a run longer than BF_ODD_MAX is a scene of its own, not reported */
+    drive(0.05f, 0);
+    memset(&g_spare[0], 0, sizeof g_spare[0]);
+    for (i = 100; i < 104; i++) g_frames[i] = &g_spare[0];
+    n = odd_run(g_frames, NF, hit, 16);
+    for (i = 0; i < n; i++)
+        CHECK(hit[i].kind != BF_ODD_RUN, "4-frame black run reported as odd %u-%u", hit[i].ev.first, hit[i].ev.last);
+
+    /* at speed, the world held for a frame while one HUD block still changed */
+    drive(0.4f, 1);
+    g_spare[0] = g_sig[99];
+    for (i = 0; i < 3; i++) g_spare[0].c[(9 * BF_SIG_W + 15) * 3 + i] = clamp8(g_spare[0].c[(9 * BF_SIG_W + 15) * 3 + i] + 60.0f);
+    g_frames[100] = &g_spare[0];
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].kind == BF_ODD_REPEAT && hit[0].ev.first == 101 && hit[0].ev.last == 101 &&
+          hit[0].ev.around > 0.3f,
+          "held world, moving HUD: n=%d kind=%d %u-%u around %.2f scale %.2f", n, n ? hit[0].kind : 0,
+          n ? hit[0].ev.first : 0, n ? hit[0].ev.last : 0, n ? hit[0].ev.around : 0, n ? hit[0].ev.scale : 0);
+    /* while a slow drive's ordinary small steps are not taken for one */
+    drive(0.02f, 2);
+    n = odd_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "crawl reported %d (kind %d first %u)", n, n ? hit[0].kind : 0, n ? hit[0].ev.first : 0);
+}
+
+static int local_run(BfSig *const *frames, int n, BfLocalEvent *hit, int max)
+{
+    BfLocal l;
+    int i, k = 0;
+    memset(&l, 0, sizeof l);
+    for (i = 0; i < n; i++) {
+        BfLocalEvent ev;
+        if (!frames[i]) continue;
+        if (bf_local_feed(&l, (uint32_t)i + 1, frames[i], &ev) && k < max) hit[k++] = ev;
+    }
+    return k;
+}
+
+/* Blocks x0..x1 by y0..y1 of s in one grey. */
+static void paint(BfSig *s, unsigned x0, unsigned y0, unsigned x1, unsigned y1, uint8_t v)
+{
+    unsigned x, y;
+    for (y = y0; y <= y1; y++)
+        for (x = x0; x <= x1; x++) {
+            uint8_t *c = s->c + (y * BF_SIG_W + x) * 3;
+            c[0] = c[1] = c[2] = v;
+        }
+}
+
+static void local_checks(void)
+{
+    BfLocalEvent hit[16];
+    int n, i;
+    float speeds[3] = { 0.05f, 0.4f, 0.9f };
+
+    /* driving at any speed, and a still scene: nothing */
+    for (i = 0; i < 3; i++) {
+        drive(speeds[i], i);
+        n = local_run(g_frames, NF, hit, 16);
+        CHECK(n == 0, "drive at %.2f: %d local flashes (first %u, %u blocks)", speeds[i], n,
+              n ? hit[0].frame : 0, n ? hit[0].blocks : 0);
+    }
+    for (i = 0; i < NF; i++) g_frames[i] = &g_sig[0];
+    street(&g_sig[0], 0.0f, 0.0f, 6);
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "still scene: %d local flashes", n);
+
+    /* a building, 3x3 blocks, gone for one frame while driving slowly */
+    drive(0.05f, 3);
+    g_spare[0] = g_sig[120];
+    paint(&g_spare[0], 5, 1, 7, 3, 235);
+    g_frames[120] = &g_spare[0];
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].frame == 121 && hit[0].blocks == 9 && hit[0].x0 == 5 && hit[0].x1 == 7 &&
+          hit[0].y0 == 1 && hit[0].y1 == 3 && hit[0].strength > 60.0f,
+          "building gone: n=%d frame %u blocks %u box %u,%u-%u,%u strength %.1f", n, n ? hit[0].frame : 0,
+          n ? hit[0].blocks : 0, n ? hit[0].x0 : 0, n ? hit[0].y0 : 0, n ? hit[0].x1 : 0, n ? hit[0].y1 : 0,
+          n ? hit[0].strength : 0);
+
+    /* two blocks are too few; a lamp lit for three frames is no flash */
+    drive(0.05f, 3);
+    g_spare[0] = g_sig[120];
+    paint(&g_spare[0], 5, 1, 6, 1, 235);
+    g_frames[120] = &g_spare[0];
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "two blocks reported %d", n);
+    drive(0.05f, 3);
+    for (i = 0; i < 3; i++) {
+        g_spare[i] = g_sig[120 + i];
+        paint(&g_spare[i], 2, 6, 4, 7, 250);
+        g_frames[120 + i] = &g_spare[i];
+    }
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "three-frame lamp reported %d (frame %u)", n, n ? hit[0].frame : 0);
+
+    /* a dark hole in a still scene, and one across a lost sample */
+    for (i = 0; i < NF; i++) g_frames[i] = &g_sig[0];
+    street(&g_sig[0], 0.0f, 0.0f, 6);
+    g_spare[0] = g_sig[0];
+    paint(&g_spare[0], 10, 4, 11, 5, 0);
+    g_frames[60] = &g_spare[0];
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 1 && hit[0].frame == 61 && hit[0].blocks == 4, "hole in still scene: n=%d frame %u blocks %u",
+          n, n ? hit[0].frame : 0, n ? hit[0].blocks : 0);
+    g_frames[59] = NULL;
+    n = local_run(g_frames, NF, hit, 16);
+    CHECK(n == 0, "flash after a lost sample reported %d", n);
+}
+
+/* A night drive's light pass: lights enter and leave a few at a time, the
+ * volume draws are batched 2..4 per flip, one composite, two depth copies,
+ * and the volumes move steadily. */
+#define NL 200
+static BfLightPass g_lp[NL + 1];
+static int g_lp_skip[NL + 1];
+
+static void night(void)
+{
+    int t;
+    for (t = 1; t <= NL; t++) {
+        BfLightPass *p = &g_lp[t];
+        p->indices = 12600u + 36u * (uint32_t)(10.0 + 10.0 * sin(t / 40.0));
+        p->draws = 2u + (uint32_t)(t % 3);
+        p->screen = p->draws;
+        p->composites = 1;
+        p->views = 2;
+        p->where = 500.0f + 0.3f * (float)t;
+        g_lp_skip[t] = 0;
+    }
+}
+
+static int light_run(BfLightEvent *hit, int max)
+{
+    BfLight l;
+    BfLightEvent ev;
+    int t, n = 0;
+    memset(&l, 0, sizeof l);
+    for (t = 1; t <= NL; t++) {
+        if (g_lp_skip[t]) continue;
+        memset(&ev, 0, sizeof ev);
+        if (bf_light_feed(&l, (uint32_t)t, &g_lp[t], &ev) && n < max) hit[n++] = ev;
+    }
+    return n;
+}
+
+static void light_checks(void)
+{
+    BfLightEvent hit[8];
+    int n, t;
+    night();
+    n = light_run(hit, 8);
+    CHECK(n == 0, "steady night drive: %d light events (first at %u)", n, n ? hit[0].first : 0);
+    /* one flip drawn with a third of its lights missing (run 013150 flip 2217) */
+    night();
+    g_lp[120].indices = g_lp[120].indices * 2 / 3;
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 120 && hit[0].last == 120 && hit[0].why == BF_LIGHT_COUNT &&
+          hit[0].odd.indices < hit[0].before.indices,
+          "missing lights: n=%d first %u why %u", n, n ? hit[0].first : 0, n ? hit[0].why : 0);
+    /* two flips in a row with extra lights */
+    night();
+    g_lp[160].indices += 4000;
+    g_lp[161].indices += 3800;
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 160 && hit[0].last == 161 && (hit[0].why & BF_LIGHT_COUNT),
+          "two flips of extra lights: n=%d first %u last %u", n, n ? hit[0].first : 0, n ? hit[0].last : 0);
+    /* the light buffer not laid over one frame */
+    night();
+    g_lp[90].composites = 0;
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 90 && hit[0].why == BF_LIGHT_COMPOSITE,
+          "missing composite: n=%d first %u why %u", n, n ? hit[0].first : 0, n ? hit[0].why : 0);
+    /* one volume draw without the screen blend */
+    night();
+    g_lp[70].screen = g_lp[70].draws - 1;
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 70 && hit[0].why == BF_LIGHT_BLEND,
+          "blend change: n=%d first %u why %u", n, n ? hit[0].first : 0, n ? hit[0].why : 0);
+    /* the same lights drawn elsewhere for a flip */
+    night();
+    for (t = 139; t <= 143; t++) g_lp[t].indices = 12960;
+    g_lp[141].where += 50.0f;
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 141 && hit[0].why == BF_LIGHT_WHERE,
+          "moved lights: n=%d first %u why %u", n, n ? hit[0].first : 0, n ? hit[0].why : 0);
+    /* lights fading out over half a second into a darker street */
+    night();
+    for (t = 100; t <= NL; t++) g_lp[t].indices = (uint32_t)(12600.0 * pow(0.98, t - 100 < 30 ? t - 100 : 30));
+    n = light_run(hit, 8);
+    CHECK(n == 0, "gradual fade reported %d (first %u)", n, n ? hit[0].first : 0);
+    /* no light pass at all (menus), then it starts */
+    night();
+    for (t = 1; t <= 100; t++) memset(&g_lp[t], 0, sizeof g_lp[t]);
+    n = light_run(hit, 8);
+    CHECK(n == 0, "light pass starting reported %d (first %u)", n, n ? hit[0].first : 0);
+    /* an odd flip right after a lost sample is not judged */
+    night();
+    g_lp[120].indices /= 2;
+    g_lp_skip[119] = 1;
+    n = light_run(hit, 8);
+    CHECK(n == 0, "odd flip after a gap reported %d", n);
+    /* a camera cut: the light count steps down over two flips */
+    night();
+    for (t = 120; t <= NL; t++) g_lp[t].indices = t == 120 ? 10000u : 7000u;
+    n = light_run(hit, 8);
+    CHECK(n == 0, "camera cut reported %d (first %u)", n, n ? hit[0].first : 0);
+    /* the whole light pass missing for one flip */
+    night();
+    memset(&g_lp[150], 0, sizeof g_lp[150]);
+    n = light_run(hit, 8);
+    CHECK(n == 1 && hit[0].first == 150 && (hit[0].why & BF_LIGHT_COUNT) && (hit[0].why & BF_LIGHT_COMPOSITE),
+          "missing light pass: n=%d first %u why %u", n, n ? hit[0].first : 0, n ? hit[0].why : 0);
+    /* one flip with a light pass among menu flips without one */
+    memset(g_lp, 0, sizeof g_lp);
+    g_lp[50] = (BfLightPass){ 3, 12600, 3, 1, 2, 500.0f };
+    n = light_run(hit, 8);
+    CHECK(n == 0, "lone light pass in a menu reported %d", n);
+}
+
+int main(void)
+{
+    dark_run_checks();
+    stats_checks();
+    odd_checks();
+    local_checks();
+    light_checks();
+    printf(fails ? "%d FAILED\n" : "all black/odd-frame logic checks passed\n", fails);
+    return fails != 0;
+}
