index 0000000..678ef13
--- /dev/null
+++ b/src/kernel/guest_write_watch.c
@@ -0,0 +1,438 @@
+/* Write stamps for guest pages of the contiguous window; see the header. */
+#include "kernel.h"
+#include "guest_write_watch.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+
+#define GWW_PAGE 4096u
+#define F_ARMED    1u   /* read-only because of us; the next write faults */
+#define F_EXCLUDED 2u   /* the guest asked for another protection: never arm */
+
+static int s_active;
+static uint32_t s_guest;                 /* guest VA of page 0 */
+static uint8_t *s_contig, *s_tiled;      /* host views of the same pages */
+static uint8_t *s_writer;                /* a third view, never protected */
+static size_t s_pages, s_tiled_pages;
+static uint64_t *s_stamp;                /* clock value of the last write */
+static uint8_t *s_flags;
+static uint16_t *s_pins;                 /* kernel-mode writes in progress */
+static uint64_t s_clock;
+/* Arming, stamping and checking are serialised. Nothing done while holding
+ * it writes guest memory, so a fault never arrives on a thread that owns it. */
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static volatile LONG64 s_faults, s_armed_pages;
+static INIT_ONCE s_handler_once = INIT_ONCE_STATIC_INIT;
+static PVOID s_handler;
+
+static int host_page(uintptr_t a, size_t *page)
+{
+    uintptr_t base = (uintptr_t)s_contig;
+    if (a >= base && a - base < s_pages * GWW_PAGE) {
+        *page = (a - base) / GWW_PAGE;
+        return 1;
+    }
+    base = (uintptr_t)s_tiled;
+    if (s_tiled && a >= base && a - base < s_tiled_pages * GWW_PAGE) {
+        *page = (a - base) / GWW_PAGE;
+        return 1;
+    }
+    return 0;
+}
+
+/* Pages [first, first + count) on every host view that maps them. */
+static int protect_pages(size_t first, size_t count, DWORD protect)
+{
+    DWORD old;
+    if (!VirtualProtect(s_contig + first * GWW_PAGE, count * GWW_PAGE, protect, &old))
+        return 0;
+    if (s_tiled && first < s_tiled_pages) {
+        size_t n = s_tiled_pages - first < count ? s_tiled_pages - first : count;
+        if (!VirtualProtect(s_tiled + first * GWW_PAGE, n * GWW_PAGE, protect, &old)) {
+            if (protect != PAGE_READWRITE)
+                VirtualProtect(s_contig + first * GWW_PAGE, count * GWW_PAGE,
+                               PAGE_READWRITE, &old);
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static LONG CALLBACK gww_fault(PEXCEPTION_POINTERS ep)
+{
+    const EXCEPTION_RECORD *er = ep->ExceptionRecord;
+    uintptr_t address;
+    size_t page;
+    LONG result = EXCEPTION_CONTINUE_SEARCH;
+    if (er->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || er->NumberParameters < 2 ||
+        er->ExceptionInformation[0] != 1)
+        return EXCEPTION_CONTINUE_SEARCH;
+    address = (uintptr_t)er->ExceptionInformation[1];
+    if (!host_page(address, &page))
+        return EXCEPTION_CONTINUE_SEARCH;
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_flags[page] & F_ARMED) {
+        /* Writable first, then stamped: see the header. */
+        if (protect_pages(page, 1, PAGE_READWRITE)) {
+            s_flags[page] &= (uint8_t)~F_ARMED;
+            s_stamp[page] = ++s_clock;
+            InterlockedIncrement64(&s_faults);
+            result = EXCEPTION_CONTINUE_EXECUTION;
+        }
+    } else {
+        /* Another thread's fault opened the page first: retry the write.
+         * A page that is still not writable is not ours to open. */
+        MEMORY_BASIC_INFORMATION mbi;
+        if (VirtualQuery((LPCVOID)address, &mbi, sizeof mbi) &&
+            ((mbi.Protect & 0xFFu) == PAGE_READWRITE ||
+             (mbi.Protect & 0xFFu) == PAGE_EXECUTE_READWRITE))
+            result = EXCEPTION_CONTINUE_EXECUTION;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return result;
+}
+
+/* Installed by the first arm, so it runs ahead of handlers registered
+ * during start-up; it passes on every fault outside the watched pages. */
+static BOOL CALLBACK install_handler(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    (void)once; (void)parameter; (void)context;
+    s_handler = AddVectoredExceptionHandler(1, gww_fault);
+    if (!s_handler) {
+        fprintf(stderr, "  Texture write watch: no exception handler (error %lu); hashing every check\n",
+                GetLastError());
+        s_active = 0;
+    }
+    return TRUE;
+}
+
+static int guest_span(const GwwRange *r, size_t *first, size_t *last)
+{
+    uint64_t offset;
+    if (!r->bytes || r->va < s_guest) return 0;
+    offset = (uint64_t)r->va - s_guest;
+    if (offset + r->bytes > (uint64_t)s_pages * GWW_PAGE) return 0;
+    *first = (size_t)(offset / GWW_PAGE);
+    *last = (size_t)((offset + r->bytes - 1) / GWW_PAGE);
+    return 1;
+}
+
+/* The part of [a, a + bytes) inside one view, as page indices. */
+static int view_span(const uint8_t *view, size_t pages, uintptr_t a, size_t bytes,
+                     size_t *first, size_t *last)
+{
+    uintptr_t lo = (uintptr_t)view, hi, end = a + bytes;
+    if (!view || !bytes || end < a) return 0;
+    hi = lo + pages * GWW_PAGE;
+    if (end <= lo || a >= hi) return 0;
+    if (a < lo) a = lo;
+    if (end > hi) end = hi;
+    *first = (a - lo) / GWW_PAGE;
+    *last = (end - 1 - lo) / GWW_PAGE;
+    return 1;
+}
+
+/* Disarm and stamp pages a host writer is about to change. Lock held. */
+static void open_pages(size_t first, size_t last, int pin, int exclude)
+{
+    size_t p = first, q, k;
+    while (p <= last) {
+        if (!(s_flags[p] & F_ARMED)) { ++p; continue; }
+        for (q = p; q < last && (s_flags[q + 1] & F_ARMED); ++q) {}
+        if (protect_pages(p, q - p + 1, PAGE_READWRITE))
+            for (k = p; k <= q; ++k) s_flags[k] &= (uint8_t)~F_ARMED;
+        p = q + 1;
+    }
+    for (p = first; p <= last; ++p) {
+        s_stamp[p] = ++s_clock;
+        if (pin > 0 && s_pins[p] < 0xFFFFu) ++s_pins[p];
+        else if (pin < 0 && s_pins[p]) --s_pins[p];
+        if (exclude) s_flags[p] |= F_EXCLUDED;
+    }
+}
+
+static void open_host(const void *host, size_t bytes, int pin, int exclude)
+{
+    size_t first, last;
+    uintptr_t a = (uintptr_t)host;
+    if (!s_active) return;
+    AcquireSRWLockExclusive(&s_lock);
+    if (view_span(s_contig, s_pages, a, bytes, &first, &last))
+        open_pages(first, last, pin, exclude);
+    if (view_span(s_tiled, s_tiled_pages, a, bytes, &first, &last))
+        open_pages(first, last, pin, exclude);
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+int gww_covers(uint32_t va, uint32_t bytes)
+{
+    GwwRange r;
+    size_t first, last;
+    r.va = va; r.bytes = bytes;
+    return s_active && guest_span(&r, &first, &last);
+}
+
+uint64_t gww_arm(const GwwRange *ranges, int count, int *complete)
+{
+    uint64_t seq;
+    int ok = 1, i;
+    *complete = 0;
+    if (!s_active) return 0;
+    InitOnceExecuteOnce(&s_handler_once, install_handler, NULL, NULL);
+    if (!s_handler) return 0;
+    AcquireSRWLockExclusive(&s_lock);
+    seq = s_clock;
+    for (i = 0; i < count; ++i) {
+        size_t first, last, p, q, k;
+        if (!guest_span(&ranges[i], &first, &last)) { ok = 0; continue; }
+        for (p = first; p <= last; p = q + 1) {
+            q = p;
+            if (s_flags[p] & F_ARMED) continue;
+            if ((s_flags[p] & F_EXCLUDED) || s_pins[p]) { ok = 0; continue; }
+            while (q < last && !(s_flags[q + 1] & (F_ARMED | F_EXCLUDED)) && !s_pins[q + 1])
+                ++q;
+            if (protect_pages(p, q - p + 1, PAGE_READONLY)) {
+                for (k = p; k <= q; ++k) s_flags[k] |= F_ARMED;
+                InterlockedAdd64(&s_armed_pages, (LONG64)(q - p + 1));
+            } else {
+                ok = 0;
+            }
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    *complete = ok;
+    return seq;
+}
+
+int gww_clean(const GwwRange *ranges, int count, uint64_t since)
+{
+    int ok = s_active, i;
+    if (!ok) return 0;
+    AcquireSRWLockShared(&s_lock);
+    for (i = 0; ok && i < count; ++i) {
+        size_t first, last, p;
+        if (!guest_span(&ranges[i], &first, &last)) { ok = 0; break; }
+        for (p = first; p <= last; ++p)
+            if (!(s_flags[p] & F_ARMED) || s_stamp[p] > since) { ok = 0; break; }
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return ok;
+}
+
+void gww_stats(uint64_t *faults, uint64_t *armed_pages)
+{
+    if (faults) *faults = (uint64_t)s_faults;
+    if (armed_pages) *armed_pages = (uint64_t)s_armed_pages;
+}
+
+void gww_host_write(const void *host, size_t bytes) { open_host(host, bytes, 0, 0); }
+void gww_host_write_begin(const void *host, size_t bytes) { open_host(host, bytes, 1, 0); }
+void gww_host_write_end(const void *host, size_t bytes) { open_host(host, bytes, -1, 0); }
+
+int gww_virtual_protect(void *host, size_t bytes, unsigned long protect, unsigned long *old)
+{
+    DWORD previous = 0;
+    BOOL ok;
+    size_t first, last;
+    uintptr_t a = (uintptr_t)host;
+    /* Arming swaps read-write for read-only and back, so only plain
+     * read-write pages can stay watched. */
+    int plain = protect == PAGE_READWRITE || protect == PAGE_EXECUTE_READWRITE;
+    if (!s_active) {
+        ok = VirtualProtect(host, bytes, (DWORD)protect, &previous);
+        if (old) *old = previous;
+        return ok != 0;
+    }
+    AcquireSRWLockExclusive(&s_lock);
+    /* Restoring read-write first also makes the reported old protection the
+     * one the guest set, not the watch's read-only. */
+    if (view_span(s_contig, s_pages, a, bytes, &first, &last))
+        open_pages(first, last, 0, !plain);
+    if (view_span(s_tiled, s_tiled_pages, a, bytes, &first, &last))
+        open_pages(first, last, 0, !plain);
+    ok = VirtualProtect(host, bytes, (DWORD)protect, &previous);
+    ReleaseSRWLockExclusive(&s_lock);
+    if (old) *old = previous;
+    return ok != 0;
+}
+
+unsigned long gww_logical_protect(const void *host, unsigned long protect)
+{
+    size_t page;
+    int armed = 0;
+    if (!s_active || (protect & 0xFFu) != PAGE_READONLY) return protect;
+    AcquireSRWLockShared(&s_lock);
+    if (host_page((uintptr_t)host, &page)) armed = (s_flags[page] & F_ARMED) != 0;
+    ReleaseSRWLockShared(&s_lock);
+    return armed ? (protect & ~0xFFul) | PAGE_READWRITE : protect;
+}
+
+int gww_range_armed(const void *host, size_t bytes)
+{
+    uintptr_t a = (uintptr_t)host, end = a + bytes, cursor;
+    int ok = 1;
+    if (!s_active || !bytes || end < a) return 0;
+    AcquireSRWLockShared(&s_lock);
+    /* Page by page: a range may cross from one view's end into memory that
+     * is not watched at all. */
+    for (cursor = a & ~(uintptr_t)(GWW_PAGE - 1); ok && cursor < end; cursor += GWW_PAGE) {
+        size_t page;
+        ok = host_page(cursor, &page) && (s_flags[page] & F_ARMED);
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return ok;
+}
+
+uint8_t *gww_host_writer(uint32_t va, uint32_t bytes)
+{
+    GwwRange r;
+    size_t first, last, p;
+    int ok = 1;
+    r.va = va; r.bytes = bytes;
+    if (!s_active || !s_writer || !guest_span(&r, &first, &last)) return NULL;
+    AcquireSRWLockShared(&s_lock);
+    /* A page the guest protected keeps its own behaviour: write it through
+     * the guest's view, as before the watch. */
+    for (p = first; p <= last; ++p)
+        if (s_flags[p] & F_EXCLUDED) { ok = 0; break; }
+    ReleaseSRWLockShared(&s_lock);
+    return ok ? s_writer + ((size_t)va - s_guest) : NULL;
+}
+
+uint64_t gww_host_wrote(const GwwRange *ranges, int count, uint64_t prior, int *still_clean)
+{
+    uint64_t seq;
+    int still = s_active, i;
+    if (!s_active) { *still_clean = 0; return 0; }
+    AcquireSRWLockExclusive(&s_lock);
+    /* Judge and stamp under one lock: a CPU write either faulted before
+     * (still_clean is 0) or stamps after the returned snapshot. */
+    for (i = 0; i < count; ++i) {
+        size_t first, last, p;
+        if (!guest_span(&ranges[i], &first, &last)) { still = 0; continue; }
+        for (p = first; p <= last; ++p)
+            if (!(s_flags[p] & F_ARMED) || s_stamp[p] > prior) still = 0;
+    }
+    for (i = 0; i < count; ++i) {
+        size_t first, last, p;
+        if (!guest_span(&ranges[i], &first, &last)) continue;
+        for (p = first; p <= last; ++p) s_stamp[p] = ++s_clock;
+    }
+    seq = s_clock;
+    ReleaseSRWLockExclusive(&s_lock);
+    *still_clean = still;
+    return seq;
+}
+
+static const GwwOps s_ops = { gww_covers, gww_arm, gww_clean, gww_stats,
+                              gww_host_writer, gww_host_wrote };
+
+const GwwOps *gww_ops(void)
+{
+    return s_active ? &s_ops : NULL;
+}
+
+int gww_init(uint32_t contig_guest, void *contig_host, size_t contig_bytes,
+             void *tiled_host, size_t tiled_bytes, void *section)
+{
+    const char *setting = getenv("RECOMP_TEXTURE_WATCH");
+    SYSTEM_INFO si;
+    volatile uint8_t *probe_guest, *probe_writer;
+    uint8_t saved;
+    if (s_active) return 1;
+    if (setting && !strcmp(setting, "0")) {
+        fprintf(stderr, "  Texture write watch: off (RECOMP_TEXTURE_WATCH=0)\n");
+        return 0;
+    }
+    GetSystemInfo(&si);
+    if (!contig_host || !section || contig_bytes < GWW_PAGE || si.dwPageSize != GWW_PAGE ||
+        ((uintptr_t)contig_host | (uintptr_t)tiled_host) & (GWW_PAGE - 1))
+        return 0;
+    /* The renderer's writer view. Prove it aliases the guest's view (one
+     * byte, restored) rather than assume it. */
+    s_writer = (uint8_t *)MapViewOfFile((HANDLE)section, FILE_MAP_ALL_ACCESS, 0, 0, contig_bytes);
+    if (!s_writer) {
+        fprintf(stderr, "  Texture write watch: no writer view (error %lu); off\n", GetLastError());
+        return 0;
+    }
+    probe_guest = (volatile uint8_t *)contig_host + 8;
+    probe_writer = (volatile uint8_t *)s_writer + 8;
+    saved = *probe_guest;
+    *probe_writer = (uint8_t)(saved ^ 0xA5u);
+    if (*probe_guest != (uint8_t)(saved ^ 0xA5u)) {
+        *probe_writer = saved;
+        UnmapViewOfFile(s_writer);
+        s_writer = NULL;
+        fprintf(stderr, "  Texture write watch: writer view does not alias the window; off\n");
+        return 0;
+    }
+    *probe_writer = saved;
+    s_pages = contig_bytes / GWW_PAGE;
+    s_stamp = (uint64_t *)calloc(s_pages, sizeof *s_stamp);
+    s_flags = (uint8_t *)calloc(s_pages, sizeof *s_flags);
+    s_pins = (uint16_t *)calloc(s_pages, sizeof *s_pins);
+    if (!s_stamp || !s_flags || !s_pins) {
+        free(s_stamp); free(s_flags); free(s_pins);
+        s_stamp = NULL; s_flags = NULL; s_pins = NULL;
+        UnmapViewOfFile(s_writer);
+        s_writer = NULL;
+        return 0;
+    }
+    s_guest = contig_guest;
+    s_contig = (uint8_t *)contig_host;
+    s_tiled = tiled_host && tiled_bytes >= GWW_PAGE ? (uint8_t *)tiled_host : NULL;
+    s_tiled_pages = s_tiled ? (tiled_bytes / GWW_PAGE < s_pages ? tiled_bytes / GWW_PAGE : s_pages) : 0;
+    s_active = 1;
+    fprintf(stderr, "  Texture write watch: %zu pages at 0x%08X (contiguous %p, tiled alias %p, writer %p)\n",
+            s_pages, contig_guest, (void *)s_contig, (void *)s_tiled, (void *)s_writer);
+    return 1;
+}
+
+#else /* Not on this host: every check reads the bytes, as before. */
+
+int gww_init(uint32_t contig_guest, void *contig_host, size_t contig_bytes,
+             void *tiled_host, size_t tiled_bytes, void *section)
+{
+    (void)contig_guest; (void)contig_host; (void)contig_bytes;
+    (void)tiled_host; (void)tiled_bytes; (void)section;
+    return 0;
+}
+uint8_t *gww_host_writer(uint32_t va, uint32_t bytes) { (void)va; (void)bytes; return NULL; }
+uint64_t gww_host_wrote(const GwwRange *ranges, int count, uint64_t prior, int *still_clean)
+{
+    (void)ranges; (void)count; (void)prior; *still_clean = 0; return 0;
+}
+const GwwOps *gww_ops(void) { return NULL; }
+int gww_covers(uint32_t va, uint32_t bytes) { (void)va; (void)bytes; return 0; }
+uint64_t gww_arm(const GwwRange *ranges, int count, int *complete)
+{
+    (void)ranges; (void)count; *complete = 0; return 0;
+}
+int gww_clean(const GwwRange *ranges, int count, uint64_t since)
+{
+    (void)ranges; (void)count; (void)since; return 0;
+}
+void gww_stats(uint64_t *faults, uint64_t *armed_pages)
+{
+    if (faults) *faults = 0;
+    if (armed_pages) *armed_pages = 0;
+}
+void gww_host_write(const void *host, size_t bytes) { (void)host; (void)bytes; }
+void gww_host_write_begin(const void *host, size_t bytes) { (void)host; (void)bytes; }
+void gww_host_write_end(const void *host, size_t bytes) { (void)host; (void)bytes; }
+int gww_virtual_protect(void *host, size_t bytes, unsigned long protect, unsigned long *old)
+{
+    DWORD previous = 0;
+    BOOL ok = VirtualProtect(host, bytes, (DWORD)protect, &previous);
+    if (old) *old = previous;
+    return ok != 0;
+}
+unsigned long gww_logical_protect(const void *host, unsigned long protect)
+{
+    (void)host; return protect;
+}
+int gww_range_armed(const void *host, size_t bytes) { (void)host; (void)bytes; return 0; }
+
+#endif
diff --git a/src/kernel/guest_write_watch.h b/src/kernel/guest_write_watch.h
new file mode 100644
index 0000000..bb8e703
--- /dev/null
+++ b/src/kernel/guest_write_watch.h
@@ -0,0 +1,103 @@
+/* Write stamps for guest pages of the contiguous window.
+ *
+ * The renderer re-reads a texture's guest bytes at every pushbuffer kick to
+ * learn whether the CPU changed them. This module lets it learn that without
+ * reading: a checked range is write-protected ("armed") on every host view
+ * of its pages -- the contiguous window and its tiled alias -- and the first
+ * write to an armed page faults into a vectored handler, which makes the
+ * page writable again and stamps it with the next value of a write clock.
+ *
+ * The protocol a caller follows:
+ *   seq = gww_arm(ranges)     snapshot the clock, then protect the pages
+ *   ... read the bytes ...    every later write stamps a page past seq
+ *   gww_clean(ranges, seq)    1 only if every page is still armed and no
+ *                             page carries a stamp newer than seq
+ * The handler makes the page writable before it stamps it, and arming,
+ * stamping and the clean check share one lock, so a write either lands
+ * before the read that follows the arm or leaves a stamp newer than seq.
+ *
+ * The renderer writes rendered pixels back into guest render targets. It
+ * does so through a third, never-protected view of the same pages
+ * (gww_host_writer), so the guest's views stay armed and every CPU write
+ * still faults, and then stamps the pages (gww_host_wrote): other ranges on
+ * them re-read, while the writer, which mirrored its bytes in its own copy,
+ * may keep its snapshot when no CPU write arrived since.
+ *
+ * Kernel-mode writers (ReadFile into a guest buffer) do not fault into user
+ * mode: they fail on a read-only page. They bracket the call with
+ * gww_host_write_begin/end, which unprotects the pages and keeps them from
+ * being armed until the write is over. Guest protection changes go through
+ * gww_virtual_protect so a request never silently undoes (or is undone by) an
+ * armed page.
+ *
+ * Inactive (no calls take effect) on non-Windows hosts, when gww_init was not
+ * called, or with RECOMP_TEXTURE_WATCH=0. */
+#ifndef XBOXRECOMP_GUEST_WRITE_WATCH_H
+#define XBOXRECOMP_GUEST_WRITE_WATCH_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* One guest range, by guest virtual address. */
+typedef struct { uint32_t va, bytes; } GwwRange;
+
+/* What the renderer uses; a test may supply its own. */
+typedef struct GwwOps {
+    /* 1 if [va, va + bytes) lies inside the watched window. */
+    int (*covers)(uint32_t va, uint32_t bytes);
+    /* Snapshot the write clock, then arm every page of the ranges. *complete
+     * is 1 only when every page ended up armed. */
+    uint64_t (*arm)(const GwwRange *ranges, int count, int *complete);
+    /* 1 if every page is armed and none was written after since. */
+    int (*clean)(const GwwRange *ranges, int count, uint64_t since);
+    /* Cumulative write faults taken and pages armed. */
+    void (*stats)(uint64_t *faults, uint64_t *armed_pages);
+    /* A host pointer to [va, va + bytes) through the unprotected view, or
+     * NULL (not watched, no such view, or a page the guest protected).
+     * Writes through it neither fault nor stamp: follow them with
+     * host_wrote. */
+    uint8_t *(*host_writer)(uint32_t va, uint32_t bytes);
+    /* After writing through host_writer: *still_clean = every page armed and
+     * unwritten since prior; then stamps every page and returns the clock,
+     * a snapshot the writer may keep when *still_clean. */
+    uint64_t (*host_wrote)(const GwwRange *ranges, int count, uint64_t prior,
+                           int *still_clean);
+} GwwOps;
+
+/* Called once the contiguous window and its tiled alias are mapped.
+ * contig_guest is the window's guest base (0x80000000). tiled_host may be
+ * NULL. section is the file-mapping handle both views map; the watch maps
+ * its unprotected writer view from it. Returns 1 when the watch is
+ * available. */
+int gww_init(uint32_t contig_guest, void *contig_host, size_t contig_bytes,
+             void *tiled_host, size_t tiled_bytes, void *section);
+/* The renderer's operations, or NULL when the watch is inactive. */
+const GwwOps *gww_ops(void);
+
+int gww_covers(uint32_t va, uint32_t bytes);
+uint64_t gww_arm(const GwwRange *ranges, int count, int *complete);
+int gww_clean(const GwwRange *ranges, int count, uint64_t since);
+void gww_stats(uint64_t *faults, uint64_t *armed_pages);
+uint8_t *gww_host_writer(uint32_t va, uint32_t bytes);
+uint64_t gww_host_wrote(const GwwRange *ranges, int count, uint64_t prior, int *still_clean);
+
+/* A host write through a host pointer into guest memory. Unprotects and
+ * stamps the watched pages it touches; other addresses are ignored. */
+void gww_host_write(const void *host, size_t bytes);
+/* The same for a write a user-mode fault cannot see (kernel-mode copies):
+ * the pages also stay unarmed until the matching end. */
+void gww_host_write_begin(const void *host, size_t bytes);
+void gww_host_write_end(const void *host, size_t bytes);
+
+/* VirtualProtect on guest memory. Watched pages lose their arm; a request for
+ * a protection that is not plain read-write keeps them from being armed
+ * again. *old reports PAGE_READWRITE for an armed page. */
+int gww_virtual_protect(void *host, size_t bytes, unsigned long protect,
+                        unsigned long *old);
+/* The protection the guest believes a page has: PAGE_READWRITE for an armed
+ * page whose host protection is the watch's PAGE_READONLY. */
+unsigned long gww_logical_protect(const void *host, unsigned long protect);
+/* 1 if every page of the range is armed (read-only only because of us). */
+int gww_range_armed(const void *host, size_t bytes);
+
+#endif
