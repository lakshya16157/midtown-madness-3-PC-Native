+/* Real file opens and failures, isolated from game assets and saves. */
+#include "kernel.h"
+#include "kernel_file_probe.h"
+#include <io.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+static HANDLE root;
+static int trace;
+
+static NTSTATUS open_name(const char *path, ULONG access, HANDLE *opened)
+{
+    XBOX_ANSI_STRING name = {0};
+    XBOX_OBJECT_ATTRIBUTES oa = {0};
+    XBOX_IO_STATUS_BLOCK ios = {0};
+    NTSTATUS status;
+    name.Buffer = (PCHAR)path;
+    name.Length = (USHORT)strlen(path);
+    name.MaximumLength = name.Length + 1;
+    oa.RootDirectory = root;
+    oa.ObjectName = &name;
+    status = xbox_NtCreateFile(opened, access, &oa, &ios, NULL, 0x80,
+        1, XBOX_FILE_OPEN, XBOX_FILE_NON_DIRECTORY_FILE);
+    if (ios.Status != status || (status && ios.Information)) abort();
+    return status;
+}
+
+static DWORD WINAPI probe_worker(void *unused)
+{
+    unsigned i;
+    (void)unused;
+    for (i = 0; i < 16; ++i) {
+        HANDLE opened = NULL;
+        if (open_name("Data\\Shared\\Cars\\absent\\body.cmp", XBOX_GENERIC_READ, &opened)
+                != STATUS_OBJECT_PATH_NOT_FOUND || opened ||
+            xbox_LastFileError() != ERROR_PATH_NOT_FOUND ||
+            xbox_LastFileFailureLogged() != trace) return 1;
+    }
+    return 0;
+}
+
+static unsigned occurrences(const char *text, const char *needle)
+{
+    unsigned n = 0;
+    while ((text = strstr(text, needle))) { ++n; text += strlen(needle); }
+    return n;
+}
+
+int main(int argc, char **argv)
+{
+    wchar_t temporary[MAX_PATH], folder[MAX_PATH], path[MAX_PATH];
+    char *output;
+    FILE *capture;
+    int saved, result = 1;
+    HANDLE opened = NULL, workers[2];
+    XBOX_IO_STATUS_BLOCK ios = {0};
+    char byte = 0;
+    unsigned i;
+    size_t length;
+    trace = argc == 2 && !strcmp(argv[1], "trace");
+    _putenv_s("RECOMP_FILE_PROBE_TRACE", trace ? "1" : "0");
+    if (!GetTempPathW(MAX_PATH, temporary) || !GetTempFileNameW(temporary, L"xfp", 0, folder)) return 10;
+    if (!DeleteFileW(folder) || !CreateDirectoryW(folder, NULL)) return 11;
+    swprintf_s(path, MAX_PATH, L"%s\\Data", folder);
+    if (!CreateDirectoryW(path, NULL)) return 12;
+    root = CreateFileW(folder, FILE_LIST_DIRECTORY,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    if (root == INVALID_HANDLE_VALUE) return 13;
+    /* Close lookalikes, archives, save files, writes and directory operations
+     * must never enter the quiet candidate class. Match all observed roots. */
+    if (!xbox_file_probe_path(L"game_files\\Data\\Shared\\Cars\\car215\\body.cmp", 0x80100080, 1, 0x64) ||
+        !xbox_file_probe_path(L"C:/Cache//data/xbox/Cars/stock/body.cmp", 0x80100080, 1, 0x64) ||
+        !xbox_file_probe_path(L"game_files\\TDATA\\4d53002a\\$C\\00000005\\Cars\\car215\\body.cmp", 0x80100080, 1, 0x64) ||
+        xbox_file_probe_path(L"game_files\\Data\\Data_hd.zip", XBOX_GENERIC_READ, 1, 0x64) ||
+        xbox_file_probe_path(L"game_files\\Data\\Sharedish\\body.cmp", XBOX_GENERIC_READ, 1, 0x64) ||
+        xbox_file_probe_path(L"game_files\\UDATA\\profile.txt", XBOX_GENERIC_READ, 1, 0x64) ||
+        xbox_file_probe_path(L"Data\\Shared\\body.cmp", XBOX_GENERIC_WRITE, 1, 0x64) ||
+        xbox_file_probe_path(L"Data\\Shared\\body.cmp", XBOX_GENERIC_READ, 2, 0x64) ||
+        xbox_file_probe_path(L"Data\\Shared\\body.cmp", XBOX_GENERIC_READ, 1, 1)) abort();
+    fflush(stderr);
+    capture = tmpfile();
+    saved = _dup(_fileno(stderr));
+    if (!capture || saved < 0 || _dup2(_fileno(capture), _fileno(stderr))) abort();
+    for (i = 0; i < (trace ? 4u : 2048u); ++i) {
+        if (open_name("Data\\Shared\\Cars\\absent\\body.cmp", XBOX_GENERIC_READ, &opened)
+                != STATUS_OBJECT_PATH_NOT_FOUND || opened ||
+            xbox_LastFileFailureLogged() != trace) abort();
+    }
+    for (i = 0; i < 2; ++i) {
+        workers[i] = CreateThread(NULL, 0, probe_worker, NULL, 0, NULL);
+        if (!workers[i]) abort();
+    }
+    if (WaitForMultipleObjects(2, workers, TRUE, 5000) != WAIT_OBJECT_0) abort();
+    for (i = 0; i < 2; ++i) {
+        DWORD code = 1;
+        GetExitCodeThread(workers[i], &code);
+        CloseHandle(workers[i]);
+        if (code) abort();
+    }
+    if (open_name("Data\\Shared\\ParticleSystems\\required.dps", XBOX_GENERIC_READ, &opened)
+            != STATUS_OBJECT_PATH_NOT_FOUND || opened) abort();
+    if (open_name("Data\\Data_hd.zip", XBOX_GENERIC_READ, &opened) != STATUS_OBJECT_NAME_NOT_FOUND ||
+        xbox_LastFileError() != ERROR_FILE_NOT_FOUND || !xbox_LastFileFailureLogged()) abort();
+    if (open_name("UDATA\\profile.txt", XBOX_GENERIC_READ, &opened) != STATUS_OBJECT_PATH_NOT_FOUND ||
+        !xbox_LastFileFailureLogged()) abort();
+    if (open_name("Data\\Shared\\Cars\\absent\\body.cmp", XBOX_GENERIC_WRITE, &opened)
+            != STATUS_OBJECT_PATH_NOT_FOUND || !xbox_LastFileFailureLogged()) abort();
+    if (xbox_NtReadFile(INVALID_HANDLE_VALUE, NULL, NULL, NULL, &ios, &byte, 1, NULL)
+            != STATUS_UNSUCCESSFUL || GetLastError() != ERROR_INVALID_HANDLE) abort();
+    swprintf_s(path, MAX_PATH, L"%s\\read-only.bin", folder);
+    opened = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, CREATE_NEW,
+                         FILE_ATTRIBUTE_NORMAL, NULL);
+    if (opened == INVALID_HANDLE_VALUE) abort();
+    if (xbox_NtWriteFile(opened, NULL, NULL, NULL, &ios, &byte, 1, NULL)
+            != STATUS_UNSUCCESSFUL || GetLastError() != ERROR_ACCESS_DENIED) abort();
+    xbox_NtClose(opened);
+    opened = NULL;
+    /* Success clears a prior failure without changing the returned handle. */
+    if (open_name("read-only.bin", XBOX_GENERIC_READ, &opened) != STATUS_SUCCESS ||
+        !opened || xbox_LastFileError() || xbox_LastFileFailureLogged()) abort();
+    xbox_NtClose(opened);
+    fflush(stderr);
+    _dup2(saved, _fileno(stderr));
+    _close(saved);
+    fseek(capture, 0, SEEK_END);
+    length = (size_t)ftell(capture);
+    output = malloc(length + 1);
+    if (!output) abort();
+    rewind(capture);
+    length = fread(output, 1, length, capture);
+    output[length] = 0;
+    fclose(capture);
+    if (occurrences(output, "[FILE_PROBE]") == (trace ? 37u : 4u) &&
+        occurrences(output, "[FILE_ERROR]") == 5u &&
+        strstr(output, "operation=NtReadFile") && strstr(output, "operation=NtWriteFile") &&
+        strstr(output, "thread=") && strstr(output, "tick_ms=") &&
+        strstr(output, "required.dps") &&
+        (trace || (strstr(output, "count=1024 ") && strstr(output, "count=2048 ") &&
+                    strstr(output, "RECOMP_FILE_PROBE_TRACE=1")))) result = 0;
+    if (result) fprintf(stderr, "FAIL: file probe logging mode %s:\n%s", trace ? "trace" : "quiet", output);
+    free(output);
+    CloseHandle(root);
+    DeleteFileW(path);
+    swprintf_s(path, MAX_PATH, L"%s\\Data", folder);
+    RemoveDirectoryW(path);
+    RemoveDirectoryW(folder);
+    if (!result) printf("PASS: %s file probes, exact failure statuses, concurrent TLS and read/write context\n", trace ? "full" : "bounded");
+    return result;
+}
