+#ifndef NV2A_HOST_COMMANDS_H
+#define NV2A_HOST_COMMANDS_H
+
+/* Ordered host fog pass: eleven non-increasing NV097_NO_OPERATION parameters
+ * on subchannel zero. Tag, W-to-world scale, far clip, start, end, packed ARGB,
+ * flags, world-up camera-ray plane XYZ and inverse sky-fade width. Ordinary
+ * Xbox command decoders treat the entire extension as no-ops. */
+#define NV2A_HOST_FOG_HEADER 0x402C0100u
+#define NV2A_HOST_FOG_TAG 0x58424647u
+#define NV2A_HOST_FOG_WORDS 12u
+#define NV2A_HOST_FOG_SKY_MASK 1u
+#define NV2A_HOST_FOG_SKY_FILL 2u
+#define NV2A_HOST_FOG_SKY_FADE 4u
+
+/* The sky's authored fog ramp for the next fog pass and the draws that read
+ * it (MM3's trees): six no-op parameters. Tag, guest VA of the ramp texels,
+ * SET_TEXTURE_FORMAT, the ramp row (V, 0..1), and the depth remap that puts
+ * the ramp at its authored distance (scale, knee; see y16d_ps). */
+#define NV2A_HOST_RAMP_HEADER 0x40180100u
+#define NV2A_HOST_RAMP_TAG 0x52424647u
+#define NV2A_HOST_RAMP_WORDS 7u
+
+/* World-space triangles published under a sequence number
+ * (nv2a_d3d_world_tris_publish), drawn over this camera's scene: nineteen
+ * no-op parameters. Tag, sequence, W-to-world scale, the camera's
+ * world-to-camera rows (right, up, forward, translation; xyz each) and the
+ * projection's _11, _22, _31, _32. */
+#define NV2A_HOST_TRIS_HEADER 0x404C0100u
+#define NV2A_HOST_TRIS_TAG 0x53495254u
+#define NV2A_HOST_TRIS_WORDS 20u
+
+#endif
