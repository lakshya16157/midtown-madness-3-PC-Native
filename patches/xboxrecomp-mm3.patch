+#include "apu_dsp_trace.h"
+#include <emmintrin.h>
 
 /* ============================================================
  * SVF (State Variable Filter) - from vp/svf.h
@@ -145,9 +150,11 @@ static inline void hrtf_filter_step_parameters(HrtfFilter *f) {
