index 0000000..d7fec98
--- /dev/null
+++ b/tests/nv2a_readback/test_main.c
@@ -0,0 +1,1017 @@
+/* Real staging copies/pixels with controlled asynchronous API failures. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_4.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <io.h>
+
+static int inspect, hold_query, fail_query, fail_create_query, fail_map, fail_rtv;
+static unsigned maps, queries, creates, flushes, bad_flags, clock_calls, frequency_calls;
+static int mock_clock, fail_clock, fail_frequency, allow_blocking_maps;
+static LONGLONG clock_ticks = 1000000, clock_frequency = 1000000;
+static int mock_poll_environment;
+static const char *poll_environment_value;
+static unsigned fence_qi_calls, fence_creates, fence_signals, fence_reads;
+static int fail_fence_qi, fail_fence_create, fail_fence_signal, mock_fence_value;
+static UINT64 fence_completed_value;
+static int mock_fence_environment;
+static const char *fence_environment_value;
+static int mock_idle_environment, hold_idle_event, fail_idle_event, fail_idle_timer;
+static int fail_idle_register, fail_idle_arm, fail_idle_wait, mock_idle_wait;
+static const char *idle_environment_value;
+static unsigned idle_event_creates, idle_timer_creates, idle_registers, idle_arms, idle_waits;
+static DWORD last_idle_wait;
+
+static char *watched_getenv(const char *name)
+{
+    if (mock_poll_environment && !strcmp(name, "RECOMP_READBACK_POLL_US"))
+        return (char *)poll_environment_value;
+    if (mock_fence_environment && !strcmp(name, "RECOMP_READBACK_FENCE"))
+        return (char *)fence_environment_value;
+    if (mock_idle_environment && !strcmp(name, "RECOMP_READBACK_IDLE_WAIT"))
+        return (char *)idle_environment_value;
+    return getenv(name);
+}
+static HRESULT watched_map(ID3D11DeviceContext *ctx, ID3D11Resource *resource,
+                           UINT sub, D3D11_MAP type, UINT flags, D3D11_MAPPED_SUBRESOURCE *out)
+{
+    if (inspect && type == D3D11_MAP_READ) {
+        maps++;
+        if (flags != D3D11_MAP_FLAG_DO_NOT_WAIT && !(allow_blocking_maps && !flags)) bad_flags++;
+        if (fail_map) { fail_map--; return DXGI_ERROR_WAS_STILL_DRAWING; }
+    }
+    return ctx->lpVtbl->Map(ctx, resource, sub, type, flags, out);
+}
+
+static HRESULT watched_query(ID3D11DeviceContext *ctx, ID3D11Asynchronous *query,
+                             void *data, UINT size, UINT flags)
+{
+    if (inspect) {
+        queries++;
+        if (flags != D3D11_ASYNC_GETDATA_DONOTFLUSH) bad_flags++;
+        if (hold_query) { if (data && size == sizeof(BOOL)) *(BOOL *)data = FALSE; return S_FALSE; }
+        if (fail_query) { fail_query--; return E_FAIL; }
+    }
+    return ctx->lpVtbl->GetData(ctx, query, data, size, flags);
+}
+
+static HRESULT watched_create_query(ID3D11Device *dev, const D3D11_QUERY_DESC *desc, ID3D11Query **out)
+{
+    if (inspect) {
+        creates++;
+        if (fail_create_query) { fail_create_query--; *out = NULL; return E_OUTOFMEMORY; }
+    }
+    return dev->lpVtbl->CreateQuery(dev, desc, out);
+}
+
+static HRESULT watched_rtv(ID3D11Device *dev, ID3D11Resource *resource,
+                           const D3D11_RENDER_TARGET_VIEW_DESC *desc, ID3D11RenderTargetView **out)
+{
+    if (inspect && fail_rtv) { fail_rtv--; *out = NULL; return E_OUTOFMEMORY; }
+    return dev->lpVtbl->CreateRenderTargetView(dev, resource, desc, out);
+}
+
+static void watched_flush(ID3D11DeviceContext *ctx)
+{
+    if (inspect) flushes++;
+    ctx->lpVtbl->Flush(ctx);
+}
+
+static BOOL WINAPI watched_clock(LARGE_INTEGER *time)
+{
+    if (inspect) clock_calls++;
+    if (mock_clock) {
+        if (fail_clock) { fail_clock--; return FALSE; }
+        time->QuadPart = clock_ticks;
+        return TRUE;
+    }
+    return QueryPerformanceCounter(time);
+}
+
+static BOOL WINAPI watched_frequency(LARGE_INTEGER *frequency)
+{
+    if (inspect) frequency_calls++;
+    if (mock_clock) {
+        if (fail_frequency) { fail_frequency--; return FALSE; }
+        frequency->QuadPart = clock_frequency;
+        return TRUE;
+    }
+    return QueryPerformanceFrequency(frequency);
+}
+
+static HRESULT watched_device_qi(ID3D11Device *dev, REFIID iid, void **out)
+{
+    if (inspect && !memcmp(iid,&IID_ID3D11Device5,sizeof *iid)) {
+        ++fence_qi_calls;
+        if (fail_fence_qi==1) { *out=NULL; return E_NOINTERFACE; }
+    }
+    return dev->lpVtbl->QueryInterface(dev,iid,out);
+}
+static HRESULT watched_context_qi(ID3D11DeviceContext *ctx, REFIID iid, void **out)
+{
+    if (inspect && !memcmp(iid,&IID_ID3D11DeviceContext4,sizeof *iid)) {
+        ++fence_qi_calls;
+        if (fail_fence_qi==2) { *out=NULL; return E_NOINTERFACE; }
+    }
+    return ctx->lpVtbl->QueryInterface(ctx,iid,out);
+}
+static HRESULT watched_create_fence(ID3D11Device5 *dev,UINT64 initial,D3D11_FENCE_FLAG flags,REFIID iid,void **out)
+{
+    if (inspect) {
+        ++fence_creates;
+        if (fail_fence_create) { *out=NULL; return E_OUTOFMEMORY; }
+    }
+    return dev->lpVtbl->CreateFence(dev,initial,flags,iid,out);
+}
+static HRESULT watched_signal(ID3D11DeviceContext4 *ctx,ID3D11Fence *fence,UINT64 value)
+{
+    if (inspect) {
+        ++fence_signals;
+        if (fail_fence_signal) return E_FAIL;
+    }
+    return ctx->lpVtbl->Signal(ctx,fence,value);
+}
+static UINT64 watched_fence_value(ID3D11Fence *fence)
+{
+    if (inspect) {
+        ++fence_reads;
+        if (mock_fence_value) return fence_completed_value;
+    }
+    return fence->lpVtbl->GetCompletedValue(fence);
+}
+
+static HANDLE WINAPI watched_idle_event(LPSECURITY_ATTRIBUTES attr, BOOL manual, BOOL initial, LPCWSTR name)
+{
+    if (inspect) {
+        ++idle_event_creates;
+        if (manual || initial || name) ++bad_flags;
+        if (fail_idle_event) return NULL;
+    }
+    return CreateEventW(attr, manual, initial, name);
+}
+static HANDLE WINAPI watched_idle_timer(LPSECURITY_ATTRIBUTES attr, LPCWSTR name, DWORD flags, DWORD access)
+{
+    if (inspect) {
+        ++idle_timer_creates;
+        if (flags != CREATE_WAITABLE_TIMER_HIGH_RESOLUTION || name) ++bad_flags;
+        if (fail_idle_timer) return NULL;
+    }
+    return CreateWaitableTimerExW(attr, name, flags, access);
+}
+static HRESULT watched_idle_register(ID3D11Fence *fence, UINT64 target, HANDLE event)
+{
+    if (inspect) {
+        ++idle_registers;
+        if (fail_idle_register) return E_OUTOFMEMORY;
+        if (hold_idle_event) return S_OK;
+    }
+    return fence->lpVtbl->SetEventOnCompletion(fence, target, event);
+}
+static BOOL WINAPI watched_idle_arm(HANDLE timer, const LARGE_INTEGER *due, LONG period,
+                                    PTIMERAPCROUTINE callback, LPVOID arg, BOOL resume)
+{
+    if (inspect) {
+        ++idle_arms;
+        if (due->QuadPart != -2500 || period || callback || arg || resume) ++bad_flags;
+        if (fail_idle_arm) return FALSE;
+    }
+    return SetWaitableTimer(timer, due, period, callback, arg, resume);
+}
+static DWORD WINAPI watched_idle_wait(DWORD count, const HANDLE *handles, BOOL all, DWORD timeout)
+{
+    if (inspect) {
+        ++idle_waits;
+        if (count != 2 || all || timeout != INFINITE) ++bad_flags;
+        if (fail_idle_wait) return WAIT_FAILED;
+        if (mock_idle_wait) { clock_ticks += 1000; return last_idle_wait = WAIT_OBJECT_0 + 1; }
+    }
+    return last_idle_wait = WaitForMultipleObjects(count, handles, all, timeout);
+}
+
+#undef ID3D11DeviceContext_Map
+#define ID3D11DeviceContext_Map watched_map
+#undef ID3D11DeviceContext_GetData
+#define ID3D11DeviceContext_GetData watched_query
+#undef ID3D11Device_CreateQuery
+#define ID3D11Device_CreateQuery watched_create_query
+#undef ID3D11Device_CreateRenderTargetView
+#define ID3D11Device_CreateRenderTargetView watched_rtv
+#undef ID3D11DeviceContext_Flush
+#define ID3D11DeviceContext_Flush watched_flush
+#undef ID3D11Device_QueryInterface
+#define ID3D11Device_QueryInterface watched_device_qi
+#undef ID3D11DeviceContext_QueryInterface
+#define ID3D11DeviceContext_QueryInterface watched_context_qi
+#undef ID3D11Device5_CreateFence
+#define ID3D11Device5_CreateFence watched_create_fence
+#undef ID3D11DeviceContext4_Signal
+#define ID3D11DeviceContext4_Signal watched_signal
+#undef ID3D11Fence_GetCompletedValue
+#define ID3D11Fence_GetCompletedValue watched_fence_value
+#undef ID3D11Fence_SetEventOnCompletion
+#define ID3D11Fence_SetEventOnCompletion watched_idle_register
