+    CHECK(nv2a_d3d_writeback_busy() && queries == 2);
+    CHECK(writeback_finish(1) && maps == 2 && flushes == 2 && !bad_flags);
+    CHECK(!pixels_match(s, 1, 0));
+    puts("PASS: blocking staging reuse bypasses cadence and each new copy batch gets an immediate first query");
+    return 0;
