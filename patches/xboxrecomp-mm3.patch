+int main(int argc, char **argv)
+{
+    _putenv_s("RECOMP_RENDER_SCALE","1"); _putenv_s("RECOMP_MSAA","1");
+    _putenv_s("RECOMP_ASPECT","4:3"); _putenv_s("RECOMP_PS_SPEC","0");
+    _putenv_s("RECOMP_PS_PREWARM","0"); _putenv_s("RECOMP_SHADER_CACHE","0");
+    /* Point lists here carry the capture geometry shader; keep the
+     * renderer's own wide-line shader (tests/nv2a_wide_lines) off them. */
+    _putenv_s("RECOMP_LINE_WIDTH","0");
+    CHECK(argc == 2 && nv2a_d3d_init());
+    if (!strcmp(argv[1],"panorama")) test_panorama();
+    else if (!strcmp(argv[1],"gates")) test_gates();
+    else if (!strcmp(argv[1],"depth")) test_depth();
+    else if (!strcmp(argv[1],"placement")) test_placement();
+    else if (!strcmp(argv[1],"map_placement")) test_map_placement();
+    else if (!strcmp(argv[1],"map_improved")) test_map_improved();
+    else if (!strcmp(argv[1],"menu_canvas")) test_menu_canvas();
+    else if (!strcmp(argv[1],"aspect_control")) test_aspect_control();
+    else if (!strcmp(argv[1],"haze_depth")) test_haze_depth();
+    else if (!strcmp(argv[1],"haze_gates")) test_haze_gates();
+    else if (!strcmp(argv[1],"haze_coverage")) test_haze_coverage();
+    else CHECK(0);
+    return 0;
+}
