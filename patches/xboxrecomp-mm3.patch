index 0000000..6c83530
--- /dev/null
+++ b/tests/nv2a_flare_depth/test_flare_depth.c
@@ -0,0 +1,423 @@
+/* Lamp glow sprites must not shine through an opaque hill's depth. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t *ram;
+static int native_fixture;
+static uint32_t native_program[136][4] = {
+    {0, 0x0020001B, 0x0836106C, 0x2F100FF8},
+    {0, 0x0420061B, 0x083613FC, 0x5011F818},
+    {0, 0x002008FF, 0x0836106C, 0x2070F828},
+    {0, 0x0240081B, 0x1436186C, 0x2F20F824},
+    {0, 0x0060201B, 0x2436106C, 0x3070F800},
+    {0, 0x00200200, 0x0836106C, 0x2070F830},
+    {0, 0x00200E1B, 0x0836106C, 0x2070F838},
+    {0, 0x0020101B, 0x0836106C, 0x2070F840},
+    {0, 0x0020121B, 0x0836106C, 0x2070F848},
+    {0, 0x0020141B, 0x0836106C, 0x2070F850},
+    {0, 0x0020161B, 0x0836106C, 0x2070F858},
+    {0, 0x0020181B, 0x0836106C, 0x2070F861}
+};
+static float native_constants[192][4] = {{1, 1, 16777215, 1}, {.53125f, .53125f, 0, 0}};
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{
+    *start = 0; *version = 1;
+    return native_fixture ? (const uint32_t (*)[4])native_program : NULL;
+}
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{
+    *version = 1;
+    return native_fixture ? (const float (*)[4])native_constants : NULL;
+}
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+static uint32_t pixel(Surface *surface, unsigned x, unsigned y)
+{
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    uint32_t result = 0xDEADBEEFu;
+    surface_resolve(surface);
+    ID3D11Texture2D_GetDesc(surface->tex, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging))) return result;
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)surface->tex);
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped))) {
+        memcpy(&result, (uint8_t *)mapped.pData + y * mapped.RowPitch + x * 4, 4);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11Texture2D_Release(staging);
+    return result;
+}
+
+static void glow(const NvD3DState *st, float depth)
+{
+    static const uint32_t indices[] = {0, 1, 2, 2, 1, 3};
+    float vertices[4][4] = {{0, 0, 0, 1}, {48, 0, 0, 1}, {0, 48, 0, 1}, {48, 48, 0, 1}};
+    float defaults[16][4] = {{0}};
+    NvD3DAttrib attributes[16] = {{0}};
+    unsigned n;
+    for (n = 0; n < 4; ++n) {
+        vertices[n][2] = depth * 16777215.0f;
+        vertices[n][3] = st->z_perspective ? 1.0f / vertices[n][2] : 1.0f;
+    }
+    defaults[3][1] = defaults[3][3] = 1; /* green */
+    for (n = 9; n < 13; ++n) defaults[n][3] = 1;
+    attributes[0].enabled = 1;
+    attributes[0].type = 2;
+    attributes[0].size = 4;
+    attributes[0].stride = sizeof vertices[0];
+    attributes[0].data = (const uint8_t *)vertices;
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attributes, defaults, 0, indices, 6, 0, 3, NULL);
+}
+
+/* Native Flares vertex program/constants captured from the installed game.
+ * Keep its 56-byte position stride and real distant-sprite Z/RHW convention;
+ * a larger quad makes pixel readback stable at every tested resolution. The
+ * native combiner uses a white lamp texture and fully visible mask fixture. */
+static void native_glow_fixture(const NvD3DState *st, unsigned near_car)
+{
+    static const uint32_t indices[] = {0, 1, 2, 2, 1, 3};
+    float vertices[4][14] = {
+        {298.299f, 162.611f, .999532f, 2.71648e-7f},
+        {322.299f, 162.611f, .999532f, 2.71648e-7f},
+        {298.299f, 186.611f, .999532f, 2.71648e-7f},
+        {322.299f, 186.611f, .999532f, 2.71648e-7f}
+    };
+    float defaults[16][4] = {{0}};
+    NvD3DAttrib attributes[16] = {{0}};
+    unsigned n;
+    if (near_car) {
+        /* Exact rear-lamp quad captured from the installed Panoz at night. */
+        static const float positions[4][2] = {
+            {400.503510f, 397.231323f}, {447.440033f, 397.231323f},
+            {400.503510f, 444.167847f}, {447.440033f, 444.167847f}
+        };
+        for (n = 0; n < 4; ++n) {
+            vertices[n][0] = positions[n][0]; vertices[n][1] = positions[n][1];
+            vertices[n][2] = .954220414f; vertices[n][3] = 8.24015297e-6f;
+        }
+    }
+    defaults[3][1] = 1; defaults[3][3] = .5f;
+    for (n = 9; n < 13; ++n) defaults[n][3] = 1;
+    attributes[0].enabled = 1;
+    attributes[0].type = 2;
+    attributes[0].size = 4;
+    attributes[0].stride = sizeof vertices[0];
+    attributes[0].data = (const uint8_t *)vertices;
+    native_fixture = 1;
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attributes, defaults, 1, indices, 6, 0, 3, NULL);
+    native_fixture = 0;
+}
+
+/* Both white front lamps captured from the player Panoz, facing the camera
+ * at night (16 October 2026). Retain their native 56-byte layout, packed
+ * 0x69FFFFFF diffuse, Z/RHW, and all three screen-mask taps. These exercise
+ * the front color and real coordinates that the green rear fixture cannot. */
+static void native_front_lamps(const NvD3DState *st)
+{
+    typedef struct {
+        float position[4];
+        uint32_t diffuse, specular;
+        float uv[8];
+    } LampVertex;
+    static const LampVertex vertices[8] = {
+        {{373.947296f,269.813538f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {395.196350f,291.062592f,395.696350f,291.562592f,395.946350f,291.812592f,0,0}},
+        {{418.445404f,269.813538f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {397.196350f,291.062592f,396.696350f,291.562592f,396.446350f,291.812592f,1,0}},
+        {{418.445404f,314.311646f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {397.196350f,293.062592f,396.696350f,292.562592f,396.446350f,292.312592f,1,1}},
+        {{373.947296f,314.311646f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {395.196350f,293.062592f,395.696350f,292.562592f,395.946350f,292.312592f,0,1}},
+        {{222.554459f,269.813538f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {243.803513f,291.062592f,244.303513f,291.562592f,244.553513f,291.812592f,0,0}},
+        {{267.052551f,269.813538f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {245.803513f,291.062592f,245.303513f,291.562592f,245.053513f,291.812592f,1,0}},
+        {{267.052551f,314.311646f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {245.803513f,293.062592f,245.303513f,292.562592f,245.053513f,292.312592f,1,1}},
+        {{222.554459f,314.311646f,.975612760f,5.58034981e-6f},0x69FFFFFF,0x80808080,
+         {243.803513f,293.062592f,244.303513f,292.562592f,244.553513f,292.312592f,0,1}}
+    };
+    static const uint32_t indices[] = {0,1,2,0,2,3,4,5,6,4,6,7};
+    NvD3DAttrib attributes[16] = {{0}};
+    float defaults[16][4] = {{0}};
+    unsigned n;
+    attributes[0].data = (const uint8_t *)&vertices[0].position;
+    attributes[0].type = 2; attributes[0].size = 4;
+    attributes[3].data = (const uint8_t *)&vertices[0].diffuse;
+    attributes[4].data = (const uint8_t *)&vertices[0].specular;
+    attributes[3].size = attributes[4].size = 4;
+    for (n = 9; n < 13; ++n) {
+        attributes[n].data = (const uint8_t *)&vertices[0].uv[(n - 9) * 2];
+        attributes[n].type = attributes[n].size = 2;
+    }
+    for (n = 0; n < 16; ++n) if (attributes[n].data) {
+        attributes[n].enabled = 1;
+        attributes[n].stride = sizeof vertices[0];
+    }
+    native_fixture = 1;
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attributes, defaults, 1, indices, 12, 0, 7, NULL);
+    native_fixture = 0;
+}
+
+/* Seed through the public clear path: direct host clears cannot publish which
+ * encoding the guest used in this particular depth buffer. */
+static void scene_depth_clear(const NvD3DState *st, unsigned wbuffer, float value)
+{
+    NvD3DState scene = *st;
+    uint32_t packed = (uint32_t)floorf(fminf(1.0f, fmaxf(0.0f, value)) * 16777215.0f + .5f);
+    scene.z_perspective = wbuffer;
+    nv2a_d3d_clear(&scene, 1, 0, packed << 8, 0, 0, st->clip_w - 1, st->clip_h - 1);
+}
+
+static void scene_depth_plane(const NvD3DState *st, unsigned wbuffer, float value, unsigned write)
+{
+    static const uint32_t indices[] = {0, 1, 2, 2, 1, 3};
+    float vertices[4][4] = {{0,0,0,1}, {640,0,0,1}, {0,480,0,1}, {640,480,0,1}};
+    float defaults[16][4] = {{0}};
+    NvD3DAttrib attr[16] = {{0}};
+    NvD3DState scene = *st;
+    unsigned n;
+    scene.z_perspective = wbuffer;
+    scene.depth_test = 1; scene.depth_mask = write; scene.depth_func = 0x207;
+    scene.blend_enable = scene.rc_seen = scene.tex_used = scene.fog_enable = 0;
+    scene.color_mask = write ? 0x01010101 : 0;
+    defaults[3][0] = defaults[3][3] = 1;
+    for (n = 0; n < 4; ++n) {
+        vertices[n][2] = value * (wbuffer ? 16777216.0f : 16777215.0f);
+        vertices[n][3] = wbuffer ? 1.0f / vertices[n][2] : 1.0f;
+    }
+    attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+    attr[0].stride = sizeof vertices[0]; attr[0].data = (const uint8_t *)vertices;
+    nv2a_d3d_draw_ub(&scene, NV_D3D_TRIANGLES, attr, defaults, 0, indices, 6, 0, 3, NULL);
+}
+
+static int check_near_domain(NvD3DState st, unsigned scene_wbuffer,
+                             unsigned flare_wbuffer, unsigned visible, unsigned draw_seed)
+{
+    Surface *target = surface_find(phys(st.color_addr));
+    float lamp_depth = scene_wbuffer ? 1.0f / (8.24015297e-6f * 16777216.0f) : .954220414f;
+    float plane = lamp_depth + (visible ? .0001f : -.0001f);
+    float red[4] = {1,0,0,1};
+    CHECK(target);
+    ID3D11DeviceContext_ClearRenderTargetView(s_ctx, target->rtv, red);
+    target->gen++; target->ms_dirty = 1;
+    scene_depth_clear(&st, draw_seed ? !scene_wbuffer : scene_wbuffer, draw_seed ? 1.0f : plane);
+    if (draw_seed) {
+        scene_depth_plane(&st, scene_wbuffer, plane, 1);
+        /* A depth-tested read-only pass must not replace the last writer's mode. */
+        scene_depth_plane(&st, !scene_wbuffer, .5f, 0);
+    }
+    st.z_perspective = flare_wbuffer;
+    native_glow_fixture(&st, 1);
+    CHECK(pixel(target, (unsigned)(424 * target->sx), (unsigned)(421 * target->sy)) ==
+          (visible ? 0xFFFFFF00u : 0xFFFF0000u));
+    return 0;
+}
+
+static int check_front_lamps(NvD3DState st, unsigned scene_wbuffer)
+{
+    static const unsigned x[2] = {396,244};
+    /* Controlled opaque-white BC3 lamp, matching the native texture format.
+     * Alpha-mask and depth visibility are varied independently below. */
+    static const uint8_t white_bc3[16] = {255,255,0,0,0,0,0,0,255,255,255,255,0,0,0,0};
+    NvD3DState mask = st, scene = st;
+    Surface *target = surface_find(phys(st.color_addr));
+    float black[4] = {0,0,0,1};
+    float lamp_depth = scene_wbuffer ? 1.0f / (5.58034981e-6f * 16777216.0f) : .975612760f;
+    uint32_t occluder = (uint32_t)floorf((lamp_depth - .0001f) * 16777215.0f + .5f);
+    unsigned visible, blocked, lamp, n;
+    CHECK(target);
+    for (n = 0; n < 64 * 64; n += 16) memcpy(ram + 0x70000 + n, white_bc3, 16);
+    st.tex[3].addr = 0x70000; st.tex[3].color = 0x0F;
+    mask.color_addr = st.tex[0].addr; mask.zeta_addr = 0;
+    scene.z_perspective = scene_wbuffer;
+    st.z_perspective = !scene_wbuffer; /* Unused native glow state may differ. */
+    for (visible = 0; visible < 4; ++visible) {
+        nv2a_d3d_clear(&mask, 0xF0, 0, 0, 0, 0, 639, 479);
+        for (lamp = 0; lamp < 2; ++lamp) if (visible & (1u << lamp))
+            nv2a_d3d_clear(&mask, 0xF0, 0xFFFFFFFF, 0, x[lamp]-4, 288, x[lamp]+4, 296);
+        for (blocked = 0; blocked < 4; ++blocked) {
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, target->rtv, black);
+            target->gen++; target->ms_dirty = 1;
+            scene_depth_clear(&st, scene_wbuffer, lamp_depth + .0001f);
+            for (lamp = 0; lamp < 2; ++lamp) if (blocked & (1u << lamp))
+                nv2a_d3d_clear(&scene, 1, 0, occluder << 8, x[lamp]-25, 265, x[lamp]+25, 319);
+            native_front_lamps(&st);
+            for (lamp = 0; lamp < 2; ++lamp) {
+                uint32_t actual = pixel(target, (unsigned)(x[lamp] * target->sx), (unsigned)(292 * target->sy));
+                if ((visible & ~blocked) & (1u << lamp)) {
+                    /* Native alpha 105/255, multiplied by two: neutral 210.
+                     * Allow one quantization step across supported adapters. */
+                    unsigned r = (actual >> 16) & 255, g = (actual >> 8) & 255, b = actual & 255;
+                    CHECK(r >= 209 && r <= 211 && r == g && g == b && (actual >> 24) == 255);
+                } else CHECK(actual == 0xFF000000u);
+            }
+            CHECK(pixel(target, (unsigned)(320 * target->sx), (unsigned)(292 * target->sy)) == 0xFF000000u);
+        }
+    }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    NvD3DState st = {0}, other;
+    Surface *mask, *target;
+    Depth *depth;
+    unsigned n, wbuffer, enabled;
+    float red[4] = {1, 0, 0, 1};
+    uint32_t gw, gh, zmax;
+    ram = calloc(1, 0x400000);
+    CHECK(ram);
+    _putenv_s("RECOMP_MSAA", argc > 1 ? argv[1] : "1");
+    _putenv_s("RECOMP_RENDER_SCALE", argc > 2 ? argv[2] : "1");
+    _putenv_s("RECOMP_PS_SPEC", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    mask = surface_get(0x20000, 64 * 4, 8, 64, 64, 0);
+    CHECK(mask);
+    st.color_addr = 0x10000;
+    st.color_pitch = st.zeta_pitch = 64 * 4;
+    st.zeta_addr = 0x30000;
+    st.surface_format = 0x28;
+    st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x00010101; /* RGB; leave the visibility alpha intact. */
+    st.depth_test = 1;
+    st.depth_func = 0x203;
+    CHECK(setup_pipeline(&st, NV_D3D_TRIANGLES, &target, &gw, &gh, &zmax));
+    depth = s_cur_ds;
+    CHECK(depth);
+    st.depth_test = 0;
+    st.blend_enable = 1;
+    st.blend_sfactor = st.blend_dfactor = 1;
+    st.blend_equation = 0x8006;
+    st.rc_seen = 1;
+    st.rc.final0 = 4;       /* Final D = primary diffuse. */
+    st.rc.final1 = 0x1400;  /* Final G = primary diffuse alpha. */
+    st.rc.stage_program = 0x8421;
+    st.tex_used = 15;
+    for (n = 0; n < 4; ++n) {
+        /* Native Flares/Flares.psh: three occluders, then the flare. */
+        st.tex[n].addr = n < 3 ? mask->va : 0x60000;
+        st.tex[n].color = 0x12;
+        st.tex[n].pitch = 64 * 4;
+        st.tex[n].width = st.tex[n].height = 64;
+        st.tex[n].levels = 1;
+        /* Native traced linear magnification; minification/aniso varies. */
+        st.tex[n].filter = 0x02062000;
+    }
+    for (n = 0; n < 64 * 64; ++n) ((uint32_t *)(ram + 0x60000))[n] = 0xFFFFFFFFu;
+    nv2a_d3d_set_flare_depth_test(1);
+    CHECK(flare_needs_depth(&st));
+    other = st; other.tex[3] = other.tex[0]; CHECK(!flare_needs_depth(&other)); /* bloom */
+    other = st; other.tex_used = 1; CHECK(flare_needs_depth(&other)); /* native RC fallback mask */
+    other = st; other.rc.stage_program = 1; CHECK(!flare_needs_depth(&other)); /* HUD */
+    other = st; other.blend_dfactor = 0x303; CHECK(!flare_needs_depth(&other)); /* glass */
+    other = st; other.depth_test = 1; CHECK(!flare_needs_depth(&other)); /* native depth */
+    other = st; other.tex[2].addr += 16; CHECK(!flare_needs_depth(&other)); /* unrelated taps */
+    other = st; other.tex[0] = st.tex[3]; other.tex[3] = st.tex[0];
+    CHECK(!flare_needs_depth(&other)); /* reversed stage order is not native */
+    other = st; other.rc.stage_program = 0x8000; CHECK(!flare_needs_depth(&other)); /* Flares2 */
+    other = st; other.tex[1].filter = 0x01000000;
+    CHECK(!flare_needs_depth(&other)); /* native visibility pass uses linear magnification */
+    for (wbuffer = 0; wbuffer < 2; ++wbuffer) {
+        st.z_perspective = wbuffer;
+        for (enabled = 0; enabled < 2; ++enabled) {
+            nv2a_d3d_set_flare_depth_test(enabled);
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, target->rtv, red);
+            target->gen++; target->ms_dirty = 1;
+            scene_depth_clear(&st, wbuffer, .5f);
+            glow(&st, .75f);
+            CHECK(pixel(target, (unsigned)(16 * s_scale), (unsigned)(16 * s_scale)) ==
+                  (enabled ? 0xFFFF0000u : 0xFFFFFF00u));
+            if (enabled) {
+                glow(&st, .25f);
+                CHECK(pixel(target, (unsigned)(16 * s_scale), (unsigned)(16 * s_scale)) == 0xFFFFFF00u);
+            }
+        }
+    }
+    /* Replay the native VF and register-combiner program. Live diagnostics
+     * contain both encodings; retain distant hill occlusion in each domain. */
+    mask = surface_get(0x100000, 640 * 4, 8, 640, 480, 0);
+    CHECK(mask);
+    {
+        float white[4] = {1, 1, 1, 1};
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, mask->rtv, white);
+        mask->gen++; mask->ms_dirty = 1;
+    }
+    st.color_addr = 0x200000;
+    st.zeta_addr = 0x300000;
+    st.color_pitch = st.zeta_pitch = 640 * 4;
+    st.clip_w = 640; st.clip_h = 480;
+    st.surface_format = 0x128;
+    st.tex_used = 1; /* Actual native register-combiner draw state. */
+    st.blend_sfactor = 0x302;
+    st.rc.control = 0x11102;
+    st.rc.final0 = 0x0C040000; st.rc.final1 = 0x00001C80;
+    st.rc.color_icw[0] = 0xCBD40000; st.rc.alpha_icw[0] = 0xD830D930;
+    st.rc.color_ocw[0] = 0x000100C0; st.rc.alpha_ocw[0] = 0x00030C00;
+    st.rc.color_icw[1] = 0xCCDB0000; st.rc.alpha_icw[1] = 0xDC30DA30;
+    st.rc.color_ocw[1] = 0x000000C0; st.rc.alpha_ocw[1] = 0x00030C00;
+    for (n = 0; n < 3; ++n) {
+        st.tex[n].addr = mask->va;
+        st.tex[n].width = 640; st.tex[n].height = 480; st.tex[n].pitch = 640 * 4;
+    }
+    for (wbuffer = 0; wbuffer < 2; ++wbuffer) {
+        float lamp_depth = wbuffer ? 1.0f / (2.71648e-7f * 16777216.0f) : .999532f;
+        st.z_perspective = wbuffer;
+        for (enabled = 0; enabled < 2; ++enabled) {
+            nv2a_d3d_set_flare_depth_test(enabled);
+            CHECK(setup_pipeline(&st, NV_D3D_TRIANGLES, &target, &gw, &gh, &zmax));
+            depth = s_cur_ds;
+            if (!depth) depth = depth_find(phys(st.zeta_addr));
+            if (!depth) depth = depth_get(st.zeta_addr, target->iw, target->ih, target->ms ? s_msaa : 1);
+            CHECK(depth);
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, target->rtv, red);
+            target->gen++; target->ms_dirty = 1;
+            scene_depth_clear(&st, wbuffer, lamp_depth - .0001f);
+            native_glow_fixture(&st, 0);
+            CHECK(pixel(target, (unsigned)(306 * target->sx), (unsigned)(170 * target->sy)) ==
+                  (enabled ? 0xFFFF0000u : 0xFFFFFF00u));
+            if (enabled) {
+                scene_depth_clear(&st, wbuffer, lamp_depth + .0001f);
+                native_glow_fixture(&st, 0);
+                CHECK(pixel(target, (unsigned)(306 * target->sx), (unsigned)(170 * target->sy)) == 0xFFFFFF00u);
+            }
+        }
+    }
+    nv2a_d3d_set_flare_depth_test(1);
+    for (wbuffer = 0; wbuffer < 2; ++wbuffer) {
+        unsigned visible, draw_seed;
+        for (visible = 0; visible < 2; ++visible)
+            for (draw_seed = 0; draw_seed < 2; ++draw_seed)
+                CHECK(!check_near_domain(st, wbuffer, !wbuffer, visible, draw_seed));
+    }
+    /* Interleave independent Z/W depth surfaces. A global last-mode cache
+     * would use the other surface's encoding and fail one of these probes. */
+    for (wbuffer = 0; wbuffer < 2; ++wbuffer) {
+        Surface *surface = surface_find(phys(st.color_addr));
+        NvD3DState second = st;
+        float lamp_depth = wbuffer ? 1.0f / (8.24015297e-6f * 16777216.0f) : .954220414f;
+        float red_clear[4] = {1,0,0,1};
+        second.zeta_addr = 0x380000;
+        scene_depth_clear(&st, wbuffer, lamp_depth + (wbuffer ? .0001f : -.0001f));
+        scene_depth_clear(&second, !wbuffer, .5f);
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, surface->rtv, red_clear);
+        surface->gen++; surface->ms_dirty = 1;
+        st.z_perspective = !wbuffer;
+        native_glow_fixture(&st, 1);
+        CHECK(pixel(surface, (unsigned)(424 * surface->sx), (unsigned)(421 * surface->sy)) ==
+              (wbuffer ? 0xFFFFFF00u : 0xFFFF0000u));
+    }
+    for (wbuffer = 0; wbuffer < 2; ++wbuffer) CHECK(!check_front_lamps(st, wbuffer));
+    puts("PASS: native front white headlamps, near/distant lamps, independent alpha/depth occlusion, mismatched Z/W states, depth writers, independent depth surfaces and MSAA/scale");
+    return 0;
+}
