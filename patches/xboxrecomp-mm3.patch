+static void maps(float aspect, float scale) {
+    float p[4][4], narrow = (4.0f / 3.0f) / aspect;
+    const uint32_t idx[6] = {0,1,2,0,2,3};
+    Result base, r, tag;
+    int frame, turn, i, old_n;
+    uint32_t old_tex[32];
+    seed(1); centered = 0;
+    nv2a_d3d_set_map_texture_query(map_texture_query);
+    old_n = s_hud_tex_n; memcpy(old_tex, s_hud_tex, sizeof old_tex);
+    /* Small map -> enlarged map -> small map, including rotated bases and
+     * the native horizontal/vertical movement while the control animates. */
+    for (frame = 0; frame <= 16; ++frame) {
+        float zoom = (float)(frame <= 8 ? frame : 16 - frame) / 8.0f;
+        float cx = 114 + 206 * zoom, cy = 384 - 144 * zoom;
+        float half = 64 * (1 + 2 * zoom);
+        for (turn = 0; turn < 8; ++turn) {
+            float angle = (float)turn * 0.3926990817f;
+            float c = cosf(angle), s = sinf(angle);
+            next_map_frame();
+            tag = box(100, 140, 80, 100, aspect, scale, 1, 0, 600);
+            near((tag.x[0] + tag.x[1]) * 0.5f, 120);
+            quad(p, -half, half, -half, half);
+            for (i = 0; i < 4; ++i) {
+                float x = p[i][0], y = p[i][1];
+                p[i][0] = cx + x * c - y * s;
+                p[i][1] = cy + x * s + y * c;
+            }
+            base = draw(p, 4, idx, 6, 0, aspect, scale, 1, 0, map_base);
+            near(base.squeeze, narrow); assert(!s_frame_bg_tex);
+            {
+                float source_left = p[0][0], source_right = p[0][0], output_left = base.x[0];
+                float source_bottom = p[0][1], output_bottom = base.y[0];
+                for (i = 1; i < 4; ++i) {
+                    if (p[i][0] < source_left) source_left = p[i][0];
+                    if (p[i][0] > source_right) source_right = p[i][0];
+                    if (base.x[i] < output_left) output_left = base.x[i];
+                    if (p[i][1] > source_bottom) source_bottom = p[i][1];
+                    if (base.y[i] > output_bottom) output_bottom = base.y[i];
+                }
+                if (source_right <= 320.0f) {
+                    near(output_left, 0.0f); near(output_bottom, 480.0f);
+                    near(base.y_offset, 480.0f - source_bottom);
+                }
+                else if (source_left >= 320.0f) near(output_left, 640.0f - (640.0f - source_left) * narrow);
+                else near(output_left, centered_x(source_left, aspect));
+                if (source_right > 320.0f) near(output_bottom, source_bottom);
+            }
+            map_markers(aspect, scale, base, p[0][0]);
+            map_routes(aspect, scale, base, p[0][0]);
+            old_n = s_hud_tex_n; memcpy(old_tex, s_hud_tex, sizeof old_tex);
+            assert(!base.use_dx);
+            assert(s_frame_map_valid && !s_frame_tag_window);
+            assert(s_hud_tex_n == old_n && !memcmp(old_tex, s_hud_tex, sizeof old_tex));
+            r = race_batch(aspect); /* Timer/counter remain normal edge HUD. */
+            near(r.x[0], 20 * narrow); near(r.x[4], 640 - 80 * narrow);
+            /* race_batch legitimately learns its unrelated HUD atlas. */
+            old_n = s_hud_tex_n; memcpy(old_tex, s_hud_tex, sizeof old_tex);
+        }
+    }
+    /* A large/rotated map can cover the whole display, but it is not a menu
+     * background and must not disable placement of its following markers. */
+    next_map_frame();
+    base = box(-40, 680, -120, 600, aspect, scale, 1, 0, map_base);
+    near(base.x[0], centered_x(-40, aspect));
+    assert(!s_frame_bg_tex);
+    map_markers(aspect, scale, base, -40);
+    map_routes(aspect, scale, base, -40);
+
+    centered = 1; /* Pause keeps its existing uniform centered transform. */
+    next_map_frame();
+    r = box(50, 178, 320, 448, aspect, scale, 1, 0, map_base);
+    check_centered(r, 50, 178, aspect);
+    near(r.y[0], 320); near(r.y[2], 448); assert(!r.use_dy);
+    assert(!s_frame_map_valid && s_frame_tag_window == 1);
+    tag_route(17, 4);
+    r = box(500, 516, 180, 196, aspect, scale, 0, 0, 0);
+    check_centered(r, 500, 516, aspect);
+    near(r.y[0], 180); near(r.y[2], 196); assert(!r.use_dy);
+    memset(&submitted_uv, 0, sizeof submitted_uv);
+    centered = 0;
+
+    /* A marker before this frame's base must not inherit last frame's left
+     * anchor. Same for query removal, ordinary menus and a new allocation. */
+    r = box(500, 516, 180, 196, aspect, scale, 1, 0, map_marker);
+    check_centered(r, 500, 516, aspect);
+    tag_route(17, 4);
+    r = box(500, 516, 180, 196, aspect, scale, 0, 0, 0);
+    near(r.x[0], centered_x(500, aspect)); near(r.x[1], centered_x(516, aspect));
+    near(r.y[0], 180); near(r.y[2], 196); assert(!r.use_dy);
+    nv2a_d3d_set_edge_hud(0); assert(!s_frame_map_valid);
+    r = box(50, 178, 320, 448, aspect, scale, 1, 0, map_base);
+    near(r.x[0], centered_x(50,aspect)); near(r.x[1], centered_x(178,aspect));
+    near(r.y[0], 320); near(r.y[2], 448); assert(!r.use_dy);
+    r = box(500, 516, 180, 196, aspect, scale, 0, 0, 0);
+    near(r.x[0], centered_x(500,aspect)); near(r.x[1], centered_x(516,aspect));
+    memset(&submitted_uv, 0, sizeof submitted_uv);
+    nv2a_d3d_set_edge_hud(1); next_map_frame();
+    map_base += 0x10000; map_marker += 0x10000;
+    base = box(128, 512, 48, 432, aspect, scale, 1, 0, map_base);
+    map_markers(aspect, scale, base, 128);
+    nv2a_d3d_set_map_texture_query(NULL); assert(!s_frame_map_valid);
+}
