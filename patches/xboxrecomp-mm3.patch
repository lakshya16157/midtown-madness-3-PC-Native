+/* Called before a local-light composite draw sets up its targets. */
+static void light_dump_tick(const NvD3DState *st)
+{
+    static const char *dir = (const char *)-1;
+    static unsigned composites, serial;
+    Surface *unlit, *buffer;
+    char flag[1024];
+    int forced = 0;
+    FILE *f;
+    if (dir == (const char *)-1) {
+        dir = getenv("MM3_LIGHT_DUMP");
+        if (dir && !*dir) dir = NULL;
+        if (dir) {
+            fprintf(stderr, "[D3D11_LIGHT] frame dumps enabled in %s (3 automatic, or create dump.flag)\n", dir);
+            fflush(stderr);
+        }
+    }
+    if (!dir) return;
+    composites++;
+    if (composites == 899 || composites == 1799 || composites == 2699) {
+        memset(&s_ldraw, 0, sizeof s_ldraw);   /* log the draws of the next frame */
+        s_ldraw.armed = 1;
+    }
+    snprintf(flag, sizeof flag, "%s/dump.flag", dir);
+    if ((f = fopen(flag, "rb")) != NULL) { fclose(f); remove(flag); forced = 1; }
+    if (!forced && (serial >= 3 || (composites != 900 && composites != 1800 && composites != 2700)))
+        return;
+    unlit = surface_find(phys(st->tex[0].addr));
+    buffer = surface_find(phys(st->tex[1].addr));
+    if (!unlit || !buffer) return;
+    surface_resolve(unlit);
+    surface_resolve(buffer);
+    light_dump_texture(dir, serial, "unlit", unlit->tex);
+    light_dump_texture(dir, serial, "light", buffer->tex);
+    if (s_light_depth && depth_y16_view(s_light_depth, 1))
+        light_dump_texture(dir, serial, "depth", s_light_depth->y16);
+    fprintf(stderr, "[D3D11_LIGHT] frame dump %02u written (composite %u, scene %ux%u, light buffer %ux%u, depth %s)\n",
+            serial, composites, (unsigned)unlit->w, (unsigned)unlit->h,
+            (unsigned)buffer->w, (unsigned)buffer->h, s_light_depth ? "yes" : "none");
+    if (s_ldraw.draws) {
+        fprintf(stderr, "[D3D11_LIGHT] that frame: %u light draws, %u indices; last clip %u,%u %ux%u;"
+                " target guest %ux%u host %ux%u scale %.2fx%.2f; vertex bounds x %.1f..%.1f y %.1f..%.1f\n",
+                s_ldraw.draws, s_ldraw.vertices, s_ldraw.cx, s_ldraw.cy, s_ldraw.cw, s_ldraw.ch,
+                s_ldraw.gw, s_ldraw.gh, s_ldraw.iw, s_ldraw.ih, s_ldraw.sx, s_ldraw.sy,
+                s_ldraw.xmin, s_ldraw.xmax, s_ldraw.ymin, s_ldraw.ymax);
+        snprintf(flag, sizeof flag, "%s/dump%02u-lightdraw.csv", dir, serial);
+        light_dump_vertices(flag);
+    }
+    s_ldraw.armed = 0;
+    fflush(stderr);
+    serial++;
+}
