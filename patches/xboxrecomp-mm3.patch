diff --git a/tests/nv2a_vertex_reuse/test_vertex_reuse.c b/tests/nv2a_vertex_reuse/test_vertex_reuse.c
new file mode 100644
index 0000000..35cb3d9
--- /dev/null
+++ b/tests/nv2a_vertex_reuse/test_vertex_reuse.c
@@ -0,0 +1,132 @@
+/* Real D3D11 pixels: a guest vertex span drawn again in the same kick reuses
+ * the bytes already in the vertex ring, a new kick copies changed guest data
+ * again, and a ring wrap never reuses a span from before the discard. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x200000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch)
+{ (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ (void)version; return NULL; }
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); \
+} } while (0)
+
+#define SIZE 64u
+#define GREEN 0xFF00FF00u
+#define RED 0xFFFF0000u
+#define BLUE 0xFF0000FFu
+#define BLACK 0xFF000000u
+
+static NvD3DState make_state(void)
+{
+    NvD3DState st = {0};
+    st.color_addr = 0x20000; st.color_pitch = SIZE * 4;
+    st.surface_format = 0x28; st.clip_w = SIZE; st.clip_h = SIZE;
+    st.color_mask = 0x01010101; st.blend_sfactor = 1;
+    st.blend_equation = 0x8006; st.front_face = 0x901;
+    return st;
+}
+
+/* A screen-space quad over columns [x0, x1), written into guest RAM at va. */
+static void write_quad(uint32_t va, float x0, float x1)
+{
+    float quad[4][4] = { {x0,-4,0,1}, {x1,-4,0,1}, {x1,SIZE + 4.f,0,1}, {x0,SIZE + 4.f,0,1} };
+    memcpy(ram + va, quad, sizeof quad);
+}
+
+static void draw_quad(const NvD3DState *st, uint32_t va, uint32_t argb)
+{
+    NvD3DAttrib attributes[16] = {0};
+    float defaults[16][4] = {{0}};
+    uint32_t indices[6] = {0,1,2,0,2,3};
+    attributes[0] = (NvD3DAttrib){1,2,4,16,ram + va};
+    defaults[3][0] = ((argb >> 16) & 255) / 255.f;
+    defaults[3][1] = ((argb >> 8) & 255) / 255.f;
+    defaults[3][2] = (argb & 255) / 255.f;
+    defaults[3][3] = 1;
+    nv2a_d3d_draw_ub(st,NV_D3D_TRIANGLES,attributes,defaults,0,indices,6,0,3,NULL);
+}
+
+/* Columns [0, a) are first, [a, b) second and the rest third. */
+static void check_columns(const NvD3DState *st, unsigned a, uint32_t first, unsigned b,
+                          uint32_t second, uint32_t third)
+{
+    Surface *target = surface_find(st->color_addr);
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC description;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    unsigned x, y;
+    CHECK(target);
+    surface_resolve(target);
+    ID3D11Texture2D_GetDesc(target->tex,&description);
+    description.Usage = D3D11_USAGE_STAGING;
+    description.BindFlags = description.MiscFlags = 0;
+    description.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&description,NULL,&staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)staging,(ID3D11Resource *)target->tex);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)staging,0,D3D11_MAP_READ,0,&mapped)));
+    for (y = 0; y < target->ih; ++y) for (x = 0; x < target->iw; ++x) {
+        uint32_t actual = ((const uint32_t *)((const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch))[x];
+        uint32_t expected = x < a ? first : x < b ? second : third;
+        if (actual != expected) {
+            fprintf(stderr,"pixel %u,%u expected %08X actual %08X\n",x,y,expected,actual);
+            exit(1);
+        }
+    }
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)staging,0);
+    ID3D11Texture2D_Release(staging);
+}
+
+int main(void)
+{
+    NvD3DState st = make_state();
+    uint64_t reused;
+    _putenv_s("RECOMP_MSAA","1");
+    _putenv_s("RECOMP_RENDER_SCALE","1");
+    _putenv_s("RECOMP_ASPECT","4:3");
+    _putenv_s("RECOMP_PS_SPEC","0");
+    _putenv_s("RECOMP_PS_PREWARM","0");
+    _putenv_s("RECOMP_FPS_LIMIT","0");
+    CHECK(nv2a_d3d_init());
+    CHECK(s_raw_nooverwrite);  /* reuse needs NO_OVERWRITE on the raw ring */
+    s_prof_on = 1;
+    nv2a_d3d_clear(&st,0xF0,BLACK,0,0,0,SIZE - 1,SIZE - 1);
+
+    /* Same span, same kick: the second pass reuses the ring copy. */
+    write_quad(0x30000, 0, 32);
+    nv2a_d3d_kick();
+    draw_quad(&st, 0x30000, GREEN);
+    reused = s_prof_vb_reused;
+    draw_quad(&st, 0x30000, RED);
+    CHECK(s_prof_vb_reused == reused + 64);
+    check_columns(&st, 32, RED, SIZE, BLACK, BLACK);
+
+    /* The guest moved the quad and kicked: the new bytes are copied. */
+    write_quad(0x30000, 32, SIZE);
+    nv2a_d3d_kick();
+    reused = s_prof_vb_reused;
+    draw_quad(&st, 0x30000, BLUE);
+    CHECK(s_prof_vb_reused == reused);
+    check_columns(&st, 32, RED, SIZE, BLUE, BLUE);
+
+    /* A span noted before a ring wrap is copied again after the discard. */
+    write_quad(0x30100, 0, 16);
+    draw_quad(&st, 0x30000, BLUE);              /* noted in this kick */
+    CHECK(s_prof_vb_reused == reused + 64);
+    s_raw_pos = VB_BYTES - 32;                  /* the next fresh copy cannot fit */
+    draw_quad(&st, 0x30100, GREEN);
+    CHECK(s_raw_pos && s_raw_pos < 1024);
+    reused = s_prof_vb_reused;
+    draw_quad(&st, 0x30000, BLUE);
+    CHECK(s_prof_vb_reused == reused);
+    check_columns(&st, 16, GREEN, 32, RED, BLUE);
+    puts("PASS: real GPU pixels; same-kick vertex spans reuse the ring copy, a new kick copies changed guest data, a ring wrap never reuses a discarded span");
+    return 0;
+}
