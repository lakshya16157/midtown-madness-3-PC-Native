+static int check_depth_views(Depth *d)
+{
+    unsigned raw,fog,changed,hi,lo;
+    CHECK(depth_y16_view(d,1)); raw = depth_word(d);
+    CHECK(depth_y16(d)); fog = depth_word(d);
+    CHECK(raw >= 16382 && raw <= 16385 && fog >= 20751 && fog <= 20755);
+    nv2a_d3d_set_depth_view_remap(1.5f,.78f);
+    CHECK(depth_y16(d)); changed = depth_word(d);
+    CHECK(changed >= 24574 && changed <= 24578 && changed > fog);
+    CHECK(depth_y16_view(d,1)); CHECK(depth_word(d) == raw);
+    /* LightDraw's view: R = 1, G and B the two bytes of the same word. */
+    CHECK(depth_y16_view(d,2));
+    CHECK(depth_channel(d,0) == 65535);
+    hi = (depth_channel(d,1) * 255u + 32767u) / 65535u;
+    lo = (depth_channel(d,2) * 255u + 32767u) / 65535u;
+    CHECK(hi * 256u + lo == raw);
+    CHECK(depth_y16_view(d,1)); CHECK(depth_word(d) == raw);
+    nv2a_d3d_set_depth_view_remap(1.26666667f,.78f);
+    printf("same-generation raw/fog/remapped depth=%u/%u/%u, light view bytes %u/%u\n",raw,fog,changed,hi,lo);
+    return 0;
+}
