+static int throttle_device_target(void)
+{
+    static int target = -1, fixed;
+    static unsigned dry_seen;
+    static int64_t raised_ms;
+    if (target < 0) {
+        const char *setting = getenv("RECOMP_XA2_TARGET_BUFFERS");
+        target = 8;
