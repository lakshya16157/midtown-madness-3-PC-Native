+static int read_contract(HANDLE h, unsigned char *buffer, const unsigned char *expected)
+{
+    XBOX_IO_STATUS_BLOCK ios;
+    LARGE_INTEGER offset, position;
+    HANDLE event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    int result = 1;
+    CHECK(event);
+    offset.QuadPart = 4096;
+    CHECK(xbox_NtReadFile(h, event, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_SUCCESS);
+    CHECK(ios.Status == STATUS_SUCCESS && ios.Information == 4096 && !memcmp(buffer, expected + 4096, 4096));
+    CHECK(WaitForSingleObject(event, 0) == WAIT_OBJECT_0);
+    offset.QuadPart = 0;
+    CHECK(SetFilePointerEx(h, offset, &position, FILE_CURRENT) && position.QuadPart == 8192);
+    CHECK(SetFilePointerEx(h, offset, NULL, FILE_BEGIN));
+    CHECK(xbox_NtReadFile(h, NULL, NULL, NULL, &ios, buffer, 4096, NULL) == STATUS_SUCCESS &&
+        ios.Information == 4096 && !memcmp(buffer, expected, 4096));
+    ResetEvent(event);
+    offset.QuadPart = 0;
+    CHECK(xbox_NtReadFile(h, event, NULL, NULL, &ios, buffer, 0, &offset) == STATUS_SUCCESS &&
+        ios.Information == 0 && WaitForSingleObject(event, 0) == WAIT_OBJECT_0);
+    ResetEvent(event);
+    offset.QuadPart = 65536 - 4096;
+    CHECK(xbox_NtReadFile(h, event, NULL, NULL, &ios, buffer, 8192, &offset) == STATUS_SUCCESS &&
+        ios.Information == 4096 && !memcmp(buffer, expected + 65536 - 4096, 4096));
+    CHECK(WaitForSingleObject(event, 0) == WAIT_OBJECT_0);
+    ResetEvent(event);
+    memset(buffer, 0xA5, 4096);
+    offset.QuadPart = 65536;
+    CHECK(xbox_NtReadFile(h, event, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_END_OF_FILE &&
+        ios.Status == STATUS_END_OF_FILE && ios.Information == 0 && buffer[0] == 0xA5);
+    CHECK(WaitForSingleObject(event, 0) == WAIT_TIMEOUT);
+    result = 0;
+done:
+    if (event) CloseHandle(event);
+    return result;
+}
+
+static int contracts(const char *setting)
+{
+    WCHAR folder[MAX_PATH] = {0}, path[MAX_PATH], copy[MAX_PATH];
