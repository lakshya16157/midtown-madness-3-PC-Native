+/* What actually reached the screen. The frame CSV and the pacing logs show
+ * when frames were presented, not which refresh showed them, so a picture the
+ * display kept up for an extra refresh (a visible hitch or "stuck frame") was
+ * only ever inferred. After every Present the swap chain's own statistics
+ * (DXGI) name the newest present on screen and the refresh it appeared at.
+ * Between two such reports:
+ *   refreshes repeated: the screen showed an older picture again. Each is
+ *       put down to the frame shown after it: presented late (after its
+ *       pacing point: the title or the renderer was late), or on time while
+ *       the GPU had not finished it a refresh later (an event query placed
+ *       after its Present, checked at the next one), or on time and finished
+ *       (Windows' compositor or the display was late with it);
+ *   frames replaced: presented, but a newer one reached the screen first.
+ * A hold of two or more extra refreshes is logged at once with its time,
+ *   [DISPLAY] the screen kept one picture for N more refreshes ...
+ * restarts of the statistics (display mode, window or compositor changes)
+ * likewise, and once a minute
+ *   [DISPLAY] last 60 s: R refreshes at X Hz; ...
+ * Two DXGI queries per present. RECOMP_DISPLAY_STATS=0 turns it off.
+ *
+ * Define NV2A_DISPLAY_STATS_LOGIC_ONLY to compile just the bookkeeping
+ * (unit tests). */
+#ifndef NV2A_DISPLAY_STATS_H
+#define NV2A_DISPLAY_STATS_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    uint32_t present_count;     /* newest present on screen */
+    uint32_t present_refresh;   /* the refresh it appeared at */
+    uint32_t sync_refresh;      /* a recent refresh ... */
+    int64_t sync_qpc;           /* ... and its QPC time */
+} DsStats;
+
+/* Longer holds are the title not flipping at all (loading, a paused movie):
+ * counted apart, not as repeats. */
+enum { DS_RING = 256, DS_LONG_HOLD = 30 };
+enum { DS_PENDING, DS_SHOWN, DS_SHOWN_NEAR, DS_MAYBE_REPLACED };
+enum { DS_GPU_UNKNOWN, DS_GPU_DONE, DS_GPU_SLOW };
+
+typedef struct {
+    /* our presents, by DXGI present count */
+    uint32_t id[DS_RING], flip[DS_RING], refresh[DS_RING];
+    int64_t qpc[DS_RING];
+    uint8_t late[DS_RING], fate[DS_RING], extra[DS_RING], gpu[DS_RING];
+    int have;
+    DsStats last;
+    /* since the window began */
+    unsigned presents, late_presents, gpu_slow, shown, repeats;
+    unsigned repeats_late, repeats_gpu, repeats_display;
+    unsigned holds, long_holds, replaced, restarts, waiting_max;
+    int have_first;
+    uint32_t first_sync_refresh, last_sync_refresh;
+    int64_t first_sync_qpc, last_sync_qpc;
+    /* the refresh rate from consecutive reports only: a display-mode change
+     * stalls the refresh count for a second, which would drag a first-to-last
+     * average down (58.8 Hz on a 60 Hz panel). freq (QPC ticks per second,
+     * 0 = unknown) bounds a step to 20..1000 Hz. */
+    int64_t freq;
+    int rate_have;
+    uint32_t rate_refresh;
+    int64_t rate_qpc, rate_ticks;
+    uint64_t rate_refreshes;
+} DsState;
+
+typedef struct {
+    uint32_t id, flip;          /* the frame that ended the hold */
+    unsigned extra;             /* refreshes the older picture stayed beyond its own */
+    int late;                   /* that frame was presented after its pacing point */
+    int gpu;                    /* DS_GPU_*: had the GPU finished it a refresh later */
+    int64_t present_qpc;
+    unsigned waiting;           /* our presents not on screen yet, at that report */
+} DsHold;
+
+static int ds_slot(const DsState *s, uint32_t id)
+{
+    unsigned k = id % DS_RING;
+    return s->id[k] == id && s->qpc[k] ? (int)k : -1;
+}
+
+/* After each successful Present: `id` from GetLastPresentCount, `flip` the
+ * guest flip it showed (0 for repeats of the last one), `late` when it was
+ * presented after its pacing point. */
+static void ds_presented(DsState *s, uint32_t id, uint32_t flip, int64_t qpc, int late)
+{
+    unsigned k = id % DS_RING;
+    s->id[k] = id;
+    s->flip[k] = flip;
+    s->qpc[k] = qpc ? qpc : 1;
+    s->late[k] = (uint8_t)(late != 0);
+    s->fate[k] = DS_PENDING;
+    s->refresh[k] = 0;
+    s->extra[k] = 0;
+    s->gpu[k] = DS_GPU_UNKNOWN;
+    s->presents++;
+    if (late) s->late_presents++;
+}
+
+/* Whether the GPU had finished present `id` by the next present. */
+static void ds_gpu_done(DsState *s, uint32_t id, int done)
+{
+    int k = ds_slot(s, id);
+    if (k < 0) return;
+    s->gpu[k] = (uint8_t)(done ? DS_GPU_DONE : DS_GPU_SLOW);
+    if (!done) s->gpu_slow++;
+}
+
+/* The statistics restarted (DXGI_ERROR_FRAME_STATISTICS_DISJOINT). */
+static void ds_restart(DsState *s)
+{
+    s->have = 0;
+    s->rate_have = 0;
+    s->restarts++;
+}
+
+static void ds_rate(DsState *s, const DsStats *st)
+{
+    if (s->rate_have) {
+        uint32_t step = st->sync_refresh - s->rate_refresh;
+        int64_t ticks = st->sync_qpc - s->rate_qpc;
+        if (step && step <= 8u && ticks > 0 &&
+            (!s->freq || (ticks <= (int64_t)step * (s->freq / 20) && ticks >= (int64_t)step * (s->freq / 1000)))) {
+            s->rate_refreshes += step;
+            s->rate_ticks += ticks;
+        }
+    }
+    s->rate_have = 1;
+    s->rate_refresh = st->sync_refresh;
+    s->rate_qpc = st->sync_qpc;
+}
+
+/* Feed the statistics read after the present `newest`. Returns 1, with *hold
+ * filled in, when the screen kept one picture for two or more extra
+ * refreshes. */
+static int ds_stats(DsState *s, const DsStats *st, uint32_t newest, DsHold *hold)
+{
+    uint32_t dp, dr, shown, i, waiting = newest - st->present_count;
+    int k, found = 0;
+    if (!st->present_count && !st->present_refresh) return 0;   /* nothing on screen yet */
+    if (waiting < 0x80000000u && waiting > s->waiting_max) s->waiting_max = waiting;
+    ds_rate(s, st);
+    if (!s->have_first) {
+        s->have_first = 1;
+        s->first_sync_refresh = st->sync_refresh;
+        s->first_sync_qpc = st->sync_qpc;
+    }
+    s->last_sync_refresh = st->sync_refresh;
+    s->last_sync_qpc = st->sync_qpc;
+    if (!s->have || st->present_count - s->last.present_count >= 0x80000000u ||
+        st->present_refresh - s->last.present_refresh >= 0x80000000u) {
+        /* First report, or one from before the last: start from here. */
+        s->have = 1;
+        s->last = *st;
+        if ((k = ds_slot(s, st->present_count)) >= 0) {
+            s->fate[k] = DS_SHOWN;
+            s->refresh[k] = st->present_refresh;
+        }
+        return 0;
+    }
+    dp = st->present_count - s->last.present_count;
+    dr = st->present_refresh - s->last.present_refresh;
+    if (!dp) return 0;
+    shown = dp < dr ? dp : dr;
+    s->shown += shown;
+    if (dp > dr) s->replaced += dp - dr;
+    /* The frames between the two reports reached the screen in that span,
+     * one refresh each when there were enough. */
+    for (i = 1; i < dp; i++)
+        if ((k = ds_slot(s, s->last.present_count + i)) >= 0 && s->fate[k] == DS_PENDING) {
+            s->fate[k] = dp > dr ? DS_MAYBE_REPLACED : DS_SHOWN_NEAR;
+            s->refresh[k] = dp == dr ? s->last.present_refresh + i : 0;
+        }
+    k = ds_slot(s, st->present_count);
+    if (k >= 0) {
+        s->fate[k] = DS_SHOWN;
+        s->refresh[k] = st->present_refresh;
+    }
+    if (dr > dp + DS_LONG_HOLD) {
+        s->long_holds++;
+    } else if (dr > dp) {
+        unsigned extra = dr - dp;
+        int late = k >= 0 && s->late[k], gpu = k >= 0 ? s->gpu[k] : DS_GPU_UNKNOWN;
+        s->repeats += extra;
+        if (late) s->repeats_late += extra;
+        else if (gpu == DS_GPU_SLOW) s->repeats_gpu += extra;
+        else s->repeats_display += extra;
+        if (k >= 0) s->extra[k] = (uint8_t)(extra > 255 ? 255 : extra);
+        if (extra >= 2) {
+            s->holds++;
+            found = 1;
+            hold->id = st->present_count;
+            hold->flip = k >= 0 ? s->flip[k] : 0;
+            hold->extra = extra;
+            hold->late = late;
+            hold->gpu = gpu;
+            hold->present_qpc = k >= 0 ? s->qpc[k] : 0;
+            hold->waiting = waiting < 0x80000000u ? waiting : 0;
+        }
+    }
+    s->last = *st;
+    return found;
+}
+
+/* The refresh rate over the window from the statistics' own clock, or 0:
+ * from consecutive reports when there are enough of them, else from the
+ * window's first and last. */
+static double ds_refresh_hz(const DsState *s, int64_t frequency)
+{
+    uint32_t refreshes = s->last_sync_refresh - s->first_sync_refresh;
+    int64_t ticks = s->last_sync_qpc - s->first_sync_qpc;
+    if (frequency <= 0) return 0.0;
+    if (s->rate_refreshes >= 30 && s->rate_ticks > 0)
+        return (double)s->rate_refreshes * (double)frequency / (double)s->rate_ticks;
+    if (!s->have_first || refreshes < 30 || refreshes >= 0x80000000u || ticks <= 0)
+        return 0.0;
+    return (double)refreshes * (double)frequency / (double)ticks;
+}
+
+/* Start a new window; the ring and the last report carry over. */
+static void ds_window_reset(DsState *s)
+{
+    s->presents = s->late_presents = s->gpu_slow = s->shown = s->repeats = 0;
+    s->repeats_late = s->repeats_gpu = s->repeats_display = 0;
+    s->holds = s->long_holds = s->replaced = 0;
+    s->restarts = s->waiting_max = 0;
+    s->have_first = 0;
+    s->rate_refreshes = 0;
+    s->rate_ticks = 0;
+}
+
+/* Why a frame of present slot k came when it did. */
+static const char *ds_cause(const DsState *s, unsigned k)
+{
+    if (s->late[k]) return " (presented late)";
+    if (s->gpu[k] == DS_GPU_SLOW) return " (presented on time, GPU not done a refresh later)";
+    return "";
+}
+
+/* What became of guest flip `flip`, for the F9 capture's table. */
+static void ds_describe(const DsState *s, uint32_t flip, char *out, size_t size)
+{
+    unsigned k;
+    if (!size) return;
+    snprintf(out, size, "not presented");
+    if (!flip) return;
+    for (k = 0; k < DS_RING; k++) {
+        if (!s->qpc[k] || s->flip[k] != flip) continue;
+        switch (s->fate[k]) {
+        case DS_SHOWN:
+            if (s->extra[k]) snprintf(out, size, "shown at refresh %u after the one before stayed %u more%s",
+                                      s->refresh[k], s->extra[k], *ds_cause(s, k) ? ds_cause(s, k) : " (presented on time)");
+            else snprintf(out, size, "shown at refresh %u%s", s->refresh[k], ds_cause(s, k));
+            break;
+        case DS_SHOWN_NEAR:
+            if (s->refresh[k]) snprintf(out, size, "shown at refresh %u%s", s->refresh[k], ds_cause(s, k));
+            else snprintf(out, size, "shown%s", ds_cause(s, k));
+            break;
+        case DS_MAYBE_REPLACED:
+            snprintf(out, size, "shown briefly or replaced before the screen%s", ds_cause(s, k));
+            break;
+        default:
+            snprintf(out, size, "presented%s, not on screen yet", s->late[k] ? " late" : "");
+            break;
+        }
+        return;
+    }
+}
+
+#ifndef NV2A_DISPLAY_STATS_LOGIC_ONLY
+
+static struct {
+    int state;                  /* -1 setting unread, 0 off, 1 on */
+    DsState ds;
+    unsigned failures, reports, holds_logged, restarts_logged;
+    int64_t window_start;
+    LARGE_INTEGER freq;
+    /* one event query after each present, alternating; 0 untried, 1 on, -1 off */
+    int gpu_state;
+    ID3D11Query *gpu_event[2];
+    uint32_t gpu_id[2];
+    int gpu_pending[2];
+    unsigned gpu_at;
+} s_dstats = { -1 };
+
+/* Has the GPU finished the present before this one? Then mark this one. */
+static void dstats_gpu(ID3D11DeviceContext *ctx, uint32_t id)
+{
+    unsigned prev = s_dstats.gpu_at ^ 1u, cur = s_dstats.gpu_at;
+    if (!s_dstats.gpu_state) {
