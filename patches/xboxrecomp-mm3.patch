+/* Real DXGI buffer lifetime, retry and pixels for the production presenter. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_4.h>
+#include <dxgi1_6.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned buffer_gets, view_creates;
+static int fail_get, fail_view, fail_resize;
+static HRESULT watched_get(IDXGISwapChain1 *swap, UINT index, REFIID iid, void **out)
+{
+    buffer_gets++;
+    if (fail_get) { fail_get--; *out = NULL; return E_FAIL; }
+    return swap->lpVtbl->GetBuffer(swap, index, iid, out);
+}
+static HRESULT watched_view(ID3D11Device *device, ID3D11Resource *resource,
+                             const D3D11_RENDER_TARGET_VIEW_DESC *desc,
+                             ID3D11RenderTargetView **out)
+{
+    view_creates++;
+    if (fail_view) { fail_view--; *out = NULL; return E_OUTOFMEMORY; }
+    return device->lpVtbl->CreateRenderTargetView(device, resource, desc, out);
+}
+static HRESULT watched_resize(IDXGISwapChain1 *swap, UINT count, UINT width,
+                               UINT height, DXGI_FORMAT format, UINT flags)
+{
+    if (fail_resize) { fail_resize--; return E_FAIL; }
+    return swap->lpVtbl->ResizeBuffers(swap, count, width, height, format, flags);
+}
+#undef IDXGISwapChain1_GetBuffer
+#define IDXGISwapChain1_GetBuffer watched_get
+#undef ID3D11Device_CreateRenderTargetView
+#define ID3D11Device_CreateRenderTargetView watched_view
+#undef IDXGISwapChain1_ResizeBuffers
+#define IDXGISwapChain1_ResizeBuffers watched_resize
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x100000];
+static HWND test_window;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return test_window; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { return NULL; }
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+
+static HWND new_window(UINT width, UINT height)
+{
+    HWND window = CreateWindowExW(0, L"STATIC", L"presentation lifetime test", WS_POPUP,
+                                   0, 0, (int)width, (int)height, NULL, NULL, NULL, NULL);
+    CHECK(window);
+    return window;
+}
+static void acquire(void)
+{
+    CHECK(ensure_swapchain());
+    CHECK(ensure_swap_backbuffer());
+    CHECK(s_swap_buffer && s_swap_rtv);
+}
+static uint32_t center_pixel(void)
+{
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *stage = NULL;
+    D3D11_MAPPED_SUBRESOURCE map;
+    uint32_t result;
+    ID3D11Texture2D_GetDesc(s_swap_buffer, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &stage)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)stage, (ID3D11Resource *)s_swap_buffer);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)stage, 0, D3D11_MAP_READ, 0, &map)));
+    memcpy(&result, (uint8_t *)map.pData + (desc.Height / 2) * map.RowPitch + (desc.Width / 2) * 4, 4);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)stage, 0);
+    ID3D11Texture2D_Release(stage);
+    return result;
+}
+static void test_pixels(void)
+{
+    Surface *surface = surface_get(0x20000, 64 * 4, 8, 64, 64, 0);
+    PresentConsts constants;
+    ID3D11RenderTargetView *view;
+    const float red[4] = {1, 0, 0, 1}, green[4] = {0, 1, 0, 1};
+    CHECK(surface);
+    acquire();
+    view = s_swap_rtv;
+    memset(&constants, 0, sizeof constants);
+    ID3D11DeviceContext_ClearRenderTargetView(s_ctx, surface->rtv, red);
+    composite(s_swap_rtv, s_swap_w, s_swap_h, surface, &constants, 1);
+    CHECK(center_pixel() == 0xFFFF0000u);
+    /* Present unbinds the output. Reuse must still explicitly rebind it. */
+    CHECK(SUCCEEDED(IDXGISwapChain1_Present(s_swap, 0, 0)));
+    memset(&constants, 0, sizeof constants);
+    ID3D11DeviceContext_ClearRenderTargetView(s_ctx, surface->rtv, green);
+    composite(s_swap_rtv, s_swap_w, s_swap_h, surface, &constants, 1);
+    CHECK(s_swap_rtv == view && center_pixel() == 0xFF00FF00u);
+    puts("PASS: actual composite pixels change correctly using one view across Present");
+}
+int main(int argc, char **argv)
+{
+    unsigned gets, creates;
+    CHECK(argc == 2);
+    _putenv_s("RECOMP_MSAA", "1"); _putenv_s("RECOMP_RENDER_SCALE", "1");
+    _putenv_s("RECOMP_ASPECT", "4:3"); _putenv_s("RECOMP_PS_SPEC", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    test_window = new_window(256, 128);
+    CHECK(ensure_swapchain());
+    buffer_gets = view_creates = 0;
+    if (!strcmp(argv[1], "get_failure") || !strcmp(argv[1], "view_failure")) {
+        int get_failure = !strcmp(argv[1], "get_failure");
+        fail_get = get_failure; fail_view = !get_failure;
+        CHECK(!ensure_swap_backbuffer());
+        CHECK(!s_swap_buffer && !s_swap_rtv);
+        acquire();
+        CHECK(buffer_gets == 2 && view_creates == (get_failure ? 1u : 2u));
+        gets = buffer_gets; creates = view_creates;
+        acquire(); CHECK(buffer_gets == gets && view_creates == creates);
+        puts("PASS: partial acquisition failure releases resources and next frame retries exactly once");
+    } else if (!strcmp(argv[1], "pixels")) {
+        test_pixels();
+    } else {
+        acquire();
+        CHECK(buffer_gets == 1 && view_creates == 1);
+        if (!strcmp(argv[1], "reuse")) {
+            Surface *surface = surface_get(0x20000, 64 * 4, 8, 64, 64, 0);
+            CHECK(surface);
+            gets = buffer_gets; creates = view_creates;
+            present_surface(surface, NULL); present_surface(surface, NULL);
+            CHECK(buffer_gets == gets && view_creates == creates);
+            puts("PASS: repeated production presents perform no buffer acquisitions or view allocations");
+        } else if (!strcmp(argv[1], "resize") || !strcmp(argv[1], "resize_failure")) {
+            CHECK(SetWindowPos(test_window, NULL, 0, 0, 320, 192, SWP_NOMOVE | SWP_NOZORDER));
+            if (!strcmp(argv[1], "resize_failure")) {
+                fail_resize = 1;
+                CHECK(!ensure_swapchain());
+                CHECK(!s_swap_buffer && !s_swap_rtv);
+                CHECK(s_swap_w == 256 && s_swap_h == 128);
+            }
+            acquire(); CHECK(s_swap_w == 320 && s_swap_h == 192);
+            CHECK(buffer_gets == 2 && view_creates == 2);
+            /* DXGI refuses ResizeBuffers while any old buffer/view refs survive. */
+            puts("PASS: cached references are released before successful native ResizeBuffers");
+        } else if (!strcmp(argv[1], "zero_area")) {
+            ID3D11RenderTargetView *view = s_swap_rtv;
+            CHECK(SetWindowPos(test_window, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOZORDER));
+            CHECK(!ensure_swapchain());
+            CHECK(s_swap_rtv == view);
+            CHECK(SetWindowPos(test_window, NULL, 0, 0, 256, 128, SWP_NOMOVE | SWP_NOZORDER));
+            acquire();
+            CHECK(s_swap_rtv == view && buffer_gets == 1 && view_creates == 1);
+            puts("PASS: zero-area window skips presentation and restore reuses the valid view");
+        } else if (!strcmp(argv[1], "window")) {
+            HWND old = test_window;
+            test_window = new_window(192, 96);
+            acquire();
+            CHECK(s_swap_hwnd == test_window && s_swap_w == 192 && s_swap_h == 96);
+            CHECK(buffer_gets == 2 && view_creates == 2);
+            DestroyWindow(old);
+            puts("PASS: window replacement drops the old swap-chain view and acquires the new one");
+        } else CHECK(0);
+    }
+    unbind_targets();
+    release_swap_backbuffer();
+    CHECK(!s_swap_buffer && !s_swap_rtv);
+    IDXGISwapChain1_Release(s_swap); s_swap = NULL;
+    DestroyWindow(test_window);
+    return 0;
+}
