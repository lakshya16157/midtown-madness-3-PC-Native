+static void light_attr(const NvD3DAttrib *a, uint32_t index, float *out, unsigned n)
+{
+    const uint8_t *p;
+    unsigned k;
+    for (k = 0; k < n; k++) out[k] = 0.0f;
+    if (!a->enabled || !a->data || !a->stride) return;
+    p = a->data + (size_t)index * a->stride;
+    if (a->type == 2) {
+        for (k = 0; k < n && k < a->size; k++) {
+            float f;
+            memcpy(&f, p + 4 * k, 4);
+            out[k] = f;
+        }
+    } else if (a->type == 0 && n >= 4) {                 /* D3DCOLOR: b g r a */
+        out[0] = p[2] / 255.0f; out[1] = p[1] / 255.0f;
+        out[2] = p[0] / 255.0f; out[3] = p[3] / 255.0f;
+    } else if (a->type == 4) {
+        for (k = 0; k < n && k < a->size; k++) out[k] = p[k] / 255.0f;
+    }
+}
