diff --git a/tests/xaudio2/throttle_test.c b/tests/xaudio2/throttle_test.c
new file mode 100644
index 0000000..19ca399
--- /dev/null
+++ b/tests/xaudio2/throttle_test.c
@@ -0,0 +1,155 @@
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../src/apu/apu_profile.h"
+#include "../../src/apu/apu_wait.h"
+
+#define QEMU_CLOCK_REALTIME 1
+#define MIXER_FRAME_SAMPLES 256
+#define EP_FRAME_US 5333
+typedef struct MCPXAPUState {
+    int ep_frame_div, sleep_acc_us, cond, lock;
+    int64_t next_frame_time_us;
+    unsigned next_frame_time_remainder;
+    bool pause_requested, exiting;
+    APUAudioProfile audio_profile;
+    APUHiResWait hires_wait;
+} MCPXAPUState;
+static int64_t now_us;
+static int wait_count, overshoot_us, clock_reads;
+#define qatomic_read(p) (*(p))
+static void qemu_mutex_unlock(int *lock) { (void)lock; }
+static void qemu_mutex_lock(int *lock) { (void)lock; }
+static int64_t qemu_clock_get_us(int clock) { (void)clock; ++clock_reads; return now_us; }
+static void qemu_cond_timedwait(int *cond, int *lock, int ms)
+{
+    (void)cond; (void)lock;
+    ++wait_count;
+    now_us += (int64_t)ms * 1000 + overshoot_us;
+}
+/* The device queue the throttle follows: -1 (no device) unless a test sets it. */
+static int device_queue = -1, device_target = 8;
+static int throttle_device_queue(void) { return device_queue; }
+static int throttle_device_target(void) { return device_target; }
+#include "throttle_under_test.inc"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "APU throttle line %d: %s\n", __LINE__, #condition); return 1; \
+} } while (0)
+
+int main(void)
+{
+    MCPXAPUState d = {0};
+    const int64_t start = 1000000;
+    now_us = start;
+    /* One hour: 675000 * 256 frames must occupy exactly 3600 seconds. */
+    for (unsigned n = 0; n < 675000; ++n) {
+        throttle(&d);
+        int64_t expected = start + (int64_t)(n + 1) * 256 * 1000000 / 48000;
+        CHECK(d.next_frame_time_us == expected);
+        now_us = d.next_frame_time_us;
+    }
+    CHECK(d.next_frame_time_us == start + 3600000000LL);
+    CHECK(d.next_frame_time_remainder == 0 && wait_count == 0);
+
+    memset(&d, 0, sizeof(d));
+    now_us = start;
+    throttle(&d);
+    throttle(&d);
+    CHECK(wait_count == 1 && d.sleep_acc_us == 5000);
+    int64_t before = d.next_frame_time_us;
+    now_us = before + 15000; /* Catch up a short scheduling delay. */
+    throttle(&d);
+    CHECK(d.next_frame_time_us == before + 5334);
+    before = d.next_frame_time_us;
+    now_us = before + 250001; /* Rebase after a long pause. */
+    throttle(&d);
+    CHECK(d.next_frame_time_us == now_us + 5333);
+    CHECK(d.next_frame_time_remainder == 16000);
+    before = d.next_frame_time_us;
+    d.ep_frame_div = 1;
+    throttle(&d);
+    CHECK(d.next_frame_time_us == before);
+
+    /* Enabling diagnostics must leave clock deadlines and waits identical. */
+    MCPXAPUState normal = {0}, profiled = {0};
+    apu_audio_profile_init(&profiled.audio_profile, true, 1000000);
+    int64_t normal_now = start, profiled_now = start;
+    overshoot_us = 750;
+    for (unsigned n = 0; n < 200; ++n) {
+        now_us = normal_now;
+        int normal_waits = wait_count;
+        int normal_reads = clock_reads;
+        throttle(&normal);
+        normal_waits = wait_count - normal_waits;
+        normal_reads = clock_reads - normal_reads;
+        normal_now = now_us + 500;
+        now_us = profiled_now;
+        int profiled_waits = wait_count;
+        int profiled_reads = clock_reads;
+        throttle(&profiled);
+        profiled_waits = wait_count - profiled_waits;
+        profiled_reads = clock_reads - profiled_reads;
+        profiled_now = now_us + 500;
+        CHECK(normal_waits == profiled_waits && normal_now == profiled_now);
+        CHECK(normal_reads == profiled_reads);
+        CHECK(normal.next_frame_time_us == profiled.next_frame_time_us);
+        CHECK(normal.next_frame_time_remainder == profiled.next_frame_time_remainder);
+        CHECK(normal.sleep_acc_us == profiled.sleep_acc_us);
+        apu_audio_profile_begin_group(&profiled.audio_profile, profiled_now);
+    }
+    CHECK(profiled.audio_profile.deadline_late_max_us > 0);
+    CHECK(profiled.audio_profile.cond_wait_calls > 0);
+    CHECK(profiled.audio_profile.cond_wait_overshoot_max_us == 750);
+    CHECK(profiled.audio_profile.cond_wait_early_wakes == 0);
+    apu_audio_profile_pause(&profiled.audio_profile);
+    now_us = profiled.next_frame_time_us + 10000000;
+    throttle(&profiled); /* Resume must rebase without calling a pause a stall. */
+    CHECK(profiled.audio_profile.deadline_late_max_us == 0);
+
+    /* Following the device queue: the correction itself. */
+    CHECK(apu_queue_correction_us(-1, 8) == 0 && apu_queue_correction_us(3, 0) == 0);
+    CHECK(apu_queue_correction_us(8, 8) == 0 && apu_queue_correction_us(10, 8) == 0);
+    CHECK(apu_queue_correction_us(7, 8) == -250 && apu_queue_correction_us(5, 8) == -750);
+    CHECK(apu_queue_correction_us(0, 8) == -1000 && apu_queue_correction_us(11, 8) == 250);
+    CHECK(apu_queue_correction_us(64, 8) == 1000);
+
+    /* A short queue brings the deadline forward, a long one pushes it back. */
+    memset(&d, 0, sizeof(d));
+    now_us = start;
+    overshoot_us = 0;
+    throttle(&d);                          /* first call rebases */
+    before = d.next_frame_time_us;
+    device_queue = 5;
+    throttle(&d);
+    CHECK(d.next_frame_time_us == before - 750 + 5333);
+    before = d.next_frame_time_us;
+    device_queue = 13;
+    throttle(&d);
+    CHECK(d.next_frame_time_us == before + 750 + 5334);
+
+    /* A sound card 0.02% faster than the PC clock: the queue no longer runs
+     * dry. Each output frame the device plays 256 * 1.0002 samples. */
+    {
+        double queued_samples = 5 * 256.0;
+        int dry = 0;
+        memset(&d, 0, sizeof(d));
+        now_us = start;
+        device_queue = 5;
+        for (unsigned n = 0; n < 200000; ++n) {      /* about 18 minutes */
+            int64_t was = now_us;
+            throttle(&d);
+            queued_samples += 256.0;                  /* this frame submitted */
+            queued_samples -= (double)(now_us - was) * 48000.0 * 1.0002 / 1e6;
+            if (queued_samples <= 0) { ++dry; queued_samples = 0; }
+            device_queue = (int)(queued_samples / 256.0);
+            if (n > 1000) CHECK(device_queue >= 5 && device_queue <= 11);
+        }
+        CHECK(dry == 0);
+    }
+    device_queue = -1;
+    puts("PASS: exact 48 kHz deadlines for one hour, measured waits, bounded catch-up, pause rebase and device-queue following");
+    return 0;
+}
diff --git a/tests/xaudio2/wake_idle_test.c b/tests/xaudio2/wake_idle_test.c
new file mode 100644
index 0000000..dd5dbfd
--- /dev/null
+++ b/tests/xaudio2/wake_idle_test.c
@@ -0,0 +1,56 @@
+/* Exercise the production routing with real idle and legacy condition waits.
+ * The native timer primitives are covered separately by hires_wait_test. */
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "../../src/apu/apu_shim.h"
+#include "../../src/apu/apu_wait.h"
+#include <assert.h>
+
+typedef struct MCPXAPUState {
+    QemuMutex lock;
+    QemuCond cond;
+    bool pause_requested, exiting;
+    APUHiResWait hires_wait;
+} MCPXAPUState;
+static MCPXAPUState *g_state;
+#include "wait_control_under_test.inc"
+static HANDLE waiting;
+static int timed;
+static DWORD WINAPI idle_worker(void *opaque)
+{
+    MCPXAPUState *d = opaque;
+    qemu_mutex_lock(&d->lock);
+    SetEvent(waiting);
+    while (d->pause_requested) {
+        if (timed) qemu_cond_timedwait(&d->cond, &d->lock, 10000);
+        else qemu_cond_wait(&d->cond, &d->lock);
+    }
+    qemu_mutex_unlock(&d->lock);
+    return 0;
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    timed = !strcmp(argv[1], "fallback");
+    MCPXAPUState d = {0};
+    g_state = &d;
+    qemu_mutex_init(&d.lock);
+    qemu_cond_init(&d.cond);
+    d.pause_requested = true;
+    waiting = CreateEventA(NULL, TRUE, FALSE, NULL); assert(waiting);
+    HANDLE thread = CreateThread(NULL, 0, idle_worker, &d, 0, NULL); assert(thread);
+    assert(WaitForSingleObject(waiting, 2000) == WAIT_OBJECT_0);
+    /* Lock acquisition pairs publication with the atomic release+wait, so the
+     * test does not depend on a sleep or on how soon the worker is scheduled. */
+    qemu_mutex_lock(&d.lock);
+    d.pause_requested = false;
+    mcpx_apu_wake_commands(&d, true);
+    qemu_mutex_unlock(&d.lock);
+    assert(WaitForSingleObject(thread, 2000) == WAIT_OBJECT_0);
+    assert(!d.hires_wait.wake); /* Ordinary routing needs no native handles. */
+    CloseHandle(thread); CloseHandle(waiting);
+    qemu_cond_destroy(&d.cond); qemu_mutex_destroy(&d.lock);
+    printf("PASS: command notification wakes real %s condition wait\n", timed ? "fallback" : "idle");
+    return 0;
+}
diff --git a/tools/dsp_recomp/dsp_recomp_gen.c b/tools/dsp_recomp/dsp_recomp_gen.c
new file mode 100644
index 0000000..5f4f27c
--- /dev/null
+++ b/tools/dsp_recomp/dsp_recomp_gen.c
@@ -0,0 +1,1131 @@
+/* dsp_recomp_gen <dsp_cpu.c> <dsp_emu.c.inc> <out.inc> <program dir>
+ *
+ * Recompiles the DSP56300 programs a title loaded -- <dir>/gp.p.bin and
+ * <dir>/ep.p.bin, saved by the runtime (dsp.c, RECOMP_DSP_PROGRAM_DIR) -- into
+ * C that dsp_cpu.c includes, twice:
+ * - per-word code (dsp_recomp_*, RECOMP_DSP_TRANSLATOR=threaded): each word
+ *   a label running exactly what dsp56k_execute_instruction would for it
+ *   (DSP_RECOMP_STEP), with the fetch, opcode lookup and dispatch resolved
+ *   here; each word is checked against program memory before it runs;
+ * - block code (dsp_rb_*, the default): runs of plain instructions as one
+ *   block, specialised C on registers held in locals where the form allows
+ *   (see "Specialised code"), DO loops and REP repeated in place, one
+ *   validity mark per block (dsp_cpu.c, DSP_RB_ENTER); where it cannot run
+ *   a word exactly it steps through the per-word code.
+ * Anything else goes back to the interpreter, so a missing, stale or
+ * different program only costs speed.
+ *
+ * Handler names come from the interpreter's own tables, read from its source;
+ * the opcode lookup and instruction lengths come from the interpreter itself.
+ * The output is rewritten only when it changes. Missing programs give stubs. */
+#include "dsp_cpu.c"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char *names_np[ARRAY_SIZE(nonparallel_opcodes)];
+static char *names_pm[16];
+static char *names_alu[256];
+
+static char *read_text(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) { fprintf(stderr, "dsp_recomp_gen: cannot read %s\n", path); exit(1); }
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char *s = malloc(n + 1);
+    if (!s || fread(s, 1, n, f) != (size_t)n) exit(1);
+    s[n] = 0;
+    fclose(f);
+    return s;
+}
+
+static char *ident(const char *p)
+{
+    while (*p == ' ' || *p == '\t') p++;
+    size_t n = 0;
+    while ((p[n] >= 'a' && p[n] <= 'z') || (p[n] >= 'A' && p[n] <= 'Z') || (p[n] >= '0' && p[n] <= '9') || p[n] == '_') n++;
+    char *s = malloc(n + 1);
+    memcpy(s, p, n);
+    s[n] = 0;
+    return s;
+}
+
+/* nonparallel_opcodes: one { "template", "name", dis, emu[, match] } per line. */
+static void read_nonparallel_names(const char *cpu_c)
+{
+    char *s = read_text(cpu_c);
+    char *p = strstr(s, "static const OpcodeEntry nonparallel_opcodes[] = {");
+    if (!p) { fprintf(stderr, "dsp_recomp_gen: opcode table not found\n"); exit(1); }
+    for (size_t i = 0; i < ARRAY_SIZE(nonparallel_opcodes); i++) {
+        p = strstr(p, "\n    { \"");
+        if (!p) { fprintf(stderr, "dsp_recomp_gen: opcode table entry %zu not found\n", i); exit(1); }
+        p += 8;
+        if (strncmp(p, nonparallel_opcodes[i].template, 24) || p[24] != '"') {
+            fprintf(stderr, "dsp_recomp_gen: opcode table line %zu does not match the compiled table\n", i);
+            exit(1);
+        }
+        p += 25;                     /* template and its closing quote */
+        p = strchr(p, '"') + 1;      /* name */
+        p = strchr(p, '"') + 1;
+        p = strchr(p, ',') + 1;      /* dis_func */
+        p = strchr(p, ',') + 1;      /* emu_func */
+        names_np[i] = ident(p);
+    }
+    free(s);
+}
+
+/* A table of function names: "<decl> = { a, b, c, ... };", comments allowed. */
+static void read_name_table(const char *text, const char *decl, char **names, int count)
+{
+    const char *p = strstr(text, decl);
+    if (!p) { fprintf(stderr, "dsp_recomp_gen: %s not found\n", decl); exit(1); }
+    p = strchr(p, '{') + 1;
+    for (int i = 0; i < count; i++) {
+        for (;;) {
+            while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' || *p == ',') p++;
+            if (p[0] == '/' && p[1] == '*') { p = strstr(p, "*/") + 2; continue; }
+            break;
+        }
+        names[i] = ident(p);
+        if (!*names[i]) { fprintf(stderr, "dsp_recomp_gen: %s entry %d unreadable\n", decl, i); exit(1); }
+        p += strlen(names[i]);
+    }
+}
+
+static void read_emu_names(const char *emu_inc)
+{
+    char *s = read_text(emu_inc);
+    read_name_table(s, "static const emu_func_t opcodes_parmove[16] = {", names_pm, 16);
+    read_name_table(s, "static const emu_func_t opcodes_alu[256] = {", names_alu, 256);
+    free(s);
+}
+
+typedef struct { char *buf; size_t len, cap; } Out;
+static void out(Out *o, const char *fmt, ...)
+{
+    va_list ap;
+    for (;;) {
+        va_start(ap, fmt);
+        int n = vsnprintf(o->buf + o->len, o->cap - o->len, fmt, ap);
+        va_end(ap);
+        if (n >= 0 && o->len + n < o->cap) { o->len += n; return; }
+        o->cap = o->cap * 2 + 4096;
+        o->buf = realloc(o->buf, o->cap);
+    }
+}
+
+static int program_word_compiled(const uint32_t *pram, uint32_t a, const OpcodeEntry **entry)
+{
+    uint32_t w = pram[a];
+    *entry = NULL;
+    if (w == 0 || w > 0xffffff) return 0;   /* unused memory (NOP) runs interpreted */
+    if (w >= 0x100000) return 1;
+    for (size_t i = 0; i < ARRAY_SIZE(nonparallel_opcodes); i++) {
+        if ((w & nonparallel_matches[i][0]) != nonparallel_matches[i][1]) continue;
+        if (nonparallel_opcodes[i].match_func && !nonparallel_opcodes[i].match_func(w)) continue;
+        *entry = &nonparallel_opcodes[i];
+        return nonparallel_opcodes[i].emu_func != NULL;
+    }
+    return 0;
+}
+
+/* One function per CHUNK words of program memory: inside one, labels and
+ * gotos; between them, dsp_recomp_<name>'s loop. A single function for the
+ * whole program grew past what the compiler optimizes (the decoding stopped
+ * folding: ~5 KB of code per instruction instead of ~0.3 KB). Keep chunks
+ * separate while letting the instruction helpers fold their constant words;
+ * MSVC otherwise spends excessive optimizer time/memory on MM3's race GP. */
+#define CHUNK 64
+
+static void emit_program(Out *o, const char *name, const uint32_t *pram, bool present)
+{
+    static dsp_core_t core;
+    static bool compiled[DSP_PRAM_SIZE];
+    static const OpcodeEntry *entries[DSP_PRAM_SIZE];
+    bool chunk_used[DSP_PRAM_SIZE / CHUNK] = {0};
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++) {
+        compiled[a] = present && program_word_compiled(pram, a, &entries[a]);
+        if (compiled[a]) chunk_used[a / CHUNK] = true;
+    }
+    memcpy(core.pram, pram, sizeof(core.pram));
+
+    for (uint32_t c = 0; c < DSP_PRAM_SIZE / CHUNK; c++) {
+        if (!chunk_used[c]) continue;
+        out(o, "DSP_RECOMP_LINKAGE DSP_RECOMP_NOINLINE int %s_%X(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running, int used)\n{\n", name, c);
+        out(o, "dispatch:\n    switch (dsp->pc) {\n");
+        for (uint32_t a = c * CHUNK; a < (c + 1) * CHUNK; a++)
+            if (compiled[a]) out(o, "    case 0x%03X: goto L_%03X;\n", a, a);
+        out(o, "    default: return used;\n    }\n");
+        for (uint32_t a = c * CHUNK; a < (c + 1) * CHUNK; a++) {
+            if (!compiled[a]) continue;
+            core.pc = a;
+            core.disasm_prev_inst_pc = 0xFFFFFFFF;
+            uint32_t len = disasm_instruction(&core, DSP_DISASM_MODE);
+            uint32_t next = a + (len ? len : 1);
+            uint32_t w = pram[a];
+            out(o, "L_%03X:\n    if (dsp->pram[0x%03X] != 0x%06X) return used;\n", a, a, w);
+            if (w >= 0x100000)
+                out(o, "    DSP_RECOMP_STEP(0x%06X, %s_x(dsp, 0x%06X, %s));\n", w, names_pm[(w >> 20) & 0xf], w, names_alu[w & 0xff]);
+            else
+                out(o, "    DSP_RECOMP_STEP(0x%06X, %s(dsp));\n", w, names_np[entries[a] - nonparallel_opcodes]);
+            if (next < (c + 1) * CHUNK && compiled[next])
+                out(o, "    if (dsp->pc == 0x%03X) goto L_%03X;\n", next, next);
+            out(o, "    goto dispatch;\n");
+        }
+        out(o, "}\n\n");
+    }
+
+    out(o, "DSP_RECOMP_LINKAGE int %s(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running)\n{\n", name);
+    out(o, "    int used = 0;\n    for (;;) {\n        int before = used;\n        switch (dsp->pc / %d) {\n", CHUNK);
+    for (uint32_t c = 0; c < DSP_PRAM_SIZE / CHUNK; c++)
+        if (chunk_used[c]) out(o, "        case %u: used = %s_%X(dsp, budget, dma_control, dma_running, used); break;\n", c, name, c);
+    out(o, "        default: break;\n        }\n");
+    out(o, "        if (used == before || DSP_RECOMP_STOPPED) return used;\n    }\n}\n\n");
+}
+/**********************************
+ *  Block code
+ **********************************/
+
+/* Plain data instructions: they leave the PC, loop, stack, mode and
+ * interrupt state alone (register operands are checked separately). */
+static const char *const plain_handlers[] = {
+    "emu_add_imm", "emu_add_long", "emu_sub_imm", "emu_sub_long", "emu_cmp_imm", "emu_cmp_long",
+    "emu_logic_imm", "emu_logic_long", "emu_asl_imm", "emu_asr_imm", "emu_logic_shift",
+    "emu_cmpu", "emu_clb", "emu_inc", "emu_dec", "emu_extract", "emu_merge", "emu_norm",
+    "emu_normf", "emu_mpyi", "emu_multiply_mixed", "emu_div", "emu_lua", "emu_lua_rel", "emu_tcc",
+    "emu_move_x_imm", "emu_move_y_imm", "emu_move_x_long",
+    "emu_bset_aa", "emu_bset_ea", "emu_bset_pp", "emu_bclr_aa", "emu_bclr_ea", "emu_bclr_pp",
+    "emu_bchg_aa", "emu_bchg_ea", "emu_bchg_pp", "emu_btst_aa", "emu_btst_ea", "emu_btst_pp",
+    "emu_bset_reg", "emu_bclr_reg", "emu_bchg_reg", "emu_btst_reg", "emu_nop",
+};
+
+/* Data and address registers X0..M7; anything above is control state. */
+static bool data_register(uint32_t reg) { return reg >= DSP_REG_X0 && reg <= DSP_REG_M7; }
+
+static bool plain_instruction(uint32_t w, const OpcodeEntry *entry)
+{
+    if (w >= 0x100000) return strcmp(names_alu[w & 0xff], "emu_undefined") != 0;
+    if (!entry || !entry->emu_func) return false;
+    const char *name = names_np[entry - nonparallel_opcodes];
+    bool listed = false;
+    for (size_t i = 0; i < ARRAY_SIZE(plain_handlers); i++)
+        if (!strcmp(name, plain_handlers[i])) listed = true;
+    if (!listed) return false;
+    if (!strcmp(name, "emu_move_x_long")) return data_register(w & 0x3f);
+    if (!strcmp(name, "emu_bset_reg") || !strcmp(name, "emu_bclr_reg") ||
+        !strcmp(name, "emu_bchg_reg") || !strcmp(name, "emu_btst_reg"))
+        return data_register((w >> 8) & 0x3f);
+    return true;
+}
+
+/* False only where the instruction cannot store to X memory (and so cannot
+ * reach the idle or DMA peripheral registers). */
+static bool may_write_x(uint32_t w, const OpcodeEntry *entry)
+{
+    if (w >= 0x100000) {
+        unsigned form = (w >> 20) & 0xf;
+        if (form == 2 || form == 3) return false;            /* register moves */
+        if (form >= 4 && form <= 7) {
+            if (w & (1u << 15)) return false;                /* memory to register */
+            if ((w & 0xf40000) != 0x400000 && ((w >> 19) & 1)) return false; /* Y: store */
+        }
+        if (form >= 8) return !(w & (1u << 15));             /* X:Y: stores X when W1 clear */
+        return true;
+    }
+    const char *name = names_np[entry - nonparallel_opcodes];
+    if (!strcmp(name, "emu_move_x_imm") || !strcmp(name, "emu_move_y_imm"))
+        return !strcmp(name, "emu_move_x_imm") && !((w >> 4) & 1);
+    if (!strcmp(name, "emu_move_x_long")) return !((w >> 6) & 1) && !((w >> 16) & 1);
+    if (!strncmp(name, "emu_bset_", 9) || !strncmp(name, "emu_bclr_", 9) || !strncmp(name, "emu_bchg_", 9))
+        return strcmp(name + 9, "reg") != 0;
+    return false;
+}
+
+static uint32_t probe_read(dsp_core_t *core, uint32_t address) { (void)core; (void)address; return 0; }
+static void probe_write(dsp_core_t *core, uint32_t address, uint32_t value) { (void)core; (void)address; (void)value; }
+
+/* Runs one plain instruction on scratch states: its length and cycles must
+ * not depend on them (the block code counts them in advance). Pointers stay
+ * inside the RAM arrays and modifiers linear. */
+static bool fixed_timing(uint32_t a, uint32_t w, bool gp, uint32_t len, uint16_t *cycles)
+{
+    static dsp_core_t s;
+    uint32_t seed = 0x2545f491u ^ w;
+    for (int trial = 0; trial < 6; trial++) {
+        memset(&s, 0, sizeof(s));
+        dsp56k_reset_cpu(&s);
+        s.is_gp = gp;
+        s.read_peripheral = probe_read;
+        s.write_peripheral = probe_write;
+        for (unsigned r = DSP_REG_X0; r <= DSP_REG_B1; r++) {
+            seed = seed * 1103515245u + 12345u;
+            s.registers[r] = (seed >> 4) & 0xffffff;
+        }
+        s.registers[DSP_REG_A2] = trial & 1 ? 0xff : 0;
+        s.registers[DSP_REG_B2] = trial & 2 ? 0xff : 0;
+        for (unsigned r = 0; r < 8; r++) {
+            seed = seed * 1103515245u + 12345u;
+            s.registers[DSP_REG_R0 + r] = (seed >> 8) & 0x3ff;
+            s.registers[DSP_REG_N0 + r] = (seed >> 20) & 7;
+        }
+        s.registers[DSP_REG_SR] = (seed >> 3) & 0xff;
+        s.pram[a] = w;
+        s.pc = a;
+        dsp56k_execute_instruction(&s);
+        if (s.pc != a + len || s.cur_inst_len != len || s.loop_rep || s.is_waiting || s.is_stopped ||
+            s.is_debugging || s.interrupt_counter || s.interrupt_state != DSP_INTERRUPT_NONE)
+            return false;
+        if (trial && s.instr_cycle != *cycles) return false;
+        *cycles = s.instr_cycle;
+    }
+    return true;
+}
+
+/**********************************
+ *  Specialised code
+ **********************************/
+
+/* Plain instructions of the forms below become C on locals g00..g27 and g39
+ * (SR) -- X0..M7 and SR held off the core while a block runs -- for the mode
+ * DSP_RB_MODE_MASK clear and linear modifiers on the address registers they
+ * update, which the block's entry checks (the scaling mode is read at run
+ * time, as the interpreter reads it). Memory goes through dsp_read_xy /
+ * dsp_write_xy as in the interpreter, extension words are read from P
+ * memory, and the ALU operations are dsp_cpu.c's dsp_rb_* helpers, compared
+ * here with the interpreter's functions before use (check_alu). */
+typedef struct { uint64_t rd, wr; unsigned mguard; } RegUse;
+#define SR_LOCAL 0x39
+static void use_r(RegUse *u, unsigned r) { u->rd |= 1ull << r; }
+static void use_w(RegUse *u, unsigned r) { u->wr |= 1ull << r; }
+static const unsigned acc_regs[2][3] = {
+    {DSP_REG_A2, DSP_REG_A1, DSP_REG_A0}, {DSP_REG_B2, DSP_REG_B1, DSP_REG_B0}};
+
+typedef struct {
+    int kind;                    /* 0 move, 1 add/sub/cmp, 2 mpy/mac, 3 clr, 4 tst, 5 tfr, 6 cmpm */
+    unsigned s1, s2, acc;
+    int subtract, store, negative, accumulate, round;
+} AluOp;
+
+static int data_source(const char *s)
+{
+    if (!strcmp(s, "x0")) return DSP_REG_X0;
+    if (!strcmp(s, "x1")) return DSP_REG_X1;
+    if (!strcmp(s, "y0")) return DSP_REG_Y0;
+    if (!strcmp(s, "y1")) return DSP_REG_Y1;
+    return -1;
+}
+
+static bool parse_alu(const char *name, AluOp *op)
+{
+    char buf[64], *tok[8];
+    int n = 0;
+    memset(op, 0, sizeof(*op));
+    if (strncmp(name, "emu_", 4) || strlen(name) >= sizeof(buf)) return false;
+    strcpy(buf, name + 4);
+    for (char *p = strtok(buf, "_"); p && n < 8; p = strtok(NULL, "_")) tok[n++] = p;
+    if (n == 1 && !strcmp(tok[0], "move")) { op->kind = 0; return true; }
+    int last_acc = n >= 2 && (!strcmp(tok[n - 1], "a") || !strcmp(tok[n - 1], "b"));
+    if (!last_acc) return false;
+    op->acc = tok[n - 1][0] == 'b';
+    if (n == 2 && !strcmp(tok[0], "clr")) { op->kind = 3; return true; }
+    if (n == 2 && !strcmp(tok[0], "tst")) { op->kind = 4; return true; }
+    if (n == 3 && data_source(tok[1]) >= 0) {
+        op->s1 = data_source(tok[1]);
+        if (!strcmp(tok[0], "add")) { op->kind = 1; op->store = 1; return true; }
+        if (!strcmp(tok[0], "sub")) { op->kind = 1; op->store = 1; op->subtract = 1; return true; }
+        if (!strcmp(tok[0], "cmp")) { op->kind = 1; op->subtract = 1; return true; }
+        if (!strcmp(tok[0], "tfr")) { op->kind = 5; return true; }
+        if (!strcmp(tok[0], "cmpm")) { op->kind = 6; return true; }
+        return false;
+    }
+    if (n == 5 && data_source(tok[2]) >= 0 && data_source(tok[3]) >= 0 &&
+        (!strcmp(tok[1], "p") || !strcmp(tok[1], "m"))) {
+        op->kind = 2;
+        op->s1 = data_source(tok[2]);
+        op->s2 = data_source(tok[3]);
+        op->negative = tok[1][0] == 'm';
+        if (!strcmp(tok[0], "mpy")) return true;
+        if (!strcmp(tok[0], "mpyr")) { op->round = 1; return true; }
+        if (!strcmp(tok[0], "mac")) { op->accumulate = 1; return true; }
+        if (!strcmp(tok[0], "macr")) { op->accumulate = 1; op->round = 1; return true; }
+    }
+    return false;
+}
+
+static void alu_text(Out *o, const AluOp *op, RegUse *u)
+{
+    const unsigned *r = acc_regs[op->acc];
+    switch (op->kind) {
+    case 0: return;
+    case 1:
+        out(o, "        dsp_rb_add(&g%02X, &g%02X, &g%02X, g%02X, %d, %d, &g39);\n", r[0], r[1], r[2], op->s1, op->subtract, op->store);
+        use_r(u, op->s1);
+        for (int i = 0; i < 3; i++) { use_r(u, r[i]); if (op->store) use_w(u, r[i]); }
+        break;
+    case 2:
+        out(o, "        dsp_rb_mul(&g%02X, &g%02X, &g%02X, g%02X, g%02X, %d, %d, %d, &g39);\n", r[0], r[1], r[2], op->s1, op->s2,
+            op->negative, op->accumulate, op->round);
+        use_r(u, op->s1); use_r(u, op->s2);
+        for (int i = 0; i < 3; i++) { use_w(u, r[i]); if (op->accumulate) use_r(u, r[i]); }
+        break;
+    case 3:
+        out(o, "        dsp_rb_clr(&g%02X, &g%02X, &g%02X, &g39);\n", r[0], r[1], r[2]);
+        for (int i = 0; i < 3; i++) use_w(u, r[i]);
+        break;
+    case 4:
+        out(o, "        dsp_rb_tst(g%02X, g%02X, g%02X, &g39);\n", r[0], r[1], r[2]);
+        for (int i = 0; i < 3; i++) use_r(u, r[i]);
+        break;
+    case 6:
+        out(o, "        dsp_rb_cmpm(g%02X, g%02X, g%02X, g%02X, &g39);\n", r[0], r[1], r[2], op->s1);
+        use_r(u, op->s1);
+        for (int i = 0; i < 3; i++) use_r(u, r[i]);
+        break;
+    case 5:
+        out(o, "        dsp_rb_tfr(&g%02X, &g%02X, &g%02X, g%02X);\n", r[0], r[1], r[2], op->s1);
+        use_r(u, op->s1);
+        for (int i = 0; i < 3; i++) use_w(u, r[i]);
+        return;
+    }
+    use_r(u, SR_LOCAL); use_w(u, SR_LOCAL);
+}
+
+/* Move source (dsp_move_source, emu_pm_read_accu24) into t. */
+static bool source_text(Out *o, unsigned reg, RegUse *u)
+{
+    if (reg == DSP_REG_A || reg == DSP_REG_B) {
+        const unsigned *r = acc_regs[reg - DSP_REG_A];
+        out(o, "        t = dsp_rb_accu24(g%02X, g%02X, g%02X, &g39);\n", r[0], r[1], r[2]);
+        use_r(u, r[2]);
+        use_r(u, r[0]); use_r(u, r[1]); use_r(u, SR_LOCAL); use_w(u, SR_LOCAL);
+        return true;
+    }
+    if (reg > DSP_REG_M7) return false;
+    use_r(u, reg);
+    if (reg >= DSP_REG_R0) out(o, "        t = g%02X & 0xffffffu;\n", reg);
+    else out(o, "        t = g%02X;\n", reg);
+    return true;
+}
+
+/* Register write of t (dsp_write_reg); M registers and above are not. */
+static bool write_text(Out *o, unsigned reg, RegUse *u)
+{
+    if (reg == DSP_REG_A || reg == DSP_REG_B) {
+        const unsigned *r = acc_regs[reg - DSP_REG_A];
+        out(o, "        g%02X = 0; g%02X = t; g%02X = t & (1u << 23) ? 0xff : 0x0;\n", r[2], r[1], r[0]);
+        for (int i = 0; i < 3; i++) use_w(u, r[i]);
+        return true;
+    }
+    if (reg >= DSP_REG_M0) return false;
+    uint32_t mask = (reg >= DSP_REG_X0 && reg <= DSP_REG_Y1) || reg >= DSP_REG_R0 ? 0xffffff : BITMASK(registers_mask[reg]);
+    out(o, "        g%02X = t & 0x%Xu;\n", reg, mask);
+    use_w(u, reg);
+    return true;
+}
+
+/* emu_calc_ea with linear modifiers: the address in ad; 1 for an immediate
+ * (the extension word itself). */
+static int ea_to(Out *o, const char *ad, uint32_t a, unsigned ea, RegUse *u)
+{
+    unsigned mode = (ea >> 3) & 7, n = ea & 7, R = DSP_REG_R0 + n, N = DSP_REG_N0 + n;
+    switch (mode) {
+    case 0: out(o, "        %s = g%02X; g%02X = (g%02X + (uint32_t)-(int32_t)g%02X) & 0xffffffu;\n", ad, R, R, R, N); break;
+    case 1: out(o, "        %s = g%02X; g%02X = (g%02X + g%02X) & 0xffffffu;\n", ad, R, R, R, N); break;
+    case 2: out(o, "        %s = g%02X; g%02X = (g%02X + 0xffffffffu) & 0xffffffu;\n", ad, R, R, R); break;
+    case 3: out(o, "        %s = g%02X; g%02X = (g%02X + 1u) & 0xffffffu;\n", ad, R, R, R); break;
+    case 4: out(o, "        %s = g%02X;\n", ad, R); use_r(u, R); return 0;
+    case 5: out(o, "        %s = (g%02X + g%02X) & 0xffffffu;\n", ad, R, N); use_r(u, R); use_r(u, N); u->mguard |= 1u << n; return 0;
+    case 6: out(o, "        %s = dsp->pram[0x%03X];\n", ad, a + 1); return n != 0;
+    case 7: out(o, "        g%02X = (g%02X + 0xffffffffu) & 0xffffffu; %s = g%02X;\n", R, R, ad, R); break;
+    }
+    use_r(u, R); use_w(u, R);
+    if (mode <= 1) use_r(u, N);
+    u->mguard |= 1u << n;
+    return 0;
+}
+static int ea_text(Out *o, uint32_t a, unsigned ea, RegUse *u) { return ea_to(o, "ad", a, ea, u); }
+
+/* emu_pm_8_x: X:ea and Y:ea moves together; registers raw, as there. */
+static bool pm8_text(Out *o, uint32_t a, uint32_t w, const AluOp *op, RegUse *u)
+{
+    static const unsigned d1[4] = {DSP_REG_X0, DSP_REG_X1, DSP_REG_A, DSP_REG_B};
+    static const unsigned d2[4] = {DSP_REG_Y0, DSP_REG_Y1, DSP_REG_A, DSP_REG_B};
+    unsigned ea1 = (w >> 8) & 0x1f;
+    if ((ea1 >> 3) == 0) ea1 |= 1 << 5;
+    unsigned ea2 = (w >> 13) & 3;
+    ea2 |= (w >> 17) & (3 << 3);
+    if ((ea1 & (1 << 2)) == 0) ea2 |= 1 << 2;
+    if ((ea2 >> 3) == 0) ea2 |= 1 << 5;
+    if (((ea1 >> 3) & 7) == 6 || ((ea2 >> 3) & 7) == 6) return false;
+    out(o, "        uint32_t xa = 0, ya = 0, t1 = 0, t2 = 0;\n");
+    ea_to(o, "xa", a, ea1, u);
+    ea_to(o, "ya", a, ea2, u);
+    unsigned r1 = d1[(w >> 18) & 3], r2 = d2[(w >> 16) & 3];
+    unsigned regs[2] = {r1, r2};
+    const char *vars[2] = {"t1", "t2"}, *addrs[2] = {"xa", "ya"};
+    bool load[2] = {(w & (1u << 15)) != 0, (w & (1u << 22)) != 0};
+    for (int i = 0; i < 2; i++) {
+        if (load[i]) {
+            out(o, "        %s = dsp_read_xy(dsp, %d, %s);\n", vars[i], i, addrs[i]);
+        } else if (regs[i] == DSP_REG_A || regs[i] == DSP_REG_B) {
+            const unsigned *r = acc_regs[regs[i] - DSP_REG_A];
+            out(o, "        %s = dsp_rb_accu24(g%02X, g%02X, g%02X, &g39);\n", vars[i], r[0], r[1], r[2]);
+            use_r(u, r[2]);
+            use_r(u, r[0]); use_r(u, r[1]); use_r(u, SR_LOCAL); use_w(u, SR_LOCAL);
+        } else {
+            out(o, "        %s = g%02X;\n", vars[i], regs[i]);
+            use_r(u, regs[i]);
+        }
+    }
+    alu_text(o, op, u);
+    for (int i = 0; i < 2; i++) {
+        if (!load[i]) {
+            out(o, "        dsp_write_xy(dsp, %d, %s, %s);\n", i, addrs[i], vars[i]);
+        } else if (regs[i] == DSP_REG_A || regs[i] == DSP_REG_B) {
+            const unsigned *r = acc_regs[regs[i] - DSP_REG_A];
+            out(o, "        g%02X = 0; g%02X = %s; g%02X = %s & (1u << 23) ? 0xff : 0x0;\n", r[2], r[1], vars[i], r[0], vars[i]);
+            for (int k = 0; k < 3; k++) use_w(u, r[k]);
+        } else {
+            out(o, "        g%02X = %s;\n", regs[i], vars[i]);
+            use_w(u, regs[i]);
+        }
+    }
+    return true;
+}
+
+/* The specialised C for one plain instruction, or false. */
+static bool special_text(Out *o, uint32_t a, uint32_t w, const OpcodeEntry *entry, RegUse *u)
+{
+    out(o, "    {\n        uint32_t ad = 0, t = 0;\n        (void)ad; (void)t;\n");
+    if (w >= 0x100000) {
+        AluOp op;
+        if (!parse_alu(names_alu[w & 0xff], &op)) return false;
+        unsigned form = (w >> 20) & 0xf;
+        if (form == 2 || form == 3) {
+            if (form == 2 && (w & 0xffff00) == 0x200000) {
+                alu_text(o, &op, u);
+            } else if (form == 2 && (w & 0xffe000) == 0x204000) {
+                ea_text(o, a, (w >> 8) & 0x1f, u);
+                alu_text(o, &op, u);
+            } else if (form == 2 && (w & 0xfc0000) == 0x200000) {
+                if (!source_text(o, (w >> 13) & 0x1f, u)) return false;
+                alu_text(o, &op, u);
+                if (!write_text(o, (w >> 8) & 0x1f, u)) return false;
+            } else {
+                unsigned reg = (w >> 16) & 0x1f;
+                uint32_t value = (w >> 8) & 0xff;
+                alu_text(o, &op, u);
+                if ((reg >= DSP_REG_X0 && reg <= DSP_REG_Y1) || reg == DSP_REG_A || reg == DSP_REG_B) value <<= 16;
+                if (reg == DSP_REG_A || reg == DSP_REG_B) {
+                    const unsigned *r = acc_regs[reg - DSP_REG_A];
+                    out(o, "        g%02X = 0; g%02X = 0x%06Xu; g%02X = 0x%02Xu;\n", r[2], r[1], value, r[0], value & (1u << 23) ? 0xff : 0);
+                    for (int i = 0; i < 3; i++) use_w(u, r[i]);
+                } else {
+                    uint32_t mask = reg >= DSP_REG_R0 ? 0xffffff : BITMASK(registers_mask[reg]);
+                    out(o, "        g%02X = 0x%06Xu;\n", reg, value & mask);
+                    use_w(u, reg);
+                }
+            }
+        } else if (form >= 4 && form <= 7 && (w & 0xf40000) != 0x400000) {
+            unsigned value = (w >> 8) & 0x3f, space = (w >> 19) & 1;
+            unsigned reg = ((w >> 16) & 7) | ((w >> 17) & 0x18);
+            int immediate = 0;
+            if (w & (1u << 14)) immediate = ea_text(o, a, value, u);
+            else out(o, "        ad = 0x%02X;\n", value);
+            if (w & (1u << 15)) {
+                if (immediate) out(o, "        t = ad;\n");
+                else out(o, "        t = dsp_read_xy(dsp, %u, ad);\n", space);
+                alu_text(o, &op, u);
+                if (!write_text(o, reg, u)) return false;
+            } else {
+                if (!source_text(o, reg, u)) return false;
+                alu_text(o, &op, u);
+                out(o, "        dsp_write_xy(dsp, %u, ad, t);\n", space);
+            }
+        } else if (form >= 8) {
+            if (!pm8_text(o, a, w, &op, u)) return false;
+        } else {
+            return false;
+        }
+    } else {
+        const char *name = names_np[entry - nonparallel_opcodes];
+        if (!strcmp(name, "emu_move_x_imm") || !strcmp(name, "emu_move_y_imm")) {
+            uint32_t xxx = (((w >> 11) & 0x3f) << 1) + ((w >> 6) & 1);
+            unsigned space = !strcmp(name, "emu_move_y_imm"), reg = w & 0xf, R = DSP_REG_R0 + ((w >> 8) & 7);
+            out(o, "        ad = (g%02X + 0x%Xu) & 0xffffffu;\n", R, dsp_signextend(7, xxx));
+            use_r(u, R);
+            if (!((w >> 4) & 1)) {
+                if (!source_text(o, reg, u)) return false;
+                out(o, "        dsp_write_xy(dsp, %u, ad, t);\n", space);
+            } else {
+                out(o, "        t = dsp_read_xy(dsp, %u, ad);\n", space);
+                if (!write_text(o, reg, u)) return false;
+            }
+        } else if (!strcmp(name, "emu_move_x_long")) {
+            unsigned space = (w >> 16) & 1, reg = w & 0x3f, R = DSP_REG_R0 + ((w >> 8) & 7);
+            out(o, "        ad = (g%02X + dsp->pram[0x%03X]) & 0xffffffu;\n", R, a + 1);
+            use_r(u, R);
+            if (!((w >> 6) & 1)) {
+                if (!source_text(o, reg, u)) return false;
+                out(o, "        dsp_write_xy(dsp, %u, ad, t);\n", space);
+            } else {
+                out(o, "        t = dsp_read_xy(dsp, %u, ad);\n", space);
+                if (!write_text(o, reg, u)) return false;
+            }
+        } else {
+            return false;
+        }
+    }
+    out(o, "    }\n");
+    return true;
+}
+
+
+/* Conditional branches that stay in their block when not taken: BCC and the
+ * non-subroutine BRCLR/BRSET forms on a register or a fixed address. The
+ * text sets br_taken and br_target; the block code leaves when taken. Their
+ * cycles do not depend on the outcome (emu_bcc_*, emu_brclr_*). */
+static bool branch_text(Out *o, uint32_t a, uint32_t w, const OpcodeEntry *entry, RegUse *u,
+                        uint16_t *cycles, uint32_t *len, int64_t *target)
+{
+    if (w >= 0x100000) return false;
+    const char *name = names_np[entry - nonparallel_opcodes];
+    *target = -1;
+    if (!strcmp(name, "emu_bcc_imm")) {
+        uint32_t xxx = (w & 0x1f) + ((w & (0xfu << 6)) >> 1);
+        *target = (a + dsp_signextend(9, xxx)) & 0xffffff;
+        out(o, "    br_taken = dsp_calc_cc(g39, %u);\n    br_target = 0x%06Xu;\n", (w >> 12) & 15, (uint32_t)*target);
+        *cycles = 2; *len = 1;
+    } else if (!strcmp(name, "emu_bcc_long")) {
+        out(o, "    br_taken = dsp_calc_cc(g39, %u);\n", w & 15);
+        if (w & 0x800) {
+            unsigned R = DSP_REG_R0 + ((w >> 8) & 7);
+            out(o, "    br_target = (0x%03Xu + g%02X) & 0xffffffu;\n", a, R);
+            use_r(u, R);
+            *len = 1;
+        } else {
+            out(o, "    br_target = (0x%03Xu + dsp->pram[0x%03X]) & 0xffffffu;\n", a, a + 1);
+            *len = 2;
+        }
+        *cycles = 2;
+    } else if (!strcmp(name, "emu_brclr_reg") || !strcmp(name, "emu_brset_reg")) {
+        unsigned reg = (w >> 8) & 0x3f, bit = w & 0x1f;
+        if (w & 0x010000) return false;                 /* BSCLR/BSSET */
+        if (reg == DSP_REG_A || reg == DSP_REG_B) {
+            const unsigned *r = acc_regs[reg - DSP_REG_A];
+            out(o, "    br_taken = dsp_rb_accu24(g%02X, g%02X, g%02X, &g39);\n", r[0], r[1], r[2]);
+            for (int i = 0; i < 3; i++) use_r(u, r[i]);
+            use_w(u, SR_LOCAL);
+        } else if (reg >= DSP_REG_X0 && reg <= DSP_REG_N7) {
+            out(o, "    br_taken = g%02X;\n", reg);
+            use_r(u, reg);
+        } else {
+            return false;
+        }
+        out(o, "    br_taken = %s(br_taken & (1u << %u));\n", name[6] == 'c' ? "!" : "!!", bit);
+        out(o, "    br_target = (0x%03Xu + dsp->pram[0x%03X]) & 0xffffffu;\n", a, a + 1);
+        *cycles = 6; *len = 2;
+    } else if (!strcmp(name, "emu_brclr_pp") || !strcmp(name, "emu_brset_pp")) {
+        if ((w & 0x0f0000) == 0x0d0000 || (w & 0x0fc080) == 0x048080) return false;   /* BSCLR/BSSET */
+        if ((w & 0x0ec080) == 0x0c8000) return false;                                   /* EA form */
+        unsigned field = (w >> 8) & 0x3f, bit = w & 0x1f, space = (w >> 6) & 1;
+        uint32_t address = !(w & 0x080000) ? 0xffff80 + field : (w & 0x80) ? field : 0xffffc0 + field;
+        out(o, "    br_taken = %s(dsp_read_xy(dsp, %u, 0x%06Xu) & (1u << %u));\n", name[6] == 'c' ? "!" : "!!",
+            space, address, bit);
+        out(o, "    br_target = (0x%03Xu + dsp->pram[0x%03X]) & 0xffffffu;\n", a, a + 1);
+        *cycles = 6; *len = 2;
+    } else {
+        return false;
+    }
+    use_r(u, SR_LOCAL);
+    return true;
+}
+
+/* An unconditional jump's target where the word fixes it (no extension). */
+static int64_t fixed_target(uint32_t a, uint32_t w, const OpcodeEntry *entry)
+{
+    if (w >= 0x100000 || !entry) return -1;
+    const char *name = names_np[entry - nonparallel_opcodes];
+    if (!strcmp(name, "emu_bra_imm") || !strcmp(name, "emu_bsr_imm") || !strcmp(name, "emu_bcc_imm") ||
+        !strcmp(name, "emu_bscc_imm")) {
+        uint32_t xxx = (w & 0x1f) + ((w & (0xfu << 6)) >> 1);
+        return (a + dsp_signextend(9, xxx)) & 0xffffff;
+    }
+    if (!strcmp(name, "emu_jmp_imm") || !strcmp(name, "emu_jsr_imm") || !strcmp(name, "emu_jcc_imm") ||
+        !strcmp(name, "emu_jscc_imm"))
+        return w & 0xfff;
+    return -1;
+}
+
+/* A plain instruction left to its interpreter handler inside a block with
+ * locals must not change the modifier registers the block's entry checked. */
+static bool writes_modifier(uint32_t w, const OpcodeEntry *entry)
+{
+    if (w >= 0x100000) return false;
+    const char *name = names_np[entry - nonparallel_opcodes];
+    if (!strcmp(name, "emu_move_x_long")) return ((w >> 6) & 1) && (w & 0x3f) >= DSP_REG_M0;
+    if (!strcmp(name, "emu_bset_reg") || !strcmp(name, "emu_bclr_reg") || !strcmp(name, "emu_bchg_reg"))
+        return ((w >> 8) & 0x3f) >= DSP_REG_M0;
+    return false;
+}
+
+/* Every ALU operation the specialised code uses against the interpreter's
+ * own function, on random register states in the guarded mode. */
+static void check_alu(void)
+{
+    static dsp_core_t ref;
+    uint32_t seed = 12345;
+    unsigned checked = 0;
+    for (unsigned i = 0; i < 256; i++) {
+        AluOp op;
+        if (!parse_alu(names_alu[i], &op) || op.kind == 0) continue;
+        for (int trial = 0; trial < 20000; trial++) {
+            memset(ref.registers, 0, sizeof(ref.registers));
+            for (unsigned r = DSP_REG_X0; r <= DSP_REG_B1; r++) {
+                seed = seed * 1103515245u + 12345u;
+                uint32_t v = (seed >> 3) & 0xffffff;
+                static const uint32_t edge[] = {0, 1, 0x7fffff, 0x800000, 0xffffff, 0x400000, 0xc00000, 0x3fffff, 0x800001, 0x7ffffe, 0x000080, 0xffff80};
+                if (trial % 3 == 1) v = (seed & 0x10000) ? 0x7fffff ^ (v & 0xff) : 0x800000 | (v & 0x3);
+                else if (trial % 3 == 2) v = edge[(seed >> 20) % 12];
+                ref.registers[r] = v;
+            }
+            seed = seed * 1103515245u + 12345u;
+            ref.registers[DSP_REG_A2] = (seed >> 7) & 1 ? 0xff : (seed >> 9) & 0xff;
+            ref.registers[DSP_REG_B2] = (seed >> 8) & 1 ? 0 : (seed >> 17) & 0xff;
+            ref.registers[DSP_REG_SR] = ((seed >> 5) & 0xffffff) & ~DSP_RB_MODE_MASK;
+            uint32_t g[DSP_REG_MAX];
+            memcpy(g, ref.registers, sizeof(g));
+            const unsigned *r = acc_regs[op.acc];
+            switch (op.kind) {
+            case 1: dsp_rb_add(&g[r[0]], &g[r[1]], &g[r[2]], g[op.s1], op.subtract, op.store, &g[SR_LOCAL]); break;
+            case 2: dsp_rb_mul(&g[r[0]], &g[r[1]], &g[r[2]], g[op.s1], g[op.s2], op.negative, op.accumulate, op.round, &g[SR_LOCAL]); break;
+            case 3: dsp_rb_clr(&g[r[0]], &g[r[1]], &g[r[2]], &g[SR_LOCAL]); break;
+            case 4: dsp_rb_tst(g[r[0]], g[r[1]], g[r[2]], &g[SR_LOCAL]); break;
+            case 5: dsp_rb_tfr(&g[r[0]], &g[r[1]], &g[r[2]], g[op.s1]); break;
+            case 6: dsp_rb_cmpm(g[r[0]], g[r[1]], g[r[2]], g[op.s1], &g[SR_LOCAL]); break;
+            }
+            opcodes_alu[i](&ref);
+            if (memcmp(g, ref.registers, sizeof(g))) {
+                fprintf(stderr, "dsp_recomp_gen: %s differs from its specialised form\n", names_alu[i]);
+                exit(1);
+            }
+        }
+        checked++;
+    }
+    /* The accumulator read of the moves, against emu_pm_read_accu24. */
+    for (int trial = 0; trial < 200000; trial++) {
+        seed = seed * 1103515245u + 12345u;
+        memset(ref.registers, 0, sizeof(ref.registers));
+        ref.registers[DSP_REG_A2] = trial & 1 ? (seed >> 24) : (seed & 2 ? 0xff : 0);
+        ref.registers[DSP_REG_A1] = (seed >> 1) & 0xffffff;
+        ref.registers[DSP_REG_A0] = (seed * 13) & 0xffffff;
+        ref.registers[DSP_REG_SR] = (seed * 7) & 0xffffff & ~DSP_RB_MODE_MASK;
+        uint32_t sr = ref.registers[DSP_REG_SR], value, expected;
+        value = dsp_rb_accu24(ref.registers[DSP_REG_A2], ref.registers[DSP_REG_A1], ref.registers[DSP_REG_A0], &sr);
+        emu_pm_read_accu24(&ref, DSP_REG_A, &expected);
+        if (value != expected || sr != ref.registers[DSP_REG_SR]) {
+            fprintf(stderr, "dsp_recomp_gen: accumulator read differs from emu_pm_read_accu24\n");
+            exit(1);
+        }
+    }
+    fprintf(stderr, "dsp_recomp_gen: %u specialised ALU operations match the interpreter\n", checked);
+}
+
+typedef struct {
+    bool compiled, plain, xwrite;
+    uint32_t len;
+    uint16_t cycles;
+    uint32_t head, end;          /* block: first word, end of its last opcode word */
+    bool last;                   /* last instruction of its block */
+    unsigned pre;                /* fixed cycles from here up to the block's last instruction */
+    const OpcodeEntry *entry;
+    char *special;               /* specialised C, or NULL for the handler call */
+    RegUse use;                  /* its registers */
+    RegUse block;                /* the block's locals (at its head word) */
+    bool locals;                 /* the block keeps registers in locals */
+    bool branch;                 /* conditional exit (branch_text) */
+    int64_t target;              /* its or an ender's fixed target, or -1 */
+} WordInfo;
+static WordInfo infos[2][DSP_PRAM_SIZE];
+
+static void plan_blocks(int prog, const uint32_t *pram, bool present, unsigned *stats)
+{
+    static dsp_core_t core;
+    WordInfo *info = infos[prog];
+    memset(info, 0, sizeof(infos[prog]));
+    memcpy(core.pram, pram, sizeof(core.pram));
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++) {
+        info[a].compiled = present && program_word_compiled(pram, a, &info[a].entry);
+        info[a].head = 0xffff;
+        if (!info[a].compiled) continue;
+        core.pc = a;
+        core.disasm_prev_inst_pc = 0xFFFFFFFF;
+        uint32_t len = disasm_instruction(&core, DSP_DISASM_MODE);
+        info[a].len = len ? len : 1;
+        free(info[a].special);
+        info[a].special = NULL;
+        info[a].branch = false;
+        info[a].target = fixed_target(a, pram[a], info[a].entry);
+        {
+            Out text = {0};
+            RegUse use = {0};
+            uint16_t cycles;
+            uint32_t blen;
+            int64_t target;
+            if (branch_text(&text, a, pram[a], info[a].entry, &use, &cycles, &blen, &target) && blen == info[a].len) {
+                info[a].plain = info[a].branch = true;
+                info[a].xwrite = false;
+                info[a].cycles = cycles;
+                info[a].special = text.buf;
+                info[a].use = use;
+                info[a].target = target;
+                stats[2]++;
+                continue;
+            }
+            free(text.buf);
+        }
+        info[a].plain = plain_instruction(pram[a], info[a].entry) &&
+                        fixed_timing(a, pram[a], prog == 0, info[a].len, &info[a].cycles);
+        info[a].xwrite = info[a].plain && may_write_x(pram[a], info[a].entry);
+        if (info[a].plain) {
+            Out text = {0};
+            RegUse use = {0};
+            if (special_text(&text, a, pram[a], info[a].entry, &use)) {
+                info[a].special = text.buf;
+                info[a].use = use;
+                stats[2]++;
+            } else {
+                free(text.buf);
+            }
+        }
+    }
+    /* Blocks: plain instructions in address order within a chunk, ending at
+     * the first other one, a word that is not compiled, the chunk's end, or
+     * an extension word that is also compiled (entered as an instruction). */
+    static bool assigned[DSP_PRAM_SIZE];
+    memset(assigned, 0, sizeof(assigned));
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++) {
+        if (!info[a].compiled || assigned[a]) continue;
+        uint32_t chunk_end = (a / CHUNK + 1) * CHUNK, list[CHUNK], n = 0, cur = a;
+        for (;;) {
+            list[n++] = cur;
+            assigned[cur] = true;
+            uint32_t next = cur + info[cur].len;
+            bool hidden = false;
+            for (uint32_t x = cur + 1; x < next && x < DSP_PRAM_SIZE; x++)
+                if (info[x].compiled) hidden = true;
+            if (!info[cur].plain || hidden || next >= chunk_end || !info[next].compiled) break;
+            cur = next;
+        }
+        RegUse block = {0};
+        bool locals = false, blocked = false;
+        for (uint32_t i = 0; i < n; i++) {
+            const WordInfo *w = &info[list[i]];
+            if (w->special) {
+                locals = true;
+                block.rd |= w->use.rd | w->use.wr;
+                block.wr |= w->use.wr;
+                block.mguard |= w->use.mguard;
+            } else if (w->plain && writes_modifier(pram[list[i]], w->entry)) {
+                blocked = true;
+            }
+        }
+        if (blocked) {
+            for (uint32_t i = 0; i < n; i++) { free(info[list[i]].special); info[list[i]].special = NULL; }
+            locals = false;
+            memset(&block, 0, sizeof(block));
+        }
+        if (locals) stats[3]++;
+        unsigned pre = 0;
+        for (uint32_t i = n; i-- > 0;) {
+            WordInfo *w = &info[list[i]];
+            if (i < n - 1) pre += w->cycles;
+            w->head = a;
+            w->end = list[n - 1] + 1;
+            w->last = i == n - 1;
+            w->pre = pre;
+            w->block = block;
+            w->locals = locals;
+        }
+        stats[0]++;
+        stats[1] += n;
+    }
+}
+
+/* The opcode words each block's validity mark covers, and the block
+ * holding each word: a P write clears that block's mark. */
+static void emit_tables(Out *o, const char *name, int prog, const uint32_t *pram)
+{
+    const WordInfo *info = infos[prog];
+    out(o, "static const uint32_t %s_image[DSP_PRAM_SIZE] = {", name);
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++)
+        out(o, "%s0x%06X,", a % 8 ? "" : "\n   ", info[a].compiled ? pram[a] : 0);
+    out(o, "\n};\nstatic const uint16_t %s_head[DSP_PRAM_SIZE] = {", name);
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++)
+        out(o, "%s0x%04X,", a % 8 ? "" : "\n   ", info[a].compiled ? info[a].head : 0xffff);
+    out(o, "\n};\n\n");
+}
+
+/* The entry test of a block with locals: the mode its code assumes. */
+static void guard_text(Out *o, const RegUse *block)
+{
+    out(o, "(dsp->registers[DSP_REG_SR] & DSP_RB_MODE_MASK)");
+    for (unsigned r = 0; r < 8; r++)
+        if (block->mguard & (1u << r))
+            out(o, " ||\n        (uint16_t)dsp->registers[DSP_REG_M0 + %u] != 0xffff", r);
+}
+
+static unsigned block_mark(const WordInfo *info, const uint32_t *pram, uint32_t h)
+{
+    return pram[h] >= 0x100000 ? (unsigned)ARRAY_SIZE(nonparallel_opcodes)
+                               : (unsigned)(info[h].entry - nonparallel_opcodes);
+}
+
+/* A REP whose repeated word the block code can run natively (DSP_RB_REP_READY):
+ * the next word, first of its own block in this chunk, specialised, with
+ * no peripheral store or branch. */
+static bool native_rep(const WordInfo *info, const uint32_t *pram, uint32_t a, uint32_t hi)
+{
+    if (pram[a] >= 0x100000 || !info[a].entry) return false;
+    if (strncmp(names_np[info[a].entry - nonparallel_opcodes], "emu_rep_", 8)) return false;
+    uint32_t x = a + 1;
+    return x < hi && info[x].compiled && info[x].plain && info[x].special && !info[x].xwrite &&
+           !info[x].branch && info[x].head == x && info[x].locals;
+}
+
+static void emit_registers(Out *o, uint64_t set, bool store)
+{
+    for (unsigned r = 0; r < DSP_REG_MAX; r++)
+        if (set & (1ull << r)) {
+            if (store) out(o, "    dsp->registers[0x%02X] = g%02X;\n", r, r);
+            else out(o, "    g%02X = dsp->registers[0x%02X];\n", r, r);
+        }
+}
+
+static void emit_blocks(Out *o, const char *name, const char *threaded, int prog, const uint32_t *pram)
+{
+    const WordInfo *info = infos[prog];
+    bool chunk_used[DSP_PRAM_SIZE / CHUNK] = {0};
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++)
+        if (info[a].compiled) chunk_used[a / CHUNK] = true;
+    for (uint32_t c = 0; c < DSP_PRAM_SIZE / CHUNK; c++) {
+        if (!chunk_used[c]) continue;
+        uint32_t lo = c * CHUNK, hi = lo + CHUNK;
+        out(o, "static DSP_RECOMP_NOINLINE int %s_%X(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running, int used)\n{\n", name, c);
+        out(o, "    uint32_t la1 = 0xffffffffu, br_taken, br_target;\n    int cyc = 0;\n    (void)br_taken; (void)br_target;\n");
+        uint64_t chunk_regs = 0;
+        for (uint32_t a = lo; a < hi; a++)
+            if (info[a].compiled && info[a].locals) chunk_regs |= info[a].block.rd | info[a].block.wr;
+        for (unsigned r = 0; r < DSP_REG_MAX; r++)
+            if (chunk_regs & (1ull << r)) out(o, "    uint32_t g%02X;\n", r);
+        out(o, "dispatch:\n    switch (dsp->pc) {\n");
+        for (uint32_t a = lo; a < hi; a++)
+            if (info[a].compiled) out(o, "    case 0x%03X: goto E_%03X;\n", a, a);
+        out(o, "    default: return used;\n    }\n");
+        out(o, "loop_end:\n    DSP_RB_LOOP_END();\n    goto dispatch;\n");
+        for (uint32_t a = lo; a < hi; a++) {
+            if (!info[a].compiled) continue;
+            const WordInfo *w = &info[a];
+            uint32_t h = w->head;
+            unsigned mark = pram[h] >= 0x100000 ? (unsigned)ARRAY_SIZE(nonparallel_opcodes)
+                                                : (unsigned)(info[h].entry - nonparallel_opcodes);
+            out(o, "E_%03X:\n    DSP_RB_ENTER(0x%03X, 0x%03X, %d, %u, %u, %s_%X);\n",
+                a, h, w->end, prog, mark, w->pre, threaded, c);
+            if (w->locals) {
+                out(o, "    if ((dsp->registers[DSP_REG_SR] & DSP_RB_MODE_MASK)");
+                for (unsigned r = 0; r < 8; r++)
+                    if (w->block.mguard & (1u << r))
+                        out(o, " ||\n        (uint16_t)dsp->registers[DSP_REG_M0 + %u] != 0xffff", r);
+                out(o, ")\n        return %s_%X(dsp, budget, dma_control, dma_running, used);\n", threaded, c);
+                emit_registers(o, w->block.rd | w->block.wr, false);
+            }
+            out(o, "    goto L_%03X;\n", a);
+        }
+        for (uint32_t a = lo; a < hi; a++) {
+            if (!info[a].compiled || !native_rep(info, pram, a, hi)) continue;
+            uint32_t x = a + 1;
+            const WordInfo *xi = &info[x];
+            out(o, "P_%03X:\n", x);
+            emit_registers(o, xi->block.rd | xi->block.wr, false);
+            out(o, "    la1 = (dsp->registers[DSP_REG_SR] & (1u << DSP_SR_LF)) ? dsp->registers[DSP_REG_LA] + 1 : 0xffffffffu;\n"
+                   "    cyc = 0;\n    {\n        uint32_t rep_left = dsp->registers[DSP_REG_LC] - 1;\n"
+                   "        while (rep_left--) {\n%s        cyc += %u;\n        }\n    }\n"
+                   "    dsp->registers[DSP_REG_LC] = dsp->registers[DSP_REG_LCSAVE];\n    dsp->loop_rep = 0;\n"
+                   "    goto L_%03X;\n", xi->special, xi->cycles, x);
+        }
+        for (uint32_t a = lo; a < hi; a++) {
+            if (!info[a].compiled) continue;
+            const WordInfo *w = &info[a];
+            uint32_t word = pram[a], next = a + w->len, h = w->head;
+            char call[256];
+            if (word >= 0x100000)
+                snprintf(call, sizeof(call), "%s_x(dsp, 0x%06X, %s)", names_pm[(word >> 20) & 0xf], word, names_alu[word & 0xff]);
+            else
+                snprintf(call, sizeof(call), "%s(dsp)", names_np[w->entry - nonparallel_opcodes]);
+            out(o, "L_%03X:\n", a);
+            bool next_entry = next < hi && info[next].compiled;
+            if (!w->plain) {
+                if (w->locals) emit_registers(o, w->block.wr, true);
+                if (native_rep(info, pram, a, hi)) {
+                    uint32_t x = a + 1;
+                    const WordInfo *xi = &info[x];
+                    out(o, "    DSP_RB_FLUSH();\n    dsp->pc = 0x%03X;\n    DSP_RB_REP_STEP(0x%06X, %s);\n", a, word, call);
+                    out(o, "    if (DSP_RB_REP_READY(0x%03X, 0x%03X, 0x%03X, %d, %u, %u, %u) && !(", x, xi->head, xi->end, prog,
+                        block_mark(info, pram, x), xi->cycles, xi->pre);
+                    guard_text(o, &xi->block);
+                    out(o, "))\n        goto P_%03X;\n    if (DSP_RECOMP_STOPPED) return used;\n", x);
+                } else {
+                    out(o, "    DSP_RB_FLUSH();\n    dsp->pc = 0x%03X;\n    DSP_RECOMP_STEP(0x%06X, %s);\n", a, word, call);
+                }
+                if (next_entry) out(o, "    if (dsp->pc == 0x%03X) goto E_%03X;\n", next, next);
+                if (w->target >= lo && w->target < hi && info[w->target].compiled && (uint32_t)w->target != next)
+                    out(o, "    if (dsp->pc == 0x%03X) goto E_%03X;\n", (uint32_t)w->target, (uint32_t)w->target);
+                out(o, "    goto dispatch;\n");
+                continue;
+            }
+            if (w->special) {
+                out(o, "%s", w->special);
+            } else {
+                if (w->locals) emit_registers(o, w->block.wr, true);
+                if (word < 0x100000)
+                    out(o, "    dsp->cur_inst = 0x%06X;\n    dsp->cur_inst_len = 1;\n    dsp->pc = 0x%03X;\n", word, a);
+                else if (w->len > 1)
+                    out(o, "    dsp->cur_inst_len = 1;\n    dsp->pc = 0x%03X;\n", a);
+                out(o, "    %s;\n", call);
+                if (w->locals) emit_registers(o, w->block.rd | w->block.wr, false);
+            }
+            out(o, "    cyc += %u;\n", w->cycles);
+            Out store = {0};
+            if (w->locals) emit_registers(&store, w->block.wr, true);
+            const char *flush = store.buf ? store.buf : "";
+            if (w->branch) {
+                out(o, "    if (br_taken) {\n%s        DSP_RB_SAVE(br_target, 0x%06X, 0, %u);\n"
+                       "        if (la1 == br_target) goto loop_end;\n", flush, word, w->cycles);
+                if (w->target >= lo && w->target < hi && info[w->target].compiled)
+                    out(o, "        goto E_%03X;\n", (uint32_t)w->target);
+                else
+                    out(o, "        goto dispatch;\n");
+                out(o, "    }\n");
+            }
+            /* A DO loop ending here and starting at this block's head goes
+             * round without leaving the block (DSP_RB_LOOP_AGAIN). */
+            char again[128];
+            snprintf(again, sizeof(again), "%s(0x%03X, %u)", w->xwrite ? "DSP_RB_LOOP_AGAIN_X" : "DSP_RB_LOOP_AGAIN",
+                     h, info[h].pre);
+            if (w->last) {
+                out(o, "    if (la1 == 0x%03X && %s) goto L_%03X;\n", next, again, h);
+                out(o, "%s    DSP_RB_SAVE(0x%03X, 0x%06X, %u, %u);\n    if (la1 == 0x%03X) goto loop_end;\n",
+                    flush, next, word, w->len, w->cycles, next);
+                free(store.buf);
+                if (next_entry) out(o, "    goto E_%03X;\n", next);
+                else out(o, "    goto dispatch;\n");
+                continue;
+            }
+            out(o, "    if (la1 == 0x%03X) {\n        if (%s) goto L_%03X;\n"
+                   "%s        DSP_RB_SAVE(0x%03X, 0x%06X, %u, %u);\n        goto loop_end;\n    }\n",
+                next, again, h, flush, next, word, w->len, w->cycles);
+            if (w->xwrite)
+                out(o, "    if (DSP_RB_PERIPHERAL_STOP) {\n%s        DSP_RB_SAVE(0x%03X, 0x%06X, %u, %u);\n        goto dispatch;\n    }\n",
+                    flush, next, word, w->len, w->cycles);
+            free(store.buf);
+        }
+        out(o, "}\n\n");
+    }
+    out(o, "static int %s(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running)\n{\n", name);
+    out(o, "    int used = 0;\n    for (;;) {\n        int before = used;\n        switch (dsp->pc / %d) {\n", CHUNK);
+    for (uint32_t c = 0; c < DSP_PRAM_SIZE / CHUNK; c++)
+        if (chunk_used[c]) out(o, "        case %u: used = %s_%X(dsp, budget, dma_control, dma_running, used); break;\n", c, name, c);
+    out(o, "        default: break;\n        }\n");
+    out(o, "        if (used == before || DSP_RECOMP_STOPPED) return used;\n    }\n}\n\n");
+}
+
+static void emit_prototypes(Out *o, const char *name, const uint32_t *pram, bool present)
+{
+    const OpcodeEntry *entry;
+    bool chunk_used[DSP_PRAM_SIZE / CHUNK] = {0};
+    for (uint32_t a = 0; a < DSP_PRAM_SIZE; a++)
+        if (present && program_word_compiled(pram, a, &entry)) chunk_used[a / CHUNK] = true;
+    for (uint32_t c = 0; c < DSP_PRAM_SIZE / CHUNK; c++)
+        if (chunk_used[c])
+            out(o, "int %s_%X(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running, int used);\n", name, c);
+    out(o, "int %s(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running);\n", name);
+}
+
+static bool read_program(const char *dir, const char *file, uint32_t *pram)
+{
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/%s", dir, file);
+    FILE *f = fopen(path, "rb");
+    if (!f) return false;
+    bool ok = fread(pram, 4, DSP_PRAM_SIZE, f) == DSP_PRAM_SIZE;
+    fclose(f);
+    if (!ok) fprintf(stderr, "dsp_recomp_gen: %s is not a %d-word program; ignored\n", path, DSP_PRAM_SIZE);
+    return ok;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 5) {
+        fprintf(stderr, "usage: dsp_recomp_gen <dsp_cpu.c> <dsp_emu.c.inc> <out.inc> <program dir>\n");
+        return 2;
+    }
+    static dsp_core_t init;
+    dsp56k_reset_cpu(&init);          /* fills nonparallel_matches */
+    read_nonparallel_names(argv[1]);
+    read_emu_names(argv[2]);
+
+    static uint32_t gp[DSP_PRAM_SIZE], ep[DSP_PRAM_SIZE];
+    bool have_gp = read_program(argv[4], "gp.p.bin", gp);
+    bool have_ep = read_program(argv[4], "ep.p.bin", ep);
+
+    Out o = {0};
+    out(&o, "/* Generated by dsp_recomp_gen from %s (gp %s, ep %s). Do not edit. */\n\n",
+        argv[4], have_gp ? "recompiled" : "absent", have_ep ? "recompiled" : "absent");
+    out(&o, "#if defined(_MSC_VER)\n#define DSP_RECOMP_NOINLINE __declspec(noinline)\n"
+        "#elif defined(__GNUC__) || defined(__clang__)\n#define DSP_RECOMP_NOINLINE __attribute__((noinline))\n"
+        "#else\n#define DSP_RECOMP_NOINLINE\n#endif\n\n");
+    /* DSP_RECOMP_SPLIT: the threaded code builds in its own unit
+     * (dsp_recomp_threaded.c, DSP_RECOMP_THREADED_UNIT), the block code with
+     * dsp_cpu.c; without it both are static parts of dsp_cpu.c. */
+    out(&o, "#ifdef DSP_RECOMP_SPLIT\n#define DSP_RECOMP_LINKAGE\n#else\n#define DSP_RECOMP_LINKAGE static\n#endif\n\n");
+    check_alu();
+    unsigned stats[2][4] = {{0}};
+    plan_blocks(0, gp, have_gp, stats[0]);
+    plan_blocks(1, ep, have_ep, stats[1]);
+    out(&o, "#if !defined(DSP_RECOMP_SPLIT) || defined(DSP_RECOMP_THREADED_UNIT)\n");
+    emit_program(&o, "dsp_recomp_gp", gp, have_gp);
+    emit_program(&o, "dsp_recomp_ep", ep, have_ep);
+    out(&o, "#endif\n\n#ifndef DSP_RECOMP_THREADED_UNIT\n#ifdef DSP_RECOMP_SPLIT\n");
+    emit_prototypes(&o, "dsp_recomp_gp", gp, have_gp);
+    emit_prototypes(&o, "dsp_recomp_ep", ep, have_ep);
+    out(&o, "#endif\n\n");
+    emit_tables(&o, "dsp_rb_gp", 0, gp);
+    emit_tables(&o, "dsp_rb_ep", 1, ep);
+    emit_blocks(&o, "dsp_rb_gp", "dsp_recomp_gp", 0, gp);
+    emit_blocks(&o, "dsp_rb_ep", "dsp_recomp_ep", 1, ep);
+    out(&o, "#endif /* !DSP_RECOMP_THREADED_UNIT */\n");
+    fprintf(stderr, "dsp_recomp_gen: blocks gp %u (%u words, %u specialised, %u with locals), "
+            "ep %u (%u words, %u specialised, %u with locals)\n",
+            stats[0][0], stats[0][1], stats[0][2], stats[0][3], stats[1][0], stats[1][1], stats[1][2], stats[1][3]);
+
+    FILE *f = fopen(argv[3], "rb");
+    if (f) {
+        char *old = malloc(o.len + 1);
+        size_t n = fread(old, 1, o.len + 1, f);
+        fclose(f);
+        bool same = n == o.len && !memcmp(old, o.buf, o.len);
+        free(old);
+        if (same) return 0;
+    }
+    f = fopen(argv[3], "wb");
+    if (!f || fwrite(o.buf, 1, o.len, f) != o.len || fclose(f)) {
+        fprintf(stderr, "dsp_recomp_gen: cannot write %s\n", argv[3]);
+        return 1;
+    }
+    printf("dsp_recomp_gen: wrote %s (gp %s, ep %s)\n", argv[3], have_gp ? "recompiled" : "absent", have_ep ? "recompiled" : "absent");
+    return 0;
+}
