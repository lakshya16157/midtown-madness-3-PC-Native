diff --git a/tests/input_bindings/parser_test.c b/tests/input_bindings/parser_test.c
new file mode 100644
index 0000000..242c288
--- /dev/null
+++ b/tests/input_bindings/parser_test.c
@@ -0,0 +1,60 @@
+#include "../../src/input/input_bindings.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "Binding parser line %d: %s\n", __LINE__, #c); exit(1); \
+} } while (0)
+
+int main(void)
+{
+    XbInputBindings map, original;
+    xb_bindings_defaults(&map);
+    original = map;
+    CHECK(map.pad[XB_PAD_BLACK] == 5 && map.pad[XB_PAD_WHITE] == 4);
+    CHECK(xb_bindings_parse(" a : 0x41 , B:ff,X:NONE,Y:0", xb_key_names,
+                            XB_KEY_COUNT, map.keys, 0));
+    CHECK(map.keys[XB_KEY_A] == 0x41 && map.keys[XB_KEY_B] == 255);
+    CHECK(!map.keys[XB_KEY_X] && !map.keys[XB_KEY_Y]);
+    CHECK(map.keys[XB_KEY_LT] == original.keys[XB_KEY_LT]);
+    CHECK(xb_bindings_parse("A:41,B:41", xb_key_names, XB_KEY_COUNT, map.keys, 0));
+    CHECK(map.keys[XB_KEY_A] == map.keys[XB_KEY_B]);
+    static const char *const invalid[] = {
+        "A", "A,B:41", "A:41,B", "A:41,B:", "A:41,B:42:43",
+        "A:41garbage", "A:100", "A:0x100", "A:-1", "A:+1", "A:0x",
+        "A:", ":41", "UNKNOWN:41", "A:41,", ",A:41", "A:41,,B:42",
+        "A:41,A:42", "A:41,a:42", "A:41\n", "A:41,B:000",
+        "A:41,THIS_NAME_CANNOT_MATCH_B:42", "A:79", "A:7a", "A:0x79", "A:0X7A"
+    };
+    for (unsigned i = 0; i < sizeof(invalid) / sizeof(*invalid); ++i) {
+        map = original;
+        CHECK(!xb_bindings_parse(invalid[i], xb_key_names, XB_KEY_COUNT, map.keys, 0));
+        CHECK(!memcmp(&map, &original, sizeof(map)));
+    }
+    CHECK(xb_bindings_parse("BLACK:LB,WHITE:RB,START:LT,A:NONE,B:RT,X:RT",
+                            xb_pad_names, XB_PAD_COUNT, map.pad, 1));
+    CHECK(map.pad[XB_PAD_BLACK] == 4 && map.pad[XB_PAD_WHITE] == 5);
+    CHECK(map.pad[XB_PAD_START] == 14 && map.pad[XB_PAD_A] == XB_PAD_NONE);
+    CHECK(map.pad[XB_PAD_B] == map.pad[XB_PAD_X]);
+    static const char *const bad_pad[] = {
+        "A:LB,BAD:B", "A:RTsuffix", "A:BLACK", "A:0", "A:-1",
+        "A:RT,A:LT", "A:RT,B", "A:RT,,B:LT", "A:RT,B:LT:"
+    };
+    for (unsigned i = 0; i < sizeof(bad_pad) / sizeof(*bad_pad); ++i) {
+        map = original;
+        CHECK(!xb_bindings_parse(bad_pad[i], xb_pad_names, XB_PAD_COUNT, map.pad, 1));
+        CHECK(!memcmp(&map, &original, sizeof(map)));
+    }
+    CHECK(xb_bindings_parse("THROTTLE:57,BRAKE:53,LEFT:41,RIGHT:44,"
+                            "HANDBRAKE:NONE,GEAR_UP:52,GEAR_DOWN:46,CAMERA:56",
+                            xb_drive_names, XB_DRIVE_COUNT, map.drive, 0));
+    CHECK(map.drive[XB_DRIVE_THROTTLE] == 'W' && !map.drive[XB_DRIVE_HANDBRAKE]);
+    XbInputBindings accepted = map;
+    CHECK(!xb_bindings_parse("THROTTLE:57,CAMERA:7A",
+                            xb_drive_names, XB_DRIVE_COUNT, map.drive, 0));
+    CHECK(!memcmp(&map, &accepted, sizeof(map)));
+    CHECK(xb_bindings_parse(NULL, xb_key_names, XB_KEY_COUNT, map.keys, 0));
+    CHECK(xb_bindings_parse("", xb_key_names, XB_KEY_COUNT, map.keys, 0));
+    puts("Binding parser: checked boundaries, atomic rejection, disabled and shared sources");
+    return 0;
+}
diff --git a/tests/input_bindings/runtime_test.c b/tests/input_bindings/runtime_test.c
new file mode 100644
index 0000000..d0c6d7d
--- /dev/null
+++ b/tests/input_bindings/runtime_test.c
@@ -0,0 +1,261 @@
+/* Production input, framebuffer mouse/key handling and USB report encoding.
+ * Only physical XInput calls are replaced; no game or controller needed. */
+#include <windows.h>
+#include <xinput.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static XINPUT_STATE host[4];
+static BOOL connected[4], driving;
+static BOOL fixture_driving(void) { return driving; }
+static DWORD WINAPI fixture_get_state(DWORD port, XINPUT_STATE *state)
+{
+    if (port >= 4 || !connected[port]) return ERROR_DEVICE_NOT_CONNECTED;
+    *state = host[port]; return ERROR_SUCCESS;
+}
+static DWORD WINAPI fixture_set_state(DWORD port, XINPUT_VIBRATION *vibration)
+{ (void)port; (void)vibration; return ERROR_SUCCESS; }
+static DWORD WINAPI fixture_get_caps(DWORD port, DWORD flags, XINPUT_CAPABILITIES *caps)
+{ (void)port; (void)flags; memset(caps, 0, sizeof(*caps)); return ERROR_SUCCESS; }
+#define XInputGetState fixture_get_state
+#define XInputSetState fixture_set_state
+#define XInputGetCapabilities fixture_get_caps
+#include "../../src/input/xinput_device.c"
+#include "../../src/video/fb_present.c"
+#include "../../src/usb/usb_gamepad.c"
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return 0; }
+bool nv2a_hook_pvideo_snapshot(uint32_t regs[0x1000 / 4]) { (void)regs; return false; }
+bool nv2a_hook_pvideo_scanout_snapshot(Nv2aPvideoSnapshot *snapshot) { (void)snapshot; return false; }
+void nv2a_hook_pvideo_consume(unsigned bank) { (void)bank; }
+float nv2a_d3d_display_aspect(void) { return 4.f / 3.f; }
+
+static unsigned checks;
+#define CHECK(c) do { ++checks; if (!(c)) { \
+    fprintf(stderr, "Binding runtime line %d: %s\n", __LINE__, #c); exit(1); \
+} } while (0)
+
+static XBOX_INPUT_STATE poll(unsigned port)
+{
+    XBOX_INPUT_STATE state;
+    memset(&state, 0xa5, sizeof(state));
+    CHECK(xbox_InputGetState(port, &state) == ERROR_SUCCESS);
+    return state;
+}
+static void key(HWND window, unsigned vk, int down)
+{ SendMessageA(window, down ? WM_KEYDOWN : WM_KEYUP, vk, 0); }
+static void clear_input(HWND window)
+{ SendMessageA(window, WM_KILLFOCUS, 0, 0); memset(host, 0, sizeof(host)); }
+static void check_neutral(const XBOX_INPUT_STATE *state)
+{
+    XBOX_GAMEPAD empty = {0};
+    CHECK(!memcmp(&state->Gamepad, &empty, sizeof(empty)));
+}
+static void check_modal(HWND window)
+{
+    XBOX_INPUT_STATE before[4], state;
+    for (unsigned port = 0; port < 4; ++port) {
+        connected[port] = TRUE;
+        host[port].dwPacketNumber = 0xffffffffu;
+        host[port].Gamepad.wButtons = XINPUT_GAMEPAD_A;
+        before[port] = poll(port);
+    }
+    key(window, '3', 1);
+    xbox_InputSetBlocked(1);
+    for (unsigned port = 0; port < 4; ++port) {
+        state = poll(port); check_neutral(&state);
+        CHECK(state.dwPacketNumber != before[port].dwPacketNumber);
+        before[port] = state;
+        CHECK(xbox_InputIsConnected(port));
+    }
+    xbox_InputSetBlocked(0);
+    for (unsigned port = 0; port < 4; ++port) {
+        state = poll(port);
+        CHECK(state.dwPacketNumber != before[port].dwPacketNumber);
+        CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_A] ||
+              state.Gamepad.bAnalogButtons[XBOX_BUTTON_B]);
+    }
+    clear_input(window);
+}
+static void check_defaults(HWND window)
+{
+    XBOX_INPUT_STATE state;
+    static const BYTE pressures[] = {0, 1, 29, 30, 31, 85, 86, 127, 128, 254, 255};
+    for (unsigned port = 0; port < 4; ++port) {
+        connected[port] = TRUE;
+        for (unsigned i = 0; i < sizeof(pressures); ++i) {
+            host[port].Gamepad.bLeftTrigger = pressures[i];
+            host[port].Gamepad.bRightTrigger = pressures[sizeof(pressures) - 1 - i];
+            state = poll(port);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_LTRIGGER] == pressures[i]);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER] ==
+                  pressures[sizeof(pressures) - 1 - i]);
+        }
+        host[port].Gamepad.wButtons = XINPUT_GAMEPAD_RIGHT_SHOULDER;
+        state = poll(port);
+        CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK] == 255);
+        CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_WHITE]);
+        host[port].Gamepad.wButtons = XINPUT_GAMEPAD_LEFT_SHOULDER;
+        state = poll(port);
+        CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK]);
+        CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_WHITE] == 255);
+    }
+    clear_input(window);
+    key(window, VK_UP, 1);
+    driving = FALSE; state = poll(0);
+    CHECK(state.Gamepad.wButtons == XBOX_GAMEPAD_DPAD_UP);
+    CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER]);
+    driving = TRUE; state = poll(0);
+    CHECK(!state.Gamepad.wButtons && state.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER] == 255);
+    clear_input(window);
+    check_modal(window);
+}
+static void check_remapped(HWND window)
+{
+    XBOX_INPUT_STATE state;
+    static const BYTE pressures[] = {0, 1, 30, 85, 86, 127, 128, 254, 255};
+    for (unsigned port = 0; port < 4; ++port) {
+        connected[port] = TRUE;
+        host[port].Gamepad.wButtons = XINPUT_GAMEPAD_A | XINPUT_GAMEPAD_LEFT_SHOULDER |
+            XINPUT_GAMEPAD_DPAD_DOWN;
+        host[port].Gamepad.sThumbLX = -32768; host[port].Gamepad.sThumbLY = 32767;
+        host[port].Gamepad.sThumbRX = -1; host[port].Gamepad.sThumbRY = 1;
+        for (unsigned i = 0; i < sizeof(pressures); ++i) {
+            host[port].Gamepad.bLeftTrigger = pressures[i];
+            host[port].Gamepad.bRightTrigger = pressures[sizeof(pressures) - 1 - i];
+            state = poll(port);
+            CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_A]);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_B] == 255);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_X] == host[port].Gamepad.bRightTrigger);
+            CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_Y]);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK] == 255);
+            CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_WHITE]);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_LTRIGGER] == host[port].Gamepad.bRightTrigger);
+            CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER] == pressures[i]);
+            CHECK(!!(state.Gamepad.wButtons & XBOX_GAMEPAD_START) == (pressures[i] > 85));
+            CHECK(!!(state.Gamepad.wButtons & XBOX_GAMEPAD_BACK) ==
+                  (host[port].Gamepad.bRightTrigger > 85));
+            CHECK(state.Gamepad.wButtons & XBOX_GAMEPAD_LEFT_THUMB);
+            CHECK(state.Gamepad.wButtons & XBOX_GAMEPAD_DPAD_UP);
+            CHECK(!(state.Gamepad.wButtons & XBOX_GAMEPAD_RIGHT_THUMB));
+            CHECK(state.Gamepad.sThumbLX == -32768 && state.Gamepad.sThumbLY == 32767);
+            CHECK(state.Gamepad.sThumbRX == -1 && state.Gamepad.sThumbRY == 1);
+        }
+    }
+    clear_input(window);
+    driving = FALSE; key(window, 'B', 1);
+    state = poll(0); /* Generic Xbox A is unaffected by pad A:B. */
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 255);
+    CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_B]);
+    for (unsigned port = 1; port < 4; ++port) {
+        state = poll(port); check_neutral(&state);
+    }
+    key(window, 'B', 0); key(window, 'Z', 1);
+    state = poll(0); check_neutral(&state); /* Old generic A key replaced. */
+    key(window, 'Z', 0); key(window, VK_SHIFT, 1); key(window, VK_CONTROL, 1);
+    state = poll(0); check_neutral(&state); /* NONE/0 are disabled, never VK 0. */
+    key(window, VK_SHIFT, 0); key(window, VK_CONTROL, 0);
+    key(window, 'Z', 0); key(window, '1', 1);
+    state = poll(0); CHECK(state.Gamepad.wButtons == XBOX_GAMEPAD_DPAD_UP);
+    clear_input(window);
+    key(window, 'A', 1); key(window, 'S', 1); driving = TRUE;
+    state = poll(0);
+    CHECK(state.Gamepad.sThumbLX == -32767);
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_LTRIGGER] == 255);
+    CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_X] &&
+          !state.Gamepad.bAnalogButtons[XBOX_BUTTON_Y]); /* WASD priority. */
+    key(window, 'D', 1); state = poll(0); CHECK(!state.Gamepad.sThumbLX);
+    key(window, 'A', 0); state = poll(0); CHECK(state.Gamepad.sThumbLX == 32767);
+    key(window, VK_NUMPAD4, 1); state = poll(0); CHECK(!state.Gamepad.sThumbLX);
+    key(window, 'D', 0); state = poll(0); CHECK(state.Gamepad.sThumbLX == -32767);
+    clear_input(window);
+    key(window, 'W', 1); key(window, 'H', 1); key(window, 'V', 1);
+    state = poll(0);
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_RTRIGGER] == 255);
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 255);
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK] == 255);
+    driving = FALSE; state = poll(0); check_neutral(&state);
+    driving = TRUE; clear_input(window);
+    key(window, VK_UP, 1); key(window, VK_SPACE, 1); key(window, 'C', 1);
+    state = poll(0); check_neutral(&state); /* Old contextual aliases replaced. */
+    clear_input(window);
+    _putenv_s("RECOMP_KEYMAP", "A:5A"); /* Immutable after the first poll. */
+    key(window, 'B', 1); driving = FALSE;
+    state = poll(0); CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 255);
+    clear_input(window); check_modal(window);
+    for (unsigned port = 0; port < 4; ++port) {
+        BYTE report[20]; host[port].Gamepad.wButtons = XINPUT_GAMEPAD_A;
+        CHECK(usb_gamepad_report(port, report, sizeof(report)) == 20);
+        CHECK(report[4] == 0 && report[5] == 255);
+    }
+    connected[3] = FALSE;
+    CHECK(xbox_InputGetState(3, &state) == ERROR_DEVICE_NOT_CONNECTED);
+    CHECK(!xbox_InputIsConnected(3)); /* Keyboard never creates a port 1..3 pad. */
+    CHECK(xbox_InputGetState(4, &state) == ERROR_DEVICE_NOT_CONNECTED);
+    CHECK(xbox_InputGetState(0, NULL) == ERROR_DEVICE_NOT_CONNECTED);
+}
+static void check_mouse(HWND window)
+{
+    XBOX_INPUT_STATE state;
+    connected[0] = FALSE;
+    SendMessageA(window, WM_LBUTTONDOWN, 0, 0);
+    state = poll(0); CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_A] == 255);
+    CHECK(GetCapture() == window);
+    SendMessageA(window, WM_RBUTTONDOWN, 0, 0);
+    SendMessageA(window, WM_LBUTTONUP, 0, 0);
+    state = poll(0);
+    CHECK(!state.Gamepad.bAnalogButtons[XBOX_BUTTON_A]);
+    CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_B] == 255);
+    CHECK(GetCapture() == window);
+    SendMessageA(window, WM_RBUTTONUP, 0, 0);
+    state = poll(0); check_neutral(&state); CHECK(GetCapture() != window);
+    SendMessageA(window, WM_XBUTTONDOWN, MAKEWPARAM(0, XBUTTON1), 0);
+    state = poll(0); CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_Y] == 255);
+    SendMessageA(window, WM_XBUTTONUP, MAKEWPARAM(0, XBUTTON1), 0);
+    SendMessageA(window, WM_XBUTTONDOWN, MAKEWPARAM(0, XBUTTON2), 0);
+    state = poll(0); CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_BLACK] == 255);
+    SendMessageA(window, WM_CAPTURECHANGED, 0, 0);
+    state = poll(0); check_neutral(&state); ReleaseCapture();
+    SendMessageA(window, WM_MBUTTONDOWN, 0, 0);
+    state = poll(0); CHECK(state.Gamepad.bAnalogButtons[XBOX_BUTTON_X] == 255);
+    SendMessageA(window, WM_CANCELMODE, 0, 0);
+    state = poll(0); check_neutral(&state);
+    SendMessageA(window, WM_LBUTTONDOWN, 0, 0);
+    clear_input(window); state = poll(0); check_neutral(&state);
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    _putenv_s("RECOMP_KEYBOARD", "1"); _putenv_s("RECOMP_KEYBOARD_LAYOUT", "mm3");
+    _putenv_s("RECOMP_KEYMAP", ""); _putenv_s("MM3_DRIVE_KEYMAP", "");
+    _putenv_s("RECOMP_PADMAP", ""); _putenv_s("RECOMP_PAD_SCRIPT", "");
+    _putenv_s("RECOMP_PAD_PRESS", ""); _putenv_s("RECOMP_PAD_LIVE", "");
+    _putenv_s("RECOMP_INPUT_DIAG", "");
+    if (!strcmp(argv[1], "remapped")) {
+        _putenv_s("RECOMP_KEYMAP", "A:42,B:4A,START:50,UP:31,DOWN:32,LEFT:33,RIGHT:34,LT:55,RT:49,LS:NONE,RS:0");
+        _putenv_s("MM3_DRIVE_KEYMAP", "THROTTLE:57,BRAKE:53,LEFT:41,RIGHT:44,HANDBRAKE:48,GEAR_UP:52,GEAR_DOWN:46,CAMERA:56");
+        _putenv_s("RECOMP_PADMAP", "A:B,B:A,X:RT,Y:NONE,BLACK:LB,WHITE:RB,START:LT,BACK:RT,LS:A,RS:NONE,UP:DOWN,DOWN:UP,LEFT:RIGHT,RIGHT:LEFT,LT:RT,RT:LT");
+    } else if (!strcmp(argv[1], "invalid")) {
+        _putenv_s("RECOMP_KEYMAP", "A:42,UP:79"); /* Reserved F10 rejects whole map. */
+        _putenv_s("MM3_DRIVE_KEYMAP", "THROTTLE:57,BRAKE:53,LEFT");
+        _putenv_s("RECOMP_PADMAP", "BLACK:LB,A:RTsuffix");
+    } else if (!strcmp(argv[1], "mouse")) {
+        _putenv_s("RECOMP_KEYMAP", "A:1,B:2,X:4,Y:5,BLACK:6");
+    } else CHECK(!strcmp(argv[1], "defaults"));
+    WNDCLASSA wc = {0};
+    wc.lpfnWndProc = fb_wndproc; wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "MM3InputBindingFixture"; CHECK(RegisterClassA(&wc));
+    HWND window = CreateWindowA(wc.lpszClassName, "Input binding fixture", WS_OVERLAPPED,
+                                 0, 0, 100, 100, NULL, NULL, wc.hInstance, NULL);
+    CHECK(window);
+    xbox_InputSetKeyboardDrivingProbe(fixture_driving); xbox_InputInit();
+    if (!strcmp(argv[1], "remapped")) check_remapped(window);
+    else if (!strcmp(argv[1], "mouse")) check_mouse(window);
+    else check_defaults(window);
+    DestroyWindow(window);
+    printf("Input binding %s: %u checks passed\n", argv[1], checks);
+    return 0;
+}
