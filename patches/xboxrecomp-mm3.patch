diff --git a/tests/xaudio2/clock_test.c b/tests/xaudio2/clock_test.c
new file mode 100644
index 0000000..391d729
--- /dev/null
+++ b/tests/xaudio2/clock_test.c
@@ -0,0 +1,58 @@
+/* Test the production clock wrappers with absolute QPC values, including
+ * uptimes that overflowed their old multiply-before-divide implementation. */
+#include <stdint.h>
+#include <stdio.h>
+#include <limits.h>
+#include "../../src/platform/qpc_clock.h"
+
+typedef struct { int64_t QuadPart; } LARGE_INTEGER;
+static int64_t counter, frequency = 10000000;
+static int QueryPerformanceCounter(LARGE_INTEGER *out) { out->QuadPart = counter; return 1; }
+static int QueryPerformanceFrequency(LARGE_INTEGER *out) { out->QuadPart = frequency; return 1; }
+#include "clock_under_test.inc"
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "QPC clock line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+int main(void)
+{
+    const int64_t centers[] = {
+        INT64_MAX / 1000000000LL, /* Old signed multiplication overflow. */
+        (int64_t)(UINT64_MAX / 1000000000ULL), /* Unsigned wrap too. */
+        9LL * 3600 * 10000000, 14LL * 86400 * 10000000,
+        30LL * 86400 * 10000000, 365LL * 86400 * 10000000,
+        10000000, 20000000,
+    };
+    for (unsigned i = 0; i < sizeof(centers) / sizeof(centers[0]); ++i) {
+        int64_t previous = -1;
+        for (int offset = -3; offset <= 3; ++offset) {
+            counter = centers[i] + offset;
+            int64_t ns = qemu_clock_get_ns(0);
+            CHECK(ns == counter * 100); /* A 10 MHz tick is exactly 100 ns. */
+            CHECK(ns > previous);
+            CHECK(qemu_clock_get_us(0) == counter / 10);
+            previous = ns;
+        }
+    }
+    /* Native guest audio register intentionally wraps at 32 bits in 100 ns
+     * units. Only its absolute host conversion must remain monotonic. */
+    for (int offset = -2; offset <= 2; ++offset) {
+        counter = (int64_t)UINT32_MAX + offset;
+        CHECK((uint32_t)(qemu_clock_get_ns(0) / 100) == (uint32_t)counter);
+    }
+    frequency = 3000000;
+    counter = 9LL * 3600 * frequency + 1;
+    CHECK(qemu_clock_get_ns(0) == 9LL * 3600 * 1000000000 + 333);
+    CHECK(qemu_clock_get_us(0) == 9LL * 3600 * 1000000);
+    /* Exercise the wide remainder product rather than assuming a low QPC
+     * frequency; expected result here is simply integer division by 1000. */
+    frequency = 1000000000000LL;
+    counter = INT64_MAX;
+    CHECK(qemu_clock_get_ns(0) == counter / 1000);
+    CHECK(qemu_clock_get_us(0) == counter / 1000000);
+    CHECK(xbox_qpc_to_units(INT64_MAX, 1, 1000000000) == INT64_MAX);
+    CHECK(!xbox_qpc_to_units(1, 0, 1000000000));
+    CHECK(!xbox_qpc_to_units(-1, 10000000, 1000000000));
+    puts("PASS: absolute QPC clocks at overflow boundaries, hour/day uptimes and guest counter wrap");
+    return 0;
+}
diff --git a/tests/xaudio2/dsp_trace_test.c b/tests/xaudio2/dsp_trace_test.c
new file mode 100644
index 0000000..1c54ce9
--- /dev/null
+++ b/tests/xaudio2/dsp_trace_test.c
@@ -0,0 +1,143 @@
+#include <windows.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <string.h>
+#include <errno.h>
+#include <fenv.h>
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "DSP trace line %d: %s\n", __LINE__, #c); return 1; } } while (0)
+static unsigned clock_calls, cycle_calls, writes;
+static int64_t clock_value = 1000;
+static uint64_t cycle_value = 100;
+static bool clock_ok = true, cycle_ok = true;
+static BOOL fake_clock(LARGE_INTEGER *value)
+{
+    ++clock_calls; value->QuadPart = clock_value;
+    SetLastError(123); errno = EIO;
+    return clock_ok;
+}
+static BOOL fake_cycles(HANDLE thread, PULONG64 value)
+{
+    (void)thread; ++cycle_calls; *value = cycle_value;
+    SetLastError(456); errno = EIO;
+    return cycle_ok;
+}
+#define QueryPerformanceCounter fake_clock
+#define QueryThreadCycleTime fake_cycles
+#include "../../src/apu/apu_dsp_trace.h"
+#undef QueryThreadCycleTime
+#undef QueryPerformanceCounter
+typedef struct MCPXAPUState { APUDSPTrace dsp_trace; int dsp_queue_lock; } MCPXAPUState;
+static unsigned held_locks, queue_locks;
+static void qemu_mutex_lock(int *lock) { ++*lock; ++held_locks; ++queue_locks; }
+static void qemu_mutex_unlock(int *lock) { --*lock; --held_locks; }
+static char output[16384];
+static int trace_fprintf(FILE *stream, const char *format, ...)
+{
+    (void)stream;
+    if (held_locks) abort();
+    ++writes;
+    va_list args; va_start(args, format);
+    int n = vsnprintf(output, sizeof(output), format, args);
+    va_end(args);
+    errno = EIO; SetLastError(789);
+    fesetround(FE_UPWARD); feraiseexcept(FE_DIVBYZERO);
+    return n;
+}
+#define fprintf trace_fprintf
+#include "dsp_trace_glue_under_test.inc"
+#undef fprintf
+static APUDSPTraceStamp stamp(int64_t value)
+{ APUDSPTraceStamp s = {value, true}; return s; }
+int main(void)
+{
+    MCPXAPUState d = {0}; APUDSPTrace *t = &d.dsp_trace;
+    apu_dsp_trace_init(t, 0, 1, 1000000);
+    CHECK(!apu_dsp_trace_now(t).valid && !apu_dsp_trace_cpu(t).valid);
+    apu_dsp_trace_begin(t, 100, 1, 7); apu_dsp_trace_posted(t); apu_dsp_trace_finish(t, 1000);
+    audio_dsp_trace_collect(&d); audio_dsp_trace_report(&d);
+    CHECK(!clock_calls && !cycle_calls && !writes && !queue_locks);
+    apu_dsp_trace_init(t, 1, 1, 0);
+    CHECK(!apu_dsp_trace_now(t).valid && !clock_calls);
+
+    apu_dsp_trace_init(t, 1, 0, 1000000);
+    errno = E2BIG; SetLastError(55);
+    CHECK(apu_dsp_trace_now(t).valid && clock_calls == 1);
+    CHECK(errno == E2BIG && GetLastError() == 55);
+    CHECK(!apu_dsp_trace_cpu(t).valid && !cycle_calls);
+    clock_ok = false;
+    CHECK(!apu_dsp_trace_now(t).valid && errno == E2BIG && GetLastError() == 55);
+    clock_ok = true;
+    bool valid;
+    CHECK(apu_dsp_trace_elapsed(stamp(20), stamp(10), &valid) == 0 && !valid);
+    APUDSPTraceStamp invalid = {0};
+    CHECK(!apu_dsp_trace_elapsed(invalid, stamp(20), &valid) && !valid);
+
+    apu_dsp_trace_init(t, 1, 1, 1000000);
+    CHECK(apu_dsp_trace_cpu(t).valid && cycle_calls == 1);
+    CHECK(errno == E2BIG && GetLastError() == 55);
+    cycle_ok = false;
+    CHECK(!apu_dsp_trace_cpu(t).valid && cycle_calls == 2);
+    CHECK(errno == E2BIG && GetLastError() == 55); cycle_ok = true;
+    APUDSPTraceCycles cb = {20, true}, ce = {10, true};
+    CHECK(!apu_dsp_trace_cpu_delta(cb, ce, &valid) && !valid);
+    ce.value = 30; CHECK(apu_dsp_trace_cpu_delta(cb, ce, &valid) == 10 && valid);
+
+    /* Exact integer partition, including queue drain and producer relock. */
+    APUDSPTraceEvent *e = &t->current;
+    e->begin = stamp(100); e->posted = stamp(200); e->end = stamp(1000);
+    e->wait_count = 1; APUDSPTraceWait *w = &e->waits[0];
+    w->reason = 1; w->depth = 8; w->wakes = 1;
+    w->begin = e->posted; w->acquired = stamp(250); w->drained = stamp(600);
+    w->released = stamp(620); w->relocked = stamp(900);
+    uint64_t total = apu_dsp_trace_elapsed(e->begin, e->posted, &valid);
+    CHECK(valid);
+    total += apu_dsp_trace_elapsed(w->begin, w->acquired, &valid); CHECK(valid);
+    total += apu_dsp_trace_elapsed(w->acquired, w->drained, &valid); CHECK(valid);
+    total += apu_dsp_trace_elapsed(w->drained, w->released, &valid); CHECK(valid);
+    total += apu_dsp_trace_elapsed(w->released, w->relocked, &valid); CHECK(valid);
+    total += apu_dsp_trace_elapsed(w->relocked, e->end, &valid); CHECK(valid);
+    CHECK(total == apu_dsp_trace_elapsed(e->begin, e->end, &valid) && total == 900 && valid);
+    for (unsigned i = 1; i <= 18; ++i) {
+        APUDSPTraceJob j = {0}; j.id = i; j.generation = 3; j.div = i; j.depth = 8; j.executed = true;
+        j.posted = stamp(100); j.enqueued = stamp(180); j.dequeued = stamp(210);
+        j.locked = stamp(240); j.serviced = stamp(8500); j.completed = stamp(8600);
+        apu_dsp_trace_commit(t, &j);
+    }
+    CHECK(t->history_written == 18 && t->long_job_pending);
+    e->end = stamp(20000); t->last_qpc = 20000;
+    audio_dsp_trace_collect(&d);
+    CHECK(queue_locks == 1 && !held_locks && t->pending.history_count == 16);
+    CHECK(t->pending.history[0].id == 3 && t->pending.history[15].id == 18);
+    CHECK(!t->long_job_pending);
+    fesetround(FE_DOWNWARD); feclearexcept(FE_ALL_EXCEPT); feraiseexcept(FE_INVALID);
+    errno = E2BIG; SetLastError(55);
+    audio_dsp_trace_report(&d);
+    CHECK(writes == 1 && t->reports == 1 && !held_locks);
+    CHECK(errno == E2BIG && GetLastError() == 55 && fegetround() == FE_DOWNWARD);
+    CHECK((fetestexcept(FE_ALL_EXCEPT) & (FE_INVALID | FE_DIVBYZERO)) == FE_INVALID);
+    CHECK(strstr(output, "begin_qpc=100 posted_qpc=200 end_qpc=20000"));
+    CHECK(strstr(output, "w0=1,8,1,200,250,600,620,900,31"));
+    CHECK(strstr(output, "j0=3,") && strstr(output, "j15=18,") && strstr(output, "truncated=0"));
+
+    /* No catch-up burst after clock regression; half-second spacing and cap. */
+    t->current.begin = stamp(21000); t->current.end = stamp(30000); t->last_qpc = 30000;
+    apu_dsp_trace_offer(t); audio_dsp_trace_report(&d); CHECK(writes == 1);
+    t->last_qpc = 1; audio_dsp_trace_report(&d); CHECK(writes == 1);
+    for (unsigned report = 2; report <= APU_DSP_TRACE_MAX_REPORTS; ++report) {
+        t->last_qpc = t->next_report_qpc;
+        t->current.begin = stamp(t->last_qpc - 9000); t->current.end = stamp(t->last_qpc);
+        apu_dsp_trace_offer(t); audio_dsp_trace_report(&d);
+        CHECK(writes == report);
+    }
+    CHECK(!apu_dsp_trace_enabled(t) && t->reports == 64);
+    unsigned clocks_before = clock_calls, cycles_before = cycle_calls;
+    CHECK(!apu_dsp_trace_now(t).valid && !apu_dsp_trace_cpu(t).valid);
+    apu_dsp_trace_begin(t, 40000000, 1, 0); apu_dsp_trace_posted(t); apu_dsp_trace_finish(t, 40010000);
+    audio_dsp_trace_report(&d);
+    CHECK(clock_calls == clocks_before && cycle_calls == cycles_before && writes == 64);
+    puts("PASS: DSP trace clock/cycle gates, exact phase partitions, history, lock-free reports, errors/fenv and caps");
+    return 0;
+}
diff --git a/tests/xaudio2/hires_wait_test.c b/tests/xaudio2/hires_wait_test.c
new file mode 100644
index 0000000..03bc17a
--- /dev/null
+++ b/tests/xaudio2/hires_wait_test.c
@@ -0,0 +1,348 @@
+/* Exercise production timer lifecycle and throttle with controlled wake races.
+ * Fake only OS waits/handles; no audio device, real sleeps or game is used. */
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <windows.h>
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../../src/apu/apu_profile.h"
+#include "../../src/apu/apu_fe_decode.h"
+
+static const HANDLE timer_handle = (HANDLE)(uintptr_t)1, wake_handle = (HANDLE)(uintptr_t)2;
+static int timer_ok = 1, event_ok = 1, reset_ok = 1, arm_ok = 1, signal_ok = 1, block_ok = 1;
+static int creates, closes, signals, resets, arms, blocks, fallback_waits, lock_held = 1;
+static int condition_signals, condition_broadcasts;
+static int wake_signaled;
+static int64_t now_us = 1000000, due_us;
+static int block_failure_delay_us, last_fallback_ms;
+static void (*reset_hook)(void), (*block_hook)(void);
+static void (*fallback_hook)(void);
+static HANDLE fake_timer(DWORD flags, DWORD access)
+{
+    ++creates;
+    assert(flags == CREATE_WAITABLE_TIMER_HIGH_RESOLUTION);
+    assert(access == (TIMER_MODIFY_STATE | SYNCHRONIZE));
+    if (!timer_ok) SetLastError(ERROR_NOT_SUPPORTED);
+    return timer_ok ? timer_handle : NULL;
+}
+static HANDLE fake_event(BOOL manual, BOOL initial)
+{
+    assert(manual && !initial);
+    if (!event_ok) SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+    return event_ok ? wake_handle : NULL;
+}
+static BOOL fake_close(HANDLE handle)
+{
+    assert(handle == timer_handle || handle == wake_handle);
+    ++closes;
+    return TRUE;
+}
+static BOOL fake_signal(HANDLE handle)
+{
+    assert(handle == wake_handle);
+    ++signals;
+    if (signal_ok) wake_signaled = 1;
+    return signal_ok;
+}
+static BOOL fake_reset(HANDLE handle)
+{
+    assert(handle == wake_handle && lock_held);
+    ++resets;
+    /* Worst ordering: notify after the sequence read, then erase its event.
+     * Production must notice the sequence change and restore the wake. */
+    if (reset_hook) { void (*hook)(void) = reset_hook; reset_hook = NULL; hook(); }
+    if (reset_ok) wake_signaled = 0;
+    return reset_ok;
+}
+static BOOL fake_arm(HANDLE handle, const LARGE_INTEGER *due)
+{
+    assert(handle == timer_handle && due->QuadPart < 0 && lock_held);
+    ++arms;
+    due_us = -due->QuadPart / 10;
+    return arm_ok;
+}
+static DWORD fake_block(DWORD count, const HANDLE *handles, BOOL all, DWORD timeout)
+{
+    assert(count == 2 && handles[0] == wake_handle && handles[1] == timer_handle);
+    assert(!all && timeout == INFINITE && !lock_held);
+    ++blocks;
+    if (!block_ok) { now_us += block_failure_delay_us; return WAIT_FAILED; }
+    if (block_hook) { void (*hook)(void) = block_hook; block_hook = NULL; hook(); }
+    if (wake_signaled) return WAIT_OBJECT_0;
+    now_us += due_us;
+    return WAIT_OBJECT_0 + 1;
+}
+#define CreateWaitableTimerExW(a,b,flags,access) fake_timer(flags,access)
+#define CreateEventW(a,manual,initial,name) fake_event(manual,initial)
+#define CloseHandle fake_close
+#define SetEvent fake_signal
+#define ResetEvent fake_reset
+#define SetWaitableTimer(timer,due,period,callback,arg,resume) fake_arm(timer,due)
+#define WaitForMultipleObjects fake_block
+#include "../../src/apu/apu_wait.h"
+
+#define QEMU_CLOCK_REALTIME 1
+#define MIXER_FRAME_SAMPLES 256
+#define EP_FRAME_US 5333
+typedef struct MCPXAPUState {
+    int ep_frame_div, sleep_acc_us, cond, lock;
+    int64_t next_frame_time_us;
+    unsigned next_frame_time_remainder;
+    bool pause_requested, exiting;
+    APUAudioProfile audio_profile;
+    APUFEPublication fe_publication;
+    APUHiResWait hires_wait;
+    unsigned regs[4], dsp_generation;
+    struct { int *dsp; unsigned regs[4]; } gp, ep;
+    struct { unsigned ep_pcm_offset; } monitor;
+    bool set_irq;
+} MCPXAPUState;
+static MCPXAPUState *g_state;
+#define qatomic_read(p) (*(p))
+static int64_t qemu_clock_get_us(int clock) { (void)clock; return now_us; }
+static void qemu_mutex_unlock(int *lock)
+{ assert(*lock == 1 && lock_held); *lock = 0; lock_held = 0; }
+static void qemu_mutex_lock(int *lock)
+{ assert(*lock == 0 && !lock_held); *lock = 1; lock_held = 1; }
+static void qemu_cond_timedwait(int *cond, int *lock, int ms)
+{
+    (void)cond; assert(*lock == 1 && lock_held); ++fallback_waits; last_fallback_ms = ms;
+    if (fallback_hook) {
+        void (*hook)(void) = fallback_hook; fallback_hook = NULL;
+        qemu_mutex_unlock(lock); hook(); qemu_mutex_lock(lock);
+    } else now_us += (int64_t)ms * 1000;
+}
+static void qemu_cond_signal(int *cond) { (void)cond; ++condition_signals; }
+static void qemu_cond_broadcast(int *cond) { (void)cond; ++condition_broadcasts; }
+#include "wait_control_under_test.inc"
+/* No output device here: the throttle keeps the PC clock. */
+static int throttle_device_queue(void) { return -1; }
+static int throttle_device_target(void) { return 0; }
+#include "throttle_under_test.inc"
+static unsigned vp_resets;
+static void mcpx_apu_vp_reset(MCPXAPUState *d) { (void)d; ++vp_resets; }
+static void apu_dsp_control_lock(MCPXAPUState *d) { assert(d->lock == 1 && lock_held); }
+static void apu_dsp_control_unlock(MCPXAPUState *d) { assert(d->lock == 1 && lock_held); }
+static void dsp_reset(int *dsp) { *dsp = 0; }
+#include "reset_under_test.inc"
+
+static APUHiResWait *notify_target;
+static MCPXAPUState *current;
+static void notify(void) { apu_hires_wait_notify(notify_target); }
+static void early_wake(void) { now_us += 1000; notify(); }
+static void command_flood(void)
+{
+    for (unsigned i = 0; i < 10000; ++i) mcpx_apu_wake_commands(current, (i & 1) != 0);
+    assert(condition_signals == 5000 && condition_broadcasts == 5000);
+    assert(!signals && !wake_signaled);
+}
+static void fallback_command(void)
+{
+    now_us += 1000;
+    mcpx_apu_wake_commands(current, false);
+}
+static void enable_wake(void)
+{
+    now_us += 1000;
+    assert(mcpx_apu_set_hires_wait_enabled(1));
+}
+static void whole_reset_wake(void)
+{
+    qemu_mutex_lock(&current->lock);
+    mcpx_apu_reset_locked(current);
+    qemu_mutex_unlock(&current->lock);
+    now_us += 1000;
+}
+static void deadline_change_wake(void)
+{
+    qemu_mutex_lock(&current->lock);
+    current->next_frame_time_us = now_us + 1000;
+    mcpx_apu_wake(current, true);
+    qemu_mutex_unlock(&current->lock);
+    now_us += 1000;
+}
+static void disable_wake(void)
+{
+    now_us += 1000;
+    assert(mcpx_apu_set_hires_wait_enabled(0));
+    assert(!mcpx_apu_get_hires_wait_enabled());
+}
+static int select_mode(int enabled)
+{
+    qemu_mutex_unlock(&current->lock);
+    int accepted = mcpx_apu_set_hires_wait_enabled(enabled);
+    qemu_mutex_lock(&current->lock);
+    return accepted;
+}
+static void pause_wake(void)
+{
+    qemu_mutex_lock(&current->lock);
+    current->pause_requested = true;
+    mcpx_apu_wake(current, false);
+    qemu_mutex_unlock(&current->lock);
+    now_us += 1000;
+}
+static void shutdown_wake(void)
+{
+    qemu_mutex_lock(&current->lock);
+    current->exiting = true;
+    mcpx_apu_wake(current, false);
+    qemu_mutex_unlock(&current->lock);
+    now_us += 1000;
+}
+static void fixture(MCPXAPUState *d)
+{
+    memset(d, 0, sizeof(*d));
+    d->lock = lock_held = 1;
+    d->next_frame_time_us = (now_us = 1000000) + 3000;
+    timer_ok = event_ok = reset_ok = arm_ok = signal_ok = block_ok = 1;
+    creates = closes = signals = resets = arms = blocks = fallback_waits = wake_signaled = 0;
+    reset_hook = block_hook = NULL;
+    fallback_hook = NULL;
+    condition_signals = condition_broadcasts = 0;
+    block_failure_delay_us = last_fallback_ms = 0;
+    current = d;
+    g_state = d;
+    notify_target = &d->hires_wait;
+    apu_audio_profile_init(&d->audio_profile, true, 1000000);
+    apu_audio_profile_begin_group(&d->audio_profile, now_us);
+}
+int main(void)
+{
+    MCPXAPUState d;
+    fixture(&d);
+    assert(!apu_hires_wait_init(&d.hires_wait, 0) && creates == 0);
+    throttle(&d);
+    assert(fallback_waits == 1 && blocks == 0 && d.lock == 1);
+
+    /* Runtime controls never allocate handles; unavailable ON is rejected,
+     * while OFF is accepted and invalid values leave the selection intact. */
+    assert(!select_mode(1) && !mcpx_apu_get_hires_wait_enabled());
+    assert(select_mode(0) && creates == 0 && closes == 0);
+    assert(!select_mode(-1) && !select_mode(2));
+    g_state = NULL;
+    assert(!select_mode(0) && !mcpx_apu_get_hires_wait_enabled());
+    g_state = &d;
+
+    fixture(&d); timer_ok = 0;
+    assert(!apu_hires_wait_init(&d.hires_wait, 1) && creates == 1 && closes == 0);
+    assert(d.hires_wait.init_error == ERROR_NOT_SUPPORTED);
+    fixture(&d); event_ok = 0;
+    assert(!apu_hires_wait_init(&d.hires_wait, 1) && closes == 1 && !d.hires_wait.timer);
+    assert(d.hires_wait.init_error == ERROR_NOT_ENOUGH_MEMORY);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+    throttle(&d);
+    assert(blocks == 1 && fallback_waits == 0 && due_us == 3000 && now_us == 1003000);
+    assert(d.lock == 1 && d.next_frame_time_us == 1008333);
+    assert(d.audio_profile.cond_wait_calls == 1 && !d.audio_profile.cond_wait_overshoot_max_us);
+    apu_hires_wait_destroy(&d.hires_wait);
+    assert(closes == 2 && !apu_hires_wait_available(&d.hires_wait));
+    apu_hires_wait_destroy(&d.hires_wait); assert(closes == 2);
+
+    /* A command flood keeps idle/fallback notifications but neither changes
+     * nor repeatedly re-arms the native output deadline. */
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = command_flood;
+    throttle(&d);
+    assert(blocks == 1 && arms == 1 && resets == 1 && !fallback_waits);
+    assert(now_us == 1003000 && d.next_frame_time_us == 1008333);
+    assert(d.audio_profile.cond_wait_calls == 1 && !d.audio_profile.cond_wait_early_wakes);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+    int gp_dsp = 7, ep_dsp = 8;
+    d.gp.dsp = &gp_dsp; d.ep.dsp = &ep_dsp;
+    d.regs[0] = d.gp.regs[0] = d.ep.regs[0] = 123;
+    d.monitor.ep_pcm_offset = 512; d.set_irq = true;
+    block_hook = whole_reset_wake;
+    unsigned before_resets = vp_resets;
+    throttle(&d);
+    assert(d.dsp_generation == 1 && vp_resets == before_resets + 1);
+    assert(!gp_dsp && !ep_dsp && !d.regs[0] && !d.gp.regs[0] && !d.ep.regs[0]);
+    assert(!d.monitor.ep_pcm_offset && !d.set_irq && signals == 1 && condition_broadcasts == 1);
+    assert(blocks == 2 && now_us == 1003000 && d.next_frame_time_us == 1008333);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    /* There is no standalone load-state API. A future state/deadline change
+     * using the urgent API must nevertheless interrupt and recheck promptly. */
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = deadline_change_wake;
+    throttle(&d);
+    assert(blocks == 1 && now_us == 1001000 && d.next_frame_time_us == 1006333);
+    assert(signals == 1 && condition_broadcasts == 1);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); fallback_hook = fallback_command;
+    throttle(&d);
+    assert(fallback_waits == 2 && !blocks && condition_signals == 1 && !signals);
+    assert(now_us == 1003000 && d.next_frame_time_us == 1008333);
+    assert(d.audio_profile.cond_wait_early_wakes == 1);
+
+    /* Switching ON while in the fallback wait wakes it and keeps only the
+     * remaining deadline; OFF from an active native wait is checked below. */
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+    assert(select_mode(0)); fallback_hook = enable_wake;
+    throttle(&d);
+    assert(fallback_waits == 1 && blocks == 1 && mcpx_apu_get_hires_wait_enabled());
+    assert(now_us == 1003000 && d.next_frame_time_us == 1008333);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    /* OFF retains prepared handles and uses the condition backend. Re-enable
+     * reuses them, and mode switching does not alter the audio deadline. */
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+    assert(mcpx_apu_get_hires_wait_enabled());
+    assert(!select_mode(2) && mcpx_apu_get_hires_wait_enabled());
+    assert(select_mode(0) && !mcpx_apu_get_hires_wait_enabled());
+    assert(apu_hires_wait_available(&d.hires_wait) && creates == 1 && closes == 0);
+    throttle(&d);
+    assert(fallback_waits == 1 && blocks == 0 && d.next_frame_time_us == 1008333);
+    d.next_frame_time_us = now_us + 3000;
+    assert(select_mode(1) && mcpx_apu_get_hires_wait_enabled());
+    throttle(&d);
+    assert(blocks == 1 && creates == 1 && closes == 0);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = disable_wake;
+    throttle(&d);
+    assert(blocks == 1 && fallback_waits == 1 && last_fallback_ms == 2);
+    assert(now_us == 1003000 && d.next_frame_time_us == 1008333 && d.lock == 1);
+    assert(apu_hires_wait_available(&d.hires_wait) && !mcpx_apu_get_hires_wait_enabled());
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+    reset_hook = notify; /* Unlocked VP notification racing ResetEvent. */
+    assert(apu_hires_wait_prepare(&d.hires_wait, 3) && wake_signaled);
+    qemu_mutex_unlock(&d.lock); assert(apu_hires_wait_block(&d.hires_wait)); qemu_mutex_lock(&d.lock);
+    assert(blocks == 1 && now_us == 1000000);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = early_wake;
+    throttle(&d);
+    assert(blocks == 2 && now_us == 1003000 && d.lock == 1);
+    assert(d.audio_profile.cond_wait_early_wakes == 1);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = pause_wake;
+    throttle(&d); assert(blocks == 1 && d.pause_requested && d.lock == 1 && now_us == 1001000);
+    apu_hires_wait_destroy(&d.hires_wait);
+    fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1)); block_hook = shutdown_wake;
+    throttle(&d); assert(blocks == 1 && d.exiting && d.lock == 1 && now_us == 1001000);
+    apu_hires_wait_destroy(&d.hires_wait);
+
+    for (int failure = 0; failure < 4; ++failure) {
+        fixture(&d); assert(apu_hires_wait_init(&d.hires_wait, 1));
+        if (failure == 0) reset_ok = 0;
+        if (failure == 1) arm_ok = 0;
+        if (failure == 2) { block_ok = 0; block_failure_delay_us = 2000; }
+        if (failure == 3) { signal_ok = 0; notify(); }
+        throttle(&d);
+        assert(fallback_waits == 1 && d.lock == 1 && !apu_hires_wait_available(&d.hires_wait));
+        assert(now_us == 1003000 && last_fallback_ms == (failure == 2 ? 1 : 3));
+        assert(!select_mode(1) && !mcpx_apu_get_hires_wait_enabled());
+        apu_hires_wait_destroy(&d.hires_wait); assert(closes == 2);
+    }
+    puts("PASS: native APU timer command flood/CV fallback, urgent lifecycle wake, runtime selection, reset race and exact deadline");
+    return 0;
+}
