+ * for each report because the handler for the last one may have taken voices
+ * out; reported holds the voices already reported this frame. A voice
+ * declined VP_IDLE_PATIENCE times in a row is offered only every
+ * VP_IDLE_BACKOFF frames. */
+static int vp_next_idle(MCPXAPUState *d, const uint64_t reported[MCPX_HW_MAX_VOICES / 64])
+{
+    uint64_t walked[MCPX_HW_MAX_VOICES / 64] = { 0 };
+
+    voice_regs_forget();
+    for (int list = 0; list < 3; list++) {
+        uint32_t handle = d->regs[voice_list_regs[list].top];
+        for (int i = 0; handle != 0xFFFF && i < MCPX_HW_MAX_VOICES; i++) {
+            uint32_t link;
+            uint16_t v;
+
+            if (handle >= MCPX_HW_MAX_VOICES)
+                break;
+            v = (uint16_t)handle;
+            if (walked[v >> 6] & (1ULL << (v & 63)))
+                break;
+            walked[v >> 6] |= 1ULL << (v & 63);
+            link = voice_get_mask(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                                  NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+            if (link == v) {
+                /* Taken out but still reached, as in the frame's walk. */
+                link = s_next_seen[v] ? s_next_seen[v] - 1 : 0xFFFF;
+                if (link == v)
+                    link = 0xFFFF;
+            }
+            if (!(reported[v >> 6] & (1ULL << (v & 63))) &&
+                !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE) &&
+                (s_idle_declines[v] < VP_IDLE_PATIENCE ||
+                 s_vp_frames % VP_IDLE_BACKOFF == 0))
+                return v;
+            handle = link;
+        }
+    }
+    return -1;
+}
+
+#define VP_IDLE_REPORTS_PER_FRAME 32
+
+/* After a frame, with d->lock held: trap the front end on each idle voice in
+ * turn and have interrupt() raise and deliver DirectSound's interrupt for it.
+ * Stops when the front end is not free to trap -- the title halted it, or the
+ * last trap was not delivered and waits for the next frame -- or when the
+ * title has not enabled idle-voice traps (FETFORCE1). Returns the reports. */
+int mcpx_apu_vp_report_idle(MCPXAPUState *d, void (*interrupt)(MCPXAPUState *d))
+{
+    uint64_t reported[MCPX_HW_MAX_VOICES / 64] = { 0 };
+    int reports = 0;
+
+    if (!g_apu_vp_idle_voices)
+        return 0;
+    while (reports < VP_IDLE_REPORTS_PER_FRAME) {
+        int v;
+
+        if ((qatomic_read(&d->regs[NV_PAPU_FECTL]) & NV_PAPU_FECTL_FEMETHMODE) !=
+            NV_PAPU_FECTL_FEMETHMODE_FREE_RUNNING)
+            break;
+        v = vp_next_idle(d, reported);
+        if (v < 0)
+            break;
+        reported[v >> 6] |= 1ULL << (v & 63);
+        if (!fe_method(d, SE2FE_IDLE_VOICE, (uint32_t)v))
+            break;
+        s_idle_reported[v] = 1;
+        reports++;
+        interrupt(d);
+    }
+    return reports;
+}
+
+/* Whether all 256 voice structures are mapped, which the voice check reads;
+ * the walks only ever touch linked ones. */
+static bool vp_voice_table_readable(MCPXAPUState *d)
+{
+#ifdef _WIN32
+    const size_t span = NV_PAVS_SIZE * MCPX_HW_MAX_VOICES;
+    uintptr_t start = (uintptr_t)mcpx_apu_phys(d->regs[NV_PAPU_VPVADDR]);
+    uintptr_t last = (uintptr_t)mcpx_apu_phys((uint64_t)d->regs[NV_PAPU_VPVADDR] + span - 1);
+    if (span > UINTPTR_MAX - start || last != start + span - 1)
+        return false;
+    for (uintptr_t cursor = start; cursor < start + span;) {
+        MEMORY_BASIC_INFORMATION region;
+        if (!VirtualQuery((const void *)cursor, &region, sizeof(region)) ||
+            region.State != MEM_COMMIT ||
+            (region.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+            return false;
+        uintptr_t end = (uintptr_t)region.BaseAddress + region.RegionSize;
+        if (end <= cursor)
+            return false;
+        cursor = end;
+    }
+    return true;
+#else
+    (void)d;
+    return false;
+#endif
+}
+
+/* Once a second, from the frame thread with d->lock held. Says once per voice
+ * when a finished voice stays in its list for 2 s although DirectSound has
+ * been told (it keeps declining it), and when a voice is playing in no list,
+ * seen at two checks in a row: such a voice is never mixed and never
+ * finishes, so its sound is silent and its buffer never stops. Neither shows
+ * in a healthy run. */
+void mcpx_apu_vp_check_voices(MCPXAPUState *d, int64_t now_ms)
+{
+    static uint32_t table_base;
+    static bool table_readable;
+    static unsigned lines;
+    static const char *const names[3] = { "2D", "3D", "multipass" };
+    uint64_t listed[MCPX_HW_MAX_VOICES / 64] = { 0 };
+    uint8_t list_of[MCPX_HW_MAX_VOICES];
+
+    if (!d->regs[NV_PAPU_VPVADDR])
+        return;
+    if (table_base != d->regs[NV_PAPU_VPVADDR]) {
+        table_base = d->regs[NV_PAPU_VPVADDR];
+        table_readable = vp_voice_table_readable(d);
+    }
+    voice_regs_forget();
+    for (int list = 0; list < 3; list++) {
+        uint32_t handle = d->regs[voice_list_regs[list].top];
+        for (int i = 0; handle != 0xFFFF && i < MCPX_HW_MAX_VOICES; i++) {
+            uint32_t link;
+            uint16_t v;
+
+            if (handle >= MCPX_HW_MAX_VOICES)
+                break;
+            v = (uint16_t)handle;
+            if (listed[v >> 6] & (1ULL << (v & 63)))
+                break;
+            listed[v >> 6] |= 1ULL << (v & 63);
+            list_of[v] = (uint8_t)list;
+            link = voice_get_mask(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                                  NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+            if (link == v) {
+                link = s_next_seen[v] ? s_next_seen[v] - 1 : 0xFFFF;
+                if (link == v)
+                    link = 0xFFFF;
+            }
+            handle = link;
+        }
+    }
+    for (unsigned v = 0; v < MCPX_HW_MAX_VOICES; v++) {
+        bool in_list = (listed[v >> 6] & (1ULL << (v & 63))) != 0;
+
+        if (in_list && s_idle_declines[v] &&
+            !voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE,
+                            NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE)) {
+            if (!s_idle_since_ms[v]) {
+                s_idle_since_ms[v] = now_ms;
+            } else if (now_ms - s_idle_since_ms[v] >= 2000 && !s_idle_noted[v]) {
+                s_idle_noted[v] = 1;
+                if (lines < 16) {
+                    bool stream = voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_CFG_FMT,
+                                                 NV_PAVS_VOICE_CFG_FMT_DATA_TYPE) != 0;
+                    bool persist = voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_CFG_FMT,
+                                                  NV_PAVS_VOICE_CFG_FMT_PERSIST) != 0;
+                    lines++;
+                    fprintf(stderr, "[APU] voice %u (%s list) finished but has stayed in its list for"
+                            " %lld s; DirectSound was told %u times and left it there%s\n",
+                            v, names[list_of[v]], (long long)((now_ms - s_idle_since_ms[v]) / 1000),
+                            (unsigned)s_idle_declines[v],
+                            persist ? " (a stream meant to persist)" : stream ? " (a stream)" : "");
+                    fflush(stderr);
+                }
+            }
+        } else {
+            s_idle_since_ms[v] = 0;
+        }
+
+        if (!table_readable)
+            continue;
+        if (!in_list && voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE,
+                                       NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE)) {
+            if (s_lost_seen[v] && !s_lost_noted[v]) {
+                s_lost_noted[v] = 1;
+                if (lines < 16) {
+                    lines++;
+                    fprintf(stderr, "[APU] voice %u is playing but is in no voice list: it is never"
+                            " mixed and never finishes\n", v);
+                    fflush(stderr);
+                }
+            }
+            s_lost_seen[v] = 1;
+        } else {
+            s_lost_seen[v] = 0;
+            s_lost_noted[v] = 0;
+        }
+    }
+}
+
 /* ============================================================
  * VP Init / Finalize / Reset
  * ============================================================ */
 
 void mcpx_apu_vp_init(MCPXAPUState *d)
 {
-    /* Single-threaded - no worker dispatch needed */
-    (void)d;
+    /* Eight bins per voice used to repeat this powf every 32 samples, even
+     * when their volume had not changed. Calculate the finite input domain
+     * using the same expression and host math library, before the frame
+     * thread starts. The final encoding is the hardware's silence sentinel.
+     * Keeping the table in the APU avoids lazy-init races and shared state. */
+    d->vp.attenuation_rounding = -2;
+    prepare_attenuation(d);
 }
 
 void mcpx_apu_vp_finalize(MCPXAPUState *d)
@@ -1355,5 +2196,16 @@ void mcpx_apu_vp_reset(MCPXAPUState *d)
     memset(d->vp.voice_locked, 0, sizeof(d->vp.voice_locked));
     for (int v = 0; v < MCPX_HW_MAX_VOICES; v++) {
         hrtf_filter_init(&d->vp.filters[v].hrtf);
+        voice_reset_filters(d, (uint16_t)v);
     }
+    memset(s_gain_valid, 0, sizeof(s_gain_valid));
+    memset(s_next_seen, 0, sizeof(s_next_seen));
+    memset(s_self_noted, 0, sizeof(s_self_noted));
+    memset(s_prev_nodes, 0, sizeof(s_prev_nodes));
+    memset(s_idle_reported, 0, sizeof(s_idle_reported));
+    memset(s_idle_declines, 0, sizeof(s_idle_declines));
+    memset(s_idle_since_ms, 0, sizeof(s_idle_since_ms));
+    memset(s_idle_noted, 0, sizeof(s_idle_noted));
+    memset(s_lost_seen, 0, sizeof(s_lost_seen));
+    memset(s_lost_noted, 0, sizeof(s_lost_noted));
 }
diff --git a/src/apu/apu_wait.h b/src/apu/apu_wait.h
new file mode 100644
index 0000000..26fc01a
--- /dev/null
+++ b/src/apu/apu_wait.h
@@ -0,0 +1,121 @@
+/* Optional native APU deadline wait. Preparation runs with the producer lock;
+ * blocking runs without it. Notification does not take the producer lock, so
+ * per-voice commands retain their existing lock behavior. */
+#ifndef MCPX_APU_WAIT_H
+#define MCPX_APU_WAIT_H
+
+#include <stdint.h>
+#include <string.h>
+
+/* How far to move the next output deadline so the device queue settles at
+ * `target` buffers: 250 us earlier per missing buffer, 250 us later per
+ * buffer beyond a two-buffer band, at most 1 ms a frame either way (the
+ * device consumes in 10 ms passes, so the queue swings by about two). No
+ * reading (queued < 0) or no target leaves the deadline alone. */
+static inline int64_t apu_queue_correction_us(int queued, int target)
+{
+    int error;
+    if (queued < 0 || target <= 0) return 0;
+    error = queued - target;
+    if (error < 0) return -(int64_t)(-error > 4 ? 4 : -error) * 250;
+    if (error > 2) return (int64_t)(error - 2 > 4 ? 4 : error - 2) * 250;
+    return 0;
+}
+
+#ifdef _WIN32
+#include <windows.h>
+
+typedef struct APUHiResWait {
+    HANDLE timer, wake;
+    volatile LONG sequence, failed, enabled;
+    DWORD init_error;
+} APUHiResWait;
+
+static inline int apu_hires_wait_available(APUHiResWait *w)
+{
+    return w->timer && w->wake && !InterlockedCompareExchange(&w->failed, 0, 0);
+}
+
+static inline int apu_hires_wait_enabled(APUHiResWait *w)
+{
+    return InterlockedCompareExchange(&w->enabled, 0, 0) && apu_hires_wait_available(w);
+}
+
+static inline void apu_hires_wait_select(APUHiResWait *w, int enabled)
+{
+    InterlockedExchange(&w->enabled, enabled);
+}
+
+static inline void apu_hires_wait_destroy(APUHiResWait *w)
+{
+    /* Owning audio threads must have joined before handles are closed. */
+    if (w->wake) CloseHandle(w->wake);
+    if (w->timer) CloseHandle(w->timer);
+    memset(w, 0, sizeof(*w));
+}
+
+static inline int apu_hires_wait_init(APUHiResWait *w, int requested)
+{
+    memset(w, 0, sizeof(*w));
+    if (!requested) return 0;
+    w->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                     TIMER_MODIFY_STATE | SYNCHRONIZE);
+    if (!w->timer) { w->init_error = GetLastError(); return 0; }
+    w->wake = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!w->wake) {
+        DWORD error = GetLastError();
+        apu_hires_wait_destroy(w);
+        w->init_error = error;
+        return 0;
+    }
+    InterlockedExchange(&w->enabled, 1);
+    return 1;
+}
+
+static inline void apu_hires_wait_notify(APUHiResWait *w)
+{
+    if (!w->wake) return;
+    InterlockedIncrement(&w->sequence);
+    if (!SetEvent(w->wake)) InterlockedExchange(&w->failed, 1);
+}
+
+static inline int apu_hires_wait_prepare(APUHiResWait *w, int milliseconds)
+{
+    LARGE_INTEGER due;
+    if (milliseconds <= 0 || !apu_hires_wait_enabled(w)) return 0;
+    LONG sequence = InterlockedCompareExchange(&w->sequence, 0, 0);
+    if (!ResetEvent(w->wake)) goto failed;
+    /* A VP wake can arrive without the producer lock. Do not erase one that
+     * races the reset. Pause and shutdown predicates use the producer lock. */
+    if (InterlockedCompareExchange(&w->sequence, 0, 0) != sequence && !SetEvent(w->wake))
+        goto failed;
+    due.QuadPart = -(LONGLONG)milliseconds * 10000;
+    if (!SetWaitableTimer(w->timer, &due, 0, NULL, NULL, FALSE)) goto failed;
+    return 1;
+failed:
+    InterlockedExchange(&w->failed, 1);
+    return 0;
+}
+
+static inline int apu_hires_wait_block(APUHiResWait *w)
+{
+    HANDLE handles[2] = {w->wake, w->timer};
+    DWORD result = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+    if (result == WAIT_OBJECT_0 || result == WAIT_OBJECT_0 + 1) return 1;
+    InterlockedExchange(&w->failed, 1);
+    return 0;
+}
+#else
+typedef struct APUHiResWait { unsigned long init_error; volatile long enabled; } APUHiResWait;
+static inline int apu_hires_wait_available(APUHiResWait *w) { (void)w; return 0; }
+static inline int apu_hires_wait_enabled(APUHiResWait *w) { (void)w; return 0; }
+static inline void apu_hires_wait_select(APUHiResWait *w, int enabled) { (void)w; (void)enabled; }
+static inline void apu_hires_wait_destroy(APUHiResWait *w) { memset(w, 0, sizeof(*w)); }
+static inline int apu_hires_wait_init(APUHiResWait *w, int requested)
+{ (void)requested; memset(w, 0, sizeof(*w)); return 0; }
+static inline void apu_hires_wait_notify(APUHiResWait *w) { (void)w; }
+static inline int apu_hires_wait_prepare(APUHiResWait *w, int ms) { (void)w; (void)ms; return 0; }
+static inline int apu_hires_wait_block(APUHiResWait *w) { (void)w; return 0; }
+#endif
+
+#endif
