+static int policy_contract(void)
+{
+    const char *paths[] = {"u:\\asset.bin", "t:\\asset.bin", "asset.bin", "d:asset.bin",
+        "d:\\..\\asset.bin", "d:\\.\\asset.bin", "d:\\asset.bin:stream",
+        "d:\\a\\\\asset.bin", "d:\\", "\\Device\\Cdrom0\\asset.bin", "", "d",
+        "d:\\.. \\asset.bin", "d:\\folder.\\asset.bin", "d:\\folder \\asset.bin",
+        "d:\\NUL", "d:\\folder\\con.txt", "d:\\COM1.bin", "d:\\lpt9.bin",
+        "d:\\CONOUT$", "d:\\PRN.bin", "d:\\AUX", "d:\\asset?.bin"};
+    ULONG denied_access[] = {XBOX_GENERIC_WRITE, XBOX_GENERIC_ALL, XBOX_DELETE,
+        XBOX_FILE_WRITE_DATA, XBOX_FILE_APPEND_DATA, XBOX_FILE_WRITE_ATTRIBUTES,
+        0x10u, 0x40000u, 0x80000u, 0x02000000u, 0x00000200u};
+    ULONG denied_options[] = {1u, 2u, 0x1000u, 0x200u, 0x10000000u};
+    size_t i;
+    if (!xbox_file_buffered_asset("z:\\Washington.pak", 0, ACCESS, 0, 1, OPTIONS) ||
+        !xbox_file_buffered_asset("D:/Data/Shared/asset.bin", 0, ACCESS, 1, 1, OPTIONS | 0x20) ||
+        !xbox_file_buffered_asset("D:\\Data\\Shared\\Audio\\Music\\frontend.wma",
+            0, 0x80100080u, 1, 1, 0x4Cu)) return 0;
