+        room = NV_MAX_INLINE - s_gpu.inline_count;
+        if (n > room) n = room;
+        memcpy(s_gpu.inline_buf + s_gpu.inline_count, words, (size_t)n * 4);
+        s_gpu.inline_count += n;
+    } else {
+        for (i = 0; i < n; ++i) nv2a_pb_exec_method(0, method, words[i]);
