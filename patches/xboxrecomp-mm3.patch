+enum { MAP_FIRST_VERTEX = 17, MAP_MAX_VERTICES = 12,
+       MAP_BASE_TEXTURE = 0x300000, MAP_MARKER_TEXTURE = 0x310000 };
+static int map_centered;
+static int map_improved;
+static int map_fragment_mask;
+static float map_mask_bounds[4];
+static float map_motion, map_expansion;
+static unsigned map_motion_calls, map_expansion_calls;
+static int map_camera_tag;
+static unsigned map_camera_motion_byte, map_camera_expansion_byte;
+static int map_centered_query(void) { return map_centered; }
+static int map_style_query(void) { return map_improved; }
+static float map_motion_query(float cx, float cy) {
+    CHECK(isfinite(cx) && isfinite(cy)); ++map_motion_calls; return map_motion;
+}
+static float map_expansion_query(float cx, float cy) {
+    CHECK(isfinite(cx) && isfinite(cy)); ++map_expansion_calls; return map_expansion;
+}
+static int map_texture_query(uint32_t address)
+{
+    return address == MAP_BASE_TEXTURE ? 1 : address == MAP_MARKER_TEXTURE ? 2 : 0;
+}
