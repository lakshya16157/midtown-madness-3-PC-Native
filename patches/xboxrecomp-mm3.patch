+/* Independent references for the real depth-view and w-buffer pixel shaders. */
+static void test_haze_depth(void)
+{
+    static const float inputs[16] = {0,.0625f,.1f,.15f,.2f,.25f,.3f,.4f,
+                                      .6f,.8f,.95f,.99f,1,1,1,1};
+    static const float views[][2] = {{1,.5f},{2,.5f},{4,.5f},{1,.78f},{2,.78f},{4,.78f},{NAN,.5f},
+                                    {INFINITY,.5f},{.5f,.5f},{2,0},{2,1},{2,NAN}};
+    static const UINT samples[] = {1,4};
+    ID3D11DepthStencilState *write_depth = NULL;
+    D3D11_DEPTH_STENCIL_DESC dd = {0};
+    unsigned variant,scale,view,x,y,checked=0,sky=0;
+    dd.DepthEnable=TRUE; dd.DepthWriteMask=D3D11_DEPTH_WRITE_MASK_ALL;
+    dd.DepthFunc=D3D11_COMPARISON_ALWAYS;
+    CHECK(SUCCEEDED(ID3D11Device_CreateDepthStencilState(s_dev,&dd,&write_depth)));
+    for(variant=0;variant<2;++variant) {
+        Depth *d=depth_get(0x320000+variant*0x10000,16,2,samples[variant]);
+        D3D11_VIEWPORT vp={0,0,16,2,0,1}; D3D11_RECT sc={0,0,1,2};
+        CHECK(d && d->dsv && d->zsrv);
+        unbind_textures(); unbind_targets();
+        ID3D11DeviceContext_OMSetRenderTargets(s_ctx,0,NULL,d->dsv);
+        ID3D11DeviceContext_OMSetDepthStencilState(s_ctx,write_depth,0);
+        ID3D11DeviceContext_RSSetState(s_ctx,s_rs_plain);
+        ID3D11DeviceContext_RSSetViewports(s_ctx,1,&vp);
+        ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx,D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+        bind_vertex_shader(s_clear_vs); bind_vertex_constants(s_cb_clear);
+        bind_pixel_shader(s_clear_ps);
+        ID3D11DeviceContext_PSSetConstantBuffers(s_ctx,0,1,&s_cb_clear);
+        for(x=0;x<16;++x) {
+            float cc[8]={0}; cc[4]=inputs[x];
+            CHECK(upload_cb(s_cb_clear,cc,sizeof cc));
+            sc.left=x; sc.right=x+1;
+            ID3D11DeviceContext_RSSetScissorRects(s_ctx,1,&sc);
+            ID3D11DeviceContext_Draw(s_ctx,4,0);
+        }
+        /* The raw calls above bypass the renderer's binding cache. */
+        s_bound_scissors_valid=s_bound_ds_valid=s_bound_rs_valid=s_bound_topology_valid=0;
+        unbind_targets();
+        for(scale=1;scale<=8;scale*=2) for(view=0;view<sizeof views/sizeof views[0];++view) {
+            ID3D11Texture2D *staging=NULL; D3D11_TEXTURE2D_DESC desc;
+            D3D11_MAPPED_SUBRESOURCE mapped;
+            double knee=views[view][1];
+            double distance=isfinite(views[view][0]) && views[view][0]>=1 &&
+                            isfinite(knee) && knee>0 && knee<1 ? views[view][0]:1.0;
+            nv2a_d3d_set_depth_view_remap(views[view][0],views[view][1]);
+            d->w=16/scale; d->h=2; ++d->gen;
+            CHECK(depth_y16(d));
+            ID3D11Texture2D_GetDesc(d->y16,&desc);
+            desc.Usage=D3D11_USAGE_STAGING; desc.BindFlags=desc.MiscFlags=0;
+            desc.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+            CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&staging)));
+            ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)staging,(ID3D11Resource *)d->y16);
+            CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)staging,0,D3D11_MAP_READ,0,&mapped)));
+            for(y=0;y<2;++y) for(x=0;x<32;++x) {
+                int column=(int)floor((x+.5)/2.0-.25*scale);
+                double depth,value; unsigned expected;
+                const uint16_t *pixel=(const uint16_t *)((const uint8_t *)mapped.pData+y*mapped.RowPitch)+4*x;
+                if(column<0) column=0;
+                /* Account for the actual D24 store before evaluating a
+                 * separate double-precision exponential reference. */
+                depth=floor(inputs[column]*16777215.0+.5)/16777215.0;
+                value=depth;
+                if(distance>1 && depth<1) {
+                    double scaled=depth*distance;
+                    value=scaled<=knee?scaled:knee+(1-knee)*(-expm1((knee-scaled)/(1-knee)));
+                }
+                expected=(unsigned)floor(value*16777215.0+.5)>>8;
+                if(abs((int)pixel[0]-(int)expected)>1)
+                    fprintf(stderr,"haze view=%g scale=%u MSAA=%u input=%g actual=%u expected=%u\n",
+                            distance,scale,samples[variant],depth,pixel[0],expected);
+                CHECK(abs((int)pixel[0]-(int)expected)<=1);
+                CHECK(pixel[0]==pixel[1] && pixel[1]==pixel[2] && pixel[3]==65535);
+                if(inputs[column]==1) { CHECK(pixel[0]==65535); ++sky; }
+                ++checked;
+            }
+            ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)staging,0);
+            ID3D11Texture2D_Release(staging);
+        }
+    }
+    CHECK(sky>100);
+    ID3D11DepthStencilState_Release(write_depth);
+    nv2a_d3d_set_depth_view_remap(1,.5f);
+    printf("PASS: %u actual packed Y16 pixels, views1/2/4, knees0.5/0.78 and invalid scales/knees, render scales1/2/4/8, MSAA1/4, quarter-pixel alignment and exact sky sentinel (%u samples)\n",checked,sky);
+}
+
+static void haze_pipeline(const NvD3DState *st, float expected)
+{
+    Surface *surface; uint32_t w,h,z; PSConsts pc;
+    CHECK(setup_pipeline(st,NV_D3D_TRIANGLES,&surface,&w,&h,&z));
+    read_buffer(s_cb_ps,&pc,sizeof pc);
+    CHECK(pc.zp1[2]==expected);
+    CHECK(expected==0 || pc.zp1[3]==.5f);
+}
+
+static void test_haze_gates(void)
+{
+    NvD3DState world=state_for(64,64), haze,st;
+    unsigned mode;
+    world.depth_test=world.depth_mask=world.z_perspective=1;
+    world.depth_func=0x203; world.zeta_addr=0x200000; world.zeta_pitch=64*4;
+    nv2a_d3d_set_depth_view_remap(2,.5f);
+    nv2a_d3d_flip(0,0); /* Real frame boundary resets the post-haze state. */
+    haze_pipeline(&world,0);
+    CHECK(s_cur_ds && depth_y16(s_cur_ds));
+    haze_pipeline(&world,0); /* Creating a view is not sampling it. */
+    haze=state_for(64,64); haze.tex_used=1;
+    haze.tex[0].addr=world.zeta_addr; haze.tex[0].color=0x35;
+    haze.tex[0].format=0x00013500; haze.tex[0].levels=1;
+    haze.tex[0].width=128; haze.tex[0].height=64; haze.tex[0].pitch=256;
+    haze_pipeline(&haze,0); /* Bind the actual cached Y16 depth view. */
+    haze_pipeline(&world,2);
+    for(mode=0;mode<4;++mode) {
+        st=world;
+        if(mode==0) st.depth_test=0;
+        else if(mode==1) st.depth_mask=0;
+        else if(mode==2) st.z_perspective=0;
+        else { st.depth_test=st.depth_mask=st.z_perspective=0; st.zeta_addr=0; }
+        haze_pipeline(&st,0);
+    }
+    nv2a_d3d_set_depth_view_remap(1,.5f); haze_pipeline(&world,0);
+    nv2a_d3d_set_depth_view_remap(NAN,.5f); haze_pipeline(&world,0);
+    nv2a_d3d_set_depth_view_remap(4,.5f); haze_pipeline(&world,4);
+    nv2a_d3d_flip(0,0); haze_pipeline(&world,0);
+    st=haze; st.tex[0].addr=0x180000; /* Ordinary Y16 bytes are not a depth view. */
+    haze_pipeline(&st,0); haze_pipeline(&world,0);
+    nv2a_d3d_set_depth_view_remap(1,.5f);
+    puts("PASS: actual Y16 depth binding enables post-haze w-buffer coverage only with depth test/write; pre-haze, generated-only views, no-test, no-write, z-buffer, HUD, baseline/invalid scale and flip reset remain excluded");
+}
+
+static void test_haze_coverage(void)
+{
+    static const char suffix[]=
+        "cbuffer QualityCoverage:register(b4) { float quality_depth; float quality_alpha; float2 quality_pad; };\n"
+        "PSIn quality_coverage_vs(uint id:SV_VertexID) {\n"
+        " const float2 p[3]={float2(-1,-1),float2(-1,3),float2(3,-1)};\n"
+        " PSIn o=(PSIn)0; o.pos=float4(p[id],.5,1);\n"
+        " o.d0=float4(1,1,1,quality_alpha); o.fog=float4(1,quality_depth,0,0); return o; }\n";
+    static const float depths[]={0,.1f,.2f,.3f,.5f,.8f,.979f,.98f,1};
+    static const float knees[]={.5f,.78f};
+    static const unsigned samples[]={1,2,4,8};
+    ID3DBlob *code=compile_fixture(suffix,"quality_coverage_vs","vs_5_0");
+    ID3D11VertexShader *vertex_shader=NULL;
+    ID3D11Buffer *settings=make_buffer(16,D3D11_BIND_CONSTANT_BUFFER);
+    unsigned sample,view,depth,knee,alpha,x,y,checked=0;
+    CHECK(settings);
+    CHECK(SUCCEEDED(ID3D11Device_CreateVertexShader(s_dev,ID3D10Blob_GetBufferPointer(code),
+                                                   ID3D10Blob_GetBufferSize(code),NULL,&vertex_shader)));
+    ID3D10Blob_Release(code);
+    for(sample=0;sample<sizeof samples/sizeof samples[0];++sample) {
+        ID3D11Texture2D *output=NULL,*resolved=NULL,*staging=NULL;
+        ID3D11RenderTargetView *rtv=NULL;
+        D3D11_TEXTURE2D_DESC desc={0};
+        D3D11_VIEWPORT vp={0,0,2,2,0,1}; D3D11_RECT sc={0,0,2,2};
+        UINT quality=0,ns=samples[sample];
+        CHECK(SUCCEEDED(ID3D11Device_CheckMultisampleQualityLevels(s_dev,DXGI_FORMAT_R8G8B8A8_UNORM,ns,&quality)) && quality);
+        desc.Width=desc.Height=2; desc.MipLevels=desc.ArraySize=1;
+        desc.Format=DXGI_FORMAT_R8G8B8A8_UNORM; desc.SampleDesc.Count=ns;
+        desc.Usage=D3D11_USAGE_DEFAULT; desc.BindFlags=D3D11_BIND_RENDER_TARGET;
+        CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&output)));
+        CHECK(SUCCEEDED(ID3D11Device_CreateRenderTargetView(s_dev,(ID3D11Resource *)output,NULL,&rtv)));
+        desc.SampleDesc.Count=1;
+        CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&resolved)));
+        desc.Usage=D3D11_USAGE_STAGING; desc.BindFlags=0; desc.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+        CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&staging)));
+        for(view=1;view<=4;view*=2) for(knee=0;knee<sizeof knees/sizeof knees[0];++knee)
+        for(depth=0;depth<sizeof depths/sizeof depths[0];++depth)
+        for(alpha=0;alpha<3;++alpha) {
+            PSConsts pc={0}; D3D11_MAPPED_SUBRESOURCE mapped;
+            float constant[4]={depths[depth]*16777216.f,alpha==1?128.5f/255.f:1.f,0,0};
+            float black[4]={0};
+            pc.zp1[0]=1.f/16777216.f; pc.zp1[1]=16777215.f;
+            pc.zp1[2]=(float)view; pc.zp1[3]=knees[knee];
+            if(alpha) { pc.ps_flags=2; pc.alpha_func=alpha==1?0x204:0x200; pc.alpha_ref=128; }
+            CHECK(upload_cb(s_cb_ps,&pc,sizeof pc) && upload_cb(settings,constant,sizeof constant));
+            unbind_targets(); unbind_textures();
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx,rtv,black);
+            ID3D11DeviceContext_OMSetRenderTargets(s_ctx,1,&rtv,NULL);
+            ID3D11DeviceContext_OMSetBlendState(s_ctx,s_blend_opaque,NULL,0xFFFFFFFF);
+            ID3D11DeviceContext_OMSetDepthStencilState(s_ctx,s_ds_off,0);
+            ID3D11DeviceContext_RSSetState(s_ctx,s_rs_plain);
+            ID3D11DeviceContext_RSSetViewports(s_ctx,1,&vp);
+            ID3D11DeviceContext_RSSetScissorRects(s_ctx,1,&sc);
+            ID3D11DeviceContext_IASetInputLayout(s_ctx,NULL);
+            ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx,D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            bind_vertex_shader(vertex_shader); bind_pixel_shader(s_psv[2]);
+            ID3D11DeviceContext_VSSetConstantBuffers(s_ctx,4,1,&settings);
+            ID3D11DeviceContext_PSSetConstantBuffers(s_ctx,1,1,&s_cb_ps);
+            ID3D11DeviceContext_Draw(s_ctx,3,0);
+            unbind_targets();
+            if(ns>1) ID3D11DeviceContext_ResolveSubresource(s_ctx,(ID3D11Resource *)resolved,0,
+                (ID3D11Resource *)output,0,DXGI_FORMAT_R8G8B8A8_UNORM);
+            else ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)resolved,(ID3D11Resource *)output);
+            ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)staging,(ID3D11Resource *)resolved);
+            CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)staging,0,D3D11_MAP_READ,0,&mapped)));
+            for(y=0;y<2;++y) for(x=0;x<2;++x) {
+                double z=fmin(constant[0],16777215.f)/16777216.0;
+                double scaled=z*view,rank=(x*2+(x^y))*.25;
+                unsigned keep=ns,alpha_keep=alpha==2?0:alpha==1 && ns>1?ns/2:ns;
+                const uint8_t *pixel=(const uint8_t *)mapped.pData+y*mapped.RowPitch+x*4;
+                int expected;
+                if(view>1 && scaled>knees[knee] && z<.98f)
+                    keep=(unsigned)floor(exp((knees[knee]-scaled)/(1-knees[knee]))*ns+rank);
+                if(keep>alpha_keep) keep=alpha_keep;
+                expected=(int)floor(255.0*keep/ns+.5);
+                if(abs((int)pixel[0]-expected)>1)
+                    fprintf(stderr,"coverage MSAA=%u view=%u z=%g alpha=%u xy=%u,%u actual=%u expected=%d keep=%u\n",
+                            ns,view,z,alpha,x,y,pixel[0],expected,keep);
+                CHECK(abs((int)pixel[0]-expected)<=1);
+                CHECK(pixel[0]==pixel[1] && pixel[1]==pixel[2]); ++checked;
+            }
+            ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)staging,0);
+        }
+        ID3D11RenderTargetView_Release(rtv); ID3D11Texture2D_Release(output);
+        ID3D11Texture2D_Release(resolved); ID3D11Texture2D_Release(staging);
+    }
+    ID3D11Buffer_Release(settings); ID3D11VertexShader_Release(vertex_shader);
+    printf("PASS: %u real ps_wdepth resolved pixels across views1/2/4, knees0.5/0.78, MSAA1/2/4/8, all four ordered ranks, alpha-mask intersection/rejection and unchanged near/sky coverage\n",checked);
+}
