+    improved=1; centered=1; next_map_frame();
+    pause=box(cx-half,cx+half,cy-half,cy+half,aspect,2,1,0,map_base);
+    assert(!pause.suppressed && !s_frame_map_valid && !pause.use_dx && !pause.use_dy);
+    centered=0; next_map_frame();
+    /* A stale marker after the map's frame/ownership retirement remains flat. */
+    marker=box(cx-4,cx+4,cy-4,cy+4,aspect,2,1,0,map_marker);
+    assert(!marker.use_dx && !marker.use_dy);
+}
+static void projection_bounds(void) {
+    float x, y;
+    assert(!nv2a_minimap_project(1,2,0,0,0,64,&x,&y));
+    assert(!nv2a_minimap_project(1,2,0,0,64,NAN,&x,&y));
+    assert(!nv2a_minimap_project(INFINITY,2,0,0,64,64,&x,&y));
+    assert(!nv2a_minimap_project(1,2,0,0,64,64,NULL,&y));
+    assert(nv2a_minimap_project(0,0,0,0,64,64,&x,&y));
+    near(x,76.8f); near(y,7.68f);
+    assert(nv2a_minimap_project(1000,100000,0,0,64,64,&x,&y));
+    assert(isfinite(x) && isfinite(y));
+}
+static void speed_perspective(float aspect, float half) {
+    float p[4][4], cx=114, cy=384;
+    const uint32_t idx[6]={0,1,2,0,2,3};
+    Result low, high, low_marker, high_marker, route, crop;
+    float narrow=fminf(1.0f,(4.0f/3.0f)/aspect);
+    int i;
+    seed(1); centered=0; improved=1;
+    nv2a_d3d_set_map_texture_query(map_texture_query);
+    nv2a_d3d_set_minimap_motion_query(minimap_motion_query);
+    motion=0;
+    box(cx-half,cx+half,cy-half,cy+half,aspect,2,1,0,map_base);
+    quad(p,cx-half,cx+half,cy-half,cy+half); tag_route(0,4);
+    low=draw(p,4,idx,6,0,aspect,2,0,0,0);
+    memset(&submitted_uv,0,sizeof submitted_uv);
+    low_marker=box(cx-4,cx+4,cy-4,cy+4,aspect,2,1,0,map_marker);
+    next_map_frame(); motion=1;
+    box(cx-half,cx+half,cy-half,cy+half,aspect,2,1,0,map_base);
+    assert(motion_calls==2); near(s_frame_map_motion,1);
+    /* Once the base captured this camera, a following masked tile and mixed
+     * batches retain it even when the next guest update changes the speed. */
+    motion=0;
+    box(cx-half,cx+half,cy-half,cy+half,aspect,2,1,0,map_base);
+    assert(motion_calls==2); near(s_frame_map_motion,1);
+    quad(p,cx-half,cx+half,cy-half,cy+half); tag_route(0,4);
+    high=draw(p,4,idx,6,0,aspect,2,0,0,0);
+    /* Speed changes the native world scale, never the map's display frame. */
+    for(i=0;i<4;++i) { near(high.x[i],low.x[i]); near(high.y[i],low.y[i]); }
+    memset(&submitted_uv,0,sizeof submitted_uv);
+    high_marker=box(cx-4,cx+4,cy-4,cy+4,aspect,2,1,0,map_marker);
+    for(i=0;i<4;++i) { near(high_marker.x[i],low_marker.x[i]); near(high_marker.y[i],low_marker.y[i]); }
+    tag_route(17,4);
+    route=box(cx-4,cx+4,cy-4,cy+4,aspect,2,0,0,0);
+    for(i=0;i<4;++i) { near(high_marker.x[i],route.x[i]); near(high_marker.y[i],route.y[i]); }
+    /* Crop and frame corners stay fixed with the same native geometry. */
+    {
+        float depth=.40f/(1.15f+.22f*.40f);
+        crop=box(cx-half,cx-half+.1f,cy+depth*half,cy+depth*half+.1f,aspect,2,0,0,0);
+        near(crop.x[0],0); near(crop.y[0],480);
+        near(nv2a_minimap_left_crop_motion(half,1),nv2a_minimap_left_crop(half));
+        near(high.x[1]-high.x[0],2*half*narrow*2.20f*.78f/1.22f);
+    }
+    memset(&submitted_uv,0,sizeof submitted_uv);
+    next_map_frame();
+    box(cx-half,cx+half,cy-half,cy+half,aspect,2,1,0,map_base);
+    assert(motion_calls==3); near(s_frame_map_motion,0);
+    nv2a_d3d_set_minimap_motion_query(NULL); assert(!s_frame_map_valid);
+}
+static void speed_projection_bounds(void) {
+    float x,y,base_x,base_y;
+    const float invalid[]={NAN,INFINITY,-1,0,1,99};
+    unsigned i;
+    for(i=0;i<sizeof invalid/sizeof invalid[0];++i) {
+        float bounded=nv2a_minimap_motion_bound(invalid[i]);
+        assert(bounded>=0 && bounded<=1);
+        assert(nv2a_minimap_project_motion(1000,100000,0,0,64,64,invalid[i],&x,&y));
+        assert(isfinite(x) && isfinite(y));
+        assert(nv2a_minimap_project_motion(1000,100000,0,0,64,64,bounded,&base_x,&base_y));
+        near(x,base_x); near(y,base_y);
+    }
+}
+static void improved_expanded(float aspect) {
+    float p[4][4];
+    const uint32_t idx[6]={0,1,2,0,2,3};
+    const float phases[]={0,.5f,1};
+    Result base, plane, marker, route;
+    float narrow=fminf(1,(4.0f/3.0f)/aspect), ynarrow=fminf(1,aspect/(4.0f/3.0f));
+    int i, phase, corner;
+    seed(1); centered=0; improved=1;
+    nv2a_d3d_set_map_texture_query(map_texture_query);
+    nv2a_d3d_set_minimap_motion_query(minimap_motion_query);
+    nv2a_d3d_set_minimap_expansion_query(minimap_expansion_query);
+    for(phase=0;phase<3;++phase) {
+        unsigned expansion_byte=(unsigned)(phases[phase]*255+.5f);
+        float e=(float)expansion_byte/255, left=50+78*e, top=320-272*e, extent=128+256*e;
+        float cx=left+extent*.5f, cy=top+extent*.5f;
+        next_map_frame(); expansion=1-e; motion=0;
+        tag_camera(17,4,255,expansion_byte);
+        base=box(left,left+extent,top,top+extent,aspect,2,1,0,map_base);
+        assert(base.suppressed); near(s_frame_map_expansion,e);
+        assert(!expansion_calls && !motion_calls);
+        /* A queued next update cannot change this map's camera between its
+         * base, roads and checkpoints, even at the half-open transition. */
+        tag_camera(17,4,0,255-expansion_byte);
+        box(left,left+extent,top,top+extent,aspect,2,1,0,map_base);
+        assert(!expansion_calls && !motion_calls);
+        near(s_frame_map_expansion,e); near(s_frame_map_motion,1);
+        quad(p,left,left+extent,top,top+extent); tag_route(0,4);
+        plane=draw(p,4,idx,6,0,aspect,2,0,0,0);
+        if(e==0) near(plane.x[2]-plane.x[3],extent*narrow*2.20f);
+        if(e==1) for(i=0;i<4;++i) {
+            near(plane.x[i],320+(p[i][0]-320)*narrow);
+            near(plane.y[i],240+(p[i][1]-240)*ynarrow);
+            assert(plane.x[i]>=0 && plane.x[i]<=640 && plane.y[i]>=0 && plane.y[i]<=480);
+        }
+        /* Checkpoint icons near every corner include the rear corners that
+         * the driving camera deliberately crops below the display. */
+        for(corner=0;corner<4;++corner) {
+            float x=left+(corner&1?extent-8:8), y=top+(corner&2?extent-8:8);
+            memset(&submitted_uv,0,sizeof submitted_uv);
+            marker=box(x-4,x+4,y-4,y+4,aspect,2,1,0,map_marker);
+            tag_route(17,4); route=box(x-4,x+4,y-4,y+4,aspect,2,0,0,0);
+            quad(p,x-4,x+4,y-4,y+4);
+            for(i=0;i<4;++i) {
+                double half=extent*.5, depth=(p[i][1]-cy)/half, denominator=1-.22*depth;
+                double px=cx+(p[i][0]-cx)*.78/denominator;
+                double py=cy+half*.60+(p[i][1]-cy)*1.15/denominator;
+                double crop=half*2.20*(1-.78/(1-.22*(.40/(1.15+.22*.40))));
+                double driving_x=((px-left)*2.20-crop)*narrow;
+                double driving_y=480+(py-top-extent)*2.20*ynarrow;
+                double flat_x=320+(p[i][0]-320)*narrow;
+                double flat_y=240+(p[i][1]-240)*ynarrow;
+                near(marker.x[i],(float)(driving_x*(1-e)+flat_x*e));
+                near(marker.y[i],(float)(driving_y*(1-e)+flat_y*e));
+                near(marker.x[i],route.x[i]); near(marker.y[i],route.y[i]);
+                if(e==1) assert(marker.x[i]>=0 && marker.x[i]<=640 && marker.y[i]>=0 && marker.y[i]<=480);
+            }
+        }
+        memset(&submitted_uv,0,sizeof submitted_uv);
+    }
+    /* Reject a mixed camera batch instead of interpreting arbitrary UVs.
+     * An already tagged base also cannot become textured after a live
+     * switch to Stock while those vertices were waiting in the queue. */
+    {
+        const uint32_t camera_idx[6]={17,18,19,17,19,20};
+        float queued_motion, queued_expansion;
+        tag_camera(17,4,255,255);
+        packed_uv[19][5]^=1;
+        assert(!map_camera_window(&submitted_uv,camera_idx,6,&queued_motion,&queued_expansion));
+        tag_camera(17,4,255,255); improved=0;
+        base=box(128,512,48,432,aspect,2,1,0,map_base);
+        assert(base.suppressed); improved=1;
+    }
+    nv2a_d3d_set_minimap_expansion_query(NULL); assert(!s_frame_map_valid);
+}
+static void mask_fragment_contract(float aspect, float left, float top, float width, float height,
+                                   float overview) {
+    const uint32_t idx[6]={17,18,19,17,19,20};
+    const double xy_scale=32768.0*0.0005537098622880876;
+    float bounds[4], p[4][4], old_cx, old_cy;
+    unsigned row,col,k;
+    Result r;
+    seed(1); centered=0; improved=masked=1;
+    nv2a_d3d_set_map_texture_query(map_texture_query);
+    expansion=overview; nv2a_d3d_set_minimap_expansion_query(minimap_expansion_query);
+    memset(packed_uv,0,sizeof packed_uv);
+    submitted_uv.enabled=1; submitted_uv.type=1; submitted_uv.size=4; submitted_uv.stride=16;
+    submitted_uv.data=(const uint8_t *)&packed_uv[0][4];
+    for(row=0;row<3;++row) for(col=0;col<3;++col) {
+        quad(p,left+width*col/3,left+width*(col+1)/3,top+height*row/3,top+height*(row+1)/3);
+        for(k=0;k<4;++k) {
+            packed_uv[17+k][6]=(int16_t)((p[k][0]-left)*16383.5/width);
+            packed_uv[17+k][7]=(int16_t)((p[k][1]-top)*16383.5/height);
+            p[k][0]=(float)(floor(p[k][0]*xy_scale)/xy_scale);
+            p[k][1]=(float)(floor(p[k][1]*xy_scale)/xy_scale);
+        }
+        assert(map_mask_window(&submitted_uv,p,idx,17,6,bounds));
+        assert(fabsf(bounds[0]-left)<.25f && fabsf(bounds[1]-left-width)<.25f);
+        assert(fabsf(bounds[2]-top)<.25f && fabsf(bounds[3]-top-height)<.25f);
+        r=draw(p,4,idx,6,17,aspect,2,1,0,map_base);
+        assert(r.suppressed && s_frame_map_valid);
+        assert(s_frame_map_expansion==overview);
+        assert(fabsf(s_frame_map_cx-left-width*.5f)<.25f);
+        assert(fabsf(s_frame_map_cy-top-height*.5f)<.25f);
+    }
+    old_cx=s_frame_map_cx; old_cy=s_frame_map_cy;
+    /* A later nearly zero-area tile is discarded without replacing this
+     * map's full window with a small last-fragment bounding box. */
+    quad(p,left,left+.5f,top,top+.5f);
+    for(k=0;k<4;++k) {
+        packed_uv[17+k][6]=(int16_t)((p[k][0]-left)*16383.5/width);
+        packed_uv[17+k][7]=(int16_t)((p[k][1]-top)*16383.5/height);
+    }
+    r=draw(p,4,idx,6,17,aspect,2,1,0,map_base);
+    assert(r.suppressed); near(s_frame_map_cx,old_cx); near(s_frame_map_cy,old_cy);
+    memset(&submitted_uv,0,sizeof submitted_uv); masked=0;
+    /* The driving camera anchors its visible clipped boundary; the native
+     * expanded window keeps its flat coordinates and all checkpoint space. */
+    {
+        float d=.40f/(1.15f+.22f*.40f), hw=s_frame_map_half_width, hh=s_frame_map_half_height;
+        float x=s_frame_map_cx-hw, y=s_frame_map_cy+d*hh;
+        tag_route(17,4);
+        r=box(x,x+.1f,y,y+.1f,aspect,2,0,0,0);
+        if(overview==0) assert(fabsf(r.x[0])<.01f && fabsf(r.y[0]-480.0f)<.01f);
+        else {
+            near(r.x[0],320+(x-320)*fminf(1,(4.0f/3.0f)/aspect));
+            near(r.y[0],240+(y-240)*fminf(1,aspect/(4.0f/3.0f)));
+        }
+        memset(&submitted_uv,0,sizeof submitted_uv);
+    }
+    next_map_frame(); masked=1;
+    r=draw(p,4,idx,6,17,aspect,2,1,0,map_base);
+    assert(r.suppressed && !s_frame_map_valid); /* Invalid first tile cannot invent a window. */
+    masked=0;
+}
+int main(void) {
+    const float aspects[] = {4.0f/3.0f, 16.0f/10.0f, 16.0f/9.0f, 21.0f/9.0f};
+    int a, phase, scale;
+    for (a = 0; a < 4; a++) {
+        for (phase = 0; phase < 2; phase++)
+            for (scale = 1; scale <= 2; scale++) overlay(aspects[a], (float)scale, phase);
+        exemptions(aspects[a]);
+        race_backgrounds(aspects[a]);
+        resume(aspects[a]);
+        for (scale = 1; scale <= 2; ++scale) dialogue_after_race(aspects[a], (float)scale);
+        for (scale = 1; scale <= 2; ++scale) shared_name_atlas(aspects[a], (float)scale);
+        mixed_name_map(aspects[a]);
+        for (scale = 1; scale <= 2; ++scale) maps(aspects[a], (float)scale);
+        improved_map(aspects[a],64); improved_map(aspects[a],160);
+        speed_perspective(aspects[a],64); speed_perspective(aspects[a],160);
+        improved_expanded(aspects[a]);
+        mask_fragment_contract(aspects[a],50,320,128,128,0);
+        mask_fragment_contract(aspects[a],128,48,384,384,1);
+    }
+    tall_layout(1.0f); tall_layout(0.75f);
+    shared_name_atlas(1.0f,1); shared_name_atlas(0.75f,2);
+    mixed_name_map(1.0f); mixed_name_map(0.75f);
+    improved_map(1.0f,64); improved_map(0.75f,64); projection_bounds();
+    speed_perspective(1.0f,64); speed_perspective(.75f,64); speed_projection_bounds();
+    improved_expanded(1.0f); improved_expanded(0.75f);
+    mask_fragment_contract(1.0f,128,48,384,384,1); mask_fragment_contract(.75f,50,80,128,128,0);
+    tag_upload();
+    puts("Real HUD placement: post-race dialogue seams, stock/driving perspective, flat expanded checkpoints, transition camera latch, road/icon alignment, transparent city isolation, 6 aspects, mixed batches and lifecycle passed");
+    return 0;
+}
+"""
+with tempfile.TemporaryDirectory() as folder:
+    (Path(folder) / "nv2a_minimap_projection.h").write_text(
+        (Path(__file__).resolve().parents[1] / "src/video/nv2a_minimap_projection.h").read_text(),
+        encoding="utf-8",
+    )
+    presence_gate = "                if (!s_hud_seen && !s_hud_prev && !name_n && !route_n)\n                    centered_ui = 1;\n"
+    gate = "                centered_ui = s_centered_ui_query ? s_centered_ui_query() : 0;\n" + presence_gate + "                if (!centered_ui) {"
+    assert harness.count(gate) == 1
+    map_gate = "if (map_part) {"
+    assert harness.count(map_gate) == 1
+    for legacy in ("", "menu", "presence", "map", "route", "world_name", "mixed_name_map", "speed", "expansion", "queued_camera", "camera_latch"):
+        name = "placement_" + (legacy or "fixed")
+        test = Path(folder) / (name + ".c")
+        # Removing only the new gate reinstates the original renderer path.
+        # The same UI checks must reject it, not merely exercise new code.
+        mutant = harness.replace(gate, "                centered_ui = 0;\n                if (1) {") if legacy == "menu" else harness
+        if legacy == "presence":
+            mutant = mutant.replace(presence_gate, "")
+        if legacy == "map":
+            mutant = mutant.replace(map_gate, "if (0) {")
+        if legacy == "route":
+            mutant = mutant.replace("return tag[0] == 23117 && tag[1] == -17493;", "return 0;")
+        if legacy == "world_name":
+            mutant = mutant.replace("return tag[0] == 23417 && tag[1] == -17293;", "return 0;")
+        if legacy == "mixed_name_map":
+            mutant = mutant.replace("if (name_n && map_part == 2 && count <= dx_cap && dy)", "if (0)")
+        if legacy == "speed":
+            mutant = mutant.replace("nv2a_minimap_motion_bound(s_minimap_motion_query(map_cx, map_cy))", "0.0f")
+        if legacy == "expansion":
+            mutant = mutant.replace("nv2a_minimap_motion_bound(s_minimap_expansion_query(map_cx, map_cy))", "0.0f")
+        if legacy == "queued_camera":
+            mutant = mutant.replace("int queued_map_camera = map_part == 1 &&", "int queued_map_camera = 0 &&")
+        if legacy == "camera_latch":
+            mutant = mutant.replace("if (!InterlockedCompareExchange(&s_frame_map_valid, 0, 0) ||", "if (1 ||")
+        test.write_text(mutant, encoding="utf-8")
+        exe = Path(folder) / (name + ".exe")
+        subprocess.run(
+            ["cl", "/nologo", "/W4", str(test), "/Fe:" + str(exe), "/Fo:" + str(Path(folder) / (name + ".obj"))],
+            check=True,
+        )
+        result = subprocess.run([str(exe)], capture_output=True, text=True)
+        if legacy in ("speed", "expansion", "queued_camera", "camera_latch"):
+            assert result.returncode and ("Assertion failed:" in result.stderr or
+                                          "placement mismatch:" in result.stderr), result
+            print(legacy + " removed renderer correctly fails camera contract")
+        elif legacy:
+            assert result.returncode == 2 and "placement mismatch:" in result.stderr, result
+            print(legacy + " gate-removed renderer correctly fails shared placement: " + result.stderr.strip())
+        else:
+            assert result.returncode == 0, (result.stdout, result.stderr)
+            print(result.stdout.strip())
