+static void check_map_position(const float captured[4], double x, double y)
+{
+    double expected_x = 2.0 * x / 640.0 - 1.0, expected_y = 1.0 - 2.0 * y / 480.0;
+    if (fabs(captured[0] - expected_x) >= 2e-6 || fabs(captured[1] - expected_y) >= 2e-6)
+        fprintf(stderr,"map placement native=(%.9g,%.9g) expected=(%.9g,%.9g), guest=(%.9g,%.9g)\n",
+                captured[0],captured[1],expected_x,expected_y,x,y);
+    CHECK(fabs(captured[0] - expected_x) < 2e-6 && fabs(captured[1] - expected_y) < 2e-6);
+    CHECK(captured[2] == 0 && captured[3] == 1);
+}
