diff --git a/tests/nv2a_vsh/arl_fixture.h b/tests/nv2a_vsh/arl_fixture.h
new file mode 100644
index 0000000..187933a
--- /dev/null
+++ b/tests/nv2a_vsh/arl_fixture.h
@@ -0,0 +1,48 @@
+/* Shared CPU/GPU fixture: ARL + EXP must choose one spline interval. */
+#ifndef NV2A_ARL_FIXTURE_H
+#define NV2A_ARL_FIXTURE_H
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+static void arl_src(uint32_t w[4], unsigned which, unsigned mux, unsigned reg, unsigned swz)
+{
+    if (which == 0) { w[1] |= swz; w[2] |= (mux << 26) | (reg << 28); }
+    else if (which == 1) { w[2] |= (swz << 17) | (mux << 11) | (reg << 13); }
+    else { w[2] |= (swz << 2) | (reg >> 2); w[3] |= (mux << 28) | ((reg & 3) << 30); }
+}
+
+static void arl_fixture(uint32_t program[136][4], float constants[192][4], float scale)
+{
+    unsigned i;
+    memset(program, 0, 136 * 16);
+    for (i = 0; i < 192; ++i) {
+        constants[i][0] = (float)((int)i - 64);
+        constants[i][1] = (float)i;
+        constants[i][2] = 0; constants[i][3] = 1;
+    }
+    constants[0][0] = constants[0][1] = constants[0][2] = constants[0][3] = scale;
+    /* mul R0, v0, c[0] -- preserves the actual road's float32 multiply. */
+    program[0][1] = 2u << 21;
+    arl_src(program[0], 0, 2, 0, 0); arl_src(program[0], 1, 3, 0, 0);
+    program[0][3] = 0xFu << 24;
+    /* arl a0, R0.x + exp R1, R0.x -- paired ILU always writes R1. */
+    program[1][1] = (13u << 21) | (5u << 25);
+    arl_src(program[1], 0, 1, 0, 0); arl_src(program[1], 2, 1, 0, 0);
+    program[1][3] |= (7u << 20) | (0xFu << 16);
+    /* mov oT0, c[64+a0] -- exposes the selected control-point interval. */
+    program[2][1] = (1u << 21) | (64u << 13);
+    arl_src(program[2], 0, 3, 0, 0x1B);
+    program[2][3] = (0xFu << 12) | (1u << 11) | (9u << 3) | 2u;
+    /* mov oT1, R1 -- exposes EXP's integer power and fractional coordinate. */
+    program[3][1] = 1u << 21;
+    arl_src(program[3], 0, 1, 1, 0x1B);
+    program[3][3] = (0xFu << 12) | (1u << 11) | (10u << 3) | 1u;
+}
+
+static const float arl_boundary_values[] = {
+    0, 1, 16, 59, 15.999999f, 58.999996f, 16.000002f, 59.000004f,
+    -15, -15.000001f, -14.999999f, -58, -58.000004f, -57.999996f,
+    -.0000001f, .0000001f, -.99999994f, -1.00000012f
+};
+#endif
diff --git a/tests/nv2a_vsh/nv2a_vsh_decode_test.c b/tests/nv2a_vsh/nv2a_vsh_decode_test.c
new file mode 100644
index 0000000..344d09a
--- /dev/null
+++ b/tests/nv2a_vsh/nv2a_vsh_decode_test.c
@@ -0,0 +1,63 @@
+/* The pre-decoded instruction step must equal the raw-word step bit for bit:
+ * random 128-bit instructions (every op, mux, swizzle, mask and output
+ * field), random registers, constants and a0, with and without CXT_WRITE. */
+#include "../../src/kernel/nv2a_vsh_interp.c"
+
+static uint32_t rng = 0x9E3779B9u;
+static uint32_t next(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+static float value(void)
+{
+    static const float special[] = { 0.0f, -0.0f, 1.0f, -1.0f, 0.5f, 127.9961f, 1e-30f, 1e30f };
+    uint32_t r = next();
+    if ((r & 7) == 0) return special[(r >> 3) & 7];
+    return ((float)(int32_t)next() / 2147483648.0f) * (float)(1u << (r >> 28));
+}
+
+int main(void)
+{
+    static float in[NV2A_VSH_INPUTS][4], consts[NV2A_VSH_CONSTANTS][4];
+    unsigned trial, i, j;
+    for (trial = 0; trial < 2000000; ++trial) {
+        uint32_t ins[4];
+        vec4 temp[2][12], opos[2];
+        float out[2][13][4], saved[NV2A_VSH_CONSTANTS][4];
+        int a0[2], final[2];
+        uint32_t version[2];
+        VshDec d;
+        ins[0] = 0; ins[1] = next(); ins[2] = next(); ins[3] = next();
+        if (trial % 4 == 0) {                         /* keep MAC ops in range often */
+            ins[1] = (ins[1] & ~(15u << 21)) | ((next() % 14) << 21);
+            ins[1] = (ins[1] & ~(7u << 25)) | ((next() % 8) << 25);
+        }
+        if (trial % 64 == 0) {
+            for (i = 0; i < NV2A_VSH_INPUTS; ++i) for (j = 0; j < 4; ++j) in[i][j] = value();
+            for (i = 0; i < NV2A_VSH_CONSTANTS; ++i) for (j = 0; j < 4; ++j) consts[i][j] = value();
+        }
+        memcpy(s_const, consts, sizeof s_const);
+        for (i = 0; i < 12; ++i) for (j = 0; j < 4; ++j) temp[0][i].v[j] = value();
+        for (j = 0; j < 4; ++j) opos[0].v[j] = value();
+        for (i = 0; i < 13; ++i) for (j = 0; j < 4; ++j) out[0][i][j] = value();
+        a0[0] = (int)(next() % 400) - 200;
+        memcpy(temp[1], temp[0], sizeof temp[0]); opos[1] = opos[0];
+        memcpy(out[1], out[0], sizeof out[0]); a0[1] = a0[0];
+        s_cxt_write = trial % 3 == 0;
+        version[0] = s_const_version;
+        final[0] = vsh_step(ins, (const float (*)[4])in, temp[0], &opos[0], out[0], &a0[0]);
+        version[0] = s_const_version - version[0];
+        memcpy(saved, s_const, sizeof saved);
+        memcpy(s_const, consts, sizeof s_const);
+        vsh_decode(ins, &d);
+        version[1] = s_const_version;
+        final[1] = vsh_step_dec(&d, (const float (*)[4])in, temp[1], &opos[1], out[1], &a0[1]);
+        version[1] = s_const_version - version[1];
+        if (final[0] != final[1] || a0[0] != a0[1] || version[0] != version[1] ||
+            memcmp(temp[0], temp[1], sizeof temp[0]) || memcmp(&opos[0], &opos[1], sizeof opos[0]) ||
+            memcmp(out[0], out[1], sizeof out[0]) || memcmp(saved, s_const, sizeof saved)) {
+            printf("FAIL trial %u: %08X %08X %08X\n", trial, ins[1], ins[2], ins[3]);
+            return 1;
+        }
+    }
+    puts("ok: 2000000 random instructions; decoded step equals the raw-word step bit for bit");
+    return 0;
+}
diff --git a/tests/nv2a_vsh/nv2a_vsh_position_test.c b/tests/nv2a_vsh/nv2a_vsh_position_test.c
new file mode 100644
index 0000000..c70b6dc
--- /dev/null
+++ b/tests/nv2a_vsh/nv2a_vsh_position_test.c
@@ -0,0 +1,84 @@
+/* Position-only runs must be bit-identical to full runs.
+ *
+ * Random programs mix paired MAC/ILU writes, partial masks, oPos written
+ * through temp 12 and o[0], oPos read back as a source, relative constants
+ * behind ARL, and constant writes (CXT_WRITE, which keeps the full run).
+ * Each program runs on several random vertices; the full run's position and
+ * the sliced run's position must match bit for bit. */
+#include "nv2a_vsh_interp.h"
+#include <stdio.h>
+#include <string.h>
+
+static uint32_t seed = 12345u;
+static uint32_t next(void) { seed = seed * 1664525u + 1013904223u; return seed >> 8; }
+static float value(void) { return ((float)(next() % 20001u) - 10000.0f) / 997.0f; }
+
+static void instruction(uint32_t w[4], int final)
+{
+    uint32_t mac = next() % 16u, ilu = next() % 8u;
+    w[0] = 0;
+    w[1] = (ilu << 25) | (mac << 21) | ((next() % 192u) << 13) | ((next() % 16u) << 9) |
+           ((next() & 1u) << 8) | (next() & 0xFFu);
+    w[2] = next() | (next() << 24);
+    w[3] = ((next() % 4u) << 30) | ((next() % 4u) << 28) | ((next() % 16u) << 24) |
+           ((next() % 16u) << 20) | ((next() % 16u) << 16) | ((next() % 16u) << 12) |
+           ((next() % 2u) << 11) | ((next() % 3u == 0 ? 0u : next() % 13u) << 3) |
+           ((next() % 2u) << 2) | ((next() % 4u == 0) << 1) | (final ? 1u : 0u);
+    /* Bias a third of the instructions towards temp 12 (oPos). */
+    if (next() % 3u == 0) w[3] = (w[3] & ~(15u << 20)) | (12u << 20);
+}
+
+int main(void)
+{
+    static float saved[NV2A_VSH_CONSTANTS][4];
+    unsigned programs = 0, runs = 0, sliced = 0, total_length = 0;
+    unsigned p, v, i;
+    for (p = 0; p < 4000; p++) {
+        uint32_t length = 1 + next() % 48u, words[4], version;
+        float in[NV2A_VSH_INPUTS][4];
+        for (i = 0; i < NV2A_VSH_SLOTS; i++) {
+            memset(words, 0, sizeof words);
+            if (i < length) instruction(words, i + 1 == length);
+            nv2a_vsh_set_instruction(i, words);
+        }
+        nv2a_vsh_set_start_slot(0);
+        nv2a_vsh_set_cxt_write(next() % 4u == 0);
+        for (i = 0; i < NV2A_VSH_CONSTANTS; i++) {
+            float c[4] = { value(), value(), value(), value() };
+            nv2a_vsh_set_constant(i, c);
+        }
+        memcpy(saved, nv2a_vsh_constants(&version), sizeof saved);
+        programs++;
+        total_length += length;
+        if (nv2a_vsh_position_inputs() != 0xFFFFu) sliced++;
+        for (v = 0; v < 8; v++) {
+            Nv2aVshOutput full;
+            float pos[4];
+            int a, b;
+            for (i = 0; i < NV2A_VSH_INPUTS; i++) {
+                in[i][0] = value(); in[i][1] = value(); in[i][2] = value(); in[i][3] = value();
+            }
+            a = nv2a_vsh_run((const float (*)[4])in, &full);
+            /* A full run may have written constants; restore them. */
+            for (i = 0; i < NV2A_VSH_CONSTANTS; i++) nv2a_vsh_set_constant(i, saved[i]);
+            {
+                /* Inputs the slice does not read must not matter. */
+                uint32_t used = nv2a_vsh_position_inputs();
+                for (i = 0; i < NV2A_VSH_INPUTS; i++)
+                    if (!(used & (1u << i))) in[i][0] = in[i][1] = in[i][2] = in[i][3] = 1e30f;
+            }
+            b = nv2a_vsh_run_position((const float (*)[4])in, pos);
+            for (i = 0; i < NV2A_VSH_CONSTANTS; i++) nv2a_vsh_set_constant(i, saved[i]);
+            if (a != b || (a && memcmp(full.pos, pos, sizeof pos))) {
+                printf("FAIL program %u vertex %u: full %d (%.9g %.9g %.9g %.9g) slice %d (%.9g %.9g %.9g %.9g)\n",
+                       p, v, a, full.pos[0], full.pos[1], full.pos[2], full.pos[3],
+                       b, pos[0], pos[1], pos[2], pos[3]);
+                return 1;
+            }
+            runs++;
+        }
+    }
+    printf("ok: %u random programs (%u sliced, mean length %.1f), %u vertices bit-identical\n",
+           programs, sliced, (double)total_length / programs, runs);
+    return 0;
+}
diff --git a/tests/nv2a_vsh/nv2a_vsh_test.c b/tests/nv2a_vsh/nv2a_vsh_test.c
index b229880..6957afd 100644
--- a/tests/nv2a_vsh/nv2a_vsh_test.c
+++ b/tests/nv2a_vsh/nv2a_vsh_test.c
@@ -10,6 +10,8 @@
 #include "nv2a_vsh_interp.h"
 #include <math.h>
 #include <stdio.h>
+#include <string.h>
+#include "arl_fixture.h"
 
 enum { T = 1, V = 2, C = 3 };             /* source mux */
 #define XYZW 0x1B                         /* swizzle x,y,z,w */
@@ -23,6 +25,27 @@ static void src(uint32_t w[4], int which, int mux, int reg, int swz)
     else { w[2] |= (swz << 2) | (reg >> 2); w[3] |= (mux << 28) | ((reg & 3) << 30); }
 }
 
+static int check_arl(float input, float scale)
+{
+    uint32_t program[136][4];
+    float constants[192][4], in[NV2A_VSH_INPUTS][4] = {{0}};
+    volatile float value = input * scale;
+    float interval = floorf(value), fraction = value - interval;
+    Nv2aVshOutput output;
+    unsigned i;
+    arl_fixture(program, constants, scale);
+    for (i = 0; i < 136; ++i) nv2a_vsh_set_instruction(i, program[i]);
+    for (i = 0; i < 192; ++i) nv2a_vsh_set_constant(i, constants[i]);
+    in[0][0] = input;
+    if (!nv2a_vsh_run((const float (*)[4])in, &output) || output.tex[0][0] != interval ||
+        fabsf(output.tex[1][1] - fraction) > 1e-6f) {
+        printf("FAIL paired ARL/EXP input=%.9g scale=%.9g value=%.9g interval=%.9g expected=%.9g fraction=%.9g expected=%.9g\n",
+               input, scale, value, output.tex[0][0], interval, output.tex[1][1], fraction);
+        return 1;
+    }
+    return 0;
+}
+
 int main(void)
 {
     uint32_t i0[4] = {0}, i1[4] = {0}, i2[4] = {0};
@@ -63,6 +86,37 @@ int main(void)
                o.pos[0], o.pos[1], o.pos[2], o.pos[3]);
         return 1;
     }
-    puts("ok");
+    {
+        unsigned i;
+        for (i = 0; i < sizeof arl_boundary_values / sizeof arl_boundary_values[0]; ++i)
+            if (check_arl(arl_boundary_values[i], 1)) return 1;
+        /* Actual MM3 road 615: 165 * float32(16/165) is just below 16. */
+        if (check_arl(165, 16.0f / 165.0f)) return 1;
+        for (i = 0; i < 128; ++i) if (check_arl((float)i / 255.0f, 255)) return 1;
+    }
+    {
+        /* The constant version (what makes the renderer re-upload the
+         * constant file) moves only when a stored value changes. */
+        const float same[4] = {1, 2, 3, 4};
+        uint32_t v0, v1, v2, v3, w;
+        nv2a_vsh_set_constant(10, same);
+        nv2a_vsh_constants(&v0);
+        nv2a_vsh_set_constant(10, same);
+        nv2a_vsh_set_constant_load(10);
+        memcpy(&w, &same[0], 4); nv2a_vsh_constant_word(w);
+        memcpy(&w, &same[1], 4); nv2a_vsh_constant_word(w);
+        nv2a_vsh_constant_component(10, 2, w = 0x40400000u);   /* 3.0f */
+        nv2a_vsh_constants(&v1);
+        memcpy(&w, &same[0], 4); nv2a_vsh_constant_word(w);    /* c[10].z = 1: a change */
+        nv2a_vsh_constants(&v2);
+        nv2a_vsh_constant_component(10, 2, 0x40400000u);
+        nv2a_vsh_constants(&v3);
+        if (v1 != v0 || v2 == v1 || v3 == v2 || nv2a_vsh_constant(10)[2] != 3.0f ||
+            nv2a_vsh_constant(10)[0] != 1.0f || nv2a_vsh_constant(10)[1] != 2.0f) {
+            printf("FAIL: constant versions %u %u %u %u\n", v0, v1, v2, v3);
+            return 1;
+        }
+    }
+    puts("ok: screen-space epilogue and 147 paired ARL/EXP relative-fetch cases");
     return 0;
 }
