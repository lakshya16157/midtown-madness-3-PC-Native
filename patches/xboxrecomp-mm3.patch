diff --git a/tests/nv2a_arl/test_arl.c b/tests/nv2a_arl/test_arl.c
new file mode 100644
index 0000000..e1668ce
--- /dev/null
+++ b/tests/nv2a_arl/test_arl.c
@@ -0,0 +1,152 @@
+/* Execute the production ub_vs decoder as a compute probe and read its raw
+ * texture outputs. This avoids rasterization/color quantization hiding a
+ * one-control-point ARL error. The CPU uses the identical encoded program. */
+#include "../../src/video/nv2a_d3d11.c"
+#include "../../src/kernel/nv2a_vsh_interp.h"
+#include "../nv2a_vsh/arl_fixture.h"
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return 0; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+static ID3D11Buffer *output, *readback, *raw, *cb[4];
+static ID3D11UnorderedAccessView *output_uav;
+static ID3D11ShaderResourceView *raw_srv;
+static ID3D11ComputeShader *probe;
+static unsigned cases, biased_misindices;
+static int old_bias;
+
+static int buffer(UINT bytes, UINT bind, UINT misc, UINT stride, ID3D11Buffer **out)
+{
+    D3D11_BUFFER_DESC d = {0};
+    d.ByteWidth = bytes; d.BindFlags = bind; d.MiscFlags = misc; d.StructureByteStride = stride;
+    return SUCCEEDED(ID3D11Device_CreateBuffer(s_dev, &d, NULL, out));
+}
+
+static int init(void)
+{
+    static const char wrapper[] =
+        "\nRWStructuredBuffer<float4> ARLResult : register(u0);\n"
+        "[numthreads(1,1,1)] void arl_probe(uint3 id:SV_DispatchThreadID) {\n"
+        "PSIn o = ub_vs(0); ARLResult[0] = o.t0; ARLResult[1] = o.t1; }\n";
+    ID3DBlob *blob = NULL, *errors = NULL;
+    D3D11_UNORDERED_ACCESS_VIEW_DESC uv = {0};
+    D3D11_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    D3D11_BUFFER_DESC rd = {0};
+    char *hlsl = malloc(sizeof s_hlsl + sizeof wrapper + 32), *p;
+    HRESULT hr;
+    CHECK(hlsl);
+    strcpy(hlsl, s_hlsl);
+    if (old_bias) {
+        /* Exact old production bug, not an independent floor simulation. */
+        p = strstr(hlsl, "a0 = (int)floor(A.x);"); CHECK(p);
+        memmove(p + strlen("a0 = (int)floor(A.x + 0.001);"),
+                p + strlen("a0 = (int)floor(A.x);"), strlen(p + strlen("a0 = (int)floor(A.x);")) + 1);
+        memcpy(p, "a0 = (int)floor(A.x + 0.001);", strlen("a0 = (int)floor(A.x + 0.001);"));
+    }
+    strcat(hlsl, wrapper);
+    hr = D3DCompile(hlsl, strlen(hlsl), "production_nv2a_ub_vs_arl_probe", NULL, NULL,
+                    "arl_probe", "cs_5_0", D3DCOMPILE_ENABLE_STRICTNESS | D3DCOMPILE_OPTIMIZATION_LEVEL3,
+                    0, &blob, &errors);
+    if (errors) { fprintf(stderr, "%s", (char *)ID3D10Blob_GetBufferPointer(errors)); ID3D10Blob_Release(errors); }
+    free(hlsl); CHECK(SUCCEEDED(hr));
+    CHECK(SUCCEEDED(D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_WARP, NULL, 0, NULL, 0,
+                                     D3D11_SDK_VERSION, &s_dev, NULL, &s_ctx)));
+    CHECK(SUCCEEDED(ID3D11Device_CreateComputeShader(s_dev, ID3D10Blob_GetBufferPointer(blob),
+                                                    ID3D10Blob_GetBufferSize(blob), NULL, &probe)));
+    ID3D10Blob_Release(blob);
+    CHECK(buffer(32, D3D11_BIND_UNORDERED_ACCESS, D3D11_RESOURCE_MISC_BUFFER_STRUCTURED, 16, &output));
+    uv.ViewDimension = D3D11_UAV_DIMENSION_BUFFER; uv.Buffer.NumElements = 2;
+    CHECK(SUCCEEDED(ID3D11Device_CreateUnorderedAccessView(s_dev, (ID3D11Resource *)output, &uv, &output_uav)));
+    rd.ByteWidth = 32; rd.Usage = D3D11_USAGE_STAGING; rd.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateBuffer(s_dev, &rd, NULL, &readback)));
+    CHECK(buffer(16, D3D11_BIND_SHADER_RESOURCE, D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS, 0, &raw));
+    sv.Format = DXGI_FORMAT_R32_TYPELESS; sv.ViewDimension = D3D11_SRV_DIMENSION_BUFFEREX;
+    sv.BufferEx.NumElements = 4; sv.BufferEx.Flags = D3D11_BUFFEREX_SRV_FLAG_RAW;
+    CHECK(SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)raw, &sv, &raw_srv)));
+    CHECK(buffer(sizeof(UbConsts), D3D11_BIND_CONSTANT_BUFFER, 0, 0, &cb[0]));
+    CHECK(buffer(136 * 16, D3D11_BIND_CONSTANT_BUFFER, 0, 0, &cb[2]));
+    CHECK(buffer(192 * 16, D3D11_BIND_CONSTANT_BUFFER, 0, 0, &cb[3]));
+    ID3D11DeviceContext_CSSetShader(s_ctx, probe, NULL, 0);
+    ID3D11DeviceContext_CSSetConstantBuffers(s_ctx, 0, 4, cb);
+    ID3D11DeviceContext_CSSetShaderResources(s_ctx, 0, 1, &raw_srv);
+    ID3D11DeviceContext_CSSetUnorderedAccessViews(s_ctx, 0, 1, &output_uav, NULL);
+    return 0;
+}
+
+static int run_case(float input, float scale, int normalized_byte, const char *label)
+{
+    uint32_t program[136][4], packed[4] = {0};
+    float constants[192][4], in[16][4] = {{0}}, result[2][4];
+    volatile float value = input * scale;
+    float expected = floorf(value), fraction = value - expected;
+    int gpu_index = (int)(old_bias ? floorf(value + .001f) : expected);
+    /* HLSL normalizes UBYTE through a reciprocal multiply, while the CPU
+     * reference divides. Accept a few float32 ULPs, but never another index. */
+    float fraction_tolerance = normalized_byte >= 0 ? 2e-5f : 1e-6f;
+    Nv2aVshOutput cpu;
+    UbConsts uc = {0};
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    unsigned i;
+    arl_fixture(program, constants, scale);
+    for (i = 0; i < 136; ++i) nv2a_vsh_set_instruction(i, program[i]);
+    for (i = 0; i < 192; ++i) nv2a_vsh_set_constant(i, constants[i]);
+    in[0][0] = in[0][1] = in[0][2] = in[0][3] = input;
+    CHECK(nv2a_vsh_run((const float (*)[4])in, &cpu));
+    if (cpu.tex[0][0] != expected || fabsf(cpu.tex[1][1] - fraction) > 1e-6f) {
+        fprintf(stderr, "FAIL CPU %s input=%.9g scaled=%.9g selected=%.9g expected=%.9g frac=%.9g\n",
+                label, input, value, cpu.tex[0][0], expected, cpu.tex[1][1]); return 1;
+    }
+    memcpy(uc.def[0], in[0], sizeof in[0]);
+    if (normalized_byte >= 0) {
+        packed[0] = (uint32_t)normalized_byte * 0x01010101u;
+        uc.at[0][2] = 4; uc.at[0][3] = 4;
+    }
+    uc.info[1] = 1; uc.info[2] = uc.info[3] = 0xFFFFFFFFu;
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)raw, 0, NULL, packed, 0, 0);
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)cb[0], 0, NULL, &uc, 0, 0);
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)cb[2], 0, NULL, program, 0, 0);
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)cb[3], 0, NULL, constants, 0, 0);
+    ID3D11DeviceContext_Dispatch(s_ctx, 1, 1, 1);
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)readback, (ID3D11Resource *)output);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)readback, 0, D3D11_MAP_READ, 0, &mapped)));
+    memcpy(result, mapped.pData, sizeof result);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)readback, 0);
+    if (result[0][0] != (float)gpu_index || fabsf(result[1][1] - fraction) > fraction_tolerance ||
+        fabsf(result[1][0] / exp2f(expected) - 1) > 1e-5f) {
+        fprintf(stderr, "FAIL GPU %s input=%.9g scaled=%.9g selected=%.9g expected=%d frac=%.9g expectedfrac=%.9g EXP=(%.9g %.9g %.9g %.9g) fetch=(%.9g %.9g %.9g %.9g)\n",
+                label, input, value, result[0][0], gpu_index, result[1][1], fraction,
+                result[1][0],result[1][1],result[1][2],result[1][3],result[0][0],result[0][1],result[0][2],result[0][3]); return 1;
+    }
+    if (result[0][0] != expected) {
+        ++biased_misindices;
+        printf("old-bias misindex %s value=%.9g ARL=%.0f EXPfrac=%.9g expectedARL=%.0f\n",
+               label, value, result[0][0], result[1][1], expected);
+    }
+    ++cases;
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    unsigned i;
+    old_bias = argc == 2 && !strcmp(argv[1], "--old-bias-check");
+    CHECK(!init());
+    for (i = 0; i < sizeof arl_boundary_values / sizeof arl_boundary_values[0]; ++i)
+        CHECK(!run_case(arl_boundary_values[i], 1, -1, "boundary"));
+    CHECK(!run_case(165, 16.0f / 165.0f, -1, "actual-road615-spline"));
+    /* Real UBYTE/255 fetch, then *255: usable matrix-index range c64..c191. */
+    for (i = 0; i < 128; ++i) CHECK(!run_case((float)i / 255.0f, 255, (int)i, "normalized-byte-matrix-index"));
+    CHECK(old_bias ? biased_misindices >= 5 : biased_misindices == 0);
+    printf("PASS %u paired ARL/EXP CPU+production-HLSL cases; old-bias misindices=%u\n", cases, biased_misindices);
+    ID3D11DeviceContext_ClearState(s_ctx);
+    ID3D11ComputeShader_Release(probe);
+    ID3D11UnorderedAccessView_Release(output_uav); ID3D11ShaderResourceView_Release(raw_srv);
+    ID3D11Buffer_Release(output); ID3D11Buffer_Release(readback); ID3D11Buffer_Release(raw);
+    for (i = 0; i < 4; ++i) if (cb[i]) ID3D11Buffer_Release(cb[i]);
+    ID3D11DeviceContext_Release(s_ctx); ID3D11Device_Release(s_dev);
+    return 0;
+}
