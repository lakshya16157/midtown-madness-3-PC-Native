+void mcpx_apu_wake_commands(MCPXAPUState *d, bool broadcast)
+{
+    /* Commands wake an idle producer or the legacy timed-wait fallback. The
+     * native throttle only rechecks time/pause/exit, so a command notification
+     * there merely interrupts and re-arms the same output deadline. */
+    if (broadcast) qemu_cond_broadcast(&d->cond);
+    else qemu_cond_signal(&d->cond);
+}
+
+void mcpx_apu_wake(MCPXAPUState *d, bool broadcast)
+{
+    /* Pause, shutdown and runtime backend changes must interrupt either wait. */
+    apu_hires_wait_notify(&d->hires_wait);
+    mcpx_apu_wake_commands(d, broadcast);
+}
+
+int mcpx_apu_get_hires_wait_enabled(void)
+{
+    MCPXAPUState *d = g_state;
+    return d && !qatomic_read(&d->exiting) && apu_hires_wait_enabled(&d->hires_wait);
+}
+
+int mcpx_apu_set_hires_wait_enabled(int enabled)
+{
+    MCPXAPUState *d = g_state;
+    if (!d || (enabled != 0 && enabled != 1)) return 0;
+    qemu_mutex_lock(&d->lock);
+    int accepted = !qatomic_read(&d->exiting) &&
+        (!enabled || apu_hires_wait_available(&d->hires_wait));
+    if (accepted) {
+        apu_hires_wait_select(&d->hires_wait, enabled);
+        /* The lock also pairs this wake with entry to the condition wait.
+         * Native waits have already released the lock and wake on the event. */
+        mcpx_apu_wake(d, false);
+    }
+    qemu_mutex_unlock(&d->lock);
+    return accepted;
+}
