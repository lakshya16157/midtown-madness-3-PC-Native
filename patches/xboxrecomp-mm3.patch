+static void reset_poll_config(void)
+{
+    s_wb_poll_configured = s_wb_poll_last_valid = 0;
+    s_wb_poll_ticks = s_wb_poll_frequency = 0;
+    InterlockedExchange(&s_wb_poll_requested, -1);
+    InterlockedExchange(&s_wb_poll_effective, -1);
+}
