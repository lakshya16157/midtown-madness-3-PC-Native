+/* Deliberately asymmetric in all three axes: a narrow X strip near the
+ * lower Y face, occupying only the middle half of Z. Swapping attenuation
+ * axes, reversing forward, or dropping a signed reconstruction term must
+ * change a sampled pixel. A symmetric point-light fixture cannot catch that. */
+static void make_direction_field(uint8_t *dst)
+{
+    unsigned group, by, bx, dz;
+    size_t offset = 0;
+    for (group = 0; group < 32; group += 4)
+        for (by = 0; by < 8; ++by) for (bx = 0; bx < 8; ++bx)
+            for (dz = 0; dz < 4; ++dz) {
+                unsigned alpha = bx >= 3 && bx < 5 && by < 2 &&
+                    group + dz >= 8 && group + dz < 24 ? 255 : 0;
+                memset(dst + offset, 0, 16);
+                dst[offset] = dst[offset + 1] = (uint8_t)alpha;
+                offset += 16;
+            }
+}
+
+static void draw_direction_field(const NvD3DState *st, float fx, float fz,
+                                  float origin_x, float origin_z)
+{
+    static const uint32_t indices[] = {0,1,2,2,1,3};
+    static const float position[4][4] = {
+        {0,0,2097151.875f,1},{64,0,2097151.875f,1},
+        {0,64,2097151.875f,1},{64,64,2097151.875f,1}
+    };
+    static const float ground[4][2] = {{-1,-1},{1,-1},{-1,1},{1,1}};
+    float rows[3][4][4] = {{{0}}}, defaults[16][4] = {{0}};
+    NvD3DAttrib attr[16] = {{0}};
+    unsigned v, row;
+    attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+    attr[0].stride = sizeof position[0]; attr[0].data = (const uint8_t *)position;
+    defaults[3][0] = defaults[3][1] = defaults[3][2] = defaults[3][3] = 1;
+    defaults[9][0] = 65; defaults[9][1] = 32; defaults[9][3] = 1;
+    for (v = 0; v < 4; ++v) {
+        float x = ground[v][0] - origin_x, z = ground[v][1] - origin_z;
+        /* Independent ground-plane inverse transform: right=(fz,-fx),
+         * forward=(fx,fz). The scene depth is .25. Texture Z is the source's
+         * forward axis, including after yaw. */
+        depth_row(rows[0][v], .5f + .4f * (x * fz - z * fx), .25f);
+        depth_row(rows[1][v], .125f, .25f);
+        depth_row(rows[2][v], .0625f + .375f * (x * fx + z * fz), .25f);
+    }
+    for (row = 0; row < 3; ++row) {
+        attr[10 + row].enabled = 1; attr[10 + row].type = 2; attr[10 + row].size = 4;
+        attr[10 + row].stride = sizeof rows[row][0];
+        attr[10 + row].data = (const uint8_t *)rows[row];
+    }
+    fixture_prepare_shader(st);
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attr, defaults, 0, indices, 6, 0, 3, NULL);
+}
+
+static int check_projector_directions(NvD3DState st, Surface *target)
+{
+    static const float headings[8][2] = {
+        {0,1},{.70710678f,.70710678f},{1,0},{.70710678f,-.70710678f},
+        {0,-1},{-.70710678f,-.70710678f},{-1,0},{-.70710678f,.70710678f}
+    };
+    unsigned heading, translated, side;
+    make_direction_field(ram + 0x100000);
+    nv2a_d3d_kick();
+    CHECK(!sample_light(&st,target,"asymmetric-xyz",.5f,.125f,.3125f,255,.125f));
+    CHECK(!sample_light(&st,target,"swapped-xz",.3125f,.125f,.5f,0,.125f));
+    CHECK(!sample_light(&st,target,"swapped-yz",.5f,.3125f,.125f,0,.125f));
+    CHECK(!sample_light(&st,target,"swapped-xy",.125f,.5f,.3125f,0,.125f));
+    for (heading = 0; heading < 8; ++heading) for (translated = 0; translated < 2; ++translated) {
+        float fx = headings[heading][0], fz = headings[heading][1];
+        float ox = translated ? .1f : 0, oz = translated ? -.1f : 0;
+        nv2a_d3d_clear(&st,0xF1,0xA5000000,(uint32_t)(.25f * 16777215.0f) << 8,0,0,63,63);
+        draw_direction_field(&st,fx,fz,ox,oz);
+        /* Ahead is illuminated; the two sides and the rear stay dark at the
+         * same distance, for cardinal/diagonal headings and a moved source. */
+        for (side = 0; side < 4; ++side) {
+            float x = side < 2 ? fx : fz, z = side < 2 ? fz : -fx;
+            float distance = (side & 1) ? -.7f : .7f;
+            unsigned px = (unsigned)((ox + distance * x + 1) * 32 * target->sx);
+            unsigned py = (unsigned)((oz + distance * z + 1) * 32 * target->sy);
+            uint32_t value = pixel(target,px,py);
+            CHECK((value >> 24) == 0xA5);
+            CHECK((value & 255) == (side ? 0u : 255u));
+        }
+    }
+    puts("PASS: asymmetric volume axes and forward-only ground footprints at eight headings, including translated sources");
+    return 0;
+}
+
+/* MM3's own row builder (000EA998 + 000EA6D2 + 000EA623 + 00012D9A), written
+ * out from the retail code. For the screen position (X, Y), 0..1, row k is
+ *   (a_k, ROW_HI * u_k, ROW_LO * u_k)
+ *   u_k = scale_k * R_k . ((X - .5) * Wf, -(Y - .5) * Hf, far)
+ *   a_k = scale_k * (offset_k - R_k . T)
+ * with R_k the light's axes in camera space, T its origin, (Wf, Hf) the far
+ * plane's size and scale/offset the volume's, so the dot product with the
+ * depth view (1, hi, lo) of a surface at depth fraction d is the volume
+ * coordinate of the camera-space point d * (far-plane point). */
+static void retail_rows(const float R[3][3], const float T[3], float tan_half_y,
+                        float aspect, float far_plane, const float scale[3],
+                        const float offset[3], float X, float Y, float rows[3][4])
+{
+    float hf = 2 * tan_half_y * far_plane, wf = hf * aspect;
+    float ray[3] = {(X - .5f) * wf, -(Y - .5f) * hf, far_plane};
+    unsigned k;
+    for (k = 0; k < 3; ++k) {
+        float u = R[k][0] * ray[0] + R[k][1] * ray[1] + R[k][2] * ray[2];
+        float a = offset[k] - (R[k][0] * T[0] + R[k][1] * T[1] + R[k][2] * T[2]);
+        rows[k][0] = a * scale[k]; rows[k][1] = ROW_HI * u * scale[k];
+        rows[k][2] = ROW_LO * u * scale[k]; rows[k][3] = 1;
+    }
+}
+
+/* A light 4 m right of and 3 m below the camera axis, 30 m out, lighting a
+ * wall at that depth: only the wall points inside the volume's lit cuboid
+ * may be lit, whatever the light's yaw. The camera is far from the light, so
+ * a depth view that scaled the constant row by the depth (as the luminance
+ * view does) would put the light somewhere else. */
+static int check_retail_rows(NvD3DState st, Surface *target)
+{
+    static const float tan_half = 1.0f, aspect = 1.0f, far_plane = 100.0f;
+    static const float light[3] = {4, -3, 30}, depth = .3f;
+    static const float scale[3] = {1 / 12.0f, 1 / 12.0f, 1 / 12.0f}, offset[3] = {6, 6, 6};
+    static const uint32_t indices[] = {0,1,2,2,1,3};
+    static const float corner[4][2] = {{0,0},{1,0},{0,1},{1,1}};
+    unsigned yaw, gx, gy, v, k, lit = 0, dark = 0;
+    CHECK(make_field(ram + 0x100000, 32, 32, 32, 1) == 32768);
+    nv2a_d3d_kick();
+    for (yaw = 0; yaw < 3; ++yaw) {
+        unsigned yaw_lit = 0, yaw_dark = 0;
+        float angle = yaw * 0.5235988f, c = cosf(angle), s = sinf(angle);
+        float R[3][3] = {{c, 0, -s}, {0, 1, 0}, {s, 0, c}};
+        float position[4][4], rows[3][4][4] = {{{0}}}, defaults[16][4] = {{0}}, d = depth_fraction(depth);
+        NvD3DAttrib attr[16] = {{0}};
+        for (v = 0; v < 4; ++v) {
+            float r[3][4];
+            position[v][0] = corner[v][0] * 64; position[v][1] = corner[v][1] * 64;
+            position[v][2] = .05f * 16777215.0f; position[v][3] = 1;
+            retail_rows(R, light, tan_half, aspect, far_plane, scale, offset,
+                        corner[v][0], corner[v][1], r);
+            for (k = 0; k < 3; ++k) memcpy(rows[k][v], r[k], sizeof r[k]);
+        }
+        attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+        attr[0].stride = sizeof position[0]; attr[0].data = (const uint8_t *)position;
+        for (k = 0; k < 3; ++k) {
+            attr[10 + k].enabled = 1; attr[10 + k].type = 2; attr[10 + k].size = 4;
+            attr[10 + k].stride = sizeof rows[k][0]; attr[10 + k].data = (const uint8_t *)rows[k];
+        }
+        defaults[3][0] = defaults[3][1] = defaults[3][2] = defaults[3][3] = 1;
+        defaults[9][0] = 65; defaults[9][1] = 32; defaults[9][3] = 1;
+        nv2a_d3d_clear(&st, 0xF1, 0xA5000000, ((uint32_t)(depth * 16777215.0f)) << 8, 0,0,63,63);
+        fixture_prepare_shader(&st);
+        nv2a_d3d_draw_ub(&st, NV_D3D_TRIANGLES, attr, defaults, 0, indices, 6, 0, 3, NULL);
+        /* The 60-degree footprint is narrower than four screen pixels after
+         * excluding its boundary. A four-pixel lattice misses its lit interior
+         * entirely; two-pixel spacing covers every yaw (20/8/4 lit samples). */
+        for (gy = 2; gy < 64; gy += 2) for (gx = 2; gx < 64; gx += 2) {
+            float X = (gx + .5f) / 64, Y = (gy + .5f) / 64, p[3], q[3], margin;
+            uint32_t value = pixel(target, (unsigned)((gx + .5f) * target->sx),
+                                   (unsigned)((gy + .5f) * target->sy));
+            p[0] = d * (X - .5f) * 2 * tan_half * far_plane * aspect;
+            p[1] = -d * (Y - .5f) * 2 * tan_half * far_plane;
+            p[2] = d * far_plane;
+            for (k = 0; k < 3; ++k)
+                q[k] = scale[k] * (R[k][0] * (p[0] - light[0]) + R[k][1] * (p[1] - light[1]) +
+                                   R[k][2] * (p[2] - light[2]) + offset[k]) - .5f;
+            /* The fixture is lit for |u-.5|,|v-.5| < .375 and |w-.5| < .125. */
+            margin = fminf(fminf(.375f - fabsf(q[0]), .375f - fabsf(q[1])), .125f - fabsf(q[2]));
+            if (margin > .04f) {
+                CHECK((value >> 24) == 0xA5 && (value & 255) == 255); ++yaw_lit;
+            } else if (margin < -.04f) {
+                CHECK((value >> 24) == 0xA5 && (value & 255) == 0); ++yaw_dark;
+            }
+        }
+        printf("retail rows yaw %u: %u lit and %u dark wall pixels match the analytic volume\n",
+               yaw * 30, yaw_lit, yaw_dark);
+        CHECK(yaw_lit >= 4 && yaw_dark >= 100);
+        lit += yaw_lit; dark += yaw_dark;
+    }
+    printf("retail rows: %u lit and %u dark wall pixels match the analytic volume at three yaws\n", lit, dark);
+    CHECK(lit >= 12 && dark >= 100);
+    return 0;
+}
+
+/* The emitter crosses the camera plane while its 50 m forward volume still
+ * reaches a visible wall at 25 m. No car/lens geometry is submitted: local
+ * illumination depends on the volume's footprint, not emitter visibility. */
+static int check_offscreen_source(NvD3DState st, Surface *target)
+{
+    static const float R[3][3] = {{1,0,0},{0,1,0},{0,0,1}};
+    static const float source_z[] = {2,0,-2,-4};
+    static const float scale[3] = {1 / 12.0f,1 / 12.0f,1 / 50.0f};
+    static const float offset[3] = {6,6,0}, depth = .25f, far_plane = 100;
+    static const uint32_t indices[] = {0,1,2,2,1,3};
+    static const float corner[4][2] = {{0,0},{1,0},{0,1},{1,1}};
+    unsigned source, gx, gy, v, k;
+    CHECK(make_field(ram + 0x100000,32,32,32,1) == 32768);
+    nv2a_d3d_kick();
+    for (source = 0; source < sizeof source_z / sizeof source_z[0]; ++source) {
+        float light[3] = {0,-3,source_z[source]};
+        float position[4][4], rows[3][4][4] = {{{0}}}, defaults[16][4] = {{0}};
+        float d = depth_fraction(depth);
+        NvD3DAttrib attr[16] = {{0}};
+        unsigned lit = 0, dark = 0;
+        for (v = 0; v < 4; ++v) {
+            float r[3][4];
+            position[v][0] = corner[v][0] * 64; position[v][1] = corner[v][1] * 64;
+            position[v][2] = .05f * 16777215.0f; position[v][3] = 1;
+            retail_rows(R,light,1,1,far_plane,scale,offset,corner[v][0],corner[v][1],r);
+            for (k = 0; k < 3; ++k) memcpy(rows[k][v],r[k],sizeof r[k]);
+        }
+        attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+        attr[0].stride = sizeof position[0]; attr[0].data = (const uint8_t *)position;
+        for (k = 0; k < 3; ++k) {
+            attr[10 + k].enabled = 1; attr[10 + k].type = 2; attr[10 + k].size = 4;
+            attr[10 + k].stride = sizeof rows[k][0]; attr[10 + k].data = (const uint8_t *)rows[k];
+        }
+        defaults[3][0] = defaults[3][1] = defaults[3][2] = defaults[3][3] = 1;
+        defaults[9][0] = 65; defaults[9][1] = 32; defaults[9][3] = 1;
+        nv2a_d3d_clear(&st,0xF1,0xA5000000,((uint32_t)(depth * 16777215.0f)) << 8,0,0,63,63);
+        fixture_prepare_shader(&st);
+        nv2a_d3d_draw_ub(&st,NV_D3D_TRIANGLES,attr,defaults,0,indices,6,0,3,NULL);
+        for (gy = 2; gy < 64; gy += 2) for (gx = 2; gx < 64; gx += 2) {
+            float X = (gx + .5f) / 64, Y = (gy + .5f) / 64;
+            float p[3] = {d * (X - .5f) * 2 * far_plane,
+                          -d * (Y - .5f) * 2 * far_plane,d * far_plane};
+            float q[3], margin;
+            uint32_t value;
+            for (k = 0; k < 3; ++k) q[k] = (p[k] - light[k] + offset[k]) * scale[k] - .5f;
+            margin = fminf(fminf(.375f - fabsf(q[0]),.375f - fabsf(q[1])),.125f - fabsf(q[2]));
+            value = pixel(target,(unsigned)((gx + .5f) * target->sx),(unsigned)((gy + .5f) * target->sy));
+            CHECK((value >> 24) == 0xA5);
+            if (margin > .04f) { CHECK((value & 0x00FFFFFFu) == 0x00FFFFFFu); ++lit; }
+            else if (margin < -.04f) { CHECK((value & 0x00FFFFFFu) == 0); ++dark; }
+        }
+        printf("offscreen emitter z=%.1f: %u lit and %u dark visible wall pixels match its forward volume\n",light[2],lit,dark);
+        CHECK(lit >= 16 && dark >= 100);
+    }
+    puts("PASS: visible illumination survives emitter crossing and moving behind the camera plane without model geometry");
+    return 0;
+}
