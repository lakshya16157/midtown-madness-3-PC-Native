+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    CHECK(open_asset("d:\\asset.bin", NULL, ACCESS, 3, OPTIONS, &h) == STATUS_SUCCESS && (mode(h) & 8));
+    writer = CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    CHECK(writer != INVALID_HANDLE_VALUE); CHECK(CloseHandle(writer)); writer = INVALID_HANDLE_VALUE;
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    root = CreateFileW(folder, FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    CHECK(root != INVALID_HANDLE_VALUE);
+    CHECK(open_asset("asset.bin", root, ACCESS, 1, OPTIONS, &h) == STATUS_SUCCESS && (mode(h) & 8));
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    CHECK(open_asset("d:\\asset.bin", NULL, ACCESS, 1, 0x40, &h) == STATUS_SUCCESS && !(mode(h) & 8));
+    puts("PASS: buffering policy, real bytes/offsets/events/EOF, original writer/delete sharing, writable flags and close/reopen coherence");
+    result = 0;
+done:
+    if (h) xbox_NtClose(h);
+    if (writer != INVALID_HANDLE_VALUE) CloseHandle(writer);
+    if (root != INVALID_HANDLE_VALUE) CloseHandle(root);
+    if (expected) VirtualFree(expected, 0, MEM_RELEASE);
+    if (buffer) VirtualFree(buffer, 0, MEM_RELEASE);
+    if (*folder) remove_fixture(folder);
+    return result;
+}
+
+static int compare_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x > y ? 1 : x < y ? -1 : 0;
+}
+
+static int benchmark(const char *setting, const char *asset)
+{
+    WCHAR folder[MAX_PATH] = {0}, native[MAX_PATH];
+    char save[MAX_PATH * 4], parent[MAX_PATH * 4], guest[MAX_PATH];
+    HANDLE h = NULL, warm = INVALID_HANDLE_VALUE;
+    unsigned char *buffer = NULL;
+    LARGE_INTEGER size, offset, frequency, start, end;
+    XBOX_IO_STATUS_BLOCK ios;
+    const unsigned lengths[] = {4096, 12288, 65536};
+    double samples[128], total;
+    uint64_t hash = 14695981039346656037ull;
+    DWORD count;
+    int result = 1;
+    char *leaf;
+    CHECK(_putenv_s("RECOMP_BUFFERED_ASSET_READS", setting) == 0);
+    CHECK(fixture(folder, save));
+    CHECK(MultiByteToWideChar(CP_UTF8, 0, asset, -1, native, MAX_PATH));
+    strcpy_s(parent, sizeof parent, asset);
+    leaf = strrchr(parent, '\\'); CHECK(leaf); *leaf++ = 0;
+    sprintf_s(guest, sizeof guest, "d:\\%s", leaf);
+    xbox_path_init(parent, save);
+    buffer = VirtualAlloc(NULL, 65536, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE); CHECK(buffer);
+    warm = CreateFileW(native, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    CHECK(warm != INVALID_HANDLE_VALUE && GetFileSizeEx(warm, &size) && size.QuadPart > 65536);
+    CHECK(QueryPerformanceFrequency(&frequency));
+    /* Deliberately warm these exact ranges through a normal cached handle.
+     * NO_BUFFERING bypasses the OS cache, but device/controller caches may be
+     * warm too. This is not a cold-storage or an in-game FPS benchmark. */
+    for (unsigned i = 0; i < 128; ++i) {
+        offset.QuadPart = ((uint64_t)i * 2654435761u % ((size.QuadPart - 65536) / 4096)) * 4096;
+        CHECK(SetFilePointerEx(warm, offset, NULL, FILE_BEGIN) && ReadFile(warm, buffer, 65536, &count, NULL) && count == 65536);
+    }
+    CHECK(CloseHandle(warm)); warm = INVALID_HANDLE_VALUE;
+    CHECK(open_asset(guest, NULL, ACCESS, 1, OPTIONS, &h) == STATUS_SUCCESS);
+    CHECK((mode(h) & 8) == (!strcmp(setting, "1") ? 0u : 8u));
+    printf("{\"policy\":%s,\"context\":\"128 fixed ranges deliberately warmed through Windows cache; device cache may also be warm; no cold-start/FPS claim\",\"results\":[", setting);
+    for (unsigned k = 0; k < 3; ++k) {
+        total = 0;
+        for (unsigned i = 0; i < 128; ++i) {
+            offset.QuadPart = ((uint64_t)i * 2654435761u % ((size.QuadPart - 65536) / 4096)) * 4096;
+            QueryPerformanceCounter(&start);
+            CHECK(xbox_NtReadFile(h, NULL, NULL, NULL, &ios, buffer, lengths[k], &offset) == STATUS_SUCCESS && ios.Information == lengths[k]);
+            QueryPerformanceCounter(&end);
+            samples[i] = (end.QuadPart - start.QuadPart) * 1000.0 / frequency.QuadPart;
+            total += samples[i];
+            for (unsigned j = 0; j < lengths[k]; ++j) hash = (hash ^ buffer[j]) * 1099511628211ull;
+        }
+        qsort(samples, 128, sizeof *samples, compare_double);
+        printf("%s{\"bytes\":%u,\"reads\":128,\"total_ms\":%.6f,\"p50_ms\":%.6f,\"p95_ms\":%.6f,\"p99_ms\":%.6f,\"max_ms\":%.6f}", k ? "," : "", lengths[k], total, samples[64], samples[121], samples[126], samples[127]);
+    }
+    printf("],\"hash\":\"%016llX\"}\n", (unsigned long long)hash);
+    result = 0;
+done:
+    if (h) xbox_NtClose(h);
+    if (warm != INVALID_HANDLE_VALUE) CloseHandle(warm);
+    if (buffer) VirtualFree(buffer, 0, MEM_RELEASE);
+    if (*folder) remove_fixture(folder);
+    return result;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc == 4 && !strcmp(argv[1], "bench")) return benchmark(argv[2], argv[3]);
+    return contracts(argc == 2 ? argv[1] : "unset");
+}
diff --git a/tests/kernel_dispatch/kernel_file_hitch_test.c b/tests/kernel_dispatch/kernel_file_hitch_test.c
