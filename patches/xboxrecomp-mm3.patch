diff --git a/src/apu/apu_dsp_handoff.h b/src/apu/apu_dsp_handoff.h
new file mode 100644
index 0000000..f5a4c60
--- /dev/null
+++ b/src/apu/apu_dsp_handoff.h
@@ -0,0 +1,69 @@
+/* Included after MCPXAPUState. Control callers own the producer lock before
+ * publishing a request, then acquire dsp_lock. The worker never needs the
+ * producer lock and cannot execute another quantum until the observed request
+ * is acknowledged. Bounds are execution quanta, not scheduler wall time. */
+#ifndef MCPX_APU_DSP_HANDOFF_H
+#define MCPX_APU_DSP_HANDOFF_H
+
+static inline void apu_dsp_handoff_init(MCPXAPUState *d, int enabled)
+{
+    d->dsp_handoff_enabled = enabled == 1;
+    InterlockedExchange(&d->dsp_control_pending, 0);
+    InterlockedExchange(&d->dsp_control_completed, 0);
+    if (d->dsp_handoff_enabled) qemu_cond_init(&d->dsp_control_done_cond);
+}
+
+static inline void apu_dsp_handoff_destroy(MCPXAPUState *d)
+{
+    if (d->dsp_handoff_enabled) qemu_cond_destroy(&d->dsp_control_done_cond);
+}
+
+static inline void apu_dsp_control_lock(MCPXAPUState *d)
+{
+    if (d->dsp_handoff_enabled) InterlockedIncrement(&d->dsp_control_pending);
+    qemu_mutex_lock(&d->dsp_lock);
+}
+
+static inline void apu_dsp_control_unlock(MCPXAPUState *d)
+{
+    if (d->dsp_handoff_enabled) {
+        InterlockedDecrement(&d->dsp_control_pending);
+        InterlockedIncrement(&d->dsp_control_completed);
+        qemu_cond_broadcast(&d->dsp_control_done_cond);
+    }
+    qemu_mutex_unlock(&d->dsp_lock);
+}
+
+/* Called with dsp_lock held before the first and between existing quanta.
+ * A request arriving after the check waits at most the current DSP quantum,
+ * rather than relying on critical-section acquisition order for progress. */
+static inline void apu_dsp_quantum_handoff(MCPXAPUState *d)
+{
+    if (!d->dsp_handoff_enabled) {
+        qemu_mutex_unlock(&d->dsp_lock);
+        Sleep(0);
+        qemu_mutex_lock(&d->dsp_lock);
+        return;
+    }
+    if (InterlockedCompareExchange(&d->dsp_control_pending, 0, 0)) {
+        LONG completed = InterlockedCompareExchange(&d->dsp_control_completed, 0, 0);
+        /* All controllers hold the producer lock, so only one request can be
+         * published at once. Wait for that request, not all future arrivals:
+         * continuous MMIO polling must still permit one DSP quantum per ack. */
+        while (InterlockedCompareExchange(&d->dsp_control_completed, 0, 0) == completed &&
+               !qatomic_read(&d->exiting))
+            qemu_cond_wait(&d->dsp_control_done_cond, &d->dsp_lock);
+    }
+}
+
+/* Shutdown publishes exiting first. Pair the broadcast with the handoff lock
+ * so a waiter cannot miss the predicate change while entering its sleep. */
+static inline void apu_dsp_handoff_shutdown_wake(MCPXAPUState *d)
+{
+    if (!d->dsp_handoff_enabled) return;
+    qemu_mutex_lock(&d->dsp_lock);
+    qemu_cond_broadcast(&d->dsp_control_done_cond);
+    qemu_mutex_unlock(&d->dsp_lock);
+}
+
+#endif
diff --git a/src/apu/apu_dsp_trace.h b/src/apu/apu_dsp_trace.h
new file mode 100644
index 0000000..675fbe6
--- /dev/null
+++ b/src/apu/apu_dsp_trace.h
@@ -0,0 +1,197 @@
+/* Opt-in DSP scheduling diagnostics. Histories are committed/snapshotted with
+ * the existing DSP queue lock. Pending reports belong only to the producer. */
+#ifndef MCPX_APU_DSP_TRACE_H
+#define MCPX_APU_DSP_TRACE_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <errno.h>
+
+#define APU_DSP_TRACE_HISTORY 16u
+#define APU_DSP_TRACE_MAX_REPORTS 64u
+#define APU_DSP_TRACE_WAITS 2u
+typedef struct APUDSPTraceStamp { int64_t qpc; bool valid; } APUDSPTraceStamp;
+typedef struct APUDSPTraceCycles { uint64_t value; bool valid; } APUDSPTraceCycles;
+typedef struct APUDSPTraceJob {
+    uint64_t id;
+    unsigned generation, div, depth;
+    bool synchronous, executed;
+    APUDSPTraceStamp posted, enqueued, dequeued, locked, serviced, completed;
+    APUDSPTraceCycles cpu_begin, cpu_end;
+} APUDSPTraceJob;
+typedef struct APUDSPTraceWait {
+    unsigned reason, depth, wakes;
+    APUDSPTraceStamp begin, acquired, drained, released, relocked;
+} APUDSPTraceWait;
+typedef struct APUDSPTraceEvent {
+    unsigned div, generation, wait_count, history_count;
+    bool synchronous;
+    APUDSPTraceStamp begin, posted, end;
+    APUDSPTraceCycles cpu_begin, cpu_end;
+    APUDSPTraceWait waits[APU_DSP_TRACE_WAITS];
+    APUDSPTraceJob history[APU_DSP_TRACE_HISTORY];
+} APUDSPTraceEvent;
+typedef struct APUDSPTrace {
+    bool configured, cpu_enabled, producer_active, report_pending;
+    volatile LONG enabled, long_job_pending;
+    int64_t frequency, threshold, next_report_qpc, last_qpc;
+    unsigned reports, suppressed;
+    uint64_t next_job_id, history_written;
+    APUDSPTraceJob slots[8], history[APU_DSP_TRACE_HISTORY];
+    APUDSPTraceEvent current, pending;
+} APUDSPTrace;
+
+static inline int apu_dsp_trace_enabled(APUDSPTrace *t)
+{ return t->configured && InterlockedCompareExchange(&t->enabled, 0, 0); }
+static inline void apu_dsp_trace_disable(APUDSPTrace *t)
+{ if (t->configured) InterlockedExchange(&t->enabled, 0); }
+static inline void apu_dsp_trace_init(APUDSPTrace *t, int requested, int cpu, int64_t frequency)
+{
+    memset(t, 0, sizeof(*t));
+    t->configured = requested && frequency > 0;
+    t->cpu_enabled = t->configured && cpu;
+    t->frequency = frequency;
+    t->threshold = frequency / 125; /* Eight milliseconds. */
+    if (t->threshold < 1) t->threshold = 1;
+    if (t->configured) InterlockedExchange(&t->enabled, 1);
+}
+static inline APUDSPTraceStamp apu_dsp_trace_existing(APUDSPTrace *t, int64_t qpc)
+{
+    APUDSPTraceStamp s = {qpc, qpc > 0 && apu_dsp_trace_enabled(t)};
+    return s;
+}
+static inline APUDSPTraceStamp apu_dsp_trace_now(APUDSPTrace *t)
+{
+    APUDSPTraceStamp s = {0};
+    if (!apu_dsp_trace_enabled(t)) return s;
+    int saved_errno = errno;
+    DWORD saved_error = GetLastError();
+    LARGE_INTEGER now = {0};
+    if (QueryPerformanceCounter(&now) && now.QuadPart > 0) {
+        s.qpc = now.QuadPart; s.valid = true;
+    }
+    SetLastError(saved_error); errno = saved_errno;
+    return s;
+}
+static inline APUDSPTraceCycles apu_dsp_trace_cpu(APUDSPTrace *t)
+{
+    APUDSPTraceCycles c = {0};
+    if (!t->cpu_enabled || !apu_dsp_trace_enabled(t)) return c;
+#ifdef _WIN32
+    int saved_errno = errno;
+    DWORD saved_error = GetLastError();
+    ULONG64 value = 0;
+    if (QueryThreadCycleTime(GetCurrentThread(), &value)) {
+        c.value = value; c.valid = true;
+    }
+    SetLastError(saved_error); errno = saved_errno;
+#endif
+    return c;
+}
+static inline uint64_t apu_dsp_trace_elapsed(APUDSPTraceStamp a, APUDSPTraceStamp b, bool *valid)
+{
+    *valid = a.valid && b.valid && b.qpc >= a.qpc;
+    return *valid ? (uint64_t)(b.qpc - a.qpc) : 0;
+}
+static inline uint64_t apu_dsp_trace_cpu_delta(APUDSPTraceCycles a, APUDSPTraceCycles b, bool *valid)
+{
+    *valid = a.valid && b.valid && b.value >= a.value;
+    return *valid ? b.value - a.value : 0;
+}
+static inline void apu_dsp_trace_begin(APUDSPTrace *t, int64_t qpc, unsigned generation, unsigned div)
+{
+    t->producer_active = false;
+    if (!apu_dsp_trace_enabled(t)) return;
+    memset(&t->current, 0, sizeof(t->current));
+    t->current.begin = apu_dsp_trace_existing(t, qpc);
+    t->current.generation = generation; t->current.div = div;
+    t->producer_active = t->current.begin.valid;
+    if (t->producer_active) t->current.cpu_begin = apu_dsp_trace_cpu(t);
+}
+static inline void apu_dsp_trace_posted(APUDSPTrace *t)
+{
+    if (t->producer_active && apu_dsp_trace_enabled(t)) t->current.posted = apu_dsp_trace_now(t);
+}
+/* Wait reason: 1=output group drain, 2=full queue drain. */
+static inline APUDSPTraceWait *apu_dsp_trace_wait_begin(APUDSPTrace *t, unsigned reason)
+{
+    if (!t->producer_active || !apu_dsp_trace_enabled(t) || t->current.wait_count == APU_DSP_TRACE_WAITS)
+        return NULL;
+    APUDSPTraceWait *w = &t->current.waits[t->current.wait_count++];
+    memset(w, 0, sizeof(*w));
+    w->reason = reason;
+    w->begin = t->current.posted.valid ? t->current.posted : apu_dsp_trace_now(t);
+    return w;
+}
+static inline APUDSPTraceJob apu_dsp_trace_job_begin(APUDSPTrace *t, unsigned generation,
+    unsigned div, unsigned depth, bool synchronous)
+{
+    APUDSPTraceJob j = {0};
+    if (!apu_dsp_trace_enabled(t)) return j;
+    j.id = ++t->next_job_id; j.generation = generation; j.div = div; j.depth = depth;
+    j.synchronous = synchronous;
+    j.posted = t->producer_active ? t->current.begin : (APUDSPTraceStamp){0};
+    j.enqueued = apu_dsp_trace_now(t);
+    return j;
+}
+/* Caller owns the existing queue lock. Only completed worker-local records
+ * become visible, so producer snapshots never race an in-flight write. */
+static inline void apu_dsp_trace_commit(APUDSPTrace *t, const APUDSPTraceJob *j)
+{
+    if (!j->id || !apu_dsp_trace_enabled(t)) return;
+    t->history[t->history_written++ % APU_DSP_TRACE_HISTORY] = *j;
+    bool valid;
+    if (apu_dsp_trace_elapsed(j->dequeued, j->completed, &valid) >= (uint64_t)t->threshold && valid)
+        InterlockedExchange(&t->long_job_pending, 1);
+}
+static inline void apu_dsp_trace_snapshot(APUDSPTrace *t)
+{
+    unsigned count = t->history_written < APU_DSP_TRACE_HISTORY ? (unsigned)t->history_written : APU_DSP_TRACE_HISTORY;
+    t->current.history_count = count;
+    for (unsigned i = 0; i < count; ++i)
+        t->current.history[i] = t->history[(t->history_written - count + i) % APU_DSP_TRACE_HISTORY];
+    InterlockedExchange(&t->long_job_pending, 0);
+}
+static inline void apu_dsp_trace_finish(APUDSPTrace *t, int64_t end_qpc)
+{
+    if (!t->producer_active) return;
+    t->current.end = apu_dsp_trace_existing(t, end_qpc);
+    if (!t->current.posted.valid) t->current.posted = t->current.end;
+    t->current.cpu_end = apu_dsp_trace_cpu(t);
+    if (t->current.end.valid) t->last_qpc = t->current.end.qpc;
+    t->producer_active = false;
+}
+static inline bool apu_dsp_trace_candidate(APUDSPTrace *t)
+{
+    if (!apu_dsp_trace_enabled(t)) return false;
+    bool valid;
+    uint64_t elapsed = apu_dsp_trace_elapsed(t->current.begin, t->current.end, &valid);
+    return (valid && elapsed >= (uint64_t)t->threshold) ||
+        InterlockedCompareExchange(&t->long_job_pending, 0, 0);
+}
+static inline void apu_dsp_trace_offer(APUDSPTrace *t)
+{
+    if (!apu_dsp_trace_enabled(t) || !t->current.end.valid) return;
+    bool valid, previous_valid;
+    uint64_t elapsed = apu_dsp_trace_elapsed(t->current.begin, t->current.end, &valid);
+    if (!valid) { ++t->suppressed; return; }
+    uint64_t previous = apu_dsp_trace_elapsed(t->pending.begin, t->pending.end, &previous_valid);
+    if (!t->report_pending || (valid && (!previous_valid || elapsed > previous))) t->pending = t->current;
+    else ++t->suppressed;
+    t->report_pending = true;
+}
+/* Minimum half-second spacing, maximum64 reports. Use an existing producer
+ * QPC endpoint, with no clock query here or after the cap disables tracing. */
+static inline bool apu_dsp_trace_take(APUDSPTrace *t, APUDSPTraceEvent *event)
+{
+    if (!apu_dsp_trace_enabled(t) || !t->report_pending || t->last_qpc <= 0) return false;
+    if (t->reports >= APU_DSP_TRACE_MAX_REPORTS) { apu_dsp_trace_disable(t); return false; }
+    if (t->last_qpc < t->next_report_qpc) return false;
+    *event = t->pending; t->report_pending = false; ++t->reports;
+    int64_t half = t->frequency / 2;
+    if (half < 1) half = 1;
+    t->next_report_qpc = t->last_qpc > INT64_MAX - half ? INT64_MAX : t->last_qpc + half;
+    if (t->reports == APU_DSP_TRACE_MAX_REPORTS) apu_dsp_trace_disable(t);
+    return true;
+}
+#endif
diff --git a/src/apu/apu_dsp_worker.c b/src/apu/apu_dsp_worker.c
new file mode 100644
index 0000000..bfbf509
--- /dev/null
+++ b/src/apu/apu_dsp_worker.c
@@ -0,0 +1,174 @@
+/* Bounded VP -> DSP pipeline. The producer may prepare one eight-frame output
+ * group while the DSP runs; an idle worker sleeps on a condition variable.
+ * No rendering or window thread calls into this queue. */
+#include "apu_state.h"
+
+static DWORD WINAPI dsp_worker_main(void *opaque)
+{
+    MCPXAPUState *d = opaque;
+#ifdef _WIN32
+    /* One step above normal: the frame thread waits for this worker every
+     * 256 samples, so a preempted DSP frame is a late output buffer. */
+    if (!mcpx_apu_raise_priority(THREAD_PRIORITY_ABOVE_NORMAL))
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_NORMAL);
+#endif
+    qemu_mutex_lock(&d->dsp_queue_lock);
+    for (;;) {
+        while (!d->dsp_job_count && !qatomic_read(&d->exiting))
+            qemu_cond_wait(&d->dsp_job_cond, &d->dsp_queue_lock);
+        if (!d->dsp_job_count) break;
+        unsigned job = d->dsp_job_head;
+        APUDSPTraceJob trace_job = {0};
+        if (apu_dsp_trace_enabled(&d->dsp_trace)) {
+            trace_job = d->dsp_trace.slots[job];
+            trace_job.dequeued = apu_dsp_trace_now(&d->dsp_trace);
+        }
+        qemu_mutex_unlock(&d->dsp_queue_lock);
+        qemu_mutex_lock(&d->dsp_lock);
+        if (trace_job.id) {
+            trace_job.locked = apu_dsp_trace_now(&d->dsp_trace);
+            trace_job.cpu_begin = apu_dsp_trace_cpu(&d->dsp_trace);
+        }
+        if (!qatomic_read(&d->exiting) &&
+            d->dsp_job_generation[job] == d->dsp_generation) {
+            trace_job.executed = true;
+            mcpx_apu_dsp_frame(d, d->dsp_job_mixbins[job], d->dsp_job_div[job]);
+        }
+        if (trace_job.id) {
+            trace_job.serviced = apu_dsp_trace_now(&d->dsp_trace);
+            trace_job.cpu_end = apu_dsp_trace_cpu(&d->dsp_trace);
+        }
+        qemu_mutex_unlock(&d->dsp_lock);
+        qemu_mutex_lock(&d->dsp_queue_lock);
+        if (trace_job.id) {
+            trace_job.completed = apu_dsp_trace_now(&d->dsp_trace);
+            apu_dsp_trace_commit(&d->dsp_trace, &trace_job);
+        }
+        d->dsp_job_head = (job + 1) % 8;
+        --d->dsp_job_count;
+        /* Every done waiter requires the whole queue to drain. Intermediate
+         * completions cannot satisfy that predicate and only wake it to sleep
+         * again; publish completion while holding the same predicate lock. */
+        if (!d->dsp_job_count) qemu_cond_broadcast(&d->dsp_done_cond);
+    }
+    qemu_mutex_unlock(&d->dsp_queue_lock);
+    return 0;
+}
+
+void mcpx_apu_dsp_worker_init(MCPXAPUState *d)
+{
+    qemu_mutex_init(&d->dsp_lock);
+    qemu_mutex_init(&d->dsp_queue_lock);
+    qemu_cond_init(&d->dsp_job_cond);
+    qemu_cond_init(&d->dsp_done_cond);
+    const char *handoff = getenv("RECOMP_AUDIO_DSP_HANDOFF");
+    apu_dsp_handoff_init(d, handoff && !strcmp(handoff, "1"));
+    if (d->dsp_handoff_enabled)
+        fprintf(stderr, "[APU] contention-aware DSP handoff enabled (RECOMP_AUDIO_DSP_HANDOFF=1)\n");
+    d->dsp_thread.thread = CreateThread(NULL, 0, dsp_worker_main, d, 0, NULL);
+    d->dsp_worker_started = d->dsp_thread.thread != NULL;
+    if (!d->dsp_worker_started)
+        fprintf(stderr, "[APU] DSP worker unavailable (%lu); using synchronous DSP\n",
+                (unsigned long)GetLastError());
+}
+
+static void dsp_worker_wait_reason(MCPXAPUState *d, unsigned reason)
+{
+    if (!d->dsp_worker_started) return;
+    APUDSPTraceWait *trace_wait = apu_dsp_trace_wait_begin(&d->dsp_trace, reason);
+    qemu_mutex_unlock(&d->lock);
+    qemu_mutex_lock(&d->dsp_queue_lock);
+    if (trace_wait) {
+        trace_wait->acquired = apu_dsp_trace_now(&d->dsp_trace);
+        trace_wait->depth = d->dsp_job_count;
+    }
+    while (d->dsp_job_count) {
+        qemu_cond_wait(&d->dsp_done_cond, &d->dsp_queue_lock);
+        if (trace_wait) ++trace_wait->wakes;
+    }
+    if (trace_wait) trace_wait->drained = apu_dsp_trace_now(&d->dsp_trace);
+    qemu_mutex_unlock(&d->dsp_queue_lock);
+    if (trace_wait) trace_wait->released = apu_dsp_trace_now(&d->dsp_trace);
+    qemu_mutex_lock(&d->lock);
+    if (trace_wait) trace_wait->relocked = apu_dsp_trace_now(&d->dsp_trace);
+}
+
+void mcpx_apu_dsp_worker_wait(MCPXAPUState *d)
+{
+    dsp_worker_wait_reason(d, 1);
+}
+
+void mcpx_apu_dsp_worker_post(MCPXAPUState *d,
+    float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME], int div)
+{
+    unsigned generation = d->dsp_generation;
+    if (!d->dsp_worker_started) {
+        APUDSPTraceJob trace_job = apu_dsp_trace_job_begin(&d->dsp_trace, generation, (unsigned)div, 0, true);
+        APUDSPTraceWait *trace_wait = apu_dsp_trace_wait_begin(&d->dsp_trace, 3);
+        if (d->dsp_trace.producer_active) d->dsp_trace.current.synchronous = true;
+        /* MMIO can reset a continuously running DSP between its quanta even
+         * when thread creation failed. Do not hold the producer lock here. */
+        qemu_mutex_unlock(&d->lock);
+        if (trace_job.id) trace_job.dequeued = apu_dsp_trace_now(&d->dsp_trace);
+        qemu_mutex_lock(&d->dsp_lock);
+        if (trace_job.id) {
+            trace_job.locked = apu_dsp_trace_now(&d->dsp_trace);
+            trace_job.cpu_begin = apu_dsp_trace_cpu(&d->dsp_trace);
+        }
+        if (!qatomic_read(&d->exiting) && generation == d->dsp_generation) {
+            trace_job.executed = true;
+            mcpx_apu_dsp_frame(d, mixbins, div);
+        }
+        if (trace_job.id) {
+            trace_job.serviced = apu_dsp_trace_now(&d->dsp_trace);
+            trace_job.cpu_end = apu_dsp_trace_cpu(&d->dsp_trace);
+        }
+        qemu_mutex_unlock(&d->dsp_lock);
+        if (trace_wait) {
+            trace_wait->drained = trace_job.serviced;
+            trace_wait->released = apu_dsp_trace_now(&d->dsp_trace);
+        }
+        qemu_mutex_lock(&d->lock);
+        if (trace_job.id) {
+            trace_job.completed = apu_dsp_trace_now(&d->dsp_trace);
+            if (trace_wait) trace_wait->relocked = trace_job.completed;
+            qemu_mutex_lock(&d->dsp_queue_lock);
+            apu_dsp_trace_commit(&d->dsp_trace, &trace_job);
+            qemu_mutex_unlock(&d->dsp_queue_lock);
+        }
+        return;
+    }
+    /* This function has exactly one producer. Only the worker can reduce the
+     * count after we check it, so a free slot stays free until this post. */
+    qemu_mutex_lock(&d->dsp_queue_lock);
+    bool full = d->dsp_job_count == 8;
+    qemu_mutex_unlock(&d->dsp_queue_lock);
+    if (full) dsp_worker_wait_reason(d, 2);
+    if (qatomic_read(&d->exiting) || generation != d->dsp_generation) return;
+    qemu_mutex_lock(&d->dsp_queue_lock);
+    unsigned job = (d->dsp_job_head + d->dsp_job_count) % 8;
+    memcpy(d->dsp_job_mixbins[job], mixbins, sizeof(d->dsp_job_mixbins[job]));
+    d->dsp_job_div[job] = div;
+    d->dsp_job_generation[job] = generation;
+    if (apu_dsp_trace_enabled(&d->dsp_trace))
+        d->dsp_trace.slots[job] = apu_dsp_trace_job_begin(&d->dsp_trace,
+            generation, (unsigned)div, d->dsp_job_count + 1, false);
+    if (d->dsp_job_count++ == 0) qemu_cond_signal(&d->dsp_job_cond);
+    qemu_mutex_unlock(&d->dsp_queue_lock);
+}
+
+void mcpx_apu_dsp_worker_stop(MCPXAPUState *d)
+{
+    if (d->dsp_worker_started) {
+        qemu_mutex_lock(&d->dsp_queue_lock);
+        qemu_cond_signal(&d->dsp_job_cond);
+        qemu_mutex_unlock(&d->dsp_queue_lock);
+        qemu_thread_join(&d->dsp_thread);
+        d->dsp_worker_started = false;
+    }
+    qemu_cond_destroy(&d->dsp_done_cond);
+    qemu_cond_destroy(&d->dsp_job_cond);
+    apu_dsp_handoff_destroy(d);
+    qemu_mutex_destroy(&d->dsp_queue_lock);
+    qemu_mutex_destroy(&d->dsp_lock);
+}
diff --git a/src/apu/apu_fe_decode.h b/src/apu/apu_fe_decode.h
new file mode 100644
index 0000000..093aa4a
--- /dev/null
+++ b/src/apu/apu_fe_decode.h
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <windows.h>
+#include "apu_regs.h"
+
+/* Serializes decoder metadata and its trap-mode publication only. Method
+ * execution and voice locks stay outside this very small critical section. */
+typedef struct APUFEPublication {
+    volatile LONG lock;
+} APUFEPublication;
+
+typedef struct APUFEPublishResult {
+    uint32_t previous_mode;
+    uint32_t previous_method;
+    uint32_t previous_argument;
+    bool wrote_pair;
+    bool trapped;
+} APUFEPublishResult;
+
+static inline void apu_fe_publication_lock(APUFEPublication *publication)
+{
+    while (InterlockedCompareExchange(&publication->lock, 1, 0) != 0) {
+        YieldProcessor();
+    }
+}
+
+static inline void apu_fe_publication_unlock(APUFEPublication *publication)
+{
+    InterlockedExchange(&publication->lock, 0);
+}
+
+static inline APUFEPublishResult apu_fe_publish(
+    APUFEPublication *publication, uint32_t *fectl,
+    uint32_t *decode_method, uint32_t *decode_argument,
+    uint32_t method, uint32_t argument, bool idle_trap_enabled)
+{
+    APUFEPublishResult result = {0};
+    apu_fe_publication_lock(publication);
+    result.previous_mode = *fectl & NV_PAPU_FECTL_FEMETHMODE;
+    result.previous_method = *decode_method;
+    result.previous_argument = *decode_argument;
+
+    /* Keep a trapped pair stable across the SDK's separate method/argument
+     * reads and ISTS acknowledgement. An IDLE publication also waits out the
+     * SDK's HALTED -> FREE acknowledgement, which would clear a new trap. */
+    if (result.previous_mode != NV_PAPU_FECTL_FEMETHMODE_TRAPPED &&
+        (method != SE2FE_IDLE_VOICE ||
+         result.previous_mode == NV_PAPU_FECTL_FEMETHMODE_FREE_RUNNING)) {
+        *decode_method = method;
+        *decode_argument = argument;
+        result.wrote_pair = true;
+        if (method == SE2FE_IDLE_VOICE && idle_trap_enabled) {
+            *fectl = (*fectl & ~(NV_PAPU_FECTL_FEMETHMODE |
+                                 NV_PAPU_FECTL_FETRAPREASON)) |
+                     NV_PAPU_FECTL_FEMETHMODE_TRAPPED |
+                     NV_PAPU_FECTL_FETRAPREASON_REQUESTED;
+            result.trapped = true;
+        }
+    }
+    apu_fe_publication_unlock(publication);
+    return result;
+}
+
+static inline void apu_fe_write_mode(APUFEPublication *publication,
+                                     uint32_t *fectl, uint32_t value)
+{
+    apu_fe_publication_lock(publication);
+    *fectl = value;
+    apu_fe_publication_unlock(publication);
+}
diff --git a/src/apu/apu_profile.h b/src/apu/apu_profile.h
new file mode 100644
index 0000000..563e9e8
--- /dev/null
+++ b/src/apu/apu_profile.h
@@ -0,0 +1,230 @@
+/* Producer-owned, opt-in audio health counters. No clocks or audio math here. */
+#ifndef MCPX_APU_PROFILE_H
+#define MCPX_APU_PROFILE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#define APU_AUDIO_PROFILE_MAX_LINES 600u
+#define APU_AUDIO_PROFILE_HARD_LIMIT 1200u
+
+typedef struct APUFloatSignal {
+    unsigned finite_nonzero, denormal, nonfinite;
+    uint32_t peak_bits;
+} APUFloatSignal;
+
+typedef struct APUPcmSignal {
+    unsigned samples, nonzero, peak;
+    uint64_t squares;
+} APUPcmSignal;
+
+typedef struct APUVoiceSnapshot {
+    unsigned available;
+    uint32_t voice_base;
+    unsigned table_active, active_3d, paused, multipass, persistent;
+    unsigned source_ended, stream_empty, envelope_zero, invalid_ssl;
+    unsigned linked_active, linked_idle, unlisted_active, bad_links, repeated;
+    uint32_t heads[3];
+    unsigned nodes[3];
+} APUVoiceSnapshot;
+
+typedef struct APUStateSnapshot {
+    bool valid, vp_valid, pre_valid, final_valid;
+    int64_t qpc;
+    APUVoiceSnapshot voices;
+    APUFloatSignal vp;
+    APUPcmSignal pre, final;
+    unsigned muted;
+    uint32_t sectl, fectl, ists, ien, method, argument, force, gp_reset, ep_reset;
+    uint64_t generation;
+} APUStateSnapshot;
+
+/* Do not evaluate float inputs: even signalling NaNs and denormals are read
+ * as integer bits, preserving the audio thread's FP control and sticky flags. */
+static inline APUFloatSignal apu_profile_float_signal(const void *data, size_t samples)
+{
+    APUFloatSignal result = {0};
+    const unsigned char *bytes = (const unsigned char *)data;
+    for (size_t i = 0; i < samples; ++i) {
+        uint32_t bits;
+        memcpy(&bits, bytes + i * sizeof(bits), sizeof(bits));
+        bits &= 0x7fffffffu;
+        if ((bits & 0x7f800000u) == 0x7f800000u) {
+            ++result.nonfinite;
+        } else if (bits) {
+            ++result.finite_nonzero;
+            result.denormal += (bits & 0x7f800000u) == 0;
+            if (bits > result.peak_bits) result.peak_bits = bits;
+        }
+    }
+    return result;
+}
+
+static inline APUPcmSignal apu_profile_pcm_signal(const int16_t *data, size_t samples)
+{
+    APUPcmSignal result = {0};
+    result.samples = (unsigned)samples;
+    for (size_t i = 0; i < samples; ++i) {
+        int value = data[i];
+        unsigned magnitude = (unsigned)(value < 0 ? -value : value);
+        result.nonzero += magnitude != 0;
+        if (magnitude > result.peak) result.peak = magnitude;
+        result.squares += (uint64_t)((int64_t)value * value);
+    }
+    return result;
+}
+
+static inline unsigned apu_audio_profile_parse_limit(const char *text)
+{
+    unsigned value = 0;
+    if (!text || !*text) return APU_AUDIO_PROFILE_MAX_LINES;
+    for (; *text; ++text) {
+        if (*text < '0' || *text > '9') return APU_AUDIO_PROFILE_MAX_LINES;
+        value = value * 10 + (unsigned)(*text - '0');
+        if (value > APU_AUDIO_PROFILE_HARD_LIMIT) return APU_AUDIO_PROFILE_MAX_LINES;
+    }
+    return value ? value : APU_AUDIO_PROFILE_MAX_LINES;
+}
+
+typedef struct APUAudioProfile {
+    bool enabled, report_ready;
+    unsigned lines, line_limit;
+    int64_t frequency, window_start, last_group_start, report_qpc;
+    uint64_t groups, vp_frames, vp_ticks, dsp_post_wait_ticks, output_ticks;
+    uint64_t vp_frame_max_ticks, dsp_post_wait_max_ticks, output_max_ticks;
+    int64_t dsp_post_wait_max_begin, dsp_post_wait_max_end;
+    int64_t group_gap_max_ticks, deadline_late_max_us;
+    uint64_t cond_wait_calls, cond_wait_requested_ms, cond_wait_actual_us;
+    uint64_t cond_wait_max_us, cond_wait_overshoot_max_us, cond_wait_early_wakes;
+    int active_last, active_peak, idle_last;
+    uint64_t staging_frames, staging_dropped_total;
+    uint64_t idle_overwrite_opportunities, idle_overwrites, idle_replacements;
+    APUStateSnapshot snapshot;
+} APUAudioProfile;
+
+static inline void apu_audio_profile_init(APUAudioProfile *p, bool enabled,
+                                         int64_t frequency)
+{
+    memset(p, 0, sizeof(*p));
+    p->enabled = enabled && frequency > 0;
+    p->frequency = frequency;
+    p->line_limit = APU_AUDIO_PROFILE_MAX_LINES;
+}
+
+/* Pauses must not be counted as processing stalls or a low playback rate. */
+static inline void apu_audio_profile_pause(APUAudioProfile *p)
+{
+    bool enabled = p->enabled;
+    int64_t frequency = p->frequency;
+    unsigned lines = p->lines;
+    unsigned line_limit = p->line_limit;
+    apu_audio_profile_init(p, enabled, frequency);
+    p->lines = lines;
+    p->line_limit = line_limit;
+}
+
+/* Once per report, close enough to its end to inspect the final PCM before
+ * output consumes it. Snapshot QPC makes the <=20ms lead explicit. */
+static inline bool apu_audio_profile_snapshot_due(APUAudioProfile *p, int64_t now)
+{
+    return p->enabled && !p->snapshot.valid && p->window_start &&
+           now >= p->window_start &&
+           now - p->window_start >= p->frequency - p->frequency / 50;
+}
+
+static inline void apu_audio_profile_begin_group(APUAudioProfile *p, int64_t now)
+{
+    if (!p->enabled) return;
+    if (!p->window_start) p->window_start = now;
+    if (p->last_group_start && now > p->last_group_start &&
+        now - p->last_group_start > p->group_gap_max_ticks)
+        p->group_gap_max_ticks = now - p->last_group_start;
+    p->last_group_start = now;
+}
+
+static inline void apu_audio_profile_deadline(APUAudioProfile *p,
+                                             int64_t now_us, int64_t deadline_us)
+{
+    /* The first deadline after an idle pause predates the new window. Wait
+     * until a producer group has actually started before measuring lateness. */
+    if (p->enabled && p->last_group_start && deadline_us && now_us > deadline_us &&
+        now_us - deadline_us > p->deadline_late_max_us)
+        p->deadline_late_max_us = now_us - deadline_us;
+}
+
+static inline uint64_t apu_audio_profile_elapsed(int64_t begin, int64_t end)
+{
+    return end > begin ? (uint64_t)(end - begin) : 0;
+}
+
+/* The condition wait atomically releases and reacquires the producer lock.
+ * Its elapsed time includes reacquisition and cannot identify timer rounding
+ * separately from scheduling/lock delay. Callers reuse existing clock reads. */
+static inline void apu_audio_profile_wait(APUAudioProfile *p, int requested_ms,
+                                         int64_t begin_us, int64_t end_us)
+{
+    if (!p->enabled || requested_ms <= 0) return;
+    uint64_t actual = apu_audio_profile_elapsed(begin_us, end_us);
+    uint64_t requested = (uint64_t)requested_ms * 1000;
+    uint64_t overshoot = actual > requested ? actual - requested : 0;
+    ++p->cond_wait_calls;
+    p->cond_wait_requested_ms += (unsigned)requested_ms;
+    p->cond_wait_actual_us += actual;
+    if (actual > p->cond_wait_max_us) p->cond_wait_max_us = actual;
+    if (overshoot > p->cond_wait_overshoot_max_us) p->cond_wait_overshoot_max_us = overshoot;
+    p->cond_wait_early_wakes += actual < requested;
+}
+
+static inline void apu_audio_profile_frame(APUAudioProfile *p, int64_t begin,
+    int64_t vp_end, int64_t dsp_end, int64_t output_end, bool vp_frame,
+    int active, int idle)
+{
+    if (!p->enabled) return;
+    uint64_t vp = apu_audio_profile_elapsed(begin, vp_end);
+    uint64_t dsp = apu_audio_profile_elapsed(vp_end, dsp_end);
+    uint64_t output = apu_audio_profile_elapsed(dsp_end, output_end);
+    p->vp_frames += vp_frame;
+    p->vp_ticks += vp;
+    p->dsp_post_wait_ticks += dsp;
+    p->output_ticks += output;
+    if (vp > p->vp_frame_max_ticks) p->vp_frame_max_ticks = vp;
+    if (dsp > p->dsp_post_wait_max_ticks) {
+        p->dsp_post_wait_max_ticks = dsp;
+        p->dsp_post_wait_max_begin = vp_end;
+        p->dsp_post_wait_max_end = dsp_end;
+    }
+    if (output > p->output_max_ticks) p->output_max_ticks = output;
+    p->active_last = active;
+    p->idle_last = idle;
+    if (active > p->active_peak) p->active_peak = active;
+}
+
+static inline void apu_audio_profile_end_group(APUAudioProfile *p, int64_t now,
+    uint64_t staging_frames, uint64_t staging_dropped_total)
+{
+    if (!p->enabled) return;
+    ++p->groups;
+    p->staging_frames = staging_frames;
+    p->staging_dropped_total = staging_dropped_total;
+    if (p->window_start && now - p->window_start >= p->frequency) {
+        p->report_qpc = now;
+        p->report_ready = true;
+    }
+}
+
+/* Keep the previous group start across a reporting boundary, but never across
+ * a pause. The line cap also disables further timing work for this session. */
+static inline void apu_audio_profile_reported(APUAudioProfile *p)
+{
+    int64_t now = p->report_qpc, last = p->last_group_start;
+    unsigned lines = p->lines + 1;
+    apu_audio_profile_pause(p);
+    p->lines = lines;
+    p->enabled = p->enabled && lines < p->line_limit;
+    p->window_start = now;
+    p->last_group_start = last;
+}
+
+#endif
