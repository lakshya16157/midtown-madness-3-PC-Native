+     * avoids publishing a partial program or clobbering another capture. */
+    length = snprintf(temporary, sizeof(temporary), "%s.%lu.tmp", path, process);
+    if (length < 0 || (size_t)length >= sizeof(temporary)) return;
+    file = fopen(temporary, "wb");
+    bool saved = file && fwrite(image, 4, DSP_PRAM_SIZE, file) == DSP_PRAM_SIZE;
+    if (file && fclose(file)) saved = false;
+#ifdef _WIN32
+    if (saved) saved = MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    if (saved) saved = rename(temporary, path) == 0;
+#endif
+    if (!saved) remove(temporary);
+    fprintf(stderr, "[DSP] %s program %s %s; rebuild to recompile it\n", i ? "EP" : "GP",
+            saved ? "saved to" : "could not be saved to", path);
