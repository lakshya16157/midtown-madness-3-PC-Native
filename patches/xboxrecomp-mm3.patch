+        near(copy[i][5], i == 0 ? -17492.0f : 0.0f);
+    }
+    assert(packed_uv[18][4] == 23117 && packed_uv[18][5] == -17493);
+    assert(copy[1][6] == 321 && copy[1][7] == -987);
