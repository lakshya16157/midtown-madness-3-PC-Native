+/* The vertices of the armed frame's LightDraw draws, one line per triangle
+ * corner: draw, x y z rhw, diffuse rgba, tex0 u v, tex1/2/3 rows. */
+static void light_dump_vertices(const char *path)
+{
+    FILE *f = fopen(path, "wb");
+    unsigned i, draws = s_ldraw.draws < LV_DRAWS ? s_ldraw.draws : LV_DRAWS;
+    if (!f) return;
+    for (i = 0; i < draws; i++) fputs(s_lv_head[i], f);
+    fputs("draw,x,y,z,rhw,r,g,b,a,u0,v0,t1x,t1y,t1z,t2x,t2y,t2z,t3x,t3y,t3z\n", f);
+    for (i = 0; i < s_lv_n; i++) {
+        unsigned k;
+        fprintf(f, "%u", s_lv_draw[i]);
+        for (k = 0; k < LV_FLOATS; k++) fprintf(f, ",%.6g", s_lv[i][k]);
+        fputc('\n', f);
+    }
+    if (s_lv_n >= LV_MAX) fprintf(f, "# truncated at %u corners\n", (unsigned)LV_MAX);
+    fclose(f);
+}
