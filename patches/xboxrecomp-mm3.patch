+static uint32_t texture_pixel(ID3D11Texture2D *texture, unsigned sub, unsigned x,
+                              unsigned y, unsigned bytes_per_pixel)
+{
+    ID3D11Texture2D *stage; D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map; uint32_t value=0;
+    ID3D11Texture2D_GetDesc(texture,&desc);
+    CHECK(desc.SampleDesc.Count==1 && bytes_per_pixel<=16);
+    desc.Usage=D3D11_USAGE_STAGING; desc.BindFlags=desc.MiscFlags=0;
+    desc.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&stage)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)stage,(ID3D11Resource *)texture);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)stage,sub,D3D11_MAP_READ,0,&map)));
+    memcpy(&value,(const uint8_t *)map.pData+y*map.RowPitch+x*bytes_per_pixel,
+           bytes_per_pixel<sizeof value?bytes_per_pixel:sizeof value);
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)stage,sub);
+    ID3D11Texture2D_Release(stage); return value;
+}
