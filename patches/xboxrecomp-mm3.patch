+/* This flip's light pass for the black-frame detector: one more volume draw,
+ * its indices, whether it is screen-blended, and the positions of every
+ * third index (a checksum of where the volumes are). */
+static void light_frame_note(const NvD3DState *st, const NvD3DAttrib attr[16], uint32_t ni, const uint32_t *idx)
+{
+    uint32_t k;
+    s_bf_frame.light_draws++;
+    s_bf_frame.light_indices += ni;
+    if (local_light_screen(st)) s_bf_frame.light_screen++;
+    if (!idx) return;
+    for (k = 0; k < ni; k += 3) {
+        float v[3];
+        light_attr(&attr[0], idx[k], v, 3);
+        if (!isfinite(v[0]) || !isfinite(v[1]) || !isfinite(v[2])) continue;
+        s_bf_frame.light_where += (double)v[0] + 1.7 * (double)v[1] + 2.3 * (double)v[2];
+        s_bf_frame.light_where_n++;
+    }
+}
