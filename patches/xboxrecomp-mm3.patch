+        for (i = 0; i < 2; i++)
+            if (!dev || FAILED(ID3D11Device_CreateQuery(dev, &d, &s_dstats.gpu_event[i]))) s_dstats.gpu_state = -1;
+        if (dev) ID3D11Device_Release(dev);
+    }
+    if (s_dstats.gpu_state < 0) return;
+    if (s_dstats.gpu_pending[prev]) {
+        BOOL done = FALSE;
+        HRESULT hr = ID3D11DeviceContext_GetData(ctx, (ID3D11Asynchronous *)s_dstats.gpu_event[prev], &done,
+                                                 sizeof done, D3D11_ASYNC_GETDATA_DONOTFLUSH);
+        ds_gpu_done(&s_dstats.ds, s_dstats.gpu_id[prev], hr == S_OK && done);
+        s_dstats.gpu_pending[prev] = 0;
+    }
+    ID3D11DeviceContext_End(ctx, (ID3D11Asynchronous *)s_dstats.gpu_event[cur]);
+    /* Sent now: an End left in the context until the next present reached
+     * the GPU only with it, so a light frame read as "GPU not done" (363 of
+     * 3424 menu presents did). */
+    ID3D11DeviceContext_Flush(ctx);
+    s_dstats.gpu_id[cur] = id;
+    s_dstats.gpu_pending[cur] = 1;
+    s_dstats.gpu_at = prev;
+}
+
+static void dstats_when(int64_t ticks, char *out, size_t size)
+{
+    SYSTEMTIME t;
+    GetLocalTime(&t);
+    snprintf(out, size, "at %02u:%02u:%02u (qpc_ms=%.1f)", t.wHour, t.wMinute, t.wSecond,
+             (double)ticks * 1000.0 / (double)s_dstats.freq.QuadPart);
+}
+
+static int dstats_on(void)
+{
+    if (s_dstats.state < 0) {
+        const char *setting = getenv("RECOMP_DISPLAY_STATS");
+        s_dstats.state = (!setting || strcmp(setting, "0")) && QueryPerformanceFrequency(&s_dstats.freq) &&
+                       s_dstats.freq.QuadPart > 0;
+    }
+    return s_dstats.state > 0;
+}
+
+/* Where the paced presents of the window sit in the refresh, as a fraction
+ * after the vblank, or -1. */
+static double dstats_phase(int64_t period)
+{
+    const DsState *s = &s_dstats.ds;
+    double c = 0.0, sn = 0.0;
+    unsigned k, n = 0;
+    if (period <= 0) return -1.0;
+    for (k = 0; k < DS_RING; k++) {
+        double a;
+        if (!s->qpc[k] || s->late[k] || !s->flip[k] || s->qpc[k] < s_dstats.window_start) continue;
+        a = (double)((s->qpc[k] - s->last_sync_qpc) % period) / (double)period;
+        if (a < 0.0) a += 1.0;
+        c += cos(a * 6.283185307179586);
+        sn += sin(a * 6.283185307179586);
+        n++;
+    }
+    if (n < 20) return -1.0;
+    {
+        double a = atan2(sn, c) / 6.283185307179586;
+        return a < 0.0 ? a + 1.0 : a;
+    }
+}
+
+static void dstats_window(int64_t now)
+{
+    DsState *s = &s_dstats.ds;
+    double hz, phase;
+    int64_t period;
+    if (!s_dstats.window_start) { s_dstats.window_start = now; return; }
+    if (now - s_dstats.window_start < 60 * s_dstats.freq.QuadPart) return;
+    hz = ds_refresh_hz(s, s_dstats.freq.QuadPart);
+    period = hz > 0.0 ? (int64_t)((double)s_dstats.freq.QuadPart / hz) : 0;
+    phase = dstats_phase(period);
+    fprintf(stderr, "[DISPLAY] last %.0f s: %u refreshes at %.4f Hz; %u frames shown, %u refreshes repeated an older picture"
+                    " (%u after a late frame, %u after an on-time frame the GPU was slow with, %u after an on-time frame the"
+                    " compositor or display was slow with), %u holds of 2+ refreshes, %u frames replaced before the screen,"
+                    " %u waits over %u refreshes (loading); %u of %u presents late, %u not finished by the GPU a refresh later;"
+                    " up to %u waiting; statistics restarted %u times",
+            (double)(now - s_dstats.window_start) / (double)s_dstats.freq.QuadPart,
+            s->last_sync_refresh - s->first_sync_refresh, hz, s->shown, s->repeats, s->repeats_late,
+            s->repeats_gpu, s->repeats_display, s->holds, s->replaced, s->long_holds, (unsigned)DS_LONG_HOLD,
+            s->late_presents, s->presents, s->gpu_slow, s->waiting_max, s->restarts);
+    if (phase >= 0.0)
+        fprintf(stderr, "; paced presents %.1f ms after the refresh", phase * 1000.0 / hz);
+    fprintf(stderr, "\n");
+    fflush(stderr);
+    s_dstats.window_start = now;
+    ds_window_reset(s);
+}
+
+/* A new swap chain numbers its presents and refreshes afresh; after an F9
+ * capture the renderer's own pause is not a hold either. */
+static void dstats_reset(void)
+{
+    if (s_dstats.state > 0) s_dstats.ds.have = s_dstats.ds.rate_have = 0;
+}
+
+/* After a successful Present: `flip` is the guest flip it showed (0 for a
+ * movie or idle tick), `pace_ticks` the pacing wait just before it (-1 when
+ * unknown); no wait at all means the frame was late for its pacing point. */
+static void dstats_after_present(IDXGISwapChain1 *swap, ID3D11DeviceContext *ctx, uint32_t flip,
+                                 int64_t pace_ticks, int64_t now)
+{
+    DXGI_FRAME_STATISTICS st;
+    DsStats ds;
+    DsHold hold;
+    UINT id = 0;
+    HRESULT hr;
+    char when[64];
+    if (!swap || !ctx || !dstats_on()) return;
+    s_dstats.ds.freq = s_dstats.freq.QuadPart;
+    if (FAILED(IDXGISwapChain1_GetLastPresentCount(swap, &id))) return;
+    ds_presented(&s_dstats.ds, id, flip, now,
+                 flip && pace_ticks >= 0 && pace_ticks < s_dstats.freq.QuadPart / 20000);
+    dstats_gpu(ctx, id);
+    memset(&st, 0, sizeof st);
+    hr = IDXGISwapChain1_GetFrameStatistics(swap, &st);
+    if (hr == DXGI_ERROR_FRAME_STATISTICS_DISJOINT) {
+        int was = s_dstats.ds.have;
+        ds_restart(&s_dstats.ds);
+        if (was && s_dstats.restarts_logged < 20) {
+            s_dstats.restarts_logged++;
+            dstats_when(now, when, sizeof when);
+            fprintf(stderr, "[DISPLAY] Windows restarted the frame statistics %s: display mode, window or compositor change\n", when);
+        }
+        dstats_window(now);
+        return;
+    }
+    if (FAILED(hr)) {
+        if (++s_dstats.failures == 600 && !s_dstats.reports) {
+            fprintf(stderr, "[DISPLAY] Windows gives no frame statistics for this window (0x%08lX); screen-side counts off\n",
+                    (unsigned long)hr);
+            s_dstats.state = 0;
+        }
+        return;
+    }
+    if (!s_dstats.reports++)
+        fprintf(stderr, "[DISPLAY] frame statistics on: repeated refreshes, held and replaced frames counted from what the screen showed (RECOMP_DISPLAY_STATS=0 disables)\n");
+    ds.present_count = st.PresentCount;
+    ds.present_refresh = st.PresentRefreshCount;
+    ds.sync_refresh = st.SyncRefreshCount;
+    ds.sync_qpc = st.SyncQPCTime.QuadPart;
+    if (ds_stats(&s_dstats.ds, &ds, id, &hold) && s_dstats.holds_logged < 40) {
+        char next[32];
+        s_dstats.holds_logged++;
+        dstats_when(hold.present_qpc ? hold.present_qpc : now, when, sizeof when);
+        if (hold.flip) snprintf(next, sizeof next, "flip %u", hold.flip);
+        else snprintf(next, sizeof next, "the next picture");
+        fprintf(stderr, "[DISPLAY] the screen kept one picture for %u more refreshes before %s %s; that frame was presented %s; %u presents waiting\n",
+                hold.extra, next, when,
+                hold.late ? "late (after its pacing point)" :
+                hold.gpu == DS_GPU_SLOW ? "on time, but the GPU had not finished it a refresh later" :
+                hold.gpu == DS_GPU_DONE ? "on time and the GPU had finished it (the compositor or display was late)" :
+                "on time", hold.waiting);
+        fflush(stderr);
+    }
+    dstats_window(now);
+}
+
+static void dstats_describe(uint32_t flip, char *out, size_t size)
+{
+    if (s_dstats.state > 0) ds_describe(&s_dstats.ds, flip, out, size);
+    else if (size) snprintf(out, size, "unknown");
+}
+
+#endif /* NV2A_DISPLAY_STATS_LOGIC_ONLY */
+#endif /* NV2A_DISPLAY_STATS_H */
diff --git a/src/video/nv2a_distance_fog.h b/src/video/nv2a_distance_fog.h
new file mode 100644
index 0000000..afd9915
--- /dev/null
+++ b/src/video/nv2a_distance_fog.h
@@ -0,0 +1,247 @@
+/* Dedicated ordered fog pass, based on xboxrecomp 7c90561..cf52bbe.
+ * Included after surface, window-clip and binding helpers. */
+static const char s_native_fog_hlsl[] =
+"cbuffer Fog : register(b0) { float4 band; float4 colour; float4 sky;\n"
+"  float4 wclip[8]; uint wclip_mode; uint3 wclip_pad; float4 ramp; };\n"
+/* ramp = (row, remap scale, knee, on): the sky's authored fog ramp
+ * (nv2a_d3d_sky_fog_ramp), across at the depth remapped to its authored
+ * distance as y16d_ps does, down at the row the title chose. */
+"Texture2D Ramp : register(t1); SamplerState RampS : register(s0);\n"
+"float ramp_fog(float z) {\n"
+"  float x = z * ramp.y, k = ramp.z;\n"
+"  float u = ramp.y > 1.0 && x > k ? k + (1.0 - k) * (1.0 - exp((k - x) / (1.0 - k))) : x;\n"
+"  return Ramp.SampleLevel(RampS, float2(saturate(u), ramp.x), 0).r;\n"
+"}\n"
+"#if FOG_MSAA\n"
+"Texture2DMS<float> Depth : register(t0);\n"
+"#else\n"
+"Texture2D<float> Depth : register(t0);\n"
+"#endif\n"
+"float4 fog_vs(uint id : SV_VertexID) : SV_Position {\n"
+"  float2 p = float2((id << 1) & 2, id & 2);\n"
+"  return float4(p * float2(2,-2) + float2(-1,1), 0, 1);\n"
+"}\n"
+"float4 fog_ps(float4 p : SV_Position, uint sample : SV_SampleIndex) : SV_Target {\n"
+"  if (wclip_mode != 0u) {\n"
+"    bool in_any = false;\n"
+"    [unroll] for (uint w = 0; w < 8; w++)\n"
+"      in_any = in_any || (all(p.xy >= wclip[w].xy) && all(p.xy < wclip[w].zw));\n"
+"    if (in_any == (wclip_mode == 2u)) discard;\n"
+"  }\n"
+"#if FOG_MSAA\n"
+"  float z = Depth.Load(int2(p.xy), sample);\n"
+"#else\n"
+"  float z = Depth.Load(int3(int2(p.xy), 0));\n"
+"#endif\n"
+"  if (colour.a > 0) {\n"
+"    float a = z >= 0.99999 ? 1 : 0;\n"
+"    if (sky.w > 0) {\n"
+"      float t = saturate(dot(float3(p.xy,1),sky.xyz) * sky.w);\n"
+"      a *= t*t*(3-2*t);\n"
+"    }\n"
+"    return float4(0,0,0,a);\n"
+"  }\n"
+"  if (z >= 0.99999) return float4(colour.rgb,band.w);\n"
+"  float x = saturate((z * band.z - band.x) * band.y);\n"
+"  float a = 1.0 - exp2(-6.643856 * x * x);\n"
+"  if (ramp.w > 0) a = max(a, ramp_fog(z));\n"
+"  return float4(colour.rgb, a);\n"
+"}\n";
+
+typedef struct {
+    float band[4], colour[4], sky[4], wclip[8][4];
+    uint32_t wclip_mode, pad[3];
+    float ramp[4];
+} NativeFogConsts;
+static ID3D11VertexShader *s_native_fog_vs;
+static ID3D11PixelShader *s_native_fog_ps[2];
+static ID3D11Buffer *s_native_fog_cb;
+static ID3D11BlendState *s_native_fog_blend, *s_native_fog_mask;
+static ID3D11DepthStencilState *s_native_fog_depth;
+static ID3D11RasterizerState *s_native_fog_raster;
+
+static ID3DBlob *native_fog_compile(const char *entry, const char *target, int msaa)
+{
+    D3D_SHADER_MACRO macros[] = {{"FOG_MSAA",msaa ? "1" : "0"},{NULL,NULL}};
+    ID3DBlob *code = NULL, *error = NULL;
+    HRESULT hr = nv_shader_cache_compile(s_native_fog_hlsl,sizeof s_native_fog_hlsl-1,
+        "native_distance_fog",macros,entry,target,D3DCOMPILE_OPTIMIZATION_LEVEL3,
+        0,&code,&error,NULL);
+    if (FAILED(hr)) {
+        fprintf(stderr,"[FOG] %s: %s\n",entry,
+            error ? (const char *)ID3D10Blob_GetBufferPointer(error) : "compile failed");
+        if (code) { ID3D10Blob_Release(code); code = NULL; }
+    }
+    if (error) ID3D10Blob_Release(error);
+    return code;
+}
+
+static int native_fog_init(void)
+{
+    ID3DBlob *code;
+    HRESULT hr;
+    unsigned i;
+    D3D11_BUFFER_DESC cb = {sizeof(NativeFogConsts),D3D11_USAGE_DYNAMIC,
+        D3D11_BIND_CONSTANT_BUFFER,D3D11_CPU_ACCESS_WRITE,0,0};
+    D3D11_BLEND_DESC blend = {0};
+    D3D11_DEPTH_STENCIL_DESC depth = {0};
+    D3D11_RASTERIZER_DESC raster = {0};
+    if (nv2a_d3d_distance_fog_ready()) return 1;
+    code = native_fog_compile("fog_vs","vs_5_0",0);
+    if (!code) goto fail;
+    hr = ID3D11Device_CreateVertexShader(s_dev,ID3D10Blob_GetBufferPointer(code),
+        ID3D10Blob_GetBufferSize(code),NULL,&s_native_fog_vs);
+    ID3D10Blob_Release(code);
+    if (FAILED(hr)) goto fail;
+    for (i = 0; i < 2; ++i) {
+        code = native_fog_compile("fog_ps","ps_5_0",i != 0);
+        if (!code) goto fail;
+        hr = ID3D11Device_CreatePixelShader(s_dev,ID3D10Blob_GetBufferPointer(code),
+            ID3D10Blob_GetBufferSize(code),NULL,&s_native_fog_ps[i]);
+        ID3D10Blob_Release(code);
+        if (FAILED(hr)) goto fail;
+    }
+    blend.RenderTarget[0].BlendEnable = TRUE;
+    blend.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+    blend.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+    blend.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ZERO;
+    blend.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+    blend.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    depth.DepthFunc = D3D11_COMPARISON_ALWAYS;
+    raster.FillMode = D3D11_FILL_SOLID;
+    raster.CullMode = D3D11_CULL_NONE;
+    raster.ScissorEnable = raster.DepthClipEnable = raster.MultisampleEnable = TRUE;
+    if (FAILED(ID3D11Device_CreateBuffer(s_dev,&cb,NULL,&s_native_fog_cb)) ||
+        FAILED(ID3D11Device_CreateBlendState(s_dev,&blend,&s_native_fog_blend)) ||
+        FAILED(ID3D11Device_CreateDepthStencilState(s_dev,&depth,&s_native_fog_depth)) ||
+        FAILED(ID3D11Device_CreateRasterizerState(s_dev,&raster,&s_native_fog_raster))) goto fail;
+    blend.RenderTarget[0].BlendEnable = FALSE;
+    blend.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALPHA;
+    if (FAILED(ID3D11Device_CreateBlendState(s_dev,&blend,&s_native_fog_mask))) goto fail;
+    InterlockedExchange(&s_distance_fog_ready,1);
+    return 1;
+fail:
+    InterlockedExchange(&s_distance_fog_ready,0);
+    if (s_native_fog_vs) { ID3D11VertexShader_Release(s_native_fog_vs); s_native_fog_vs = NULL; }
+    for (i = 0; i < 2; ++i)
+        if (s_native_fog_ps[i]) { ID3D11PixelShader_Release(s_native_fog_ps[i]); s_native_fog_ps[i] = NULL; }
+    if (s_native_fog_cb) { ID3D11Buffer_Release(s_native_fog_cb); s_native_fog_cb = NULL; }
+    if (s_native_fog_blend) { ID3D11BlendState_Release(s_native_fog_blend); s_native_fog_blend = NULL; }
+    if (s_native_fog_mask) { ID3D11BlendState_Release(s_native_fog_mask); s_native_fog_mask = NULL; }
+    if (s_native_fog_depth) { ID3D11DepthStencilState_Release(s_native_fog_depth); s_native_fog_depth = NULL; }
+    if (s_native_fog_raster) { ID3D11RasterizerState_Release(s_native_fog_raster); s_native_fog_raster = NULL; }
+    return 0;
+}
+
+void nv2a_d3d_distance_fog(const NvD3DState *st, float depth_to_world, float far_clip,
+                          float start, float end, uint32_t argb, uint32_t flags,
+                          const float sky_fade[4])
+{
+    Surface *surface = NULL;
+    Depth *depth_buffer = NULL;
+    uint32_t gw, gh, viewport[4];
+    NativeFogConsts constants = {0};
+    PSConsts clipping = {0};
+    NvD3DState camera;
+    ID3D11ShaderResourceView *ramp_view;
+    D3D11_VIEWPORT vp;
+    float vx, vy, vw, vh;
+    static int logged;
+    if (!st || (flags & ~(NV2A_HOST_FOG_SKY_MASK | NV2A_HOST_FOG_SKY_FILL | NV2A_HOST_FOG_SKY_FADE)) ||
+        !isfinite(depth_to_world) || !isfinite(far_clip) || !isfinite(start) || !isfinite(end) ||
+        depth_to_world <= 0 || far_clip <= 0 || start < 0 || end <= start || end > far_clip) return;
+    if ((flags & NV2A_HOST_FOG_SKY_FADE) && (!sky_fade ||
+        !isfinite(sky_fade[0]) || !isfinite(sky_fade[1]) || !isfinite(sky_fade[2]) ||
+        !isfinite(sky_fade[3]) || sky_fade[3] <= 0 || sky_fade[3] > 1.e6f ||
+        fabsf(sky_fade[0]) > 1.e6f || fabsf(sky_fade[1]) > 1.e6f || fabsf(sky_fade[2]) > 1.e6f)) return;
+    /* Validate arithmetic before touching the context, including subnormal
+     * bands/scales that overflow despite each packet field being finite. */
+    constants.band[0] = start;
+    constants.band[1] = 1.f / (end-start);
+    constants.band[2] = depth_to_world * (((st->surface_format >> 4) & 15u) == 1 ? 65536.f : 16777216.f);
+    constants.band[3] = flags & NV2A_HOST_FOG_SKY_FILL ? 1.f : 0.f;
+    if (!isfinite(constants.band[1]) || !isfinite(constants.band[2])) return;
+    if (!bind_targets(st,1,&surface,&depth_buffer,&gw,&gh) || !surface || !depth_buffer ||
+        !depth_buffer->zsrv || surface->iw != depth_buffer->iw || surface->ih != depth_buffer->ih ||
+        (!!surface->ms != (depth_buffer->samples > 1)) || !native_fog_init()) return;
+    constants.colour[0] = ((argb >> 16) & 255) / 255.f;
+    constants.colour[1] = ((argb >> 8) & 255) / 255.f;
+    constants.colour[2] = (argb & 255) / 255.f;
+    /* The camera's ray plane is authored in its own viewport. Split-screen
+     * region zero must not shift its horizon into the other player's view. */
+    camera = *st;
+    camera.wclip_mask = !(st->wclip_type & 1u) ? st->wclip_mask & 1u : 0;
+    camera.wclip_type = 0;
+    window_clip_bounds(&camera,gw,gh,viewport);
+    vx = viewport[0] * s_aa_x * s_cur_sx;
+    vy = viewport[1] * s_aa_y * s_cur_sy;
+    vw = (viewport[2]-viewport[0]) * s_aa_x * s_cur_sx;
+    vh = (viewport[3]-viewport[1]) * s_aa_y * s_cur_sy;
+    if (!(vw > 0) || !(vh > 0)) return;
+    if (flags & NV2A_HOST_FOG_SKY_FADE) {
+        constants.sky[0] = 2.f * sky_fade[0] / vw;
+        constants.sky[1] = -2.f * sky_fade[1] / vh;
+        constants.sky[2] = sky_fade[2]-sky_fade[0]+sky_fade[1]
+            - constants.sky[0]*vx - constants.sky[1]*vy;
+        constants.sky[3] = sky_fade[3];
+        if (!isfinite(constants.sky[0]) || !isfinite(constants.sky[1]) || !isfinite(constants.sky[2])) return;
+    }
+    window_clip_constants(&clipping,st,gw,gh,1.f,1.f);
+    memcpy(constants.wclip,clipping.wclip,sizeof constants.wclip);
+    constants.wclip_mode = clipping.wclip_mode;
+    /* The sky's own ramp keeps its weather (rain haze) under the curve. */
+    ramp_view = sky_ramp_current() ? texture_get(&s_sky_ramp.tex) : NULL;
+    if (ramp_view) {
+        constants.ramp[0] = s_sky_ramp.row;
+        constants.ramp[1] = s_sky_ramp.scale;
+        constants.ramp[2] = s_sky_ramp.knee;
+        constants.ramp[3] = 1.f;
+    }
+    if (!upload_cb(s_native_fog_cb,&constants,sizeof constants)) return;
+    vp = (D3D11_VIEWPORT){0,0,(float)surface->iw,(float)surface->ih,0,1};
+    unbind_textures();
+    unbind_targets();
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx,1,&surface->rtv,NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx,1,&vp);
+    apply_scissor(st,gw,gh);
+    /* Through the binding cache: raw state calls left it describing the
+     * previous draw's state, so the next draw asking for that state kept
+     * the fog's depth-always/no-write and alpha-blend states instead. */
+    bind_rasterizer_state(s_native_fog_raster);
+    bind_depth_stencil_state(s_native_fog_depth,0);
+    bind_blend_state(s_native_fog_blend,NULL,0xFFFFFFFFu);
+    ID3D11DeviceContext_IASetInputLayout(s_ctx,NULL);
+    bind_primitive_topology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    bind_vertex_shader(s_native_fog_vs);
+    bind_pixel_shader(s_native_fog_ps[depth_buffer->samples > 1]);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx,0,1,&s_native_fog_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx,0,1,&depth_buffer->zsrv);
+    if (ramp_view) {
+        ID3D11DeviceContext_PSSetShaderResources(s_ctx,1,1,&ramp_view);
+        bind_pixel_samplers(1,&s_linear_clamp);
+    }
+    ID3D11DeviceContext_Draw(s_ctx,3,0);
+    constants.colour[3] = 1;
+    if ((flags & NV2A_HOST_FOG_SKY_MASK) && upload_cb(s_native_fog_cb,&constants,sizeof constants)) {
+        bind_blend_state(s_native_fog_mask,NULL,0xFFFFFFFFu);
+        ID3D11DeviceContext_Draw(s_ctx,3,0);
+    }
+    unbind_textures();
+    unbind_targets();
+    surface->gpu_dirty = 1; surface->ms_dirty = surface->ms != NULL; ++surface->gen;
+    /* Draws with the title's own fog follow this pass (native_fog_draw). */
+    native_fog_frame();
+    s_native_fog_seen.target = surface;
+    ++s_native_fog_seen.passes;
+    s_native_fog_seen.start = start;
+    s_native_fog_seen.end = end;
+    s_native_fog_seen.depth_to_world = depth_to_world;
+    s_native_fog_seen.argb = argb;
+    if (!logged) {
+        logged = 1;
+        fprintf(stderr,"[FOG] native pass %ux%u depth-format=%u samples=%u\n",
+            surface->iw,surface->ih,depth_buffer->zf,depth_buffer->samples);
+    }
+}
diff --git a/src/video/nv2a_map_mask.h b/src/video/nv2a_map_mask.h
new file mode 100644
index 0000000..0f3cc7c
--- /dev/null
+++ b/src/video/nv2a_map_mask.h
@@ -0,0 +1,36 @@
+#ifndef NV2A_MAP_MASK_H
+#define NV2A_MAP_MASK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* PAL MM3 Hud/MapMask, independently decoded from its retail CDDS. Identity
+ * is checked only alongside a title-owned map base; dimensions alone could
+ * otherwise confuse checkpoints, gauges, menus or another title's textures. */
+static inline int nv2a_map_mask_matches(const uint8_t *bytes, size_t length)
+{
+    uint64_t hash = UINT64_C(14695981039346656037);
+    size_t i;
+    if (!bytes || length != 16384u) return 0;
+    for (i = 0; i < length; ++i)
+        hash = (hash ^ bytes[i]) * UINT64_C(1099511628211);
+    return hash == UINT64_C(0xDB4CFCE042391AD0);
+}
+
+/* Keep the middle 112x112 pixels fully visible; smoothly fade the last
+ * eight pixels on each side to transparent, including every corner. Black
+ * RGB retains the native alpha-only texture's register-combiner behavior. */
+static inline uint32_t nv2a_map_mask_pixel(unsigned x, unsigned y)
+{
+    unsigned edge;
+    float t;
+    if (x >= 128u || y >= 128u) return 0;
+    edge = x < y ? x : y;
+    if (127u - x < edge) edge = 127u - x;
+    if (127u - y < edge) edge = 127u - y;
+    t = edge < 8u ? (float)edge / 8.0f : 1.0f;
+    t = t * t * (3.0f - 2.0f * t);
+    return (uint32_t)(t * 255.0f + 0.5f) << 24;
+}
+
+#endif
diff --git a/src/video/nv2a_minimap_projection.h b/src/video/nv2a_minimap_projection.h
new file mode 100644
index 0000000..9c1099f
--- /dev/null
+++ b/src/video/nv2a_minimap_projection.h
@@ -0,0 +1,109 @@
+#ifndef NV2A_MINIMAP_PROJECTION_H
+#define NV2A_MINIMAP_PROJECTION_H
+
+#include <math.h>
+
+/* Grow the driving minimap's display frame from its visible bottom-left
+ * corner. The title compensates its world scale and marker sizes by this
+ * same factor, so a larger frame reveals more city at the authored scale. */
+#define NV2A_MINIMAP_SCALE 2.20f
+
+static inline float nv2a_minimap_motion_bound(float motion)
+{
+    if (!isfinite(motion) || motion < 0.0f) return 0.0f;
+    return motion > 1.0f ? 1.0f : motion;
+}
+
+/* The tilted near edge extends below the map's bottom clip. Remove the
+ * horizontal gap at that clip, rather than anchoring an invisible square's
+ * corner and leaving the visible road plane inset by perspective taper.
+ * Solve offset + vertical*d/(1-tilt*d) = 1 at the current camera tilt. */
+static inline float nv2a_minimap_left_crop_motion(float half_width, float motion)
+{
+    float tilt, vertical, offset, depth;
+    (void)motion; /* Speed zooms the world scale, never the display frame. */
+    tilt = .22f;
+    vertical = 1.15f;
+    offset = .60f;
+    depth = (1.0f - offset) / (vertical + tilt * (1.0f - offset));
+    return half_width * NV2A_MINIMAP_SCALE * (1.0f - (1.0f - tilt) / (1.0f - tilt * depth));
+}
+
+static inline float nv2a_minimap_left_crop(float half_width)
+{
+    return nv2a_minimap_left_crop_motion(half_width, 0.0f);
+}
+
+/* Opening the overview restores its authored flat rectangle. Blend the
+ * camera and anchor with the native transition rather than guessing from
+ * map size; small and split-screen maps can share the same dimensions. */
+static inline float nv2a_minimap_left_crop_camera(float half_width, float motion,
+                                                 float expansion)
+{
+    expansion = nv2a_minimap_motion_bound(expansion);
+    return nv2a_minimap_left_crop_motion(half_width, motion) * (1.0f - expansion);
+}
+
+/* A camera-facing road plane. Its far edge narrows toward the horizon; the
+ * player sits about 70% down the visible plane so the road ahead gets room.
+ * Enlarge from the common bottom-left anchor, keeping the rear crop grounded
+ * at the HUD's native bottom edge and preserving the road/icon relationship.
+ * Inputs and outputs are authored guest pixels, before the common HUD anchor.
+ * This same projection is used for road quads, guidance and map-only icons. */
+static inline int nv2a_minimap_project_motion(float x, float y, float cx, float cy,
+                                      float half_width, float half_height,
+                                      float motion,
+                                      float *projected_x, float *projected_y)
+{
+    float depth, perspective, tilt, vertical, offset;
+    if (!projected_x || !projected_y || !isfinite(x) || !isfinite(y) ||
+        !isfinite(cx) || !isfinite(cy) || !isfinite(half_width) ||
+        !isfinite(half_height) || half_width < 1.0f || half_height < 1.0f)
+        return 0;
+    depth = (y - cy) / half_height;
+    /* Native off-map indicator icons can extend a little past the window.
+     * Bound their perspective denominator without changing their position. */
+    if (depth < -1.25f) depth = -1.25f;
+    if (depth > 1.25f) depth = 1.25f;
+    (void)motion; /* Native world-scale zoom supplies speed-dependent reach. */
+    /* Keep one camera and visible frame while accelerating. Only the native
+     * road/checkpoint world scale changes, revealing more surrounding streets. */
+    tilt = .22f;
+    vertical = 1.15f;
+    offset = .60f;
+    perspective = 1.0f - tilt * depth;
+    *projected_x = cx + (x - cx) * (1.0f - tilt) / perspective;
+    *projected_y = cy + half_height * offset + (y - cy) * vertical / perspective;
+    *projected_x = cx - half_width + (*projected_x - (cx - half_width)) * NV2A_MINIMAP_SCALE;
+    *projected_y = cy + half_height - ((cy + half_height) - *projected_y) * NV2A_MINIMAP_SCALE;
+    return isfinite(*projected_x) && isfinite(*projected_y);
+}
+
+static inline int nv2a_minimap_project(float x, float y, float cx, float cy,
+                                      float half_width, float half_height,
+                                      float *projected_x, float *projected_y)
+{
+    return nv2a_minimap_project_motion(x, y, cx, cy, half_width, half_height,
+                                     0.0f, projected_x, projected_y);
+}
+
+static inline int nv2a_minimap_project_camera(float x, float y, float cx, float cy,
+                                      float half_width, float half_height,
+                                      float motion, float expansion,
+                                      float *projected_x, float *projected_y)
+{
+    if (!nv2a_minimap_project_motion(x, y, cx, cy, half_width, half_height,
+                                   motion, projected_x, projected_y))
+        return 0;
+    expansion = nv2a_minimap_motion_bound(expansion);
+    if (expansion == 1.0f) {
+        *projected_x = x;
+        *projected_y = y;
+        return 1;
+    }
+    *projected_x += (x - *projected_x) * expansion;
+    *projected_y += (y - *projected_y) * expansion;
+    return isfinite(*projected_x) && isfinite(*projected_y);
+}
+
+#endif
diff --git a/src/video/nv2a_pacing.h b/src/video/nv2a_pacing.h
new file mode 100644
index 0000000..eed15f8
--- /dev/null
+++ b/src/video/nv2a_pacing.h
@@ -0,0 +1,167 @@
+/* Display pacing is owned by the render thread. Keep the successful wait's
+ * one-millisecond spin tail and late-frame cadence; timer failures must not
+ * turn the entire remaining frame into a busy spin. */
+#ifndef NV2A_PACING_H
+#define NV2A_PACING_H
+
+#include <windows.h>
+#include <stdint.h>
+#include <limits.h>
+
+static int nv_pacing_deadline(int64_t *next, int64_t now, int64_t frequency, int limit)
+{
+    int64_t period;
+    if (limit <= 0 || frequency <= 0) return 0;
+    period = frequency / limit;
+    /* A zero period cannot pace. Rebase rather than overflow signed QPC
+     * arithmetic; valid timestamps follow the original deadline calculation. */
+    if (period <= 0 || now < 0 || *next < 0 || *next > INT64_MAX - period) {
+        *next = now;
+        return 0;
+    }
+    *next += period;
+    if (!*next || *next <= now) {
+        *next = now;
+        return 0;
+    }
+    return 1;
+}
+
+/* Display-locked cadence. A "60 Hz" panel refreshes at its own rate (the
+ * 3840x2400 laptop panel this was measured on reports 16.6609 ms through
+ * DwmGetCompositionTimingInfo, 60.0208 Hz), so the nominal deadline above
+ * beats against its vblank: a frame repeats about every 48 s, with a burst
+ * of doubled and skipped frames while the present phase crosses the
+ * compositor's pickup. Every late frame also re-phased that cadence at
+ * random. When the refresh is a whole multiple of the requested rate, frames
+ * are placed on a grid of whole refreshes instead, a quarter refresh after
+ * each vblank: three quarters remain for the frame's GPU work and, on hybrid
+ * laptops, its copy to the display adapter before the next composition, and
+ * the grid cannot wander. Returns the frame period, or 0 to keep the nominal
+ * cadence (refresh off by more than 0.5% from a multiple of the rate). */
+static int64_t nv_pacing_display_period(int64_t frequency, int limit, int64_t refresh)
+{
+    int64_t multiple, period;
+    if (limit <= 0 || frequency <= 0 || refresh <= 0) return 0;
+    /* 20-500 Hz displays only; anything else is not a usable report. */
+    if (refresh > frequency / 20 || refresh < frequency / 500) return 0;
+    multiple = (frequency + refresh * limit / 2) / (refresh * limit);
+    if (multiple < 1 || multiple > 8) return 0;
+    period = refresh * multiple;
+    if (period * limit > frequency + frequency / 200 ||
+        period * limit < frequency - frequency / 200) return 0;
+    return period;
+}
+
+static int64_t nv_pacing_floor_div(int64_t value, int64_t divisor)
+{
+    int64_t quotient = value / divisor;
+    return quotient * divisor > value ? quotient - 1 : quotient;
+}
+
+/* Nearest grid point: the anchor is refreshed from the compositor and may
+ * move by microseconds between reports. */
+static int64_t nv_pacing_grid_point(int64_t time, int64_t anchor, int64_t period)
+{
+    return anchor + nv_pacing_floor_div(time - anchor + period / 2, period) * period;
+}
+
+/* `anchor` is any grid point (a vblank plus a quarter refresh). Like the
+ * nominal deadline, a late frame is presented at once. It is counted in the
+ * refresh nearest to it, so a frame landing more than half a refresh late
+ * (possibly in the next composition, once copy time is included) makes the
+ * following frame wait for the grid point after that one: two frames never
+ * share a composition, which would drop the first. */
+static int nv_pacing_locked_deadline(int64_t *next, int64_t now, int64_t anchor, int64_t period)
+{
+    int64_t candidate;
+    if (period <= 0 || now < 0 || anchor < 0 || *next < 0 || *next > INT64_MAX - period ||
+        now > INT64_MAX - period) {
+        *next = now;
+        return 0;
+    }
+    candidate = nv_pacing_grid_point(*next ? *next + period : now, anchor, period);
+    if (candidate <= now) {
+        *next = nv_pacing_grid_point(now, anchor, period);
+        if (*next <= 0) *next = now;
+        return 0;
+    }
+    *next = candidate;
+    return 1;
+}
+
+static HANDLE nv_pacing_create_timer(void)
+{
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                         TIMER_ALL_ACCESS);
+    if (!timer) timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    return timer;
+}
+
+/* Convert QPC ticks to relative 100 ns units. The ordinary path is exactly
+ * the original integer conversion. Binary division handles only products
+ * that would overflow it, without changing the deadline or using floats. */
+static int64_t nv_pacing_timer_units(int64_t ticks, int64_t frequency)
+{
+    const uint64_t scale = 10000000;
+    uint64_t t = (uint64_t)ticks, f = (uint64_t)frequency, units;
+    if (ticks <= 0 || frequency <= 0) return 1;
+    if (t <= INT64_MAX / scale) {
+        units = t * scale / f;
+    } else {
+        uint64_t whole = t / f, a = t % f, remainder = 0, fraction = 0;
+        int bit;
+        for (bit = 23; bit >= 0; bit--) {
+            fraction *= 2;
+            if (remainder >= f - remainder) {
+                remainder -= f - remainder;
+                fraction++;
+            } else remainder *= 2;
+            if ((scale >> bit) & 1) {
+                if (remainder >= f - a) {
+                    remainder -= f - a;
+                    fraction++;
+                } else remainder += a;
+            }
+        }
+        if (whole > (INT64_MAX - fraction) / scale) return INT64_MAX;
+        units = whole * scale + fraction;
+    }
+    /* Zero would be an absolute date, rather than a future relative wait. */
+    return units ? (int64_t)units : 1;
+}
+
+static int64_t nv_pacing_qpc(void)
+{
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    return now.QuadPart;
+}
+
+static void nv_pacing_wait(HANDLE timer, int64_t frequency, int64_t deadline, int64_t now)
+{
+    int64_t remain = deadline - now;
+    int64_t spin = frequency / 1000;
+    if (remain > spin) {
+        int waited = 0;
+        if (timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -nv_pacing_timer_units(remain - spin, frequency);
+            if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+                waited = WaitForSingleObject(timer, INFINITE) == WAIT_OBJECT_0;
+        }
+        if (!waited) {
+            /* Request at most one ms at a time and recheck QPC: Sleep and
+             * ordinary timers can wake late on a coarse-resolution system.
+             * Failure never makes us spin longer than the original tail. */
+            now = nv_pacing_qpc();
+            while (now < deadline && deadline - now > spin) {
+                Sleep(1);
+                now = nv_pacing_qpc();
+            }
+        }
+    }
+    while (nv_pacing_qpc() < deadline) YieldProcessor();
+}
+
+#endif
diff --git a/src/video/nv2a_ps_manifest.h b/src/video/nv2a_ps_manifest.h
new file mode 100644
index 0000000..5ddea2c
--- /dev/null
+++ b/src/video/nv2a_ps_manifest.h
@@ -0,0 +1,118 @@
+/* Optional, bounded specialised-PS warm-up metadata. Bytecode keeps its own
+ * independently validated cache; any metadata failure leaves lazy compilation. */
+#ifndef NV2A_PS_MANIFEST_H
+#define NV2A_PS_MANIFEST_H
+
+#include "nv2a_shader_cache.h"
+
+#define NV_PS_MANIFEST_SCHEMA 1u
+#define NV_PS_MANIFEST_WORDS 54u
+#define NV_PS_MANIFEST_LIMIT 512u
+#define NV_PS_MANIFEST_HEADER 88u
+
+static uint32_t nv_ps_get32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void nv_ps_put32(uint8_t *p, uint32_t v)
+{
+    unsigned i;
+    for (i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i));
+}
+
+static int nv_ps_manifest_path(const uint8_t family[32], wchar_t path[NV_SHADER_CACHE_PATH])
+{
+    if (!nv_shader_cache_path(family, path)) return 0;
+    wcscpy_s(path + wcslen(path) - 4, 5, L".psm");
+    return 1;
+}
+
+static int nv_ps_manifest_read(const wchar_t *path, const uint8_t family[32],
+                              uint32_t records[NV_PS_MANIFEST_LIMIT][NV_PS_MANIFEST_WORDS],
+                              unsigned *count)
+{
+    uint8_t header[NV_PS_MANIFEST_HEADER], checksum[32];
+    uint8_t payload[NV_PS_MANIFEST_LIMIT * NV_PS_MANIFEST_WORDS * 4];
+    NvShaderHash hash;
+    LARGE_INTEGER size;
+    DWORD read, bytes;
+    unsigned n, i, j;
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                             NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    int ok = 0;
+    *count = 0;
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    if (!GetFileSizeEx(file, &size) ||
+        !ReadFile(file, header, sizeof header, &read, NULL) || read != sizeof header ||
+        memcmp(header, "NVPSMAN1", 8) || nv_ps_get32(header + 8) != NV_PS_MANIFEST_SCHEMA ||
+        nv_ps_get32(header + 12) != NV_PS_MANIFEST_WORDS * 4 ||
+        nv_ps_get32(header + 20) != 0 || memcmp(header + 24, family, 32)) goto done;
+    n = nv_ps_get32(header + 16);
+    if (n > NV_PS_MANIFEST_LIMIT) goto done;
+    bytes = n * NV_PS_MANIFEST_WORDS * 4;
+    if (size.QuadPart != (LONGLONG)sizeof header + bytes ||
+        !ReadFile(file, payload, bytes, &read, NULL) || read != bytes) goto done;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, payload, bytes);
+    nv_shader_hash_finish(&hash, checksum);
+    if (memcmp(header + 56, checksum, 32)) goto done;
+    /* Decode only after validating the complete file; never partially import. */
+    for (i = 0; i < n; i++) for (j = 0; j < NV_PS_MANIFEST_WORDS; j++)
+        records[i][j] = nv_ps_get32(payload + (i * NV_PS_MANIFEST_WORDS + j) * 4);
+    *count = n;
+    ok = 1;
+done:
+    CloseHandle(file);
+    return ok;
+}
+
+static int nv_ps_manifest_write(const wchar_t *path, const uint8_t family[32],
+                               const uint32_t records[][NV_PS_MANIFEST_WORDS], unsigned count)
+{
+    static volatile LONG serial;
+    uint8_t header[NV_PS_MANIFEST_HEADER] = {0};
+    uint8_t payload[NV_PS_MANIFEST_LIMIT * NV_PS_MANIFEST_WORDS * 4];
+    wchar_t temporary[NV_SHADER_CACHE_PATH], dir[NV_SHADER_CACHE_PATH];
+    NvShaderHash hash;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    DWORD wrote, bytes;
+    unsigned i, j;
+    int ok;
+    if (count > NV_PS_MANIFEST_LIMIT) return 0;
+    bytes = count * NV_PS_MANIFEST_WORDS * 4;
+    for (i = 0; i < count; i++) for (j = 0; j < NV_PS_MANIFEST_WORDS; j++)
+        nv_ps_put32(payload + (i * NV_PS_MANIFEST_WORDS + j) * 4, records[i][j]);
+    memcpy(header, "NVPSMAN1", 8);
+    nv_ps_put32(header + 8, NV_PS_MANIFEST_SCHEMA);
+    nv_ps_put32(header + 12, NV_PS_MANIFEST_WORDS * 4);
+    nv_ps_put32(header + 16, count);
+    memcpy(header + 24, family, 32);
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, payload, bytes);
+    nv_shader_hash_finish(&hash, header + 56);
+    wcscpy_s(dir, NV_SHADER_CACHE_PATH, path);
+    *wcsrchr(dir, L'\\') = 0;
+    for (i = 3; dir[i]; i++) if (dir[i] == L'\\' || dir[i] == L'/') {
+        wchar_t slash = dir[i]; dir[i] = 0;
+        CreateDirectoryW(dir, NULL); dir[i] = slash;
+    }
+    if (!CreateDirectoryW(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return 0;
+    for (i = 0; i < 4 && file == INVALID_HANDLE_VALUE; i++) {
+        if (swprintf_s(temporary, NV_SHADER_CACHE_PATH, L"%s.%lu.%lu.%lu.tmp", path,
+                       GetCurrentProcessId(), GetCurrentThreadId(),
+                       (unsigned long)InterlockedIncrement(&serial)) < 0) return 0;
+        file = CreateFileW(temporary, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) return 0;
+    }
+    if (file == INVALID_HANDLE_VALUE) return 0;
+    ok = WriteFile(file, header, sizeof header, &wrote, NULL) && wrote == sizeof header;
+    if (ok) ok = WriteFile(file, payload, bytes, &wrote, NULL) && wrote == bytes;
+    CloseHandle(file);
+    if (ok) ok = MoveFileExW(temporary, path, MOVEFILE_REPLACE_EXISTING) != 0;
+    if (!ok) DeleteFileW(temporary);
+    return ok;
+}
+
+#endif
diff --git a/src/video/nv2a_shader_cache.h b/src/video/nv2a_shader_cache.h
new file mode 100644
index 0000000..f833590
--- /dev/null
+++ b/src/video/nv2a_shader_cache.h
@@ -0,0 +1,272 @@
+/* Persistent D3DCompile bytecode. Cache failures always fall back to compiling;
+ * specialised shaders call this on their existing compiler worker threads. */
+#ifndef NV2A_SHADER_CACHE_H
+#define NV2A_SHADER_CACHE_H
+
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#define NV_SHADER_CACHE_SCHEMA 1u
+#define NV_SHADER_CACHE_MAX_CODE (16u * 1024u * 1024u)
+#define NV_SHADER_CACHE_PATH 1040
+
+/* SHA-256 keeps the filename and the bytecode checksum independent of runtime
+ * addresses, compiler struct padding, and ambiguous macro concatenations. */
+typedef struct {
+    uint32_t h[8];
+    uint64_t bytes;
+    unsigned used;
+    uint8_t block[64];
+} NvShaderHash;
+
+static uint32_t nv_shader_ror(uint32_t x, unsigned n)
+{
+    return (x >> n) | (x << (32 - n));
+}
+
+static void nv_shader_hash_block(NvShaderHash *s, const uint8_t *p)
+{
+    static const uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+    };
+    uint32_t w[64], a,b,c,d,e,f,g,h;
+    unsigned i;
+    for (i = 0; i < 16; i++)
+        w[i] = (uint32_t)p[i*4] << 24 | (uint32_t)p[i*4+1] << 16 |
+               (uint32_t)p[i*4+2] << 8 | p[i*4+3];
+    for (; i < 64; i++) {
+        uint32_t x = w[i-15], y = w[i-2];
+        w[i] = w[i-16] + (nv_shader_ror(x,7) ^ nv_shader_ror(x,18) ^ (x >> 3)) +
+               w[i-7] + (nv_shader_ror(y,17) ^ nv_shader_ror(y,19) ^ (y >> 10));
+    }
+    a=s->h[0]; b=s->h[1]; c=s->h[2]; d=s->h[3];
+    e=s->h[4]; f=s->h[5]; g=s->h[6]; h=s->h[7];
+    for (i = 0; i < 64; i++) {
+        uint32_t t1 = h + (nv_shader_ror(e,6) ^ nv_shader_ror(e,11) ^ nv_shader_ror(e,25)) +
+                      ((e & f) ^ (~e & g)) + k[i] + w[i];
+        uint32_t t2 = (nv_shader_ror(a,2) ^ nv_shader_ror(a,13) ^ nv_shader_ror(a,22)) +
+                      ((a & b) ^ (a & c) ^ (b & c));
+        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    s->h[0]+=a; s->h[1]+=b; s->h[2]+=c; s->h[3]+=d;
+    s->h[4]+=e; s->h[5]+=f; s->h[6]+=g; s->h[7]+=h;
+}
+
+static void nv_shader_hash_init(NvShaderHash *s)
+{
+    static const uint32_t initial[8] = {
+        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
+    };
+    memset(s, 0, sizeof *s);
+    memcpy(s->h, initial, sizeof initial);
+}
+
+static void nv_shader_hash_add(NvShaderHash *s, const void *data, size_t size)
+{
+    const uint8_t *p = (const uint8_t *)data;
+    s->bytes += size;
+    while (size) {
+        size_t n = 64 - s->used;
+        if (n > size) n = size;
+        memcpy(s->block + s->used, p, n);
+        s->used += (unsigned)n; p += n; size -= n;
+        if (s->used == 64) {
+            nv_shader_hash_block(s, s->block);
+            s->used = 0;
+        }
+    }
+}
+
+static void nv_shader_hash_finish(NvShaderHash *s, uint8_t out[32])
+{
+    uint64_t bits = s->bytes * 8;
+    uint8_t tail[72] = {0x80};
+    unsigned i, n = s->used < 56 ? 56 - s->used : 120 - s->used;
+    for (i = 0; i < 8; i++) tail[n+i] = (uint8_t)(bits >> (56-i*8));
+    nv_shader_hash_add(s, tail, n+8);
+    for (i = 0; i < 32; i++) out[i] = (uint8_t)(s->h[i/4] >> (24-(i%4)*8));
+}
+
+static void nv_shader_hash_number(NvShaderHash *s, uint64_t value)
+{
+    uint8_t bytes[8];
+    unsigned i;
+    for (i = 0; i < 8; i++) bytes[i] = (uint8_t)(value >> (i*8));
+    nv_shader_hash_add(s, bytes, sizeof bytes);
+}
+
+static void nv_shader_hash_string(NvShaderHash *s, const char *text)
+{
+    size_t n = text ? strlen(text) : 0;
+    nv_shader_hash_number(s, text ? n : UINT64_MAX);
+    if (n) nv_shader_hash_add(s, text, n);
+}
+
+static void nv_shader_cache_key(const void *source, size_t size, const char *name,
+                               const D3D_SHADER_MACRO *macros, const char *entry,
+                               const char *target, UINT flags1, UINT flags2,
+                               uint8_t key[32])
+{
+    NvShaderHash hash;
+    size_t i, count = 0;
+    if (macros) while (macros[count].Name) count++;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_number(&hash, NV_SHADER_CACHE_SCHEMA);
+    nv_shader_hash_number(&hash, size);
+    nv_shader_hash_add(&hash, source, size);
+    nv_shader_hash_string(&hash, name);
+    nv_shader_hash_string(&hash, entry);
+    nv_shader_hash_string(&hash, target);
+    nv_shader_hash_number(&hash, flags1);
+    nv_shader_hash_number(&hash, flags2);
+    nv_shader_hash_number(&hash, count);
+    for (i = 0; i < count; i++) {
+        nv_shader_hash_string(&hash, macros[i].Name);
+        nv_shader_hash_string(&hash, macros[i].Definition);
+    }
+    nv_shader_hash_finish(&hash, key);
+}
+
+static int nv_shader_cache_path(const uint8_t key[32], wchar_t path[NV_SHADER_CACHE_PATH])
+{
+    wchar_t dir[NV_SHADER_CACHE_PATH], full[NV_SHADER_CACHE_PATH], enabled[8];
+    DWORD n = GetEnvironmentVariableW(L"RECOMP_SHADER_CACHE", enabled, 8);
+    size_t length;
+    unsigned i;
+    if (n == 1 && enabled[0] == L'0') return 0;
+    n = GetEnvironmentVariableW(L"RECOMP_SHADER_CACHE_DIR", dir, NV_SHADER_CACHE_PATH);
+    if (n >= NV_SHADER_CACHE_PATH) return 0;
+    if (!n) {
+        n = GetEnvironmentVariableW(L"LOCALAPPDATA", dir, NV_SHADER_CACHE_PATH);
+        if (!n || n >= NV_SHADER_CACHE_PATH - 40) return 0;
+        wcscat_s(dir, NV_SHADER_CACHE_PATH, L"\\xboxrecomp\\ShaderCache");
+    }
+    n = GetFullPathNameW(dir, NV_SHADER_CACHE_PATH, full, NULL);
+    if (!n || n >= NV_SHADER_CACHE_PATH - 80) return 0;
+    length = wcslen(full);
+    while (length && (full[length-1] == L'\\' || full[length-1] == L'/')) length--;
+    memcpy(path, full, length * sizeof *path);
+    path[length++] = L'\\';
+    for (i = 0; i < 32; i++) {
+        static const wchar_t hex[] = L"0123456789abcdef";
+        path[length++] = hex[key[i] >> 4];
+        path[length++] = hex[key[i] & 15];
+    }
+    wcscpy_s(path + length, NV_SHADER_CACHE_PATH - length, L".bin");
+    return 1;
+}
+
+typedef struct {
+    uint8_t magic[8];
+    uint32_t schema, size;
+    uint8_t key[32], checksum[32];
+} NvShaderCacheHeader;
+
+static ID3DBlob *nv_shader_cache_read(const wchar_t *path, const uint8_t key[32])
+{
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                              NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    NvShaderCacheHeader header;
+    LARGE_INTEGER length;
+    ID3DBlob *code = NULL;
+    NvShaderHash hash;
+    uint8_t checksum[32];
+    DWORD read;
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (!GetFileSizeEx(file, &length) ||
+        !ReadFile(file, &header, sizeof header, &read, NULL) || read != sizeof header ||
+        memcmp(header.magic, "NVSCACHE", 8) || header.schema != NV_SHADER_CACHE_SCHEMA ||
+        !header.size || header.size > NV_SHADER_CACHE_MAX_CODE ||
+        length.QuadPart != (LONGLONG)sizeof header + header.size ||
+        memcmp(header.key, key, 32) || FAILED(D3DCreateBlob(header.size, &code))) goto done;
+    if (!ReadFile(file, ID3D10Blob_GetBufferPointer(code), header.size, &read, NULL) ||
+        read != header.size) goto invalid;
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, ID3D10Blob_GetBufferPointer(code), header.size);
+    nv_shader_hash_finish(&hash, checksum);
+    if (memcmp(checksum, header.checksum, 32)) goto invalid;
+    goto done;
+invalid:
+    ID3D10Blob_Release(code);
+    code = NULL;
+done:
+    CloseHandle(file);
+    return code;
+}
+
+static void nv_shader_cache_write(const wchar_t *path, const uint8_t key[32], ID3DBlob *code)
+{
+    static volatile LONG serial;
+    wchar_t temporary[NV_SHADER_CACHE_PATH], dir[NV_SHADER_CACHE_PATH];
+    NvShaderCacheHeader header;
+    NvShaderHash hash;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    size_t size = ID3D10Blob_GetBufferSize(code), i;
+    DWORD wrote;
+    int ok;
+    if (!size || size > NV_SHADER_CACHE_MAX_CODE) return;
+    wcscpy_s(dir, NV_SHADER_CACHE_PATH, path);
+    *wcsrchr(dir, L'\\') = 0;
+    /* Parent creation is idempotent when several compiler workers arrive. */
+    for (i = 3; dir[i]; i++) if (dir[i] == L'\\' || dir[i] == L'/') {
+        wchar_t slash = dir[i]; dir[i] = 0;
+        CreateDirectoryW(dir, NULL); dir[i] = slash;
+    }
+    if (!CreateDirectoryW(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) return;
+    for (i = 0; i < 4 && file == INVALID_HANDLE_VALUE; i++) {
+        if (swprintf_s(temporary, NV_SHADER_CACHE_PATH, L"%s.%lu.%lu.%lu.tmp", path,
+                       GetCurrentProcessId(), GetCurrentThreadId(),
+                       (unsigned long)InterlockedIncrement(&serial)) < 0) return;
+        file = CreateFileW(temporary, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                           FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file == INVALID_HANDLE_VALUE && GetLastError() != ERROR_FILE_EXISTS) return;
+    }
+    if (file == INVALID_HANDLE_VALUE) return;
+    memcpy(header.magic, "NVSCACHE", 8);
+    header.schema = NV_SHADER_CACHE_SCHEMA; header.size = (uint32_t)size;
+    memcpy(header.key, key, 32);
+    nv_shader_hash_init(&hash);
+    nv_shader_hash_add(&hash, ID3D10Blob_GetBufferPointer(code), size);
+    nv_shader_hash_finish(&hash, header.checksum);
+    ok = WriteFile(file, &header, sizeof header, &wrote, NULL) && wrote == sizeof header;
+    if (ok) ok = WriteFile(file, ID3D10Blob_GetBufferPointer(code), (DWORD)size, &wrote, NULL) && wrote == size;
+    CloseHandle(file);
+    if (!ok || !MoveFileExW(temporary, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileW(temporary);
+}
+
+static HRESULT nv_shader_cache_compile(const void *source, size_t size, const char *name,
+                                      const D3D_SHADER_MACRO *macros, const char *entry,
+                                      const char *target, UINT flags1, UINT flags2,
+                                      ID3DBlob **code, ID3DBlob **errors, int *cache_hit)
+{
+    uint8_t key[32];
+    wchar_t path[NV_SHADER_CACHE_PATH];
+    int cache;
+    HRESULT hr;
+    *code = NULL;
+    if (errors) *errors = NULL;
+    if (cache_hit) *cache_hit = 0;
+    nv_shader_cache_key(source, size, name, macros, entry, target, flags1, flags2, key);
+    cache = nv_shader_cache_path(key, path);
+    if (cache && (*code = nv_shader_cache_read(path, key)) != NULL) {
+        if (cache_hit) *cache_hit = 1;
+        return S_OK;
+    }
+    hr = D3DCompile(source, size, name, macros, NULL, entry, target, flags1, flags2, code, errors);
+    if (SUCCEEDED(hr) && cache) nv_shader_cache_write(path, key, *code);
+    return hr;
+}
+
+#endif
diff --git a/src/video/nv2a_slow_frame.h b/src/video/nv2a_slow_frame.h
new file mode 100644
index 0000000..58b97cc
--- /dev/null
+++ b/src/video/nv2a_slow_frame.h
@@ -0,0 +1,233 @@
+/* Renderer-thread diagnostics only. No host clocks when disabled. API totals
+ * are exclusive to that API; draw/readback scopes explicitly include nested
+ * work, and observed pending wall time overlaps CPU work. Never add them. */
+#ifndef NV2A_SLOW_FRAME_H
+#define NV2A_SLOW_FRAME_H
+#include <windows.h>
+#include <d3d11.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+
+#ifndef NV_SLOW_FRAME_LOG
+#define NV_SLOW_FRAME_LOG(...) fprintf(stderr, __VA_ARGS__)
+#endif
+
+enum { SF_RAW, SF_INDEX, SF_CONSTANT, SF_BUFFER_COUNT };
+enum { SF_DRAW_SCOPE, SF_READBACK_FINISH_SCOPE, SF_READBACK_ISSUE_SCOPE,
+       SF_PRESENT_API, SF_PACE_WAIT, SF_CAPTURE_PROBE, SF_CAPTURE_IO_SCOPE,
+       SF_DIAGNOSTIC_OUTPUT, SF_STAGE_COUNT };
+typedef struct {
+    uint64_t calls, bytes, discard, nooverwrite, other_mode, failures, unmap_calls;
+    int64_t ticks, maximum, unmap_ticks, unmap_maximum;
+    HRESULT last_hr, maximum_hr;
+    unsigned maximum_mode;
+    uint64_t maximum_bytes;
+} SlowFrameMap;
+typedef struct { uint64_t calls; int64_t ticks, maximum; } SlowFrameStage;
+typedef struct {
+    SlowFrameMap maps[SF_BUFFER_COUNT];
+    SlowFrameStage stage[SF_STAGE_COUNT];
+    int64_t pending_overlap;
+    uint64_t invalid_timings;
+} SlowFrameSample;
+static struct {
+    int configured, enabled;
+    int64_t frequency, previous, last_emit, pending_begin;
+    uint64_t frames, slow_frames, suppressed, emitted;
+    SlowFrameSample sample;
+} s_slow_frame;
+
+static int slow_frame_enabled(void)
+{
+    if (!s_slow_frame.configured) {
+        const char *setting;
+        LARGE_INTEGER frequency;
+        s_slow_frame.configured = 1;
+        setting = getenv("RECOMP_SLOW_FRAME_TRACE");
+        if (setting && !strcmp(setting, "1") &&
+            QueryPerformanceFrequency(&frequency) && frequency.QuadPart > 0) {
+            s_slow_frame.frequency = frequency.QuadPart;
+            s_slow_frame.enabled = 1;
+        }
+    }
+    return s_slow_frame.enabled;
+}
+
+static int64_t slow_frame_begin(void)
+{
+    LARGE_INTEGER now;
+    if (!slow_frame_enabled()) return 0;
+    if (!QueryPerformanceCounter(&now) || now.QuadPart <= 0) return 0;
+    return now.QuadPart;
+}
+
+static int64_t slow_frame_elapsed(int64_t begin)
+{
+    int64_t end = begin ? slow_frame_begin() : 0;
+    if (!begin || end < begin) {
+        ++s_slow_frame.sample.invalid_timings;
+        return 0;
+    }
+    return end - begin;
+}
+
+static void slow_frame_add_ticks(unsigned stage, int64_t ticks)
+{
+    SlowFrameStage *entry;
+    if (!slow_frame_enabled() || stage >= SF_STAGE_COUNT) return;
+    entry = &s_slow_frame.sample.stage[stage];
+    ++entry->calls;
+    if (ticks < 0) { ++s_slow_frame.sample.invalid_timings; return; }
+    entry->ticks += ticks;
+    if (ticks > entry->maximum) entry->maximum = ticks;
+}
+
+static void slow_frame_end(unsigned stage, int64_t begin)
+{
+    if (slow_frame_enabled()) slow_frame_add_ticks(stage, slow_frame_elapsed(begin));
+}
+
+static void slow_frame_map_end(unsigned kind, int64_t begin, uint64_t bytes,
+                                unsigned mode, HRESULT hr)
+{
+    SlowFrameMap *entry;
+    int64_t ticks;
+    if (!slow_frame_enabled() || kind >= SF_BUFFER_COUNT) return;
+    ticks = slow_frame_elapsed(begin);
+    entry = &s_slow_frame.sample.maps[kind];
+    ++entry->calls; entry->bytes += bytes; entry->last_hr = hr;
+    if (FAILED(hr)) ++entry->failures;
+    if (mode == D3D11_MAP_WRITE_DISCARD) ++entry->discard;
+    else if (mode == D3D11_MAP_WRITE_NO_OVERWRITE) ++entry->nooverwrite;
+    else ++entry->other_mode;
+    entry->ticks += ticks;
+    if (entry->calls == 1 || ticks > entry->maximum) {
+        entry->maximum = ticks; entry->maximum_hr = hr;
+        entry->maximum_mode = mode; entry->maximum_bytes = bytes;
+    }
+}
+
+static void slow_frame_unmap_end(unsigned kind, int64_t begin)
+{
+    SlowFrameMap *entry;
+    int64_t ticks;
+    if (!slow_frame_enabled() || kind >= SF_BUFFER_COUNT) return;
+    ticks = slow_frame_elapsed(begin);
+    entry = &s_slow_frame.sample.maps[kind];
+    ++entry->unmap_calls; entry->unmap_ticks += ticks;
+    if (ticks > entry->unmap_maximum) entry->unmap_maximum = ticks;
+}
+
+/* Only transitions take a clock; repeated busy polls add no extra clocks. */
+static void slow_frame_readback_pending(int busy)
+{
+    int64_t now;
+    if (!slow_frame_enabled()) return;
+    if (busy && !s_slow_frame.pending_begin)
+        s_slow_frame.pending_begin = slow_frame_begin();
+    else if (!busy && s_slow_frame.pending_begin) {
+        now = slow_frame_begin();
+        if (now >= s_slow_frame.pending_begin)
+            s_slow_frame.sample.pending_overlap += now - s_slow_frame.pending_begin;
+        else ++s_slow_frame.sample.invalid_timings;
+        s_slow_frame.pending_begin = 0;
+    }
+}
+
+static void slow_frame_append(char *line, size_t capacity, size_t *used,
+                               const char *format, ...)
+{
+    va_list args;
+    int written;
+    if (*used >= capacity - 1) return;
+    va_start(args, format);
+    written = vsnprintf(line + *used, capacity - *used, format, args);
+    va_end(args);
+    if (written > 0)
+        *used += (size_t)written < capacity - *used ? (size_t)written : capacity - *used - 1;
+}
+
+/* `now` is the very same QPC timestamp written to the frame CSV. Exact raw
+ * ticks avoid rounding ambiguity in its decimal columns. Reset BEFORE log
+ * formatting/I/O: that overhead belongs to the following frame interval. */
+static void slow_frame_boundary(int64_t now, unsigned csv_line)
+{
+    static const char *const kinds[] = { "raw", "index", "constant" };
+    static const char *const stages[] = {
+        "draw_scope_inclusive", "readback_finish_scope_inclusive", "readback_issue_scope_inclusive",
+        "present_api", "pace_wait", "capture_probe", "capture_io_scope_inclusive", "diagnostic_output" };
+    SlowFrameSample sample;
+    int64_t previous, duration, output_begin;
+    double ms;
+    char line[8192];
+    size_t used = 0;
+    unsigned i;
+    if (!slow_frame_enabled()) return;
+    previous = s_slow_frame.previous;
+    s_slow_frame.previous = now;
+    if (s_slow_frame.pending_begin) {
+        if (previous && now >= s_slow_frame.pending_begin)
+            s_slow_frame.sample.pending_overlap += now - s_slow_frame.pending_begin;
+        s_slow_frame.pending_begin = now;
+    }
+    sample = s_slow_frame.sample;
+    memset(&s_slow_frame.sample, 0, sizeof s_slow_frame.sample);
+    if (!previous || now <= previous) {
+        s_slow_frame.last_emit = 0;
+        return;
+    }
+    ++s_slow_frame.frames;
+    duration = now - previous;
+    /* Strictly >30ms, with no overflow in the integer QPC conversion. */
+    if (duration <= s_slow_frame.frequency / 100 * 3 +
+        s_slow_frame.frequency % 100 * 3 / 100) return;
+    ++s_slow_frame.slow_frames;
+    if (s_slow_frame.last_emit && now - s_slow_frame.last_emit <
+        s_slow_frame.frequency / 2 + s_slow_frame.frequency % 2) {
+        ++s_slow_frame.suppressed;
+        return;
+    }
+    s_slow_frame.last_emit = now;
+    ++s_slow_frame.emitted;
+    output_begin = slow_frame_begin();
+    ms = 1000.0 / s_slow_frame.frequency;
+    slow_frame_append(line, sizeof line, &used,
+        "[HITCH] phase=slow_frame qpc_ms=%.3f start_qpc_ms=%.3f duration_ms=%.4f "
+        "start_qpc_ticks=%lld end_qpc_ticks=%lld qpc_frequency=%lld csv_line=%u frame=%llu "
+        "record=%llu budget=64 slow_seen=%llu rate_suppressed=%llu timing_invalid=%llu "
+        "scope=nested_totals_not_additive pending_wall_overlap_ms=%.4f",
+        now * ms, previous * ms, duration * ms, (long long)previous, (long long)now,
+        (long long)s_slow_frame.frequency, csv_line, (unsigned long long)s_slow_frame.frames,
+        (unsigned long long)s_slow_frame.emitted, (unsigned long long)s_slow_frame.slow_frames,
+        (unsigned long long)s_slow_frame.suppressed, (unsigned long long)sample.invalid_timings,
+        sample.pending_overlap * ms);
+    for (i = 0; i < SF_BUFFER_COUNT; ++i) {
+        SlowFrameMap *m = &sample.maps[i];
+        slow_frame_append(line, sizeof line, &used,
+            " %s_map_calls=%llu %s_map_bytes=%llu %s_map_ms=%.4f %s_map_max_ms=%.4f "
+            "%s_map_discard=%llu %s_map_nooverwrite=%llu %s_map_other=%llu %s_map_failures=%llu "
+            "%s_map_last_hr=0x%08lX %s_map_max_hr=0x%08lX %s_map_max_mode=%u %s_map_max_bytes=%llu "
+            "%s_unmap_calls=%llu %s_unmap_ms=%.4f %s_unmap_max_ms=%.4f",
+            kinds[i], (unsigned long long)m->calls, kinds[i], (unsigned long long)m->bytes,
+            kinds[i], m->ticks * ms, kinds[i], m->maximum * ms,
+            kinds[i], (unsigned long long)m->discard, kinds[i], (unsigned long long)m->nooverwrite,
+            kinds[i], (unsigned long long)m->other_mode, kinds[i], (unsigned long long)m->failures,
+            kinds[i], (unsigned long)m->last_hr, kinds[i], (unsigned long)m->maximum_hr,
+            kinds[i], m->maximum_mode, kinds[i], (unsigned long long)m->maximum_bytes,
+            kinds[i], (unsigned long long)m->unmap_calls, kinds[i], m->unmap_ticks * ms,
+            kinds[i], m->unmap_maximum * ms);
+    }
+    for (i = 0; i < SF_STAGE_COUNT; ++i)
+        slow_frame_append(line, sizeof line, &used, " %s_ms=%.4f %s_max_ms=%.4f %s_calls=%llu",
+            stages[i], sample.stage[i].ticks * ms, stages[i], sample.stage[i].maximum * ms,
+            stages[i], (unsigned long long)sample.stage[i].calls);
+    slow_frame_append(line, sizeof line, &used, " record_end=1\n");
+    NV_SLOW_FRAME_LOG("%s", line); /* One complete record, not interleaved fragments. */
+    slow_frame_end(SF_DIAGNOSTIC_OUTPUT, output_begin);
+    if (s_slow_frame.emitted == 64) s_slow_frame.enabled = 0; /* Stop timing too. */
+}
+
+#endif
diff --git a/src/video/nv2a_texture_hash.h b/src/video/nv2a_texture_hash.h
new file mode 100644
index 0000000..9dc9c00
--- /dev/null
+++ b/src/video/nv2a_texture_hash.h
@@ -0,0 +1,152 @@
+/* Content hash for texture and render-target change checks. Native integer
+ * lanes preserve the scalar hash exactly; only CPU execution changes, never
+ * the amount or frequency of validation.
+ *
+ * Sixteen independent 64-bit lanes take one 128-byte block per step (lane i
+ * the i-th little-endian word): v = (v ^ w) * 0x100000001B3, v ^= v >> 31.
+ * Four independent 256-bit chains keep the multiplier busy instead of
+ * waiting on one dependency chain. After the full blocks, leftover 32-byte
+ * blocks go to lanes 0..3 and leftover bytes to lane 0 (FNV-1a style). The
+ * sixteen lanes fold into the result. Lanes start from fixed constants with
+ * the length mixed into lane 3. hash_rows applies the same steps row by row
+ * (a pitched guest surface and its packed shadow hash alike). */
+#ifndef NV2A_TEXTURE_HASH_H
+#define NV2A_TEXTURE_HASH_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#define NV_HASH_PRIME 0x100000001B3ull
+
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+#include <intrin.h>
+#include <immintrin.h>
+#ifndef NV_HASH_CPUID
+#define NV_HASH_CPUID(result,leaf,subleaf) __cpuidex(result,leaf,subleaf)
+#endif
+#ifndef NV_HASH_XGETBV
+#define NV_HASH_XGETBV(index) _xgetbv(index)
+#endif
+static int hash_mem_cpu_native(void)
+{
+    int r[4];
+    NV_HASH_CPUID(r,0,0);
+    if(r[0]<7) return 0;
+    NV_HASH_CPUID(r,1,0);
+    /* XSAVE, OSXSAVE and AVX precede XGETBV. The OS must save XMM/YMM,
+     * opmask and both upper ZMM components, including for 256-bit EVEX. */
+    if(((uint32_t)r[2]&0x1C000000u)!=0x1C000000u) return 0;
+    if((NV_HASH_XGETBV(0)&0xE6u)!=0xE6u) return 0;
+    NV_HASH_CPUID(r,7,0);
+    /* AVX2 for the 256-bit logical shifts, AVX512F/DQ/VL for VPMULLQ. */
+    return ((uint32_t)r[1]&0x80030020u)==0x80030020u;
+}
+static volatile long s_hash_mem_native = -1;
+static int hash_mem_native_available(void)
+{
+    long available=s_hash_mem_native;
+    if(available<0) {
+        int detected=hash_mem_cpu_native();
+        _InterlockedCompareExchange(&s_hash_mem_native,detected,-1);
+        available=s_hash_mem_native;
+    }
+    return available!=0;
+}
+/* Keep feature instructions outside the generic scalar function. No global
+ * /arch option is required or used; the runtime guard owns every call here. */
+static __declspec(noinline) void hash_blocks_native(uint64_t v[16],const uint8_t *p,size_t blocks)
+{
+    __m256i a=_mm256_loadu_si256((const __m256i *)v),b=_mm256_loadu_si256((const __m256i *)(v+4));
+    __m256i c=_mm256_loadu_si256((const __m256i *)(v+8)),d=_mm256_loadu_si256((const __m256i *)(v+12));
+    __m256i prime=_mm256_set1_epi64x((long long)NV_HASH_PRIME);
+    for(;blocks;--blocks,p+=128) {
+        a=_mm256_mullo_epi64(_mm256_xor_si256(a,_mm256_loadu_si256((const __m256i *)p)),prime);
+        b=_mm256_mullo_epi64(_mm256_xor_si256(b,_mm256_loadu_si256((const __m256i *)(p+32))),prime);
+        c=_mm256_mullo_epi64(_mm256_xor_si256(c,_mm256_loadu_si256((const __m256i *)(p+64))),prime);
+        d=_mm256_mullo_epi64(_mm256_xor_si256(d,_mm256_loadu_si256((const __m256i *)(p+96))),prime);
+        a=_mm256_xor_si256(a,_mm256_srli_epi64(a,31));
+        b=_mm256_xor_si256(b,_mm256_srli_epi64(b,31));
+        c=_mm256_xor_si256(c,_mm256_srli_epi64(c,31));
+        d=_mm256_xor_si256(d,_mm256_srli_epi64(d,31));
+    }
+    _mm256_storeu_si256((__m256i *)v,a);_mm256_storeu_si256((__m256i *)(v+4),b);
+    _mm256_storeu_si256((__m256i *)(v+8),c);_mm256_storeu_si256((__m256i *)(v+12),d);
+}
+#endif
+
+#ifndef NV_HASH_NATIVE_MIN
+#define NV_HASH_NATIVE_MIN 1024u
+#endif
+static void hash_lanes_init(uint64_t v[16],uint64_t n)
+{
+    static const uint64_t k[4]={0x9E3779B97F4A7C15ull,0xC2B2AE3D27D4EB4Full,
+                                0x165667B19E3779F9ull,0x27D4EB2F165667C5ull};
+    unsigned i;
+    for(i=0;i<16;i++) v[i]=k[i&3]^((uint64_t)(i>>2)*0xD6E8FEB86659FD93ull);
+    v[3]^=n;
+}
+static void hash_blocks_scalar(uint64_t v[16],const uint8_t *p,size_t blocks)
+{
+    uint64_t w[16];
+    unsigned i;
+    for(;blocks;--blocks,p+=128) {
+        memcpy(w,p,128);
+        for(i=0;i<16;i++){v[i]=(v[i]^w[i])*NV_HASH_PRIME;v[i]^=v[i]>>31;}
+    }
+}
+/* n bytes after the full 128-byte blocks: 32-byte blocks, then bytes. */
+static void hash_tail(uint64_t v[16],const uint8_t *p,size_t n)
+{
+    uint64_t w[4];
+    unsigned i;
+    for(;n>=32;n-=32,p+=32) {
+        memcpy(w,p,32);
+        for(i=0;i<4;i++){v[i]=(v[i]^w[i])*NV_HASH_PRIME;v[i]^=v[i]>>31;}
+    }
+    for(;n;--n,++p) v[0]=(v[0]^*p)*NV_HASH_PRIME;
+}
+static uint64_t hash_fold(const uint64_t v[16])
+{
+    uint64_t h=0;
+    unsigned i;
+    for(i=0;i<16;i++){h=(h^v[i])*0x9E3779B97F4A7C15ull;h^=h>>32;}
+    return h;
+}
+static void hash_blocks(uint64_t v[16],const uint8_t *p,size_t blocks,int native)
+{
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    if(native){hash_blocks_native(v,p,blocks);return;}
+#endif
+    (void)native;
+    hash_blocks_scalar(v,p,blocks);
+}
+static int hash_use_native(size_t total)
+{
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    return total>=NV_HASH_NATIVE_MIN && hash_mem_native_available();
+#else
+    (void)total;
+    return 0;
+#endif
+}
+static uint64_t hash_mem(const uint8_t *p,size_t n)
+{
+    uint64_t v[16];
+    hash_lanes_init(v,n);
+    hash_blocks(v,p,n/128,hash_use_native(n));
+    hash_tail(v,p+n/128*128,n%128);
+    return hash_fold(v);
+}
+/* rows rows of rowb bytes, pitch bytes apart. */
+static uint64_t hash_rows(const uint8_t *p,size_t pitch,size_t rowb,size_t rows)
+{
+    uint64_t v[16];
+    int native=hash_use_native(rowb*rows);
+    hash_lanes_init(v,(uint64_t)rowb*rows);
+    for(;rows;--rows,p+=pitch) {
+        hash_blocks(v,p,rowb/128,native);
+        hash_tail(v,p+rowb/128*128,rowb%128);
+    }
+    return hash_fold(v);
+}
+#endif
diff --git a/src/video/nv2a_world_tris.h b/src/video/nv2a_world_tris.h
new file mode 100644
index 0000000..22e65bd
--- /dev/null
+++ b/src/video/nv2a_world_tris.h
@@ -0,0 +1,278 @@
+/* World-space triangles a title adds to its scene (MM3's triangle exhaust).
+ * Included after nv2a_distance_fog.h, which supplies the binding helpers.
+ *
+ * The title thread publishes each frame's triangles into a host ring
+ * (nv2a_d3d_world_tris_publish) and names the batch in an ordered no-op
+ * packet with its camera (NV2A_HOST_TRIS_*). The executor holds that packet
+ * until the frame's first pre-transformed 2D draw that is not stencil
+ * tested -- the name tags and HUD follow the whole 3D scene, cars,
+ * particles and the stencil quads that darken shadows included -- and draws
+ * the batch there: alpha blended over the scene target, fading out over its
+ * last 0.25 m in front of the scene's stored W depth (read the way the fog
+ * pass reads it), so soft geometry meets the ground and walls without a hard
+ * edge. A frame without such 2D drops its batch. */
+static const char s_world_tris_hlsl[] =
+"cbuffer Tris : register(b0) { float4 view[3]; float4 proj; float4 band; };\n"
+"struct VI { float3 p : POSITION; float4 c : COLOR; };\n"
+"struct VO { float4 pos : SV_Position; float4 c : COLOR; float z : TEXCOORD0; };\n"
+"VO tris_vs(VI i) {\n"
+"  VO o; float4 w = float4(i.p, 1);\n"
+"  float3 v = float3(dot(w, view[0]), dot(w, view[1]), dot(w, view[2]));\n"
+"  o.pos = float4(v.x * proj.x + v.z * proj.z, v.y * proj.y + v.z * proj.w, 0.5 * v.z, v.z);\n"
+"  o.c = i.c; o.z = v.z;\n"
+"  return o;\n"
+"}\n"
+"#if TRIS_MSAA\n"
+"Texture2DMS<float> Depth : register(t0);\n"
+"#else\n"
+"Texture2D<float> Depth : register(t0);\n"
+"#endif\n"
+"float4 tris_ps(VO i, uint sample : SV_SampleIndex) : SV_Target {\n"
+"#if TRIS_MSAA\n"
+"  float z = Depth.Load(int2(i.pos.xy), sample);\n"
+"#else\n"
+"  float z = Depth.Load(int3(int2(i.pos.xy), 0));\n"
+"#endif\n"
+"  float4 c = i.c;\n"
+"  if (z < 0.99999) c.a *= saturate((z * band.x - i.z + band.y) * band.z);\n"
+"  if (c.a <= 0.002) discard;\n"
+"  return c;\n"
+"}\n";
+
+typedef struct { float view[3][4], proj[4], band[4]; } WorldTrisConsts;
+enum { WORLD_TRIS_SLOTS = 8 };
+static struct {
+    uint32_t seq, count;
+    NvWorldVertex v[NV2A_WORLD_TRIS_MAX];
+} s_world_tris_ring[WORLD_TRIS_SLOTS];
+static SRWLOCK s_world_tris_lock = SRWLOCK_INIT;
+static struct {
+    int valid;
+    uint32_t seq;
+    NvD3DState st;
+    WorldTrisConsts c;
+} s_world_tris_pending;
+static ID3D11VertexShader *s_world_tris_vs;
+static ID3D11PixelShader *s_world_tris_ps[2];
+static ID3D11InputLayout *s_world_tris_layout;
+static ID3D11Buffer *s_world_tris_cb, *s_world_tris_vb;
+static ID3D11BlendState *s_world_tris_blend;
+static ID3D11RasterizerState *s_world_tris_raster;
+static ID3D11DepthStencilState *s_world_tris_depth;
+static int s_world_tris_state; /* 0 not tried, 1 ready, -1 failed */
+
+void nv2a_d3d_world_tris_publish(uint32_t seq, const NvWorldVertex *v, uint32_t count)
+{
+    uint32_t slot = seq % WORLD_TRIS_SLOTS;
+    if (count > NV2A_WORLD_TRIS_MAX) count = NV2A_WORLD_TRIS_MAX;
+    count -= count % 3u;
+    AcquireSRWLockExclusive(&s_world_tris_lock);
+    if (count) memcpy(s_world_tris_ring[slot].v, v, count * sizeof *v);
+    s_world_tris_ring[slot].count = count;
+    s_world_tris_ring[slot].seq = seq;
+    ReleaseSRWLockExclusive(&s_world_tris_lock);
+}
+
+static ID3DBlob *world_tris_compile(const char *entry, const char *target, int msaa)
+{
+    D3D_SHADER_MACRO macros[] = {{"TRIS_MSAA", msaa ? "1" : "0"}, {NULL, NULL}};
+    ID3DBlob *code = NULL, *error = NULL;
+    HRESULT hr = nv_shader_cache_compile(s_world_tris_hlsl, sizeof s_world_tris_hlsl - 1,
+        "world_tris", macros, entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &error, NULL);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[TRIS] %s: %s\n", entry,
+                error ? (const char *)ID3D10Blob_GetBufferPointer(error) : "compile failed");
+        if (code) { ID3D10Blob_Release(code); code = NULL; }
+    }
+    if (error) ID3D10Blob_Release(error);
+    return code;
+}
+
+static int world_tris_init(void)
+{
+    static const D3D11_INPUT_ELEMENT_DESC layout[] = {
+        {"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+        {"COLOR", 0, DXGI_FORMAT_R8G8B8A8_UNORM, 0, 12, D3D11_INPUT_PER_VERTEX_DATA, 0}};
+    D3D11_BUFFER_DESC cb = {sizeof(WorldTrisConsts), D3D11_USAGE_DYNAMIC,
+        D3D11_BIND_CONSTANT_BUFFER, D3D11_CPU_ACCESS_WRITE, 0, 0};
+    D3D11_BUFFER_DESC vb = {NV2A_WORLD_TRIS_MAX * sizeof(NvWorldVertex), D3D11_USAGE_DYNAMIC,
+        D3D11_BIND_VERTEX_BUFFER, D3D11_CPU_ACCESS_WRITE, 0, 0};
+    D3D11_BLEND_DESC blend = {0};
+    D3D11_DEPTH_STENCIL_DESC depth = {0};
+    D3D11_RASTERIZER_DESC raster = {0};
+    ID3DBlob *code;
+    unsigned i;
+    if (s_world_tris_state) return s_world_tris_state > 0;
+    s_world_tris_state = -1;
+    code = world_tris_compile("tris_vs", "vs_5_0", 0);
+    if (!code) return 0;
+    if (FAILED(ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(code),
+            ID3D10Blob_GetBufferSize(code), NULL, &s_world_tris_vs)) ||
+        FAILED(ID3D11Device_CreateInputLayout(s_dev, layout, 2, ID3D10Blob_GetBufferPointer(code),
+            ID3D10Blob_GetBufferSize(code), &s_world_tris_layout))) {
+        ID3D10Blob_Release(code);
+        return 0;
+    }
+    ID3D10Blob_Release(code);
+    for (i = 0; i < 2; ++i) {
+        code = world_tris_compile("tris_ps", "ps_5_0", i != 0);
+        if (!code) return 0;
+        if (FAILED(ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(code),
+                ID3D10Blob_GetBufferSize(code), NULL, &s_world_tris_ps[i]))) {
+            ID3D10Blob_Release(code);
+            return 0;
+        }
+        ID3D10Blob_Release(code);
+    }
+    /* Colour over the scene; the target's alpha (read by later passes) kept. */
+    blend.RenderTarget[0].BlendEnable = TRUE;
+    blend.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
+    blend.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+    blend.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ZERO;
+    blend.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+    blend.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    blend.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    if (FAILED(ID3D11Device_CreateBuffer(s_dev, &cb, NULL, &s_world_tris_cb)) ||
+        FAILED(ID3D11Device_CreateBuffer(s_dev, &vb, NULL, &s_world_tris_vb)) ||
+        FAILED(ID3D11Device_CreateBlendState(s_dev, &blend, &s_world_tris_blend)))
+        return 0;
+    /* Depth is compared in the pixel shader: no test, no write. Triangles
+     * spin, so both faces show. */
+    depth.DepthFunc = D3D11_COMPARISON_ALWAYS;
+    raster.FillMode = D3D11_FILL_SOLID;
+    raster.CullMode = D3D11_CULL_NONE;
+    raster.ScissorEnable = raster.DepthClipEnable = raster.MultisampleEnable = TRUE;
+    if (FAILED(ID3D11Device_CreateDepthStencilState(s_dev, &depth, &s_world_tris_depth)) ||
+        FAILED(ID3D11Device_CreateRasterizerState(s_dev, &raster, &s_world_tris_raster)))
+        return 0;
+    s_world_tris_state = 1;
+    return 1;
+}
+
+/* Executor thread: the packet. Its camera and target are those of the fog
+ * pass beside it; a second camera in one frame (split screen) draws the
+ * first batch at once. */
+static void world_tris_draw(void);
+void nv2a_d3d_world_tris(const NvD3DState *st, uint32_t seq, float depth_to_world,
+                         const float view[12], const float proj[4])
+{
+    WorldTrisConsts c = {0};
+    unsigned i;
+    if (!st || !isfinite(depth_to_world) || depth_to_world <= 0) return;
+    for (i = 0; i < 12; ++i) if (!isfinite(view[i]) || fabsf(view[i]) > 1.0e7f) return;
+    for (i = 0; i < 4; ++i) if (!isfinite(proj[i]) || fabsf(proj[i]) > 1.0e4f) return;
+    if (s_world_tris_pending.valid) world_tris_draw();
+    /* Rows of the title's world-to-camera matrix (row vectors) -> columns. */
+    for (i = 0; i < 3; ++i) {
+        c.view[i][0] = view[i];
+        c.view[i][1] = view[3 + i];
+        c.view[i][2] = view[6 + i];
+        c.view[i][3] = view[9 + i];
+    }
+    memcpy(c.proj, proj, sizeof c.proj);
+    c.band[0] = depth_to_world * (((st->surface_format >> 4) & 15u) == 1 ? 65536.f : 16777216.f);
+    c.band[1] = 0.02f;                        /* metres: surfaces it lies on */
+    c.band[2] = 4.0f;                         /* fades over 0.25 m */
+    if (!isfinite(c.band[0])) return;
+    s_world_tris_pending.st = *st;
+    s_world_tris_pending.c = c;
+    s_world_tris_pending.seq = seq;
+    s_world_tris_pending.valid = 1;
+}
+
+static void world_tris_draw(void)
+{
+    Surface *surface = NULL;
+    Depth *depth_buffer = NULL;
+    NvD3DState camera;
+    uint32_t gw, gh, viewport[4], count = 0, slot = s_world_tris_pending.seq % WORLD_TRIS_SLOTS;
+    D3D11_MAPPED_SUBRESOURCE m;
+    D3D11_VIEWPORT vp;
+    UINT stride = sizeof(NvWorldVertex), offset = 0;
+    ID3D11Buffer *none = NULL;
+    static int logged;
+    s_world_tris_pending.valid = 0;
+    AcquireSRWLockShared(&s_world_tris_lock);
+    if (s_world_tris_ring[slot].seq == s_world_tris_pending.seq) count = s_world_tris_ring[slot].count;
+    ReleaseSRWLockShared(&s_world_tris_lock);
+    if (!count || !world_tris_init()) return;
+    if (!bind_targets(&s_world_tris_pending.st, 1, &surface, &depth_buffer, &gw, &gh) || !surface ||
+        !depth_buffer || !depth_buffer->zsrv || surface->iw != depth_buffer->iw ||
+        surface->ih != depth_buffer->ih || (!!surface->ms != (depth_buffer->samples > 1))) return;
+    /* The camera's viewport, as the fog pass finds it (split-screen region). */
+    camera = s_world_tris_pending.st;
+    camera.wclip_mask = !(camera.wclip_type & 1u) ? camera.wclip_mask & 1u : 0;
+    camera.wclip_type = 0;
+    window_clip_bounds(&camera, gw, gh, viewport);
+    vp.TopLeftX = viewport[0] * s_aa_x * s_cur_sx;
+    vp.TopLeftY = viewport[1] * s_aa_y * s_cur_sy;
+    vp.Width = (viewport[2] - viewport[0]) * s_aa_x * s_cur_sx;
+    vp.Height = (viewport[3] - viewport[1]) * s_aa_y * s_cur_sy;
+    vp.MinDepth = 0; vp.MaxDepth = 1;
+    if (!(vp.Width > 0) || !(vp.Height > 0)) return;
+    if (!upload_cb(s_world_tris_cb, &s_world_tris_pending.c, sizeof s_world_tris_pending.c)) return;
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_world_tris_vb, 0,
+                                       D3D11_MAP_WRITE_DISCARD, 0, &m))) return;
+    AcquireSRWLockShared(&s_world_tris_lock);
+    if (s_world_tris_ring[slot].seq != s_world_tris_pending.seq) count = 0;
+    else {
+        if (count > s_world_tris_ring[slot].count) count = s_world_tris_ring[slot].count;
+        memcpy(m.pData, s_world_tris_ring[slot].v, count * sizeof(NvWorldVertex));
+    }
+    ReleaseSRWLockShared(&s_world_tris_lock);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_world_tris_vb, 0);
+    if (!count) return;
+    unbind_textures();
+    unbind_targets();
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &surface->rtv, NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    apply_scissor(&s_world_tris_pending.st, gw, gh);
+    bind_rasterizer_state(s_world_tris_raster);
+    bind_depth_stencil_state(s_world_tris_depth, 0);
+    bind_blend_state(s_world_tris_blend, NULL, 0xFFFFFFFFu);
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, s_world_tris_layout);
+    ID3D11DeviceContext_IASetVertexBuffers(s_ctx, 0, 1, &s_world_tris_vb, &stride, &offset);
+    bind_primitive_topology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    bind_vertex_shader(s_world_tris_vs);
+    bind_vertex_constants(s_world_tris_cb);
+    bind_pixel_shader(s_world_tris_ps[depth_buffer->samples > 1]);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_world_tris_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &depth_buffer->zsrv);
+    ID3D11DeviceContext_Draw(s_ctx, count, 0);
+    /* Every other draw pulls its vertices without an input layout. */
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, NULL);
+    ID3D11DeviceContext_IASetVertexBuffers(s_ctx, 0, 1, &none, &stride, &offset);
+    unbind_textures();
+    unbind_targets();
+    surface->gpu_dirty = 1; surface->ms_dirty = surface->ms != NULL; ++surface->gen;
+    if (!logged) {
+        logged = 1;
+        fprintf(stderr, "[TRIS] first world triangle batch: %u vertices on %ux%u (samples %u)\n",
+                count, surface->iw, surface->ih, depth_buffer->samples);
+    }
+}
+
+/* Pre-transformed 2D (w == 1 everywhere) after the packet: the 3D scene is
+ * complete. */
+static void world_tris_before_2d(const NvD3DState *st, const uint32_t *idx, uint32_t ni, uint32_t lo,
+                                 const float (*pos)[4])
+{
+    uint32_t k;
+    /* MM3 darkens shadows with stencil-tested full-screen quads after the
+     * scene: the batch goes over them, not under. (The HUD keeps the test on
+     * with an always-passing function.) */
+    if (!s_world_tris_pending.valid || !pos ||
+        (st->stencil_test && cmp(st->stencil_func) != D3D11_COMPARISON_ALWAYS)) return;
+    for (k = 0; k < ni; ++k)
+        if (pos[idx[k] - lo][3] != 1.0f) return;
+    world_tris_draw();
+}
+
+static void world_tris_frame_end(void)
+{
+    static unsigned dropped;
+    if (s_world_tris_pending.valid && ++dropped == 120u)
+        fprintf(stderr, "[TRIS] 120 batches dropped: no 2D draw followed them in their frame\n");
+    s_world_tris_pending.valid = 0;
+}
