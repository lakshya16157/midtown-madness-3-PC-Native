+static void map_routes(float aspect, float scale, Result base, float base_x) {
+    float p[12][4], narrow = (4.0f / 3.0f) / aspect;
+    const uint32_t idx[18] = {0,1,2,0,2,3,4,5,6,4,6,7,8,9,10,8,10,11};
+    Result r;
+    int x, i, textured, old_n = s_hud_tex_n;
+    uint32_t old_tex[32];
+    memcpy(old_tex, s_hud_tex, sizeof old_tex);
+    /* The real native batch contains compact short UVs. Exercise nonzero
+     * index bases, route vertices at both edges, and a midpoint crossing. */
+    tag_route(17, 4);
+    for (x = -20; x <= 660; x += 10) {
+        r = box((float)x, (float)x + 16, 180, 196, aspect, scale, 1, 0, 701);
+        near(r.x[0], base.x[0] + ((float)x - base_x) * narrow);
+        near(r.x[1], r.x[0] + 16 * narrow);
+        near(r.y[0], 180 + base.y_offset); near(r.y[2], 196 + base.y_offset);
+    }
+    tag_route(17, 4);
+    r = box(0, 640, 180, 184, aspect, scale, 0, 0, 0);
+    near(r.x[0], base.x[0] - base_x * narrow);
+    near(r.x[1], r.x[0] + 640 * narrow);
+    near(r.y[0], 180 + base.y_offset); near(r.y[2], 184 + base.y_offset);
+    assert(s_hud_tex_n == old_n && !memcmp(old_tex, s_hud_tex, sizeof old_tex));
