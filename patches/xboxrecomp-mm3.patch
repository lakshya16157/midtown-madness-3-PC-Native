+    swprintf_s(copy, MAX_PATH, L"%s\\frontend.wma", folder);
+    CHECK(CopyFileW(path, copy, TRUE));
+    CHECK(open_asset("D:\\frontend.wma", NULL, 0x80100080u, 1, 0x4Cu, &h) == STATUS_SUCCESS);
+    CHECK((mode(h) & 8) == expected_mode && !read_contract(h, buffer, expected));
+    writer = CreateFileW(copy, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        NULL, OPEN_EXISTING, 0, NULL);
