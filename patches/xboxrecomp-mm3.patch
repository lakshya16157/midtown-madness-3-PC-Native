+static int test_poll_runtime(void)
+{
+    Surface *s = new_surface(0, 4, 16, 16, 16);
+    HANDLE publisher;
+    DWORD accepted;
+    unsigned before;
+    CHECK(s); draw_color(s, 0);
+    inspect = mock_clock = allow_blocking_maps = 1; reset_counts();
+    CHECK(nv2a_d3d_get_readback_poll_us() == -1);
+    CHECK(!nv2a_d3d_set_readback_poll_us(-1) && !nv2a_d3d_set_readback_poll_us(1001));
+    CHECK(nv2a_d3d_set_readback_poll_us(0)); /* Overrides startup environment. */
+    CHECK(nv2a_d3d_get_readback_poll_us() == -1);
+    writeback_surfaces();
+    CHECK(nv2a_d3d_get_readback_poll_us() == 0 && !s_wb_poll_ticks && !frequency_calls);
+    hold_query = 1;
+    CHECK(nv2a_d3d_writeback_busy() && nv2a_d3d_writeback_busy());
+    CHECK(queries == 2 && !clock_calls && !maps);
+
+    /* A control thread publishes only the request. The active batch keeps its
+     * old policy until the renderer completes it and starts another batch. */
+    publisher = CreateThread(NULL, 0, publish_poll_request, (void *)(INT_PTR)250, 0, NULL);
+    CHECK(publisher && WaitForSingleObject(publisher, 5000) == WAIT_OBJECT_0);
+    CHECK(GetExitCodeThread(publisher, &accepted) && accepted == 1); CloseHandle(publisher);
+    CHECK(nv2a_d3d_get_readback_poll_us() == 0 && !s_wb_poll_ticks && !frequency_calls);
+    CHECK(nv2a_d3d_writeback_busy() && queries == 3 && !clock_calls);
+    draw_color(s, 1); hold_query = 0; writeback_surfaces();
+    CHECK(nv2a_d3d_get_readback_poll_us() == 250 && s_wb_poll_ticks == 250);
+    CHECK(frequency_calls == 1 && !s_wb_poll_last_valid && !pixels_match(s, 0, 0));
+    hold_query = 1;
+    CHECK(nv2a_d3d_writeback_busy() && queries == 4);
+    CHECK(nv2a_d3d_writeback_busy() && queries == 4 && maps == 1);
