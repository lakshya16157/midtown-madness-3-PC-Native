+    CHECK(open_asset("D:\\frontend.wma", NULL, 0x80100080u, 1, 0x4Cu, &h) == STATUS_SHARING_VIOLATION && !h);
+    memset(expected, 0x6C, 65536);
+    CHECK(WriteFile(writer, expected, 65536, &count, NULL) && count == 65536 && FlushFileBuffers(writer));
+    CHECK(CloseHandle(writer)); writer = INVALID_HANDLE_VALUE;
+    CHECK(open_asset("D:\\frontend.wma", NULL, 0x80100080u, 1, 0x4Cu, &h) == STATUS_SUCCESS && !read_contract(h, buffer, expected));
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    /* WRITE_THROUGH remains excluded even when combined with the new hint. */
+    CHECK(open_asset("D:\\frontend.wma", NULL, 0x80100080u, 1, 0x4Eu, &h) == STATUS_SUCCESS && (mode(h) & 8));
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    CHECK(open_asset("z:\\asset.bin", NULL, ACCESS, 0, OPTIONS, &h) == STATUS_SUCCESS && (mode(h) & 8) == expected_mode);
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
