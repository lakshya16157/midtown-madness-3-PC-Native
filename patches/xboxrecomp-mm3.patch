+/* A locally administered console identity. Port is part of the seed so two
+ * instances on one host differ without querying a physical adapter. */
+static int net_hex(unsigned char ch)
+{
+    if (ch >= '0' && ch <= '9') return ch - '0';
+    if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+    if (ch >= 'A' && ch <= 'F') return ch - 'A' + 10;
+    return -1;
+}
+
+static int net_console_mac(UCHAR mac[6])
+{
+    const char *override = getenv("RECOMP_NET_MAC");
+    if (override && *override) {
+        size_t length = strlen(override);
+        int separated = length == 17;
+        unsigned nonzero = 0;
+        if (!separated && length != 12) return 0;
+        for (unsigned i = 0; i < 6; ++i) {
+            size_t offset = separated ? i * 3u : i * 2u;
+            int high = net_hex((unsigned char)override[offset]);
+            int low = net_hex((unsigned char)override[offset + 1]);
+            if (high < 0 || low < 0) return 0;
+            if (separated && i < 5 &&
+                ((override[2] != ':' && override[2] != '-') || override[offset + 2] != override[2]))
+                return 0;
+            mac[i] = (UCHAR)((high << 4) | low);
+            nonzero |= mac[i];
+        }
+        return nonzero && !(mac[0] & 1u); /* no zero/multicast/broadcast address */
+    }
+    char name[256] = "xboxrecomp";
+    const char *port = getenv("RECOMP_NET_PORT");
+    uint32_t hash = 2166136261u;
+#if defined(_WIN32)
+    DWORD length = sizeof name;
+    GetComputerNameA(name, &length);
+#else
+    const char *host = getenv("HOSTNAME");
+    if (host && strlen(host) < sizeof name) strcpy(name, host);
+#endif
+    for (const unsigned char *at = (const unsigned char *)name; *at; ++at)
+        hash = (hash ^ *at) * 16777619u;
+    for (const unsigned char *at = (const unsigned char *)(port && *port ? port : "3075"); *at; ++at)
+        hash = (hash ^ *at) * 16777619u;
+    mac[0] = 0x02; mac[1] = 0x58;
+    mac[2] = (UCHAR)(hash >> 24); mac[3] = (UCHAR)(hash >> 16);
+    mac[4] = (UCHAR)(hash >> 8); mac[5] = (UCHAR)hash;
+    return 1;
+}
