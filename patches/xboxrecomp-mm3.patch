+/* Force the production table's full-cache eviction branch on its bound
+ * object, using real COM references for the other occupied table entries. */
+static void evict_pipeline_state(StateSlot *table, void *bound)
+{
+    unsigned i,index=STATE_SLOTS; uint64_t key=0x100000000ull;
+    for(i=0;i<STATE_SLOTS;i++) if(table[i].obj==bound) { index=i; break; }
+    CHECK(index<STATE_SLOTS);
+    for(i=0;i<STATE_SLOTS;i++) if(i!=index) {
+        if(table[i].obj) IUnknown_Release((IUnknown *)table[i].obj);
+        table[i].key=0x200000000ull+i; table[i].obj=s_linear_clamp;
+        ID3D11SamplerState_AddRef(s_linear_clamp);
+    }
+    while((((uint32_t)(key^(key>>29)^(key>>47))*2654435761u)&(STATE_SLOTS-1))!=index ||
+           key==table[index].key) key++;
+    CHECK(state_slot(table,key)==&table[index].obj && !table[index].obj);
+    for(i=0;i<STATE_SLOTS;i++) if(i!=index) {
+        IUnknown_Release((IUnknown *)table[i].obj); table[i].obj=NULL;
+    }
+}
