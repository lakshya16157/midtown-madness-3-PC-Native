+# Loading compositor GPU contracts
+
+The fixture includes the production renderer and compiles its actual HLSL on
+the selected D3D11 adapter. Synthetic framebuffer and movie textures require no
+game assets or saved display configuration. It opens no visible window.
+
+- `arc`: two phases at 1280x720, 640x360 and a letterboxed 720x720 display
+  differ only inside the independently bounded, scaled corner annulus;
+  the rest of the frozen frame, black bars and every alpha channel remain identical.
+- `capture`: internal-resolution capture remains pixel-identical while a
+  loading phase is active.
+- `portrait_movie`: an independently checked four-band 4:3 movie fits a portrait
+  display without stretching or displaced vertical placement. Movie output also
+  remains identical if a loading phase was selected before the movie appeared.
+
+After activating the repository's portable toolchain, configure this directory
+with CMake/Ninja in a temporary build folder, build it, then run CTest with
+`--output-on-failure`. Loading activation, timing, failed presentations and guest
+frame accounting belong to `tests/mm3_present_pacing_contract.py`.
diff --git a/tests/nv2a_loading/test_loading.c b/tests/nv2a_loading/test_loading.c
new file mode 100644
index 0000000..df20691
--- /dev/null
+++ b/tests/nv2a_loading/test_loading.c
@@ -0,0 +1,234 @@
+/* The production compositor and HLSL run on the real D3D11 device. Private
+ * textures replace only the game's framebuffer/movie sources; no swap chain,
+ * game files, waits, or saved display settings are needed. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x100000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch)
+{ (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ (void)version; return NULL; }
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); \
+} } while (0)
+#define BACKGROUND 0xFF182A3Cu
+
+static const uint32_t movie_bands[4] = {
+    0xFFCC2211u, 0xFF22BB33u, 0xFF2233CCu, 0xFFDDCC22u
+};
+
+static ID3D11Texture2D *solid_texture(UINT width, UINT height, uint32_t colour)
+{
+    ID3D11Texture2D *texture;
+    uint32_t *pixels = malloc((size_t)width * height * sizeof *pixels);
+    size_t i;
+    CHECK(pixels);
+    for (i = 0; i < (size_t)width * height; ++i) pixels[i] = colour;
+    texture = make_texture(width, height, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM,
+                           D3D11_BIND_SHADER_RESOURCE, 0);
+    CHECK(texture);
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)texture,
+                                        0, NULL, pixels, width * 4, 0);
+    free(pixels);
+    return texture;
+}
+
+static Surface source_surface(float aspect)
+{
+    Surface source = {0};
+    source.w = 640; source.h = 480;
+    source.sx = aspect * .75f; source.sy = 1.f;
+    source.iw = (UINT)(source.w * source.sx + .5f); source.ih = 480;
+    source.tex = solid_texture(source.iw, source.ih, BACKGROUND);
+    CHECK(SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev,
+        (ID3D11Resource *)source.tex, NULL, &source.srv)));
+    return source;
+}
+
+static void release_source(Surface *source)
+{
+    ID3D11ShaderResourceView_Release(source->srv);
+    ID3D11Texture2D_Release(source->tex);
+}
+
+static void read_pixels(ID3D11Texture2D *texture, uint32_t *pixels)
+{
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC description;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    UINT y;
+    ID3D11Texture2D_GetDesc(texture, &description);
+    description.Usage = D3D11_USAGE_STAGING;
+    description.BindFlags = description.MiscFlags = 0;
+    description.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &description, NULL, &staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging,
+                                    (ID3D11Resource *)texture);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging,
+        0, D3D11_MAP_READ, 0, &mapped)));
+    for (y = 0; y < description.Height; ++y)
+        memcpy(pixels + (size_t)y * description.Width,
+               (const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch,
+               description.Width * sizeof *pixels);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    ID3D11Texture2D_Release(staging);
+}
+
+static void render(Surface *source, UINT width, UINT height, float phase,
+                   int window, int movie, uint32_t *pixels)
+{
+    PresentConsts constants = {0};
+    ID3D11Texture2D *output = make_texture(width, height, 1, 1,
+        DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_BIND_RENDER_TARGET, 0);
+    ID3D11RenderTargetView *target = NULL;
+    CHECK(output && SUCCEEDED(ID3D11Device_CreateRenderTargetView(s_dev,
+        (ID3D11Resource *)output, NULL, &target)));
+    if (movie) {
+        constants.ovl_flags[0] = 1;
+        constants.ovl_out[2] = constants.ovl_in[0] = 640;
+        constants.ovl_out[3] = constants.ovl_in[1] = 480;
+        constants.ovl_walk[2] = constants.ovl_walk[3] = 1;
+        constants.ovl_in[2] = 1;
+    }
+    s_loading_phase = phase;
+    composite(target, width, height, source, &constants, window);
+    read_pixels(output, pixels);
+    ID3D11RenderTargetView_Release(target);
+    ID3D11Texture2D_Release(output);
+    s_loading_phase = 0;
+}
+
+static void test_arc(void)
+{
+    static const UINT sizes[][2] = {{1280, 720}, {640, 360}, {720, 720}};
+    Surface source = source_surface(16.f / 9.f);
+    unsigned size;
+    s_aspect = 16.f / 9.f;
+    for (size = 0; size < sizeof sizes / sizeof sizes[0]; ++size) {
+        UINT width = sizes[size][0], height = sizes[size][1], x, y;
+        size_t bytes = (size_t)width * height * 4;
+        uint32_t *still = malloc(bytes), *first = malloc(bytes), *second = malloc(bytes);
+        unsigned changed = 0, rotated = 0;
+        /* Independent image-fit geometry, not renderer state/constants. The
+         * third target has black bars above/below the frozen widescreen image. */
+        double image_height = fmin((double)height, width * 9. / 16.);
+        double image_bottom = (height + image_height) * .5;
+        double scale = fmax(.25, image_height / 720.);
+        double center_x = width - 40. * scale;
+        double center_y = image_bottom - 40. * scale;
+        CHECK(still && first && second);
+        render(&source, width, height, 0, 1, 0, still);
+        render(&source, width, height, .2f, 1, 0, first);
+        render(&source, width, height, .7f, 1, 0, second);
+        for (y = 0; y < height; ++y) for (x = 0; x < width; ++x) {
+            size_t i = (size_t)y * width + x;
+            CHECK(still[i] == BACKGROUND || still[i] == 0xFF000000u);
+            CHECK((first[i] >> 24) == 255 && (second[i] >> 24) == 255);
+            if (first[i] != still[i] || second[i] != still[i]) {
+                double radius = hypot((x + .5) - center_x, (y + .5) - center_y);
+                CHECK(still[i] == BACKGROUND);
+                CHECK(fabs(radius - 13. * scale) < 2. * scale + .001);
+                CHECK(x >= width - 64. * scale && y >= image_bottom - 64. * scale);
+                ++changed;
+            }
+            if (first[i] != second[i]) ++rotated;
+        }
+        CHECK(changed > 15 && rotated > 15);
+        free(second); free(first); free(still);
+    }
+    release_source(&source);
+    puts("PASS: real GPU loading arc rotates at two scales and a letterboxed image, changes only its independently bounded 13-pixel-radius corner annulus and preserves alpha, black bars and the frozen image");
+}
+
+static void test_capture(void)
+{
+    Surface source = source_surface(16.f / 9.f);
+    size_t count = (size_t)source.iw * source.ih, i;
+    uint32_t *inactive = malloc(count * 4), *active = malloc(count * 4);
+    CHECK(inactive && active);
+    s_aspect = 16.f / 9.f;
+    render(&source, source.iw, source.ih, 0, 0, 0, inactive);
+    render(&source, source.iw, source.ih, .4f, 0, 0, active);
+    CHECK(!memcmp(inactive, active, count * 4));
+    for (i = 0; i < count; ++i) CHECK(active[i] == BACKGROUND);
+    free(active); free(inactive);
+    release_source(&source);
+    puts("PASS: internal-resolution capture has identical GPU pixels with the loading phase active or inactive");
+}
+
+static void make_movie(void)
+{
+    uint32_t *pixels = malloc(640 * 480 * sizeof *pixels);
+    unsigned x, y;
+    CHECK(pixels);
+    for (y = 0; y < 480; ++y) for (x = 0; x < 640; ++x)
+        pixels[y * 640 + x] = movie_bands[y / 120];
+    s_ovl_tex = make_texture(640, 480, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM,
+                             D3D11_BIND_SHADER_RESOURCE, 0);
+    CHECK(s_ovl_tex && SUCCEEDED(ID3D11Device_CreateShaderResourceView(s_dev,
+        (ID3D11Resource *)s_ovl_tex, NULL, &s_ovl_srv)));
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)s_ovl_tex,
+                                        0, NULL, pixels, 640 * 4, 0);
+    free(pixels);
+}
+
+static void test_portrait_movie(void)
+{
+    const UINT width = 540, height = 720;
+    const double movie_height = width * .75;
+    const double movie_top = (height - movie_height) * .5;
+    Surface source = source_surface(.75f);
+    size_t count = (size_t)width * height;
+    uint32_t *inactive = malloc(count * 4), *active = malloc(count * 4);
+    UINT x, y;
+    unsigned checked = 0;
+    CHECK(inactive && active);
+    make_movie(); s_aspect = .75f;
+    render(&source, width, height, 0, 1, 1, inactive);
+    /* A late movie activation must also suppress an already selected phase. */
+    render(&source, width, height, .6f, 1, 1, active);
+    CHECK(!memcmp(inactive, active, count * 4));
+    for (y = 0; y < height; y += 3) for (x = 0; x < width; x += 7) {
+        double authored_y = ((y + .5) - movie_top) * 480. / movie_height;
+        uint32_t expected;
+        /* Exclude only one row about band/outer boundaries, where bilinear
+         * filtering legitimately mixes adjacent colors. The oracle uses the
+         * authored image aspect, independently of renderer constants. */
+        double boundary = authored_y / 120.;
+        if (fabs(boundary - round(boundary)) < .02) continue;
+        expected = authored_y < 0 || authored_y >= 480 ? BACKGROUND
+                 : movie_bands[(unsigned)authored_y / 120];
+        CHECK(active[(size_t)y * width + x] == expected);
+        ++checked;
+    }
+    CHECK(checked > 1000);
+    free(active); free(inactive);
+    ID3D11ShaderResourceView_Release(s_ovl_srv); s_ovl_srv = NULL;
+    ID3D11Texture2D_Release(s_ovl_tex); s_ovl_tex = NULL;
+    release_source(&source);
+    puts("PASS: real GPU portrait movie retains its centered authored 4:3 image, all four bands and untouched surrounding pixels, including a late active loading phase");
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    _putenv_s("RECOMP_MSAA", "1");
+    _putenv_s("RECOMP_RENDER_SCALE", "1");
+    _putenv_s("RECOMP_ASPECT", "4:3");
+    _putenv_s("RECOMP_PS_SPEC", "0");
+    _putenv_s("RECOMP_SHADER_CACHE", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    if (!strcmp(argv[1], "arc")) test_arc();
+    else if (!strcmp(argv[1], "capture")) test_capture();
+    else if (!strcmp(argv[1], "portrait_movie")) test_portrait_movie();
+    else CHECK(0);
+    return 0;
+}
