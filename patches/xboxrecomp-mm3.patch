+static unsigned main_direct_calls, main_indexed_calls, index_map_calls;
+static int index_reference, force_nonidentity;
+static int reference, pixel_reference, pipeline_reference, fail_map, fail_ps_map, fail_buffers;
+static void set_topology(ID3D11DeviceContext *, D3D11_PRIMITIVE_TOPOLOGY);
+static void set_rs(ID3D11DeviceContext *, ID3D11RasterizerState *);
+static void set_scissors(ID3D11DeviceContext *, UINT, const D3D11_RECT *);
+static void set_blend(ID3D11DeviceContext *, ID3D11BlendState *, const FLOAT *, UINT);
+static void set_depth(ID3D11DeviceContext *, ID3D11DepthStencilState *, UINT);
+static void set_vs(ID3D11DeviceContext *, ID3D11VertexShader *, ID3D11ClassInstance *const *, UINT);
+static void set_ps(ID3D11DeviceContext *, ID3D11PixelShader *, ID3D11ClassInstance *const *, UINT);
+static void set_ps_samplers(ID3D11DeviceContext *, UINT, UINT, ID3D11SamplerState *const *);
+static void set_vs_cb(ID3D11DeviceContext *, UINT, UINT, ID3D11Buffer *const *);
+static void set_vs_srv(ID3D11DeviceContext *, UINT, UINT, ID3D11ShaderResourceView *const *);
+static void set_ps_cb(ID3D11DeviceContext *, UINT, UINT, ID3D11Buffer *const *);
+static void set_layout(ID3D11DeviceContext *, ID3D11InputLayout *);
