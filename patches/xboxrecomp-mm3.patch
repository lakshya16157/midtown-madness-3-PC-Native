+static LARGE_INTEGER s_file_hitch_frequency;
+typedef NTSTATUS (NTAPI *XboxFileHitchQueryFile)(HANDLE,
+    PXBOX_IO_STATUS_BLOCK, PVOID, ULONG, ULONG);
