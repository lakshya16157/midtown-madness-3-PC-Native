diff --git a/src/video/nv2a_black_frame.h b/src/video/nv2a_black_frame.h
new file mode 100644
index 0000000..ba782e5
--- /dev/null
+++ b/src/video/nv2a_black_frame.h
@@ -0,0 +1,1167 @@
+/* Black- and odd-frame detector. Players see a couple of black, tunnel-dark
+ * or otherwise wrong frames now and then while driving, and nothing in the
+ * frame timings shows them. Every guest flip is also composited into a 64x40
+ * target, copied to a staging ring and read a few flips later without
+ * waiting. Reported with the time, what the renderer did in each frame around
+ * them, and 256x160 pictures of the frame before, the first bad one and the
+ * frame after, saved next to the frame CSV:
+ *   [BLACK_FRAME]  a short run of dark frames between normal ones;
+ *   [ODD_FRAME]    1..3 frames unlike both the frame before and the frame
+ *                  after while those two look alike (a stale, half-drawn or
+ *                  wrongly lit picture), a picture shown again (nearly)
+ *                  unchanged between moving ones (a stuck frame), or part of
+ *                  the picture changing for one frame only (a building,
+ *                  light or texture that vanished for a frame);
+ *   [LIGHT_FRAME]  a flip, or two, whose local-light pass (street lamps,
+ *                  car lights) was unlike the flips either side: lights
+ *                  missing or extra, the light buffer laid over the frame a
+ *                  different number of times, its blend changed, or the
+ *                  volumes drawn elsewhere (counted from the draws, so it
+ *                  sees what the pictures are too small to show).
+ * A minute's counts follow even when nothing was found. F9 saves the last
+ * 2.5 s of thumbnails as one picture plus a table of each flip, including
+ * its light pass and what the screen did with it (nv2a_display_stats.h),
+ * then the next 6 flips at 1280x800 for detail: [CAPTURE].
+ * Costs two tiny draws and one 10 KB copy per flip, and 26 MB of video
+ * memory for the thumbnails. RECOMP_BLACK_FRAME=0 turns it off.
+ *
+ * The statistics and the run detection have no D3D dependency; define
+ * NV2A_BLACK_FRAME_LOGIC_ONLY to compile just those (unit tests). */
+#ifndef NV2A_BLACK_FRAME_H
+#define NV2A_BLACK_FRAME_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+typedef struct {
+    float mean;                 /* luma 0..255 */
+    unsigned p98;               /* 98th percentile luma */
+    float bright;               /* fraction of samples above 40 */
+} BfStats;
+
+static void bf_stats(const uint8_t *bgra, unsigned w, unsigned h, size_t pitch, BfStats *out)
+{
+    uint32_t hist[256];
+    uint64_t sum = 0;
+    unsigned x, y, n = w * h, bright = 0, v, acc = 0;
+    memset(hist, 0, sizeof hist);
+    for (y = 0; y < h; y++) {
+        const uint8_t *p = bgra + (size_t)y * pitch;
+        for (x = 0; x < w; x++, p += 4) {
+            v = (p[2] * 54u + p[1] * 183u + p[0] * 19u) >> 8;
+            hist[v]++;
+            sum += v;
+            if (v > 40) bright++;
+        }
+    }
+    out->mean = n ? (float)sum / (float)n : 0.0f;
+    out->bright = n ? (float)bright / (float)n : 0.0f;
+    out->p98 = 0;
+    for (v = 0; v < 256; v++) {
+        acc += hist[v];
+        if ((uint64_t)acc * 50u >= (uint64_t)n * 49u) { out->p98 = v; break; }
+    }
+}
+
+/* A frame is dark when it is nearly black, or below 35% of the median of the
+ * last normal frames. Only runs of 1..BF_MAX_RUN dark frames that end in a
+ * frame back at 60% of that median count: fades, loading screens and tunnels
+ * last longer or come back gradually. */
+enum { BF_NORMAL, BF_RUN, BF_LONG, BF_MAX_RUN = 12, BF_RECENT = 8 };
+typedef struct {
+    int state;
+    float recent[BF_RECENT];
+    unsigned recent_n, recent_at;
+    uint32_t run_start, run_last;
+    unsigned run_len;
+    float run_base;
+} BfJudge;
+
+static float bf_baseline(const BfJudge *j)
+{
+    float v[BF_RECENT], t;
+    unsigned i, k, n = j->recent_n;
+    if (n < 4) return -1.0f;
+    memcpy(v, j->recent, n * sizeof *v);
+    for (i = 1; i < n; i++)
+        for (k = i; k > 0 && v[k - 1] > v[k]; k--) { t = v[k]; v[k] = v[k - 1]; v[k - 1] = t; }
+    return n & 1 ? v[n / 2] : 0.5f * (v[n / 2 - 1] + v[n / 2]);
+}
+
+static void bf_remember(BfJudge *j, float mean)
+{
+    j->recent[j->recent_at] = mean;
+    j->recent_at = (j->recent_at + 1) % BF_RECENT;
+    if (j->recent_n < BF_RECENT) j->recent_n++;
+}
+
+static int bf_dark(const BfStats *st, float base)
+{
+    if (st->mean < 4.0f && st->p98 < 24) return 1;
+    return base >= 16.0f && st->mean < 0.35f * base;
+}
+
+/* Feed frames in order (gaps allowed). Returns 1 when a short dark run has
+ * just ended, with its first and last frame and the baseline before it. */
+static int bf_feed(BfJudge *j, uint32_t frame, const BfStats *st,
+                   uint32_t *first, uint32_t *last, float *base)
+{
+    float b = j->state == BF_NORMAL ? bf_baseline(j) : j->run_base;
+    int dark = bf_dark(st, b);
+    switch (j->state) {
+    case BF_NORMAL:
+        if (dark && b >= 0.0f) {
+            j->state = BF_RUN;
+            j->run_start = j->run_last = frame;
+            j->run_len = 1;
+            j->run_base = b;
+        } else if (!dark) {
+            bf_remember(j, st->mean);
+        }
+        return 0;
+    case BF_RUN:
+        if (dark) {
+            j->run_last = frame;
+            if (++j->run_len > BF_MAX_RUN) j->state = BF_LONG;
+            return 0;
+        }
+        if (st->mean >= 0.6f * j->run_base) {
+            j->state = BF_NORMAL;
+            bf_remember(j, st->mean);
+            *first = j->run_start;
+            *last = j->run_last;
+            *base = j->run_base;
+            return 1;
+        }
+        /* Came back only part way: a fade or a darker place. */
+        /* fall through */
+    default:
+        /* After a long or gradual change, measure the new scene afresh. */
+        if (!bf_dark(st, -1.0f)) {
+            j->state = BF_NORMAL;
+            j->recent_n = j->recent_at = 0;
+            bf_remember(j, st->mean);
+        } else {
+            j->state = BF_LONG;
+        }
+        return 0;
+    }
+}
+
+/* What a frame looks like at a glance: the mean colour of 16x10 blocks. */
+enum { BF_SIG_W = 16, BF_SIG_H = 10, BF_SIG_BYTES = BF_SIG_W * BF_SIG_H * 3 };
+typedef struct { uint8_t c[BF_SIG_BYTES]; } BfSig;
+
+static void bf_signature(const uint8_t *bgra, unsigned w, unsigned h, size_t pitch, BfSig *out)
+{
+    unsigned bw = w / BF_SIG_W, bh = h / BF_SIG_H, n = bw * bh, bx, by, x, y;
+    memset(out, 0, sizeof *out);
+    if (!n) return;
+    for (by = 0; by < BF_SIG_H; by++)
+        for (bx = 0; bx < BF_SIG_W; bx++) {
+            unsigned b = 0, g = 0, r = 0;
+            uint8_t *c = out->c + (by * BF_SIG_W + bx) * 3;
+            for (y = 0; y < bh; y++) {
+                const uint8_t *p = bgra + (size_t)(by * bh + y) * pitch + (size_t)bx * bw * 4;
+                for (x = 0; x < bw; x++, p += 4) { b += p[0]; g += p[1]; r += p[2]; }
+            }
+            c[0] = (uint8_t)((b + n / 2) / n);
+            c[1] = (uint8_t)((g + n / 2) / n);
+            c[2] = (uint8_t)((r + n / 2) / n);
+        }
+}
+
+/* Mean absolute difference of two signatures, 0..255. */
+static float bf_sig_diff(const BfSig *a, const BfSig *b)
+{
+    unsigned i, sum = 0;
+    for (i = 0; i < BF_SIG_BYTES; i++)
+        sum += a->c[i] > b->c[i] ? (unsigned)(a->c[i] - b->c[i]) : (unsigned)(b->c[i] - a->c[i]);
+    return (float)sum / (float)BF_SIG_BYTES;
+}
+
+/* Frames that do not belong, judged against the scale of normal motion: the
+ * median change from one frame to the next over the last BF_MOTION_N frames
+ * (at least 0.5), so slow night streets and fast turns get their own scale.
+ * A run of 1..BF_ODD_MAX frames is odd when every frame in it is at least
+ * max(8, 4 x scale, 3 x the gap between the frames on either side) from both
+ * of those; camera cuts, even two in a row, stay below the last term. A
+ * repeat is a picture shown again for 1..BF_ODD_WIN-3 more flips, unchanged
+ * but for max(0.3, scale / 8) (the HUD may still move while the world holds),
+ * while the flip into it and the flip out of it both moved by
+ * max(0.8, scale / 2). A still scene (menus, pause) is never a repeat. */
+enum { BF_ODD_MAX = 3, BF_ODD_WIN = 8, BF_MOTION_N = 15 };
+enum { BF_ODD_NONE, BF_ODD_RUN, BF_ODD_REPEAT };
+typedef struct {
+    BfSig sig[BF_ODD_WIN];
+    uint32_t frame[BF_ODD_WIN];
+    unsigned n, at;                 /* consecutive frames held; next slot */
+    float motion[BF_MOTION_N];
+    unsigned motion_n, motion_at;
+    uint32_t reported;              /* frame after the last reported one */
+} BfOdd;
+
+typedef struct {
+    uint32_t first, last;           /* the odd frames, or the repeated showings */
+    float into, out_of;             /* change into and out of them */
+    float around;                   /* odd run: its two sides apart; repeat: change while held */
+    float scale;
+} BfOddEvent;
+
+/* k = 0 is the newest frame held. */
+static const BfSig *bf_odd_back(const BfOdd *o, unsigned k)
+{
+    return &o->sig[(o->at + BF_ODD_WIN - 1 - k) % BF_ODD_WIN];
+}
+
+static float bf_odd_scale(const BfOdd *o)
+{
+    float v[BF_MOTION_N], t;
+    unsigned i, k, n = o->motion_n;
+    if (n < 5) return -1.0f;
+    memcpy(v, o->motion, n * sizeof *v);
+    for (i = 1; i < n; i++)
+        for (k = i; k > 0 && v[k - 1] > v[k]; k--) { t = v[k]; v[k] = v[k - 1]; v[k - 1] = t; }
+    return v[n / 2];
+}
+
+/* Feed frames in order; a missing frame starts the window again. Returns
+ * BF_ODD_RUN or BF_ODD_REPEAT, with *ev filled in, when the newest frame
+ * closes one. */
+static int bf_odd_feed(BfOdd *o, uint32_t frame, const BfSig *sig, BfOddEvent *ev)
+{
+    unsigned run, k;
+    int found = BF_ODD_NONE;
+    float scale, step;
+    if (o->n && o->frame[(o->at + BF_ODD_WIN - 1) % BF_ODD_WIN] + 1 != frame) o->n = 0;
+    o->sig[o->at] = *sig;
+    o->frame[o->at] = frame;
+    o->at = (o->at + 1) % BF_ODD_WIN;
+    if (o->n < BF_ODD_WIN) o->n++;
+    if (o->n < 2) return BF_ODD_NONE;
+    step = bf_sig_diff(bf_odd_back(o, 1), bf_odd_back(o, 0));
+    scale = bf_odd_scale(o);
+    if (scale >= 0.0f) {
+        float s = scale > 0.5f ? scale : 0.5f;
+        for (run = 1; run <= BF_ODD_MAX && run + 2 <= o->n && !found; run++) {
+            const BfSig *before = bf_odd_back(o, run + 1), *after = bf_odd_back(o, 0);
+            float around = bf_sig_diff(before, after), need, into = 1e9f, out_of = 1e9f;
+            if (frame - run <= o->reported) continue;
+            need = 3.0f * around;
+            if (need < 4.0f * s) need = 4.0f * s;
+            if (need < 8.0f) need = 8.0f;
+            for (k = 1; k <= run; k++) {
+                float a = bf_sig_diff(bf_odd_back(o, k), before), b = bf_sig_diff(bf_odd_back(o, k), after);
+                if (a < into) into = a;
+                if (b < out_of) out_of = b;
+            }
+            if (into >= need && out_of >= need) {
+                found = BF_ODD_RUN;
+                ev->first = frame - run;
+                ev->last = frame - 1;
+                ev->into = into;
+                ev->out_of = out_of;
+                ev->around = around;
+                ev->scale = scale;
+            }
+        }
+        if (!found && o->n >= 4) {
+            /* back(1)..back(same) show one picture; back(same + 1) came before it. */
+            unsigned same = 1;
+            float moved = 0.8f > 0.5f * scale ? 0.8f : 0.5f * scale;
+            float held = 0.3f > 0.125f * scale ? 0.3f : 0.125f * scale;
+            while (same + 1 < o->n && bf_sig_diff(bf_odd_back(o, same + 1), bf_odd_back(o, 1)) < held)
+                same++;
+            if (same >= 2 && same + 1 < o->n && frame - same + 1 > o->reported) {
+                float into = bf_sig_diff(bf_odd_back(o, same + 1), bf_odd_back(o, same));
+                if (into >= moved && step >= moved) {
+                    found = BF_ODD_REPEAT;
+                    ev->first = frame - same + 1;
+                    ev->last = frame - 1;
+                    ev->into = into;
+                    ev->out_of = step;
+                    ev->around = bf_sig_diff(bf_odd_back(o, same), bf_odd_back(o, 1));
+                    ev->scale = scale;
+                }
+            }
+        }
+        if (found) o->reported = frame;
+    }
+    o->motion[o->motion_at] = step;
+    o->motion_at = (o->motion_at + 1) % BF_MOTION_N;
+    if (o->motion_n < BF_MOTION_N) o->motion_n++;
+    return found;
+}
+
+/* Part of the picture flashing for one frame: a block that, in the middle one
+ * of three consecutive frames, is at least BF_LOCAL_T (per channel) from the
+ * same block before and after, while before and after agree within a quarter
+ * of that. BF_LOCAL_MIN such blocks (2.5% of the picture) make an event: a
+ * building, light, shadow or texture that vanished or changed for one frame.
+ * Passing scenery rarely qualifies, since its blocks also differ between the
+ * frames either side; blinking lamps stay lit for many frames. */
+enum { BF_LOCAL_T = 32, BF_LOCAL_MIN = 4, BF_BLOCKS = BF_SIG_W * BF_SIG_H };
+typedef struct {
+    BfSig sig[2];                   /* the two frames before the newest, oldest first */
+    uint32_t frame[2];
+    unsigned n;
+    uint32_t reported;
+} BfLocal;
+
+typedef struct {
+    uint32_t frame;                 /* the frame that flashed */
+    unsigned blocks;                /* how many of the BF_BLOCKS */
+    unsigned x0, y0, x1, y1;        /* their bounding box, in blocks */
+    float strength;                 /* mean change into and out of them, per channel */
+} BfLocalEvent;
+
+/* Sum over the three channels of one block, 0..765. */
+static unsigned bf_block_diff(const BfSig *a, const BfSig *b, unsigned i)
+{
+    const uint8_t *p = a->c + i * 3, *q = b->c + i * 3;
+    unsigned d = 0, k;
+    for (k = 0; k < 3; k++) d += p[k] > q[k] ? (unsigned)(p[k] - q[k]) : (unsigned)(q[k] - p[k]);
+    return d;
+}
+
+/* Feed frames in order; a missing frame starts again. Returns 1, with *ev
+ * filled in, when the frame before the newest one flashed. */
+static int bf_local_feed(BfLocal *l, uint32_t frame, const BfSig *sig, BfLocalEvent *ev)
+{
+    int found = 0;
+    if (l->n && l->frame[l->n - 1] + 1 != frame) l->n = 0;
+    if (l->n == 2) {
+        const BfSig *a = &l->sig[0], *b = &l->sig[1];
+        unsigned i, count = 0, x0 = BF_SIG_W, y0 = BF_SIG_H, x1 = 0, y1 = 0;
+        float sum = 0.0f;
+        for (i = 0; i < BF_BLOCKS; i++) {
+            unsigned ab = bf_block_diff(a, b, i), bc = bf_block_diff(b, sig, i);
+            unsigned lo = ab < bc ? ab : bc, x = i % BF_SIG_W, y = i / BF_SIG_W;
+            if (lo < 3u * BF_LOCAL_T || bf_block_diff(a, sig, i) * 4u > lo) continue;
+            count++;
+            sum += (float)(ab + bc) / 6.0f;
+            if (x < x0) x0 = x;
+            if (x > x1) x1 = x;
+            if (y < y0) y0 = y;
+            if (y > y1) y1 = y;
+        }
+        if (count >= BF_LOCAL_MIN && l->frame[1] > l->reported) {
+            found = 1;
+            ev->frame = l->frame[1];
+            ev->blocks = count;
+            ev->x0 = x0; ev->y0 = y0; ev->x1 = x1; ev->y1 = y1;
+            ev->strength = sum / (float)count;
+            l->reported = l->frame[1];
+        }
+        l->sig[0] = l->sig[1];
+        l->frame[0] = l->frame[1];
+        l->n = 1;
+    }
+    l->sig[l->n] = *sig;
+    l->frame[l->n] = frame;
+    l->n++;
+    return found;
+}
+
+/* The local-light pass of one flip (street lamps, car lights): the light
+ * volume draws and their indices (about 36 per light), how many of those
+ * draws were screen-blended, how often the light buffer was laid over the
+ * frame, the depth copies the volumes read, and a checksum of where the
+ * volumes are (the mean of their vertex positions). */
+typedef struct {
+    uint32_t draws, indices, screen, composites, views;
+    float where;
+} BfLightPass;
+
+enum { BF_LIGHT_COUNT = 1, BF_LIGHT_COMPOSITE = 2, BF_LIGHT_BLEND = 4, BF_LIGHT_WHERE = 8 };
+
+/* Why pass x is unlike both a and b while those two agree; 0 when it is
+ * not, or when there is no light pass around it (menus). Lights entering
+ * and leaving the view change the count gradually; a sixth (at least two
+ * lights) more or fewer than both neighbours, which agree within a third of
+ * that, is a frame drawn with other lights. */
+static unsigned bf_light_odd(const BfLightPass *x, const BfLightPass *a, const BfLightPass *b)
+{
+    uint32_t ref = a->indices > b->indices ? a->indices : b->indices;
+    uint32_t gap = a->indices > b->indices ? a->indices - b->indices : b->indices - a->indices;
+    uint32_t da = x->indices > a->indices ? x->indices - a->indices : a->indices - x->indices;
+    uint32_t db = x->indices > b->indices ? x->indices - b->indices : b->indices - x->indices;
+    uint32_t lo = da < db ? da : db, need = ref / 6u > 72u ? ref / 6u : 72u;
+    int all_a = a->screen == a->draws, all_b = b->screen == b->draws;
+    unsigned why = 0;
+    if (!a->draws || !b->draws) return 0;
+    if (lo >= need && gap * 3u <= lo) why |= BF_LIGHT_COUNT;
+    if (a->composites == b->composites && x->composites != a->composites) why |= BF_LIGHT_COMPOSITE;
+    if (all_a == all_b && x->draws && (x->screen == x->draws) != all_a) why |= BF_LIGHT_BLEND;
+    if (x->indices && x->indices == a->indices && x->indices == b->indices) {
+        float mid = 0.5f * (a->where + b->where), dev = x->where - mid, spread = a->where - b->where;
+        if (dev < 0.0f) dev = -dev;
+        if (spread < 0.0f) spread = -spread;
+        if (dev > 2.0f && dev > 4.0f * spread) why |= BF_LIGHT_WHERE;
+    }
+    return why;
+}
+
+typedef struct {
+    BfLightPass pass[4];
+    uint32_t frame[4];
+    unsigned n;                     /* consecutive frames held (ring of 4) */
+    uint32_t reported;              /* last frame reported */
+} BfLight;
+
+typedef struct {
+    uint32_t first, last;           /* the odd flip, or two in a row */
+    BfLightPass before, odd, after;
+    unsigned why;                   /* BF_LIGHT_* */
+} BfLightEvent;
+
+/* Feed flips in order; a missing one starts again. Returns the BF_LIGHT_*
+ * reasons, with *ev filled in, when the flip before the newest one (or the
+ * two before it) had a light pass unlike the flips either side. */
+static unsigned bf_light_feed(BfLight *l, uint32_t frame, const BfLightPass *p, BfLightEvent *ev)
+{
+    unsigned why;
+    if (l->n && l->frame[(l->n - 1) & 3u] + 1u != frame) l->n = 0;
+    l->pass[l->n & 3u] = *p;
+    l->frame[l->n & 3u] = frame;
+    l->n++;
+    if (l->n >= 3) {
+        const BfLightPass *a = &l->pass[(l->n - 3) & 3u], *b = &l->pass[(l->n - 2) & 3u], *c = &l->pass[(l->n - 1) & 3u];
+        uint32_t fb = l->frame[(l->n - 2) & 3u];
+        if (fb != l->reported && (why = bf_light_odd(b, a, c)) != 0) {
+            ev->first = ev->last = fb;
+            ev->before = *a; ev->odd = *b; ev->after = *c;
+            ev->why = why;
+            l->reported = fb;
+            return why;
+        }
+    }
+    if (l->n >= 4) {
+        const BfLightPass *a = &l->pass[(l->n - 4) & 3u], *b = &l->pass[(l->n - 3) & 3u];
+        const BfLightPass *c = &l->pass[(l->n - 2) & 3u], *d = &l->pass[(l->n - 1) & 3u];
+        uint32_t fb = l->frame[(l->n - 3) & 3u], fc = l->frame[(l->n - 2) & 3u];
+        unsigned wb = bf_light_odd(b, a, d), wc = bf_light_odd(c, a, d);
+        if (wb && wc && fb != l->reported && fc != l->reported) {
+            ev->first = fb; ev->last = fc;
+            ev->before = *a; ev->odd = *b; ev->after = *d;
+            ev->why = wb | wc;
+            l->reported = fc;
+            return wb | wc;
+        }
+    }
+    return 0;
+}
+
+#ifndef NV2A_BLACK_FRAME_LOGIC_ONLY
+
+#define BF_W 64
+#define BF_H 40
+#define BF_STAGES 8
+#define BF_THUMB_W 256
+#define BF_THUMB_H 160
+#define BF_THUMBS 160               /* 26 MB of video memory; F9 saves most of them */
+#define BF_HIST 256
+#define BF_LOOKBACK 48
+#define BF_MAX_EVENTS 40
+#define BF_MAX_REPEATS 12
+/* Part-frame flashes and light-pass changes are logged with pictures up to
+ * a few a minute, so menu animations cannot use up a whole run's reports;
+ * the minute's line still counts every one. */
+#define BF_MAX_LOCAL 48
+#define BF_LOCAL_PER_WINDOW 4
+#define BF_MAX_LIGHT 36
+#define BF_LIGHT_PER_WINDOW 6
+#define BF_MAX_DUMPS 180
+#define BF_SHOWN 4
+#define BF_CAPTURE (BF_THUMBS - 8)  /* flips saved by F9, about 2.5 s */
+#define BF_CAPTURE_COLS 16
+#define BF_MAX_CAPTURES 12
+/* After the F9 sheet, the next BF_SHARP flips at a third of the panel
+ * width, for detail the thumbnails lose (distant flicker); for the first
+ * BF_MAX_SHARP captures of a run (about 38 MB each with the sheet). */
+#define BF_SHARP 6
+#define BF_MAX_SHARP 6
+#define BF_SHARP_W 1280
+#define BF_SHARP_H 800
+#define BF_SHARP_COLS 3
+
+typedef struct {
+    uint32_t frame;
+    int64_t qpc;
+    uint32_t phys, w, h, iw, ih, gen_delta;
+    int same_surface, readback_pending, have;
+    float change;               /* signature change from the frame before; -1 unknown */
+    BfFrameActivity act;
+    BfStats st;
+    BfSig sig;
+} BfFrame;
+
+static struct {
+    int configured, enabled, ready;
+    LARGE_INTEGER freq;
+    uint32_t seq, next_read, last_phys;
+    uint32_t shown_phys[BF_SHOWN], shown_gen[BF_SHOWN];
+    unsigned shown_at;
+    ID3D11Texture2D *rt, *thumb_stage;
+    ID3D11RenderTargetView *rtv;
+    ID3D11Texture2D *stage[BF_STAGES];
+    uint32_t stage_frame[BF_STAGES];
+    ID3D11Texture2D *thumb[BF_THUMBS];
+    ID3D11RenderTargetView *thumb_rtv[BF_THUMBS];
+    uint32_t thumb_frame[BF_THUMBS];
+    BfFrame hist[BF_HIST];
+    BfJudge judge;
+    BfOdd odd;
+    BfLocal local;
+    BfLight light;
+    uint32_t dark_first, dark_last, odd_first, odd_last;
+    unsigned events, repeats, locals, lights, dumps, captures;
+    unsigned window_dark, window_odd, window_repeats, window_local, window_light;
+    unsigned window_local_logged, window_light_logged;
+    int64_t window_start;
+    uint64_t read, lost, window_read, window_lost;
+    /* the sharp burst after F9 */
+    ID3D11Texture2D *sharp_rt, *sharp_stage;
+    ID3D11RenderTargetView *sharp_rtv;
+    unsigned sharp_left, sharp_done;
+    uint32_t sharp_first;
+    char sharp_path[720];
+    char prefix[600];
+} s_bf;
+
+static int black_frame_ready(void)
+{
+    int i;
+    if (!s_bf.configured) {
+        const char *setting = getenv("RECOMP_BLACK_FRAME");
+        const char *csv = getenv("RECOMP_FRAME_CSV");
+        s_bf.configured = 1;
+        s_bf.enabled = (!setting || strcmp(setting, "0") != 0) &&
+                       QueryPerformanceFrequency(&s_bf.freq) && s_bf.freq.QuadPart > 0;
+        s_bf.next_read = 1;
+        if (csv && strlen(csv) < sizeof s_bf.prefix) {
+            size_t n = strlen(csv);
+            strcpy(s_bf.prefix, csv);
+            if (n > 11 && !_stricmp(s_bf.prefix + n - 11, "-frames.csv")) s_bf.prefix[n - 11] = 0;
+            else if (n > 4 && !_stricmp(s_bf.prefix + n - 4, ".csv")) s_bf.prefix[n - 4] = 0;
+        }
+        if (s_bf.enabled)
+            fprintf(stderr, "[BLACK_FRAME] detector on: every flip sampled at %dx%d, short dark runs, odd and repeated frames logged%s%s (RECOMP_BLACK_FRAME=0 disables)\n",
+                    BF_W, BF_H, s_bf.prefix[0] ? ", pictures to " : "",
+                    s_bf.prefix[0] ? s_bf.prefix : "");
+    }
+    if (!s_bf.enabled) return 0;
+    if (s_bf.ready) return 1;
+    s_bf.rt = make_texture(BF_W, BF_H, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_BIND_RENDER_TARGET, 0);
+    if (s_bf.rt) ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)s_bf.rt, NULL, &s_bf.rtv);
+    for (i = 0; i < BF_STAGES && s_bf.rtv; i++) {
+        D3D11_TEXTURE2D_DESC d;
+        memset(&d, 0, sizeof d);
+        d.Width = BF_W; d.Height = BF_H; d.MipLevels = 1; d.ArraySize = 1;
+        d.Format = DXGI_FORMAT_B8G8R8A8_UNORM; d.SampleDesc.Count = 1;
+        d.Usage = D3D11_USAGE_STAGING; d.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &d, NULL, &s_bf.stage[i]))) break;
+    }
+    for (i = 0; i < BF_THUMBS && s_bf.rtv && s_bf.stage[BF_STAGES - 1]; i++) {
+        s_bf.thumb[i] = make_texture(BF_THUMB_W, BF_THUMB_H, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM,
+                                     D3D11_BIND_RENDER_TARGET, 0);
+        if (!s_bf.thumb[i] || FAILED(ID3D11Device_CreateRenderTargetView(s_dev,
+                (ID3D11Resource *)s_bf.thumb[i], NULL, &s_bf.thumb_rtv[i]))) break;
+    }
+    if (!s_bf.rtv || !s_bf.stage[BF_STAGES - 1] || !s_bf.thumb_rtv[BF_THUMBS - 1]) {
+        fprintf(stderr, "[BLACK_FRAME] detector off: could not create its targets\n");
+        s_bf.enabled = 0;
+        return 0;
+    }
+    s_bf.ready = 1;
+    return 1;
+}
+
+static const BfFrame *bf_frame(uint32_t f)
+{
+    const BfFrame *e = &s_bf.hist[f % BF_HIST];
+    return f && e->frame == f && e->have ? e : NULL;
+}
+
+static void bf_light_pass(const BfFrameActivity *a, BfLightPass *p)
+{
+    p->draws = a->light_draws;
+    p->indices = a->light_indices;
+    p->screen = a->light_screen;
+    p->composites = a->composites;
+    p->views = a->light_views;
+    p->where = a->light_where_n ? (float)(a->light_where / (double)a->light_where_n) : 0.0f;
+}
+
+/* Map the thumbnail of `frame` (waiting for the GPU); unmap with
+ * bf_thumb_done. */
+static int bf_thumb_map(uint32_t frame, D3D11_MAPPED_SUBRESOURCE *m)
+{
+    uint32_t k = frame % BF_THUMBS;
+    if (!frame || s_bf.thumb_frame[k] != frame) return 0;
+    if (!s_bf.thumb_stage) {
+        D3D11_TEXTURE2D_DESC d;
+        memset(&d, 0, sizeof d);
+        d.Width = BF_THUMB_W; d.Height = BF_THUMB_H; d.MipLevels = 1; d.ArraySize = 1;
+        d.Format = DXGI_FORMAT_B8G8R8A8_UNORM; d.SampleDesc.Count = 1;
+        d.Usage = D3D11_USAGE_STAGING; d.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &d, NULL, &s_bf.thumb_stage))) return 0;
+    }
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)s_bf.thumb_stage,
+                                     (ID3D11Resource *)s_bf.thumb[k]);
+    return SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_bf.thumb_stage, 0,
+                                             D3D11_MAP_READ, 0, m));
+}
+
+static void bf_thumb_done(void)
+{
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_bf.thumb_stage, 0);
+}
+
+/* A bottom-up 24-bit BMP header for w x h. */
+static void bf_bmp_header(FILE *f, uint32_t w, uint32_t h)
+{
+    uint32_t img = w * 3 * h, tot = 54 + img;
+    uint8_t hdr[54];
+    memset(hdr, 0, sizeof hdr);
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &tot, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &w, 4);
+    memcpy(hdr + 22, &h, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &img, 4);
+    fwrite(hdr, 1, 54, f);
+}
+
+static void black_frame_dump(uint32_t frame, const char *tag)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    char path[700];
+    FILE *f;
+    if (!s_bf.prefix[0] || s_bf.dumps >= BF_MAX_DUMPS || !bf_thumb_map(frame, &m))
+        return;
+    snprintf(path, sizeof path, "%s-black-%u-%s.bmp", s_bf.prefix, frame, tag);
+    f = fopen(path, "wb");
+    if (f) {
+        uint32_t row = BF_THUMB_W * 3, x, y;
+        uint8_t line[BF_THUMB_W * 3];
+        bf_bmp_header(f, BF_THUMB_W, BF_THUMB_H);
+        for (y = 0; y < BF_THUMB_H; y++) {
+            const uint8_t *src = (const uint8_t *)m.pData + (size_t)(BF_THUMB_H - 1 - y) * m.RowPitch;
+            for (x = 0; x < BF_THUMB_W; x++) {
+                line[x * 3] = src[x * 4];
+                line[x * 3 + 1] = src[x * 4 + 1];
+                line[x * 3 + 2] = src[x * 4 + 2];
+            }
+            fwrite(line, 1, row, f);
+        }
+        fclose(f);
+        s_bf.dumps++;
+        fprintf(stderr, "[BLACK_FRAME]   picture %s\n", path);
+    }
+    bf_thumb_done();
+}
+
+static void black_frame_line(const BfFrame *e, const char *tag, const char *what)
+{
+    const BfFrameActivity *a = &e->act;
+    const BfFrame *prev = &s_bf.hist[(e->frame - 1) % BF_HIST];
+    double dt = prev->frame == e->frame - 1 && prev->qpc
+        ? (double)(e->qpc - prev->qpc) * 1000.0 / (double)s_bf.freq.QuadPart : 0.0;
+    BfLightPass lp;
+    bf_light_pass(a, &lp);
+    fprintf(stderr, "%s   %s %u: luma %.1f p98 %u bright %.0f%% change %.1f | shown %08X %ux%u (host %ux%u)%s draws since it was last shown %d"
+                    " | draws %u kicks %u clears %u | cpu uploads %u (%u px, last %08X %ux%u at %u,%u-%u,%u)"
+                    " | new surfaces %u (last %08X %ux%u) evicted %u (%08X) | readback pending %d"
+                    " | lights: %u draws, %u indices (%u screen-blended), %u composites, %u depth copies, at %.2f | %.1f ms\n",
+            tag, what, e->frame, e->have ? e->st.mean : -1.0f, e->have ? e->st.p98 : 0u,
+            e->have ? e->st.bright * 100.0f : 0.0f, e->change, e->phys, e->w, e->h, e->iw, e->ih,
+            e->same_surface ? " same buffer as the flip before," : "",
+            e->gen_delta == 0xFFFFFFFFu ? -1 : (int)e->gen_delta,
+            a->draws, a->kicks, a->clears, a->uploads, a->upload_pixels, a->upload_phys,
+            a->upload_w, a->upload_h, a->upload_box[0], a->upload_box[1], a->upload_box[2],
+            a->upload_box[3], a->created, a->created_phys, a->created_w, a->created_h,
+            a->evicted, a->evicted_phys, e->readback_pending,
+            lp.draws, lp.indices, lp.screen, lp.composites, lp.views, lp.where, dt);
+}
+
+/* Local time of the report (a few flips after the frame) and the frame's QPC
+ * milliseconds, which the frame CSV and the [HITCH] lines use. */
+static void bf_when(uint32_t frame, char *out, size_t size)
+{
+    const BfFrame *e = bf_frame(frame);
+    SYSTEMTIME t;
+    GetLocalTime(&t);
+    snprintf(out, size, "at %02u:%02u:%02u (qpc_ms=%.1f)", t.wHour, t.wMinute, t.wSecond,
+             e ? (double)e->qpc * 1000.0 / (double)s_bf.freq.QuadPart : 0.0);
+}
+
+static void bf_lumas(uint32_t first, uint32_t last, char *out, size_t size)
+{
+    uint32_t f;
+    size_t at = 0;
+    out[0] = 0;
+    for (f = first >= 4 ? first - 3 : 1; f <= last + 2 && at + 16 < size; f++) {
+        const BfFrame *e = bf_frame(f);
+        char v[16];
+        if (e) snprintf(v, sizeof v, "%.0f", e->st.mean);
+        else snprintf(v, sizeof v, "?");
+        at += (size_t)snprintf(out + at, size - at, "%s%s%s%s", at ? " " : "",
+                               f == first ? "[" : "", v, f == last ? "]" : "");
+    }
+}
+
+/* The frame before, up to six bad frames and the frame after, then their
+ * pictures. */
+static void bf_frames(const char *tag, const char *what, uint32_t first, uint32_t last)
+{
+    uint32_t f, listed = 0;
+    for (f = first - 1; f <= last + 1; f++) {
+        const BfFrame *e = &s_bf.hist[f % BF_HIST];
+        if (f >= first && f <= last && ++listed > 6) continue;
+        if (e->frame == f) black_frame_line(e, tag, f < first ? "before" : f > last ? "after" : what);
+    }
+    black_frame_dump(first - 1, "before");
+    black_frame_dump(first, what);
+    black_frame_dump(last + 1, "after");
+}
+
+static void black_frame_report(uint32_t first, uint32_t last, float base)
+{
+    char lumas[256], when[64];
+    if (s_bf.events >= BF_MAX_EVENTS) return;
+    s_bf.events++;
+    bf_lumas(first, last, lumas, sizeof lumas);
+    bf_when(first, when, sizeof when);
+    fprintf(stderr, "[BLACK_FRAME] %u dark frame%s (flips %u-%u) %s after normal frames at luma %.0f; luma around: %s; checked %llu flips, %llu samples lost\n",
+            last - first + 1, last == first ? "" : "s", first, last, when, base, lumas,
+            (unsigned long long)s_bf.read, (unsigned long long)s_bf.lost);
+    bf_frames("[BLACK_FRAME]", "dark", first, last);
+    fflush(stderr);
+}
+
+/* The frame among the BF_LOOKBACK before an odd run that its first frame
+ * looks most like: a stale picture shows up as a close match further back. */
+static uint32_t bf_lookalike(uint32_t first, float *diff)
+{
+    const BfFrame *odd = bf_frame(first), *e;
+    uint32_t f, best = 0;
+    *diff = -1.0f;
+    if (!odd) return 0;
+    for (f = first > BF_LOOKBACK ? first - BF_LOOKBACK : 1; f + 1 < first; f++) {
+        float d;
+        if (!(e = bf_frame(f))) continue;
+        d = bf_sig_diff(&e->sig, &odd->sig);
+        if (!best || d < *diff) { *diff = d; best = f; }
+    }
+    return best;
+}
+
+static void odd_frame_report(const BfOddEvent *ev)
+{
+    char lumas[256], when[64], like[96];
+    float diff;
+    uint32_t match;
+    if (s_bf.events >= BF_MAX_EVENTS) return;
+    s_bf.events++;
+    bf_lumas(ev->first, ev->last, lumas, sizeof lumas);
+    bf_when(ev->first, when, sizeof when);
+    match = bf_lookalike(ev->first, &diff);
+    if (match) snprintf(like, sizeof like, "flip %u (%u back, %.1f apart)", match, ev->first - match, diff);
+    else snprintf(like, sizeof like, "none held");
+    fprintf(stderr, "[ODD_FRAME] %u frame%s unlike the frames on both sides (flips %u-%u) %s: change into %.1f, out of %.1f, "
+                    "the two sides %.1f apart, typical change per frame %.1f; closest earlier picture %s; luma around: %s\n",
+            ev->last - ev->first + 1, ev->last == ev->first ? "" : "s", ev->first, ev->last, when,
+            ev->into, ev->out_of, ev->around, ev->scale, like, lumas);
+    bf_frames("[ODD_FRAME]", "odd", ev->first, ev->last);
+    fflush(stderr);
+}
+
+static void repeat_frame_report(const BfOddEvent *ev)
+{
+    char when[64];
+    if (s_bf.repeats >= BF_MAX_REPEATS) return;
+    s_bf.repeats++;
+    bf_when(ev->first, when, sizeof when);
+    fprintf(stderr, "[ODD_FRAME] the picture of flip %u was shown again for %u more flip%s (flips %u-%u) %s while the scene "
+                    "moved %.1f into it and %.1f out of it (typical change per frame %.1f, %.1f while held)\n",
+            ev->first - 1, ev->last - ev->first + 1, ev->last == ev->first ? "" : "s", ev->first, ev->last, when,
+            ev->into, ev->out_of, ev->scale, ev->around);
+    bf_frames("[ODD_FRAME]", "repeat", ev->first, ev->last);
+    fflush(stderr);
+}
+
+static void local_frame_report(const BfLocalEvent *ev)
+{
+    char lumas[256], when[64];
+    if (s_bf.locals >= BF_MAX_LOCAL || s_bf.window_local_logged >= BF_LOCAL_PER_WINDOW) return;
+    s_bf.locals++;
+    s_bf.window_local_logged++;
+    bf_lumas(ev->frame, ev->frame, lumas, sizeof lumas);
+    bf_when(ev->frame, when, sizeof when);
+    fprintf(stderr, "[ODD_FRAME] part of flip %u flashed for one frame %s: %u of %u areas (columns %u-%u, rows %u-%u of %ux%u"
+                    " from the top left) changed %.0f into it and back out while the frames either side agree; luma around: %s\n",
+            ev->frame, when, ev->blocks, (unsigned)BF_BLOCKS, ev->x0, ev->x1, ev->y0, ev->y1,
+            (unsigned)BF_SIG_W, (unsigned)BF_SIG_H, ev->strength, lumas);
+    bf_frames("[ODD_FRAME]", "flash", ev->frame, ev->frame);
+    fflush(stderr);
+}
+
+/* A flip (or two) whose local-light pass was unlike the flips either side:
+ * lights missing or extra, the light buffer laid over the frame a different
+ * number of times, the blend changed, or the volumes elsewhere. */
+static void light_frame_report(const BfLightEvent *ev)
+{
+    char lumas[256], when[64], why[160];
+    const BfLightPass *a = &ev->before, *b = &ev->odd, *c = &ev->after;
+    if (s_bf.lights >= BF_MAX_LIGHT || s_bf.window_light_logged >= BF_LIGHT_PER_WINDOW) return;
+    s_bf.lights++;
+    s_bf.window_light_logged++;
+    why[0] = 0;
+    if (ev->why & BF_LIGHT_COUNT)
+        strcat(why, b->indices < a->indices ? "fewer lights drawn; " : "more lights drawn; ");
+    if (ev->why & BF_LIGHT_COMPOSITE) strcat(why, "light buffer laid over the frame a different number of times; ");
+    if (ev->why & BF_LIGHT_BLEND) strcat(why, "light blending changed; ");
+    if (ev->why & BF_LIGHT_WHERE) strcat(why, "the same lights drawn elsewhere; ");
+    if (why[0]) why[strlen(why) - 2] = 0;
+    bf_lumas(ev->first, ev->last, lumas, sizeof lumas);
+    bf_when(ev->first, when, sizeof when);
+    fprintf(stderr, "[LIGHT_FRAME] the light pass of flip%s %u-%u was unlike the flips either side %s (%s): volume indices %u | %u | %u,"
+                    " light draws %u | %u | %u (screen-blended %u | %u | %u), composites %u | %u | %u, depth copies %u | %u | %u,"
+                    " position checksum %.2f | %.2f | %.2f; luma around: %s\n",
+            ev->last == ev->first ? "" : "s", ev->first, ev->last, when, why,
+            a->indices, b->indices, c->indices, a->draws, b->draws, c->draws, a->screen, b->screen, c->screen,
+            a->composites, b->composites, c->composites, a->views, b->views, c->views,
+            a->where, b->where, c->where, lumas);
+    bf_frames("[LIGHT_FRAME]", "light", ev->first, ev->last);
+    fflush(stderr);
+}
+
+/* A minute's counts, also when nothing was found, so a clean minute reads as
+ * checked rather than silent; events past the line limits still show. */
+static void bf_window(const BfFrame *e)
+{
+    s_bf.window_read++;
+    if (!s_bf.window_start) { s_bf.window_start = e->qpc; s_bf.window_lost = s_bf.lost; return; }
+    if (e->qpc - s_bf.window_start < 60 * s_bf.freq.QuadPart) return;
+    fprintf(stderr, "[ODD_FRAME] last %.0f s: checked %llu flips (%llu samples lost): %u short dark runs, %u odd frame runs,"
+                    " %u repeated pictures, %u part-frame flashes, %u flips with an odd light pass\n",
+            (double)(e->qpc - s_bf.window_start) / (double)s_bf.freq.QuadPart,
+            (unsigned long long)s_bf.window_read, (unsigned long long)(s_bf.lost - s_bf.window_lost),
+            s_bf.window_dark, s_bf.window_odd, s_bf.window_repeats, s_bf.window_local, s_bf.window_light);
+    s_bf.window_start = e->qpc;
+    s_bf.window_lost = s_bf.lost;
+    s_bf.window_dark = s_bf.window_odd = s_bf.window_repeats = s_bf.window_local = s_bf.window_light = 0;
+    s_bf.window_local_logged = s_bf.window_light_logged = 0;
+    s_bf.window_read = 0;
+}
+
+/* Read every sample the GPU has finished, oldest first; stop at the first
+ * one still in flight. */
+static void black_frame_poll(void)
+{
+    while (s_bf.next_read <= s_bf.seq) {
+        uint32_t f = s_bf.next_read, k = f % BF_STAGES, first, last;
+        D3D11_MAPPED_SUBRESOURCE m;
+        BfFrame *e = &s_bf.hist[f % BF_HIST];
+        const BfFrame *prev;
+        BfOddEvent ev = { 0 };
+        BfLocalEvent lev = { 0 };
+        BfLightEvent light_ev;
+        BfLightPass pass;
+        unsigned light_why;
+        float base;
+        HRESULT hr;
+        int kind;
+        if (s_bf.stage_frame[k] != f) { s_bf.next_read++; s_bf.lost++; continue; }
+        hr = ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_bf.stage[k], 0, D3D11_MAP_READ,
+                                     D3D11_MAP_FLAG_DO_NOT_WAIT, &m);
+        if (hr == DXGI_ERROR_WAS_STILL_DRAWING) break;
+        s_bf.next_read++;
+        if (FAILED(hr)) { s_bf.lost++; continue; }
+        if (e->frame == f) {
+            bf_stats((const uint8_t *)m.pData, BF_W, BF_H, m.RowPitch, &e->st);
+            bf_signature((const uint8_t *)m.pData, BF_W, BF_H, m.RowPitch, &e->sig);
+            e->have = 1;
+        }
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_bf.stage[k], 0);
+        s_bf.read++;
+        if (e->frame != f) continue;
+        prev = bf_frame(f - 1);
+        e->change = prev ? bf_sig_diff(&prev->sig, &e->sig) : -1.0f;
+        if (bf_feed(&s_bf.judge, f, &e->st, &first, &last, &base)) {
+            s_bf.dark_first = first;
+            s_bf.dark_last = last;
+            s_bf.window_dark++;
+            black_frame_report(first, last, base);
+        }
+        kind = bf_odd_feed(&s_bf.odd, f, &e->sig, &ev);
+        /* A dark run (a held black picture too) is reported above already. */
+        if (kind != BF_ODD_NONE && ev.first <= s_bf.dark_last && ev.last >= s_bf.dark_first)
+            kind = BF_ODD_NONE;
+        if (kind != BF_ODD_NONE) {
+            s_bf.odd_first = ev.first;
+            s_bf.odd_last = ev.last;
+        }
+        if (kind == BF_ODD_RUN) {
+            s_bf.window_odd++;
+            odd_frame_report(&ev);
+        } else if (kind == BF_ODD_REPEAT) {
+            s_bf.window_repeats++;
+            repeat_frame_report(&ev);
+        }
+        /* A part-frame flash inside a whole-frame event is that event. */
+        if (bf_local_feed(&s_bf.local, f, &e->sig, &lev) &&
+            !(lev.frame >= s_bf.dark_first && lev.frame <= s_bf.dark_last) &&
+            !(lev.frame >= s_bf.odd_first && lev.frame <= s_bf.odd_last)) {
+            s_bf.window_local++;
+            local_frame_report(&lev);
+        }
+        /* The light pass, judged on what the renderer drew (no picture
+         * needed); fades and loading are dark runs already. */
+        bf_light_pass(&e->act, &pass);
+        memset(&light_ev, 0, sizeof light_ev);
+        light_why = bf_light_feed(&s_bf.light, f, &pass, &light_ev);
+        if (light_why && !(light_ev.last >= s_bf.dark_first && light_ev.first <= s_bf.dark_last)) {
+            s_bf.window_light++;
+            light_frame_report(&light_ev);
+        }
+        bf_window(e);
+    }
+}
+
+/* The target and staging sheet of the sharp burst, made at the first F9
+ * (4 MB and 25 MB of video memory). */
+static int bf_sharp_ready(void)
+{
+    D3D11_TEXTURE2D_DESC d;
+    if (s_bf.sharp_stage) return 1;
+    if (!s_bf.sharp_rt) {
+        s_bf.sharp_rt = make_texture(BF_SHARP_W, BF_SHARP_H, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM,
+                                     D3D11_BIND_RENDER_TARGET, 0);
+        if (!s_bf.sharp_rt) return 0;
+        if (FAILED(ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)s_bf.sharp_rt, NULL, &s_bf.sharp_rtv)))
+            return 0;
+    }
+    memset(&d, 0, sizeof d);
+    d.Width = BF_SHARP_COLS * BF_SHARP_W;
+    d.Height = (BF_SHARP + BF_SHARP_COLS - 1) / BF_SHARP_COLS * BF_SHARP_H;
+    d.MipLevels = 1; d.ArraySize = 1;
+    d.Format = DXGI_FORMAT_B8G8R8A8_UNORM; d.SampleDesc.Count = 1;
+    d.Usage = D3D11_USAGE_STAGING; d.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &d, NULL, &s_bf.sharp_stage))) {
+        s_bf.sharp_stage = NULL;
+        fprintf(stderr, "[CAPTURE] no video memory for the sharp pictures; the F9 sheet alone is saved\n");
+        return 0;
+    }
+    return 1;
+}
+
+/* All BF_SHARP flips are in the staging sheet: save it (one wait for the
+ * GPU, about 18 MB). */
+static void bf_sharp_write(void)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    uint32_t w = BF_SHARP_COLS * BF_SHARP_W, h = (BF_SHARP + BF_SHARP_COLS - 1) / BF_SHARP_COLS * BF_SHARP_H, x, y;
+    uint8_t *line;
+    FILE *f;
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_bf.sharp_stage, 0, D3D11_MAP_READ, 0, &m))) return;
+    line = (uint8_t *)malloc((size_t)w * 3);
+    f = line ? fopen(s_bf.sharp_path, "wb") : NULL;
+    if (f) {
+        bf_bmp_header(f, w, h);
+        for (y = 0; y < h; y++) {
+            const uint8_t *src = (const uint8_t *)m.pData + (size_t)(h - 1 - y) * m.RowPitch;
+            for (x = 0; x < w; x++) {
+                line[x * 3] = src[x * 4];
+                line[x * 3 + 1] = src[x * 4 + 1];
+                line[x * 3 + 2] = src[x * 4 + 2];
+            }
+            fwrite(line, 1, (size_t)w * 3, f);
+        }
+        fclose(f);
+        fprintf(stderr, "[CAPTURE] the %u flips after it (%u-%u) at %ux%u saved as %s, %u to a row from the top left\n",
+                s_bf.sharp_done, s_bf.sharp_first, s_bf.sharp_first + s_bf.sharp_done - 1, (unsigned)BF_SHARP_W,
+                (unsigned)BF_SHARP_H, s_bf.sharp_path, (unsigned)BF_SHARP_COLS);
+        fflush(stderr);
+    }
+    free(line);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_bf.sharp_stage, 0);
+}
+
+/* One flip of the burst into its place in the sheet; nothing waits here. */
+static void bf_sharp_sample(Surface *s, const PresentConsts *shown, uint32_t f)
+{
+    PresentConsts pc = *shown;
+    D3D11_BOX box = { 0, 0, 0, BF_SHARP_W, BF_SHARP_H, 1 };
+    unsigned k = s_bf.sharp_done;
+    composite(s_bf.sharp_rtv, BF_SHARP_W, BF_SHARP_H, s, &pc, 0);
+    ID3D11DeviceContext_CopySubresourceRegion(s_ctx, (ID3D11Resource *)s_bf.sharp_stage, 0,
+                                              (k % BF_SHARP_COLS) * BF_SHARP_W, (k / BF_SHARP_COLS) * BF_SHARP_H, 0,
+                                              (ID3D11Resource *)s_bf.sharp_rt, 0, &box);
+    if (!k) s_bf.sharp_first = f;
+    s_bf.sharp_done++;
+    if (--s_bf.sharp_left == 0) bf_sharp_write();
+}
+
+/* F9: the last BF_CAPTURE flips as one picture, oldest at the top left and
+ * BF_CAPTURE_COLS to a row, and a table of what the renderer and the screen
+ * did with each; then the next BF_SHARP flips sharper (bf_sharp_sample). A
+ * capture stalls the renderer for a moment (it waits for the GPU per
+ * thumbnail and writes about 20 MB, then 18 MB). */
+static void black_frame_capture(uint32_t newest)
+{
+    uint32_t first = newest > BF_CAPTURE ? newest - BF_CAPTURE + 1 : 1, f, x, y;
+    unsigned count = newest - first + 1, rows = (count + BF_CAPTURE_COLS - 1) / BF_CAPTURE_COLS, i, saved = 0;
+    uint32_t width = BF_CAPTURE_COLS * BF_THUMB_W, height = rows * BF_THUMB_H;
+    size_t row = (size_t)width * 3;
+    uint8_t *pixels;
+    SYSTEMTIME t;
+    char bmp[720], csv[720], stamp[16];
+    FILE *out;
+    const BfFrame *newest_frame = &s_bf.hist[newest % BF_HIST];
+    if (!s_bf.prefix[0]) {
+        fprintf(stderr, "[CAPTURE] F9 saves next to the frame CSV (RECOMP_FRAME_CSV), which is off\n");
+        return;
+    }
+    if (s_bf.captures >= BF_MAX_CAPTURES) {
+        fprintf(stderr, "[CAPTURE] F9: %u captures saved already this run\n", (unsigned)BF_MAX_CAPTURES);
+        return;
+    }
+    pixels = (uint8_t *)calloc(1, row * height);
+    if (!pixels) return;
+    for (f = first, i = 0; f <= newest; f++, i++) {
+        D3D11_MAPPED_SUBRESOURCE m;
+        unsigned col = i % BF_CAPTURE_COLS, tile = i / BF_CAPTURE_COLS;
+        if (!bf_thumb_map(f, &m)) continue;
+        for (y = 0; y < BF_THUMB_H; y++) {
+            const uint8_t *src = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+            uint8_t *dst = pixels + (size_t)(height - 1 - (tile * BF_THUMB_H + y)) * row + (size_t)col * BF_THUMB_W * 3;
+            for (x = 0; x < BF_THUMB_W; x++) {
+                dst[x * 3] = src[x * 4];
+                dst[x * 3 + 1] = src[x * 4 + 1];
+                dst[x * 3 + 2] = src[x * 4 + 2];
+            }
+        }
+        bf_thumb_done();
+        saved++;
+    }
+    GetLocalTime(&t);
+    snprintf(stamp, sizeof stamp, "%02u%02u%02u", t.wHour, t.wMinute, t.wSecond);
+    snprintf(bmp, sizeof bmp, "%s-black-capture-%s.bmp", s_bf.prefix, stamp);
+    snprintf(csv, sizeof csv, "%s-black-capture-%s.csv", s_bf.prefix, stamp);
+    if ((out = fopen(bmp, "wb")) != NULL) {
+        bf_bmp_header(out, width, height);
+        fwrite(pixels, 1, row * height, out);
+        fclose(out);
+    }
+    free(pixels);
+    if ((out = fopen(csv, "w")) != NULL) {
+        fprintf(out, "flip,tile,seconds_before_last,luma,p98,bright_pct,change,draws,kicks,clears,cpu_uploads,cpu_upload_px,"
+                     "new_surfaces,evicted,shown_buffer,same_buffer,draws_since_shown,flip_ms,light_draws,light_indices,"
+                     "light_screen,light_composites,light_depth_copies,light_where,screen\n");
+        for (f = first, i = 0; f <= newest; f++, i++) {
+            const BfFrame *e = &s_bf.hist[f % BF_HIST], *p = &s_bf.hist[(f - 1) % BF_HIST];
+            const BfFrameActivity *a = &e->act;
+            BfLightPass lp;
+            char screen[160];
+            if (e->frame != f) continue;
+            dstats_describe(f, screen, sizeof screen);
+            bf_light_pass(a, &lp);
+            fprintf(out, "%u,%u,%.3f,", f, i,
+                    (double)(newest_frame->qpc - e->qpc) / (double)s_bf.freq.QuadPart);
+            if (e->have) fprintf(out, "%.1f,%u,%.0f,%.2f,", e->st.mean, e->st.p98, e->st.bright * 100.0f, e->change);
+            else fprintf(out, ",,,,");
+            fprintf(out, "%u,%u,%u,%u,%u,%u,%u,%08X,%d,%d,", a->draws, a->kicks, a->clears, a->uploads, a->upload_pixels,
+                    a->created, a->evicted, e->phys, e->same_surface, e->gen_delta == 0xFFFFFFFFu ? -1 : (int)e->gen_delta);
+            if (p->frame == f - 1 && p->qpc) fprintf(out, "%.2f,", (double)(e->qpc - p->qpc) * 1000.0 / (double)s_bf.freq.QuadPart);
+            else fprintf(out, ",");
+            fprintf(out, "%u,%u,%u,%u,%u,%.3f,", lp.draws, lp.indices, lp.screen, lp.composites, lp.views, lp.where);
+            fprintf(out, "\"%s\"\n", screen);
+        }
+        fclose(out);
+    }
+    s_bf.captures++;
+    if (s_bf.captures <= BF_MAX_SHARP && bf_sharp_ready()) {
+        snprintf(s_bf.sharp_path, sizeof s_bf.sharp_path, "%s-black-capture-%s-sharp.bmp", s_bf.prefix, stamp);
+        s_bf.sharp_left = BF_SHARP;
+        s_bf.sharp_done = 0;
+    }
+    dstats_reset();
+    fprintf(stderr, "[CAPTURE] F9 at %02u:%02u:%02u: flips %u-%u (%u pictures, %.1f s) saved as %s, %u to a row from the top left;"
+                    " per-flip numbers in %s\n",
+            t.wHour, t.wMinute, t.wSecond, first, newest, saved,
+            count > 1 ? (double)(newest_frame->qpc - s_bf.hist[first % BF_HIST].qpc) / (double)s_bf.freq.QuadPart : 0.0,
+            bmp, (unsigned)BF_CAPTURE_COLS, csv);
+    fflush(stderr);
+}
+
+/* Draws into a display buffer since that buffer was last shown. */
+static uint32_t bf_draws_since_shown(const Surface *s)
+{
+    unsigned i;
+    uint32_t delta;
+    for (i = 0; i < BF_SHOWN; i++)
+        if (s_bf.shown_phys[i] == s->phys) {
+            delta = s->gen - s_bf.shown_gen[i];
+            s_bf.shown_gen[i] = s->gen;
+            return delta;
+        }
+    i = s_bf.shown_at++ % BF_SHOWN;
+    s_bf.shown_phys[i] = s->phys;
+    s_bf.shown_gen[i] = s->gen;
+    return 0xFFFFFFFFu;
+}
+
+/* F9 pressed on the game window since the last flip. Polled here, once per
+ * flip, so the window module needs no hook for it; F9 still reaches the
+ * title like any other key. */
+static int bf_capture_pressed(void)
+{
+    static int was;
+    HWND window = xbox_FramebufferWindowHandle();
+    int down = window && GetForegroundWindow() == window && (GetAsyncKeyState(VK_F9) & 0x8000) != 0;
+    int pressed = down && !was;
+    was = down;
+    return pressed;
+}
+
+/* One guest flip, composited the way the window shows it (without the
+ * letterbox) into the sample target and a thumbnail. */
+static void black_frame_sample(Surface *s, const PresentConsts *shown)
+{
+    PresentConsts pc;
+    uint32_t f;
+    BfFrame *e;
+    if (!s || !black_frame_ready()) return;
+    f = ++s_bf.seq;
+    e = &s_bf.hist[f % BF_HIST];
+    memset(e, 0, sizeof *e);
+    e->frame = f;
+    e->qpc = qpc();
+    e->change = -1.0f;
+    e->phys = s->phys; e->w = s->w; e->h = s->h; e->iw = s->iw; e->ih = s->ih;
+    e->same_surface = s->phys == s_bf.last_phys;
+    e->gen_delta = bf_draws_since_shown(s);
+    e->readback_pending = s_wb_pending;
+    e->act = s_bf_frame;
+    memset(&s_bf_frame, 0, sizeof s_bf_frame);
+    s_bf.last_phys = s->phys;
+    /* A slot still holding an unread sample loses it; black_frame_poll
+     * counts that when it reaches the frame. */
+    pc = *shown;
+    composite(s_bf.rtv, BF_W, BF_H, s, &pc, 0);
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)s_bf.stage[f % BF_STAGES],
+                                     (ID3D11Resource *)s_bf.rt);
+    s_bf.stage_frame[f % BF_STAGES] = f;
+    pc = *shown;
+    composite(s_bf.thumb_rtv[f % BF_THUMBS], BF_THUMB_W, BF_THUMB_H, s, &pc, 0);
+    s_bf.thumb_frame[f % BF_THUMBS] = f;
+    if (s_bf.sharp_left) bf_sharp_sample(s, shown, f);
+    else if (bf_capture_pressed()) black_frame_capture(f);
+    black_frame_poll();
+}
