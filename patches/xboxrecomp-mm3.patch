diff --git a/tests/nv2a_display_stats/test_display_stats.c b/tests/nv2a_display_stats/test_display_stats.c
new file mode 100644
index 0000000..a62d9b5
--- /dev/null
+++ b/tests/nv2a_display_stats/test_display_stats.c
@@ -0,0 +1,191 @@
+/* Unit test of nv2a_display_stats.h without DXGI: the bookkeeping that turns
+ * the swap chain's "newest present on screen, and its refresh" reports into
+ * repeated refreshes, holds and replaced frames. */
+#include <stdio.h>
+#include <stdlib.h>
+#define NV2A_DISPLAY_STATS_LOGIC_ONLY
+#include "nv2a_display_stats.h"
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); fails++; } } while (0)
+
+#define N 200
+#define FREQ 10000000LL                 /* QPC ticks per second */
+#define PERIOD (FREQ / 60)
+static uint32_t g_refresh[N + 1];       /* refresh each present appeared at; 0 = replaced */
+static int g_late[N + 1];
+static int g_gpu[N + 1];                /* 0 unknown, 1 finished, 2 not finished by the next present */
+
+/* Present 1..n in turn; at each, the GPU check of the one before is known,
+ * and the screen reports the newest earlier present it has shown (the
+ * display runs one frame behind). */
+static unsigned simulate(DsState *s, int n, DsHold *holds, unsigned max)
+{
+    unsigned found = 0;
+    int i, j;
+    memset(s, 0, sizeof *s);
+    for (i = 1; i <= n; i++) {
+        DsStats st;
+        DsHold h;
+        int newest = 0;
+        ds_presented(s, (uint32_t)i, (uint32_t)i, (int64_t)i * PERIOD, g_late[i]);
+        if (i > 1 && g_gpu[i - 1]) ds_gpu_done(s, (uint32_t)i - 1, g_gpu[i - 1] == 1);
+        for (j = 1; j < i; j++)
+            if (g_refresh[j] && (!newest || g_refresh[j] > g_refresh[newest])) newest = j;
+        if (!newest) continue;
+        st.present_count = (uint32_t)newest;
+        st.present_refresh = g_refresh[newest];
+        st.sync_refresh = g_refresh[newest];
+        st.sync_qpc = (int64_t)g_refresh[newest] * PERIOD;
+        if (ds_stats(s, &st, (uint32_t)i, &h) && found < max) holds[found++] = h;
+    }
+    return found;
+}
+
+static void steady(void)
+{
+    int i;
+    for (i = 1; i <= N; i++) { g_refresh[i] = 1000u + (uint32_t)i; g_late[i] = 0; g_gpu[i] = 1; }
+}
+
+int main(void)
+{
+    DsState s;
+    DsHold holds[8];
+    unsigned n;
+    char text[160];
+
+    /* every frame in its own refresh */
+    steady();
+    n = simulate(&s, N, holds, 8);
+    CHECK(n == 0 && s.repeats == 0 && s.replaced == 0 && s.shown == N - 2 && s.holds == 0,
+          "steady: holds %u repeats %u replaced %u shown %u", n, s.repeats, s.replaced, s.shown);
+    CHECK(s.presents == N && s.late_presents == 0 && s.waiting_max == 1, "steady presents %u late %u waiting %u",
+          s.presents, s.late_presents, s.waiting_max);
+    {
+        double hz = ds_refresh_hz(&s, FREQ);
+        CHECK(hz > 59.99 && hz < 60.01, "refresh rate %.4f", hz);
+    }
+
+    /* frame 50 presented late: the screen shows 49 one more refresh, the
+     * picture runs a refresh behind until frame 60 is replaced by 61 */
+    steady();
+    for (n = 50; n < 60; n++) g_refresh[n] = 1001u + n;
+    g_refresh[60] = 0;
+    g_late[50] = 1;
+    n = simulate(&s, N, holds, 8);
+    CHECK(n == 0 && s.repeats == 1 && s.repeats_late == 1 && s.repeats_gpu == 0 && s.repeats_display == 0 &&
+          s.replaced == 1,
+          "late frame: holds %u repeats %u late %u gpu %u display %u replaced %u", n, s.repeats, s.repeats_late,
+          s.repeats_gpu, s.repeats_display, s.replaced);
+    CHECK(s.late_presents == 1 && s.gpu_slow == 0, "late presents %u gpu slow %u", s.late_presents, s.gpu_slow);
+    ds_describe(&s, 50, text, sizeof text);
+    CHECK(strstr(text, "refresh 1051") && strstr(text, "stayed 1 more") && strstr(text, "late"), "describe 50: %s", text);
+    ds_describe(&s, 60, text, sizeof text);
+    CHECK(strstr(text, "replaced") != NULL, "describe 60: %s", text);
+    ds_describe(&s, 30, text, sizeof text);
+    CHECK(!strcmp(text, "shown at refresh 1030"), "describe 30: %s", text);
+    ds_describe(&s, 0, text, sizeof text);
+    CHECK(!strcmp(text, "not presented"), "describe 0: %s", text);
+
+    /* frame 70 on time and finished by the GPU, yet up three refreshes late:
+     * a hold from the compositor or display; the screen catches up by
+     * replacing 71..73 */
+    steady();
+    g_refresh[70] = 1073; g_refresh[71] = g_refresh[72] = g_refresh[73] = 0;
+    n = simulate(&s, N, holds, 8);
+    CHECK(n == 1 && holds[0].id == 70 && holds[0].flip == 70 && holds[0].extra == 3 && !holds[0].late &&
+          holds[0].gpu == DS_GPU_DONE && holds[0].present_qpc == 70 * PERIOD,
+          "on-time hold: n=%u id %u extra %u late %d gpu %d", n, n ? holds[0].id : 0, n ? holds[0].extra : 0,
+          n ? holds[0].late : 0, n ? holds[0].gpu : 0);
+    CHECK(s.repeats == 3 && s.repeats_display == 3 && s.repeats_gpu == 0 && s.replaced == 3 && s.holds == 1,
+          "on-time hold counts: repeats %u display %u gpu %u replaced %u holds %u", s.repeats, s.repeats_display,
+          s.repeats_gpu, s.replaced, s.holds);
+    /* the same with the GPU still busy with frame 70 at the next present */
+    g_gpu[70] = 2;
+    n = simulate(&s, N, holds, 8);
+    CHECK(n == 1 && holds[0].gpu == DS_GPU_SLOW && s.repeats_gpu == 3 && s.repeats_display == 0 && s.gpu_slow == 1,
+          "GPU-slow hold: n=%u gpu %d repeats gpu %u display %u slow %u", n, n ? holds[0].gpu : 0, s.repeats_gpu,
+          s.repeats_display, s.gpu_slow);
+    ds_describe(&s, 70, text, sizeof text);
+    CHECK(strstr(text, "stayed 3 more") && strstr(text, "GPU not done"), "describe 70: %s", text);
+
+    /* a loading screen: one picture for 100 refreshes is no glitch */
+    steady();
+    for (n = 80; n <= N; n++) g_refresh[n] = 1100u + n;
+    g_late[80] = 1;
+    n = simulate(&s, N, holds, 8);
+    CHECK(n == 0 && s.repeats == 0 && s.long_holds == 1, "loading: holds %u repeats %u long %u", n, s.repeats, s.long_holds);
+
+    /* nothing on screen yet, then normal reports */
+    {
+        DsStats st;
+        DsHold h;
+        memset(&s, 0, sizeof s);
+        memset(&st, 0, sizeof st);
+        ds_presented(&s, 1, 1, PERIOD, 0);
+        CHECK(!ds_stats(&s, &st, 1, &h) && !s.have, "zero report taken as a start");
+        ds_presented(&s, 2, 2, 2 * PERIOD, 0);
+        st.present_count = 1; st.present_refresh = st.sync_refresh = 500000; st.sync_qpc = 500000 * PERIOD;
+        CHECK(!ds_stats(&s, &st, 2, &h) && s.have && s.repeats == 0 && s.shown == 0, "first real report");
+        ds_presented(&s, 3, 3, 3 * PERIOD, 0);
+        st.present_count = 2; st.present_refresh = st.sync_refresh = 500001;
+        CHECK(!ds_stats(&s, &st, 3, &h) && s.shown == 1 && s.repeats == 0, "next report: shown %u", s.shown);
+        /* statistics restart, then a report far ahead: no repeats invented */
+        ds_restart(&s);
+        ds_presented(&s, 4, 4, 4 * PERIOD, 0);
+        st.present_count = 3; st.present_refresh = st.sync_refresh = 500400;
+        CHECK(!ds_stats(&s, &st, 4, &h) && s.repeats == 0 && s.long_holds == 0 && s.restarts == 1,
+              "after restart: repeats %u restarts %u", s.repeats, s.restarts);
+        /* a report from before the last one starts again too */
+        st.present_count = 2; st.present_refresh = st.sync_refresh = 500001;
+        CHECK(!ds_stats(&s, &st, 4, &h) && s.repeats == 0 && s.replaced == 0, "backwards report");
+        ds_window_reset(&s);
+        CHECK(s.presents == 0 && s.restarts == 0 && s.have, "window reset keeps the last report");
+    }
+
+    /* two frames shown between reports (the presenter was blocked) */
+    {
+        DsStats st;
+        DsHold h;
+        memset(&s, 0, sizeof s);
+        ds_presented(&s, 10, 10, 10 * PERIOD, 0);
+        st.present_count = 10; st.present_refresh = st.sync_refresh = 2000; st.sync_qpc = 2000 * PERIOD;
+        ds_stats(&s, &st, 10, &h);
+        ds_presented(&s, 11, 11, 11 * PERIOD, 0);
+        ds_presented(&s, 12, 12, 12 * PERIOD, 1);
+        st.present_count = 12; st.present_refresh = st.sync_refresh = 2002;
+        CHECK(!ds_stats(&s, &st, 12, &h) && s.shown == 2 && s.repeats == 0, "skipped report: shown %u", s.shown);
+        ds_describe(&s, 11, text, sizeof text);
+        CHECK(!strcmp(text, "shown at refresh 2001"), "describe 11: %s", text);
+        ds_describe(&s, 12, text, sizeof text);
+        CHECK(!strcmp(text, "shown at refresh 2002 (presented late)"), "describe 12: %s", text);
+    }
+
+    /* a display-mode change stalls the refresh count for a second: the rate
+     * comes from the steps either side of it, not from first to last */
+    {
+        DsStats st;
+        DsHold h;
+        uint32_t i, r = 7000;
+        int64_t q = 7000 * PERIOD;
+        double hz;
+        memset(&s, 0, sizeof s);
+        s.freq = FREQ;
+        for (i = 1; i <= 400; i++) {
+            ds_presented(&s, i, i, q, 0);
+            if (i == 200) q += FREQ;
+            st.present_count = i; st.present_refresh = st.sync_refresh = r; st.sync_qpc = q;
+            ds_stats(&s, &st, i, &h);
+            r++;
+            q += PERIOD;
+        }
+        hz = ds_refresh_hz(&s, FREQ);
+        CHECK(hz > 59.99 && hz < 60.01, "refresh rate across a stalled count %.4f", hz);
+        ds_window_reset(&s);
+        CHECK(ds_refresh_hz(&s, FREQ) == 0.0, "rate kept after the window reset");
+    }
+
+    printf(fails ? "%d FAILED\n" : "all display statistics checks passed\n", fails);
+    return fails != 0;
+}
