+        !xbox_file_buffered_asset("d:\\asset.bin", 0, 0x80, 1, 1, OPTIONS) &&
+        !xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 2, 1, OPTIONS) &&
+        !xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 4, 1, OPTIONS) &&
+        !xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 8, 1, OPTIONS) &&
+        !xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 1, 1, 8) &&
+        !xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 1, 1, 0x40);
+}
