+#ifndef VOLUME_OLD_RENDERER
+static unsigned depth_channel(Depth *d, unsigned channel)
+{
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    unsigned result = ~0u;
+    ID3D11Texture2D_GetDesc(d->y16, &desc);
+    desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging))) return result;
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)d->y16);
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging,0,D3D11_MAP_READ,0,&mapped))) {
+        uint16_t word;
+        memcpy(&word,(uint8_t *)mapped.pData + (d->ih/2)*mapped.RowPitch + d->iw*8 + channel*2,2);
+        result = word;
+        ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)staging,0);
+    }
+    ID3D11Texture2D_Release(staging);
+    return result;
+}
+
+static unsigned depth_word(Depth *d)
+{
+    return depth_channel(d, 0);
+}
