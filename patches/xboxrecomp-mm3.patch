+        if (DSP_RECOMP_STOPPED) return used; \
+        if (dsp->pram_opcache[H] != &dsp_recomp_marks[PROG][MARK] && \
+            !dsp_rb_verify(dsp, (PROG) ? dsp_rb_ep_image : dsp_rb_gp_image, H, E, &dsp_recomp_marks[PROG][MARK])) \
+            return used; \
