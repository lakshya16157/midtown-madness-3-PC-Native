+/* Capture the production vertex output after real classification, raw-array
+ * upload and shader execution. Nonzero guest indices also exercise the Y
+ * buffer's indexing independently of the source vertex span. */
+static void capture_map(ID3D11GeometryShader *geometry, ID3D11Buffer *output,
+                         const NvD3DState *target, const float (*vertices)[4],
+                         unsigned count, uint32_t texture, unsigned route_first,
+                         unsigned route_count, int expect_y_buffer, float (*captured)[4])
+{
+    float submitted[MAP_FIRST_VERTEX + MAP_MAX_VERTICES][4] = {{0}}, def[16][4] = {{0}};
+    int16_t packed[MAP_FIRST_VERTEX + MAP_MAX_VERTICES][8] = {{0}};
+    NvD3DState st = *target; NvD3DAttrib attr[16] = {{0}};
+    uint32_t indices[MAP_MAX_VERTICES], gw,gh,z; unsigned i;
+    UINT offset = 0, raw_position = s_raw_pos;
+    ID3D11Buffer *none = NULL; Surface *surface; UbConsts uc;
+    CHECK(count <= MAP_MAX_VERTICES && route_first + route_count <= count);
+    memcpy(submitted + MAP_FIRST_VERTEX,vertices,count * sizeof *vertices);
+    for (i = 0; i < count; ++i) {
+        indices[i] = MAP_FIRST_VERTEX + i;
+        if (i >= route_first && i < route_first + route_count) {
+            packed[MAP_FIRST_VERTEX + i][4] = 23117;
+            packed[MAP_FIRST_VERTEX + i][5] = -17493;
+        }
+        if (map_camera_tag && texture == MAP_BASE_TEXTURE) {
+            packed[MAP_FIRST_VERTEX + i][4] = 23213;
+            packed[MAP_FIRST_VERTEX + i][5] = (int16_t)(uint16_t)
+                ((map_camera_motion_byte << 8) | map_camera_expansion_byte);
+        }
+        if (map_fragment_mask && texture == MAP_BASE_TEXTURE) {
+            const double xy_scale = 32768.0*0.0005537098622880876;
+            packed[MAP_FIRST_VERTEX + i][6] = (int16_t)((vertices[i][0]-map_mask_bounds[0])*16383.5/map_mask_bounds[2]);
+            packed[MAP_FIRST_VERTEX + i][7] = (int16_t)((vertices[i][1]-map_mask_bounds[1])*16383.5/map_mask_bounds[3]);
+            submitted[MAP_FIRST_VERTEX + i][0] = (float)(floor(vertices[i][0]*xy_scale)/xy_scale);
+            submitted[MAP_FIRST_VERTEX + i][1] = (float)(floor(vertices[i][1]*xy_scale)/xy_scale);
+        }
+    }
+    attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+    attr[0].stride = 16; attr[0].data = (const uint8_t *)submitted;
+    attr[2].enabled = 1; attr[2].type = 1; attr[2].size = 4;
+    attr[2].stride = 16; attr[2].data = (const uint8_t *)&packed[0][4];
+    def[3][0] = def[3][1] = def[3][2] = def[3][3] = 1;
+    if (texture) {
+        st.tex_used = 1; st.tex[0].addr = texture; st.tex[0].color = 0x12;
+        st.tex[0].format = 0x00011200; st.tex[0].levels = 1;
+        st.tex[0].width = st.tex[0].height = 4; st.tex[0].pitch = 16;
+    }
+    if (map_fragment_mask && texture == MAP_BASE_TEXTURE) {
+        st.tex_used |= 2; st.rc.stage_program |= 1u << 5;
+        st.tex[1].addr=0x320000; st.tex[1].color=0x0F; st.tex[1].format=0x00010F00;
+        st.tex[1].levels=1; st.tex[1].width=st.tex[1].height=128;
+    }
+    CHECK(setup_pipeline(&st,NV_D3D_POINTS,&surface,&gw,&gh,&z));
+    CHECK(gw == 640 && gh == 480);
+    ID3D11DeviceContext_GSSetShader(s_ctx,geometry,NULL,0);
+    ID3D11DeviceContext_SOSetTargets(s_ctx,1,&output,&offset);
+    nv2a_d3d_draw_ub(&st,NV_D3D_POINTS,attr,(const float (*)[4])def,0,indices,count,
+                     MAP_FIRST_VERTEX,MAP_FIRST_VERTEX + count - 1,
+                     (const float (*)[4])(submitted + MAP_FIRST_VERTEX));
+    ID3D11DeviceContext_SOSetTargets(s_ctx,1,&none,&offset);
+    ID3D11DeviceContext_GSSetShader(s_ctx,NULL,NULL,0);
+    read_buffer(output,captured,count * sizeof *captured);
+    if (expect_y_buffer < 0) {
+        CHECK(s_raw_pos == raw_position); /* Discarded base uploads no vertices. */
+        return;
+    }
+    read_buffer(s_cb_ub,&uc,sizeof uc);
+    CHECK((uc.info[3] != 0xFFFFFFFFu) == expect_y_buffer);
+    CHECK(uc.info[2] == 0xFFFFFFFFu || uc.info[2] + count * 4 <= VB_BYTES);
+    CHECK(uc.info[3] == 0xFFFFFFFFu || uc.info[3] + count * 4 <= VB_BYTES);
+}
