+    } while (0)
+#include DSP_RECOMP_INC
+
+#ifndef DSP_RECOMP_THREADED_UNIT
+static void dsp_recomp_invalidate(dsp_core_t* dsp, uint32_t address)
+{
+    uint16_t head = dsp_rb_gp_head[address];
+    if (head != 0xffff) dsp->pram_opcache[head] = NULL;
+    head = dsp_rb_ep_head[address];
+    if (head != 0xffff) dsp->pram_opcache[head] = NULL;
