+/* A swizzled target compares its guest bytes before undoing the Morton
+ * layout; a CPU texel written over GPU pixels must still merge exactly. */
+static int test_swizzled_sync(void)
+{
+    const uint32_t w = 16, h = 16, va = 0x40000;
+    uint32_t x, y, value, gen, *texels = (uint32_t *)(ram + va);
+    uint64_t changed, skips;
+    Surface *s;
+    for (y = 0; y < h; ++y) for (x = 0; x < w; ++x)
+        texels[morton16(x, y)] = 0xFF000000u | (y << 16) | (x << 8) | 0x40u;
+    s_prof_on = 1;
+    s = surface_get(va, w * 4, 8, w, h, 1);
+    CHECK(s && s->swizzled && s->shadow && s->raw && !memcmp(s->raw, texels, w * h * 4));
+    CHECK(!read_texel(s, 5, 9, &value) && value == (0xFF000000u | (9u << 16) | (5u << 8) | 0x40u));
+    gen = s->gen; changed = s_prof_sync_changed; skips = s_prof_sync_raw_skips;
+    nv2a_d3d_kick(); surface_sync(s, 0);
+    CHECK(s_prof_sync_raw_skips == skips + 1 && s->gen == gen && s_prof_sync_changed == changed);
+    draw_color(s, 1);                                   /* the GPU draws green everywhere */
+    texels[morton16(5, 9)] = 0xFF0000FFu;               /* then the CPU writes one texel */
+    nv2a_d3d_kick(); surface_sync(s, 0);
+    CHECK(s_prof_sync_changed == changed + 1 && s->gen == gen + 1);
+    CHECK(s_prof_sync_raw_skips == skips + 1 && !memcmp(s->raw, texels, w * h * 4));
+    CHECK(!read_texel(s, 5, 9, &value) && value == 0xFF0000FFu);
+    CHECK(!read_texel(s, 6, 9, &value) && value == 0xFF00FF00u);
+    CHECK(!read_texel(s, 5, 8, &value) && value == 0xFF00FF00u);
+    nv2a_d3d_kick(); surface_sync(s, 0);
+    CHECK(s_prof_sync_raw_skips == skips + 2 && s->gen == gen + 1);
+    s_prof_on = 0;
+    puts("PASS: swizzled sync skips the Morton decode for identical guest bytes; one CPU texel merges exactly over GPU pixels");
+    return 0;
+}
