+    if (enabled < 0) {
+        const char *e = getenv("RECOMP_RUMBLE");
+        enabled = !(e && !strcmp(e, "0"));
+        if (enabled) atexit(rumble_stop_all);
+    }
+    v.wLeftMotorSpeed  = (WORD)(data[2] | (data[3] << 8));
+    v.wRightMotorSpeed = (WORD)(data[4] | (data[5] << 8));
+    value = ((uint32_t)v.wLeftMotorSpeed << 16) | v.wRightMotorSpeed;
+    if (!enabled || value == s_rumble[pad])
+        return 1;
+    s_rumble[pad] = value;
+    xbox_InputSetState((DWORD)pad, &v);
+    if (s_rumble_reports < 8) {
+        s_rumble_reports++;
+        fprintf(stderr, "  PAD: rumble pad %d left %u right %u\n", pad + 1,
+                (unsigned)v.wLeftMotorSpeed, (unsigned)v.wRightMotorSpeed);
+        fflush(stderr);
+    }
+    return 1;
+}
