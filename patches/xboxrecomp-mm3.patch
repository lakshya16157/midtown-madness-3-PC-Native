+static void map_markers(float aspect, float scale, Result base, float base_x) {
+    float p[8][4], narrow = (4.0f / 3.0f) / aspect;
+    const uint32_t idx[12] = {0,1,2,0,2,3,4,5,6,4,6,7};
+    Result r;
+    int x, i;
+    /* A moving checkpoint passes the midpoint, then leaves the map bounds.
+     * Its position must remain the same affine function as the road pixels,
+     * rather than jumping to an independently chosen HUD edge. */
+    for (x = -20; x <= 660; x += 10) {
+        r = box((float)x, (float)x + 16, 180, 196, aspect, scale, 1, 0, map_marker);
+        near(r.x[0], base.x[0] + ((float)x - base_x) * narrow);
+        near(r.x[1], r.x[0] + 16 * narrow);
+        near(r.y[0], 180 + base.y_offset); near(r.y[2], 196 + base.y_offset);
+        assert(!r.use_dx);
+    }
+    quad(p, 110, 126, 180, 196); quad(p + 4, 490, 506, 180, 196);
+    r = draw(p, 8, idx, 12, 0, aspect, scale, 1, 0, map_marker);
+    for (i = 0; i < 8; ++i) {
+        near(r.x[i], base.x[0] + (p[i][0] - base_x) * narrow);
+        near(r.y[i], p[i][1] + base.y_offset);
+    }
+    assert(!r.use_dx); /* Disconnected icons in one atlas stay with the map. */
