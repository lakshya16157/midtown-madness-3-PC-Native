+                        UINT x, UINT y, UINT z, ID3D11Resource *src, UINT source,
+                        const D3D11_BOX *box)
+{ copy_calls++; c->lpVtbl->CopySubresourceRegion(c,dst,sub,x,y,z,src,source,box); }
+static void generate_mips(ID3D11DeviceContext *c, ID3D11ShaderResourceView *srv)
+{ mip_calls++; c->lpVtbl->GenerateMips(c,srv); }
+static HRESULT map_resource(ID3D11DeviceContext *c, ID3D11Resource *r, UINT sub,
+                            D3D11_MAP kind, UINT flags, D3D11_MAPPED_SUBRESOURCE *m)
+{
+    if(r==(ID3D11Resource *)s_ib) index_map_calls++;
+    if(r==(ID3D11Resource *)s_cb_ps) {
+        ps_map_calls++;
+        if(fail_ps_map) { fail_ps_map--; return E_FAIL; }
+    }
+    if(fail_map && r==(ID3D11Resource *)s_raw) { fail_map=0; return E_FAIL; }
+    if(fail_resource==r) { fail_resource=NULL; return E_FAIL; }
+    return c->lpVtbl->Map(c,r,sub,kind,flags,m);
+}
