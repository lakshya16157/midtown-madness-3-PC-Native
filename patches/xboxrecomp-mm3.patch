+static bool audio_dsp_trace_append(char *buffer, size_t capacity, size_t *used,
+                                  const char *format, ...)
+{
+    if (*used >= capacity - 1) return false;
+    va_list args;
+    va_start(args, format);
+    int n = vsnprintf(buffer + *used, capacity - *used, format, args);
+    va_end(args);
+    if (n < 0 || (size_t)n >= capacity - *used) {
+        buffer[capacity - 1] = 0; *used = capacity - 1; return false;
+    }
+    *used += (size_t)n;
+    return true;
+}
