+     * asset contract; only the exact value 1 enables the narrow policy. */
+    s_asset_buffering_enabled = setting && !strcmp(setting, "1");
+    fprintf(stderr, "[FILE_CACHE] buffered_asset_reads=%d scope=readonly_absolute_d_z_open_no_writers other_flags=unchanged\n",
+        s_asset_buffering_enabled);
+    return TRUE;
+}
