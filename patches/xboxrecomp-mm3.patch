+        if (xbox_file_buffered_asset(paths[i], 0, ACCESS, 1, 1, OPTIONS)) return 0;
+    for (i = 0; i < sizeof denied_access / sizeof *denied_access; ++i)
+        if (xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS | denied_access[i], 1, 1, OPTIONS)) return 0;
+    for (i = 0; i < sizeof denied_options / sizeof *denied_options; ++i)
+        if (xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 1, 1, OPTIONS | denied_options[i])) return 0;
+    for (i = 0; i <= 5; ++i)
+        if (i != 1 && xbox_file_buffered_asset("d:\\asset.bin", 0, ACCESS, 1, (ULONG)i, OPTIONS)) return 0;
+    return !xbox_file_buffered_asset(NULL, 0, ACCESS, 1, 1, OPTIONS) &&
