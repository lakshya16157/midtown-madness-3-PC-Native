+           st->rc.color_icw[0] == 0xC4DB0000u &&
+           st->rc.alpha_icw[0] == 0xD4DB1010u &&
+           st->rc.color_ocw[0] == 0xC0u && st->rc.alpha_ocw[0] == 0xC0u &&
