+/* Publishing one packed value prevents mixed FPS/VSync requests. D3D state,
+ * pacing deadlines and surface lifetime remain owned by the render thread. */
+static volatile LONG s_present_options = -1;
+static volatile LONG s_runtime_scale_bits = -1;
+static volatile LONG s_applied_scale_bits = -1;
+
+int nv2a_d3d_set_present_options(int vsync, int max_fps)
+{
+    if ((vsync != 0 && vsync != 1) || max_fps < 1 || max_fps > 60) return 0;
+    InterlockedExchange(&s_present_options, (LONG)((vsync << 16) | max_fps));
+    return 1;
+}
+
+static LONG present_options(void)
+{
+    LONG options = InterlockedCompareExchange(&s_present_options, 0, 0);
+    if (options < 0) {
+        const char *e = getenv("RECOMP_FPS_LIMIT");
+        const char *v = getenv("RECOMP_VSYNC");
+        int limit = e ? atoi(e) : 60;
+        LONG configured;
+        /* Preserve unpaced diagnostic launches until the live API is used. */
+        if (limit < 0) limit = 0;
+        if (limit > 65535) limit = 65535;
+        configured = (LONG)(((v && atoi(v) != 0) << 16) | limit);
+        options = InterlockedCompareExchange(&s_present_options, configured, -1);
+        if (options < 0) options = configured;
+    }
+    return options;
+}
+
+void nv2a_d3d_set_render_scale(float scale)
+{
+    LONG bits;
+    if (!(scale == 0.0f || (scale >= 0.5f && scale <= 8.0f))) return;
+    memcpy(&bits, &scale, sizeof bits);
+    InterlockedExchange(&s_runtime_scale_bits, bits);
+}
+
+float nv2a_d3d_get_render_scale(void)
+{
+    LONG bits = InterlockedCompareExchange(&s_applied_scale_bits, 0, 0);
+    float scale;
+    if (bits == -1) return -1.0f;
+    memcpy(&scale, &bits, sizeof scale);
+    return scale;
+}
