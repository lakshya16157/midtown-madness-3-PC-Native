+            target += 2;
+            fprintf(stderr, "[APU] output ran dry; queue target raised to %d buffers (%.1f ms)\n",
+                    target, target * MIXER_FRAME_SAMPLES * 1000.0 / 48000.0);
+            fflush(stderr);
+        }
+    }
