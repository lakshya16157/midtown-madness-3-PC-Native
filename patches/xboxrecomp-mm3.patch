diff --git a/tests/nv2a_display/test_display.c b/tests/nv2a_display/test_display.c
new file mode 100644
index 0000000..2667224
--- /dev/null
+++ b/tests/nv2a_display/test_display.c
@@ -0,0 +1,132 @@
+/* Run the actual live option consumer and surface recreation on the GPU. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x400000];
+static HWND fixture_window;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return fixture_window; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { (void)version; return NULL; }
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); } } while (0)
+
+static volatile LONG writer_done;
+static DWORD WINAPI option_writer(LPVOID unused)
+{
+    unsigned i;
+    (void)unused;
+    for (i = 0; i < 100000; ++i) CHECK(nv2a_d3d_set_present_options(i & 1, (i & 1) ? 60 : 30));
+    InterlockedExchange(&writer_done, 1);
+    return 0;
+}
+
+static void test_options(void)
+{
+    LONG expected;
+    HANDLE writer;
+    CHECK(_putenv_s("RECOMP_FPS_LIMIT", "45") == 0);
+    CHECK(_putenv_s("RECOMP_VSYNC", "1") == 0);
+    CHECK(present_options() == ((1 << 16) | 45));
+    CHECK(nv2a_d3d_set_present_options(0, 1));
+    expected = present_options();
+    CHECK(expected == 1);
+    CHECK(!nv2a_d3d_set_present_options(2, 60));
+    CHECK(!nv2a_d3d_set_present_options(-1, 60));
+    CHECK(!nv2a_d3d_set_present_options(0, 0));
+    CHECK(!nv2a_d3d_set_present_options(0, 61));
+    CHECK(present_options() == expected);
+    CHECK(nv2a_d3d_set_present_options(0, 30));
+    writer = CreateThread(NULL, 0, option_writer, NULL, 0, NULL);
+    CHECK(writer);
+    do {
+        LONG actual = present_options();
+        CHECK(actual == 30 || actual == ((1 << 16) | 60));
+    } while (!InterlockedCompareExchange(&writer_done, 0, 0));
+    CHECK(WaitForSingleObject(writer, 5000) == WAIT_OBJECT_0);
+    CloseHandle(writer);
+    puts("PASS: live FPS/VSync bounds, launch defaults and 100000 atomic paired publications");
+}
+
+static double measured_period(int rate)
+{
+    LARGE_INTEGER frequency;
+    int64_t start;
+    unsigned i;
+    CHECK(QueryPerformanceFrequency(&frequency));
+    CHECK(nv2a_d3d_set_present_options(0, rate));
+    pace_vblank();
+    start = qpc();
+    for (i = 0; i < 5; ++i) pace_vblank();
+    return (qpc() - start) * 1000.0 / frequency.QuadPart / 5;
+}
+
+static void test_pacing(void)
+{
+    double at30 = measured_period(30), at60 = measured_period(60), back30 = measured_period(30);
+    CHECK(at30 > 25 && at30 < 60);
+    CHECK(at60 > 12 && at60 < 35);
+    CHECK(back30 > 25 && back30 < 60);
+    printf("PASS: native cadence switches 30 -> 60 -> 30 FPS without restart (%.2f / %.2f / %.2f ms)\n",
+        at30, at60, back30);
+}
+
+static void test_scale(void)
+{
+    RECT rectangle = { 0, 0, 960, 720 };
+    Surface *surface;
+    LONG before;
+    CHECK(_putenv_s("RECOMP_RENDER_SCALE", "1") == 0);
+    CHECK(_putenv_s("RECOMP_SUPERSAMPLE", "2") == 0);
+    CHECK(_putenv_s("RECOMP_ASPECT", "4:3") == 0);
+    CHECK(_putenv_s("RECOMP_MSAA", "1") == 0);
+    CHECK(_putenv_s("RECOMP_PS_SPEC", "0") == 0);
+    CHECK(_putenv_s("RECOMP_PS_PREWARM", "0") == 0);
+    CHECK(_putenv_s("RECOMP_SHADER_CACHE", "0") == 0);
+    SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+    CHECK(AdjustWindowRect(&rectangle, WS_OVERLAPPEDWINDOW, FALSE));
+    fixture_window = CreateWindowExA(0, "STATIC", "Hidden render-scale contract",
+        WS_OVERLAPPEDWINDOW, 0, 0, rectangle.right - rectangle.left,
+        rectangle.bottom - rectangle.top, NULL, NULL, GetModuleHandleA(NULL), NULL);
+    CHECK(fixture_window && nv2a_d3d_init());
+    CHECK(fabsf(s_scale - 1.0f) < 0.001f);
+    surface = surface_get(0x1000u, 640 * 4, 5, 640, 480, 0);
+    CHECK(surface && surface->tex && surface->iw == 640 && surface->ih == 480);
+    nv2a_d3d_set_render_scale(2.0f);
+    display_config(0);
+    CHECK(fabsf(s_scale - 2.0f) < 0.001f && !surface->tex);
+    surface = surface_get(0x1000u, 640 * 4, 5, 640, 480, 0);
+    CHECK(surface && surface->tex && surface->iw == 1280 && surface->ih == 960);
+    before = InterlockedCompareExchange(&s_runtime_scale_bits, 0, 0);
+    nv2a_d3d_set_render_scale(0.49f);
+    nv2a_d3d_set_render_scale(8.01f);
+    nv2a_d3d_set_render_scale((float)NAN);
+    CHECK(InterlockedCompareExchange(&s_runtime_scale_bits, 0, 0) == before);
+    nv2a_d3d_set_render_scale(0.5f);
+    display_config(0);
+    CHECK(fabsf(s_scale - 0.5f) < 0.001f);
+    surface = surface_get(0x1000u, 640 * 4, 5, 640, 480, 0);
+    CHECK(surface && surface->iw == 320 && surface->ih == 240);
+    nv2a_d3d_set_render_scale(0.0f);
+    display_config(0);
+    CHECK(fabsf(s_scale - 3.0f) < 0.001f); /* 720-line window x 2, despite env scale 1. */
+    CHECK(!surface->tex);
+    nv2a_d3d_set_render_scale(8.0f);
+    display_config(0);
+    CHECK(fabsf(s_scale - 8.0f) < 0.001f);
+    CHECK(DestroyWindow(fixture_window));
+    puts("PASS: live render-scale changes recreate GPU surfaces at unchanged window size, bounds and automatic mode");
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    if (!strcmp(argv[1], "options")) test_options();
+    else if (!strcmp(argv[1], "pacing")) test_pacing();
+    else if (!strcmp(argv[1], "scale")) test_scale();
+    else CHECK(0);
+    return 0;
+}
