new file mode 100644
index 0000000..c141858
--- /dev/null
+++ b/tests/nv2a_surface_sync/watch_tests.h
@@ -0,0 +1,229 @@
+/* Render-target syncs and write-back under the write watch: a software watch
+ * over guest 0x100000..0x140000 (watch_fake), and the real module on a
+ * section mapped twice plus its writer view (watch_real). In the software
+ * watch, watch_write does what the fault handler does; a plain store into
+ * ram is a writer the stamps cannot see. */
+#include "../../src/kernel/guest_write_watch.h"
+
+#define FW_BASE 0x100000u
+#define FW_PAGES 64u
+#define FW_ARMED 1u
+
+static uint64_t fw_clock, fw_stamp[FW_PAGES], fw_faults, fw_pages;
+static uint8_t fw_flag[FW_PAGES];
+
+static int fw_span(uint32_t va, uint32_t bytes, unsigned *first, unsigned *last)
+{
+    if (!bytes || va < FW_BASE || (uint64_t)va - FW_BASE + bytes > (uint64_t)FW_PAGES * 4096u)
+        return 0;
+    *first = (va - FW_BASE) / 4096u;
+    *last = (va - FW_BASE + bytes - 1) / 4096u;
+    return 1;
+}
+static int fw_covers(uint32_t va, uint32_t bytes) { unsigned a, b; return fw_span(va, bytes, &a, &b); }
+static uint64_t fw_arm(const GwwRange *r, int n, int *complete)
+{
+    int i; unsigned p, a, b;
+    *complete = 1;
+    for (i = 0; i < n; ++i) {
+        if (!fw_span(r[i].va, r[i].bytes, &a, &b)) { *complete = 0; continue; }
+        for (p = a; p <= b; ++p)
+            if (!(fw_flag[p] & FW_ARMED)) { fw_flag[p] |= FW_ARMED; ++fw_pages; }
+    }
+    return fw_clock;
+}
+static int fw_clean(const GwwRange *r, int n, uint64_t since)
+{
+    int i; unsigned p, a, b;
+    for (i = 0; i < n; ++i) {
+        if (!fw_span(r[i].va, r[i].bytes, &a, &b)) return 0;
+        for (p = a; p <= b; ++p)
+            if (!(fw_flag[p] & FW_ARMED) || fw_stamp[p] > since) return 0;
+    }
+    return 1;
+}
+static void fw_stats(uint64_t *faults, uint64_t *pages) { *faults = fw_faults; *pages = fw_pages; }
+/* The software watch has no protection, so its writer view is guest memory. */
+static uint8_t *fw_writer(uint32_t va, uint32_t bytes)
+{
+    return fw_covers(va, bytes) ? ram + va : NULL;
+}
+static uint64_t fw_wrote(const GwwRange *r, int n, uint64_t prior, int *still)
+{
+    int i; unsigned p, a, b;
+    *still = 1;
+    for (i = 0; i < n; ++i) {
+        if (!fw_span(r[i].va, r[i].bytes, &a, &b)) { *still = 0; continue; }
+        for (p = a; p <= b; ++p)
+            if (!(fw_flag[p] & FW_ARMED) || fw_stamp[p] > prior) *still = 0;
+        for (p = a; p <= b; ++p) fw_stamp[p] = ++fw_clock;
+    }
+    return fw_clock;
+}
+static const GwwOps fw_ops = { fw_covers, fw_arm, fw_clean, fw_stats, fw_writer, fw_wrote };
+
+static void watch_write(uint32_t va, uint32_t value)
+{
+    unsigned p, a, b;
+    if (fw_span(va, 4, &a, &b))
+        for (p = a; p <= b; ++p) {
+            if (fw_flag[p] & FW_ARMED) { fw_flag[p] &= ~FW_ARMED; ++fw_faults; }
+            fw_stamp[p] = ++fw_clock;
+        }
+    memcpy(ram + va, &value, 4);
+}
+
+static uint32_t guest_word(uint32_t va)
+{
+    uint32_t v;
+    memcpy(&v, (const uint8_t *)xbox_GetMemoryOffset() + va, 4);
+    return v;
+}
+
+/* One kick's sync of s. Returns whether the guest bytes were hashed. */
+static int synced_with_hash(Surface *s)
+{
+    uint64_t before = s_prof_sync_bytes;
+    nv2a_d3d_kick();
+    surface_sync(s, 0);
+    return s_prof_sync_bytes != before;
+}
+
+static void write_back_all(void)
+{
+    writeback_surfaces();
+    CHECK(writeback_finish(1));
+}
+
+static void test_watch_fake(void)
+{
+    Surface *a, *c, *p, *q, *z;
+    uint32_t gen, i;
+    uint64_t kept;
+    s_prof_on = 1;
+    nv2a_d3d_set_write_watch(&fw_ops);
+
+    a = surface_get(FW_BASE, 32 * 4, 8, 32, 16, 0);
+    CHECK(a && a->watch_ok);
+    gen = a->gen;
+    CHECK(!synced_with_hash(a) && a->gen == gen && s_prof_sync_watch_clean == 1);
+    /* Write-back stores through the writer view and keeps the snapshot. */
+    clear_gpu(a);
+    kept = s_prof_wb_watch_kept;
+    write_back_all();
+    CHECK(s_prof_wb_watch_kept == kept + 1 && (guest_word(a->va) & 0xFFFFFFu) == 0xFF0000u);
+    CHECK(!synced_with_hash(a) && a->gen == gen);
+    /* A CPU write after write-back is caught and uploaded. */
+    watch_write(a->va + 5 * a->pitch + 3 * 4, 0xFF00FF00u);
+    CHECK(synced_with_hash(a) && a->gen == gen + 1 && pixel(a, 3, 5) == 0xFF00FF00u);
+    CHECK(!synced_with_hash(a) && a->gen == gen + 1);
+    /* Before the next write-back the CPU writes again: write-back skips that
+     * row (the title's write wins) and the surface must re-read. */
+    clear_gpu(a);
+    watch_write(a->va + 2 * a->pitch, 0xFF0000FFu);
+    write_back_all();
+    CHECK(guest_word(a->va + 2 * a->pitch) == 0xFF0000FFu);
+    CHECK(synced_with_hash(a) && pixel(a, 0, 2) == 0xFF0000FFu);
+    puts("PASS: unwritten targets skip the sync hash; write-back keeps that; CPU writes are caught");
+
+    /* Swizzled targets: the raw check is skipped the same way. */
+    c = surface_get(FW_BASE + 0x8000, 32 * 4, 8, 32, 16, 1);
+    CHECK(c && c->watch_ok);
+    gen = c->gen;
+    CHECK(!synced_with_hash(c) && c->gen == gen);
+    watch_write(c->va + 4 * (3 + 8 + 48), 0xFF0000FFu);       /* Morton (5,7) */
+    CHECK(synced_with_hash(c) && c->gen == gen + 1 && pixel(c, 5, 7) == 0xFF0000FFu);
+    CHECK(!synced_with_hash(c));
+    puts("PASS: swizzled targets skip unwritten syncs and catch CPU writes");
+
+    /* Two targets on one page: one's write-back re-reads the other, which
+     * finds its own bytes unchanged. */
+    p = surface_get(FW_BASE + 0x10000, 8 * 4, 8, 8, 4, 0);
+    q = surface_get(FW_BASE + 0x10200, 8 * 4, 8, 8, 4, 0);
+    CHECK(p && q && p->watch_ok && q->watch_ok);
+    CHECK(!synced_with_hash(p) && !synced_with_hash(q));
+    clear_gpu(p);
+    write_back_all();
+    gen = q->gen;
+    CHECK(!synced_with_hash(p));
+    CHECK(synced_with_hash(q) && q->gen == gen);
+    CHECK(!synced_with_hash(q));
+    watch_write(q->va + 4, 0xFF123456u);
+    CHECK(synced_with_hash(p) && synced_with_hash(q) && q->gen == gen + 1);
+    puts("PASS: targets sharing a page re-read after each other's write-back and CPU writes");
+
+    /* A writer the stamps cannot see: verify mode hashes, uploads like no
+     * watch and reports it. */
+    {
+        uint32_t v = 0xFF445566u;
+        memcpy(ram + a->va + 9 * a->pitch, &v, 4);
+        gen = a->gen;
+        CHECK(!synced_with_hash(a) && a->gen == gen);          /* normal mode keeps it */
+        s_watch_verify = 1;
+        CHECK(synced_with_hash(a) && a->gen == gen + 1 && s_watch_missed == 1);
+        CHECK(pixel(a, 0, 9) == v);
+        CHECK(synced_with_hash(a) && s_watch_missed == 1);     /* re-armed, consistent */
+        s_watch_verify = 0;
+    }
+    puts("PASS: verify mode hashes clean targets and reports a write the stamps missed");
+
+    /* Written on WATCH_STOP consecutive syncs: hashed for a while. */
+    for (i = 0; i < WATCH_STOP; ++i) {
+        watch_write(a->va + 4 * i, 0xFF000000u + i);
+        CHECK(synced_with_hash(a));
+    }
+    CHECK(!a->watch_ok && a->watch_retry);
