+# Window clipping GPU contracts
+
+The fixture includes the production renderer, submits real draws and reads all
+pixels back from the selected D3D11 GPU. Generic and specialized runs cover
+upper/lower views, inclusive maxima, region seven, disjoint regions, exclusive
+clipping, unwritten regions and empty rectangles at 1x/4x MSAA and scale 1/3.
+Specialized runs explicitly wait for and verify the actual bound specialized
+shader instead of accepting its generic fallback.
+
+Additional cases independently map authored clipping regions to wide and
+portrait menu canvases, covering both the scissor fast path and pixel rejection.
+The fixture uses synthetic RAM, no game assets, saved settings or visible window.
+
+Configure this directory with CMake/Ninja in a temporary build folder after
+activating `scripts/enter-env.ps1`, then build and run CTest. The game repository's
+`tests/mm3_window_clip_regression.py` separately checks production pushbuffer
+method decoding and state export.
diff --git a/tests/nv2a_window_clip/test_window_clip.c b/tests/nv2a_window_clip/test_window_clip.c
new file mode 100644
index 0000000..a67878a
--- /dev/null
+++ b/tests/nv2a_window_clip/test_window_clip.c
@@ -0,0 +1,206 @@
+/* Real D3D11 pixels from production draw/setup/shaders. The independent
+ * oracle evaluates authored rectangles in guest coordinates, including the
+ * fitted menu canvas, rather than inspecting generated clip constants. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x200000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch)
+{ (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ (void)version; return NULL; }
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); \
+} } while (0)
+
+typedef struct { unsigned index, left, top, right, bottom; } ClipRectangle;
+typedef struct {
+    const char *name;
+    unsigned exclusive, count;
+    ClipRectangle rectangle[2];
+} ClipCase;
+static const ClipCase cases[] = {
+    {"unwritten",0,0},
+    {"upper",0,1,{{0,0,0,63,31}}},
+    {"lower",0,1,{{0,0,32,63,63}}},
+    {"inclusive_one_pixel",0,1,{{0,5,9,5,9}}},
+    {"region_seven",0,1,{{7,8,16,15,31}}},
+    {"two_disjoint",0,2,{{0,0,0,15,15},{3,48,48,63,63}}},
+    {"exclusive",1,1,{{0,16,16,47,47}}},
+    {"exclusive_unwritten",1,0},
+    {"reversed_empty",0,1,{{0,20,0,10,63}}},
+    {"outside_empty",0,1,{{0,80,0,90,63}}}
+};
+static const ClipCase canvas_cases[] = {
+    {"canvas_scissor",0,1,{{0,80,120,159,199}}},
+    {"canvas_region_seven",0,1,{{7,80,120,159,199}}},
+    {"canvas_disjoint",0,2,{{0,80,120,159,199},{7,440,280,519,359}}},
+    {"canvas_exclusive",1,1,{{7,80,120,159,199}}}
+};
+static int specialized;
+
+static NvD3DState make_state(unsigned width, unsigned height, const ClipCase *c)
+{
+    NvD3DState st = {0};
+    unsigned n;
+    st.color_addr = 0x20000; st.color_pitch = width * 4;
+    st.surface_format = 0x28; st.clip_w = width; st.clip_h = height;
+    st.color_mask = 0x01010101; st.blend_sfactor = 1;
+    st.blend_equation = 0x8006; st.front_face = 0x901;
+    st.wclip_type = c->exclusive;
+    for (n = 0; n < c->count; ++n) {
+        const ClipRectangle *r = &c->rectangle[n];
+        st.wclip_mask |= 1u << r->index;
+        st.wclip_h[r->index] = r->left | r->right << 16;
+        st.wclip_v[r->index] = r->top | r->bottom << 16;
+    }
+    return st;
+}
+
+static ID3D11PixelShader *prepare_shader(const NvD3DState *st)
+{
+    Surface *target;
+    uint32_t w, h, zmax;
+    ID3D11PixelShader *shader;
+    ULONGLONG deadline;
+    CHECK(setup_pipeline(st,NV_D3D_TRIANGLES,&target,&w,&h,&zmax));
+    if (!specialized) return s_psv[0];
+    deadline = GetTickCount64() + 20000;
+    while (!(shader = spec_ps(&s_uploaded_pc,0))) {
+        CHECK(GetTickCount64() < deadline);
+        Sleep(1);
+    }
+    return shader;
+}
+
+static void draw_full(const NvD3DState *st)
+{
+    float position[4][4] = {
+        {-4,-4,0,1}, {0,-4,0,1}, {0,0,0,1}, {-4,0,0,1}
+    };
+    NvD3DAttrib attributes[16] = {0};
+    float defaults[16][4] = {{0}};
+    uint32_t indices[6] = {0,1,2,0,2,3};
+    ID3D11PixelShader *expected_shader;
+    position[1][0] = position[2][0] = st->clip_w + 4.f;
+    position[2][1] = position[3][1] = st->clip_h + 4.f;
+    attributes[0] = (NvD3DAttrib){1,2,4,16,(const uint8_t *)position};
+    defaults[3][1] = defaults[3][3] = 1;
+    expected_shader = prepare_shader(st);
+    nv2a_d3d_draw_ub(st,NV_D3D_TRIANGLES,attributes,defaults,0,indices,6,0,3,NULL);
+    CHECK(s_bound_ps_valid && s_bound_ps == expected_shader);
+}
+
+static uint32_t *read_surface(Surface *source)
+{
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC description;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    uint32_t *pixels = malloc((size_t)source->iw * source->ih * 4);
+    unsigned y;
+    CHECK(pixels);
+    surface_resolve(source);
+    ID3D11Texture2D_GetDesc(source->tex,&description);
+    description.Usage = D3D11_USAGE_STAGING;
+    description.BindFlags = description.MiscFlags = 0;
+    description.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&description,NULL,&staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)staging,
+                                    (ID3D11Resource *)source->tex);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)staging,
+        0,D3D11_MAP_READ,0,&mapped)));
+    for (y = 0; y < source->ih; ++y)
+        memcpy(pixels + (size_t)y * source->iw,
+               (const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch,source->iw * 4);
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)staging,0);
+    ID3D11Texture2D_Release(staging);
+    return pixels;
+}
+
+static int contains(const ClipCase *c, double x, double y)
+{
+    unsigned n;
+    int inside = 0;
+    if (!c->count && !c->exclusive) return 1;
+    for (n = 0; n < c->count; ++n) {
+        const ClipRectangle *r = &c->rectangle[n];
+        if (x >= r->left && x < r->right + 1. &&
+            y >= r->top && y < r->bottom + 1.) inside = 1;
+    }
+    return c->exclusive ? !inside : inside;
+}
+
+static void check_case(const ClipCase *c, unsigned width, unsigned height,
+                       unsigned samples, unsigned scale, float aspect)
+{
+    NvD3DState st = make_state(width,height,c);
+    Surface *target;
+    uint32_t *pixels;
+    unsigned x, y, accepted = 0;
+    double sx = scale, sy = scale, xfit = 1, yfit = 1, margin_x = 0, margin_y = 0;
+    s_msaa = samples; s_scale = (float)scale; s_aspect = aspect;
+    s_frame_bg_tex = 0; nv2a_d3d_set_edge_hud(0);
+    nv2a_d3d_clear(&st,0xF0,0xFF000000,0,0,0,width-1,height-1);
+    draw_full(&st);
+    target = surface_find(st.color_addr); CHECK(target);
+    CHECK((target->ms != NULL) == (samples > 1));
+    if (width == 640 && height == 480) {
+        sx *= aspect * .75;
+        xfit = fmin(1.,(4./3.) / aspect);
+        yfit = fmin(1.,aspect / (4./3.));
+        margin_x = width * .5 * (1 - xfit);
+        margin_y = height * .5 * (1 - yfit);
+    }
+    pixels = read_surface(target);
+    for (y = 0; y < target->ih; ++y) for (x = 0; x < target->iw; ++x) {
+        double gx = ((x + .5) / sx - margin_x) / xfit;
+        double gy = ((y + .5) / sy - margin_y) / yfit;
+        int visible = gx >= 0 && gx < width && gy >= 0 && gy < height && contains(c,gx,gy);
+        uint32_t expected = visible ? 0xFF00FF00u : 0xFF000000u;
+        uint32_t actual = pixels[(size_t)y * target->iw + x];
+        if (actual != expected) {
+            fprintf(stderr,"case=%s samples=%u scale=%u aspect=%g host=%u,%u guest=%g,%g expected=%08X actual=%08X\n",
+                    c->name,samples,scale,aspect,x,y,gx,gy,expected,actual);
+            exit(1);
+        }
+        accepted += visible != 0;
+    }
+    if (strstr(c->name,"empty")) CHECK(!accepted);
+    else CHECK(accepted);
+    /* Ordinary region zero remains entirely in the scissor path. */
+    CHECK(s_uploaded_pc.wclip_mode == (wclip_scissored(&st) ? 0u : c->exclusive ? 2u : 1u));
+    free(pixels);
+    surface_release(target);
+}
+
+int main(int argc, char **argv)
+{
+    unsigned sample, scale, n, a, count = 0;
+    const unsigned samples[] = {1,4}, scales[] = {1,3};
+    const float aspects[] = {2.f,1.f};
+    CHECK(argc == 2); specialized = atoi(argv[1]) != 0;
+    _putenv_s("RECOMP_MSAA","4");
+    _putenv_s("RECOMP_RENDER_SCALE","1");
+    _putenv_s("RECOMP_ASPECT","4:3");
+    _putenv_s("RECOMP_PS_SPEC",specialized ? "1" : "0");
+    _putenv_s("RECOMP_PS_PREWARM","0");
+    _putenv_s("RECOMP_FPS_LIMIT","0");
+    CHECK(nv2a_d3d_init() && s_msaa == 4);
+    for (sample = 0; sample < 2; ++sample) for (scale = 0; scale < 2; ++scale) {
+        for (n = 0; n < sizeof cases / sizeof cases[0]; ++n) {
+            check_case(&cases[n],64,64,samples[sample],scales[scale],4.f/3.f);
+            ++count;
+        }
+        for (a = 0; a < 2; ++a) for (n = 0; n < sizeof canvas_cases / sizeof canvas_cases[0]; ++n) {
+            check_case(&canvas_cases[n],640,480,samples[sample],scales[scale],aspects[a]);
+            ++count;
+        }
+    }
+    printf("PASS: %u real GPU clip cases, specialized=%d; upper/lower viewports, inclusive last pixel, all-region mask, disjoint/exclusive/empty, 1x/4x MSAA, scale1/3 and wide/portrait canvas coordinates\n",count,specialized);
+    return 0;
+}
