+foreach(case panorama gates depth placement map_placement map_improved menu_canvas aspect_control haze_depth haze_gates haze_coverage)
+    add_test(NAME nv2a_graphics_quality_${case} COMMAND nv2a_graphics_quality ${case})
+endforeach()
