+        nv2a_d3d_set_local_light_softness(soft);
+        for (step = 0; step <= 24; ++step) {
+            float x = (16.5f + 15.0f * step / 24) / 32;
+            uint32_t value;
+            nv2a_d3d_clear(&st,0xF1,0xA5000000,
+                (uint32_t)(.25f * 16777215.0f) << 8,0,0,63,63);
+            light_draw(&st,x,16.5f/32,16.5f/32,.25f,.125f);
+            value = pixel(target,(unsigned)(32 * target->sx),(unsigned)(32 * target->sy));
+            values[soft][step] = value & 255;
+            CHECK((value >> 24) == 0xA5);
+            if (step) {
+                unsigned previous = values[soft][step - 1], current = values[soft][step];
+                CHECK(current <= previous + 2);
+                if (previous > current && previous - current > largest_step)
+                    largest_step = previous - current;
+            }
+            if (soft) {
+                float a = values[0][step] / 255.0f;
+                float expected = 255 * a * a * (3 - 2 * a);
+                CHECK(fabsf((float)values[soft][step] - expected) <= 2.0f);
+            }
+        }
+        CHECK(values[soft][24] < values[soft][0] / 3);
+    }
+    nv2a_d3d_set_local_light_softness(0);
+    printf("retail %s gradient: center/edge %u/%u, eased %u/%u, largest 1/24-radius step %u\n",
+        spot ? "spot" : "point",values[0][0],values[0][24],values[1][0],values[1][24],largest_step);
+    /* Smaller than one fifth of the buffer's range, including the steeper
+     * eased midrange: no single slice or source boundary can appear as a
+     * large intensity step in this radial sweep. */
+    CHECK(largest_step < 51);
+    return 0;
+}
+#endif
+
+static int retail_volume(NvD3DState st, Surface *target, const char *path, int spot)
+{
+    uint8_t header[128];
+    FILE *f = fopen(path,"rb");
+    size_t bytes;
+    CHECK(f); CHECK(fread(header,1,128,f) == 128);
+    CHECK(!memcmp(header,"DDS ",4));
+    bytes = fread(ram+0x100000,1,37440,f); fclose(f); CHECK(bytes == 37440);
+    st.tex[3].levels = 4; st.tex[3].format |= 4 << 16;
+    nv2a_d3d_kick();
+    CHECK(!sample_light(&st,target,spot ? "retail-spot-center" : "retail-point-center",
+        16.5f/32,16.5f/32,16.5f/32,spot ? 173 : 255,.125f));
+    CHECK(!sample_light(&st,target,spot ? "retail-spot-first" : "retail-point-first",
+        16.5f/32,16.5f/32,.5f/32,spot ? 254 : 13,.125f));
+    CHECK(!sample_light(&st,target,spot ? "retail-spot-last" : "retail-point-last",
+        16.5f/32,16.5f/32,31.5f/32,spot ? 0 : 13,.125f));
+#ifndef VOLUME_OLD_RENDERER
+    CHECK(!check_retail_gradient(st,target,spot));
+#endif
+    return 0;
+}
+
+#ifndef LIGHT_VOLUME_MAIN
+#define LIGHT_VOLUME_MAIN main
+#endif
+int LIGHT_VOLUME_MAIN(int argc, char **argv)
+{
+    NvD3DState st = {0};
+    Surface *target;
+    uint32_t gw,gh,zmax;
+    ram = calloc(1,0x400000); CHECK(ram);
+    _putenv_s("RECOMP_MSAA",argc > 1 ? argv[1] : "1");
+    _putenv_s("RECOMP_RENDER_SCALE",argc > 2 ? argv[2] : "1");
+    _putenv_s("RECOMP_PS_SPEC",argc == 4 ? argv[3] : argc > 5 ? argv[5] : "0");
+    _putenv_s("RECOMP_PS_PREWARM","0");
+    _putenv_s("RECOMP_FPS_LIMIT","0");
+    CHECK(nv2a_d3d_init());
+    st.color_addr = 0x10000; st.zeta_addr = 0x80000;
+    st.color_pitch = st.zeta_pitch = 256; st.surface_format = 0x28;
+    st.clip_w = st.clip_h = 64; st.color_mask = 0x10101;
+    st.depth_test = 1; st.depth_func = 0x203;
+    native_light_state(&st);
+    st.tex[0].addr = st.zeta_addr; st.tex[0].color = 0x35;
+    st.tex[0].width = 128; st.tex[0].height = 64; st.tex[0].pitch = 256;
+    st.tex[0].levels = 1; st.tex[0].filter = 0x02062000;
+    st.tex[3].addr = 0x100000; st.tex[3].color = 0x0F;
+    st.tex[3].width = st.tex[3].height = st.tex[3].depth = 32;
+    st.tex[3].format = (5u<<28) | (5u<<24) | (5u<<20) | (0xFu<<8) | (3u<<4);
+    st.tex[3].levels = 1; st.tex[3].filter = 0x01010000;
+    st.tex[3].address = 0x30303;
+    CHECK(make_field(ram+0x100000,32,32,32,1) == 32768);
+    nv2a_d3d_set_depth_view_remap(1.26666667f,.78f);
+    CHECK(setup_pipeline(&st,NV_D3D_TRIANGLES,&target,&gw,&gh,&zmax)); CHECK(target);
+    CHECK(!sample_light(&st,target,"center",.5f,.5f,.5f,255,.125f));
+    CHECK(!sample_light(&st,target,"first-z",.5f,.5f,.015625f,0,.125f));
+    CHECK(!sample_light(&st,target,"last-z",.5f,.5f,.984375f,0,.125f));
+    CHECK(!sample_light(&st,target,"off-volume",0,.5f,.5f,0,.125f));
+    CHECK(!sample_light(&st,target,"depth-occluded",.5f,.5f,.5f,0,.5f));
+#ifndef VOLUME_OLD_RENDERER
+    CHECK(!check_depth_views(depth_find(st.zeta_addr)));
+#endif
+    if (argc > 4) {
+        CHECK(!retail_volume(st,target,argv[3],0));
+        CHECK(!retail_volume(st,target,argv[4],1));
+    }
+    CHECK(!check_projector_directions(st,target));
+    CHECK(!check_retail_rows(st,target));
+    CHECK(!check_offscreen_source(st,target));
+    CHECK(!check_light_overlap(st,target));
+#ifndef VOLUME_OLD_RENDERER
+    CHECK(!check_bounded_light_overlap(st,target));
+    CHECK(!check_soft_profile(st,target));
+    CHECK(!check_depth_byte_interpolation(st,target));
+    CHECK(!check_short_mips(st,target));
+    CHECK(!check_projective_color_volume(st,target));
+#endif
+    puts("PASS: native LightDraw 3D attenuation, Z/XY extent, scene depth and RGB-only output mask");
+    return 0;
+}
diff --git a/tests/nv2a_world_lighting/test_world_lighting.c b/tests/nv2a_world_lighting/test_world_lighting.c
new file mode 100644
index 0000000..8d3da10
--- /dev/null
+++ b/tests/nv2a_world_lighting/test_world_lighting.c
@@ -0,0 +1,250 @@
+/* Production GPU replay of MM3's native LightApplyTex composition. */
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t *ram;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4]
+{
+    *start = 0; *version = 1;
+    return NULL;
+}
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{
+    *version = 1;
+    return NULL;
+}
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+/* Specialized shaders compile asynchronously in production. Explicitly wait
+ * for this draw's exact key so the specialized tests cannot silently pass on
+ * the generic fallback while a worker is still compiling. */
+static void fixture_prepare_shader(const NvD3DState *st)
+{
+    Surface *surface;
+    uint32_t gw, gh, zmax;
+    ULONGLONG deadline;
+    const char *mode = getenv("RECOMP_PS_SPEC");
+    if (!mode || *mode == '0') return;
+    if (!setup_pipeline(st,NV_D3D_TRIANGLES,&surface,&gw,&gh,&zmax)) {
+        fprintf(stderr,"FAIL: specialization fixture pipeline setup\n"); exit(1);
+    }
+    deadline = GetTickCount64() + 15000;
+    while (!spec_ps(&s_uploaded_pc,0)) {
+        if (GetTickCount64() > deadline) {
+            fprintf(stderr,"FAIL: exact specialized shader was not compiled\n"); exit(1);
+        }
+        Sleep(1);
+    }
+}
+
+static uint32_t pixel(Surface *surface, unsigned x, unsigned y)
+{
+    ID3D11Texture2D *staging = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    uint32_t result = 0xDEADBEEFu;
+    surface_resolve(surface);
+    ID3D11Texture2D_GetDesc(surface->tex, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging))) return result;
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)surface->tex);
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped))) {
+        memcpy(&result, (uint8_t *)mapped.pData + y * mapped.RowPitch + x * 4, 4);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11Texture2D_Release(staging);
+    return result;
+}
+
+/* Register-combiner words and constants observed in the 16 October 2026
+ * player-front night capture, out/headlight-player-qa/baseline-stderr.log:
+ * ctl=00011108, prog=00021, final=080F000C/0D1A0080. This is the installed
+ * Light/LightApplyTex.psh, including the t0.rgb*t1.rgb local-light term.
+ * Only authored ambient/diffuse/backlight colors vary between test cases.
+ * Specular (0x00989898) and the native .75/.5/glow constants stay captured. */
+static void native_composite_state(NvD3DState *st, uint32_t world)
+{
+    static const uint32_t color_icw[8] = {
+        0xD820D140,0xC120C420,0x0DC1C22D,0xD820D140,
+        0x1CCCC53C,0xC8C920CC,0x1C31CC3C,0xC8CC0000
+    };
+    static const uint32_t alpha_icw[8] = {
+        0xD830D830,0xD8303250,0x31301850,0x1C301D30,
+        0xD830D150,0,0x0A3C1010,0
+    };
+    static const uint32_t color_ocw[8] = {
+        0x00020D00,0x00004C00,0x00000D00,0x00020A00,
+        0x00000C00,0x00000C00,0x00000C00,0x000200C0
+    };
+    static const uint32_t alpha_ocw[8] = {
+        0x00000C00,0x00020C00,0x00020D00,0x00000C00,
+        0x00020C00,0,0x000000A0,0
+    };
+    st->rc_seen = 1;
+    st->rc.control = 0x00011108;
+    st->rc.stage_program = 0x00021;
+    st->rc.final0 = 0x080F000C;
+    st->rc.final1 = 0x0D1A0080;
+    memcpy(st->rc.color_icw, color_icw, sizeof color_icw);
+    memcpy(st->rc.alpha_icw, alpha_icw, sizeof alpha_icw);
+    memcpy(st->rc.color_ocw, color_ocw, sizeof color_ocw);
+    memcpy(st->rc.alpha_ocw, alpha_ocw, sizeof alpha_ocw);
+    st->rc.factor0[0] = st->rc.factor0[2] = st->rc.factor0[4] =
+        st->rc.factor0[6] = st->rc.factor1[1] = 0xBFFFFFFF;
+    st->rc.factor0[1] = world;
+    st->rc.factor1[2] = 0x00989898;
+    st->rc.factor0[3] = 0x80000000;
+}
+
+static void clear_source(const NvD3DState *target, uint32_t address, uint32_t color,
+                         uint32_t x0, uint32_t x1)
+{
+    NvD3DState source = *target;
+    source.color_addr = address;
+    nv2a_d3d_clear(&source, 0xF0, color, 0, x0, 0, x1, 63);
+}
+
+static void draw_native_composite(const NvD3DState *st, unsigned world)
+{
+    static const uint32_t indices[] = {0,1,2,2,1,3};
+    static const float position[4][4] = {{0,0,0,1},{64,0,0,1},{0,64,0,1},{64,64,0,1}};
+    static const float uv[4][2] = {{0,0},{64,0},{0,64},{64,64}};
+    NvD3DAttrib attr[16] = {{0}};
+    float defaults[16][4] = {{0}};
+    unsigned n;
+    attr[0].enabled = 1; attr[0].type = 2; attr[0].size = 4;
+    attr[0].stride = sizeof position[0]; attr[0].data = (const uint8_t *)position;
+    for (n = 9; n < 11; ++n) {
+        attr[n].enabled = 1; attr[n].type = attr[n].size = 2;
+        attr[n].stride = sizeof uv[0]; attr[n].data = (const uint8_t *)uv;
+    }
+    for (n = 0; n < 3; ++n) defaults[3][n] = defaults[4][n] = world / 255.0f;
+    defaults[3][3] = defaults[4][3] = 1;
+    fixture_prepare_shader(st);
+    nv2a_d3d_draw_ub(st, NV_D3D_TRIANGLES, attr, defaults, 0, indices, 6, 0, 3, NULL);
+}
+
+static int check_material(NvD3DState st, Surface *target, unsigned world,
+                          unsigned material, unsigned local)
+{
+    uint32_t surrounding, illuminated;
+    unsigned dark, lit;
+    native_composite_state(&st, world * 0x010101u);
+    /* Material alpha belongs to the unlit frame, independent of output alpha.
+     * Clear the output to a sentinel so alpha damage cannot be hidden. */
+    clear_source(&st, 0x20000, (material << 24) | 0x00404040, 0, 63);
+    clear_source(&st, 0x30000, 0xFF000000, 0, 63);
+    if (local) clear_source(&st, 0x30000, 0xFF808080, 32, 63);
+    clear_source(&st, st.color_addr, 0xA5000000, 0, 63);
+    draw_native_composite(&st, world);
+    surrounding = pixel(target, (unsigned)(16 * target->sx), (unsigned)(32 * target->sy));
+    illuminated = pixel(target, (unsigned)(48 * target->sx), (unsigned)(32 * target->sy));
+    CHECK((surrounding >> 24) == 0xA5 && (illuminated >> 24) == 0xA5);
+    CHECK(((surrounding >> 16) & 255) == ((surrounding >> 8) & 255));
+    CHECK(((surrounding >> 8) & 255) == (surrounding & 255));
+    CHECK(((illuminated >> 16) & 255) == ((illuminated >> 8) & 255));
+    CHECK(((illuminated >> 8) & 255) == (illuminated & 255));
+    dark = surrounding & 255; lit = illuminated & 255;
+    if (material == 255) {
+        /* Emissive pixels retain their 64/255 authored texture intensity,
+         * independently of base lighting and the local-light buffer. */
+        CHECK(dark == 64 && lit == 64);
+    } else if (world <= 4) {
+        CHECK(dark <= 6);
+        if (local) CHECK(lit >= 31 && lit <= 39 && lit > dark * 5);
+        else CHECK(lit == dark);
+    } else {
+        /* Bright authored daytime colors are composed normally, rather than
+         * inheriting a low night multiplier or becoming globally dark. */
+        CHECK(dark >= 127 && dark <= 131);
+        if (local) CHECK(lit >= dark + 30 && lit <= dark + 34);
+        else CHECK(lit == dark);
+    }
+    printf("world=%u material=%u local=%u surrounding=%u illuminated=%u alpha=%02X\n",
+           world, material, local, dark, lit, surrounding >> 24);
+    return 0;
+}
+
+/* Title-requested local-light gain: the composite's t0.rgb * t1.rgb term reads
+ * the light buffer through gain, capped at 3 after scaling. A 64/255 material
+ * lit by a 0.5 buffer adds 4 * .25 * .25 * .5 = 32/255 at gain 1. */
+static int check_gain(NvD3DState st, Surface *target, float gain, unsigned world,
+                      unsigned lo, unsigned hi, uint32_t light)
+{
+    uint32_t surrounding, illuminated;
+    unsigned dark, lit;
+    nv2a_d3d_set_local_light_gain(gain);
+    native_composite_state(&st, world * 0x010101u);
+    clear_source(&st, 0x20000, 0x00404040, 0, 63);
+    clear_source(&st, 0x30000, 0xFF000000, 0, 63);
+    clear_source(&st, 0x30000, light, 32, 63);
+    clear_source(&st, st.color_addr, 0xA5000000, 0, 63);
+    draw_native_composite(&st, world);
+    surrounding = pixel(target, (unsigned)(16 * target->sx), (unsigned)(32 * target->sy));
+    illuminated = pixel(target, (unsigned)(48 * target->sx), (unsigned)(32 * target->sy));
+    dark = surrounding & 255; lit = illuminated & 255;
+    printf("gain=%.1f world=%u light=%02X overlap=%d surrounding=%u illuminated=%u (expected %u..%u)\n",
+           gain, world, light & 255, s_local_light_overlap, dark, lit, lo, hi);
+    CHECK((surrounding >> 24) == 0xA5 && (illuminated >> 24) == 0xA5);
+    CHECK(lit >= lo && lit <= hi);
+    CHECK(dark <= 6 || world > 4);   /* unlit surroundings never gain light */
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    NvD3DState st = {0};
+    Surface *target;
+    static const unsigned worlds[] = {0,4,128};
+    static const unsigned materials[] = {0,64,128,255};
+    unsigned w, m, local, n;
+    ram = calloc(1, 0x400000);
+    CHECK(ram);
+    _putenv_s("RECOMP_MSAA", argc > 1 ? argv[1] : "1");
+    _putenv_s("RECOMP_RENDER_SCALE", argc > 2 ? argv[2] : "1");
+    _putenv_s("RECOMP_PS_SPEC", argc > 3 ? argv[3] : "0");
+    _putenv_s("RECOMP_PS_PREWARM", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    st.color_addr = 0x10000; st.color_pitch = 64 * 4;
+    st.surface_format = 8; st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x00010101; /* Preserve the original output alpha. */
+    for (n = 0; n < 2; ++n) {
+        st.tex[n].addr = n ? 0x30000 : 0x20000;
+        st.tex[n].color = 0x12; st.tex[n].pitch = 64 * 4;
+        st.tex[n].width = st.tex[n].height = 64; st.tex[n].levels = 1;
+        st.tex[n].filter = 0x02062000;
+    }
+    target = surface_get(st.color_addr, st.color_pitch, st.surface_format, 64, 64, 0);
+    CHECK(target);
+    for (w = 0; w < sizeof worlds / sizeof worlds[0]; ++w)
+        for (m = 0; m < sizeof materials / sizeof materials[0]; ++m)
+            for (local = 0; local < 2; ++local)
+                CHECK(!check_material(st, target, worlds[w], materials[m], local));
+    /* Gain 1 is retail (above). Gain 3 triples the buffer: 1.5 -> 96/255. Gain 8
+     * and 3 on a full buffer both hit the cap of 3: 4 * .25 * .25 * 3 = 191. */
+    CHECK(!check_gain(st, target, 1.0f, 0, 31, 39, 0xFF808080));
+    CHECK(!check_gain(st, target, 1.3f, 0, 39, 47, 0xFF808080));
+    CHECK(!check_gain(st, target, 3.0f, 0, 92, 101, 0xFF808080));
+    CHECK(!check_gain(st, target, 8.0f, 0, 186, 196, 0xFF808080));
+    CHECK(!check_gain(st, target, 3.0f, 4, 92, 104, 0xFF808080));
+    /* Title overlap policy: a buffer below the 0.6 knee (one lamp) is
+     * unchanged, while a saturated buffer (many overlapping headlights)
+     * eases to about 0.8 before gain: 4 * .25 * .25 * 1.3 * .8 = 66/255
+     * instead of 83/255. */
+    CHECK(!check_gain(st, target, 1.3f, 0, 79, 87, 0xFFFFFFFF));
+    nv2a_d3d_set_local_light_overlap(1);
+    CHECK(!check_gain(st, target, 1.3f, 0, 39, 47, 0xFF808080));
+    CHECK(!check_gain(st, target, 1.3f, 0, 62, 71, 0xFFFFFFFF));
+    nv2a_d3d_set_local_light_overlap(0);
+    nv2a_d3d_set_local_light_gain(1.0f);
+    puts("PASS: native LightApplyTex GPU replay retains local-light contrast in dark scenes, authored daylight, emissive pixels and material/output alpha");
+    return 0;
+}
