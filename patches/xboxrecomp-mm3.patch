+static void light_draw_note(const NvD3DState *st, const Surface *s, uint32_t gw, uint32_t gh,
+                            const NvD3DAttrib attr[16], int program,
+                            uint32_t ni, const uint32_t *idx, uint32_t lo, const float (*pos)[4])
+{
+    static int announced;
+    uint32_t k;
+    if (!announced) {
+        announced = 1;
+        fprintf(stderr, "[D3D11_LIGHT] LightDraw: dot_rgb_mapping %08X other_stage_input %08X program %d,"
+                " depth test %u func %X mask %u, blend %u %X/%X, cull %u %X, color mask %08X,"
+                " texture0 format %02X %ux%u, texture3 format %02X %ux%ux%u\n",
+                (unsigned)st->dot_rgb_mapping, (unsigned)st->other_stage_input, program,
+                (unsigned)st->depth_test, (unsigned)st->depth_func, (unsigned)st->depth_mask,
+                (unsigned)st->blend_enable, (unsigned)st->blend_sfactor, (unsigned)st->blend_dfactor,
+                (unsigned)st->cull_enable, (unsigned)st->cull_face, (unsigned)st->color_mask,
+                (unsigned)st->tex[0].color, (unsigned)st->tex[0].width, (unsigned)st->tex[0].height,
+                (unsigned)st->tex[3].color, (unsigned)st->tex[3].width, (unsigned)st->tex[3].height,
+                (unsigned)st->tex[3].depth);
+        fflush(stderr);
+    }
+    if (!s_ldraw.armed) return;
+    if (!s_ldraw.draws) {
+        s_ldraw.xmin = s_ldraw.ymin = 1e30f;
+        s_ldraw.xmax = s_ldraw.ymax = -1e30f;
+        s_lv_n = 0;
+    }
+    if (s_ldraw.draws < LV_DRAWS)
+        snprintf(s_lv_head[s_ldraw.draws], sizeof s_lv_head[0],
+                 "# draw %u: %u indices, program %d, depth %u/%X/%u, blend %u %X/%X, cull %u %X,"
+                 " dot_map %08X other_input %08X, tex0 %02X\n",
+                 s_ldraw.draws, (unsigned)ni, program, (unsigned)st->depth_test,
+                 (unsigned)st->depth_func, (unsigned)st->depth_mask, (unsigned)st->blend_enable,
+                 (unsigned)st->blend_sfactor, (unsigned)st->blend_dfactor,
+                 (unsigned)st->cull_enable, (unsigned)st->cull_face,
+                 (unsigned)st->dot_rgb_mapping, (unsigned)st->other_stage_input,
+                 (unsigned)st->tex[0].color);
+    s_ldraw.draws++;
+    s_ldraw.vertices += ni;
+    s_ldraw.cx = st->clip_x; s_ldraw.cy = st->clip_y; s_ldraw.cw = st->clip_w; s_ldraw.ch = st->clip_h;
+    s_ldraw.gw = gw; s_ldraw.gh = gh;
+    s_ldraw.iw = s ? s->iw : 0; s_ldraw.ih = s ? s->ih : 0;
+    s_ldraw.sx = s ? s->sx : 0; s_ldraw.sy = s ? s->sy : 0;
+    if (!idx) return;
+    for (k = 0; k < ni; k++) {
+        float v[4];
+        if (pos) memcpy(v, pos[idx[k] - lo], sizeof v);
+        else light_attr(&attr[0], idx[k], v, 4);
+        if (v[0] < s_ldraw.xmin) s_ldraw.xmin = v[0];
+        if (v[0] > s_ldraw.xmax) s_ldraw.xmax = v[0];
+        if (v[1] < s_ldraw.ymin) s_ldraw.ymin = v[1];
+        if (v[1] > s_ldraw.ymax) s_ldraw.ymax = v[1];
+        if (s_lv_n < LV_MAX) {
+            float *e = s_lv[s_lv_n];
+            memcpy(e, v, sizeof v);
+            light_attr(&attr[3], idx[k], e + 4, 4);
+            light_attr(&attr[9], idx[k], e + 8, 2);
+            light_attr(&attr[10], idx[k], e + 10, 3);
+            light_attr(&attr[11], idx[k], e + 13, 3);
+            light_attr(&attr[12], idx[k], e + 16, 3);
+            s_lv_draw[s_lv_n++] = s_ldraw.draws - 1;
+        }
+    }
+    if (s_ldraw.shown < 12 && ni >= 3) {
+        float a[4], b[4], c[4];
+        if (pos) {
+            memcpy(a, pos[idx[0] - lo], sizeof a);
+            memcpy(b, pos[idx[1] - lo], sizeof b);
+            memcpy(c, pos[idx[2] - lo], sizeof c);
+        } else {
+            light_attr(&attr[0], idx[0], a, 4);
+            light_attr(&attr[0], idx[1], b, 4);
+            light_attr(&attr[0], idx[2], c, 4);
+        }
+        s_ldraw.shown++;
+        fprintf(stderr, "[D3D11_LIGHT]   light draw: %u indices, clip %u,%u %ux%u, target guest %ux%u host %ux%u,"
+                " first triangle (%.1f,%.1f,%.2f,%.2f) (%.1f,%.1f) (%.1f,%.1f)\n",
+                ni, st->clip_x, st->clip_y, st->clip_w, st->clip_h, gw, gh,
+                s ? s->iw : 0, s ? s->ih : 0, a[0], a[1], a[2], a[3], b[0], b[1], c[0], c[1]);
+    }
+}
