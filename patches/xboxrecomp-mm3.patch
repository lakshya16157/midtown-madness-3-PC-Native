+#endif
 
 #define CHECK(c) do { if (!(c)) { fprintf(stderr, "Frame replay line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
-static FILE *input;
+/* The capture is read into memory once: the timed loop then measures the DSP
+ * and the recorded-transfer checks, not file reads. */
+static const uint8_t *input, *input_end;
 static DSPState *processor;
 static unsigned transfers;
+static int quiet;
+static double replay_seconds;
+static double replay_now(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER ticks, frequency;
+    QueryPerformanceCounter(&ticks); QueryPerformanceFrequency(&frequency);
+    return (double)ticks.QuadPart / frequency.QuadPart;
+#else
+    struct timespec value;
+    timespec_get(&value, TIME_UTC);
+    return value.tv_sec + value.tv_nsec * 1e-9;
+#endif
+}
+static int take(void *destination, size_t length)
+{
+    if ((size_t)(input_end - input) < length) return 0;
+    memcpy(destination, input, length);
+    input += length;
