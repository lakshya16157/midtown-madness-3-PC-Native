new file mode 100644
index 0000000..2037132
--- /dev/null
+++ b/tests/nv2a_native_fog/README.md
@@ -0,0 +1,21 @@
+# Native fog GPU contracts
+
+The production renderer and dedicated fog shaders run on the selected D3D11
+adapter. Synthetic scenes exercise near/mid/far haze, sky color/alpha, oriented
+horizon blending, independent split-screen cameras, surface bounds, region seven,
+disjoint and exclusive regions, and subsequent native shader binding recovery.
+
+An independent R32_FLOAT GPU pass captures every stored depth sample before and
+after fog, including 4x MSAA. Samples must remain bit-identical and the renderer's
+depth generation must remain unchanged. Invalid fields must leave scene pixels
+and generations untouched.
+
+Startup preparation and lazy preparation both publish readiness only after all
+resources exist. Injected constant-buffer allocation and shader compilation
+failures must release partial resources, leave readiness false and allow a later
+successful retry. The fixture needs no game data or visible window.
+
+Build this directory with CMake/Ninja in a temporary folder after activating the
+repository toolchain, then run CTest. The game's
+`tests/mm3_native_fog_decoder_regression.py` checks the actual ordered packet
+decoder independently of D3D11.
diff --git a/tests/nv2a_native_fog/test_native_fog.c b/tests/nv2a_native_fog/test_native_fog.c
new file mode 100644
index 0000000..d160c10
--- /dev/null
+++ b/tests/nv2a_native_fog/test_native_fog.c
@@ -0,0 +1,375 @@
+/* Actual fog/depth/compositor GPU results. Only framebuffer inputs and
+ * deliberate resource/compiler failures are fixture boundaries. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_1.h>
+#include <d3dcompiler.h>
+static int fail_fog_buffer, fail_fog_compile;
+static unsigned compile_failures;
+static HRESULT observed_buffer(ID3D11Device *,const D3D11_BUFFER_DESC *,const D3D11_SUBRESOURCE_DATA *,ID3D11Buffer **);
+static HRESULT WINAPI observed_compile(LPCVOID,SIZE_T,LPCSTR,const D3D_SHADER_MACRO *,ID3DInclude *,LPCSTR,LPCSTR,UINT,UINT,ID3DBlob **,ID3DBlob **);
+#undef ID3D11Device_CreateBuffer
+#define ID3D11Device_CreateBuffer observed_buffer
+#define D3DCompile observed_compile
+#include "../../src/video/nv2a_d3d11.c"
+#undef D3DCompile
+
+static uint8_t ram[0x100000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va,uint32_t *pitch) { (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start,uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ (void)version; return NULL; }
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); } } while (0)
+
+static HRESULT observed_buffer(ID3D11Device *device,const D3D11_BUFFER_DESC *desc,
+    const D3D11_SUBRESOURCE_DATA *data,ID3D11Buffer **buffer)
+{
+    if (fail_fog_buffer && desc->ByteWidth == sizeof(NativeFogConsts)) {
+        *buffer = NULL; return E_OUTOFMEMORY;
+    }
+    return device->lpVtbl->CreateBuffer(device,desc,data,buffer);
+}
+static HRESULT WINAPI observed_compile(LPCVOID source,SIZE_T length,LPCSTR name,
+    const D3D_SHADER_MACRO *macros,ID3DInclude *include,LPCSTR entry,LPCSTR target,
+    UINT flags1,UINT flags2,ID3DBlob **code,ID3DBlob **error)
+{
+    if (fail_fog_compile && name && !strcmp(name,"native_distance_fog")) {
+        ++compile_failures; *code = NULL; if (error) *error = NULL; return E_FAIL;
+    }
+    return D3DCompile(source,length,name,macros,include,entry,target,flags1,flags2,code,error);
+}
+
+static uint32_t *read_texture(ID3D11Texture2D *texture)
+{
+    ID3D11Texture2D *stage = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    uint32_t *pixels;
+    unsigned y;
+    ID3D11Texture2D_GetDesc(texture,&desc);
+    pixels = malloc((size_t)desc.Width * desc.Height * 4); CHECK(pixels);
+    desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&stage)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)stage,(ID3D11Resource *)texture);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)stage,0,D3D11_MAP_READ,0,&map)));
+    for (y = 0; y < desc.Height; ++y)
+        memcpy(pixels + (size_t)y * desc.Width,(const uint8_t *)map.pData + (size_t)y * map.RowPitch,desc.Width * 4);
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)stage,0);
+    ID3D11Texture2D_Release(stage);
+    return pixels;
+}
+static uint32_t *colours(void)
+{
+    Surface *surface = surface_find(0x20000); CHECK(surface);
+    surface_resolve(surface); return read_texture(surface->tex);
+}
+
+/* Independent R32_FLOAT readback captures every stored depth sample, including
+ * MSAA, rather than relying on the renderer's remapped/quantized depth views. */
+static uint32_t *raw_depth(Depth *depth_buffer)
+{
+    static const char source[] =
+        "#if SAMPLES > 1\nTexture2DMS<float> D:register(t0);\n#else\nTexture2D<float> D:register(t0);\n#endif\n"
+        "float4 vertex(uint id:SV_VertexID):SV_Position {float2 p=float2((id<<1)&2,id&2);return float4(p*float2(2,-2)+float2(-1,1),0,1);}\n"
+        "float pixel(float4 p:SV_Position):SV_Target {uint x=(uint)p.x;\n#if SAMPLES > 1\nreturn D.Load(int2(x/SAMPLES,p.y),x%SAMPLES);\n#else\nreturn D.Load(int3(int2(p.xy),0));\n#endif\n}";
+    ID3DBlob *code = NULL, *error = NULL;
+    ID3D11VertexShader *vs = NULL; ID3D11PixelShader *ps = NULL;
+    ID3D11Texture2D *output = NULL; ID3D11RenderTargetView *rtv = NULL;
+    char samples[8]; D3D_SHADER_MACRO macros[2];
+    UINT width = depth_buffer->iw * depth_buffer->samples, height = depth_buffer->ih;
+    D3D11_VIEWPORT viewport = {0,0,(float)width,(float)height,0,1};
+    D3D11_RECT rect = {0,0,(LONG)width,(LONG)height};
+    uint32_t *pixels;
+    snprintf(samples,sizeof samples,"%u",depth_buffer->samples);
+    macros[0] = (D3D_SHADER_MACRO){"SAMPLES",samples}; macros[1] = (D3D_SHADER_MACRO){NULL,NULL};
+    CHECK(SUCCEEDED(D3DCompile(source,sizeof source-1,"raw_depth_fixture",macros,NULL,
+        "vertex","vs_5_0",0,0,&code,&error)));
+    CHECK(SUCCEEDED(ID3D11Device_CreateVertexShader(s_dev,ID3D10Blob_GetBufferPointer(code),
+        ID3D10Blob_GetBufferSize(code),NULL,&vs)));
+    ID3D10Blob_Release(code); if (error) { ID3D10Blob_Release(error); error = NULL; }
+    CHECK(SUCCEEDED(D3DCompile(source,sizeof source-1,"raw_depth_fixture",macros,NULL,
+        "pixel","ps_5_0",0,0,&code,&error)));
+    CHECK(SUCCEEDED(ID3D11Device_CreatePixelShader(s_dev,ID3D10Blob_GetBufferPointer(code),
+        ID3D10Blob_GetBufferSize(code),NULL,&ps)));
+    ID3D10Blob_Release(code); if (error) ID3D10Blob_Release(error);
+    output = make_texture(width,height,1,1,DXGI_FORMAT_R32_FLOAT,D3D11_BIND_RENDER_TARGET,0);
+    CHECK(output && SUCCEEDED(ID3D11Device_CreateRenderTargetView(s_dev,(ID3D11Resource *)output,NULL,&rtv)));
+    unbind_targets(); unbind_textures();
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx,1,&rtv,NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx,1,&viewport);
+    ID3D11DeviceContext_RSSetScissorRects(s_ctx,1,&rect);
+    ID3D11DeviceContext_RSSetState(s_ctx,s_rs_plain);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx,s_blend_opaque,NULL,0xFFFFFFFFu);
+    ID3D11DeviceContext_OMSetDepthStencilState(s_ctx,s_ds_off,0);
+    ID3D11DeviceContext_IASetInputLayout(s_ctx,NULL);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx,D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    bind_vertex_shader(vs); bind_pixel_shader(ps);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx,0,1,&depth_buffer->zsrv);
+    ID3D11DeviceContext_Draw(s_ctx,3,0);
+    unbind_targets(); unbind_textures();
+    pixels = read_texture(output);
+    bind_vertex_shader(NULL); bind_pixel_shader(NULL);
+    ID3D11RenderTargetView_Release(rtv); ID3D11Texture2D_Release(output);
+    ID3D11VertexShader_Release(vs); ID3D11PixelShader_Release(ps);
+    return pixels;
+}
+
+static NvD3DState state(void)
+{
+    NvD3DState st = {0};
+    st.color_addr = 0x20000; st.color_pitch = 64 * 4;
+    st.zeta_addr = 0x40000; st.zeta_pitch = 64 * 4;
+    st.surface_format = 0x28; st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x01010101; st.blend_sfactor = 1; st.blend_equation = 0x8006;
+    st.z_perspective = 1; st.depth_test = st.depth_mask = 1; st.depth_func = 0x207;
+    return st;
+}
+static void geometry(NvD3DState *st,float depth,unsigned green)
+{
+    float pos[4][4] = {{-4,-4,0,0},{68,-4,0,0},{68,68,0,0},{-4,68,0,0}};
+    NvD3DAttrib attr[16] = {0}; float defaults[16][4] = {{0}};
+    uint32_t indices[6] = {0,1,2,0,2,3}; unsigned n;
+    for (n = 0; n < 4; ++n) {
+        pos[n][3] = 1.f / (depth * 16777216.f);
+        pos[n][2] = (1000.f/990.f - 10.f/(990.f*depth)) * 16777215.f;
+    }
+    attr[0] = (NvD3DAttrib){1,2,4,16,(const uint8_t *)pos};
+    defaults[3][green ? 1 : 0] = 1; defaults[3][3] = .5f;
+    nv2a_d3d_draw_ub(st,NV_D3D_TRIANGLES,attr,defaults,0,indices,6,0,3,NULL);
+}
+static NvD3DState scene(float depth)
+{
+    NvD3DState st = state();
+    nv2a_d3d_clear(&st,0xF1,0x80FF0000,0xFFFFFF00,0,0,63,63);
+    geometry(&st,depth,0); return st;
+}
+static void fog(NvD3DState *st,uint32_t flags,const float *plane)
+{
+    NvD3DState post = *st; post.depth_mask = post.z_perspective = 0;
+    nv2a_d3d_distance_fog(&post,1000.f/16777216.f,1000,200,800,0xFF0000FF,flags,plane);
+}
+static int channel(uint32_t colour,unsigned shift) { return (colour >> shift) & 255; }
+
+static void test_distances(void)
+{
+    const float distances[] = {.1f,.5f,.8f,1.f}; unsigned n;
+    for (n = 0; n < 4; ++n) {
+        NvD3DState st = scene(distances[n]);
+        Depth *d = depth_find(st.zeta_addr);
+        uint32_t generation, original_alpha, *before, *after, *pixels;
+        double x = fmax(0,fmin(1,(distances[n]*1000. - 200.) / 600.));
+        double alpha = distances[n] >= .99999f ? 0 : 1 - exp2(-6.643856*x*x);
+        CHECK(d); generation = d->gen;
+        pixels = colours(); original_alpha = pixels[16*64+16] >> 24; free(pixels);
+        before = raw_depth(d);
+        fog(&st,0,NULL); CHECK(nv2a_d3d_distance_fog_ready());
+        pixels = colours();
+        CHECK(abs(channel(pixels[16*64+16],16) - (int)round(255*(1-alpha))) <= 2);
+        CHECK(abs(channel(pixels[16*64+16],0) - (int)round(255*alpha)) <= 2);
+        CHECK((pixels[16*64+16] >> 24) == original_alpha);
+        after = raw_depth(d);
+        CHECK(d->gen == generation && !memcmp(before,after,(size_t)64*64*d->samples*4));
+        free(after); free(before); free(pixels);
+        fog(&st,NV2A_HOST_FOG_SKY_MASK,NULL); pixels = colours();
+        CHECK((pixels[16*64+16] >> 24) == (distances[n] >= .99999f ? 255u : 0u)); free(pixels);
+    }
+    {
+        NvD3DState st = scene(1); uint32_t *pixels = colours();
+        uint32_t original_alpha = pixels[100] >> 24; free(pixels);
+        fog(&st,NV2A_HOST_FOG_SKY_FILL,NULL); pixels = colours();
+        CHECK((pixels[100]&0xFFFFFFu) == 255 && (pixels[100]>>24) == original_alpha); free(pixels);
+    }
+}
+
+static void check_plane(const uint32_t *pixels,unsigned top,unsigned height,const float plane[4],uint32_t rgb)
+{
+    unsigned x,y;
+    for (y = top; y < top+height; ++y) for (x = 0; x < 64; ++x) {
+        double up = plane[0]*(2.*(x+.5)/64-1) + plane[1]*(1-2.*(y-top+.5)/height) + plane[2];
+        double a = fmax(0,fmin(1,up*plane[3]));
+        uint32_t pixel = pixels[y*64+x];
+        int expected = (int)round(255*a*a*(3-2*a));
+        CHECK((pixel&0xFFFFFFu) == rgb && abs((int)(pixel>>24)-expected) <= 3);
+    }
+}
+static void test_split_orientation(void)
+{
+    NvD3DState st = state(), upper, lower;
+    const float up[4] = {0,1,0,1}, tilted[4] = {.6f,.8f,-.1f,1};
+    uint32_t *first,*second; unsigned x,y;
+    nv2a_d3d_clear(&st,0xF1,0x80FF0000,0xFFFFFF00,0,0,63,31);
+    nv2a_d3d_clear(&st,0xF1,0x8000FF00,0xFFFFFF00,0,32,63,63);
+    upper = lower = st; upper.wclip_mask = lower.wclip_mask = 1;
+    upper.wclip_h[0] = lower.wclip_h[0] = 63u << 16;
+    upper.wclip_v[0] = 31u << 16; lower.wclip_v[0] = 32u | 63u << 16;
+    fog(&upper,7,up); first = colours();
+    check_plane(first,0,32,up,0x0000FF);
+    for (y=32;y<64;++y) for (x=0;x<64;++x) CHECK(first[y*64+x] == 0x8000FF00u);
+    nv2a_d3d_distance_fog(&lower,1000.f/16777216.f,1000,200,800,0xFFFFFF00,7,tilted);
+    second = colours(); CHECK(!memcmp(first,second,32*64*4));
+    check_plane(second,32,32,tilted,0xFFFF00);
+    free(second); free(first);
+}
+
+static void test_shapes(void)
+{
+    unsigned mode,x,y;
+    for (mode=0;mode<4;++mode) {
+        NvD3DState st = state(); uint32_t *pixels;
+        Depth *depth_buffer;
+        uint32_t generation, *raw_before, *raw_after;
+        nv2a_d3d_clear(&st,0xF1,0x80FF0000,0xFFFFFF00,0,0,63,63);
+        depth_buffer = depth_find(st.zeta_addr); CHECK(depth_buffer);
+        generation = depth_buffer->gen; raw_before = raw_depth(depth_buffer);
+        st.wclip_mask = (1u<<7) | (mode==1 ? 1u : 0);
+        st.wclip_h[7] = 8u | 23u<<16; st.wclip_v[7] = 16u | 31u<<16;
+        st.wclip_h[0] = 40u | 55u<<16; st.wclip_v[0] = 40u | 55u<<16;
+        st.wclip_type = mode==2;
+        if (mode==3) { st.clip_x=16; st.clip_w=48; st.clip_y=8; st.clip_h=56; }
+        fog(&st,NV2A_HOST_FOG_SKY_FILL,NULL); pixels = colours();
+        for(y=0;y<64;++y) for(x=0;x<64;++x) {
+            int inside = x>=8 && x<24 && y>=16 && y<32;
+            if(mode==1) inside |= x>=40 && x<56 && y>=40 && y<56;
+            if(mode==2) inside = !inside;
+            if(mode==3) inside &= x>=16 && y>=8;
+            CHECK(pixels[y*64+x] == (inside ? 0x800000FFu : 0x80FF0000u));
+        }
+        free(pixels);
+        raw_after = raw_depth(depth_buffer);
+        CHECK(depth_buffer->gen == generation &&
+              !memcmp(raw_before,raw_after,(size_t)64*64*depth_buffer->samples*4));
+        free(raw_after); free(raw_before);
+    }
+}
+
+static void test_invalid_and_recovery(void)
+{
+    NvD3DState st = scene(.5f); Surface *s = surface_find(st.color_addr);
+    Depth *d = depth_find(st.zeta_addr); uint32_t *before = colours(),*after;
+    uint32_t generation = s->gen, depth_generation = d->gen;
+    uint32_t original_alpha = before[16*64+16] >> 24;
+    const float invalid_plane[4] = {NAN,1,0,1}, zero_width[4] = {0,1,0,0};
+    const float overflow_plane[4] = {3.4e38f,3.4e38f,0,1};
+    nv2a_d3d_distance_fog(&st,NAN,1000,200,800,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,INFINITY,200,800,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,-1,800,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,800,800,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,200,1001,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,200,800,0,8,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,200,800,0,4,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,200,800,0,4,invalid_plane);
+    nv2a_d3d_distance_fog(&st,1,1000,200,800,0,4,zero_width);
+    nv2a_d3d_distance_fog(&st,3.4e38f,1000,200,800,0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1,0,nextafterf(0.f,1.f),0,0,NULL);
+    nv2a_d3d_distance_fog(&st,1,1000,200,800,0,4,overflow_plane);
+    after = colours(); CHECK(s->gen==generation && d->gen==depth_generation && !memcmp(before,after,64*64*4));
+    free(after); free(before);
+    fog(&st,0,NULL); st.depth_mask=0; geometry(&st,.1f,1);
+    CHECK(s_bound_vs==s_ub_vs && s_bound_ps==s_psv[2]);
+    after = colours(); CHECK(after[16*64+16] == ((original_alpha<<24)|0x00FF00u) && d->gen==depth_generation); free(after);
+}
+
+/* The title's own per-draw fog (MM3 trees) follows the native pass on the
+ * target that pass fogs: left to it before this frame's pass, given its range
+ * and colour after it, untouched elsewhere and without a pass. */
+static void test_title_fog(void)
+{
+    NvD3DState st = scene(.5f), other = st;
+    Surface *s = surface_find(st.color_addr);
+    uint32_t frame = s_frame;
+    memset(&s_native_fog_seen,0,sizeof s_native_fog_seen);
+    st.fog_enable = 1; st.fog_mode = 0x2601u; st.fog_param[0] = 1; st.fog_param[1] = 1;
+    st.rc.final0 = 0x130C0300u; st.rc.final1 = 0;        /* lerp(fog colour, r0, fog alpha): distance fog */
+    CHECK(native_fog_draw(&st,s) == 0);                 /* no native fog seen yet */
+    fog(&st,0,NULL);
+    CHECK(s_native_fog_seen.target == s && s_native_fog_seen.passes == 1);
+    CHECK(native_fog_draw(&st,s) == 2);                 /* after this frame's pass */
+    CHECK(s_native_fog_seen.start == 200 && s_native_fog_seen.end == 800 &&
+          s_native_fog_seen.argb == 0xFF0000FFu);
+    s_frame = frame + 1;
+    CHECK(native_fog_draw(&st,s) == 1);                 /* before the next frame's pass */
+    st.fog_enable = 0; CHECK(native_fog_draw(&st,s) == 0); st.fog_enable = 1;
+    other.fog_enable = 1; other.fog_mode = 0x2601u;
+    CHECK(native_fog_draw(&other,NULL) == 0);           /* another target keeps its fog */
+    fog(&st,0,NULL);
+    CHECK(native_fog_draw(&st,s) == 2);
+    st.fog_mode = 0x800u; CHECK(native_fog_draw(&st,s) == 2);   /* any mode: fogged by view depth */
+    st.rc.final0 = 0x13080C00u;                          /* fog alpha only, a blend weight (car paint) */
+    CHECK(native_fog_draw(&st,s) == 0);
+    st.rc.final0 = 0x130C0300u;
+    s_frame = frame + 3;                                /* a frame without a pass in between */
+    CHECK(native_fog_draw(&st,s) == 0);
+    s_frame = frame + 4;
+}
+
+/* The sky's authored fog ramp (Skies/<sky>_fog.cdds) keeps its weather under
+ * the native curve: a near pixel the curve leaves clear takes the ramp's fog,
+ * a far one keeps the curve's stronger fog, and a ramp that is not named for
+ * this frame (or not a 32-bit 2D texture) changes nothing. */
+static void test_sky_ramp(void)
+{
+    const uint32_t ramp = 0x60000u, format = 0x05610629u;  /* 64x32 A8R8G8B8, as MM3's */
+    const float distances[] = {.1f,.8f}; unsigned n;
+    memset(ram + ramp,0x80,64 * 32 * 4);
+    for (n = 0; n < 2; ++n) {
+        NvD3DState st = scene(distances[n]); uint32_t *pixels;
+        double x = fmax(0,fmin(1,(distances[n]*1000. - 200.) / 600.));
+        double alpha = fmax(1 - exp2(-6.643856*x*x),128./255.);
+        nv2a_d3d_sky_fog_ramp(ramp,format,.5f,1.f,.78f); CHECK(sky_ramp_current());
+        fog(&st,0,NULL); pixels = colours();
+        CHECK(abs(channel(pixels[16*64+16],16) - (int)round(255*(1-alpha))) <= 2);
+        CHECK(abs(channel(pixels[16*64+16],0) - (int)round(255*alpha)) <= 2);
+        free(pixels);
+    }
+    {
+        NvD3DState st = scene(.1f); uint32_t *pixels;
+        nv2a_d3d_sky_fog_ramp(ramp,0x05610C29u,.5f,1.f,.78f);      /* DXT1: not a ramp */
+        CHECK(!sky_ramp_current());
+        fog(&st,0,NULL); pixels = colours();
+        CHECK(channel(pixels[16*64+16],16) == 255 && channel(pixels[16*64+16],0) == 0); free(pixels);
+        st = scene(.1f);
+        nv2a_d3d_sky_fog_ramp(ramp,format,.5f,1.f,.78f); s_frame += 2;  /* named two frames ago */
+        CHECK(!sky_ramp_current());
+        fog(&st,0,NULL); pixels = colours();
+        CHECK(channel(pixels[16*64+16],16) == 255 && channel(pixels[16*64+16],0) == 0); free(pixels);
+        s_sky_ramp.valid = 0;
+    }
+}
+
+int main(int argc,char **argv)
+{
+    int lazy, failure;
+    CHECK(argc==2); lazy=!strcmp(argv[1],"lazy");
+    fail_fog_buffer=!strcmp(argv[1],"allocation_failure");
+    fail_fog_compile=!strcmp(argv[1],"compile_failure");
+    failure=fail_fog_buffer || fail_fog_compile;
+    _putenv_s("RECOMP_MSAA",!strcmp(argv[1],"pixels4") ? "4" : "1");
+    _putenv_s("RECOMP_RENDER_SCALE","1"); _putenv_s("RECOMP_ASPECT","4:3");
+    _putenv_s("RECOMP_PS_SPEC","0"); _putenv_s("RECOMP_FPS_LIMIT","0");
+    if(fail_fog_compile) _putenv_s("RECOMP_SHADER_CACHE","0");
+    CHECK(!nv2a_d3d_distance_fog_ready()); nv2a_d3d_prepare_distance_fog(!lazy);
+    CHECK(!nv2a_d3d_distance_fog_ready() && nv2a_d3d_init());
+    if(failure) {
+        NvD3DState st;
+        CHECK(!nv2a_d3d_distance_fog_ready() && nv2a_d3d_active());
+        CHECK(!s_native_fog_vs && !s_native_fog_ps[0] && !s_native_fog_ps[1] && !s_native_fog_cb &&
+              !s_native_fog_blend && !s_native_fog_mask && !s_native_fog_depth && !s_native_fog_raster);
+        if(fail_fog_compile) CHECK(compile_failures);
+        fail_fog_buffer=fail_fog_compile=0; st=scene(.5f); fog(&st,0,NULL);
+        CHECK(nv2a_d3d_distance_fog_ready());
+        puts("PASS: native fog resource/compiler failure leaves atomic readiness false, releases every partial resource, preserves the renderer and retries successfully"); return 0;
+    }
+    if(lazy) { NvD3DState st=scene(.5f); CHECK(!nv2a_d3d_distance_fog_ready()); fog(&st,0,NULL); }
+    CHECK(nv2a_d3d_distance_fog_ready());
+    test_distances(); test_split_orientation(); test_shapes(); test_invalid_and_recovery();
+    test_title_fog(); test_sky_ramp();
+    puts("PASS: real GPU fog near/mid/far, sky's authored ramp under the curve, sky fill/mask, camera-relative pitch/roll and split ownership, all-region/exclusive/surface clipping, exact raw depth samples/generation, invalid packets, native shader binding recovery and title per-draw fog following the native pass");
+    return 0;
+}
