+static void test_menu_canvas(void)
+{
+    static const char suffix[] =
+        "struct CanvasPosition { float4 pos:SV_Position; };\n"
+        "[maxvertexcount(1)] void canvas_gs(point CanvasPosition input[1],\n"
+        " inout PointStream<CanvasPosition> output) { output.Append(input[0]); }\n";
+    const float aspects[]={1.0f,.75f,4.0f/3.0f,16.0f/9.0f,21.0f/9.0f};
+    ID3DBlob *code=compile_fixture(suffix,"canvas_gs","gs_5_0");
+    ID3D11GeometryShader *geometry=NULL;
+    D3D11_SO_DECLARATION_ENTRY declaration={0,"SV_POSITION",0,0,4,0};
+    UINT stride=16; unsigned a,i,mode;
+    ID3D11Buffer *output=default_buffer(MAP_MAX_VERTICES*16,D3D11_BIND_STREAM_OUTPUT);
+    CHECK(SUCCEEDED(ID3D11Device_CreateGeometryShaderWithStreamOutput(s_dev,
+        ID3D10Blob_GetBufferPointer(code),ID3D10Blob_GetBufferSize(code),&declaration,1,
+        &stride,1,D3D11_SO_NO_RASTERIZED_STREAM,NULL,&geometry)));
+    ID3D10Blob_Release(code);
+    nv2a_d3d_set_map_texture_query(NULL); nv2a_d3d_set_centered_ui_query(NULL);
+    for(a=0;a<sizeof aspects/sizeof aspects[0];++a) {
+        NvD3DState target=state_for(640,480);
+        float p[MAP_MAX_VERTICES][4],captured[MAP_MAX_VERTICES][4];
+        double xfit=fmin(1.0,(4.0/3.0)/aspects[a]),yfit=fmin(1.0,aspects[a]/(4.0/3.0));
+        target.color_addr+=a*0x10000; s_aspect=aspects[a]; s_scale=2;
+        nv2a_d3d_set_edge_hud(0); s_frame_bg_tex=0;
+        for(mode=0;mode<3;++mode) {
+            D3D11_RECT scissor; UINT rectangles=1;
+            /* Background artwork, a separate UI control, then perspective
+             * turntable vertices all share one undistorted safe canvas. */
+            map_quad(p,mode?208:0,mode?432:640,mode?170:0,mode?200:480);
+            if(mode==2) for(i=0;i<4;++i) p[i][3]=2;
+            capture_map(geometry,output,&target,(const float (*)[4])p,4,
+                        mode==0?MAP_BASE_TEXTURE:0,0,0,0,captured);
+            ID3D11DeviceContext_RSGetScissorRects(s_ctx,&rectangles,&scissor);
+            CHECK(rectangles==1);
+            CHECK(scissor.left==(LONG)(640*s_cur_sx*(1-xfit)*.5+.5));
+            CHECK(scissor.right==(LONG)(640*s_cur_sx*(1+xfit)*.5+.5));
+            CHECK(scissor.top==(LONG)(480*s_cur_sy*(1-yfit)*.5+.5));
+            CHECK(scissor.bottom==(LONG)(480*s_cur_sy*(1+yfit)*.5+.5));
+            for(i=0;i<4;++i) {
+                double x=p[i][0],y=p[i][1],w=mode==2?.5:1;
+                if(mode==2) {x-=.53125;y-=.53125;}
+                CHECK(fabs(captured[i][0]-(2*x/640-1)*xfit*w)<2e-6);
+                CHECK(fabs(captured[i][1]-(1-2*y/480)*yfit*w)<2e-6);
+                CHECK(fabs(captured[i][3]-w)<2e-6);
+            }
+        }
+        /* Copies of already rendered gameplay cover the full target. A tall
+         * surface must be recognized just like a wide one, even in menus. */
+        map_quad(p,0,640,0,480);
+        capture_map(geometry,output,&target,(const float (*)[4])p,4,target.color_addr,0,0,0,captured);
+        for(i=0;i<4;++i) check_map_position(captured[i],p[i][0],p[i][1]);
+        CHECK(s_draw_reads_wide==(fabs(aspects[a]-4.0f/3.0f)>0.001f));
+    }
+    /* CPU-drawn loading artwork uses the same safe canvas, and sampling its
+     * authored rectangle produces the original guest image on both axes. */
+    for(a=0;a<sizeof aspects/sizeof aspects[0];++a) {
+        Surface *surface; ID3D11Texture2D *readback=NULL, *down=NULL;
+        ID3D11RenderTargetView *down_rtv=NULL;
+        D3D11_TEXTURE2D_DESC desc; D3D11_MAPPED_SUBRESOURCE mapped;
+        float x0,x1,y0,y1; unsigned sample;
+        uint32_t address=0x200000;
+        s_aspect=aspects[a]; s_scale=1;
+        surface=surface_find(address); if(surface) surface_release(surface);
+        memset(ram+address,0xFF,640*480*4);
+        surface=surface_get(address,640*4,0x5,640,480,0); CHECK(surface);
+        guest_rect(surface,&x0,&x1,&y0,&y1);
+        surface_resolve(surface);
+        ID3D11Texture2D_GetDesc(surface->tex,&desc);
+        desc.Usage=D3D11_USAGE_STAGING; desc.BindFlags=0; desc.MiscFlags=0;
+        desc.CPUAccessFlags=D3D11_CPU_ACCESS_READ;
+        CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&readback)));
+        ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)readback,(ID3D11Resource *)surface->tex);
+        CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)readback,0,D3D11_MAP_READ,0,&mapped)));
+        for(sample=0;sample<3;++sample) {
+            unsigned x=sample==0?surface->iw/2:sample==1?0:surface->iw/2;
+            unsigned y=sample==0?surface->ih/2:sample==1?surface->ih/2:0;
+            const uint32_t *row=(const uint32_t *)((const uint8_t *)mapped.pData+y*mapped.RowPitch);
+            int inside=(sample==0 || (sample==1 && x0==0) || (sample==2 && y0==0));
+            CHECK(row[x]==(inside?0xFFFFFFFFu:0));
+        }
+        ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)readback,0);
+        ID3D11Texture2D_Release(readback);
+        down=make_texture(640,480,1,1,DXGI_FORMAT_B8G8R8A8_UNORM,D3D11_BIND_RENDER_TARGET,0);
+        CHECK(down && SUCCEEDED(ID3D11Device_CreateRenderTargetView(s_dev,(ID3D11Resource *)down,NULL,&down_rtv)));
+        CHECK(blit_region(surface->srv,NULL,down_rtv,640,480,-1,0,1,0,1,x0,x1,y0,y1));
+        desc.Width=640; desc.Height=480;
+        CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&readback)));
+        ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)readback,(ID3D11Resource *)down);
+        CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)readback,0,D3D11_MAP_READ,0,&mapped)));
+        for(sample=0;sample<3;++sample) {
+            const uint32_t *row=(const uint32_t *)((const uint8_t *)mapped.pData+(120+sample*120)*mapped.RowPitch);
+            CHECK(row[160]==0xFFFFFFFFu && row[320]==0xFFFFFFFFu && row[480]==0xFFFFFFFFu);
+        }
+        ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)readback,0);
+        ID3D11Texture2D_Release(readback); ID3D11RenderTargetView_Release(down_rtv); ID3D11Texture2D_Release(down);
+    }
+    ID3D11Buffer_Release(output); ID3D11GeometryShader_Release(geometry);
+    puts("PASS: GPU frontend artwork, separate UI controls and 3D turntable share an unstretched fitted 4:3 canvas at five display shapes");
+}
+
+static void test_aspect_control(void)
+{
+    const float aspects[]={16.0f/9.0f,1.0f,21.0f/9.0f,.75f,4.0f/3.0f};
+    RECT rect={0,0,900,900}; unsigned i;
+    CHECK(AdjustWindowRect(&rect,WS_OVERLAPPEDWINDOW,FALSE));
+    display_window=CreateWindowA("STATIC","Aspect contract",WS_OVERLAPPEDWINDOW,
+        0,0,rect.right-rect.left,rect.bottom-rect.top,NULL,NULL,GetModuleHandleA(NULL),NULL);
+    CHECK(display_window);
+    nv2a_d3d_set_edge_hud(1);
+    for(i=0;i<sizeof aspects/sizeof aspects[0];++i) {
+        nv2a_d3d_set_display_aspect(aspects[i]); display_config(0);
+        CHECK(fabs(nv2a_d3d_display_aspect()-aspects[i])<1e-4);
+        /* A pinned boot environment must yield to the explicit Auto choice. */
+        nv2a_d3d_set_display_aspect(0); display_config(0);
+        CHECK(fabs(nv2a_d3d_display_aspect()-1.0f)<1e-4);
+    }
+    nv2a_d3d_set_display_aspect(NAN); nv2a_d3d_set_display_aspect(.1f);
+    CHECK(env_aspect()==0);
+    DestroyWindow(display_window); display_window=NULL;
+    puts("PASS: live explicit aspect and Auto update during race HUD without window resize or restart; boot override and invalid values handled");
+}
