diff --git a/tests/guest_write_watch/test_main.c b/tests/guest_write_watch/test_main.c
new file mode 100644
index 0000000..a3a70f7
--- /dev/null
+++ b/tests/guest_write_watch/test_main.c
@@ -0,0 +1,327 @@
+/* Write stamps on a page-file section mapped twice, like the contiguous
+ * window and its tiled alias: writes through either view, kernel-mode
+ * ReadFile into an armed buffer, protection requests, and a writer thread
+ * racing the arm/read/check protocol. */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "guest_write_watch.h"
+
+#define PAGE 4096u
+#define PAGES 64u
+#define GUEST 0x80000000u
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+
+static uint8_t *contig, *tiled;
+static HANDLE section;
+
+static GwwRange range(uint32_t offset, uint32_t bytes)
+{
+    GwwRange r;
+    r.va = GUEST + offset; r.bytes = bytes;
+    return r;
+}
+
+static DWORD protection(const void *p)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    CHECK(VirtualQuery(p, &mbi, sizeof mbi));
+    return mbi.Protect;
+}
+
+static uint64_t faults(void)
+{
+    uint64_t f = 0;
+    gww_stats(&f, NULL);
+    return f;
+}
+
+static void map_views(void)
+{
+    section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                                        PAGES * PAGE, NULL);
+    CHECK(section);
+    contig = (uint8_t *)MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, PAGES * PAGE);
+    tiled = (uint8_t *)MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, PAGES * PAGE);
+    CHECK(contig && tiled && contig != tiled);
+    tiled[5] = 0x5A;
+    CHECK(contig[5] == 0x5A);
+}
+
+static void test_inactive(void)
+{
+    GwwRange r = range(0, 16);
+    int complete = 1;
+    CHECK(gww_ops() == NULL);
+    CHECK(!gww_covers(r.va, r.bytes));
+    gww_arm(&r, 1, &complete);
+    CHECK(!complete);
+    CHECK(!gww_clean(&r, 1, 0));
+}
+
+/* Writes through either view fault once, open both views and stamp. */
+static void test_alias(void)
+{
+    GwwRange r = range(PAGE, 2 * PAGE);
+    uint64_t seq, before = faults();
+    int complete = 0;
+    CHECK(gww_ops() != NULL);
+    CHECK(gww_covers(GUEST, PAGES * PAGE) && !gww_covers(GUEST, PAGES * PAGE + 1));
+    CHECK(!gww_covers(GUEST - PAGE, 16));
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete);
+    CHECK(gww_clean(&r, 1, seq));
+    CHECK(protection(contig + PAGE) == PAGE_READONLY && protection(tiled + 2 * PAGE) == PAGE_READONLY);
+    CHECK(gww_range_armed(tiled + PAGE, 2 * PAGE) && gww_range_armed(contig + PAGE + 7, 1));
+    CHECK(gww_logical_protect(contig + PAGE, PAGE_READONLY) == PAGE_READWRITE);
+    CHECK(gww_logical_protect(contig, PAGE_READONLY) == PAGE_READONLY);
+
+    *(volatile uint8_t *)(tiled + PAGE + 10) = 5;          /* through the alias */
+    CHECK(contig[PAGE + 10] == 5);
+    CHECK(faults() == before + 1);
+    CHECK(!gww_clean(&r, 1, seq));
+    CHECK(protection(contig + PAGE) == PAGE_READWRITE && protection(tiled + PAGE) == PAGE_READWRITE);
+    CHECK(protection(contig + 2 * PAGE) == PAGE_READONLY);  /* only the written page opens */
+    *(volatile uint8_t *)(contig + PAGE + 11) = 6;          /* already open: no fault */
+    CHECK(faults() == before + 1);
+
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete && gww_clean(&r, 1, seq));
+    *(volatile uint32_t *)(contig + 2 * PAGE + 100) = 0x12345678u;
+    CHECK(*(volatile uint32_t *)(tiled + 2 * PAGE + 100) == 0x12345678u);
+    CHECK(faults() == before + 2 && !gww_clean(&r, 1, seq));
+    /* A store straddling two armed pages faults on each. */
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete);
+    memcpy(contig + 2 * PAGE - 4, "abcdefgh", 8);
+    CHECK(faults() == before + 4 && !memcmp(tiled + 2 * PAGE - 4, "abcdefgh", 8));
+    puts("PASS: a write through either view faults once, opens both views and stamps its page");
+}
+
+/* Stamps are per page and per check: a neighbour's write dirties everyone
+ * sharing the page until each checks again. */
+static void test_shared_page(void)
+{
+    GwwRange a = range(3 * PAGE, 100), b = range(3 * PAGE + 2000, 100), both[2];
+    uint64_t sa, sb;
+    int complete;
+    sa = gww_arm(&a, 1, &complete); CHECK(complete);
+    sb = gww_arm(&b, 1, &complete); CHECK(complete);
+    CHECK(gww_clean(&a, 1, sa) && gww_clean(&b, 1, sb));
+    *(volatile uint8_t *)(contig + 3 * PAGE + 2010) = 1;
+    CHECK(!gww_clean(&a, 1, sa) && !gww_clean(&b, 1, sb));
+    sa = gww_arm(&a, 1, &complete);
+    CHECK(complete && gww_clean(&a, 1, sa));
+    CHECK(!gww_clean(&b, 1, sb));                  /* re-armed by a, still stale for b */
+    both[0] = a; both[1] = range(9 * PAGE, 64);    /* texture plus palette */
+    sa = gww_arm(both, 2, &complete);
+    CHECK(complete && gww_clean(both, 2, sa));
+    *(volatile uint8_t *)(tiled + 9 * PAGE + 3) = 9;
+    CHECK(!gww_clean(both, 2, sa) && gww_clean(&a, 1, sa));
+    puts("PASS: stamps are per page; a shared page dirties every range on it until each re-arms");
+}
+
+/* ReadFile is a kernel-mode copy: it fails on an armed page and works while
+ * the destination is bracketed, which also keeps arms off the pages. */
+static void test_readfile(void)
+{
+    char path[MAX_PATH], dir[MAX_PATH];
+    uint8_t data[3 * PAGE];
+    HANDLE file;
+    DWORD got = 0, i;
+    GwwRange r = range(10 * PAGE, 4 * PAGE);
+    uint64_t seq;
+    int complete;
+    BOOL ok;
+    for (i = 0; i < sizeof data; ++i) data[i] = (uint8_t)(i * 7 + 3);
+    CHECK(GetTempPathA(sizeof dir, dir) && GetTempFileNameA(dir, "gww", 0, path));
+    file = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                       FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, NULL);
+    CHECK(file != INVALID_HANDLE_VALUE);
+    CHECK(WriteFile(file, data, sizeof data, &got, NULL) && got == sizeof data);
+
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete);
+    SetFilePointer(file, 0, NULL, FILE_BEGIN);
+    ok = ReadFile(file, contig + 10 * PAGE + 123, sizeof data, &got, NULL);
+    CHECK(!ok && GetLastError() == ERROR_NOACCESS);    /* why NtReadFile brackets */
+
+    SetFilePointer(file, 0, NULL, FILE_BEGIN);
+    gww_host_write_begin(contig + 10 * PAGE + 123, sizeof data);
+    gww_arm(&r, 1, &complete);
+    CHECK(!complete);                                   /* pinned pages stay open */
+    ok = ReadFile(file, contig + 10 * PAGE + 123, sizeof data, &got, NULL);
+    gww_host_write_end(contig + 10 * PAGE + 123, sizeof data);
+    CHECK(ok && got == sizeof data);
+    CHECK(!memcmp(tiled + 10 * PAGE + 123, data, sizeof data));
+    CHECK(!gww_clean(&r, 1, seq));
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete && gww_clean(&r, 1, seq));
+    /* A one-shot host write opens and stamps without a fault. */
+    {
+        uint64_t before = faults();
+        gww_host_write(tiled + 11 * PAGE, 16);
+        memset(contig + 11 * PAGE, 0xEE, 16);
+        CHECK(faults() == before && !gww_clean(&r, 1, seq));
+    }
+    CloseHandle(file);
+    puts("PASS: ReadFile into armed pages fails alone and succeeds bracketed; pins block arming");
+}
+
+static void test_protect(void)
+{
+    GwwRange r = range(20 * PAGE, PAGE), s = range(21 * PAGE, PAGE);
+    unsigned long old = 0;
+    uint64_t seq;
+    int complete;
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete);
+    CHECK(gww_virtual_protect(contig + 20 * PAGE, PAGE, PAGE_READWRITE, &old));
+    CHECK(old == PAGE_READWRITE);                       /* not the watch's read-only */
+    CHECK(protection(tiled + 20 * PAGE) == PAGE_READWRITE);
+    CHECK(!gww_clean(&r, 1, seq));
+    seq = gww_arm(&r, 1, &complete);
+    CHECK(complete && gww_clean(&r, 1, seq));           /* plain read-write: watchable */
+
+    seq = gww_arm(&s, 1, &complete);
+    CHECK(complete);
+    CHECK(gww_virtual_protect(contig + 21 * PAGE, PAGE, PAGE_READONLY, &old));
+    CHECK(old == PAGE_READWRITE && protection(contig + 21 * PAGE) == PAGE_READONLY);
+    CHECK(protection(tiled + 21 * PAGE) == PAGE_READWRITE);
+    CHECK(gww_logical_protect(contig + 21 * PAGE, PAGE_READONLY) == PAGE_READONLY);
+    CHECK(!gww_range_armed(contig + 21 * PAGE, 4));
+    gww_arm(&s, 1, &complete);
+    CHECK(!complete && !gww_clean(&s, 1, seq));         /* the guest's protection wins */
+    CHECK(protection(contig + 21 * PAGE) == PAGE_READONLY);
+    CHECK(gww_virtual_protect(contig + 21 * PAGE, PAGE, PAGE_READWRITE, &old));
+    puts("PASS: guest protection requests disarm, report read-write and keep non-plain pages unarmed");
+}
+
+/* The renderer's writer view: no faults, the guest's views stay armed, and
+ * host_wrote keeps the writer's snapshot only when no CPU write came first. */
+static void test_writer(void)
+{
+    GwwRange r = range(24 * PAGE, 2 * PAGE), other = range(25 * PAGE + 64, 32);
+    uint64_t seq, so, f0, next;
+    uint8_t *w;
+    int complete, still;
+    seq = gww_arm(&r, 1, &complete); CHECK(complete);
+    so = gww_arm(&other, 1, &complete); CHECK(complete);
+    f0 = faults();
+    w = gww_host_writer(r.va, r.bytes);
+    CHECK(w && w != contig + 24 * PAGE && w != tiled + 24 * PAGE);
+    memset(w, 0x3C, 2 * PAGE);
+    CHECK(faults() == f0 && contig[24 * PAGE + 100] == 0x3C && tiled[25 * PAGE + 7] == 0x3C);
+    CHECK(protection(contig + 24 * PAGE) == PAGE_READONLY && protection(tiled + 25 * PAGE) == PAGE_READONLY);
+    CHECK(gww_clean(&r, 1, seq));                          /* unstamped until host_wrote */
+    next = gww_host_wrote(&r, 1, seq, &still);
+    CHECK(still && next > seq && gww_clean(&r, 1, next));  /* the writer keeps a snapshot */
+    CHECK(!gww_clean(&r, 1, seq) && !gww_clean(&other, 1, so));   /* everyone else re-reads */
+    /* A CPU write before host_wrote: the writer must re-read too. */
+    *(volatile uint8_t *)(tiled + 24 * PAGE + 9) = 1;
+    memset(w, 0x5A, 16);
+    seq = gww_host_wrote(&r, 1, next, &still);
+    CHECK(!still && !gww_clean(&r, 1, seq));               /* page 24 is open now */
+    /* Excluded pages are written through the guest's own view instead. */
+    CHECK(gww_host_writer(GUEST + 21 * PAGE, 16) == NULL);
+    CHECK(gww_host_writer(GUEST + PAGES * PAGE - 8, 16) == NULL);
+    puts("PASS: writer-view stores neither fault nor unprotect; host_wrote stamps and judges");
+}
+
+/* A writer thread stores through both views while the checker arms, reads
+ * and later checks. Whenever the stamps say clean, the bytes read after the
+ * arm must equal the bytes now. */
+#define STRESS_FIRST 40u
+#define STRESS_PAGES 8u
+static volatile LONG s_run, s_request, s_ack, s_quit;
+static volatile LONG s_written;
+
+static DWORD WINAPI writer(LPVOID unused)
+{
+    uint32_t state = 0x9E3779B9u, value = 1;
+    (void)unused;
+    while (!s_quit) {
+        /* Read the request before s_run: an acknowledged request means every
+         * store begun while running has completed. */
+        LONG request = s_request;
+        if (!s_run) { InterlockedExchange(&s_ack, request); YieldProcessor(); continue; }
+        state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+        {
+            uint32_t offset = STRESS_FIRST * PAGE + (state % (STRESS_PAGES * PAGE - 4)) & ~3u;
+            uint8_t *view = (state >> 31) ? tiled : contig;
+            *(volatile uint32_t *)(view + offset) = value++;
+            InterlockedIncrement(&s_written);
+        }
+    }
+    return 0;
+}
+
+static void test_stress(void)
+{
+    GwwRange r = range(STRESS_FIRST * PAGE, STRESS_PAGES * PAGE);
+    static uint8_t snapshot[STRESS_PAGES * PAGE];
+    HANDLE thread;
+    unsigned i, clean = 0, dirty = 0;
+    uint32_t state = 12345;
+    thread = CreateThread(NULL, 0, writer, NULL, 0, NULL);
+    CHECK(thread);
+    for (i = 0; i < 3000; ++i) {
+        uint64_t seq;
+        int complete, run, c;
+        state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+        run = (state & 3) != 0;
+        InterlockedExchange(&s_run, run);
+        if (run) { LONG w = s_written; while (s_written - w < (LONG)(state % 64)) YieldProcessor(); }
+        seq = gww_arm(&r, 1, &complete);
+        memcpy(snapshot, contig + STRESS_FIRST * PAGE, sizeof snapshot);
+        if (run && (state & 4)) { LONG w = s_written; while (s_written - w < 2) YieldProcessor(); }
+        InterlockedExchange(&s_run, 0);
+        {
+            LONG request = InterlockedIncrement(&s_request);
+            while (s_ack != request) YieldProcessor();
+        }
+        c = gww_clean(&r, 1, seq);
+        CHECK(complete);
+        if (c) {
+            CHECK(!memcmp(snapshot, contig + STRESS_FIRST * PAGE, sizeof snapshot));
+            ++clean;
+        } else {
+            ++dirty;
+        }
+    }
+    InterlockedExchange(&s_quit, 1);
+    WaitForSingleObject(thread, INFINITE);
+    CloseHandle(thread);
+    CHECK(clean > 100 && dirty > 100);
+    printf("PASS: %u racing checks (%u clean, %u dirty, %ld writes, %llu faults) never vouched for changed bytes\n",
+           i, clean, dirty, (long)s_written, (unsigned long long)faults());
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2) return 2;
+    map_views();
+    test_inactive();
+    if (!strcmp(argv[1], "off")) {
+        CHECK(!gww_init(GUEST, contig, PAGES * PAGE, tiled, PAGES * PAGE, section));
+        test_inactive();
+        puts("PASS: RECOMP_TEXTURE_WATCH=0 leaves the watch off");
+        return 0;
+    }
+    if (strcmp(argv[1], "views")) return 2;
+    CHECK(!gww_init(GUEST, contig, PAGES * PAGE, tiled, PAGES * PAGE, NULL));
+    CHECK(gww_init(GUEST, contig, PAGES * PAGE, tiled, PAGES * PAGE, section));
+    test_alias();
+    test_shared_page();
+    test_readfile();
+    test_protect();
+    test_writer();
+    test_stress();
+    return 0;
+}
