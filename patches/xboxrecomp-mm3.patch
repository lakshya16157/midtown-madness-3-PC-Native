+     * enough to join the right HUD piece must not move that piece or borrow
+     * its edge anchor. All three primitives keep their intended transform. */
+    quad(p, 20, 80, 100, 120); quad(p + 4, 310, 330, 100, 120);
+    quad(p + 8, 330, 390, 100, 120); tag_route(4, 4);
+    r = draw(p, 12, idx, 18, 0, aspect, scale, 0, 0, 0);
+    near(r.x[0], 20 * narrow); near(r.x[1], 80 * narrow);
+    for (i = 4; i < 8; ++i) {
+        near(r.x[i], base.x[0] + (p[i][0] - base_x) * narrow);
+        near(r.y[i], p[i][1] + base.y_offset);
+    }
