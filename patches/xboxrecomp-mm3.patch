+/* Deterministic timing/log contracts: no D3D device or wall-clock sleeps. */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+static const char *setting;
+static LONGLONG now = 1000000, frequency = 1000000;
+static unsigned clocks, frequencies, logs;
+static int fail_clock, fail_frequency;
+static LONGLONG output_ticks;
+static char record[8192];
+static char *environment(const char *name)
+{ return !strcmp(name,"RECOMP_SLOW_FRAME_TRACE") ? (char *)setting : NULL; }
+static BOOL WINAPI clock_read(LARGE_INTEGER *out)
+{ ++clocks;if(fail_clock) {--fail_clock;return FALSE;}out->QuadPart=now;return TRUE; }
+static BOOL WINAPI frequency_read(LARGE_INTEGER *out)
+{ ++frequencies;if(fail_frequency) return FALSE;out->QuadPart=frequency;return TRUE; }
+static void log_record(const char *format,...)
+{
+    va_list args;va_start(args,format);vsnprintf(record,sizeof record,format,args);va_end(args);
+    ++logs;now+=output_ticks;
+}
+#define getenv environment
+#define QueryPerformanceCounter clock_read
+#define QueryPerformanceFrequency frequency_read
+#define NV_SLOW_FRAME_LOG log_record
+#include "../../src/video/nv2a_slow_frame.h"
+#define CHECK(x) do {if(!(x)) {fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);exit(1);}} while(0)
+static void reset(const char *value)
+{
+    memset(&s_slow_frame,0,sizeof s_slow_frame);record[0]=0;setting=value;
+    now=1000000;frequency=1000000;clocks=frequencies=logs=0;
+    fail_clock=fail_frequency=0;output_ticks=0;
+}
+static void boundary(LONGLONG tick,unsigned line)
+{now=tick;slow_frame_boundary(tick,line);}
+static void test_off(void)
+{
+    const char *values[]={NULL,"","0","true","01","1 "};unsigned i;
+    for(i=0;i<sizeof values/sizeof values[0];++i) {
+        reset(values[i]);CHECK(!slow_frame_begin());slow_frame_end(SF_DRAW_SCOPE,1);
+        slow_frame_map_end(SF_RAW,1,4,D3D11_MAP_WRITE_DISCARD,E_FAIL);
+        slow_frame_unmap_end(SF_RAW,1);slow_frame_add_ticks(SF_PACE_WAIT,50);
+        slow_frame_readback_pending(1);slow_frame_readback_pending(0);
+        boundary(2000000,2);CHECK(!clocks&&!frequencies&&!logs&&!s_slow_frame.sample.maps[0].calls);
+    }
+    reset("1");fail_frequency=1;CHECK(!slow_frame_begin()&&!slow_frame_begin());
+    CHECK(frequencies==1&&!clocks);reset("1");frequency=0;CHECK(!slow_frame_begin()&&!clocks);
+    puts("PASS: default/invalid OFF adds zero clocks; unavailable frequency safely disables once");
+}
+static void test_boundary(void)
+{
+    reset("1");boundary(1000000,0);boundary(1030000,2);CHECK(!logs); /* Exactly30ms. */
+    boundary(1060001,3);CHECK(logs==1);
+    CHECK(strstr(record,"start_qpc_ticks=1030000 end_qpc_ticks=1060001 qpc_frequency=1000000 csv_line=3 "));
+    CHECK(strstr(record,"duration_ms=30.0010")&&strstr(record,"record_end=1\n"));
+    CHECK(strstr(record,"scope=nested_totals_not_additive"));
+    /* The raw integer threshold also works for nonintegral ticks/ms. */
+    reset("1");frequency=1003;boundary(1000,0);boundary(1030,2);CHECK(!logs);
+    boundary(1061,3);CHECK(logs==1);CHECK(s_slow_frame.frames==2);
+    puts("PASS: exact supplied CSV QPC boundaries and line IDs; strictly greater than30ms");
+}
+static void test_maps(void)
+{
+    int64_t begin;reset("1");boundary(now,0);
+    begin=slow_frame_begin();now+=700;slow_frame_map_end(SF_RAW,begin,256,D3D11_MAP_WRITE_DISCARD,S_OK);
+    begin=slow_frame_begin();now+=1200;slow_frame_map_end(SF_RAW,begin,128,D3D11_MAP_WRITE_NO_OVERWRITE,E_OUTOFMEMORY);
+    begin=slow_frame_begin();now+=20;slow_frame_unmap_end(SF_RAW,begin);
+    begin=slow_frame_begin();now+=400;slow_frame_map_end(SF_INDEX,begin,12,D3D11_MAP_WRITE_DISCARD,S_OK);
+    begin=slow_frame_begin();now+=30;slow_frame_unmap_end(SF_INDEX,begin);
+    begin=slow_frame_begin();now+=600;slow_frame_map_end(SF_CONSTANT,begin,592,D3D11_MAP_WRITE_DISCARD,S_OK);
+    slow_frame_add_ticks(SF_DRAW_SCOPE,7000);slow_frame_add_ticks(SF_READBACK_FINISH_SCOPE,300);
+    slow_frame_add_ticks(SF_PRESENT_API,200);slow_frame_add_ticks(SF_PACE_WAIT,1100);
+    CHECK(s_slow_frame.sample.maps[SF_RAW].calls==2&&s_slow_frame.sample.maps[SF_RAW].ticks==1900);
+    boundary(1040000,2);CHECK(logs==1);
+    CHECK(strstr(record,"raw_map_calls=2 raw_map_bytes=384 raw_map_ms=1.9000 raw_map_max_ms=1.2000"));
+    CHECK(strstr(record,"raw_map_discard=1 raw_map_nooverwrite=1 raw_map_other=0 raw_map_failures=1"));
+    CHECK(strstr(record,"raw_map_last_hr=0x8007000E raw_map_max_hr=0x8007000E raw_map_max_mode=5 raw_map_max_bytes=128"));
+    CHECK(strstr(record,"raw_unmap_calls=1 raw_unmap_ms=0.0200"));
+    CHECK(strstr(record,"index_map_calls=1 index_map_bytes=12")&&strstr(record,"constant_map_calls=1 constant_map_bytes=592"));
+    CHECK(strstr(record,"draw_scope_inclusive_ms=7.0000")&&strstr(record,"present_api_ms=0.2000"));
+    CHECK(!s_slow_frame.sample.maps[SF_RAW].calls); /* Snapshot is reset before log work. */
+    puts("PASS: upload modes, byte totals, API failures/maxima, Unmap and explicitly nested scopes");
+}
+static void test_pending(void)
+{
+    unsigned previous_clocks;reset("1");boundary(now,0);now+=10000;slow_frame_readback_pending(1);
+    previous_clocks=clocks;slow_frame_readback_pending(1);CHECK(clocks==previous_clocks);
+    boundary(1040000,2);CHECK(strstr(record,"pending_wall_overlap_ms=30.0000"));
+    CHECK(s_slow_frame.pending_begin==1040000);
+    boundary(1600000,3);CHECK(logs==2&&strstr(record,"pending_wall_overlap_ms=560.0000"));
+    now=1605000;slow_frame_readback_pending(0);CHECK(s_slow_frame.sample.pending_overlap==5000);
+    boundary(2200000,4);CHECK(logs==3&&strstr(record,"pending_wall_overlap_ms=5.0000"));
+    CHECK(!s_slow_frame.pending_begin);
+    puts("PASS: pending wall overlap is clipped to each exact interval; repeated busy polls add no clocks");
+}
+static void test_limits(void)
+{
+    unsigned before;reset("1");boundary(now,0);boundary(1040000,2);CHECK(logs==1);
+    slow_frame_add_ticks(SF_DRAW_SCOPE,123);boundary(1080000,3);CHECK(logs==1&&s_slow_frame.suppressed==1);
+    CHECK(!s_slow_frame.sample.stage[SF_DRAW_SCOPE].calls);
+    boundary(1539999,4);CHECK(logs==1);boundary(1579999,5);CHECK(logs==2);
+    CHECK(strstr(record,"rate_suppressed=2")&&strstr(record,"draw_scope_inclusive_ms=0.0000"));
+    while(logs<64) boundary(now+500000,logs+5);
+    CHECK(!s_slow_frame.enabled&&s_slow_frame.emitted==64);
+    before=clocks;CHECK(!slow_frame_begin());slow_frame_readback_pending(1);
+    slow_frame_end(SF_DRAW_SCOPE,1);boundary(now+500000,1000);
+    CHECK(logs==64&&clocks==before);
+    puts("PASS: at most1record/500ms,64records total, suppressed per-frame stats reset and clocks stop at budget");
+}
+static void test_clock(void)
+{
+    int64_t begin;reset("1");boundary(now,0);fail_clock=1;begin=slow_frame_begin();CHECK(!begin);
+    slow_frame_map_end(SF_RAW,begin,4,D3D11_MAP_WRITE_DISCARD,E_FAIL);
+    begin=slow_frame_begin();now--;slow_frame_end(SF_PRESENT_API,begin);
+    CHECK(s_slow_frame.sample.invalid_timings==2&&s_slow_frame.sample.maps[SF_RAW].failures==1);
+    CHECK(!s_slow_frame.sample.stage[SF_PRESENT_API].ticks);
+    boundary(1040000,2);CHECK(strstr(record,"timing_invalid=2"));
+    boundary(900000,3);CHECK(s_slow_frame.previous==900000&&s_slow_frame.last_emit==0);
+    boundary(940000,4);CHECK(logs==2&&strstr(record,"start_qpc_ticks=900000 end_qpc_ticks=940000"));
+    puts("PASS: failed/backward clocks retain API counts and never produce negative durations; boundaries rebase");
+}
+static void test_output(void)
+{
+    reset("1");output_ticks=700;boundary(now,0);boundary(1040000,2);
+    CHECK(logs==1&&strstr(record,"diagnostic_output_ms=0.0000"));
+    CHECK(s_slow_frame.sample.stage[SF_DIAGNOSTIC_OUTPUT].ticks==700);
+    boundary(1600000,3);CHECK(logs==2&&strstr(record,"diagnostic_output_ms=0.7000"));
+    CHECK(strstr(record,"record_end=1\n")&&strlen(record)<sizeof record-1);
+    puts("PASS: one complete bounded record; its own formatting/I/O belongs to the following interval");
+}
+int main(int argc,char **argv)
+{
+    CHECK(argc==2);
+    if(!strcmp(argv[1],"off"))test_off();else if(!strcmp(argv[1],"boundary"))test_boundary();
+    else if(!strcmp(argv[1],"maps"))test_maps();else if(!strcmp(argv[1],"pending"))test_pending();
+    else if(!strcmp(argv[1],"limits"))test_limits();else if(!strcmp(argv[1],"clock"))test_clock();
+    else if(!strcmp(argv[1],"output"))test_output();else CHECK(0);
+    return 0;
+}
