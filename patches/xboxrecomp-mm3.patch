+#define ID3D11DeviceContext_Map map_resource
+#define ID3D11Device_CreateBuffer create_buffer
+#define ID3D11DeviceContext_IASetPrimitiveTopology set_topology
+#define ID3D11DeviceContext_RSSetState set_rs
+#define ID3D11DeviceContext_RSSetScissorRects set_scissors
