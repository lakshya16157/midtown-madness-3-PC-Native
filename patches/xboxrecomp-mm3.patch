diff --git a/tests/nv2a_wide_lines/README.md b/tests/nv2a_wide_lines/README.md
new file mode 100644
index 0000000..f04a3b9
--- /dev/null
+++ b/tests/nv2a_wide_lines/README.md
@@ -0,0 +1,13 @@
+# Wide line and point GPU contracts
+
+At a raised internal resolution, D3D11 line and point lists rasterise one host
+pixel wide, so MM3's rain (16384 line segments a frame) all but vanished.
+The renderer draws them through `ub_gs_line` / `ub_gs_point` as quads one guest
+pixel across, scaled by `RECOMP_LINE_WIDTH` (0 keeps one host pixel).
+
+The fixture renders white pre-transformed lines and a point at 3x through the
+production renderer and counts lit host pixels across each: 3 at the default,
+1 with `RECOMP_LINE_WIDTH=0`, 6 at 2. No game data or visible window.
+
+Build this directory with CMake/Ninja in a temporary folder after activating the
+repository toolchain, then run CTest.
diff --git a/tests/nv2a_wide_lines/test_wide_lines.c b/tests/nv2a_wide_lines/test_wide_lines.c
new file mode 100644
index 0000000..f6b05ca
--- /dev/null
+++ b/tests/nv2a_wide_lines/test_wide_lines.c
@@ -0,0 +1,120 @@
+/* Line and point lists at a raised internal resolution draw one guest pixel
+ * wide (ub_gs_line/ub_gs_point), not one host pixel: MM3's rain is 16384
+ * line segments a frame and all but vanished as hairlines. Real GPU output
+ * through the production renderer; no game data or window. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_1.h>
+#include <d3dcompiler.h>
+#include "../../src/video/nv2a_d3d11.c"
+
+static uint8_t ram[0x100000];
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va,uint32_t *pitch) { (void)va; (void)pitch; return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *overlay) { (void)overlay; return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) { (void)draws; }
+const uint32_t (*nv2a_vsh_program(uint32_t *start,uint32_t *version))[4]
+{ (void)start; (void)version; return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4]
+{ (void)version; return NULL; }
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x); exit(1); } } while (0)
+
+static uint32_t *pixels(unsigned *width, unsigned *height)
+{
+    Surface *surface = surface_find(0x20000);
+    ID3D11Texture2D *stage = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    uint32_t *out;
+    unsigned y;
+    CHECK(surface);
+    surface_resolve(surface);
+    ID3D11Texture2D_GetDesc(surface->tex,&desc);
+    out = malloc((size_t)desc.Width * desc.Height * 4); CHECK(out);
+    desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev,&desc,NULL,&stage)));
+    ID3D11DeviceContext_CopyResource(s_ctx,(ID3D11Resource *)stage,(ID3D11Resource *)surface->tex);
+    CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx,(ID3D11Resource *)stage,0,D3D11_MAP_READ,0,&map)));
+    for (y = 0; y < desc.Height; ++y)
+        memcpy(out + (size_t)y * desc.Width,(const uint8_t *)map.pData + (size_t)y * map.RowPitch,desc.Width * 4);
+    ID3D11DeviceContext_Unmap(s_ctx,(ID3D11Resource *)stage,0);
+    ID3D11Texture2D_Release(stage);
+    *width = desc.Width; *height = desc.Height;
+    return out;
+}
+
+static NvD3DState state(void)
+{
+    NvD3DState st = {0};
+    st.color_addr = 0x20000; st.color_pitch = 64 * 4;
+    st.surface_format = 0x28; st.clip_w = st.clip_h = 64;
+    st.color_mask = 0x01010101;
+    return st;
+}
+
+/* Pre-transformed white primitives on black, guest pixel coordinates. */
+static void draw(int topology, const float (*xy)[2], unsigned n)
+{
+    NvD3DState st = state();
+    float pos[4][4] = {{0}}, defaults[16][4] = {{0}};
+    NvD3DAttrib attr[16] = {{0}};
+    uint32_t indices[4] = {0,1,2,3};
+    unsigned i;
+    nv2a_d3d_clear(&st,0xF0,0xFF000000u,0,0,0,63,63);
+    for (i = 0; i < n; ++i) { pos[i][0] = xy[i][0]; pos[i][1] = xy[i][1]; pos[i][3] = 1; }
+    attr[0] = (NvD3DAttrib){1,2,4,16,(const uint8_t *)pos};
+    defaults[3][0] = defaults[3][1] = defaults[3][2] = defaults[3][3] = 1;
+    nv2a_d3d_draw_ub(&st,topology,attr,defaults,0,indices,n,0,n - 1,NULL);
+}
+
+static unsigned lit(const uint32_t *p, unsigned width, unsigned x, unsigned y)
+{
+    return (p[(size_t)y * width + x] & 0xFFu) > 0x80u;
+}
+
+/* Lit rows in one column, lit columns in one row. */
+static unsigned rows(const uint32_t *p, unsigned width, unsigned height, unsigned x)
+{
+    unsigned y, n = 0;
+    for (y = 0; y < height; ++y) n += lit(p,width,x,y);
+    return n;
+}
+static unsigned columns(const uint32_t *p, unsigned width, unsigned y)
+{
+    unsigned x, n = 0;
+    for (x = 0; x < width; ++x) n += lit(p,width,x,y);
+    return n;
+}
+
+int main(int argc,char **argv)
+{
+    static const float across[2][2] = {{8.f,20.5f},{56.f,20.5f}}, down[2][2] = {{30.5f,8.f},{30.5f,56.f}};
+    static const float point[1][2] = {{40.5f,40.5f}};
+    unsigned width, height, expected;
+    uint32_t *p;
+    CHECK(argc == 2);
+    _putenv_s("RECOMP_RENDER_SCALE","3"); _putenv_s("RECOMP_ASPECT","4:3");
+    _putenv_s("RECOMP_MSAA","1"); _putenv_s("RECOMP_FPS_LIMIT","0");
+    if (!strcmp(argv[1],"hairline")) _putenv_s("RECOMP_LINE_WIDTH","0");
+    if (!strcmp(argv[1],"double")) _putenv_s("RECOMP_LINE_WIDTH","2");
+    expected = !strcmp(argv[1],"hairline") ? 1u : !strcmp(argv[1],"double") ? 6u : 3u;
+    CHECK(nv2a_d3d_init());
+    CHECK(!strcmp(argv[1],"hairline") || s_ub_gs_line && s_ub_gs_point);
+    draw(NV_D3D_LINES,across,2); p = pixels(&width,&height);
+    CHECK(width == 192 && height == 192);
+    CHECK(rows(p,width,height,96) == expected);        /* across a horizontal line */
+    CHECK(!lit(p,width,96,61u - expected) && !lit(p,width,96,62u + expected));
+    free(p);
+    draw(NV_D3D_LINES,down,2); p = pixels(&width,&height);
+    CHECK(columns(p,width,96) == expected);            /* across a vertical line */
+    free(p);
+    draw(NV_D3D_POINTS,point,1); p = pixels(&width,&height);
+    CHECK(columns(p,width,121) == expected && rows(p,width,height,121) == expected);
+    free(p);
+    printf("PASS: %s: line and point lists %u host pixels wide at 3x (one guest pixel x RECOMP_LINE_WIDTH)\n",
+           argv[1],expected);
+    return 0;
+}
