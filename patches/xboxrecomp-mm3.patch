+#ifndef DSP_RECOMP_THREADED_UNIT
+int dsp56k_execute_recompiled(dsp_core_t* dsp, int budget, const uint32_t* dma_control, uint32_t dma_running)
+{
+#ifdef DSP_RECOMP_INC
+    /* Capture and matched profiling can request the interpreter even when
+     * this executable already contains the title's compiled programs. */
+    static int interpreter_only = -1;
+    if (interpreter_only < 0) {
+        const char *value = getenv("RECOMP_DSP_INTERPRETER");
+        interpreter_only = value && *value && strcmp(value, "0");
+    }
+    if (interpreter_only) return 0;
+    /* RECOMP_DSP_TRANSLATOR=threaded: the per-word code of the previous
+     * builds instead of the block code; both compute the same state. */
+    static int threaded = -1;
+    if (threaded < 0) {
+        const char *value = getenv("RECOMP_DSP_TRANSLATOR");
+        threaded = value && !strcmp(value, "threaded");
+        fprintf(stderr, "[DSP] compiled programs: %s (RECOMP_DSP_TRANSLATOR=%s selects the %s)\n",
+                threaded ? "threaded per-word code" : "block code",
+                threaded ? "blocks" : "threaded", threaded ? "block code" : "previous per-word code");
+    }
+    if (budget <= 0 || (*dma_control & dma_running) || dsp->loop_rep ||
+        dsp->is_waiting || dsp->is_stopped || dsp->is_debugging || dsp->is_idle ||
+        dsp->bootstrap_failed) return 0;
+    if (threaded)
+        return dsp->is_gp ? dsp_recomp_gp(dsp, budget, dma_control, dma_running)
+                          : dsp_recomp_ep(dsp, budget, dma_control, dma_running);
+    return dsp->is_gp ? dsp_rb_gp(dsp, budget, dma_control, dma_running)
+                      : dsp_rb_ep(dsp, budget, dma_control, dma_running);
+#else
+    (void)dsp; (void)budget; (void)dma_control; (void)dma_running;
+    return 0;
+#endif
+}
+#endif
