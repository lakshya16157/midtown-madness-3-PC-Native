+    if (!strcmp(argv[1], "down_rtv_retry")) return test_down_rtv_retry();
+    if (!strcmp(argv[1], "trace_off") || !strcmp(argv[1], "trace_on")) return test_trace(!strcmp(argv[1], "trace_on"));
+    if (!strcmp(argv[1], "poll_config")) return test_poll_config();
+    if (!strcmp(argv[1], "poll_cadence")) return test_poll_cadence();
+    if (!strcmp(argv[1], "poll_reuse")) return test_poll_reuse();
+    if (!strcmp(argv[1], "poll_clock_failure")) return test_poll_clock_failure();
+    if (!strcmp(argv[1], "poll_runtime")) return test_poll_runtime();
+    CHECK(0);
+}
