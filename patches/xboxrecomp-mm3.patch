+int main(int argc, char **argv)
+{
+    static uint32_t program[DSP_PRAM_SIZE];
+    if (argc != 2) return 2;
+    program[8] = 0x0d0200; /* Long interrupt vector. */
+    program[0x100] = 0x014180; /* ADD #1,A */
+    program[0x101] = 0x014284; /* SUB #2,A */
+    program[0x102] = 0x200000; /* Parallel no-op. */
+    program[0x110] = 0x06c420; /* REP X0 */
+    program[0x111] = 0x014180;
+    program[0x120] = 0x060280; /* DO #2,$123 */
+    program[0x121] = 0x123;
+    program[0x122] = 0x014180;
+    program[0x123] = 0x014180;
+    program[0x130] = 0x0c0200; /* JMP $200, across generated chunks. */
+    program[0x140] = 0x000086; /* WAIT */
+    program[0x200] = 0x44f400; /* MOVE #xxxxxx,X0 */
+    program[0x201] = 0x123456;
+    for (unsigned i = 0; i < 2; ++i) {
+        char path[1024];
