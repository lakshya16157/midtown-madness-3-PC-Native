diff --git a/src/nv2a/nv2a_pvideo_snapshot.h b/src/nv2a/nv2a_pvideo_snapshot.h
new file mode 100644
index 0000000..0701809
--- /dev/null
+++ b/src/nv2a/nv2a_pvideo_snapshot.h
@@ -0,0 +1,39 @@
+/* The PVIDEO words consumed by host scanout, copied as one locked snapshot. */
+#ifndef NV2A_PVIDEO_SNAPSHOT_H
+#define NV2A_PVIDEO_SNAPSHOT_H
+#include <stdint.h>
+#include "nv2a_regs.h"
+
+typedef struct {
+    uint32_t base, offset, size_in, point_in, ds_dx, dt_dy;
+    uint32_t point_out, size_out, format;
+} Nv2aPvideoBank;
+typedef struct {
+    uint32_t buffer, stop, color_key;
+    Nv2aPvideoBank bank[2];
+} Nv2aPvideoSnapshot;
+
+/* Modeled registers use byte offsets as array indices. The legacy dump API
+ * packs them at offset/4 instead. Both sources produce identical scanout data. */
+static inline void nv2a_pvideo_snapshot_read(Nv2aPvideoSnapshot *out,
+                                            const uint32_t *regs, unsigned stride)
+{
+    out->buffer = regs[(NV_PVIDEO_BUFFER / 4) * stride];
+    out->stop = regs[(NV_PVIDEO_STOP / 4) * stride];
+    out->color_key = regs[(NV_PVIDEO_COLOR_KEY / 4) * stride];
+    for (unsigned bank = 0; bank < 2; ++bank) {
+        Nv2aPvideoBank *b = &out->bank[bank];
+#define PV_COPY(field, reg) b->field = regs[((reg) / 4 + bank) * stride]
+        PV_COPY(base, NV_PVIDEO_BASE);
+        PV_COPY(offset, NV_PVIDEO_OFFSET);
+        PV_COPY(size_in, NV_PVIDEO_SIZE_IN);
+        PV_COPY(point_in, NV_PVIDEO_POINT_IN);
+        PV_COPY(ds_dx, NV_PVIDEO_DS_DX);
+        PV_COPY(dt_dy, NV_PVIDEO_DT_DY);
+        PV_COPY(point_out, NV_PVIDEO_POINT_OUT);
+        PV_COPY(size_out, NV_PVIDEO_SIZE_OUT);
+        PV_COPY(format, NV_PVIDEO_FORMAT);
+#undef PV_COPY
+    }
+}
+#endif
