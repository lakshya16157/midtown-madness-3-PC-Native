+        VERBATIM)
+    add_dependencies(xbox_apu dsp_recomp_programs)
+    # Block code builds with dsp_cpu.c, the per-word code in its own unit
+    # (DSP_RECOMP_SPLIT), so the two halves compile in parallel.
+    target_sources(xbox_apu PRIVATE dsp/interp/dsp_recomp_threaded.c)
+    target_compile_definitions(xbox_apu PRIVATE DSP_RECOMP_INC="${dsp_recomp_inc}" DSP_RECOMP_SPLIT)
+    set_source_files_properties(dsp/interp/dsp_cpu.c dsp/interp/dsp_recomp_threaded.c
+        PROPERTIES OBJECT_DEPENDS ${dsp_recomp_inc})
+    if(MSVC)
+        # The per-word code is also the block code's word-by-word step: keep
+        # its helpers inlined as in dsp_cpu.c (RelWithDebInfo defaults to /Ob1).
+        set_property(SOURCE dsp/interp/dsp_recomp_threaded.c APPEND PROPERTY
+            COMPILE_OPTIONS "$<$<NOT:$<CONFIG:Debug>>:/Ob2>")
+    endif()
+endif()
