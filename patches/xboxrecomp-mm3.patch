+    puts("PASS: a target written on 8 syncs in a row is hashed until its retry kick");
+
+    /* Outside the watched window: every kick hashes, as without a watch. */
+    z = surface_get(0x20000, 32 * 4, 8, 32, 16, 0);
+    CHECK(z && !z->watch_ok && synced_with_hash(z) && synced_with_hash(z));
+    nv2a_d3d_set_write_watch(NULL);
+    CHECK(synced_with_hash(a) && synced_with_hash(a));
+    puts("PASS: low-RAM targets and a missing watch hash at every kick");
+}
+
+static void test_watch_real(void)
+{
+    const uint32_t base = 0x100000u;
+    HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, 64 * 4096, NULL);
+    uint8_t *view, *alias;
+    Surface *a, *c;
+    uint64_t f0, f1;
+    uint32_t gen;
+    CHECK(section);
+    view = (uint8_t *)MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, 64 * 4096);
+    alias = (uint8_t *)MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, 64 * 4096);
+    CHECK(view && alias);
+    s_test_offset = (ptrdiff_t)view - (ptrdiff_t)base;
+    CHECK(gww_init(base, view, 64 * 4096, alias, 64 * 4096, section));
+    nv2a_d3d_set_write_watch(gww_ops());
+    s_prof_on = 1;
+
+    a = surface_get(base, 32 * 4, 8, 32, 16, 0);
+    CHECK(a && a->watch_ok && !synced_with_hash(a));
+    clear_gpu(a);
+    writeback_surfaces();
+    gww_stats(&f0, NULL);
+    CHECK(writeback_finish(1));
+    gww_stats(&f1, NULL);
+    CHECK(f1 == f0 && (guest_word(base) & 0xFFFFFFu) == 0xFF0000u);   /* no faults */
+    CHECK(!synced_with_hash(a));                                      /* no re-hash */
+    gen = a->gen;
+    *(volatile uint32_t *)(alias + 5 * a->pitch + 12) = 0xFF00FF00u;  /* CPU, via the alias */
+    gww_stats(&f1, NULL);
+    CHECK(f1 == f0 + 1);
+    CHECK(synced_with_hash(a) && a->gen == gen + 1 && pixel(a, 3, 5) == 0xFF00FF00u);
+    CHECK(!synced_with_hash(a));
+
+    c = surface_get(base + 0x8000, 32 * 4, 8, 32, 16, 1);
+    CHECK(c && c->watch_ok && !synced_with_hash(c));
+    gen = c->gen;
+    *(volatile uint32_t *)(view + 0x8000 + 4 * (3 + 8 + 48)) = 0xFF0000FFu;
+    CHECK(synced_with_hash(c) && c->gen == gen + 1 && pixel(c, 5, 7) == 0xFF0000FFu);
+    puts("PASS: real watch: write-back through the writer view neither faults nor re-hashes; CPU writes are caught");
+}
