+        CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    }
+    CHECK(open_asset("d:\\asset.bin", NULL, ACCESS | XBOX_GENERIC_WRITE, 1, OPTIONS, &h) == STATUS_SUCCESS && (mode(h) & 8));
