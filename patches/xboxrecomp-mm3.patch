+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "DSP capture %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+static void no_scratch(void *o, uint8_t *p, uint32_t a, size_t n, bool dir)
+{ (void)o; (void)p; (void)a; (void)n; (void)dir; CHECK(0); }
+static void no_fifo(void *o, uint8_t *p, unsigned a, size_t n, bool dir)
+{ (void)o; (void)p; (void)a; (void)n; (void)dir; CHECK(0); }
+static int light;
+static void run_frames(DSPState *dsp)
+{
+    for (unsigned frame = 0; frame < 1501; ++frame) {
+        dsp_start_frame(dsp);
+        dsp_run(dsp, light ? 100 : 3000);
+        CHECK(dsp->core.cycle_count >= (light ? 100u : 2000u));
+    }
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2 || argc == 3);
+    light = argc == 3;
+    int low_default = light && !strcmp(argv[2], "--light-default");
+    CHECK(!_putenv_s("RECOMP_DSP_CAPTURE_ALL", light && !low_default ? "1" : "0"));
+    CHECK(!_putenv_s("RECOMP_DSP_PROGRAM_DIR", argv[1]));
+    for (unsigned index = 0; index < 2; ++index) {
+        char path[1024], temporary[1060];
+        uint32_t program[DSP_PRAM_SIZE];
+        snprintf(path, sizeof(path), "%s/%s.p.bin", argv[1], index ? "ep" : "gp");
+        snprintf(temporary, sizeof(temporary), "%s.%lu.tmp", path, GetCurrentProcessId());
+        DeleteFileA(path);
+        DSPState *dsp = dsp_init(NULL, no_scratch, no_fifo, index == 0); CHECK(dsp);
+        dsp_write_memory(dsp, 'P', 0, 0x0c0000); /* Endless JMP 0, bounded by dsp_run. */
+        dsp_write_memory(dsp, 'P', 0x700, 0x123456); /* Never executed: not code. */
+        run_frames(dsp);
+        if (low_default) {
+            CHECK(GetFileAttributesA(path) == INVALID_FILE_ATTRIBUTES);
+            free(dsp);
+            continue;
+        }
+        FILE *file = fopen(path, "rb"); CHECK(file);
+        CHECK(fread(program, sizeof(program), 1, file) == 1 && fgetc(file) == EOF && !fclose(file));
+        CHECK(program[0] == 0x0c0000 && !program[0x700]);
+        CHECK(GetFileAttributesA(temporary) == INVALID_FILE_ATTRIBUTES);
+        WIN32_FILE_ATTRIBUTE_DATA before, after;
+        CHECK(GetFileAttributesExA(path, GetFileExInfoStandard, &before));
+        run_frames(dsp);
+        CHECK(GetFileAttributesExA(path, GetFileExInfoStandard, &after));
+        CHECK(CompareFileTime(&before.ftLastWriteTime, &after.ftLastWriteTime) == 0);
+        dsp_reset(dsp);
+        dsp_write_memory(dsp, 'P', 0, 0x0c0001);
+        dsp_write_memory(dsp, 'P', 1, 0x0c0000);
+        run_frames(dsp);
+        file = fopen(path, "rb"); CHECK(file);
+        CHECK(fread(program, sizeof(program), 1, file) == 1 && fgetc(file) == EOF && !fclose(file));
+        CHECK(program[0] == 0x0c0001 && program[1] == 0x0c0000 && !program[0x700]);
+        free(dsp);
+        CHECK(DeleteFileA(path));
+    }
+    puts("DSP program capture: complete atomic files, executed words, stable no-rewrite and post-reset updates");
+    return 0;
+}
diff --git a/tests/dsp/dsp_recomp_equivalence.c b/tests/dsp/dsp_recomp_equivalence.c
new file mode 100644
index 0000000..4f4fdea
--- /dev/null
+++ b/tests/dsp/dsp_recomp_equivalence.c
@@ -0,0 +1,137 @@
+#include "dsp.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "DSP native equivalence %d: %s\n", __LINE__, #c); exit(1); \
+} } while (0)
+static unsigned steps, native_steps;
+
+static void compare(dsp_core_t *reference, dsp_core_t *actual, unsigned count)
+{
+    for (unsigned i = 0; i < count; ++i) {
+        uint32_t dma = 0;
+        int used = dsp56k_execute_recompiled(actual, 1, &dma, 1);
+        if (used) ++native_steps;
+        else {
+            dsp56k_execute_instruction(actual);
+            actual->cycle_count += actual->instr_cycle;
+        }
+        dsp56k_execute_instruction(reference);
+        reference->cycle_count += reference->instr_cycle;
+        memset((void *)reference->pram_opcache, 0, sizeof(reference->pram_opcache));
+        memset((void *)actual->pram_opcache, 0, sizeof(actual->pram_opcache));
+        if (memcmp(reference, actual, sizeof(*actual))) {
+            fprintf(stderr, "PC actual=%x expected=%x native cycles=%d\n",
+                    actual->pc, reference->pc, used);
+            for (size_t a = 0; a < sizeof(*actual); ++a)
+                if (((uint8_t *)actual)[a] != ((uint8_t *)reference)[a]) {
+                    fprintf(stderr, "first differing byte=%zu actual=%02x expected=%02x\n",
+                            a, ((uint8_t *)actual)[a], ((uint8_t *)reference)[a]);
+                    break;
+                }
+            CHECK(0);
+        }
+        ++steps;
+        if (actual->is_waiting || actual->is_stopped || actual->is_idle) break;
+    }
+}
+/* Larger budgets: compiled code runs whole blocks; the interpreter catches
+ * up to the same cycle count, which must land on the same boundary. */
+static void compare_blocks(dsp_core_t *reference, dsp_core_t *actual, unsigned calls, int budget)
+{
+    for (unsigned i = 0; i < calls; ++i) {
+        uint32_t dma = 0;
+        int used = dsp56k_execute_recompiled(actual, budget, &dma, 1);
+        if (used) {
+            ++native_steps;
+            while (reference->cycle_count < actual->cycle_count) {
+                dsp56k_execute_instruction(reference);
+                reference->cycle_count += reference->instr_cycle;
+                ++steps;
+            }
+        } else {
+            dsp56k_execute_instruction(actual);
+            actual->cycle_count += actual->instr_cycle;
+            dsp56k_execute_instruction(reference);
+            reference->cycle_count += reference->instr_cycle;
+            ++steps;
+        }
+        memset((void *)reference->pram_opcache, 0, sizeof(reference->pram_opcache));
+        memset((void *)actual->pram_opcache, 0, sizeof(actual->pram_opcache));
+        if (memcmp(reference, actual, sizeof(*actual))) {
+            fprintf(stderr, "budget %d: PC actual=%x expected=%x native cycles=%d\n",
+                    budget, actual->pc, reference->pc, used);
+            CHECK(0);
+        }
+        if (actual->is_waiting || actual->is_stopped || actual->is_idle) break;
+    }
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2 || argc == 3);
+    int interpreter_only = argc == 3 && !strcmp(argv[2], "--interpreter");
+    if (interpreter_only) {
+#ifdef _WIN32
+        CHECK(!_putenv_s("RECOMP_DSP_INTERPRETER", "1"));
+#else
+        CHECK(!setenv("RECOMP_DSP_INTERPRETER", "1", 1));
+#endif
+    }
+    dsp_core_t *initial = calloc(1, sizeof(*initial));
+    dsp_core_t *reference = malloc(sizeof(*reference)), *actual = malloc(sizeof(*actual));
+    CHECK(initial && reference && actual);
+    dsp56k_reset_cpu(initial);
+    char path[1024]; snprintf(path, sizeof(path), "%s/gp.p.bin", argv[1]);
+    FILE *file = fopen(path, "rb"); CHECK(file);
+    CHECK(fread(initial->pram, sizeof(initial->pram), 1, file) == 1 && !fclose(file));
+    initial->is_idle = false;
+    initial->registers[DSP_REG_SR] = 0;
+    initial->registers[DSP_REG_X0] = 3;
+    const unsigned starts[] = {0x100, 0x110, 0x120, 0x130, 0x140, 0x200, 0x210};
+    for (unsigned gp = 0; gp < 2; ++gp)
+    for (unsigned i = 0; i < sizeof(starts)/sizeof(*starts); ++i) {
+        initial->is_gp = gp != 0; initial->pc = starts[i];
+        *reference = *actual = *initial;
+        compare(reference, actual, 12);
+        const int budgets[] = {2, 3, 5, 9, 1000};
+        for (unsigned b = 0; b < sizeof(budgets)/sizeof(*budgets); ++b) {
+            *reference = *actual = *initial;
+            compare_blocks(reference, actual, 12, budgets[b]);
+        }
+    }
+    /* A changed opcode falls back; an extension word is read dynamically. */
+    initial->pc = 0x100; initial->pram[0x100] = 0x014284;
+    uint32_t dma = 0;
+    CHECK(dsp56k_execute_recompiled(initial, 10, &dma, 1) == 0);
+    *reference = *actual = *initial; compare(reference, actual, 1);
+    initial->pc = 0x200; initial->pram[0x201] = 0x654321;
+    *reference = *actual = *initial; compare(reference, actual, 1);
+    CHECK(actual->registers[DSP_REG_X0] == 0x654321);
+    initial->pc = 0x102;
+    dma = 1; CHECK(!dsp56k_execute_recompiled(initial, 100, &dma, 1));
+    dma = 0;
+    initial->is_waiting = true; CHECK(!dsp56k_execute_recompiled(initial, 100, &dma, 1));
+    initial->is_waiting = false; initial->loop_rep = 1;
+    CHECK(!dsp56k_execute_recompiled(initial, 100, &dma, 1));
+    initial->loop_rep = 0;
+    for (unsigned pending = 0; pending < 2; ++pending)
+    for (unsigned pipeline = 0; pipeline < 7; ++pipeline) {
+        initial->interrupt_state = DSP_INTERRUPT_DISABLED;
+        initial->interrupt_pipeline_count = (uint16_t)pipeline;
+        initial->interrupt_counter = (uint16_t)pending;
+        initial->interrupt_is_pending[0] = (uint16_t)pending;
+        initial->interrupt_ipl[0] = 2;
+        initial->interrupt_save_pc = 0x101;
+        initial->interrupt_instr_fetch = 8;
+        initial->interrupt_ipl_to_raise = 2;
+        *reference = *actual = *initial;
+        compare(reference, actual, 1);
+    }
+    CHECK((interpreter_only ? !native_steps : native_steps > 20) && steps > native_steps);
+    printf("DSP native: %u instruction boundaries matched full state (%u native); "
+           "DO/REP/WAIT, missing/changed words, dynamic extensions, chunk branches, DMA and interrupts\n",
+           steps, native_steps);
+    free(initial); free(reference); free(actual);
+    return 0;
+}
diff --git a/tests/dsp/dsp_recomp_fixture.c b/tests/dsp/dsp_recomp_fixture.c
