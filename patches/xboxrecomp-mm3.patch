+}
diff --git a/tests/dsp/dsp_recomp_fuzz.c b/tests/dsp/dsp_recomp_fuzz.c
new file mode 100644
index 0000000..da89871
--- /dev/null
+++ b/tests/dsp/dsp_recomp_fuzz.c
@@ -0,0 +1,159 @@
+/* dsp_recomp_fuzz <program dir> [states]: every word of the compiled GP and
+ * EP programs as an entry point, on random register states, through the
+ * compiled code (as dsp_run calls it, with several budgets) and through the
+ * interpreter alone; the full processor state must match at every return.
+ * Extension words the capture does not hold get small random values; a
+ * trial ends where execution leaves the compiled words. */
+#include "dsp.h"
+#include "dsp_port.h"
+#include "dsp_dma_regs.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+#include <signal.h>
+#ifdef _WIN32
+#include <crtdbg.h>
+#endif
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "DSP fuzz %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+
+static uint32_t seed = 0x1234567u;
+static uint32_t rnd(void) { seed = seed * 1103515245u + 12345u; return seed >> 8; }
+static void no_scratch(void *o, uint8_t *p, uint32_t a, size_t l, bool d) { (void)o; (void)a; (void)d; if (!d) memset(p, 0, l); }
+static void no_fifo(void *o, uint8_t *p, unsigned a, size_t l, bool d) { (void)o; (void)a; (void)d; if (!d) memset(p, 0, l); }
+
+static DSPState *reference, *actual;
+static DSPState scratch_a, scratch_b;
+static unsigned long compared, native_calls, skipped;
+/* Random pointers can leave the RAM arrays: the interpreter only asserts
+ * there, so this test builds with assertions and skips such a trial. */
+static jmp_buf trial_exit;
+static void assertion(int signal_number) { (void)signal_number; longjmp(trial_exit, 1); }
+
+static void compare(uint32_t start, int budget)
+{
+    scratch_a = *reference; scratch_b = *actual;
+    DSPState *s[2] = {&scratch_a, &scratch_b};
+    for (int i = 0; i < 2; i++) {
+        memset((void *)s[i]->core.pram_opcache, 0, sizeof(s[i]->core.pram_opcache));
+        s[i]->core.opaque = NULL; s[i]->core.read_peripheral = NULL; s[i]->core.write_peripheral = NULL;
+        s[i]->dma.mem_opaque = s[i]->dma.rw_opaque = NULL;
+        s[i]->dma.mem_read = NULL; s[i]->dma.mem_write = NULL;
+        s[i]->dma.scratch_rw = NULL; s[i]->dma.fifo_rw = NULL;
+    }
+    if (memcmp(&scratch_a, &scratch_b, sizeof(scratch_a))) {
+        fprintf(stderr, "%s start %03X budget %d: PC actual=%X expected=%X cycles %u/%u\n",
+                reference->is_gp ? "GP" : "EP", start, budget, actual->core.pc, reference->core.pc,
+                actual->core.cycle_count, reference->core.cycle_count);
+        for (unsigned r = 0; r < DSP_REG_MAX; r++)
+            if (scratch_a.core.registers[r] != scratch_b.core.registers[r])
+                fprintf(stderr, "  register %02X actual=%06X expected=%06X\n", r,
+                        scratch_b.core.registers[r], scratch_a.core.registers[r]);
+        for (size_t i = 0; i < sizeof(scratch_a); i++)
+            if (((uint8_t *)&scratch_a)[i] != ((uint8_t *)&scratch_b)[i]) {
+                fprintf(stderr, "  first differing byte %zu\n", i);
+                break;
+            }
+        exit(1);
+    }
+    compared++;
+}
+
+static void randomise(DSPState *d, const uint32_t *image, int mode)
+{
+    dsp_reset(d);
+    dsp_core_t *c = &d->core;
+    for (unsigned a = 0; a < DSP_PRAM_SIZE; a++) c->pram[a] = image[a] ? image[a] : rnd() & 0x3ff;
+    /* Memory holds pointers the programs load: keep every value an address
+     * inside the RAM arrays; registers start with full-range data. */
+    for (unsigned a = 0; a < DSP_XRAM_SIZE; a++) c->xram[a] = rnd() & 0x3ff;
+    for (unsigned a = 0; a < DSP_YRAM_SIZE; a++) c->yram[a] = rnd() & 0x3ff;
+    for (unsigned a = 0; a < DSP_MIXBUFFER_SIZE; a++) c->mixbuffer[a] = rnd() & 0x3ff;
+    static const uint32_t edge[] = {0, 0x7fffff, 0x800000, 0xffffff, 1, 0x400000};
+    for (unsigned r = DSP_REG_X0; r <= DSP_REG_B1; r++)
+        c->registers[r] = rnd() % 4 ? rnd() & 0xffffff : edge[rnd() % 6];
+    c->registers[DSP_REG_A2] = rnd() % 3 ? (c->registers[DSP_REG_A1] & 0x800000 ? 0xff : 0) : rnd() & 0xff;
+    c->registers[DSP_REG_B2] = rnd() % 3 ? (c->registers[DSP_REG_B1] & 0x800000 ? 0xff : 0) : rnd() & 0xff;
+    for (unsigned r = 0; r < 8; r++) {
+        c->registers[DSP_REG_R0 + r] = rnd() & 0x3ff;
+        c->registers[DSP_REG_N0 + r] = rnd() & 7;
+        c->registers[DSP_REG_M0 + r] = mode == 1 && r == (rnd() & 7) ? 0x00f : 0xffffff;
+    }
+    uint32_t sr = rnd() & 0xff;
+    if (mode == 2) sr |= (rnd() & 3) << DSP_SR_S0;
+    if (mode == 3) sr |= 1u << DSP_SR_SA;
+    c->registers[DSP_REG_SR] = sr;
+    c->registers[DSP_REG_LC] = rnd() & 7;
+    c->registers[DSP_REG_LA] = rnd() & 0xfff;
+    c->registers[DSP_REG_SP] = rnd() & 3;
+    c->registers[DSP_REG_SSH] = rnd() & 0xfff;
+    c->registers[DSP_REG_SSL] = rnd() & 0xff;
+    for (unsigned i = 0; i < 16; i++) { c->stack[0][i] = rnd() & 0xfff; c->stack[1][i] = rnd() & 0xff; }
+    memset((void *)c->pram_opcache, 0, sizeof(c->pram_opcache));
+    c->is_idle = c->is_waiting = c->is_stopped = false;
+    c->loop_rep = 0;
+    c->cycle_count = 0;
+}
+
+static void trial(const uint32_t *image, uint32_t start, int mode, int budget)
+{
+    randomise(reference, image, mode);
+    reference->core.pc = start;
+    /* Same state in both, each with its own peripheral wiring. */
+    dsp_core_t keep = actual->core;
+    actual->core = reference->core;
+    actual->core.opaque = keep.opaque;
+    actual->core.read_peripheral = keep.read_peripheral;
+    actual->core.write_peripheral = keep.write_peripheral;
+    actual->dma = reference->dma;
+    actual->dma.mem_opaque = &actual->core;
+    actual->dma.rw_opaque = NULL;
+    for (int call = 0; call < 40; call++) {
+        uint32_t pc = actual->core.pc;
+        if (pc >= DSP_PRAM_SIZE || !image[pc] || actual->core.is_idle || actual->core.is_waiting ||
+            actual->core.is_stopped || actual->core.loop_rep || (actual->dma.control & DMA_CONTROL_RUNNING)) return;
+        int used = dsp56k_execute_recompiled(&actual->core, budget, &actual->dma.control, DMA_CONTROL_RUNNING);
+        if (!used) return;
+        native_calls++;
+        while (reference->core.cycle_count < actual->core.cycle_count) {
+            dsp56k_execute_instruction(&reference->core);
+            reference->core.cycle_count += reference->core.instr_cycle;
+        }
+        compare(start, budget);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2 || argc == 3);
+#ifdef _WIN32
+    _set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+    _set_error_mode(_OUT_TO_STDERR);
+#endif
+    unsigned states = argc == 3 ? (unsigned)strtoul(argv[2], NULL, 10) : 3;
+    for (int gp = 1; gp >= 0; gp--) {
+        static uint32_t image[DSP_PRAM_SIZE];
+        char path[1024];
+        snprintf(path, sizeof(path), "%s/%s.p.bin", argv[1], gp ? "gp" : "ep");
+        FILE *f = fopen(path, "rb");
+        CHECK(f && fread(image, 4, DSP_PRAM_SIZE, f) == DSP_PRAM_SIZE && !fclose(f));
+        reference = dsp_init(NULL, no_scratch, no_fifo, gp);
+        actual = dsp_init(NULL, no_scratch, no_fifo, gp);
+        CHECK(reference && actual);
+        static const int budgets[] = {1000, 7, 40};
+        for (uint32_t start = 0; start < DSP_PRAM_SIZE; start++) {
+            if (!image[start]) continue;
+            for (unsigned s = 0; s < states; s++) {
+                signal(SIGABRT, assertion);
+                if (setjmp(trial_exit)) { skipped++; continue; }
+                trial(image, start, s % 4, budgets[s % 3]);
+            }
+        }
+        free(reference); free(actual);
+    }
+    printf("DSP fuzz: %lu block returns matched the interpreter's full state "
+           "(%lu trials left the RAM arrays and were skipped)\n", compared, skipped);
+    CHECK(compared > 1000);
+    return 0;
+}
diff --git a/tests/dsp/dsp_reference_fallback.c b/tests/dsp/dsp_reference_fallback.c
new file mode 100644
index 0000000..ee5b743
--- /dev/null
+++ b/tests/dsp/dsp_reference_fallback.c
@@ -0,0 +1,9 @@
+/* The unchanged pinned CPU has no native-program dispatcher. Keep the
+ * shared DMA/peripheral replay wrapper on its reference interpreter path. */
+#include "interp/dsp_cpu.h"
+int dsp56k_execute_recompiled(dsp_core_t *dsp, int budget,
+    const uint32_t *dma_control, uint32_t dma_running)
+{
+    (void)dsp; (void)budget; (void)dma_control; (void)dma_running;
+    return 0;
+}
diff --git a/tests/dsp/dsp_switch_test.c b/tests/dsp/dsp_switch_test.c
new file mode 100644
index 0000000..a8d6832
--- /dev/null
+++ b/tests/dsp/dsp_switch_test.c
@@ -0,0 +1,34 @@
+#include "apu_state.h"
+#include <stdio.h>
+#include <stdlib.h>
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "DSP switch %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+struct McpxApuDebug g_dbg;
+int dsp_test_fail_alloc;
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t address) { (void)address; CHECK(0); return NULL; }
+int main(void)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d)); CHECK(d);
+    qemu_mutex_init(&d->lock);
+    qemu_mutex_init(&d->dsp_lock);
+    qemu_cond_init(&d->cond);
+    CHECK(!_putenv_s("RECOMP_APU_DSP", "0"));
+    mcpx_apu_dsp_init(d);
+    CHECK(d->monitor.point == MCPX_APU_DEBUG_MON_VP);
+    d->gp.regs[NV_PAPU_GPRST] = 3;
+    dsp_write_memory(d->gp.dsp, 'P', 0, 0x0c0000);
+    d->gp.dsp->core.pc = 0;
+    float bins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = {0};
+    qemu_mutex_lock(&d->dsp_lock);
+    mcpx_apu_dsp_frame(d, bins, 0);
+    qemu_mutex_unlock(&d->dsp_lock);
+    CHECK(d->gp.dsp->core.cycle_count >= 4000 && d->gp.dsp->core.cycle_count <= 4004);
+    CHECK(!d->gp.dsp->core.is_idle && !d->monitor.ep_pcm_ready);
+    free(d->gp.dsp); free(d->ep.dsp);
+    CHECK(!_putenv_s("RECOMP_APU_DSP", "1"));
+    mcpx_apu_dsp_init(d);
+    CHECK(d->monitor.point == MCPX_APU_DEBUG_MON_GP_OR_EP);
+    free(d->gp.dsp); free(d->ep.dsp); free(d);
+    puts("DSP switch: accurate default, voice-only selection and bounded handshake work");
+    return 0;
+}
diff --git a/tests/dsp/dsp_worker_test.c b/tests/dsp/dsp_worker_test.c
new file mode 100644
index 0000000..e7c190e
--- /dev/null
+++ b/tests/dsp/dsp_worker_test.c
@@ -0,0 +1,230 @@
+/* Real worker/condition queue; only DSP execution and thread-creation failure
+ * are controlled. Ownership, waiting and copied jobs are production code. */
+#include "apu_state.h"
+
+#define CHECK(c) do { if (!(c)) { \
+    fprintf(stderr, "DSP worker line %d: %s\n", __LINE__, #c); exit(1); \
+} } while (0)
+
+static MCPXAPUState *device;
+static HANDLE idle, waiting, entered, release_frame, producer_done;
+static volatile LONG calls;
+static volatile LONG done_notifications, premature_done_notifications;
+static int fail_creation, gate, trace_case;
+static unsigned sequence[32], divisions[32], threads[32];
+
+static HANDLE WINAPI checked_create(LPSECURITY_ATTRIBUTES security, SIZE_T stack,
+    LPTHREAD_START_ROUTINE routine, LPVOID parameter, DWORD flags, LPDWORD id)
+{
+    if (fail_creation) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    return CreateThread(security, stack, routine, parameter, flags, id);
+}
+static void observed_wait(QemuCond *condition, QemuMutex *mutex)
+{
+    if (device && condition == &device->dsp_job_cond) SetEvent(idle);
+    if (device && condition == &device->dsp_done_cond) SetEvent(waiting);
+    qemu_cond_wait(condition, mutex);
+}
+static void observed_broadcast(QemuCond *condition)
+{
+    if (device && condition == &device->dsp_done_cond) {
+        InterlockedIncrement(&done_notifications);
+        if (device->dsp_job_count) InterlockedIncrement(&premature_done_notifications);
+    }
+    qemu_cond_broadcast(condition);
+}
+#define CreateThread checked_create
+#define qemu_cond_wait observed_wait
+#define qemu_cond_broadcast observed_broadcast
+#include "../../src/apu/apu_dsp_worker.c"
+#undef qemu_cond_broadcast
+#undef qemu_cond_wait
+#undef CreateThread
+
+void mcpx_apu_dsp_frame(MCPXAPUState *d,
+    float bins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME], int div)
+{
+    CHECK(d == device);
+    unsigned call = (unsigned)InterlockedIncrement(&calls) - 1;
+    CHECK(call < 32);
+    sequence[call] = (unsigned)bins[0][0];
+    divisions[call] = (unsigned)div;
+    threads[call] = GetCurrentThreadId();
+    CHECK(bins[NUM_MIXBINS - 1][NUM_SAMPLES_PER_FRAME - 1] == bins[0][0] + 0.5f);
+    if (gate) {
+        SetEvent(entered);
+        CHECK(WaitForSingleObject(release_frame, 2000) == WAIT_OBJECT_0);
+        gate = 0;
+    }
+}
+static void post(unsigned number)
+{
+    float bins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = {0};
+    bins[0][0] = (float)number;
+    bins[NUM_MIXBINS - 1][NUM_SAMPLES_PER_FRAME - 1] = number + 0.5f;
+    mcpx_apu_dsp_worker_post(device, bins, (int)number + 100);
+    memset(bins, 0x55, sizeof(bins)); /* Queue owns a copy, not this stack. */
+}
+static DWORD WINAPI ninth_job(void *unused)
+{
+    (void)unused;
+    qemu_mutex_lock(&device->lock);
+    LARGE_INTEGER begin = {0}, end = {0};
+    if (trace_case) {
+        CHECK(QueryPerformanceCounter(&begin));
+        apu_dsp_trace_begin(&device->dsp_trace, begin.QuadPart, device->dsp_generation, 109);
+    }
+    post(9);
+    if (trace_case) {
+        CHECK(QueryPerformanceCounter(&end));
+        apu_dsp_trace_finish(&device->dsp_trace, end.QuadPart);
+    }
+    qemu_mutex_unlock(&device->lock);
+    SetEvent(producer_done);
+    return 0;
+}
+static void create_device(void)
+{
+    device = calloc(1, sizeof(*device)); CHECK(device);
+    idle = CreateEventA(NULL, TRUE, FALSE, NULL);
+    waiting = CreateEventA(NULL, TRUE, FALSE, NULL);
+    entered = CreateEventA(NULL, TRUE, FALSE, NULL);
+    release_frame = CreateEventA(NULL, TRUE, FALSE, NULL);
+    producer_done = CreateEventA(NULL, TRUE, FALSE, NULL);
+    CHECK(idle && waiting && entered && release_frame && producer_done);
+    qemu_mutex_init(&device->lock);
+    LARGE_INTEGER frequency = {0};
+    if (trace_case) CHECK(QueryPerformanceFrequency(&frequency));
+    apu_dsp_trace_init(&device->dsp_trace, trace_case, 0, frequency.QuadPart);
+    mcpx_apu_dsp_worker_init(device);
+}
+static void destroy_device(void)
+{
+    qatomic_set(&device->exiting, true);
+    mcpx_apu_dsp_worker_stop(device);
+    CHECK(!device->dsp_worker_started);
+    qemu_mutex_destroy(&device->lock);
+    free(device); device = NULL;
+    CloseHandle(idle); CloseHandle(waiting); CloseHandle(entered);
+    CloseHandle(release_frame); CloseHandle(producer_done);
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    trace_case = !strcmp(argv[1], "trace") || !strcmp(argv[1], "trace_fallback");
+    fail_creation = !strcmp(argv[1], "fallback") || !strcmp(argv[1], "trace_fallback");
+    create_device();
+    CHECK(device->dsp_worker_started == !fail_creation);
+    if (!fail_creation) {
+        CHECK(WaitForSingleObject(idle, 2000) == WAIT_OBJECT_0);
+        CHECK(!calls); /* Idle worker reaches a blocking condition wait. */
+    }
+    if (!strcmp(argv[1], "drain")) {
+        /* Hold the DSP execution lock until all eight jobs are queued. The
+         * sole done notification must coincide with the empty predicate, not
+         * each of the seven intermediate completions. Real condition waiting
+         * and worker execution still exercise the notification handshake. */
+        qemu_mutex_lock(&device->lock);
+        qemu_mutex_lock(&device->dsp_lock);
+        for (unsigned i = 1; i <= 8; ++i) post(i);
+        CHECK(device->dsp_job_count == 8 && !done_notifications);
+        qemu_mutex_unlock(&device->dsp_lock);
+        mcpx_apu_dsp_worker_wait(device);
+        CHECK(!device->dsp_job_count && calls == 8 && done_notifications == 1);
+        qemu_mutex_unlock(&device->lock);
+        for (unsigned i = 0; i < 8; ++i)
+            CHECK(sequence[i] == i + 1 && divisions[i] == i + 101);
+    } else if (!strcmp(argv[1], "queue") || !strcmp(argv[1], "full_reset") || !strcmp(argv[1], "trace")) {
+        int reset = !strcmp(argv[1], "full_reset");
+        qemu_mutex_lock(&device->lock);
+        qemu_mutex_lock(&device->dsp_lock);
+        for (unsigned i = 1; i <= 8; ++i) post(i);
+        CHECK(device->dsp_job_count == 8);
+        qemu_mutex_unlock(&device->lock);
+        HANDLE producer = CreateThread(NULL, 0, ninth_job, NULL, 0, NULL); CHECK(producer);
+        CHECK(WaitForSingleObject(waiting, 2000) == WAIT_OBJECT_0);
+        CHECK(WaitForSingleObject(producer_done, 0) == WAIT_TIMEOUT);
+        CHECK(TryEnterCriticalSection(&device->lock.cs)); /* Wait releases APU lock. */
+        if (reset) ++device->dsp_generation; /* Reset while post waits for capacity. */
+        LeaveCriticalSection(&device->lock.cs);
+        qemu_mutex_unlock(&device->dsp_lock);
+        CHECK(WaitForSingleObject(producer, 2000) == WAIT_OBJECT_0);
+        CloseHandle(producer);
+        qemu_mutex_lock(&device->lock);
+        mcpx_apu_dsp_worker_wait(device);
+        CHECK(device->dsp_job_count == 0 && calls == (reset ? 0 : 9));
+        CHECK(done_notifications == (reset ? 1 : 2));
+        if (trace_case) {
+            APUDSPTraceEvent *e = &device->dsp_trace.current;
+            CHECK(e->wait_count == 1 && e->waits[0].reason == 2 && e->waits[0].depth == 8);
+            APUDSPTraceWait *w = &e->waits[0]; bool valid;
+            uint64_t sum = apu_dsp_trace_elapsed(w->begin, w->acquired, &valid); CHECK(valid);
+            sum += apu_dsp_trace_elapsed(w->acquired, w->drained, &valid); CHECK(valid);
+            sum += apu_dsp_trace_elapsed(w->drained, w->released, &valid); CHECK(valid);
+            sum += apu_dsp_trace_elapsed(w->released, w->relocked, &valid); CHECK(valid);
+            CHECK(sum == apu_dsp_trace_elapsed(w->begin, w->relocked, &valid) && valid);
+            CHECK(device->dsp_trace.history_written == 9);
+            for (unsigned j = 0; j < 9; ++j) {
+                APUDSPTraceJob *record = &device->dsp_trace.history[j];
+                CHECK(record->id == j + 1 && record->executed && !record->synchronous);
+                CHECK(record->enqueued.valid && record->dequeued.valid && record->locked.valid &&
+                      record->serviced.valid && record->completed.valid);
+                CHECK(record->enqueued.qpc <= record->dequeued.qpc && record->dequeued.qpc <= record->locked.qpc &&
+                      record->locked.qpc <= record->serviced.qpc && record->serviced.qpc <= record->completed.qpc);
+            }
+        }
+        qemu_mutex_unlock(&device->lock);
+        for (unsigned i = 0; i < (reset ? 0u : 9u); ++i) {
+            CHECK(sequence[i] == i + 1 && divisions[i] == i + 101);
+            CHECK(threads[i] != GetCurrentThreadId());
+        }
+    } else if (!strcmp(argv[1], "generation")) {
+        qemu_mutex_lock(&device->lock);
+        qemu_mutex_lock(&device->dsp_lock);
+        for (unsigned i = 1; i <= 8; ++i) post(i);
+        ++device->dsp_generation; /* Guest reset, holding the documented locks. */
+        qemu_mutex_unlock(&device->dsp_lock);
+        mcpx_apu_dsp_worker_wait(device);
+        CHECK(!calls);
+        post(9);
+        mcpx_apu_dsp_worker_wait(device);
+        CHECK(calls == 1 && sequence[0] == 9 && divisions[0] == 109);
+        CHECK(done_notifications == 2);
+        qemu_mutex_unlock(&device->lock);
+    } else if (!strcmp(argv[1], "fallback") || !strcmp(argv[1], "trace_fallback")) {
+        gate = 1;
+        HANDLE producer = CreateThread(NULL, 0, ninth_job, NULL, 0, NULL); CHECK(producer);
+        CHECK(WaitForSingleObject(entered, 2000) == WAIT_OBJECT_0);
+        CHECK(TryEnterCriticalSection(&device->lock.cs)); /* Serial path also yields MMIO. */
+        LeaveCriticalSection(&device->lock.cs);
+        SetEvent(release_frame);
+        CHECK(WaitForSingleObject(producer, 2000) == WAIT_OBJECT_0);
+        CHECK(calls == 1 && sequence[0] == 9);
+        CHECK(threads[0] == GetThreadId(producer));
+        CHECK(!device->dsp_job_count);
+        CHECK(!done_notifications);
+        if (trace_case) {
+            CHECK(device->dsp_trace.current.synchronous && device->dsp_trace.history_written == 1);
+            CHECK(device->dsp_trace.current.wait_count == 1 && device->dsp_trace.current.waits[0].reason == 3);
+            APUDSPTraceJob *record = &device->dsp_trace.history[0];
+            CHECK(record->id == 1 && record->synchronous && record->executed &&
+                  record->dequeued.valid && record->locked.valid && record->serviced.valid && record->completed.valid);
+        }
+        CloseHandle(producer);
+    } else if (!strcmp(argv[1], "shutdown")) {
+        gate = 1;
+        qemu_mutex_lock(&device->lock);
+        for (unsigned i = 1; i <= 8; ++i) post(i);
+        qemu_mutex_unlock(&device->lock);
+        CHECK(WaitForSingleObject(entered, 2000) == WAIT_OBJECT_0);
+        qatomic_set(&device->exiting, true);
+        SetEvent(release_frame);
+        CHECK(WaitForSingleObject(device->dsp_thread.thread, 2000) == WAIT_OBJECT_0);
+        CHECK(calls == 1 && !device->dsp_job_count);
+        CHECK(done_notifications == 1);
+    } else CHECK(0);
+    CHECK(!premature_done_notifications);
+    destroy_device();
+    printf("DSP worker %s: bounded FIFO, copied inputs, condition waiting and lifecycle passed\n", argv[1]);
+    return 0;
+}
diff --git a/tests/dsp/hrtf_filter_test.c b/tests/dsp/hrtf_filter_test.c
new file mode 100644
index 0000000..9e30bb2
--- /dev/null
+++ b/tests/dsp/hrtf_filter_test.c
@@ -0,0 +1,151 @@
+/* Compare the production HRTF filter with its prior modulo-index reference.
+ * Every coefficient/history/PCM byte must match; no tolerance or reordered
+ * floating arithmetic can hide an audible behavior change. */
+#include "../../src/apu/apu_state.h"
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "HRTF check line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+
+static void reference_process(HrtfFilter *f, float in[][2], float out[][2])
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; n++) {
+        hrtf_filter_step_parameters(f);
+        for (int ch = 0; ch < 2; ch++) {
+            float *buf = f->ch[ch].buf;
+            float *coeff = f->ch[ch].hrir_coeff_cur;
+            buf[f->buf_pos] = in[n][ch];
+            float d = f->itd_cur * (ch == 0 ? +1.0f : -1.0f);
+            if (d < 0.0f) d = 0.0f;
+            int di = (int)d;
+            float dfrac = d - di;
+            float acc = 0.0f;
+            for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+                int idx1 = (f->buf_pos - di - k + HRTF_BUFLEN) % HRTF_BUFLEN;
+                float s = buf[idx1];
+                if (dfrac > 0.0f) {
+                    int idx2 = (idx1 - 1 + HRTF_BUFLEN) % HRTF_BUFLEN;
+                    s = s * (1 - dfrac) + buf[idx2] * dfrac;
+                }
+                acc += coeff[k] * s;
+            }
+            out[n][ch] = acc;
+        }
+        f->buf_pos = (f->buf_pos + 1) % HRTF_BUFLEN;
+    }
+}
+
+static uint32_t random_state = 0x12345678;
+static float value(void)
+{
+    random_state = random_state * 1664525u + 1013904223u;
+    return ((int32_t)(random_state >> 8) - 0x7fffff) / 8388608.0f;
+}
+static void initialize(HrtfFilter *filter, int position, float current, float target)
+{
+    hrtf_filter_init(filter);
+    filter->buf_pos = position;
+    filter->itd_cur = current; filter->itd_tar = target;
+    for (int ch = 0; ch < 2; ++ch) {
+        for (int i = 0; i < HRTF_BUFLEN; ++i) filter->ch[ch].buf[i] = value();
+        for (int i = 0; i < HRTF_NUM_TAPS; ++i) {
+            filter->ch[ch].hrir_coeff_cur[i] = value() / 31;
+            filter->ch[ch].hrir_coeff_tar[i] = value() / 31;
+        }
+    }
+}
+static void input(float data[HRTF_SAMPLES_PER_FRAME][2], unsigned kind)
+{
+    for (int n = 0; n < HRTF_SAMPLES_PER_FRAME; ++n)
+        for (int ch = 0; ch < 2; ++ch)
+            data[n][ch] = kind == 0 ? 0.0f : kind == 1 ? (n == 0 ? 1.0f : 0.0f) : value();
+}
+int main(void)
+{
+    const float delays[] = {-42, -41.999f, -41.5f, -20.75f, -1.5f, -1, -0.5f,
+                            -0.0f, 0, 0.25f, 1, 1.5f, 20.5f, 41.5f, 41.999f, 42};
+    unsigned frames = 0;
+    for (int position = 0; position < HRTF_BUFLEN; ++position)
+    for (unsigned delay = 0; delay < sizeof delays / sizeof delays[0]; ++delay)
+    for (unsigned transition = 0; transition < 4; ++transition)
+    for (unsigned inplace = 0; inplace < 2; ++inplace) {
+        float target = transition == 0 ? delays[delay] : transition == 1 ? -42 : transition == 2 ? 42 : 0;
+        HrtfFilter reference, actual;
+        initialize(&reference, position, delays[delay], target); actual = reference;
+        for (unsigned frame = 0; frame < 4; ++frame) {
+            float left[HRTF_SAMPLES_PER_FRAME][2], right[HRTF_SAMPLES_PER_FRAME][2];
+            float left_out[HRTF_SAMPLES_PER_FRAME][2], right_out[HRTF_SAMPLES_PER_FRAME][2];
+            input(left, frame % 3); memcpy(right, left, sizeof left);
+            if (inplace) {
+                reference_process(&reference, left, left);
+                hrtf_filter_process(&actual, right, right);
+                CHECK(!memcmp(left, right, sizeof left));
+            } else {
+                reference_process(&reference, left, left_out);
+                hrtf_filter_process(&actual, right, right_out);
+                CHECK(!memcmp(left_out, right_out, sizeof left_out));
+                CHECK(!memcmp(left, right, sizeof left));
+            }
+            CHECK(!memcmp(&reference, &actual, sizeof reference));
+            ++frames;
+        }
+    }
+    /* Long runs reach the paths a few frames do not: coefficients and delay
+     * settling to their fixed points (the smoothing stops), a steady delay
+     * for whole frames (one interpolation of the history, sixteen samples
+     * per pass), coefficients that start settled, and new targets arriving
+     * mid-run. Delays outside the history (never from the clamped targets)
+     * take the original code as a whole. */
+    const float steady[] = {0, -0.0f, 0.5f, 20.5f, -13.25f, 41.999f, 42, -42, 7};
+    for (unsigned run = 0; run < 3 * (sizeof steady / sizeof steady[0]); ++run) {
+        float delay = steady[run / 3];
+        HrtfFilter reference, actual;
+        initialize(&reference, (int)(run * 7) % HRTF_BUFLEN, delay, delay);
+        if (run % 3 == 0)
+            for (int ch = 0; ch < 2; ++ch)
+                memcpy(reference.ch[ch].hrir_coeff_cur, reference.ch[ch].hrir_coeff_tar,
+                       sizeof reference.ch[ch].hrir_coeff_cur);
+        actual = reference;
+        for (unsigned frame = 0; frame < 160; ++frame) {
+            if (run % 3 == 2 && frame % 50 == 49) {
+                /* A new target: coefficients and delay start moving again. */
+                float next = steady[(run / 3 + frame / 50 + 1) % (sizeof steady / sizeof steady[0])];
+                for (int ch = 0; ch < 2; ++ch)
+                    for (int i = 0; i < HRTF_NUM_TAPS; ++i)
+                        reference.ch[ch].hrir_coeff_tar[i] = value() / 31;
+                reference.itd_tar = next;
+                memcpy(actual.ch, reference.ch, sizeof actual.ch);
+                actual.itd_tar = next;
+            }
+            float left[HRTF_SAMPLES_PER_FRAME][2], right[HRTF_SAMPLES_PER_FRAME][2];
+            input(left, frame % 5 == 0 ? 1 : 2);
+            memcpy(right, left, sizeof left);
+            reference_process(&reference, left, left);
+            hrtf_filter_process(&actual, right, right);
+            CHECK(!memcmp(left, right, sizeof left));
+            CHECK(!memcmp(&reference, &actual, sizeof reference));
+            ++frames;
+        }
+    }
+    /* Finite only: with a NaN delay the original indexes outside the line. */
+    const float outside[] = {50, -60, 42.5f, -45.25f};
+    for (unsigned i = 0; i < sizeof outside / sizeof outside[0]; ++i) {
+        HrtfFilter reference, actual;
+        initialize(&reference, (int)i * 11, outside[i], 0);
+        actual = reference;
+        for (unsigned frame = 0; frame < 3; ++frame) {
+            float left[HRTF_SAMPLES_PER_FRAME][2], right[HRTF_SAMPLES_PER_FRAME][2];
+            input(left, 2);
+            memcpy(right, left, sizeof left);
+            hrtf_filter_process_reference(&reference, left, left);
+            hrtf_filter_process(&actual, right, right);
+            CHECK(!memcmp(left, right, sizeof left));
+            CHECK(!memcmp(&reference, &actual, sizeof reference));
+            ++frames;
+        }
+    }
+    printf("HRTF exact state/PCM equivalence passed: %u frames\n", frames);
+    return 0;
+}
diff --git a/tests/dsp/live_bench.cmake b/tests/dsp/live_bench.cmake
new file mode 100644
index 0000000..05f35c5
--- /dev/null
+++ b/tests/dsp/live_bench.cmake
@@ -0,0 +1,63 @@
+# Times each captured frame through the compiled programs (block code), the
+# previous threaded code and the interpreter alone (dsp_frame_replay
+# <capture> <repeat>), in alternating rounds; prints each mode's median
+# mean_us. -Dreplay=<exe> -Ddir=<frame dir> -Dframes=<a;b> -Drepeat=<n>
+# [-Drounds=<n>]
+if(NOT rounds)
+  set(rounds 5)
+endif()
+set(modes "blocks" "threaded" "interpreter")
+set(env_blocks "RECOMP_DSP_TRANSLATOR=")
+set(env_threaded "RECOMP_DSP_TRANSLATOR=threaded")
+set(env_interpreter "RECOMP_DSP_INTERPRETER=1")
+
+function(median out)
+  set(values ${ARGN})
+  list(LENGTH values count)
+  # Sort numerically: pad the integer part so a string sort orders them.
+  set(keyed "")
+  foreach(value IN LISTS values)
+    string(REGEX MATCH "^[0-9]+" whole "${value}")
+    string(LENGTH "${whole}" digits)
+    set(pad "")
+    while(digits LESS 8)
+      string(APPEND pad "0")
+      math(EXPR digits "${digits} + 1")
+    endwhile()
+    list(APPEND keyed "${pad}${value}")
+  endforeach()
+  list(SORT keyed)
+  math(EXPR middle "${count} / 2")
+  list(GET keyed ${middle} chosen)
+  string(REGEX REPLACE "^0+([0-9])" "\\1" chosen "${chosen}")
+  set(${out} "${chosen}" PARENT_SCOPE)
+endfunction()
+
+message("frame       blocks_us  threaded_us  interpreter_us  (median of ${rounds} rounds x ${repeat} frames)")
+foreach(frame IN LISTS frames)
+  foreach(mode IN LISTS modes)
+    set(times_${mode} "")
+  endforeach()
+  foreach(round RANGE 1 ${rounds})
+    foreach(mode IN LISTS modes)
+      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${env_${mode}}"
+        "${replay}" "${dir}/${frame}.frame.bin" "${repeat}"
+        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result)
+      if(NOT result EQUAL 0 OR NOT output MATCHES "mean_us=([0-9.]+)")
+        message(FATAL_ERROR "${frame} ${mode} replay failed (${result}): ${output}${errors}")
+      endif()
+      list(APPEND times_${mode} "${CMAKE_MATCH_1}")
+    endforeach()
+  endforeach()
+  set(line "${frame}")
+  string(LENGTH "${line}" length)
+  while(length LESS 12)
+    string(APPEND line " ")
+    math(EXPR length "${length} + 1")
+  endwhile()
+  foreach(mode IN LISTS modes)
+    median(value ${times_${mode}})
+    string(APPEND line "  ${value}")
+  endforeach()
+  message("${line}")
+endforeach()
diff --git a/tests/dsp/vp_adpcm_cache_test.c b/tests/dsp/vp_adpcm_cache_test.c
new file mode 100644
index 0000000..faa82d4
--- /dev/null
+++ b/tests/dsp/vp_adpcm_cache_test.c
@@ -0,0 +1,213 @@
+/* Replay the production VP with and without decoded-block reuse. CMake builds
+ * the uncached reader by replacing only its decode call, then compares every
+ * emitted mix sample, guest-memory byte and persistent resampler state. */
+#include "apu_state.h"
+#include <fenv.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t decode_calls;
+static int counted_decode(int16_t *out, const uint8_t *in, size_t bytes, int channels)
+{
+    ++decode_calls;
+    return adpcm_decode_block(out, in, bytes, channels);
+}
+#define adpcm_decode_block counted_decode
+#ifndef APU_VP_SOURCE
+#define APU_VP_SOURCE "../../src/apu/apu_vp.c"
+#endif
+#include APU_VP_SOURCE
+#include "vp_test_wake.h"
+#undef adpcm_decode_block
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "ADPCM cache line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t memory[0x100000];
+uint8_t *g_apu_ram_ptr = memory;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(memory));
+    return memory + address;
+}
+
+enum { FIRST = 80, VOICES = 160, PCM = 0x20000, SSL = 0x1c000 };
+
+static void write_value(MCPXAPUState *d, unsigned v, uint32_t reg, uint32_t mask, uint32_t value)
+{
+    voice_set_mask(d, (uint16_t)v, reg, mask, value);
+}
+
+static void setup(MCPXAPUState *d)
+{
+    memset(memory, 0, sizeof(memory));
+    memset(d, 0, sizeof(*d));
+    memset(&g_dbg, 0, sizeof(g_dbg));
+    mcpx_apu_vp_init(d);
+    mcpx_apu_vp_reset(d);
+    d->regs[NV_PAPU_VPVADDR] = 0x10000;
+    d->regs[NV_PAPU_VPSGEADDR] = 0x1a000;
+    d->regs[NV_PAPU_VPSSLADDR] = SSL;
+    d->regs[NV_PAPU_FENADDR] = 0x80000;
+    for (unsigned page = 0; page < 64; ++page)
+        stl_le_phys(NULL, 0x1a000 + page * 8, PCM + page * 4096);
+    uint32_t random = 0x5c2b9341;
+    for (unsigned v = FIRST; v < FIRST + VOICES; ++v) {
+        unsigned channels = 1 + (v & 1);
+        for (unsigned byte = 0; byte < 512; ++byte) {
+            random = random * 1664525u + 1013904223u;
+            memory[PCM + v * 512 + byte] = (uint8_t)(random >> 24);
+        }
+        /* Standard Xbox blocks, including nonzero reserved bytes and header
+         * indices outside the decoder table that must retain its clamping. */
+        for (unsigned block = 0; block < 4; ++block)
+            for (unsigned channel = 0; channel < channels; ++channel) {
+                unsigned address = PCM + v * 512 + block * 36 * channels + channel * 4;
+                memory[address + 2] = (uint8_t)(block * 70 + channel);
+            }
+        write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+                    NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM);
+        write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_STEREO, channels == 2);
+        write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_SAMPLES_PER_BLOCK, channels - 1);
+        write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, 1);
+        write_value(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+        write_value(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, 259);
+        write_value(d, v, NV_PAVS_VOICE_CUR_PSL_START, NV_PAVS_VOICE_CUR_PSL_START_BA, v * 512);
+        write_value(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH,
+                    (uint16_t)((int)(v % 5) * 250 - 500));
+    }
+}
+
+static void check_decode_key(MCPXAPUState *d)
+{
+    uint8_t input[108];
+    int16_t expected[512], fallback[512];
+    for (unsigned i = 0; i < sizeof(input); ++i) input[i] = (uint8_t)(i * 71 + 19);
+    const unsigned bytes[] = {36, 36, 72, 72, 108, 36};
+    const unsigned channels[] = {1, 1, 2, 2, 1, 2};
+    for (unsigned test = 0; test < 6; ++test) {
+        if (test == 1 || test == 3) input[35] ^= 0x80;
+        int count = adpcm_decode_block(expected, input, bytes[test], channels[test]);
+        const int16_t *actual = voice_decode_adpcm_block(d, FIRST, fallback, input, bytes[test], channels[test]);
+        CHECK(!memcmp(actual, expected, (size_t)count * channels[test] * sizeof(int16_t)));
+        uint64_t before = decode_calls;
+        actual = voice_decode_adpcm_block(d, FIRST, fallback, input, bytes[test], channels[test]);
+        CHECK(!memcmp(actual, expected, (size_t)count * channels[test] * sizeof(int16_t)));
+        if (test < 4) CHECK(decode_calls == before);
+        else CHECK(actual == fallback && decode_calls == before + 1);
+    }
+    voice_reset_filters(d, FIRST);
+    CHECK(!d->vp.filters[FIRST].adpcm_cached_bytes);
+    mcpx_apu_vp_reset(d);
+    CHECK(!d->vp.filters[FIRST].adpcm_cached_bytes);
+    setup(d);
+    voice_decode_adpcm_block(d, FIRST, fallback, input, 36, 1);
+    CHECK(d->vp.filters[FIRST].adpcm_cached_bytes == 36);
+    d->regs[NV_PAPU_FEAV] = 1u << ctz32(NV_PAPU_FEAV_LST);
+    d->regs[NV_PAPU_TVL2D] = 0xffff;
+    fe_method(d, NV1BA0_PIO_VOICE_ON, FIRST);
+    CHECK(!d->vp.filters[FIRST].adpcm_cached_bytes);
+}
+
+static void emit(FILE *out, const void *data, size_t bytes)
+{
+    CHECK(fwrite(data, bytes, 1, out) == 1);
+}
+
+static void replay(MCPXAPUState *d, FILE *out)
+{
+    setup(d);
+    const int modes[] = {FE_TONEAREST, FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO};
+    for (unsigned frame = 0; frame < 384; ++frame) {
+        CHECK(!fesetround(modes[(frame / 96) % 4]));
+        float bins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = {{0}};
+        float monitor[NUM_SAMPLES_PER_FRAME][2] = {{0}};
+        /* Change bytes while a block can still be cached, including changes
+         * to its headers. Reuse must observe the newly read source data. */
+        if (frame % 11 == 0)
+            for (unsigned v = FIRST; v < FIRST + VOICES; ++v)
+                memory[PCM + v * 512 + (frame * 17) % (36 * (1 + (v & 1)))] ^= 0x81;
+        if (frame == 120) {
+            for (unsigned v = FIRST; v < FIRST + 8; ++v) {
+                write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, 0);
+                write_value(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, v & 1 ? 70 : 10);
+                write_value(d, v, NV_PAVS_VOICE_PAR_OFFSET, NV_PAVS_VOICE_PAR_OFFSET_CBO, 0);
+                voice_reset_filters(d, (uint16_t)v);
+            }
+        }
+        if (frame == 192) {
+            /* Reuse stopped voices as split persistent streaming packets. */
+            for (unsigned v = FIRST; v < FIRST + 8; ++v) {
+                unsigned channels = 1 + (v & 1);
+                write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_DATA_TYPE, 1);
+                write_value(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_PERSIST, 1);
+                write_value(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+                write_value(d, v, NV_PAVS_VOICE_PAR_OFFSET, NV_PAVS_VOICE_PAR_OFFSET_CBO, 0);
+                voice_reset_filters(d, (uint16_t)v);
+                d->vp.ssl[v].base[0] = v * 2;
+                d->vp.ssl[v].count[0] = 2;
+                for (unsigned segment = 0; segment < 2; ++segment) {
+                    stl_le_phys(NULL, SSL + (v * 2 + segment) * 8, PCM + v * 512 + segment * 36 * channels);
+                    stl_le_phys(NULL, SSL + (v * 2 + segment) * 8 + 4,
+                                33 | (2u << 16) | ((channels - 1) << 18) | ((channels - 1) << 23));
+                }
+            }
+        }
+        for (unsigned v = FIRST; v < FIRST + VOICES; ++v)
+            if (voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE))
+                voice_process(d, bins, monitor, (uint16_t)v, 0);
+        emit(out, bins, sizeof(bins));
+        int16_t pcm[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME];
+        src_float_to_short_array((const float *)bins, (short *)pcm, NUM_MIXBINS * NUM_SAMPLES_PER_FRAME);
+        emit(out, pcm, sizeof(pcm));
+    }
+    CHECK(!fesetround(FE_TONEAREST));
+    emit(out, memory, sizeof(memory));
+    emit(out, d->vp.ssl, sizeof(d->vp.ssl));
+    emit(out, s_gain_prev, sizeof(s_gain_prev));
+    emit(out, s_gain_valid, sizeof(s_gain_valid));
+    for (unsigned v = FIRST; v < FIRST + VOICES; ++v) {
+        MCPXAPUVoiceFilter *filter = &d->vp.filters[v];
+        emit(out, filter->resample_buf, sizeof(filter->resample_buf));
+        emit(out, &filter->resample_phase, offsetof(MCPXAPUVoiceFilter, svf) - offsetof(MCPXAPUVoiceFilter, resample_phase));
+    }
+}
+
+static void benchmark(MCPXAPUState *d)
+{
+    LARGE_INTEGER frequency, begin, end;
+    QueryPerformanceFrequency(&frequency);
+    for (unsigned trial = 0; trial < 5; ++trial) {
+        setup(d);
+        decode_calls = 0;
+        float samples[32][2];
+        QueryPerformanceCounter(&begin);
+        for (unsigned frame = 0; frame < 1000; ++frame)
+            for (unsigned v = FIRST; v < FIRST + VOICES; ++v)
+                CHECK(voice_get_samples(d, v, samples, 32) > 0);
+        QueryPerformanceCounter(&end);
+        printf("trial=%u source_pulls=160000 decode_calls=%llu elapsed_ms=%.3f\n", trial + 1,
+               (unsigned long long)decode_calls, 1000.0 * (end.QuadPart - begin.QuadPart) / frequency.QuadPart);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d && argc == 2);
+    check_decode_key(d);
+    if (!strcmp(argv[1], "--bench")) benchmark(d);
+    else {
+        FILE *out = fopen(argv[1], "wb");
+        CHECK(out);
+        decode_calls = 0;
+        replay(d, out);
+        CHECK(!fclose(out));
+        printf("VP ADPCM replay: 160 voices, 384 mixed frames, decode_calls=%llu\n", (unsigned long long)decode_calls);
+    }
+    free(d);
+    return 0;
+}
diff --git a/tests/dsp/vp_adpcm_short_test.c b/tests/dsp/vp_adpcm_short_test.c
new file mode 100644
index 0000000..64ca27f
--- /dev/null
+++ b/tests/dsp/vp_adpcm_short_test.c
@@ -0,0 +1,154 @@
+/* Exercise the real sample fetcher with its scratch pre-seeded by CMake.
+ * --probe reports current undefined-tail behavior without requiring a fix.
+ * Default mode requires every fetched sample to be defined independently of
+ * prior stack contents. No decoder, sample indexing or guest state is mocked.
+ */
+#include "apu_state.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "ADPCM short line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+static int16_t g_scratch_poison;
+static int decode_frames;
+static unsigned decode_calls;
+static int counted_decode(int16_t *out, const uint8_t *in, size_t bytes, int channels)
+{
+    ++decode_calls;
+    decode_frames = adpcm_decode_block(out, in, bytes, channels);
+    return decode_frames;
+}
+#define adpcm_decode_block counted_decode
+#ifndef APU_VP_SOURCE
+#error APU_VP_SOURCE must name the production VP with test-only scratch seeding
+#endif
+#include APU_VP_SOURCE
+#include "vp_test_wake.h"
+#undef adpcm_decode_block
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t memory[0x40000];
+uint8_t *g_apu_ram_ptr = memory;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(memory));
+    return memory + address;
+}
+enum { VOICE = 80, PCM = 0x20000, SGE = 0x18000 };
+
+static void setup(MCPXAPUState *d, unsigned channels, unsigned spb, unsigned frames)
+{
+    memset(memory, 0, sizeof(memory));
+    memset(d, 0, sizeof(*d));
+    mcpx_apu_vp_init(d);
+    mcpx_apu_vp_reset(d);
+    d->regs[NV_PAPU_VPVADDR] = 0x10000;
+    d->regs[NV_PAPU_VPSGEADDR] = SGE;
+    stl_le_phys(NULL, SGE, PCM);
+    for (unsigned byte = 0; byte < 36 * spb; ++byte)
+        memory[PCM + byte] = (uint8_t)(byte * 71 + 19);
+    for (unsigned channel = 0; channel < channels; ++channel) {
+        memory[PCM + channel * 4] = (uint8_t)(channel ? 0x18 : 0xe8);
+        memory[PCM + channel * 4 + 1] = (uint8_t)(channel ? 0xfc : 0x03);
+        memory[PCM + channel * 4 + 2] = 0;
+        memory[PCM + channel * 4 + 3] = 0;
+    }
+    voice_set_mask(d, VOICE, NV_PAVS_VOICE_CFG_FMT,
+                   NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+                   NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM);
+    voice_set_mask(d, VOICE, NV_PAVS_VOICE_CFG_FMT,
+                   NV_PAVS_VOICE_CFG_FMT_STEREO, channels == 2);
+    voice_set_mask(d, VOICE, NV_PAVS_VOICE_CFG_FMT,
+                   NV_PAVS_VOICE_CFG_FMT_SAMPLES_PER_BLOCK, spb - 1);
+    voice_set_mask(d, VOICE, NV_PAVS_VOICE_PAR_STATE,
+                   NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+    voice_set_mask(d, VOICE, NV_PAVS_VOICE_PAR_NEXT,
+                   NV_PAVS_VOICE_PAR_NEXT_EBO, frames - 1);
+}
+
+static void fetch(MCPXAPUState *d, unsigned channels, unsigned spb,
+                  unsigned frames, int16_t poison, float samples[64][2])
+{
+    setup(d, channels, spb, frames);
+    g_scratch_poison = poison;
+    decode_calls = 0;
+    decode_frames = 0;
+    CHECK(voice_get_samples(d, VOICE, samples, (int)frames) == (int)frames);
+    CHECK(decode_calls == 1);
+    CHECK(voice_get_mask(d, VOICE, NV_PAVS_VOICE_PAR_OFFSET,
+                         NV_PAVS_VOICE_PAR_OFFSET_CBO) == frames);
+}
+
+int main(int argc, char **argv)
+{
+    bool probe = argc == 2 && !strcmp(argv[1], "--probe");
+    CHECK(argc == 1 || probe);
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d);
+    float first[64][2], second[64][2];
+    int16_t decoded[65 * 18 * 2];
+
+    /* Valid short usage consumes exactly what the 36-byte stereo decoder
+     * produces. It never requires a policy for nonexistent decoded samples. */
+    fetch(d, 2, 1, 25, 0x1357, first);
+    CHECK(decode_frames == 25);
+    CHECK(adpcm_decode_block(decoded, memory + PCM, 36, 2) == 25);
+    for (unsigned frame = 0; frame < 25; ++frame)
+        for (unsigned channel = 0; channel < 2; ++channel)
+            CHECK(first[frame][channel] == int16_to_float(decoded[frame * 2 + channel]));
+
+    /* Every other supported-sized block has >=65 decoded frames. Verify the
+     * complete first 64 frames against the decoder and against both poisons. */
+    for (unsigned channels = 1; channels <= 2; ++channels) {
+        for (unsigned spb = 1; spb <= 18; ++spb) {
+            if (channels == 2 && spb == 1) continue;
+            fetch(d, channels, spb, 64, 0x1357, first);
+            CHECK(decode_frames >= 65);
+            CHECK(adpcm_decode_block(decoded, memory + PCM, 36 * spb, channels) >= 65);
+            fetch(d, channels, spb, 64, 0x2468, second);
+            CHECK(!memcmp(first, second, sizeof(first)));
+            for (unsigned frame = 0; frame < 64; ++frame)
+                for (unsigned channel = 0; channel < 2; ++channel)
+                    CHECK(first[frame][channel] == int16_to_float(
+                        decoded[frame * channels + (channels == 1 ? 0 : channel)]));
+        }
+    }
+
+    /* The field encodes up to 32, but production explicitly bounds compressed
+     * scratch to 18. Refused layouts must not decode or touch output samples. */
+    float sentinel[64][2];
+    memset(sentinel, 0x42, sizeof(sentinel));
+    for (unsigned channels = 1; channels <= 2; ++channels) {
+        for (unsigned spb = 19; spb <= 32; ++spb) {
+            setup(d, channels, spb, 64);
+            memcpy(first, sentinel, sizeof(first));
+            decode_calls = 0;
+            CHECK(voice_get_samples(d, VOICE, first, 64) == -1);
+            CHECK(decode_calls == 0 && !memcmp(first, sentinel, sizeof(first)));
+            CHECK(voice_get_mask(d, VOICE, NV_PAVS_VOICE_PAR_OFFSET,
+                                 NV_PAVS_VOICE_PAR_OFFSET_CBO) == 0);
+        }
+    }
+    puts("rejected_layouts=28 no_decode=1 output_unchanged=1");
+
+    /* The conditional defect: format provides only 25 decoded stereo frames,
+     * while EBO asks the production reader for 64 from the same block. */
+    fetch(d, 2, 1, 64, 0x1357, first);
+    CHECK(decode_frames == 25);
+    fetch(d, 2, 1, 64, 0x2468, second);
+    CHECK(decode_frames == 25);
+    CHECK(!memcmp(first, second, 25 * sizeof(first[0])));
+    unsigned dependent = 0, zero = 0;
+    for (unsigned frame = 25; frame < 64; ++frame) {
+        dependent += first[frame][0] != second[frame][0] || first[frame][1] != second[frame][1];
+        zero += first[frame][0] == 0 && first[frame][1] == 0 &&
+                second[frame][0] == 0 && second[frame][1] == 0;
+    }
+    printf("decoder_frames=25 fetched_frames=64 tail_frames=39 poison_dependent_frames=%u zero_tail_frames=%u\n",
+           dependent, zero);
+    free(d);
+    if (!probe) CHECK(dependent == 0 && zero == 39);
+    return 0;
+}
diff --git a/tests/dsp/vp_attenuation_test.c b/tests/dsp/vp_attenuation_test.c
new file mode 100644
index 0000000..74ae996
--- /dev/null
+++ b/tests/dsp/vp_attenuation_test.c
@@ -0,0 +1,144 @@
+/* Compile the production VP so this covers its initialization and lookup,
+ * including reset behavior. Compare every uint16_t input against the former
+ * formula, with exact float and mixed PCM equality rather than a tolerance. */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t pow_calls;
+static float counted_powf(float base, float exponent)
+{
+    ++pow_calls;
+    return powf(base, exponent);
+}
+#define powf counted_powf
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+#undef powf
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "VP attenuation check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    (void)address;
+    CHECK(0); /* No guest-memory access is needed for volume conversion. */
+    return NULL;
+}
+
+static float reference_attenuate(uint16_t volume)
+{
+    volume &= 0xFFF;
+    return volume == 0xFFF ? 0.0f : powf(10.0f, volume / (64.0f * -20.0f));
+}
+
+static void check_all_inputs(MCPXAPUState *d)
+{
+    float expected_pcm[32], actual_pcm[32];
+    int16_t expected_s16[32], actual_s16[32];
+    for (unsigned input = 0; input <= UINT16_MAX; ++input) {
+        float expected = reference_attenuate((uint16_t)input);
+        float actual = attenuate(d, (uint16_t)input);
+        CHECK(!memcmp(&expected, &actual, sizeof(expected)));
+        for (unsigned sample = 0; sample < 32; ++sample) {
+            float pcm = (float)((int)sample - 16) / 16.0f;
+            float start = (input & 1) ? 0.0f : 1.0f;
+            expected_pcm[sample] = (start + (expected - start) / 32 * (sample + 1)) * pcm;
+            actual_pcm[sample] = (start + (actual - start) / 32 * (sample + 1)) * pcm;
+        }
+        CHECK(!memcmp(expected_pcm, actual_pcm, sizeof(expected_pcm)));
+        src_float_to_short_array(expected_pcm, expected_s16, 32);
+        src_float_to_short_array(actual_pcm, actual_s16, 32);
+        CHECK(!memcmp(expected_s16, actual_s16, sizeof(expected_s16)));
+    }
+}
+
+static __declspec(noinline) float bench_reference(const volatile uint16_t *inputs, unsigned count)
+{
+    float sum = 0.0f;
+    for (unsigned repeat = 0; repeat < 1024; ++repeat)
+        for (unsigned i = 0; i < count; ++i)
+            sum += reference_attenuate(inputs[i]);
+    return sum;
+}
+
+static __declspec(noinline) float bench_cached(MCPXAPUState *d, const volatile uint16_t *inputs, unsigned count)
+{
+    float sum = 0.0f;
+    for (unsigned repeat = 0; repeat < 1024; ++repeat)
+        for (unsigned i = 0; i < count; ++i)
+            sum += attenuate(d, inputs[i]);
+    return sum;
+}
+
+static void benchmark(MCPXAPUState *d)
+{
+    uint16_t inputs[8192];
+    uint32_t random = 0x12345678;
+    LARGE_INTEGER frequency, begin, middle, end;
+    QueryPerformanceFrequency(&frequency);
+    for (unsigned i = 0; i < 8192; ++i) {
+        random = random * 1664525u + 1013904223u;
+        inputs[i] = (uint16_t)(random >> 16);
+    }
+    for (unsigned trial = 0; trial < 5; ++trial) {
+        QueryPerformanceCounter(&begin);
+        float before = bench_reference(inputs, 8192);
+        QueryPerformanceCounter(&middle);
+        float after = bench_cached(d, inputs, 8192);
+        QueryPerformanceCounter(&end);
+        CHECK(!memcmp(&before, &after, sizeof(before)));
+        printf("trial=%u calls=8388608 reference_ms=%.3f cached_ms=%.3f sum=%.9g\n",
+               trial + 1, 1000.0 * (middle.QuadPart - begin.QuadPart) / frequency.QuadPart,
+               1000.0 * (end.QuadPart - middle.QuadPart) / frequency.QuadPart, after);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    MCPXAPUState *other = calloc(1, sizeof(*other));
+    CHECK(d && other);
+    mcpx_apu_vp_init(d);
+    CHECK(pow_calls == 4095);
+    check_all_inputs(d);
+    CHECK(pow_calls == 4095);
+    CHECK(attenuate(d, 0) == 1.0f && attenuate(d, 0xFFF) == 0.0f);
+    CHECK(attenuate(d, 0xFFE) > 0.0f);
+    mcpx_apu_vp_reset(d);
+    check_all_inputs(d);
+    CHECK(pow_calls == 4095);
+    mcpx_apu_vp_init(other);
+    CHECK(pow_calls == 8190);
+    CHECK(!memcmp(d->vp.attenuation, other->vp.attenuation, sizeof(d->vp.attenuation)));
+    {
+        int saved_rounding = fegetround();
+        const int modes[] = {FE_DOWNWARD, FE_UPWARD, FE_TOWARDZERO, FE_TONEAREST};
+        float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME] = {{0}};
+        d->regs[NV_PAPU_TVL2D] = d->regs[NV_PAPU_TVL3D] = d->regs[NV_PAPU_TVLMP] = 0xFFFF;
+        for (unsigned mode = 0; mode < sizeof(modes) / sizeof(modes[0]); ++mode) {
+            CHECK(!fesetround(modes[mode]));
+            mcpx_apu_vp_frame(d, mixbins);
+            uint64_t warmed_calls = pow_calls;
+            check_all_inputs(d);
+            mcpx_apu_vp_frame(d, mixbins);
+            CHECK(pow_calls == warmed_calls);
+        }
+        CHECK(!fesetround(saved_rounding));
+        mcpx_apu_vp_frame(d, mixbins);
+    }
+    if (argc > 1 && !strcmp(argv[1], "--bench")) benchmark(d);
+    puts("PASS: 65536 encodings in all 4 rounding modes, gain ramps/PCM, reset, separate instances; no warm powf calls");
+    mcpx_apu_vp_finalize(d);
+    mcpx_apu_vp_finalize(other);
+    free(other);
+    free(d);
+    return 0;
+}
diff --git a/tests/dsp/vp_frame_bench.c b/tests/dsp/vp_frame_bench.c
new file mode 100644
index 0000000..c370c49
--- /dev/null
+++ b/tests/dsp/vp_frame_bench.c
@@ -0,0 +1,345 @@
+/* The production voice processor under an MM3-like load, for timing and for
+ * an exact before/after comparison of optimisations:
+ *   40 3D voices: mono ADPCM loops through HRTF (31-tap filters with
+ *     fractional interaural delays), half of them low-pass filtered, to MM3's
+ *     crosstalk bins 6 8 7 9 plus a reverb send; a few run envelopes;
+ *   12 2D voices: stereo 16-bit PCM loops (music, ambience), mono ADPCM;
+ *   every 25 frames (a 60 fps game) DirectSound-style updates of volumes and
+ *     pitch, and a new HRTF target for a third of the 3D voices.
+ * usage: vp_frame_bench --emit <file> [dsp]   write every output
+ *        vp_frame_bench --bench [dsp] [nohrtf]   time per frame
+ * "dsp" mixes for the sound processor (bins only); otherwise the voice-only
+ * monitor mix (Accurate sound processor off) runs as well. */
+#include "apu_state.h"
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef APU_VP_SOURCE
+#define APU_VP_SOURCE "../../src/apu/apu_vp.c"
+#endif
+#include APU_VP_SOURCE
+#include "vp_test_wake.h"
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "VP frame bench line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t memory[0x200000];
+uint8_t *g_apu_ram_ptr = memory;
+
+/* The game's translation (apu_core.c) asks the kernel's allocation table
+ * whether the page is contiguous memory (xbox_ContiguousRangeAllocated: a
+ * per-thread range cache in front of a locked binary search) before mapping
+ * it. Model that cost, out of line like the real call, so the benchmark
+ * weighs what each translation costs in the game. */
+static __declspec(thread) uint32_t t_range_begin, t_range_end;
+static CRITICAL_SECTION s_range_lock;
+static __declspec(noinline) int bench_contiguous(uint32_t offset)
+{
+    if (offset >= sizeof(memory)) return 0;
+    if (offset >= t_range_begin && offset < t_range_end) return 1;
+    EnterCriticalSection(&s_range_lock);
+    t_range_begin = 0;
+    t_range_end = sizeof(memory);
+    LeaveCriticalSection(&s_range_lock);
+    return 1;
+}
+
+__declspec(noinline) uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    uint32_t a = (uint32_t)address & 0x0FFFFFFFu;
+    if (bench_contiguous(a)) return memory + a;
+    CHECK(!"address outside the benchmark's memory");
+    return NULL;
+}
+
+enum {
+    VOICES3D = 40, VOICES2D = 12, FIRST2D = 64, FRAMES = 3000,
+    VOICE_TABLE = 0x10000, SGE = 0x20000, NOTIFY = 0x30000, SAMPLES = 0x100000,
+    SAMPLE_PAGES = 256, VOICE_BYTES = 4096,
+};
+
+static uint32_t s_random;
+static uint32_t next_random(void)
+{
+    s_random = s_random * 1664525u + 1013904223u;
+    return s_random >> 8;
+}
+
+static void set(MCPXAPUState *d, unsigned v, uint32_t reg, uint32_t mask, uint32_t value)
+{
+    voice_set_mask(d, (uint16_t)v, reg, mask, value);
+}
+
+static void set_volumes(MCPXAPUState *d, unsigned v, const uint16_t vol[8])
+{
+    set(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME0, vol[0]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME1, vol[1]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME2, vol[2]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME3, vol[3]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME4, vol[4]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME5, vol[5]);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME6_B3_0, vol[6] & 15);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME6_B7_4, (vol[6] >> 4) & 15);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME6_B11_8, vol[6] >> 8);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME7_B3_0, vol[7] & 15);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME7_B7_4, (vol[7] >> 4) & 15);
+    set(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME7_B11_8, vol[7] >> 8);
+}
+
+static uint16_t s_vol[256][8];
+
+static void voice_3d(MCPXAPUState *d, unsigned v, unsigned page, unsigned next)
+{
+    /* 113 mono ADPCM blocks of 64 samples: a 0.15 s loop. */
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+        NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM);
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, 1);
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_V6BIN, 12);
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_V7BIN, 13);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V4BIN, 10);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V5BIN, 11);
+    set(d, v, NV_PAVS_VOICE_CUR_PSL_START, NV_PAVS_VOICE_CUR_PSL_START_BA, page * 4096);
+    set(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, 113 * 64 - 1);
+    set(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH,
+        (uint16_t)((int)(v % 9) * 400 - 1600));
+    set(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE, next);
+    if (v & 1) {
+        set(d, v, NV_PAVS_VOICE_CFG_MISC, NV_PAVS_VOICE_CFG_MISC_FMODE, 1);
+        set(d, v, NV_PAVS_VOICE_TAR_FCA, NV_PAVS_VOICE_TAR_FCA_FC0, (uint16_t)(-2000 - (int)v * 50));
+        set(d, v, NV_PAVS_VOICE_TAR_FCA, NV_PAVS_VOICE_TAR_FCA_FC1, 0x5000);
+    }
+    s_vol[v][0] = s_vol[v][1] = (uint16_t)(0x080 + v * 8);
+    s_vol[v][2] = s_vol[v][3] = (uint16_t)(0x100 + v * 8);
+    s_vol[v][4] = (uint16_t)(0x300 + v * 4);
+    s_vol[v][5] = v % 3 ? 0xFFF : 0x500;
+    s_vol[v][6] = s_vol[v][7] = 0xFFF;
+    set_volumes(d, v, s_vol[v]);
+    /* A few attack-hold-decay-sustain envelopes; the rest have none. */
+    if (v < 4) {
+        set(d, v, NV_PAVS_VOICE_CFG_ENV0, NV_PAVS_VOICE_CFG_ENV0_EA_ATTACKRATE, 40 + v * 20);
+        set(d, v, NV_PAVS_VOICE_CFG_ENVA, NV_PAVS_VOICE_CFG_ENVA_EA_HOLDTIME, 30);
+        set(d, v, NV_PAVS_VOICE_CFG_ENVA, NV_PAVS_VOICE_CFG_ENVA_EA_DECAYRATE, 200);
+        set(d, v, NV_PAVS_VOICE_CFG_ENVA, NV_PAVS_VOICE_CFG_ENVA_EA_SUSTAINLEVEL, 0x90);
+        set(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_EACUR,
+            NV_PAVS_VOICE_PAR_STATE_EFCUR_ATTACK);
+    }
+    set(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+    fe_method(d, NV1BA0_PIO_SET_CURRENT_VOICE, v);
+    fe_method(d, NV1BA0_PIO_SET_VOICE_TAR_HRTF, v % 32);
+}
+
+static void voice_2d(MCPXAPUState *d, unsigned v, unsigned page, unsigned next)
+{
+    bool pcm = (v & 1) == 0;
+    if (pcm) {
+        /* Stereo 16-bit: 1024 frames per 4 KB page. */
+        set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+            NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_B16);
+        set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE,
+            NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE_S16);
+        set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_STEREO, 1);
+        set(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, 1023);
+    } else {
+        set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+            NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM);
+        set(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, 113 * 64 - 1);
+    }
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, 1);
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_V6BIN, 10);
+    set(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_V7BIN, 11);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V0BIN, 0);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V1BIN, 1);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V2BIN, 2);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V3BIN, 3);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V4BIN, 4);
+    set(d, v, NV_PAVS_VOICE_CFG_VBIN, NV_PAVS_VOICE_CFG_VBIN_V5BIN, 5);
+    set(d, v, NV_PAVS_VOICE_CUR_PSL_START, NV_PAVS_VOICE_CUR_PSL_START_BA, page * 4096);
+    set(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH,
+        (uint16_t)((int)(v % 5) * 150 - 300));
+    set(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE, next);
+    for (unsigned b = 0; b < 8; ++b)
+        s_vol[v][b] = b < 2 ? (uint16_t)(0x0C0 + v * 4) : b == 6 ? 0x400 : 0xFFF;
+    set_volumes(d, v, s_vol[v]);
+    if (v == FIRST2D + 1) {
+        set(d, v, NV_PAVS_VOICE_CFG_ENVA, NV_PAVS_VOICE_CFG_ENVA_EA_DECAYRATE, 400);
+        set(d, v, NV_PAVS_VOICE_CFG_ENVA, NV_PAVS_VOICE_CFG_ENVA_EA_SUSTAINLEVEL, 0x40);
+        set(d, v, NV_PAVS_VOICE_CUR_ECNT, NV_PAVS_VOICE_CUR_ECNT_EACOUNT, 400 * 16);
+        set(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_EACUR,
+            NV_PAVS_VOICE_PAR_STATE_EFCUR_DECAY);
+    }
+    set(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+}
+
+static void setup(MCPXAPUState *d, bool dsp)
+{
+    memset(memory, 0, sizeof(memory));
+    memset(d, 0, sizeof(*d));
+    memset(&g_dbg, 0, sizeof(g_dbg));
+    memset(s_vol, 0, sizeof(s_vol));
+    s_random = 0x5c2b9341;
+    mcpx_apu_vp_init(d);
+    mcpx_apu_vp_reset(d);
+    d->regs[NV_PAPU_VPVADDR] = VOICE_TABLE;
+    d->regs[NV_PAPU_VPSGEADDR] = SGE;
+    d->regs[NV_PAPU_FENADDR] = NOTIFY;
+    d->monitor.point = dsp ? MCPX_APU_DEBUG_MON_GP : MCPX_APU_DEBUG_MON_VP;
+    for (unsigned page = 0; page < SAMPLE_PAGES; ++page)
+        stl_le_phys(NULL, SGE + page * 8, SAMPLES + page * 4096);
+    for (unsigned byte = 0; byte < SAMPLE_PAGES * 4096; ++byte)
+        memory[SAMPLES + byte] = (uint8_t)next_random();
+    /* MM3's routing: HRTF to the crosstalk bins, some headroom. */
+    fe_method(d, NV1BA0_PIO_SET_HRTF_SUBMIXES, 6 | 8 << 8 | 7 << 16 | 9 << 24);
+    fe_method(d, NV1BA0_PIO_SET_HRTF_HEADROOM, 1);
+    for (unsigned bin = 0; bin < NUM_MIXBINS; ++bin)
+        fe_method(d, NV1BA0_PIO_SET_SUBMIX_HEADROOM + bin * 4, bin < 10 ? 1 : 2);
+    /* 32 HRTF entries: decaying random impulse responses, delays up to
+     * +-20 samples with fractions. */
+    for (unsigned entry = 0; entry < 32; ++entry) {
+        fe_method(d, NV1BA0_PIO_SET_CURRENT_HRTF_ENTRY, entry);
+        for (unsigned slot = 0; slot < 15; ++slot) {
+            uint32_t word = 0;
+            for (unsigned b = 0; b < 4; ++b) {
+                int span = 127 >> (slot / 3);
+                int value = (int)(next_random() % (2 * span + 1)) - span;
+                word |= (uint32_t)(uint8_t)(int8_t)value << (8 * b);
+            }
+            fe_method(d, NV1BA0_PIO_SET_HRIR + slot * 4, word);
+        }
+        int itd = (int)(next_random() % (40 * 512 + 1)) - 20 * 512;
+        if (entry % 4 == 0) itd = 0;
+        fe_method(d, NV1BA0_PIO_SET_HRIR_X, 3u | 0xFDu << 8 | (uint32_t)(uint16_t)itd << 16);
+    }
+    for (unsigned v = 0; v < VOICES3D; ++v)
+        voice_3d(d, v, v * 2, v + 1 < VOICES3D ? v + 1 : 0xFFFF);
+    for (unsigned i = 0; i < VOICES2D; ++i) {
+        unsigned v = FIRST2D + i;
+        voice_2d(d, v, 128 + i * 2, i + 1 < VOICES2D ? v + 1 : 0xFFFF);
+    }
+    d->regs[NV_PAPU_TVL3D] = 0;
+    d->regs[NV_PAPU_TVL2D] = FIRST2D;
+    d->regs[NV_PAPU_TVLMP] = 0xFFFF;
+}
+
+static bool s_steady_hrtf;   /* "steady": HRTF targets never change */
+
+/* What DirectSound does once per game frame: move volumes and pitch a
+ * little, and give a third of the 3D voices a new HRTF target. */
+static void game_update(MCPXAPUState *d, unsigned frame)
+{
+    for (unsigned v = 0; v < FIRST2D + VOICES2D; ++v) {
+        if (v >= VOICES3D && v < FIRST2D) continue;
+        for (unsigned b = 0; b < 8; ++b) {
+            if (s_vol[v][b] == 0xFFF) continue;
+            int value = (int)s_vol[v][b] + (int)(next_random() % 65) - 32;
+            s_vol[v][b] = (uint16_t)(value < 0 ? 0 : value > 0xFFE ? 0xFFE : value);
+        }
+        set_volumes(d, v, s_vol[v]);
+        int pitch = (int16_t)voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                                            NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH);
+        pitch += (int)(next_random() % 41) - 20;
+        set(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH, (uint16_t)pitch);
+        if (v < VOICES3D && !s_steady_hrtf && (v + frame / 25) % 3 == 0) {
+            fe_method(d, NV1BA0_PIO_SET_CURRENT_VOICE, v);
+            fe_method(d, NV1BA0_PIO_SET_VOICE_TAR_HRTF, (v + frame / 25) % 32);
+        }
+    }
+}
+
+static void emit(FILE *out, const void *data, size_t bytes)
+{
+    if (out) CHECK(fwrite(data, bytes, 1, out) == 1);
+}
+
+static float s_bins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME];
+
+static void run(MCPXAPUState *d, unsigned frames, FILE *out)
+{
+    for (unsigned frame = 0; frame < frames; ++frame) {
+        if (frame % 25 == 0) game_update(d, frame);
+        memset(s_bins, 0, sizeof(s_bins));
+        mcpx_apu_vp_frame(d, s_bins);
+        emit(out, s_bins, sizeof(s_bins));
+        if (++d->ep_frame_div % 8 == 0) {
+            emit(out, d->monitor.frame_buf, sizeof(d->monitor.frame_buf));
+            memset(d->monitor.frame_buf, 0, sizeof(d->monitor.frame_buf));
+        }
+    }
+}
+
+static void emit_state(MCPXAPUState *d, FILE *out)
+{
+    emit(out, memory, SAMPLES);
+    emit(out, s_gain_prev, sizeof(s_gain_prev));
+    emit(out, s_mon_prev, sizeof(s_mon_prev));
+    for (unsigned v = 0; v < MCPX_HW_MAX_VOICES; ++v) {
+        MCPXAPUVoiceFilter *f = &d->vp.filters[v];
+        emit(out, f->resample_buf, sizeof(f->resample_buf));
+        emit(out, &f->resample_phase, sizeof(f->resample_phase));
+        emit(out, f->resample_pair, sizeof(f->resample_pair));
+        emit(out, &f->resample_valid, sizeof(f->resample_valid) * 3);
+        /* Not the filters' output pointer: an address, not state. */
+        emit(out, &f->svf[0], offsetof(sv_filter, op));
+        emit(out, &f->svf[1], offsetof(sv_filter, op));
+        emit(out, &f->hrtf, sizeof(f->hrtf));
+    }
+}
+
+int main(int argc, char **argv)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    bool dsp = false, emit_mode;
+    InitializeCriticalSection(&s_range_lock);
+    CHECK(d && argc >= 2);
+    emit_mode = !strcmp(argv[1], "--emit");
+    CHECK(emit_mode || !strcmp(argv[1], "--bench"));
+    for (int i = emit_mode ? 3 : 2; i < argc; ++i) {
+        if (!strcmp(argv[i], "dsp")) dsp = true;
+        else if (!strcmp(argv[i], "nohrtf")) g_config.audio.hrtf = false;
+        else if (!strcmp(argv[i], "steady")) s_steady_hrtf = true;
+        else CHECK(!"unknown option");
+    }
+    if (emit_mode) {
+        FILE *out;
+        CHECK(argc >= 3 && (out = fopen(argv[2], "wb")) != NULL);
+        setup(d, dsp);
+        run(d, FRAMES, out);
+        emit_state(d, out);
+        CHECK(!fclose(out));
+        printf("VP frame replay: %u 3D + %u 2D voices, %u frames, %s mix\n",
+               VOICES3D, VOICES2D, FRAMES, dsp ? "sound-processor" : "voice-only");
+    } else {
+        LARGE_INTEGER frequency, begin, end;
+        double best = 1e30, total = 0;
+        QueryPerformanceFrequency(&frequency);
+        for (unsigned trial = 0; trial < 7; ++trial) {
+            setup(d, dsp);
+            QueryPerformanceCounter(&begin);
+            run(d, FRAMES, NULL);
+            QueryPerformanceCounter(&end);
+            double us = 1e6 * (end.QuadPart - begin.QuadPart) / frequency.QuadPart / FRAMES;
+            total += us;
+            if (us < best) best = us;
+        }
+        printf("%s mix, HRTF %s: %.2f us per frame (best of 7, mean %.2f), %.1f%% of a core at 1500 frames/s\n",
+               dsp ? "sound-processor" : "voice-only", g_config.audio.hrtf ? "on" : "off",
+               best, total / 7, best * 1500 / 1e4);
+#ifdef VP_PROFILE
+        {
+            /* Stage-timed copy (instrument.py): share of the frame time. */
+            static const char *const names[7] = { "envelopes+rate", "fetch+resample", "bins+volumes",
+                                                  "low-pass", "HRTF", "bin mix", "monitor mix" };
+            uint64_t staged = 0;
+            for (unsigned i = 0; i < 7; ++i) staged += s_prof[i];
+            for (unsigned i = 0; i < 7; ++i)
+                printf("  %-15s %5.1f%%\n", names[i], 100.0 * s_prof[i] / s_prof[7]);
+            printf("  %-15s %5.1f%%\n", "list walk etc.", 100.0 * (s_prof[7] - staged) / s_prof[7]);
+            printf("  (source fetch alone %5.1f%%)\n", 100.0 * s_prof_fetch / s_prof[7]);
+        }
+#endif
+    }
+    free(d);
+    return 0;
+}
diff --git a/tests/dsp/vp_idle_report_test.c b/tests/dsp/vp_idle_report_test.c
new file mode 100644
index 0000000..f4ee01c
--- /dev/null
+++ b/tests/dsp/vp_idle_report_test.c
@@ -0,0 +1,202 @@
+/* Execute the production idle-voice reports and voice check: every idle voice
+ * of a frame is offered to DirectSound in list order, one trap and interrupt
+ * each, even behind a voice it keeps declining; a declined voice backs off;
+ * the voice check names a finished voice left in its list and a playing voice
+ * in no list. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+#define CHECK(c) do { if (!(c)) { fprintf(stderr,"VP idle report line %d: %s\n",__LINE__,#c); exit(1); } } while (0)
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t ram[0x20000];
+uint8_t *g_apu_ram_ptr = ram;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(ram));
+    return ram + address;
+}
+
+static MCPXAPUState *d;
+static float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME];
+static unsigned declined = 0xFFFF;
+static unsigned heard[64], heard_count;
+
+static unsigned link_of(unsigned v)
+{
+    return voice_get_mask(d, (uint16_t)v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                          NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+}
+static void link_voice(unsigned v, unsigned next)
+{
+    voice_set_mask(d, (uint16_t)v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                   NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE, next);
+}
+static void set_active(unsigned v, unsigned on)
+{
+    voice_set_mask(d, (uint16_t)v, NV_PAVS_VOICE_PAR_STATE,
+                   NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, on);
+}
+static void make_list(int list, const unsigned *voices, int count)
+{
+    d->regs[voice_list_regs[list].top] = count ? voices[0] : 0xFFFF;
+    for (int i = 0; i < count; i++)
+        link_voice(voices[i], i + 1 < count ? voices[i + 1] : 0xFFFF);
+}
+static int in_list(int list, unsigned v)
+{
+    unsigned h = d->regs[voice_list_regs[list].top];
+    for (int i = 0; h != 0xFFFF && i < 256; i++, h = link_of(h))
+        if (h == v) return 1;
+    return 0;
+}
+
+/* DirectSound's trap handler as far as these voices go (0x0027B6FB): read the
+ * trapped method and voice, take the voice out of its list -- predecessor's
+ * link or the list head, then the voice pointed at itself -- unless it is the
+ * one it declines, and acknowledge: HALTED, then FREE_RUNNING. */
+static void directsound_isr(MCPXAPUState *state)
+{
+    uint32_t v = state->regs[NV_PAPU_FEDECPARAM];
+    CHECK(state == d);
+    CHECK(state->regs[NV_PAPU_FEDECMETH] == SE2FE_IDLE_VOICE);
+    CHECK((state->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE) ==
+          NV_PAPU_FECTL_FEMETHMODE_TRAPPED);
+    CHECK(heard_count < 64);
+    heard[heard_count++] = v;
+    if (v != declined) {
+        for (int list = 0; list < 3; list++) {
+            unsigned top = voice_list_regs[list].top, h = state->regs[top], prev = 0xFFFF;
+            for (int i = 0; h != 0xFFFF && i < 256; i++, prev = h, h = link_of(h)) {
+                if (h != v) continue;
+                if (prev == 0xFFFF) state->regs[top] = link_of(v);
+                else link_voice(prev, link_of(v));
+                link_voice(v, v);
+                break;
+            }
+        }
+    }
+    apu_fe_write_mode(&state->fe_publication, &state->regs[NV_PAPU_FECTL],
+                      (state->regs[NV_PAPU_FECTL] & ~0x60u) | NV_PAPU_FECTL_FEMETHMODE_HALTED);
+    apu_fe_write_mode(&state->fe_publication, &state->regs[NV_PAPU_FECTL],
+                      state->regs[NV_PAPU_FECTL] & ~NV_PAPU_FECTL_FEMETHMODE);
+}
+
+static void undelivered_isr(MCPXAPUState *state)
+{
+    (void)state;
+    heard_count++;
+}
+
+int main(void)
+{
+    d = calloc(1, sizeof(*d));
+    CHECK(d);
+    d->regs[NV_PAPU_VPVADDR] = 0x10000;
+    d->regs[NV_PAPU_FETFORCE1] = NV_PAPU_FETFORCE1_SE2FE_IDLE_VOICE;
+    for (int l = 0; l < 3; l++) d->regs[voice_list_regs[l].top] = 0xFFFF;
+
+    /* One frame: a declined voice first, an active one, two finished ones
+     * behind them, and one in the 3D list. All four idle voices are heard,
+     * in list order; the declined one stays. One report per frame left the
+     * three behind the declined voice waiting for good. */
+    unsigned list0[] = { 70, 71, 72, 73 }, list1[] = { 74 };
+    make_list(0, list0, 4); make_list(1, list1, 1);
+    set_active(71, 1);
+    declined = 70;
+    g_apu_vp_idle_voices = 4;
+    CHECK(mcpx_apu_vp_report_idle(d, directsound_isr) == 4);
+    CHECK(heard_count == 4 && heard[0] == 70 && heard[1] == 72 && heard[2] == 73 && heard[3] == 74);
+    CHECK(in_list(0, 70) && in_list(0, 71) && !in_list(0, 72) && !in_list(0, 73) && !in_list(1, 74));
+    CHECK(link_of(70) == 71 && link_of(71) == 0xFFFF && d->regs[voice_list_regs[1].top] == 0xFFFF);
+    CHECK((d->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE) == NV_PAPU_FECTL_FEMETHMODE_FREE_RUNNING);
+
+    /* Nothing idle last frame: nothing is walked or reported. */
+    heard_count = 0;
+    g_apu_vp_idle_voices = 0;
+    CHECK(mcpx_apu_vp_report_idle(d, directsound_isr) == 0 && heard_count == 0);
+
+    /* A trap that was not delivered waits for the next frame: one report,
+     * then the front end is still trapped and nothing more is offered. */
+    g_apu_vp_idle_voices = 1;
+    CHECK(mcpx_apu_vp_report_idle(d, undelivered_isr) == 1 && heard_count == 1);
+    CHECK((d->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE) == NV_PAPU_FECTL_FEMETHMODE_TRAPPED);
+    CHECK(mcpx_apu_vp_report_idle(d, directsound_isr) == 0 && heard_count == 1);
+    apu_fe_write_mode(&d->fe_publication, &d->regs[NV_PAPU_FECTL], 0);
+
+    /* The title halted the front end: no trap. */
+    apu_fe_write_mode(&d->fe_publication, &d->regs[NV_PAPU_FECTL], NV_PAPU_FECTL_FEMETHMODE_HALTED);
+    CHECK(mcpx_apu_vp_report_idle(d, directsound_isr) == 0);
+    apu_fe_write_mode(&d->fe_publication, &d->regs[NV_PAPU_FECTL], 0);
+
+    /* Idle-voice traps not enabled: no report. */
+    d->regs[NV_PAPU_FETFORCE1] = 0;
+    CHECK(mcpx_apu_vp_report_idle(d, directsound_isr) == 0);
+    CHECK((d->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE) == NV_PAPU_FECTL_FEMETHMODE_FREE_RUNNING);
+    d->regs[NV_PAPU_FETFORCE1] = NV_PAPU_FETFORCE1_SE2FE_IDLE_VOICE;
+
+    /* Backoff, through the production walk: voice 70 alone and declined each
+     * time. Offered on each of the first VP_IDLE_PATIENCE frames, then on
+     * every VP_IDLE_BACKOFF-th frame only. */
+    mcpx_apu_vp_reset(d);
+    s_vp_frames = 0;
+    unsigned only70[] = { 70 };
+    make_list(0, only70, 1); make_list(1, NULL, 0);
+    set_active(71, 0);
+    int offered[48] = { 0 };
+    for (int f = 1; f <= 40; f++) {
+        heard_count = 0;
+        mcpx_apu_vp_frame(d, mixbins);
+        CHECK(g_apu_vp_idle_voices == 1 && g_apu_vp_active_voices == 0);
+        offered[f] = mcpx_apu_vp_report_idle(d, directsound_isr);
+        CHECK(offered[f] == (int)heard_count);
+    }
+    for (int f = 1; f <= 16; f++) CHECK(offered[f] == 1);
+    for (int f = 17; f <= 40; f++) CHECK(offered[f] == (f % VP_IDLE_BACKOFF == 0));
+    CHECK(s_idle_declines[70] >= VP_IDLE_PATIENCE);
+
+    /* Seen playing again: the backoff is forgotten. */
+    set_active(70, 1);
+    voice_set_mask(d, 70, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_PAUSED, 1);
+    mcpx_apu_vp_frame(d, mixbins);
+    CHECK(g_apu_vp_active_voices == 1 && g_apu_vp_idle_voices == 0);
+    CHECK(s_idle_declines[70] == 0 && !s_idle_reported[70]);
+    set_active(70, 0);
+
+    /* The voice check. Voice 70, finished and declined, is said once after
+     * 2 s; voice 80, playing in no list, on the second check in a row. */
+    for (int f = 0; f < 3; f++) {
+        mcpx_apu_vp_frame(d, mixbins);
+        mcpx_apu_vp_report_idle(d, directsound_isr);
+    }
+    CHECK(s_idle_declines[70] > 0);
+    set_active(80, 1);
+    voice_set_mask(d, 80, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_PAUSED, 1);
+    mcpx_apu_vp_check_voices(d, 10000);
+    CHECK(!s_idle_noted[70] && s_idle_since_ms[70] == 10000);
+    CHECK(s_lost_seen[80] && !s_lost_noted[80]);
+    mcpx_apu_vp_check_voices(d, 11000);
+    CHECK(!s_idle_noted[70] && s_lost_noted[80]);
+    mcpx_apu_vp_check_voices(d, 12000);
+    CHECK(s_idle_noted[70]);
+    /* Back in a list: no longer lost, and said again if it is lost again. */
+    unsigned list2[] = { 80 };
+    make_list(2, list2, 1);
+    mcpx_apu_vp_check_voices(d, 13000);
+    CHECK(!s_lost_seen[80] && !s_lost_noted[80]);
+    /* Taken out by DirectSound: its time in the list starts over. */
+    declined = 0xFFFF;
+    mcpx_apu_vp_frame(d, mixbins);
+    mcpx_apu_vp_report_idle(d, directsound_isr);
+    CHECK(!in_list(0, 70));
+    mcpx_apu_vp_check_voices(d, 14000);
+    CHECK(s_idle_since_ms[70] == 0);
+
+    free(d);
+    puts("VP idle reports: every idle voice in list order/declined stays/undelivered waits/halted/disabled/backoff/reset/voice check PASS");
+    return 0;
+}
diff --git a/tests/dsp/vp_monitor_mix_test.c b/tests/dsp/vp_monitor_mix_test.c
new file mode 100644
index 0000000..a03126f
--- /dev/null
+++ b/tests/dsp/vp_monitor_mix_test.c
@@ -0,0 +1,199 @@
+/* The voice-only mix used while the GP/EP DSPs are off (RECOMP_APU_DSP=0):
+ * production voice_process on known PCM. A 3D voice whose direct path is
+ * silenced by distance must not play its reverb send dry (a police siren
+ * heard with no police car around), speaker bins keep their side, a sound
+ * routed only through an effect keeps its level, volume changes ramp, and a
+ * voice DirectSound has locked is waited for, briefly. */
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "VP monitor mix line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t memory[0x40000];
+uint8_t *g_apu_ram_ptr = memory;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(memory));
+    return memory + address;
+}
+
+enum { VOICE_3D = 3, VOICE_2D = 100, PCM_ADDRESS = 0x30000, PCM_FRAMES = 256 };
+static const float PCM = 16384.0f / 32768.0f;
+static const float LEVEL = 0.316f;          /* the mix's nominal level */
+
+static void set_bin(MCPXAPUState *d, uint16_t v, int b, unsigned bin, unsigned volume)
+{
+    static const uint32_t bins[8] = {
+        NV_PAVS_VOICE_CFG_VBIN_V0BIN, NV_PAVS_VOICE_CFG_VBIN_V1BIN, NV_PAVS_VOICE_CFG_VBIN_V2BIN,
+        NV_PAVS_VOICE_CFG_VBIN_V3BIN, NV_PAVS_VOICE_CFG_VBIN_V4BIN, NV_PAVS_VOICE_CFG_VBIN_V5BIN,
+        NV_PAVS_VOICE_CFG_FMT_V6BIN, NV_PAVS_VOICE_CFG_FMT_V7BIN };
+    if (b < 6) voice_set_mask(d, v, NV_PAVS_VOICE_CFG_VBIN, bins[b], bin);
+    else voice_set_mask(d, v, NV_PAVS_VOICE_CFG_FMT, bins[b], bin);
+    switch (b) {
+    case 0: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME0, volume); break;
+    case 1: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLA, NV_PAVS_VOICE_TAR_VOLA_VOLUME1, volume); break;
+    case 2: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME2, volume); break;
+    case 3: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLB, NV_PAVS_VOICE_TAR_VOLB_VOLUME3, volume); break;
+    case 4: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME4, volume); break;
+    case 5: voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLC, NV_PAVS_VOICE_TAR_VOLC_VOLUME5, volume); break;
+    default: {
+        uint32_t hi = b == 6 ? NV_PAVS_VOICE_TAR_VOLC_VOLUME6_B11_8 : NV_PAVS_VOICE_TAR_VOLC_VOLUME7_B11_8;
+        uint32_t mid = b == 6 ? NV_PAVS_VOICE_TAR_VOLB_VOLUME6_B7_4 : NV_PAVS_VOICE_TAR_VOLB_VOLUME7_B7_4;
+        uint32_t lo = b == 6 ? NV_PAVS_VOICE_TAR_VOLA_VOLUME6_B3_0 : NV_PAVS_VOICE_TAR_VOLA_VOLUME7_B3_0;
+        voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLC, hi, (volume >> 8) & 0xF);
+        voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLB, mid, (volume >> 4) & 0xF);
+        voice_set_mask(d, v, NV_PAVS_VOICE_TAR_VOLA, lo, volume & 0xF);
+        break;
+    }
+    }
+}
+
+/* A looping mono voice of constant PCM with every bin silent. */
+static void voice(MCPXAPUState *d, uint16_t v)
+{
+    voice_set_mask(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE,
+                   NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE_S16);
+    voice_set_mask(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE,
+                   NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_B16);
+    voice_set_mask(d, v, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, 1);
+    voice_set_mask(d, v, NV_PAVS_VOICE_CFG_HRTF_TARGET, NV_PAVS_VOICE_CFG_HRTF_TARGET_HANDLE,
+                   HRTF_NULL_HANDLE);
+    voice_set_mask(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, PCM_FRAMES - 1);
+    voice_set_mask(d, v, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+    for (int b = 0; b < 8; b++) set_bin(d, v, b, 0, 0xFFF);
+    s_gain_valid[v] = 0;
+}
+
+static void setup(MCPXAPUState *d)
+{
+    memset(memory, 0, sizeof(memory));
+    memset(d, 0, sizeof(*d));
+    mcpx_apu_vp_init(d);
+    d->monitor.point = MCPX_APU_DEBUG_MON_VP;
+    d->regs[NV_PAPU_VPVADDR] = 0x1000;
+    d->regs[NV_PAPU_VPSGEADDR] = 0xA000;
+    stl_le_phys(NULL, 0xA000, PCM_ADDRESS);
+    for (unsigned i = 0; i < PCM_FRAMES; ++i) stw_le_phys(NULL, PCM_ADDRESS + i * 2, 16384);
+    /* MM3's 3D voices: crosstalk bins front-left, back-left, front-right, back-right. */
+    d->vp.hrtf_submix[0] = 6; d->vp.hrtf_submix[1] = 8;
+    d->vp.hrtf_submix[2] = 7; d->vp.hrtf_submix[3] = 9;
+}
+
+/* Two frames (the first settles the ramp); the second frame's output. */
+static void mix(MCPXAPUState *d, uint16_t v, float out[32][2], int frames)
+{
+    float bins[NUM_MIXBINS][32];
+    for (int f = 0; f < frames; f++) {
+        memset(bins, 0, sizeof(bins));
+        memset(out, 0, sizeof(float) * 64);
+        voice_process(d, bins, out, v, 0);
+    }
+}
+
+static int close_to(float a, float b) { return fabsf(a - b) < 0.0005f; }
+
+int main(void)
+{
+    static MCPXAPUState state;
+    MCPXAPUState *d = &state;
+    float out[32][2];
+
+    /* A far 3D siren: direct path silent, reverb send (I3DL2) at 0 dB. */
+    setup(d);
+    voice(d, VOICE_3D);
+    set_bin(d, VOICE_3D, 4, 10, 0);
+    mix(d, VOICE_3D, out, 2);
+    CHECK(close_to(out[31][0], 0.1f * LEVEL * PCM) && close_to(out[31][1], 0.1f * LEVEL * PCM));
+
+    /* A near 3D voice in front: both front crosstalk bins at 0 dB. */
+    voice(d, VOICE_3D);
+    set_bin(d, VOICE_3D, 0, 6, 0);
+    set_bin(d, VOICE_3D, 2, 7, 0);
+    mix(d, VOICE_3D, out, 2);
+    CHECK(close_to(out[31][0], LEVEL * PCM) && close_to(out[31][1], LEVEL * PCM));
+
+    /* To the left: only the left crosstalk bins. */
+    voice(d, VOICE_3D);
+    set_bin(d, VOICE_3D, 0, 6, 0);
+    set_bin(d, VOICE_3D, 1, 8, 0);
+    mix(d, VOICE_3D, out, 2);
+    CHECK(close_to(out[31][0], 1.707f * LEVEL * PCM) && out[31][1] == 0.0f);
+
+    /* A 2D voice on the front-left speaker stays on the left. */
+    voice(d, VOICE_2D);
+    set_bin(d, VOICE_2D, 0, 0, 0);
+    set_bin(d, VOICE_2D, 1, 1, 0xFFF);
+    mix(d, VOICE_2D, out, 2);
+    CHECK(close_to(out[31][0], LEVEL * PCM) && out[31][1] == 0.0f);
+
+    /* The centre goes to both at -3 dB; -20 dB of attenuation is 0.1. */
+    voice(d, VOICE_2D);
+    set_bin(d, VOICE_2D, 0, 2, 64 * 20);
+    mix(d, VOICE_2D, out, 2);
+    CHECK(close_to(out[31][0], 0.0707f * LEVEL * PCM) && close_to(out[31][1], 0.0707f * LEVEL * PCM));
+
+    /* A 2D voice routed only through an effect send keeps its level. */
+    voice(d, VOICE_2D);
+    set_bin(d, VOICE_2D, 0, 11, 0);
+    mix(d, VOICE_2D, out, 2);
+    CHECK(close_to(out[31][0], LEVEL * PCM) && close_to(out[31][1], LEVEL * PCM));
+
+    /* With a speaker bin as well, the send is only a quiet share. */
+    set_bin(d, VOICE_2D, 1, 1, 0);
+    mix(d, VOICE_2D, out, 2);
+    CHECK(close_to(out[31][0], 0.1f * LEVEL * PCM) && close_to(out[31][1], 1.1f * LEVEL * PCM));
+
+    /* A volume change ramps across the next frame instead of stepping. */
+    voice(d, VOICE_2D);
+    set_bin(d, VOICE_2D, 0, 0, 0);
+    mix(d, VOICE_2D, out, 2);
+    set_bin(d, VOICE_2D, 0, 0, 0xFFF);
+    mix(d, VOICE_2D, out, 1);
+    CHECK(close_to(out[0][0], LEVEL * PCM * 31.0f / 32.0f) && close_to(out[15][0], LEVEL * PCM * 16.0f / 32.0f));
+    CHECK(out[31][0] == 0.0f);
+    for (int i = 1; i < 32; i++)
+        CHECK(fabsf(out[i][0] - out[i - 1][0]) < LEVEL * PCM / 31.0f);
+
+    /* A new voice on a reused handle starts at its own level, not the old one's. */
+    voice(d, VOICE_2D);
+    set_bin(d, VOICE_2D, 0, 0, 0);
+    mix(d, VOICE_2D, out, 1);
+    CHECK(close_to(out[0][0], LEVEL * PCM));
+
+    /* A locked voice: unlocked at once returns at once; still locked, the
+     * wait gives up after VP_LOCK_WAIT_US and the voice is processed. */
+    {
+        unsigned waits, timeouts;
+        int64_t begin, took;
+        mcpx_apu_vp_lock_stats(&waits, &timeouts);
+        voice_spin_lock(d, VOICE_2D);
+        voice_wait_unlocked(d, VOICE_2D);
+        voice_spin_unlock(d, VOICE_2D);
+        mcpx_apu_vp_lock_stats(&waits, &timeouts);
+        CHECK(waits == 1 && timeouts == 0);
+        voice_lock(d, VOICE_2D, true);
+        CHECK(is_voice_locked(d, VOICE_2D));
+        begin = qemu_clock_get_us(QEMU_CLOCK_REALTIME);
+        voice_spin_lock(d, VOICE_2D);
+        voice_wait_unlocked(d, VOICE_2D);
+        voice_spin_unlock(d, VOICE_2D);
+        took = qemu_clock_get_us(QEMU_CLOCK_REALTIME) - begin;
+        mcpx_apu_vp_lock_stats(&waits, &timeouts);
+        CHECK(waits == 1 && timeouts == 1);
+        CHECK(took >= VP_LOCK_WAIT_US && took < 100000);
+        voice_lock(d, VOICE_2D, false);
+        CHECK(!is_voice_locked(d, VOICE_2D));
+    }
+
+    mcpx_apu_vp_finalize(d);
+    puts("PASS: voice-only mix keeps far 3D voices at their reverb share, speaker sides, effect-only levels, "
+         "ramps volume changes and waits briefly for locked voices");
+    return 0;
+}
diff --git a/tests/dsp/vp_profile_test.c b/tests/dsp/vp_profile_test.c
new file mode 100644
index 0000000..292f237
--- /dev/null
+++ b/tests/dsp/vp_profile_test.c
@@ -0,0 +1,71 @@
+/* Execute the production bounded voice-table/list diagnostic without mixing. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+#define CHECK(c) do { if (!(c)) { fprintf(stderr,"VP profile line %d: %s\n",__LINE__,#c); exit(1); } } while (0)
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t ram[0x20000], before[sizeof(ram)];
+static uint8_t *noaccess;
+uint8_t *g_apu_ram_ptr = ram;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    if (address >= 0x80000000u && address < 0x80008000u)
+        return noaccess + (address - 0x80000000u);
+    CHECK(address < sizeof(ram));
+    return ram + address;
+}
+static void link_voice(MCPXAPUState *d, unsigned v, unsigned next)
+{
+    voice_set_mask(d, (uint16_t)v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                   NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE, next);
+}
+int main(void)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d);
+    APUVoiceSnapshot s;
+    for (unsigned l=0;l<3;++l) d->regs[voice_list_regs[l].top]=0xffff;
+    mcpx_apu_vp_profile_snapshot(d,&s);
+    CHECK(!s.available && !s.table_active);
+    d->regs[NV_PAPU_VPVADDR]=0x10000;
+    unsigned voices[]={0,1,64,65};
+    for(unsigned i=0;i<4;++i) {
+        voice_set_mask(d,(uint16_t)voices[i],NV_PAVS_VOICE_PAR_STATE,NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE,1);
+        voice_set_mask(d,(uint16_t)voices[i],NV_PAVS_VOICE_PAR_OFFSET,NV_PAVS_VOICE_PAR_OFFSET_EALVL,i!=0);
+    }
+    voice_set_mask(d,1,NV_PAVS_VOICE_PAR_STATE,NV_PAVS_VOICE_PAR_STATE_PAUSED,1);
+    voice_set_mask(d,1,NV_PAVS_VOICE_CFG_FMT,NV_PAVS_VOICE_CFG_FMT_DATA_TYPE,1);
+    voice_set_mask(d,1,NV_PAVS_VOICE_CFG_FMT,NV_PAVS_VOICE_CFG_FMT_PERSIST,1);
+    voice_set_mask(d,64,NV_PAVS_VOICE_CFG_FMT,NV_PAVS_VOICE_CFG_FMT_MULTIPASS,1);
+    d->vp.filters[65].resample_source_ended=true;
+    d->regs[voice_list_regs[0].top]=0; link_voice(d,0,1);link_voice(d,1,0xffff);
+    d->regs[voice_list_regs[1].top]=64;link_voice(d,64,66);link_voice(d,66,0xffff);
+    memcpy(before,ram,sizeof(ram));
+    mcpx_apu_vp_profile_snapshot(d,&s);
+    CHECK(s.available && s.table_active==4 && s.active_3d==2);
+    CHECK(s.paused==1 && s.persistent==1 && s.stream_empty==1 && s.multipass==1);
+    CHECK(s.source_ended==1 && s.envelope_zero==1 && !s.invalid_ssl);
+    CHECK(s.linked_active==3 && s.linked_idle==1 && s.unlisted_active==1);
+    CHECK(s.nodes[0]==2 && s.nodes[1]==2 && !s.nodes[2] && !s.bad_links && !s.repeated);
+    CHECK(!memcmp(before,ram,sizeof(ram)));
+    link_voice(d,1,0); d->regs[voice_list_regs[2].top]=0x100;
+    d->vp.ssl[1].ssl_index=MCPX_HW_SSLS_PER_VOICE;
+    mcpx_apu_vp_profile_snapshot(d,&s);
+    CHECK(s.repeated==1 && s.bad_links==1 && s.invalid_ssl==1);
+    noaccess=VirtualAlloc(NULL,0x8000,MEM_RESERVE|MEM_COMMIT,PAGE_NOACCESS);
+    CHECK(noaccess); d->regs[NV_PAPU_VPVADDR]=0x80000000u;
+    mcpx_apu_vp_profile_snapshot(d,&s);
+    CHECK(!s.available && !s.table_active);
+    CHECK(VirtualFree(noaccess,0,MEM_RELEASE));
+    /* VP reset does not clear the independent decoder publication lock. */
+    d->fe_publication.lock=1; mcpx_apu_vp_reset(d);
+    CHECK(d->fe_publication.lock==1); d->fe_publication.lock=0;
+    free(d);
+    puts("VP profile: all 256/table-vs-list/classes/read-only/cycle/bad-handle/unconfigured/unreadable/reset-lifetime PASS");
+    return 0;
+}
diff --git a/tests/dsp/vp_resampling_test.c b/tests/dsp/vp_resampling_test.c
new file mode 100644
index 0000000..b3d4fbb
--- /dev/null
+++ b/tests/dsp/vp_resampling_test.c
@@ -0,0 +1,199 @@
+/* Exercise the production source reader/resampler against known PCM without
+ * an audio endpoint. In particular, EBO is the inclusive last input sample. */
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "VP resampling line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t memory[0x20000];
+uint8_t *g_apu_ram_ptr = memory;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(memory));
+    return memory + address;
+}
+
+enum { TEST_VOICE = 100, PCM_ADDRESS = 0x10000 };
+
+static void setup(MCPXAPUState *d, unsigned frames, int loop)
+{
+    memset(memory, 0, sizeof(memory));
+    memset(d, 0, sizeof(*d));
+    mcpx_apu_vp_init(d);
+    d->regs[NV_PAPU_VPVADDR] = 0x1000;
+    d->regs[NV_PAPU_VPSGEADDR] = 0xA000;
+    stl_le_phys(NULL, 0xA000, PCM_ADDRESS);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_CFG_FMT,
+                   NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE, NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE_S16);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_CFG_FMT,
+                   NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_B16);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_LOOP, loop);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE, 1);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO, frames - 1);
+    for (unsigned i = 0; i < frames; ++i)
+        stw_le_phys(NULL, PCM_ADDRESS + i * 2, (uint16_t)(100 + i));
+}
+
+static void check_inclusive_end(MCPXAPUState *d)
+{
+    float samples[32][2];
+    setup(d, 33, 1);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 32) == 32);
+    CHECK(voice_get_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_OFFSET,
+                         NV_PAVS_VOICE_PAR_OFFSET_CBO) == 32);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 1) == 1);
+    CHECK(samples[0][0] == int16_to_float(132));
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 1) == 1);
+    CHECK(samples[0][0] == int16_to_float(100));
+    mcpx_apu_vp_finalize(d);
+}
+
+static void check_rate(MCPXAPUState *d, double input_per_output)
+{
+    /* Pick a long looping source so boundary/chunk size cannot hide drift. */
+    setup(d, 1000, 1);
+    double position = 0;
+    float rate = (float)(1.0 / input_per_output);
+    for (unsigned frame = 0; frame < 3000; ++frame) {
+        float samples[32][2];
+        CHECK(voice_resample(d, TEST_VOICE, samples, 32, rate) == 32);
+        for (unsigned n = 0; n < 32; ++n) {
+            unsigned index = (unsigned)position % 1000;
+            unsigned next = (index + 1) % 1000;
+            double fraction = position - floor(position);
+            float expected = int16_to_float((int16_t)(100 + index)) +
+                (int16_to_float((int16_t)(100 + next)) - int16_to_float((int16_t)(100 + index))) * (float)fraction;
+            CHECK(fabsf(samples[n][0] - expected) < 0.00001f);
+            CHECK(samples[n][0] == samples[n][1]);
+            position += 1.0 / rate;
+        }
+    }
+    mcpx_apu_vp_finalize(d);
+}
+
+static void check_stream_boundary(MCPXAPUState *d)
+{
+    float samples[32][2];
+    setup(d, 66, 0);
+    d->regs[NV_PAPU_VPSSLADDR] = 0xB000;
+    d->vp.ssl[TEST_VOICE].count[0] = 2;
+    stl_le_phys(NULL, 0xB000, PCM_ADDRESS);
+    stl_le_phys(NULL, 0xB004, 33 | (1u << 16));
+    stl_le_phys(NULL, 0xB008, PCM_ADDRESS + 66);
+    stl_le_phys(NULL, 0xB00C, 33 | (1u << 16));
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_DATA_TYPE, 1);
+    voice_set_mask(d, TEST_VOICE, NV_PAVS_VOICE_CFG_FMT, NV_PAVS_VOICE_CFG_FMT_PERSIST, 1);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 32) == 32);
+    CHECK(d->vp.ssl[TEST_VOICE].ssl_seg == 0);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 1) == 1);
+    CHECK(samples[0][0] == int16_to_float(132));
+    CHECK(d->vp.ssl[TEST_VOICE].ssl_seg == 1);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 32) == 32);
+    CHECK(samples[0][0] == int16_to_float(133));
+    CHECK(d->vp.ssl[TEST_VOICE].ssl_seg == 1);
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 1) == 1);
+    CHECK(samples[0][0] == int16_to_float(165));
+    CHECK(d->vp.ssl[TEST_VOICE].ssl_index == 1);
+    /* An empty persistent stream is an underrun, ready for its next packet. */
+    CHECK(voice_get_samples(d, TEST_VOICE, samples, 1) == -1);
+    CHECK(voice_get_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE));
+    CHECK(!d->vp.filters[TEST_VOICE].resample_source_ended);
+    mcpx_apu_vp_finalize(d);
+}
+
+static void check_tail(MCPXAPUState *d, unsigned count, float rate)
+{
+    setup(d, count, 0);
+    unsigned produced = 0;
+    double position = 0;
+    for (unsigned frame = 0; frame < 500; ++frame) {
+        float samples[32][2] = {{0}};
+        int active = voice_get_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_STATE,
+                                   NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE);
+        if (!active) break;
+        int got = voice_resample(d, TEST_VOICE, samples, 32, rate);
+        CHECK(got >= 0);
+        for (int n = 0; n < got; ++n) {
+            unsigned index = (unsigned)position;
+            CHECK(index < count);
+            unsigned next = index + 1 < count ? index + 1 : index;
+            float a = int16_to_float((int16_t)(100 + index));
+            float b = int16_to_float((int16_t)(100 + next));
+            float expected = a + (b - a) * (float)(position - floor(position));
+            CHECK(fabsf(samples[n][0] - expected) < 0.000001f);
+            position += 1.0 / rate;
+        }
+        produced += (unsigned)got;
+    }
+    CHECK(produced == (unsigned)ceil(count * (double)rate - 0.000001));
+    CHECK(!voice_get_mask(d, TEST_VOICE, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE));
+    CHECK(memory[16 * (MCPX_HW_NOTIFIER_BASE_OFFSET + TEST_VOICE * MCPX_HW_NOTIFIER_COUNT) + 15] ==
+          NV1BA0_NOTIFICATION_STATUS_DONE_SUCCESS);
+    mcpx_apu_vp_finalize(d);
+}
+
+static void check_mixed_tail(MCPXAPUState *d, unsigned count)
+{
+    setup(d, count, 0);
+    float bins[NUM_MIXBINS][32] = {{0}}, monitor[32][2] = {{0}};
+    /* Default routes all eight unity-gain paths to bin zero. */
+    voice_process(d, bins, monitor, TEST_VOICE, 0);
+    unsigned first = count < 32 ? count : 32;
+    for (unsigned n = 0; n < first; ++n)
+        CHECK(fabsf(bins[0][n] - 8 * int16_to_float((int16_t)(100 + n))) < 0.000001f);
+    for (unsigned n = first; n < 32; ++n) CHECK(bins[0][n] == 0);
+    if (count > 32) {
+        memset(bins, 0, sizeof(bins));
+        voice_process(d, bins, monitor, TEST_VOICE, 0);
+        for (unsigned n = 0; n < count - 32; ++n)
+            CHECK(fabsf(bins[0][n] - 8 * int16_to_float((int16_t)(132 + n))) < 0.000001f);
+    }
+    mcpx_apu_vp_finalize(d);
+}
+
+static void check_restart(MCPXAPUState *d)
+{
+    float samples[32][2];
+    setup(d, 1, 0);
+    CHECK(voice_resample(d, TEST_VOICE, samples, 32, 1) == 1);
+    CHECK(d->vp.filters[TEST_VOICE].resample_source_ended);
+    stw_le_phys(NULL, PCM_ADDRESS, 321);
+    d->regs[NV_PAPU_FEAV] = 1u << ctz32(NV_PAPU_FEAV_LST);
+    d->regs[NV_PAPU_TVL2D] = 0xFFFF;
+    fe_method(d, NV1BA0_PIO_VOICE_ON, TEST_VOICE);
+    CHECK(!d->vp.filters[TEST_VOICE].resample_source_ended);
+    CHECK(!d->vp.filters[TEST_VOICE].resample_tail);
+    CHECK(voice_resample(d, TEST_VOICE, samples, 32, 1) == 1);
+    CHECK(samples[0][0] == int16_to_float(321));
+    mcpx_apu_vp_reset(d);
+    CHECK(!d->vp.filters[TEST_VOICE].resample_source_ended);
+    CHECK(!d->vp.filters[TEST_VOICE].resample_tail);
+    CHECK(!d->vp.filters[TEST_VOICE].resample_count);
+    mcpx_apu_vp_finalize(d);
+}
+
+int main(void)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d);
+    check_inclusive_end(d);
+    check_stream_boundary(d);
+    const double steps[] = {1, 44100.0 / 48000, 22050.0 / 48000, 2, 4};
+    for (unsigned i = 0; i < sizeof(steps) / sizeof(steps[0]); ++i) check_rate(d, steps[i]);
+    const unsigned counts[] = {1, 2, 31, 32, 33, 63, 64, 65};
+    const float rates[] = {1, 48000.0f / 44100, 2, 0.5f, 8};
+    for (unsigned i = 0; i < sizeof(counts) / sizeof(counts[0]); ++i)
+        for (unsigned r = 0; r < sizeof(rates) / sizeof(rates[0]); ++r) check_tail(d, counts[i], rates[r]);
+    check_mixed_tail(d, 1); check_mixed_tail(d, 31); check_mixed_tail(d, 32); check_mixed_tail(d, 33);
+    check_restart(d);
+    free(d);
+    puts("PASS: inclusive loop endpoint, 96,000 output samples/rate, one-shot durations and complete mixed tails");
+    return 0;
+}
diff --git a/tests/dsp/vp_sge_test.c b/tests/dsp/vp_sge_test.c
new file mode 100644
index 0000000..0dd4b1a
--- /dev/null
+++ b/tests/dsp/vp_sge_test.c
@@ -0,0 +1,44 @@
+/* get_data_ptr from the real apu_vp.c: a page index past max_sge is refused
+ * (false, out untouched) instead of reading the SGE table past its bound. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../src/apu/apu_vp.c"
+#include "vp_test_wake.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "VP SGE check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg, g_dbg_cache;
+int g_dbg_voice_monitor = -1;
+uint64_t g_dbg_muted_voices[4];
+static uint8_t ram[0x4000];
+uint8_t *g_apu_ram_ptr = ram;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    CHECK(address < sizeof(ram)); /* guest reads only: SGE table and data */
+    return ram + address;
+}
+
+int main(void)
+{
+    hwaddr out = 0xdead;
+
+    /* SGE table at 0x1000 with 8-byte entries; entry 1 maps to page 0x2000. */
+    stl_le_phys(address_space_memory, 0x1008, 0x2000);
+    CHECK(get_data_ptr(0x1000, 1, 0x1234, &out));
+    CHECK(out == 0x2000 + 0x234);
+
+    /* Entry 2 is past max_sge 1: refused, and the table is not consulted. */
+    out = 0xdead;
+    CHECK(!get_data_ptr(0x1000, 1, 0x2000, &out));
+    CHECK(out == 0xdead);
+
+    /* The VP has no SGE length register, so its callers bound the index by the
+     * largest page a 32-bit linear address reaches. */
+    CHECK(VP_SGE_MAX_ENTRY == 0xFFFFFu);
+    printf("VP SGE: page index past max refused; in-range lookup resolves\n");
+    return 0;
+}
diff --git a/tests/dsp/vp_test_wake.h b/tests/dsp/vp_test_wake.h
