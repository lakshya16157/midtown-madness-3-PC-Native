+/* Explain a few real streaming opens without changing their cache contract.
+ * This is opt-in through hitch tracing; normal launches do not emit it. */
+static void file_asset_buffering_audio_diagnostic(
+    PXBOX_OBJECT_ATTRIBUTES attributes, ULONG access, ULONG share,
+    ULONG disposition, ULONG options, int eligible)
+{
+    const char *path = get_xbox_path(attributes);
+    size_t length;
+    DWORD error;
+    int saved_errno;
+    if (!path || eligible) return;
+    length = strlen(path);
+    if (length < 4 || _stricmp(path + length - 4, ".wma")) return;
+    error = GetLastError();
+    saved_errno = errno;
+    InitOnceExecuteOnce(&s_file_hitch_once, file_hitch_init, NULL, NULL);
+    if (s_file_hitch_enabled &&
+        InterlockedIncrement(&s_asset_buffering_audio_lines) <= 8) {
+        fprintf(stderr,
+            "[FILE_CACHE] unbuffered_audio_asset guest_path=\"%.512s\" "
+            "relative=%d access=0x%08X share=0x%X disposition=0x%X "
+            "options=0x%X policy_enabled=%d eligible=%d\n",
+            path, attributes->RootDirectory != NULL, (unsigned)access,
+            (unsigned)share, (unsigned)disposition, (unsigned)options,
+            s_asset_buffering_enabled, eligible);
+    }
+    errno = saved_errno;
+    SetLastError(error);
+}
+
+static BOOL CALLBACK file_asset_buffering_initialize(PINIT_ONCE once,
+    PVOID parameter, PVOID *context)
+{
