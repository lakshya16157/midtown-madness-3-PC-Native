+static ID3D11ShaderResourceView *map_square_mask(const NvD3DTexture *t)
+{
+    static ID3D11ShaderResourceView *view;
+    static int attempted;
+    ID3D11Texture2D *texture;
+    uint32_t pixels[128 * 128];
+    unsigned x, y;
+    HRESULT hr;
+    if (t->cube || t->color != 0x0Fu || t->width != 128 || t->height != 128 ||
+        t->levels != 1 || !guest_ok(t->addr, 16384u) ||
+        !nv2a_map_mask_matches(guest(t->addr), 16384u))
+        return NULL;
+    if (view || attempted) return view;
+    attempted = 1;
+    for (y = 0; y < 128; ++y)
+        for (x = 0; x < 128; ++x)
+            pixels[y * 128 + x] = nv2a_map_mask_pixel(x, y);
+    texture = make_texture(128, 128, 1, 1, DXGI_FORMAT_B8G8R8A8_UNORM,
+                           D3D11_BIND_SHADER_RESOURCE, 0);
+    if (!texture) {
+        fprintf(stderr, "[D3D11_MAP_ERROR] square mask allocation failed; keeping native mask\n");
+        fflush(stderr);
+        return NULL;
+    }
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)texture,
+                                         0, NULL, pixels, 128 * 4, 0);
+    hr = ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)texture, NULL, &view);
+    ID3D11Texture2D_Release(texture); /* The view owns the successful allocation. */
+    if (FAILED(hr)) {
+        view = NULL;
+        fprintf(stderr, "[D3D11_MAP_ERROR] square mask view failed hr=%08lX; keeping native mask\n", (unsigned long)hr);
+        fflush(stderr);
+    } else
+        fprintf(stderr, "[D3D11_MAP] square map enabled size=128 edge_fade=8 identity=retail_map_mask\n");
+    return view;
+}
+
+/* MM3's native distance fog replaces the title's fog ramp with one depth pass
+ * per camera (nv2a_d3d_distance_fog). Draws that still carry the title's own
+ * per-draw fog - its tree shader does - kept the retail range and colour, so
+ * trees went grey where the world around them was still clear. On the target
+ * that pass fogs, a draw before this frame's pass drops its per-draw fog (the
+ * pass fogs it with the world) and a draw after it is fogged by its view depth
+ * (clip w) over the pass's range, in the pass's colour: the title's vertex
+ * programs write the fog amount itself (fog params 1, 1), so its range cannot
+ * be remapped. Other targets (reflections) keep the title's fog. */
+static struct {
+    const Surface *target;
+    uint32_t frame, argb;
+    unsigned passes, last_passes;
+    float start, end, depth_to_world;
+} s_native_fog_seen;
+static int s_draw_native_fog;   /* 0 title's fog, 1 left to the pass, 2 the pass's range */
+
+/* Each sky has an authored fog ramp (Skies/<sky>_fog.cdds, 64x32: depth
+ * across, a row the title picks). The retail fog pass and MM3's trees both
+ * read it; the native pass replaced only the first, with one curve for every
+ * weather, so in rain the city lost its haze while the trees kept the dense
+ * rain fog and stood out pale against clear buildings (winter mornings too).
+ * nv2a_d3d_sky_fog_ramp names the ramp each frame: the native pass fogs at
+ * least as much as it, and a draw that reads it gets its fog from the same
+ * depth curve as the world around it. */
+static struct {
+    NvD3DTexture tex;
+    float row, scale, knee;
+    uint32_t frame;
+    int valid;
+} s_sky_ramp;
+
+void nv2a_d3d_sky_fog_ramp(uint32_t addr, uint32_t format, float row, float scale, float knee)
+{
+    uint32_t color = (format >> 8) & 0xFFu, lu = (format >> 20) & 15u, lv = (format >> 24) & 15u;
+    static int reported;
+    s_sky_ramp.valid = 0;
+    if (!addr || !(color == 0x06u || color == 0x07u) || ((format >> 4) & 15u) != 2u ||
+        lu < 2u || lu > 10u || lv > 10u || !isfinite(row) || !isfinite(scale) || !isfinite(knee))
+        return;
+    memset(&s_sky_ramp.tex, 0, sizeof s_sky_ramp.tex);
+    s_sky_ramp.tex.addr = addr;
+    s_sky_ramp.tex.format = format;
+    s_sky_ramp.tex.color = color;
+    s_sky_ramp.tex.width = 1u << lu;
+    s_sky_ramp.tex.height = 1u << lv;
+    s_sky_ramp.tex.depth = 1;
+    s_sky_ramp.tex.levels = (format >> 16) & 15u ? (format >> 16) & 15u : 1u;
+    s_sky_ramp.tex.palette_len = 256;
+    s_sky_ramp.row = fminf(fmaxf(row, 0.0f), 1.0f);
+    s_sky_ramp.scale = scale >= 1.0f && scale <= 16.0f ? scale : 1.0f;
+    s_sky_ramp.knee = knee > 0.0f && knee < 1.0f ? knee : 1.0f;
+    s_sky_ramp.frame = s_frame;
+    s_sky_ramp.valid = 1;
+    if (!reported) {
+        reported = 1;
+        fprintf(stderr, "[FOG] sky fog ramp %08X %ux%u row %.3f at %.2fx depth (knee %.2f)\n",
+                addr, s_sky_ramp.tex.width, s_sky_ramp.tex.height, s_sky_ramp.row,
+                s_sky_ramp.scale, s_sky_ramp.knee);
+    }
+}
+
+/* Named this frame or the last (the pass may precede the frame's flip). */
+static int sky_ramp_current(void)
+{
+    return s_sky_ramp.valid && s_sky_ramp.frame + 1u >= s_frame;
+}
+
+static void native_fog_frame(void)
+{
+    if (s_native_fog_seen.frame == s_frame) return;
+    s_native_fog_seen.last_passes = s_native_fog_seen.frame + 1 == s_frame ? s_native_fog_seen.passes : 0;
+    s_native_fog_seen.passes = 0;
+    s_native_fog_seen.frame = s_frame;
+}
+
+/* Distance fog blends the fog colour in: some final-combiner input is the fog
+ * register's RGB (register 3 without the alpha bit). Draws that only take its
+ * alpha use the title's vertex-program value as a blend weight instead - the
+ * car paint's reflection strength - and must keep it. */
+static int fog_colour_blended(const NvD3DState *st)
+{
+    uint32_t inputs[6] = {st->rc.final0 >> 24, st->rc.final0 >> 16, st->rc.final0 >> 8, st->rc.final0,
+                          st->rc.final1 >> 24, st->rc.final1 >> 16};
+    unsigned i;
+    for (i = 0; i < 6; ++i)
+        if ((inputs[i] & 0x0Fu) == 3u && !(inputs[i] & 0x10u)) return 1;
+    return 0;
+}
+
+static int native_fog_draw(const NvD3DState *st, const Surface *s)
+{
+    static int reported[3], reported_weight;
+    int kind = 0;
+    if (!st->fog_enable || !s || s != s_native_fog_seen.target) return 0;
+    if (!fog_colour_blended(st)) {
+        if (!reported_weight && s_native_fog_seen.passes) {
+            reported_weight = 1;
+            fprintf(stderr, "[FOG] title fog used as a blend weight left as is (final %08X %08X)\n",
+                    st->rc.final0, st->rc.final1);
+        }
+        return 0;
+    }
+    native_fog_frame();
+    if (s_native_fog_seen.passes < s_native_fog_seen.last_passes) kind = 1;
+    else if (s_native_fog_seen.passes) kind = 2;
+    if (kind && !reported[kind]) {
+        reported[kind] = 1;
+        fprintf(stderr, "[FOG] title per-draw fog %s the native pass (mode %04X, params %g %g, "
+                "native %.0f-%.0f m, final %08X %08X)\n", kind == 1 ? "before: left to" : "after: by view depth over the range of",
+                st->fog_mode, st->fog_param[0], st->fog_param[1], s_native_fog_seen.start, s_native_fog_seen.end,
+                st->rc.final0, st->rc.final1);
+    }
+    return kind;
+}
+
+/* A draw on the natively fogged target that reads the sky's fog ramp in a 2D
+ * stage (MM3's trees, Objects/Alpha.psh: fog colour lerped by the ramp)
+ * re-reads it at its own depth in the pixel shader (ps_flags 0x800). */
+static void sky_ramp_draw(const NvD3DState *st, const Surface *s, PSConsts *pc)
+{
+    static int reported;
+    uint32_t n, ramp;
+    if (!s || s != s_native_fog_seen.target || !sky_ramp_current() ||
+        !(s_native_fog_seen.depth_to_world > 0.0f) || !(s_native_fog_seen.end > s_native_fog_seen.start))
+        return;
+    ramp = phys(s_sky_ramp.tex.addr);
+    for (n = 0; n < 4; ++n)
+        if (((st->rc_seen ? st->rc.stage_program : (st->tex_used & 1)) >> (n * 5) & 31u) == 1u &&
+            st->tex[n].addr && !st->tex[n].cube && phys(st->tex[n].addr) == ramp)
+            break;
+    if (n == 4) return;
+    native_fog_frame();
+    pc->ps_flags |= 0x800u;
+    pc->sky_fog[0][0] = s_native_fog_seen.depth_to_world;
+    pc->sky_fog[0][1] = s_native_fog_seen.start;
+    pc->sky_fog[0][2] = 1.0f / (s_native_fog_seen.end - s_native_fog_seen.start);
+    pc->sky_fog[0][3] = s_sky_ramp.scale;
+    pc->sky_fog[1][0] = s_sky_ramp.knee;
+    pc->sky_fog[1][1] = (float)n;
+    pc->sky_fog[1][2] = s_native_fog_seen.passes < s_native_fog_seen.last_passes ? 0.0f : 1.0f;
+    pc->sky_fog[1][3] = ((st->surface_format >> 4) & 15u) == 1u ? 1.0f / 65536.0f : 1.0f / 16777216.0f;
+    if (!reported) {
+        reported = 1;
+        fprintf(stderr, "[FOG] a draw reads the sky fog ramp in stage %u (%s the native pass, final %08X %08X): "
+                "fogged by its own depth like the city\n", n, pc->sky_fog[1][2] > 0.5f ? "after" : "before",
+                st->rc.final0, st->rc.final1);
+    }
+}
