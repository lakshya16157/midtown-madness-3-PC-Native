+    CHECK(s_prof_program_reused==2);
+    /* Compare the entire file, including words outside either entrypoint. */
+    instructions[135][0]=0x12345678;program_version++;clear();triangle();
+    CHECK(draws==4 && maps_program==2 && pixel()==0xFFFF0000u);
+    CHECK(s_prof_program_uploads==2 && s_prof_program_reused==2);
+    puts("PASS: unchanged ISA/start-only version changes reuse the upload while distinct GPU entrypoints render red/green; any file byte forces upload");
+}
+
+static void test_program_reset(void)
+{
+    first_draw();
+    ID3D11Buffer *old=s_cb_prog;
+    s_cb_prog=make_buffer(NV_VSH_SLOTS*16,D3D11_BIND_CONSTANT_BUFFER);
+    CHECK(s_cb_prog && s_cb_prog!=old);
+    clear();fail_resource=(ID3D11Resource *)s_cb_prog;triangle();
+    CHECK(draws==1 && maps_program==2 && !fail_resource && pixel()==0xFF000000u);
+    CHECK(s_uploaded_program_buffer==old); /* Failed Map cannot certify new storage. */
+    triangle();CHECK(draws==2 && maps_program==3 && pixel()==0xFFFF0000u);
+    CHECK(s_uploaded_program_buffer==s_cb_prog);
+    ID3D11Buffer_Release(old);
+    /* Explicit reset must also work when the actual buffer identity is kept. */
+    invalidate_program_upload();
+    clear();fail_resource=(ID3D11Resource *)s_cb_prog;triangle();
+    CHECK(draws==2 && maps_program==4 && !s_uploaded_program_valid && pixel()==0xFF000000u);
+    triangle();CHECK(draws==3 && maps_program==5 && s_uploaded_program_valid && pixel()==0xFFFF0000u);
+    CHECK(!s_prof_program_uploads && !s_prof_program_reused); /* Profiling is off. */
+    puts("PASS: buffer identity and explicit reset force same-version upload; failed Maps retry before drawing and ordinary path adds no profile counters");
+}
+int main(int argc,char **argv)
+{
+    CHECK(argc==2);_putenv_s("RECOMP_PS_SPEC","0");_putenv_s("RECOMP_MSAA","1");
+    _putenv_s("RECOMP_RENDER_SCALE","1");_putenv_s("RECOMP_FPS_LIMIT","0");
+    program(0);constants[0][0]=constants[0][3]=1;constants[1][1]=constants[1][3]=1;
+    CHECK(nv2a_d3d_init());
+    if(!strcmp(argv[1],"version_zero")) test_version_zero();
+    else if(!strcmp(argv[1],"program")) test_program();
+    else if(!strcmp(argv[1],"constants")) test_constants();
+    else if(!strcmp(argv[1],"ub")) test_ub();
+    else if(!strcmp(argv[1],"rings")) test_rings();
+    else if(!strcmp(argv[1],"program_start")) test_program_start();
+    else if(!strcmp(argv[1],"program_reset")) test_program_reset();
+    else if(!strcmp(argv[1],"slow_off")) test_slow_upload(0);
+    else if(!strcmp(argv[1],"slow_on")) test_slow_upload(1);
+    else if(!strcmp(argv[1],"slow_csv")) test_slow_csv();
+    else CHECK(0);
+    return 0;
+}
