diff --git a/src/platform/qpc_clock.h b/src/platform/qpc_clock.h
new file mode 100644
index 0000000..e20e4d2
--- /dev/null
+++ b/src/platform/qpc_clock.h
@@ -0,0 +1,37 @@
+/* Integer QPC scaling without overflowing the counter * units intermediate. */
+#ifndef XBOX_QPC_CLOCK_H
+#define XBOX_QPC_CLOCK_H
+
+#include <stdint.h>
+#include <limits.h>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#endif
+
+static inline int64_t xbox_qpc_to_units(int64_t ticks, int64_t frequency,
+                                        uint32_t units_per_second)
+{
+    if (ticks < 0 || frequency <= 0 || !units_per_second) return 0;
+    uint64_t seconds = (uint64_t)ticks / (uint64_t)frequency;
+    uint64_t remainder = (uint64_t)ticks % (uint64_t)frequency;
+    if (seconds > (uint64_t)INT64_MAX / units_per_second) return INT64_MAX;
+    uint64_t fraction;
+    if (remainder <= UINT64_MAX / units_per_second) {
+        fraction = remainder * units_per_second / (uint64_t)frequency;
+    } else {
+        /* Unusually high counter frequencies still get exact integer time. */
+#if defined(_MSC_VER)
+        uint64_t high, ignored;
+        uint64_t low = _umul128(remainder, units_per_second, &high);
+        fraction = _udiv128(high, low, (uint64_t)frequency, &ignored);
+#else
+        fraction = (uint64_t)((unsigned __int128)remainder * units_per_second /
+                              (uint64_t)frequency);
+#endif
+    }
+    uint64_t whole = seconds * units_per_second;
+    return fraction > (uint64_t)INT64_MAX - whole ? INT64_MAX :
+           (int64_t)(whole + fraction);
+}
+
+#endif
