+    for (unsigned i = 0; i < 8; ++i)
+        if (pad_source(pad, map->pad[6 + i]) > 85) out->wButtons |= digital[i];
+    out->bAnalogButtons[XBOX_BUTTON_LTRIGGER] = pad_source(pad, map->pad[XB_PAD_LT]);
+    out->bAnalogButtons[XBOX_BUTTON_RTRIGGER] = pad_source(pad, map->pad[XB_PAD_RT]);
+    out->sThumbLX = pad->sThumbLX;
+    out->sThumbLY = pad->sThumbLY;
+    out->sThumbRX = pad->sThumbRX;
+    out->sThumbRY = pad->sThumbRY;
