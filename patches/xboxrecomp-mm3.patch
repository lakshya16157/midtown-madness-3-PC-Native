+    CHECK(CloseHandle(writer)); writer = INVALID_HANDLE_VALUE;
+    CHECK(open_asset("d:\\asset.bin", NULL, ACCESS, 0, OPTIONS, &h) == STATUS_SUCCESS && !read_contract(h, buffer, expected));
+    CHECK(xbox_NtClose(h) == STATUS_SUCCESS); h = NULL;
+    /* Retail WMA opens add FILE_SEQUENTIAL_ONLY (0x4) to the normal 0x48.
