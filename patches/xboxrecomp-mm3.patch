+    malformed=submitted_uv; malformed.size=2; assert(!world_name_vertex(&malformed,18));
+    malformed=submitted_uv; malformed.stride=32; assert(!world_name_vertex(&malformed,18));
+    malformed=submitted_uv; malformed.enabled=0; assert(!world_name_vertex(&malformed,18));
+    malformed=submitted_uv; malformed.data=NULL; assert(!world_name_vertex(&malformed,18));
