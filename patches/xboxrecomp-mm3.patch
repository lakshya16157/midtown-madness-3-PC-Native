+static int test_poll_cadence(void)
+{
+    Surface *s = new_surface(0, 4, 16, 16, 16);
+    unsigned i;
+    BOOL done = FALSE;
+    ULONGLONG deadline;
+    CHECK(s); draw_color(s, 0);
+    inspect = mock_clock = 1; reset_counts();
+    writeback_surfaces(); CHECK(s_wb_poll_ticks == 250 && flushes == 1);
+    hold_query = 1;
+    CHECK(nv2a_d3d_writeback_busy() && queries == 1);
+    for (i = 0; i < 64; ++i) CHECK(nv2a_d3d_writeback_busy());
+    clock_ticks += 249;
+    CHECK(nv2a_d3d_writeback_busy() && queries == 1);
+    CHECK(!maps && flushes == 1 && s_wb_pending && s_wb_mask == 1);
+    CHECK(*(uint32_t *)(ram + s->va) == 0x55555555u);
+    ++clock_ticks;
+    CHECK(nv2a_d3d_writeback_busy() && queries == 2);
+    hold_query = 0;
+    /* Real GPU readiness must not permit a premature guest completion during
+     * the cadence window. This direct wait is outside the production poll. */
+    deadline = GetTickCount64() + 5000;
+    while (s_ctx->lpVtbl->GetData(s_ctx, (ID3D11Asynchronous *)s_wb_event,
+                                 &done, sizeof done, D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK || !done) {
+        CHECK(GetTickCount64() < deadline); Sleep(0);
+    }
+    CHECK(nv2a_d3d_writeback_busy() && queries == 2 && !maps);
+    clock_ticks += 250;
+    CHECK(!nv2a_d3d_writeback_busy() && queries == 3 && maps == 1);
+    CHECK(!s_wb_pending && !s_wb_mask && !s_wb_event_pending && flushes == 1 && !bad_flags);
+    CHECK(!pixels_match(s, 0, 0));
+    puts("PASS: deferred readiness makes no query/Map/Flush or guest completion before deadline; due query copies exact real GPU pixels");
+    return 0;
+}
