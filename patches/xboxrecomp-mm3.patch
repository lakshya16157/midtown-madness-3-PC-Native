+            check_map_position(captured[i],(p[i][0]-50)*narrow,480+(p[i][1]-448)*ynarrow);
+        map_improved = 1; map_centered = 1; reset_map_placement();
+        capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_BASE_TEXTURE,0,0,0,captured);
+        for (i = 0; i < 4; ++i)
+            check_map_position(captured[i],320+(p[i][0]-320)*narrow,240+(p[i][1]-240)*ynarrow);
+        CHECK(!s_frame_map_valid);
+
+        /* The native Ctrl transition changes the same live map from its
+         * driving camera to a flat overview. Roads and every checkpoint
+         * corner share one camera even if another update is already queued. */
+        {
+            unsigned phase,corner;
+            map_centered=0;
+            for (phase=0;phase<3;++phase) {
+                unsigned expansion_byte=(unsigned)((float)phase*.5f*255+.5f);
+                float e=(float)expansion_byte/255, left=50+78*e, top=320-272*e, extent=128+256*e;
+                float cx=left+extent*.5f, cy=top+extent*.5f;
+                unsigned motion_before=map_motion_calls, expansion_before=map_expansion_calls;
+                reset_map_placement(); map_motion=0; map_expansion=1-e;
+                map_camera_tag=1; map_camera_motion_byte=255; map_camera_expansion_byte=expansion_byte;
+                map_quad(p,left,left+extent,top,top+extent);
+                capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_BASE_TEXTURE,0,0,-1,captured);
+                CHECK(map_motion_calls==motion_before && map_expansion_calls==expansion_before);
+                map_camera_motion_byte=0; map_camera_expansion_byte=255-expansion_byte;
+                capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_BASE_TEXTURE,0,0,-1,captured);
+                CHECK(map_motion_calls==motion_before && map_expansion_calls==expansion_before);
+                CHECK(s_frame_map_motion==1 && s_frame_map_expansion==e);
+                capture_map(geometry,output,&target,(const float (*)[4])p,4,0,0,4,1,captured);
+                if (e==1) for (i=0;i<4;++i) {
+                    check_map_position(captured[i],320+(p[i][0]-320)*narrow,240+(p[i][1]-240)*ynarrow);
+                    CHECK(fabs(captured[i][0])<=1 && fabs(captured[i][1])<=1);
+                }
+                for (corner=0;corner<4;++corner) {
+                    float x=left+(corner&1?extent-8:8), y=top+(corner&2?extent-8:8);
+                    map_quad(p,x-4,x+4,y-4,y+4);
+                    capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_MARKER_TEXTURE,0,0,1,captured);
+                    memcpy(marker,captured,sizeof marker);
+                    capture_map(geometry,output,&target,(const float (*)[4])p,4,0,0,4,1,captured);
+                    for (i=0;i<4;++i) {
+                        double half=extent*.5, depth=(p[i][1]-cy)/half, denominator=1-.22*depth;
+                        double px=cx+(p[i][0]-cx)*.78/denominator;
+                        double py=cy+half*.60+(p[i][1]-cy)*1.15/denominator;
+                        double crop=half*2.20*(1-.78/(1-.22*(.40/(1.15+.22*.40))));
+                        double driving_x=((px-left)*2.20-crop)*narrow;
+                        double driving_y=480+(py-top-extent)*2.20*ynarrow;
+                        double flat_x=320+(p[i][0]-320)*narrow;
+                        double flat_y=240+(p[i][1]-240)*ynarrow;
+                        check_map_position(marker[i],driving_x*(1-e)+flat_x*e,driving_y*(1-e)+flat_y*e);
+                        CHECK(fabs(marker[i][0]-captured[i][0])<2e-6);
+                        CHECK(fabs(marker[i][1]-captured[i][1])<2e-6);
+                        if (e==1) CHECK(fabs(marker[i][0])<=1 && fabs(marker[i][1])<=1);
+                    }
+                }
+            }
+            map_camera_tag=0;
+        }
+
+        /* Native city clipping emits up to nine independent pieces. Pack
+         * both coordinates and UVs with retail constants, and recover the
+         * normal and expanded whole-window anchor from each queued piece. */
+        {
+            unsigned size,row,col;
+            map_centered=0; map_fragment_mask=1;
+            for (size=0;size<2;++size) {
+                float left=size?128:50, top=size?48:320, extent=size?384:128;
+                map_motion=0; map_expansion=(float)size;
+                reset_map_placement();
+                map_mask_bounds[0]=left; map_mask_bounds[1]=top;
+                map_mask_bounds[2]=map_mask_bounds[3]=extent;
+                for (row=0;row<3;++row) for (col=0;col<3;++col) {
+                    map_quad(p,left+extent*col/3,left+extent*(col+1)/3,
+                             top+extent*row/3,top+extent*(row+1)/3);
+                    capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_BASE_TEXTURE,0,0,-1,captured);
+                    CHECK(s_frame_map_valid);
+                    CHECK(fabs(s_frame_map_cx-left-extent*.5f)<.25);
+                    CHECK(fabs(s_frame_map_cy-top-extent*.5f)<.25);
+                }
+                /* The small camera retains its visible bottom-left crop;
+                 * the expanded overview retains the complete flat window. */
+                {
+                    float d=.4f/(1.15f+.22f*.4f);
+                    float x=s_frame_map_cx-s_frame_map_half_width;
+                    float y=s_frame_map_cy+d*s_frame_map_half_height;
+                    map_quad(p,x,x+.125f,y,y+.125f);
+                    capture_map(geometry,output,&target,(const float (*)[4])p,4,0,0,4,1,captured);
+                    if (!size) check_map_position(captured[0],0,480);
+                    else check_map_position(captured[0],320+(x-320)*narrow,240+(y-240)*ynarrow);
+                }
+                map_quad(p,left,left+.5f,top,top+.5f);
+                {
+                    float cx=s_frame_map_cx,cy=s_frame_map_cy;
+                    capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_BASE_TEXTURE,0,0,-1,captured);
+                    CHECK(s_frame_map_cx==cx && s_frame_map_cy==cy);
+                }
+                map_quad(p,s_frame_map_cx-4,s_frame_map_cx+4,s_frame_map_cy-4,s_frame_map_cy+4);
+                capture_map(geometry,output,&target,(const float (*)[4])p,4,MAP_MARKER_TEXTURE,0,0,1,captured);
+                memcpy(marker,captured,sizeof marker);
+                capture_map(geometry,output,&target,(const float (*)[4])p,4,0,0,4,1,captured);
+                for (i=0;i<4;++i) {
+                    CHECK(fabs(marker[i][0]-captured[i][0])<2e-6);
+                    CHECK(fabs(marker[i][1]-captured[i][1])<2e-6);
+                    CHECK(captured[i][2]==0 && captured[i][3]==1);
+                }
+            }
+            map_fragment_mask=0;
+        }
+    }
+    map_improved = map_centered = 0;
+    nv2a_d3d_set_edge_hud(0); nv2a_d3d_set_map_texture_query(NULL);
+    nv2a_d3d_set_centered_ui_query(NULL); nv2a_d3d_set_minimap_style_query(NULL);
+    nv2a_d3d_set_minimap_motion_query(NULL); nv2a_d3d_set_minimap_expansion_query(NULL);
+    ID3D11Buffer_Release(output); ID3D11GeometryShader_Release(geometry);
+    puts("PASS: actual GPU improved map preserves the driving camera, opens a flat overview with all checkpoint corners visible, latches transition cameras for roads/icons/routes, isolates mixed dimmers and restores Stock/pause at five aspects");
+}
