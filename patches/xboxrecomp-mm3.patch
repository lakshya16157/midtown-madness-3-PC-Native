+    uint32_t mac_mask = field(ins, 3, 24, 4), ilu_mask = field(ins, 3, 16, 4);
+    uint32_t tdst = field(ins, 3, 20, 4);
+    uint32_t omask = field(ins, 3, 12, 4), oaddr = field(ins, 3, 3, 8);
