+static void map_quad(float (*vertices)[4], float left, float right, float top, float bottom)
+{
+    float quad[4][4] = {{left,top,0,1},{right,top,0,1},{right,bottom,0,1},{left,bottom,0,1}};
+    memcpy(vertices,quad,sizeof quad);
+}
