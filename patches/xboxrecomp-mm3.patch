+        near(r.x[0], 0); near(r.x[1], 640);
+        near(r.y[0], 0); near(r.y[2], 480);
+        for (i = 4; i < 8; ++i) {
+            near(r.x[i], base.x[0] + (p[i][0] - base_x) * narrow);
+            near(r.y[i], p[i][1] + base.y_offset);
+        }
+        assert(!s_frame_bg_tex && nv2a_d3d_hud_active());
+    }
+    memset(&submitted_uv, 0, sizeof submitted_uv);
+}
+static void tag_upload(void) {
