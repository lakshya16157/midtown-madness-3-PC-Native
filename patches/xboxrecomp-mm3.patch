+++ b/tests/kernel_dispatch/kernel_file_hitch_test.c
@@ -0,0 +1,239 @@
+/* Compile the real file implementation with a deterministic measurement clock.
+ * Native disk reads and native mode queries remain real. Context/output hooks
+ * add 300 ms after each slow read, which must never inflate its duration. */
+#include "kernel.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+
+static XBOX_THREAD_LOCAL int64_t test_now, read_duration;
+static XBOX_THREAD_LOCAL unsigned clock_calls, context_calls, cycle_calls;
+static XBOX_THREAD_LOCAL DWORD read_error;
+static XBOX_THREAD_LOCAL DWORD read_incoming_error;
+static XBOX_THREAD_LOCAL int read_errno, read_incoming_errno;
+static char output[32768];
+static size_t output_used;
+
+static BOOL WINAPI test_qpc(LARGE_INTEGER *value)
+{
+    ++clock_calls;
+    value->QuadPart = test_now;
+    errno = ERANGE;
+    SetLastError(0xAADD);
+    return TRUE;
+}
+static BOOL WINAPI test_frequency(LARGE_INTEGER *value)
+{
+    value->QuadPart = 1000000;
+    errno = ERANGE;
+    SetLastError(0xAAEE);
+    return TRUE;
+}
+static BOOL WINAPI test_cycles(HANDLE thread, PULONG64 cycles)
+{
+    (void)thread;
+    *cycles = 1000u + cycle_calls * 250u;
+    ++cycle_calls;
+    test_now += 10;
+    errno = ERANGE;
+    SetLastError(0xAAFF);
+    return TRUE;
+}
+static BOOL WINAPI test_read(HANDLE handle, LPVOID buffer, DWORD length,
+    LPDWORD bytes, LPOVERLAPPED overlapped)
+{
+    read_incoming_error = GetLastError();
+    read_incoming_errno = errno;
+    BOOL result = ReadFile(handle, buffer, length, bytes, overlapped);
+    read_error = GetLastError();
+    read_errno = errno;
+    test_now += read_duration;
+    return result;
+}
+static DWORD WINAPI test_path(HANDLE handle, LPWSTR path, DWORD capacity, DWORD flags)
+{
+    DWORD result = GetFinalPathNameByHandleW(handle, path, capacity, flags);
+    ++context_calls;
+    test_now += 200000;
+    SetLastError(0xAABB);
+    errno = ERANGE;
+    return result;
+}
+static int test_print(FILE *stream, const char *format, ...)
+{
+    va_list arguments;
+    int written;
+    (void)stream;
+    va_start(arguments, format);
+    written = vsnprintf(output + output_used, sizeof output - output_used, format, arguments);
+    va_end(arguments);
+    if (written < 0 || (size_t)written >= sizeof output - output_used) abort();
+    output_used += (size_t)written;
+    test_now += 100000;
+    SetLastError(0xCCDD);
+    errno = ERANGE;
+    return written;
+}
+
+#define QueryPerformanceCounter test_qpc
+#define QueryPerformanceFrequency test_frequency
+#define QueryThreadCycleTime test_cycles
+#define ReadFile test_read
+#define GetFinalPathNameByHandleW test_path
+#define fprintf test_print
+#include "../../src/kernel/kernel_file.c"
+#undef QueryPerformanceCounter
+#undef QueryPerformanceFrequency
+#undef QueryThreadCycleTime
+#undef ReadFile
+#undef GetFinalPathNameByHandleW
+#undef fprintf
+
+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n%s", __LINE__, #x, output); goto done; } } while (0)
+
+typedef struct WorkerRead {
+    HANDLE handle;
+    int enabled;
+} WorkerRead;
+
+static DWORD WINAPI worker_read(void *parameter)
+{
+    WorkerRead *worker = parameter;
+    XBOX_FILE_READ_STATS before, after;
+    XBOX_IO_STATUS_BLOCK ios;
+    LARGE_INTEGER offset = {0};
+    unsigned char bytes[4096];
+    xbox_GetFileReadStats(&before);
+    if (before.read_count || before.read_qpc_ticks || before.qpc_frequency) return 1;
+    test_now = 5000000; read_duration = 2000;
+    if (xbox_NtReadFile(worker->handle, NULL, NULL, NULL, &ios, bytes, sizeof bytes, &offset) != STATUS_SUCCESS ||
+        ios.Information != sizeof bytes || bytes[0] != 0x5A) return 2;
+    xbox_GetFileReadStats(&after);
+    return after.read_count == (worker->enabled ? 1u : 0u) &&
+        after.read_qpc_ticks == (worker->enabled ? 2000u : 0u) &&
+        after.qpc_frequency == (worker->enabled ? 1000000u : 0u) ? 0 : 3;
+}
+
+int main(int argc, char **argv)
+{
+    WCHAR base[MAX_PATH], path[MAX_PATH] = {0};
+    HANDLE writer = INVALID_HANDLE_VALUE, cached = INVALID_HANDLE_VALUE, direct = INVALID_HANDLE_VALUE;
+    unsigned char *buffer = NULL;
+    DWORD written;
+    XBOX_IO_STATUS_BLOCK ios;
+    XBOX_FILE_READ_STATS before, after;
+    HANDLE workers[2] = {0};
+    LARGE_INTEGER offset = {0};
+    int enabled = argc > 1 && strcmp(argv[1], "off"), cpu = argc > 1 && !strcmp(argv[1], "cpu");
+    int result = 1;
+    xbox_GetFileReadStats(&before);
+    CHECK(!before.read_count && !before.read_qpc_ticks && !before.qpc_frequency);
+    xbox_GetFileReadStats(NULL);
+    CHECK(_putenv_s("RECOMP_HITCH_TRACE", enabled ? "1" : "0") == 0);
+    CHECK(_putenv_s("RECOMP_FILE_READ_CPU_TRACE", cpu ? "1" : "0") == 0);
+    CHECK(GetTempPathW(MAX_PATH, base) && GetTempFileNameW(base, L"xfh", 0, path));
+    buffer = VirtualAlloc(NULL, 4096, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE); CHECK(buffer);
+    memset(buffer, 0x5A, 4096);
+    writer = CreateFileW(path, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+    CHECK(writer != INVALID_HANDLE_VALUE && WriteFile(writer, buffer, 4096, &written, NULL) && written == 4096);
+    CHECK(CloseHandle(writer)); writer = INVALID_HANDLE_VALUE;
+    cached = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    direct = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_NO_BUFFERING, NULL);
+    CHECK(cached != INVALID_HANDLE_VALUE && direct != INVALID_HANDLE_VALUE);
+    /* Ordinary reads perform no path/mode/output work; CPU APIs are opt-in. */
+    test_now = 1000000; read_duration = 1500;
+    errno = EBUSY; SetLastError(0x7788);
+    CHECK(xbox_NtReadFile(cached, NULL, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_SUCCESS);
+    CHECK(read_incoming_errno == EBUSY && read_incoming_error == 0x7788);
+    CHECK(ios.Information == 4096 && buffer[0] == 0x5A && GetLastError() == read_error && errno == read_errno);
+    CHECK(clock_calls == (enabled ? 2u : 0u) && !context_calls && !output_used);
+    CHECK(cycle_calls == (cpu ? 2u : 0u));
+    /* Same 12.5 ms read, real cached and direct handles. Synthetic context
+     * and sink add 300 ms, plus 20 us CPU sampling when explicitly enabled. */
+    test_now = 2000000; read_duration = 12500;
+    errno = EDOM; SetLastError(0x8899);
+    CHECK(xbox_NtReadFile(cached, NULL, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_SUCCESS);
+    CHECK(read_incoming_errno == EDOM && read_incoming_error == 0x8899);
+    CHECK(GetLastError() == read_error && errno == read_errno && ios.Status == STATUS_SUCCESS && ios.Information == 4096);
+    test_now = 3000000;
+    CHECK(xbox_NtReadFile(direct, NULL, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_SUCCESS);
+    CHECK(GetLastError() == read_error && errno == read_errno && ios.Information == 4096);
+    if (enabled) {
+        CHECK(context_calls == 2 && clock_calls == 6);
+        CHECK(strstr(output, "duration_ms=12.500") && !strstr(output, "duration_ms=312.500"));
+        CHECK(strstr(output, "buffering=cached") && strstr(output, "buffering=unbuffered"));
+        CHECK(strstr(output, "mode_status=0x00000000") && strstr(output, "path=\"\\\\?\\"));
+        CHECK(strstr(output, cpu ? "cpu_cycles=250 cpu_cycles_valid=1" : "cpu_cycles=0 cpu_cycles_valid=0"));
+        CHECK(cycle_calls == (cpu ? 6u : 0u));
+    } else CHECK(!context_calls && !clock_calls && !cycle_calls && !output_used);
+    /* Failed reads keep real native failure status/count/error, even when
+     * context is unavailable and diagnostics overwrite host LastError. */
+    test_now = 4000000;
+    CHECK(xbox_NtReadFile(INVALID_HANDLE_VALUE, NULL, NULL, NULL, &ios, buffer, 4096, &offset) == STATUS_UNSUCCESSFUL);
+    CHECK(ios.Status == STATUS_UNSUCCESSFUL && !ios.Information && GetLastError() == ERROR_INVALID_HANDLE);
+    if (enabled) CHECK(strstr(output, "buffering=unknown") && strstr(output, "path=\"<unavailable>\""));
+    xbox_GetFileReadStats(&after);
+    CHECK(after.read_count == (enabled ? 4u : 0u));
+    CHECK(after.read_qpc_ticks == (enabled ? 39000u : 0u));
+    CHECK(after.qpc_frequency == (enabled ? 1000000u : 0u));
+    before = after;
+    WorkerRead worker = {cached, enabled};
+    for (unsigned i = 0; i < 2; ++i) {
+        workers[i] = CreateThread(NULL, 0, worker_read, &worker, 0, NULL);
+        CHECK(workers[i]);
+    }
+    CHECK(WaitForMultipleObjects(2, workers, TRUE, 5000) == WAIT_OBJECT_0);
+    for (unsigned i = 0; i < 2; ++i) {
+        DWORD code = 1;
+        CHECK(GetExitCodeThread(workers[i], &code) && !code);
+        CHECK(CloseHandle(workers[i])); workers[i] = NULL;
+    }
+    xbox_GetFileReadStats(&after);
+    CHECK(!memcmp(&before, &after, sizeof before));
+    /* A successful-open diagnostic must expose the actual excluded guest
+     * spelling/flags, remain bounded, and survive a sink clobbering host state. */
+    CHECK(_putenv_s("RECOMP_BUFFERED_ASSET_READS", "1") == 0);
+    InitOnceExecuteOnce(&s_asset_buffering_once,
+        file_asset_buffering_initialize, NULL, NULL);
+    output_used = 0; output[0] = 0;
+    XBOX_ANSI_STRING audio_name = {0};
+    XBOX_OBJECT_ATTRIBUTES audio_attributes = {0};
+    audio_name.Buffer = "\\??\\D:\\Data\\Shared\\Audio\\Music\\probe.WMA";
+    audio_attributes.ObjectName = &audio_name;
+    file_asset_buffering_audio_diagnostic(&audio_attributes,
+        0x80100080u, 1, 1, 0x48, 1);
+    audio_name.Buffer = "d:\\asset.bin";
+    file_asset_buffering_audio_diagnostic(&audio_attributes,
+        0x80100080u, 1, 1, 0x48, 0);
+    CHECK(!output_used);
+    audio_name.Buffer = "\\??\\D:\\Data\\Shared\\Audio\\Music\\probe.WMA";
+    for (unsigned i = 0; i < 12; ++i) {
+        errno = EDOM; SetLastError(0x9876);
+        CHECK(!file_asset_buffering(&audio_attributes, 0x80100080u, 1, 1, 0x48));
+        CHECK(errno == EDOM && GetLastError() == 0x9876);
+    }
+    if (enabled) {
+        unsigned lines = 0;
+        const char *record = output;
+        while ((record = strstr(record, "[FILE_CACHE] unbuffered_audio_asset"))) {
+            ++lines; ++record;
+        }
+        CHECK(lines == 8);
+        CHECK(strstr(output, "guest_path=\"\\??\\D:\\Data\\Shared\\Audio\\Music\\probe.WMA\""));
+        CHECK(strstr(output, "relative=0 access=0x80100080 share=0x1 disposition=0x1 options=0x48 policy_enabled=1 eligible=0"));
+    } else CHECK(!output_used);
+    puts("PASS: real file hitch context, native caching modes, opt-in CPU cycles, error preservation and context/sink exclusion");
+    result = 0;
+done:
+    for (unsigned i = 0; i < 2; ++i) if (workers[i]) { WaitForSingleObject(workers[i], 5000); CloseHandle(workers[i]); }
+    if (writer != INVALID_HANDLE_VALUE) CloseHandle(writer);
+    if (cached != INVALID_HANDLE_VALUE) CloseHandle(cached);
+    if (direct != INVALID_HANDLE_VALUE) CloseHandle(direct);
+    if (buffer) VirtualFree(buffer, 0, MEM_RELEASE);
+    if (*path) DeleteFileW(path);
+    return result;
+}
