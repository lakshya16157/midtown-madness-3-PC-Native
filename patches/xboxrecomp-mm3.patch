+/* One line, at most every 5 s and 24 per run, when the producer has little
+ * slack left or falls behind real time (a VP frame is 32 samples: 1500 per
+ * second). Many positional voices -- sirens, engines, impacts -- are what
+ * pushes it there, and an output that is starved sounds like missing audio. */
+static void apu_report_load(float utilization, int frames_per_second)
+{
+    static unsigned lines;
+    static int64_t last_ms;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+
+    if (lines >= 24 || now - last_ms < 5000)
+        return;
+    /* Report a measured processing shortfall; normal throttled playback
+     * can spend most of its time waiting for the next audio deadline. */
+    if (!(frames_per_second >= 100 && frames_per_second < 1450))
+        return;
+    last_ms = now;
+    lines++;
+    fprintf(stderr, "[APU] load: producer %.0f%% busy, %d VP frames/s (real time is 1500),"
+            " voices active %d idle %d\n",
+            utilization * 100.0f, frames_per_second,
+            g_apu_vp_active_voices, g_apu_vp_idle_voices);
+    fflush(stderr);
