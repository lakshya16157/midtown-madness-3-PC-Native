+     * then on, at most every 2 s and up to 16 (85 ms), so a slower PC settles
+     * at the cushion it needs instead of gapping on every hiccup. A target
+     * set explicitly stays as set. */
+    if (!fixed && target > 0 && target < 16 && xa2_dry_total() != dry_seen) {
+        int64_t now_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
