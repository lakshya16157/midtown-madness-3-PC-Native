+/* MM3_LIGHT_DUMP=<directory>: while the title's local-light composite draws
+ * (night races), save what it works from a few seconds apart -- the unlit
+ * frame (RGB, and its alpha, which codes the material), the light buffer and
+ * the raw scene depth the light volumes read -- as PPM/PGM files. Nothing is
+ * written, and nothing here runs, unless the variable is set. */
+static Depth *s_light_depth;        /* last depth buffer a LightDraw read raw */
+
+static void light_dump_write(const char *path, const char *magic, unsigned w, unsigned h,
+                             unsigned maxval, const uint8_t *data, size_t bytes)
+{
+    FILE *f = fopen(path, "wb");
+    if (!f) return;
+    fprintf(f, "%s\n%u %u\n%u\n", magic, w, h, maxval);
+    fwrite(data, 1, bytes, f);
+    fclose(f);
+}
+
+static void light_dump_texture(const char *dir, unsigned serial, const char *tag,
+                               ID3D11Texture2D *tex)
+{
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *staging = NULL;
+    D3D11_MAPPED_SUBRESOURCE map;
+    char path[1024];
+    unsigned x, y;
+    if (!tex) return;
+    ID3D11Texture2D_GetDesc(tex, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging))) return;
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)tex);
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0,
+                                          D3D11_MAP_READ, 0, &map))) {
+        if (desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM || desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM) {
+            int bgr = desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM;
+            uint8_t *rgb = (uint8_t *)malloc((size_t)desc.Width * desc.Height * 3);
+            uint8_t *alpha = (uint8_t *)malloc((size_t)desc.Width * desc.Height);
+            if (rgb && alpha) {
+                for (y = 0; y < desc.Height; y++) {
+                    const uint8_t *src = (const uint8_t *)map.pData + (size_t)y * map.RowPitch;
+                    for (x = 0; x < desc.Width; x++) {
+                        size_t i = (size_t)y * desc.Width + x;
+                        rgb[i * 3] = src[x * 4 + (bgr ? 2 : 0)];
+                        rgb[i * 3 + 1] = src[x * 4 + 1];
+                        rgb[i * 3 + 2] = src[x * 4 + (bgr ? 0 : 2)];
+                        alpha[i] = src[x * 4 + 3];
+                    }
+                }
+                snprintf(path, sizeof path, "%s/dump%02u-%s.ppm", dir, serial, tag);
+                light_dump_write(path, "P6", desc.Width, desc.Height, 255, rgb,
+                                 (size_t)desc.Width * desc.Height * 3);
+                snprintf(path, sizeof path, "%s/dump%02u-%s-alpha.pgm", dir, serial, tag);
+                light_dump_write(path, "P5", desc.Width, desc.Height, 255, alpha,
+                                 (size_t)desc.Width * desc.Height);
+            }
+            free(rgb); free(alpha);
+        } else if (desc.Format == DXGI_FORMAT_R16G16B16A16_UNORM) {
+            /* 16-bit PGM is big-endian: the first channel of each texel. */
+            uint8_t *gray = (uint8_t *)malloc((size_t)desc.Width * desc.Height * 2);
+            if (gray) {
+                for (y = 0; y < desc.Height; y++) {
+                    const uint16_t *src = (const uint16_t *)((const uint8_t *)map.pData +
+                                                             (size_t)y * map.RowPitch);
+                    for (x = 0; x < desc.Width; x++) {
+                        size_t i = ((size_t)y * desc.Width + x) * 2;
+                        gray[i] = (uint8_t)(src[x * 4] >> 8);
+                        gray[i + 1] = (uint8_t)(src[x * 4] & 255);
+                    }
+                }
+                snprintf(path, sizeof path, "%s/dump%02u-%s.pgm", dir, serial, tag);
+                light_dump_write(path, "P5", desc.Width, desc.Height, 65535, gray,
+                                 (size_t)desc.Width * desc.Height * 2);
+            }
+            free(gray);
+        } else {
+            fprintf(stderr, "[D3D11_LIGHT] dump: %s has format %u, skipped\n", tag, (unsigned)desc.Format);
+        }
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+    }
+    ID3D11Texture2D_Release(staging);
+}
