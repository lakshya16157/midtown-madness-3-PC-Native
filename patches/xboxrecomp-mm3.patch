diff --git a/src/kernel/kernel_file_buffering.h b/src/kernel/kernel_file_buffering.h
new file mode 100644
index 0000000..297af92
--- /dev/null
+++ b/src/kernel/kernel_file_buffering.h
@@ -0,0 +1,61 @@
+#ifndef XBOX_KERNEL_FILE_BUFFERING_H
+#define XBOX_KERNEL_FILE_BUFFERING_H
+#include <stddef.h>
+#include <string.h>
+
+static inline int xbox_file_device_component(const char *component, size_t length)
+{
+    char stem[8] = {0};
+    size_t i = 0;
+    while (i < length && component[i] != '.' && i < sizeof stem - 1) {
+        char c = component[i];
+        stem[i++] = c >= 'a' && c <= 'z' ? (char)(c - 'a' + 'A') : c;
+    }
+    if (i == sizeof stem - 1 && i < length && component[i] != '.') return 0;
+    return !strcmp(stem, "CON") || !strcmp(stem, "PRN") ||
+        !strcmp(stem, "AUX") || !strcmp(stem, "NUL") ||
+        !strcmp(stem, "CONIN$") || !strcmp(stem, "CONOUT$") ||
+        !strcmp(stem, "CLOCK$") ||
+        (i == 4 && (!memcmp(stem, "COM", 3) || !memcmp(stem, "LPT", 3)) &&
+            stem[3] >= '1' && stem[3] <= '9');
+}
+
+/* Host caching is an optional optimization for immutable title assets only.
+ * Keep the guest's original access, disposition and share contract. In
+ * particular, denying write/delete sharing also rejects an existing writer. */
+static inline int xbox_file_buffered_asset(const char *path, int relative,
+    ULONG access, ULONG share, ULONG disposition, ULONG options)
+{
+    const ULONG read_access = XBOX_GENERIC_READ | XBOX_FILE_READ_DATA |
+        0x0008u /* FILE_READ_EA */ | XBOX_FILE_READ_ATTRIBUTES |
+        0x00020000u /* READ_CONTROL */ | XBOX_SYNCHRONIZE;
+    const ULONG safe_options = XBOX_FILE_NO_INTERMEDIATE_BUFFERING |
+        XBOX_FILE_SYNCHRONOUS_IO_ALERT | XBOX_FILE_SYNCHRONOUS_IO_NONALERT |
+        XBOX_FILE_NON_DIRECTORY_FILE | 0x00000004u /* FILE_SEQUENTIAL_ONLY: read hint */;
+    const char *component;
+    if (!path || relative ||
+        !((path[0] == 'd' || path[0] == 'D' || path[0] == 'z' || path[0] == 'Z') &&
+          path[1] == ':' && (path[2] == '\\' || path[2] == '/')) ||
+        !path[3] || disposition != XBOX_FILE_OPEN ||
+        !(access & (XBOX_GENERIC_READ | XBOX_FILE_READ_DATA)) ||
+        (access & ~read_access) || (share & ~1u) ||
+        !(options & XBOX_FILE_NON_DIRECTORY_FILE) ||
+        !(options & XBOX_FILE_NO_INTERMEDIATE_BUFFERING) ||
+        (options & ~safe_options)) return 0;
+    component = path + 3;
+    for (const char *p = component;; ++p) {
+        /* Ordinary ASCII asset names only. Exclude alternate streams,
+         * wildcard/device spellings and locale-dependent DOS aliases. */
+        if (*p && ((unsigned char)*p < 32 || (unsigned char)*p > 126 ||
+            strchr(":<>\"|?*", *p))) return 0;
+        if (!*p || *p == '\\' || *p == '/') {
+            size_t length = (size_t)(p - component);
+            if (!length || component[length - 1] == '.' ||
+                component[length - 1] == ' ' ||
+                xbox_file_device_component(component, length)) return 0;
+            if (!*p) return 1;
+            component = p + 1;
+        }
+    }
+}
+#endif
diff --git a/src/kernel/kernel_file_probe.h b/src/kernel/kernel_file_probe.h
new file mode 100644
index 0000000..28e6302
--- /dev/null
+++ b/src/kernel/kernel_file_probe.h
@@ -0,0 +1,48 @@
+/* Recognize loose asset search candidates, never required archives or writes. */
+#ifndef XBOX_KERNEL_FILE_PROBE_H
+#define XBOX_KERNEL_FILE_PROBE_H
+#include <wchar.h>
+
+static const wchar_t *xbox_file_probe_asset(const wchar_t *path, unsigned long access,
+                                           unsigned long disposition, unsigned long options)
+{
+    static const wchar_t *extensions[] = {
+        L".cmp", L".omb", L".cdds", L".ccol", L".mcs", L".dps", L".txt"
+    };
+    const wchar_t *cursor, *extension;
+    unsigned i;
+    const wchar_t *asset = NULL;
+    /* OPEN_EXISTING, read only, and a regular file. A missing output or
+     * directory, access denial or sharing conflict always remains an error. */
+    if (!path || disposition != 1 || (options & 1) ||
+        (access & (0x40000000ul | 0x10000000ul | 0x00000002ul |
+                   0x00000004ul | 0x00000010ul | 0x00000100ul |
+                   0x00010000ul | 0x00040000ul | 0x00080000ul))) return 0;
+    for (cursor = path; *cursor; ++cursor) {
+        if (cursor != path && cursor[-1] != L'\\' && cursor[-1] != L'/') continue;
+        if (!_wcsnicmp(cursor, L"Data\\Shared\\", 12) ||
+            !_wcsnicmp(cursor, L"Data/Shared/", 12)) asset = cursor + 12;
+        else if (!_wcsnicmp(cursor, L"Data\\XBox\\", 10) ||
+                 !_wcsnicmp(cursor, L"Data/XBox/", 10)) asset = cursor + 10;
+        else if (!_wcsnicmp(cursor, L"TDATA\\4d53002a\\$C\\", 18) ||
+                 !_wcsnicmp(cursor, L"TDATA/4d53002a/$C/", 18)) {
+            asset = cursor + 18;
+            while (*asset && *asset != L'\\' && *asset != L'/') ++asset;
+            if (*asset) ++asset; /* Skip the DLC package directory. */
+        }
+        if (asset) break;
+    }
+    if (!asset || !*asset) return NULL;
+    extension = wcsrchr(path, L'.');
+    if (!extension) return 0;
+    for (i = 0; i < sizeof extensions / sizeof extensions[0]; ++i)
+        if (!_wcsicmp(extension, extensions[i])) return asset;
+    return NULL;
+}
+
+static int xbox_file_probe_path(const wchar_t *path, unsigned long access,
+                                unsigned long disposition, unsigned long options)
+{
+    return xbox_file_probe_asset(path, access, disposition, options) != NULL;
+}
+#endif
