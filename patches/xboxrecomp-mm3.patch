+# Native Ethernet regression tests
+
+Run from a Windows developer shell:
+
+```powershell
+cmake -S tools/xboxrecomp/tests/net -B $env:TEMP/mm3-net-tests -G Ninja -DCMAKE_BUILD_TYPE=Release
+cmake --build $env:TEMP/mm3-net-tests
+ctest --test-dir $env:TEMP/mm3-net-tests --output-on-failure
+```
+
+These tests use production network and crypto sources. They exercise local
+Winsock DHCP/ARP/UDP NAT and Ethernet peer traffic, bounded queues, strict
+configuration and bind failures, idle CPU use, repeated startup/shutdown and
+handle cleanup, MMIO widths, invalid descriptor/DMA ranges, console identity,
+and DES/3DES/modular exponentiation against independent known answers,
+Windows BCrypt and Python arithmetic. No external network service is needed.
+
+The DHCP checks cover stable MAC-derived addresses in 10.0.0.0/8, reserved
+address avoidance, the matching 255.0.0.0 mask, and the unchanged router
+10.0.2.2 and DNS server 10.0.2.3. Traffic to 10/8 peers stays on Ethernet;
+the loopback echo test separately verifies ordinary UDP NAT and its replies.
+
+The `kernel-network-contract` target in `tests/kernel_dispatch` additionally
+checks the production guest bridge: a 28-byte KDPC leaves its following field
+intact, socket errors retain their Win32 values, and invalid guest crypto
+buffers are refused before native memory access.
+
+These are transport and ABI tests. A complete System Link check also needs
+two game instances to discover/join the same lobby, start a session and
+exchange moving vehicle state.
+
+Live validation on 18 October 2026 passed with two native MM3 instances on
+one Windows PC, using separate saves/configuration and loopback UDP 3075/3076.
+The final 10/8 backend assigned 10.20.215.88 and 10.198.74.83. The client
+discovered and joined the host, both lobbies showed the same readiness, and
+the host started a Paris Cruise. Host movement of 100.74 m and client movement
+of 73.65 m propagated in both directions; settled positions and forward vectors
+matched at the debug probe's reported precision. The tested game executable
+SHA-256 was 49AF9102B9A20966D060B507F35347332F1D0C3362C9D34654F52A83E9D4D0CF.
+The game project's logs/pc-upgrades-20261018-systemlink.json records the
+inputs, identity, snapshots, captures and owned-process teardown.
+
+Separate physical PCs and packet-loss/latency conditions were not exercised.
+The live pair ended through owned process termination; bounded graceful
+worker shutdown and handle cleanup are covered by the lifecycle tests.
diff --git a/tests/net/crypto_contract.py b/tests/net/crypto_contract.py
new file mode 100644
index 0000000..cacf31a
--- /dev/null
+++ b/tests/net/crypto_contract.py
@@ -0,0 +1,144 @@
+"""XNet crypto against Python arithmetic, DES vectors and Windows BCrypt."""
+import ctypes as C
+from pathlib import Path
+import random
+import sys
+import unittest
+
+DLL = C.CDLL(str(Path(sys.argv.pop(1)).resolve()))
+U32 = C.c_uint32
+PTR = C.c_void_p
+DLL.mm3_test_modexp.argtypes = [PTR, PTR, PTR, PTR, U32]
+DLL.mm3_test_modexp.restype = U32
+DLL.mm3_test_keytable.argtypes = [U32, PTR, PTR]
+DLL.mm3_test_keytable.restype = None
+DLL.mm3_test_block.argtypes = [U32, PTR, PTR, PTR, U32]
+DLL.mm3_test_block.restype = None
+DLL.mm3_test_cbc.argtypes = [U32, U32, PTR, PTR, PTR, U32, PTR]
+DLL.mm3_test_cbc.restype = None
+DLL.mm3_test_parity.argtypes = [PTR, U32]
+DLL.mm3_test_parity.restype = None
+
+
+def buffer(data):
+    return C.create_string_buffer(data, len(data))
+
+
+def number(value, words):
+    return (U32 * words).from_buffer_copy(value.to_bytes(words * 4, 'little'))
+
+
+def modexp(base, exponent, modulus, words):
+    result = (U32 * words)()
+    status = DLL.mm3_test_modexp(result, number(base, words), number(exponent, words),
+                                number(modulus, words), words)
+    return status, int.from_bytes(bytes(result), 'little')
+
+
+def keytable(key):
+    table = C.create_string_buffer(384)
+    DLL.mm3_test_keytable(int(len(key) == 24), table, buffer(key))
+    return table
+
+
+class XNetCrypto(unittest.TestCase):
+    def test_modexp_against_python_pow(self):
+        rng = random.Random(0x4D4D3307)
+        for words in (1, 2, 4, 24):
+            for index in range(4):
+                bits = words * 32
+                modulus = rng.getrandbits(bits) | (1 << (bits - 1)) | 1
+                base = rng.getrandbits(bits)
+                exponent = 0 if index == 0 else rng.getrandbits(bits)
+                status, value = modexp(base, exponent, modulus, words)
+                self.assertEqual(status, 1)
+                self.assertEqual(value, pow(base, exponent, modulus))
+        self.assertEqual(modexp(7, 3, 1, 1), (1, 0))
+        self.assertEqual(modexp(7, 3, 0, 1)[0], 0)
+        self.assertEqual(DLL.mm3_test_modexp(None, None, None, None, 0), 0)
+        self.assertEqual(DLL.mm3_test_modexp(None, None, None, None, 1025), 0)
+
+    def test_diffie_hellman_768_bit_exchange(self):
+        prime = int('FFFFFFFFFFFFFFFFC90FDAA22168C234C4C6628B80DC1CD1'
+                    '29024E088A67CC74020BBEA63B139B22514A08798E3404DD'
+                    'EF9519B3CD3A431B302B0A6DF25F14374FE1356D6D51C245'
+                    'E485B576625E7EC6F44C42E9A63A3620FFFFFFFFFFFFFFFF', 16)
+        alice = 0x1234567890ABCDEF1234567890
+        bob = 0xFEDCBA0987654321FEDCBA0987
+        status_a, public_a = modexp(2, alice, prime, 24)
+        status_b, public_b = modexp(2, bob, prime, 24)
+        self.assertEqual((status_a, status_b), (1, 1))
+        self.assertEqual(public_a, pow(2, alice, prime))
+        self.assertEqual(public_b, pow(2, bob, prime))
+        _, secret_a = modexp(public_b, alice, prime, 24)
+        _, secret_b = modexp(public_a, bob, prime, 24)
+        self.assertEqual(secret_a, secret_b)
+        self.assertEqual(secret_a, pow(2, alice * bob, prime))
+
+    def test_des_known_answer_and_in_place_decryption(self):
+        key = bytes.fromhex('133457799BBCDFF1')
+        plain = bytes.fromhex('0123456789ABCDEF')
+        expected = bytes.fromhex('85E813540F0AB405')
+        for cipher, material in ((0, key), (1, key * 3)):
+            table = keytable(material)
+            out = C.create_string_buffer(8)
+            DLL.mm3_test_block(cipher, out, buffer(plain), table, 1)
+            self.assertEqual(out.raw, expected)
+            DLL.mm3_test_block(cipher, out, out, table, 0)
+            self.assertEqual(out.raw, plain)
+
+    def test_three_distinct_des_keys_cbc_against_bcrypt(self):
+        bcrypt = C.WinDLL('bcrypt.dll')
+        bcrypt.BCryptOpenAlgorithmProvider.argtypes = [C.POINTER(PTR), C.c_wchar_p, C.c_wchar_p, U32]
+        bcrypt.BCryptSetProperty.argtypes = [PTR, C.c_wchar_p, PTR, U32, U32]
+        bcrypt.BCryptGenerateSymmetricKey.argtypes = [PTR, C.POINTER(PTR), PTR, U32, PTR, U32, U32]
+        bcrypt.BCryptEncrypt.argtypes = [PTR, PTR, U32, PTR, PTR, U32, PTR, U32, C.POINTER(U32), U32]
+        bcrypt.BCryptDestroyKey.argtypes = [PTR]
+        bcrypt.BCryptCloseAlgorithmProvider.argtypes = [PTR, U32]
+        alg, native_key = PTR(), PTR()
+        key = bytes.fromhex('0123456789ABCDEFFEDCBA98765432100011223344556677')
+        plain = bytes(range(32))
+        iv_bytes = bytes.fromhex('A1B2C3D4E5F60718')
+        try:
+            self.assertEqual(bcrypt.BCryptOpenAlgorithmProvider(C.byref(alg), '3DES', None, 0), 0)
+            mode = C.create_unicode_buffer('ChainingModeCBC')
+            self.assertEqual(bcrypt.BCryptSetProperty(alg, 'ChainingMode', mode, C.sizeof(mode), 0), 0)
+            self.assertEqual(bcrypt.BCryptGenerateSymmetricKey(alg, C.byref(native_key), None, 0,
+                                                              buffer(key), len(key), 0), 0)
+            expected = C.create_string_buffer(len(plain)); used = U32()
+            self.assertEqual(bcrypt.BCryptEncrypt(native_key, buffer(plain), len(plain), None,
+                                                 buffer(iv_bytes), 8, expected, len(plain), C.byref(used), 0), 0)
+            self.assertEqual(used.value, len(plain))
+            out, feedback, table = C.create_string_buffer(len(plain)), buffer(iv_bytes), keytable(key)
+            DLL.mm3_test_cbc(1, len(plain), out, buffer(plain), table, 1, feedback)
+            self.assertEqual(out.raw, expected.raw)
+            self.assertEqual(feedback.raw, expected.raw[-8:])
+            feedback = buffer(iv_bytes)
+            DLL.mm3_test_cbc(1, len(plain), out, out, table, 0, feedback)
+            self.assertEqual(out.raw, plain)
+            self.assertEqual(feedback.raw, expected.raw[-8:])
+        finally:
+            if native_key: bcrypt.BCryptDestroyKey(native_key)
+            if alg: bcrypt.BCryptCloseAlgorithmProvider(alg, 0)
+
+    def test_invalid_cipher_operation_and_partial_cbc_are_noops(self):
+        table = keytable(b'12345678')
+        out, feedback = buffer(b'Z' * 16), buffer(b'IVIVIVIV')
+        for cipher, operation, length in ((2, 1, 8), (0, 2, 8), (0, 1, 7), (0, 1, 15)):
+            DLL.mm3_test_cbc(cipher, length, out, buffer(b'P' * 16), table, operation, feedback)
+            self.assertEqual(out.raw, b'Z' * 16)
+            self.assertEqual(feedback.raw, b'IVIVIVIV')
+        DLL.mm3_test_block(2, out, buffer(b'P' * 8), table, 1)
+        self.assertEqual(out.raw, b'Z' * 16)
+
+    def test_key_parity_is_odd_and_preserves_seven_key_bits(self):
+        data = bytes(range(256))
+        key = buffer(data)
+        DLL.mm3_test_parity(key, len(data))
+        for before, after in zip(data, key.raw):
+            self.assertEqual(before & 0xFE, after & 0xFE)
+            self.assertEqual(after.bit_count() & 1, 1)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
