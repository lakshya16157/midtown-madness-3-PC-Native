diff --git a/tests/nv2a_textures/README.md b/tests/nv2a_textures/README.md
new file mode 100644
index 0000000..168759e
--- /dev/null
+++ b/tests/nv2a_textures/README.md
@@ -0,0 +1,66 @@
+# Texture cache and upload regression checks
+
+Run from the game checkout with its portable Windows toolchain:
+
+```powershell
+Set-ExecutionPolicy -Scope Process Bypass -Force
+. ./scripts/enter-env.ps1
+cmake -S tools/xboxrecomp/tests/nv2a_textures -B conformance_tmp/texture-tests -G Ninja -DCMAKE_BUILD_TYPE=Release
+cmake --build conformance_tmp/texture-tests
+ctest --test-dir conformance_tmp/texture-tests --output-on-failure
+```
+
+The four GPU cases exercise failed-resource retry, complete mip publication,
+retention of an existing upload during allocation failure, and independent
+palette-length cache identity. The CPU case compares complete ARGB/XRGB and
+DXT1/3/5 rectangles with independent per-texel addressing and decoding. It covers
+unaligned source addresses, odd compressed sizes, short mip dimensions, and
+destination boundary guards.
+
+The `native_bc` case samples BC1/2/3 resources on the GPU against an independently
+decoded BGRA reference. Its 120 combinations cover full and short mip chains,
+all cube faces, non-square and non-power-of-two dimensions, four source
+alignments, point and shifted linear filtering, actual resource/SRV formats and
+byte accounting, failed-view retry, and streamed updates across kick epochs.
+Base dimensions that are not multiples of four, unsupported formats, and chains
+that need generated mips retain the existing BGRA path.
+
+Native BC decoding preserves the guest blocks but is not bit-identical to the
+integer CPU decoder. The test derives each texel/channel's tolerance from the
+endpoint span under [Direct3D's BC precision rules, section 19.5.2](https://microsoft.github.io/DirectX-Specs/d3d/archive/D3D11_3_FunctionalSpec.htm#19.5.2),
+plus the exact difference from the CPU decoder's expansion/truncation. Filtered
+bounds use the contributing texels' weights. Transparent/opaque extrema and
+BC2's explicit alpha are checked exactly. The RTX 2000 Ada's largest differences
+in the randomized tests were 6/255 for RGB and 7/255 for intermediate alpha.
+
+The optional CPU microbenchmark compares the original row traversal with the
+selected decoder, using medians of seven runs. It has no timing pass/fail limit:
+
+```powershell
+./conformance_tmp/texture-tests/nv2a_textures.exe benchmark_decode
+```
+
+On the Ryzen 9 PRO 7940HS, a 1024x1024 upload took 0.248 ms for ARGB32 and
+0.209 ms for XRGB32, compared with 1.595 ms and 1.469 ms for the original
+traversal. DXT1/3/5 improved by 1.27-1.37 times. These measurements cover CPU
+decoding, not GPU upload or whole-frame time, and vary with load and clock speed.
+
+The optional native-upload benchmark times CPU hashing, decoding and upload API
+calls for already-created 1024x1024 textures with all 11 mip levels:
+
+```powershell
+./conformance_tmp/texture-tests/nv2a_textures.exe benchmark_native_bc
+```
+
+It alternates measurement order, reports seven-sample medians of eight updates,
+and drains GPU completion between samples outside the measured interval. On
+this PC, BGRA/native CPU costs were 3.171/0.103 ms for DXT1, 3.822/0.170 ms for
+DXT3, and 3.078/0.183 ms for DXT5. Texture/upload data fell from 5,592,404 bytes
+to 699,064 bytes for BC1 and 1,398,128 bytes for BC2/3. This measures eligible
+upload bursts; it does not measure GPU throughput or predict gameplay FPS, and
+does not apply to short mip chains that retain generated BGRA mips.
+
+For an actual renderer snapshot comparison, configure another build with
+`-DNV2A_TEXTURE_RENDERER=C:/absolute/path/to/nv2a_d3d11.c`. The source's sibling
+headers can be resolved through the renderer include directory supplied by this
+test project.
diff --git a/tests/nv2a_textures/mip_generation_tests.h b/tests/nv2a_textures/mip_generation_tests.h
new file mode 100644
index 0000000..34673a1
--- /dev/null
+++ b/tests/nv2a_textures/mip_generation_tests.h
@@ -0,0 +1,242 @@
+/* In-place generation must preserve every channel, mip, and cube face. */
+static void mip_reference(const uint32_t *src, unsigned w, unsigned h, uint32_t *dst)
+{
+    unsigned nw = w > 1 ? w / 2 : 1, nh = h > 1 ? h / 2 : 1;
+    unsigned x, y, c, dx, dy;
+    for (y = 0; y < nh; y++)
+        for (x = 0; x < nw; x++) {
+            uint32_t pixel = 0;
+            for (c = 0; c < 4; c++) {
+                unsigned sum = 0;
+                for (dy = 0; dy < 2; dy++)
+                    for (dx = 0; dx < 2; dx++) {
+                        unsigned sx = w > 1 ? x * 2 + dx : 0;
+                        unsigned sy = h > 1 ? y * 2 + dy : 0;
+                        sum += (src[sy * w + sx] >> (8 * c)) & 255;
+                    }
+                pixel |= ((sum + 2) / 4) << (8 * c);
+            }
+            dst[y * nw + x] = pixel;
+        }
+}
+
+static int test_mip_inplace(void)
+{
+    const unsigned dimensions[] = {1, 2, 3, 4, 5, 7, 8, 15, 16, 31, 64, 128};
+    uint32_t original[128 * 128], reference[128 * 128], actual[128 * 128 + 2];
+    uint32_t random = 0x58A42F01u;
+    unsigned wi, hi, i, w, h, nw, nh;
+    for (wi = 0; wi < sizeof dimensions / sizeof dimensions[0]; wi++)
+        for (hi = 0; hi < sizeof dimensions / sizeof dimensions[0]; hi++) {
+            w = dimensions[wi]; h = dimensions[hi];
+            for (i = 0; i < w * h; i++) original[i] = random_word(&random);
+            memcpy(actual + 1, original, w * h * 4);
+            actual[0] = actual[1 + w * h] = 0xA5E37C91u;
+            while (w > 1 || h > 1) {
+                nw = w > 1 ? w / 2 : 1; nh = h > 1 ? h / 2 : 1;
+                mip_reference(original, w, h, reference);
+                halve_bgra(actual + 1, w, h, actual + 1);
+                CHECK(!memcmp(reference, actual + 1, nw * nh * 4));
+                CHECK(actual[0] == 0xA5E37C91u);
+                CHECK(actual[1 + dimensions[wi] * dimensions[hi]] == 0xA5E37C91u);
+                memcpy(original, reference, nw * nh * 4);
+                w = nw; h = nh;
+            }
+        }
+    puts("PASS: in-place mip chains exactly match independent channel averaging for 144 rectangles");
+    return 0;
+}
+
+static int check_mip_resource(ID3D11ShaderResourceView *view, const NvD3DTexture *texture,
+                               const TexLayout *layout)
+{
+    ID3D11Resource *resource = NULL;
+    ID3D11Texture2D *source = NULL, *staging = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    uint32_t pixels[32 * 32], reduced[32 * 32];
+    unsigned face, mip, row, w, h, levels = host_levels(layout, texture);
+    ID3D11ShaderResourceView_GetResource(view, &resource);
+    CHECK(SUCCEEDED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&source)));
+    ID3D11Resource_Release(resource);
+    ID3D11Texture2D_GetDesc(source, &desc);
+    CHECK(desc.MipLevels == levels && desc.ArraySize == (UINT)layout->faces);
+    CHECK(desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM);
+    desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging)));
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)source);
+    for (face = 0; face < desc.ArraySize; face++) {
+        w = texture->width; h = texture->height;
+        for (mip = 0; mip < levels; mip++) {
+            unsigned subresource = mip + face * levels;
+            if (mip < (unsigned)layout->levels)
+                decode_level(texture, layout, guest(texture->addr) + face * layout->face_stride +
+                             layout->level_off[mip], mip, NULL, pixels);
+            else {
+                unsigned previous_w = texture->width >> (mip - 1);
+                unsigned previous_h = texture->height >> (mip - 1);
+                mip_reference(pixels, previous_w ? previous_w : 1,
+                               previous_h ? previous_h : 1, reduced);
+                memcpy(pixels, reduced, w * h * 4);
+            }
+            CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, subresource,
+                                                   D3D11_MAP_READ, 0, &mapped)));
+            for (row = 0; row < h; row++)
+                CHECK(!memcmp((uint8_t *)mapped.pData + row * mapped.RowPitch, pixels + row * w, w * 4));
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, subresource);
+            if (w > 1) w /= 2;
+            if (h > 1) h /= 2;
+        }
+    }
+    ID3D11Texture2D_Release(staging); ID3D11Texture2D_Release(source);
+    return 0;
+}
+
+static int test_mip_chain(void)
+{
+    const unsigned formats[] = {0x06, 0x07, 0x0C, 0x0E, 0x0F};
+    const unsigned dimensions[][2] = {{16, 16}, {32, 8}, {1, 32}, {32, 1}};
+    uint32_t random = 0xDAC35691u;
+    unsigned format, dimension, iteration, i, count = 0;
+    for (format = 0; format < sizeof formats / sizeof formats[0]; format++)
+        for (dimension = 0; dimension < sizeof dimensions / sizeof dimensions[0]; dimension++) {
+            NvD3DTexture texture = {0};
+            TexLayout layout;
+            ID3D11ShaderResourceView *first = NULL, *view;
+            texture.addr = 0x20000 + count++ * 0x4000;
+            texture.color = formats[format];
+            texture.format = (formats[format] << 8) | 0x03220000u;
+            texture.width = dimensions[dimension][0]; texture.height = dimensions[dimension][1];
+            texture.levels = 2; texture.cube = dimension == 0;
+            CHECK(tex_layout(&texture, &layout));
+            for (iteration = 0; iteration < 2; iteration++) {
+                size_t allocations;
+                for (i = 0; i < layout.total; i++) ram[texture.addr + i] = (uint8_t)random_word(&random);
+                nv2a_d3d_kick();
+                allocations = pixel_allocations;
+                view = texture_get(&texture);
+                CHECK(view);
+                if (iteration) {
+                    CHECK(view == first);
+                    CHECK(pixel_allocations == allocations);
+                } else first = view;
+                CHECK(!check_mip_resource(view, &texture, &layout));
+            }
+        }
+    puts("PASS: short 2D/cube mip chains and changed uploads retain every GPU pixel without temporary allocation");
+    return 0;
+}
+
+typedef void (*MipChainFunction)(uint32_t *, unsigned, unsigned);
+static volatile uint32_t mip_sink;
+
+/* Allocation/copy behavior before this change, using the same box filter. */
+static void mip_chain_before(uint32_t *pixels, unsigned w, unsigned h)
+{
+    uint32_t *a = malloc((size_t)w * h * 4), *b = malloc((size_t)w * h * 4);
+    memcpy(a, pixels, (size_t)w * h * 4);
+    while (w > 1 || h > 1) {
+        uint32_t *tmp;
+        halve_bgra(a, w, h, b);
+        if (w > 1) w /= 2;
+        if (h > 1) h /= 2;
+        mip_sink ^= b[w * h - 1];
+        tmp = a; a = b; b = tmp;
+    }
+    free(a); free(b);
+}
+
+static void mip_chain_inplace(uint32_t *pixels, unsigned w, unsigned h)
+{
+    while (w > 1 || h > 1) {
+        halve_bgra(pixels, w, h, pixels);
+        if (w > 1) w /= 2;
+        if (h > 1) h /= 2;
+        mip_sink ^= pixels[w * h - 1];
+    }
+}
+
+static __declspec(noinline) double time_mip_chain(MipChainFunction function,
+    uint32_t *pixels, unsigned w, unsigned h, unsigned repetitions)
+{
+    LARGE_INTEGER frequency;
+    int64_t start;
+    unsigned iteration;
+    QueryPerformanceFrequency(&frequency);
+    start = qpc();
+    for (iteration = 0; iteration < repetitions; iteration++) {
+        pixels[0]++;
+        function(pixels, w, h);
+    }
+    return (qpc() - start) * 1000.0 / frequency.QuadPart / repetitions;
+}
+
+static void sort_mip_times(double values[7])
+{
+    unsigned i, j;
+    for (i = 0; i < 7; i++)
+        for (j = i + 1; j < 7; j++)
+            if (values[j] < values[i]) {
+                double tmp = values[i]; values[i] = values[j]; values[j] = tmp;
+            }
+}
+
+static int benchmark_mip_cpu(void)
+{
+    uint32_t *pixels = malloc(512 * 512 * 4);
+    const unsigned sizes[] = {4, 16, 128, 512};
+    unsigned size, sample;
+    CHECK(pixels);
+    memset(pixels, 127, 512 * 512 * 4);
+    for (size = 0; size < sizeof sizes / sizeof sizes[0]; size++) {
+        double before[7], after[7];
+        unsigned repetitions = sizes[size] <= 16 ? 20000 : 200;
+        for (sample = 0; sample < 7; sample++) {
+            if (sample & 1) {
+                after[sample] = time_mip_chain(mip_chain_inplace, pixels, sizes[size], sizes[size], repetitions);
+                before[sample] = time_mip_chain(mip_chain_before, pixels, sizes[size], sizes[size], repetitions);
+            } else {
+                before[sample] = time_mip_chain(mip_chain_before, pixels, sizes[size], sizes[size], repetitions);
+                after[sample] = time_mip_chain(mip_chain_inplace, pixels, sizes[size], sizes[size], repetitions);
+            }
+        }
+        sort_mip_times(before); sort_mip_times(after);
+        printf("MIP CPU %ux%u median: before %.6f ms, in-place %.6f ms, %.2fx\n",
+               sizes[size], sizes[size], before[3], after[3], before[3] / after[3]);
+    }
+    free(pixels);
+    return 0;
+}
+
+static int benchmark_mip_upload(void)
+{
+    NvD3DTexture texture = {0};
+    TexLayout layout;
+    LARGE_INTEGER frequency;
+    double times[7];
+    unsigned sample, iteration, i;
+    size_t allocations = pixel_allocations;
+    uint32_t random = 0xA2B4581Du;
+    texture.addr = 0x100000; texture.color = 0x06; texture.format = 0x0AA40600u;
+    texture.width = texture.height = 1024; texture.levels = 4;
+    CHECK(tex_layout(&texture, &layout));
+    for (i = 0; i < layout.total; i++) ram[texture.addr + i] = (uint8_t)random_word(&random);
+    CHECK(texture_get(&texture));
+    QueryPerformanceFrequency(&frequency);
+    allocations = pixel_allocations;
+    for (sample = 0; sample < 7; sample++) {
+        int64_t start = qpc();
+        for (iteration = 0; iteration < 100; iteration++) {
+            ram[texture.addr]++;
+            nv2a_d3d_kick();
+            CHECK(texture_get(&texture));
+        }
+        ID3D11DeviceContext_Flush(s_ctx);
+        times[sample] = (qpc() - start) * 1000.0 / frequency.QuadPart / 100;
+    }
+    sort_mip_times(times);
+    printf("MIP UPLOAD 1024x1024, 4 guest/11 host levels: %.6f ms median per update, %zu temporary allocation attempts / 700 updates\n",
+           times[3], pixel_allocations - allocations);
+    return 0;
+}
diff --git a/tests/nv2a_textures/native_bc_tests.h b/tests/nv2a_textures/native_bc_tests.h
new file mode 100644
index 0000000..4e2a775
--- /dev/null
+++ b/tests/nv2a_textures/native_bc_tests.h
@@ -0,0 +1,473 @@
+/* Sample actual BC resources and the established decoded BGRA reference on
+ * the GPU, including every mip/face and filtered taps between texel centers. */
+#include <math.h>
+
+static ID3D11ComputeShader *bc_compare_shader;
+static ID3D11SamplerState *bc_compare_sampler[2];
+static ID3D11Buffer *bc_compare_constants;
+static float bc_max_rgb_error, bc_max_alpha_error;
+
+static int bc_compare_init(void)
+{
+    static const char shader[] =
+        "Texture2DArray<float4> compressed : register(t0);"
+        "Texture2DArray<float4> decoded : register(t1);"
+        "SamplerState taps : register(s0);"
+        "struct Pair { float4 compressed; float4 decoded; };"
+        "RWStructuredBuffer<Pair> output : register(u0);"
+        "cbuffer Params : register(b0) { uint width,height,mip,face; float2 shift,pad; };"
+        "[numthreads(8,8,1)] void main(uint3 id : SV_DispatchThreadID) {"
+        " if(id.x>=width || id.y>=height) return;"
+        " float3 uv=float3((float2(id.xy)+0.5+shift)/float2(width,height),face);"
+        " Pair p; p.compressed=compressed.SampleLevel(taps,uv,mip);"
+        " p.decoded=decoded.SampleLevel(taps,uv,mip); output[id.y*width+id.x]=p; }";
+    ID3DBlob *code = NULL, *errors = NULL;
+    D3D11_SAMPLER_DESC sampler_desc;
+    unsigned i;
+    HRESULT hr = D3DCompile(shader, sizeof shader - 1, "bc_compare", NULL, NULL,
+                            "main", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+    if (FAILED(hr) && errors)
+        fprintf(stderr, "%s\n", (const char *)ID3D10Blob_GetBufferPointer(errors));
+    if (errors) ID3D10Blob_Release(errors);
+    CHECK(SUCCEEDED(hr) && code);
+    hr = ID3D11Device_CreateComputeShader(s_dev, ID3D10Blob_GetBufferPointer(code),
+                                         ID3D10Blob_GetBufferSize(code), NULL, &bc_compare_shader);
+    ID3D10Blob_Release(code);
+    CHECK(SUCCEEDED(hr));
+    memset(&sampler_desc, 0, sizeof sampler_desc);
+    sampler_desc.AddressU = sampler_desc.AddressV = sampler_desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sampler_desc.MaxLOD = D3D11_FLOAT32_MAX;
+    for (i = 0; i < 2; i++) {
+        sampler_desc.Filter = i ? D3D11_FILTER_MIN_MAG_MIP_LINEAR : D3D11_FILTER_MIN_MAG_MIP_POINT;
+        CHECK(SUCCEEDED(ID3D11Device_CreateSamplerState(s_dev, &sampler_desc, &bc_compare_sampler[i])));
+    }
+    bc_compare_constants = make_buffer(32, D3D11_BIND_CONSTANT_BUFFER);
+    CHECK(bc_compare_constants);
+    return 0;
+}
+
+static ID3D11ShaderResourceView *bc_array_view(ID3D11ShaderResourceView *original,
+                                             D3D11_TEXTURE2D_DESC *texture_desc)
+{
+    ID3D11Resource *resource = NULL;
+    ID3D11Texture2D *texture = NULL;
+    ID3D11ShaderResourceView *array = NULL;
+    D3D11_SHADER_RESOURCE_VIEW_DESC view_desc;
+    ID3D11ShaderResourceView_GetResource(original, &resource);
+    if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&texture)))
+        goto done;
+    ID3D11Texture2D_GetDesc(texture, texture_desc);
+    memset(&view_desc, 0, sizeof view_desc);
+    view_desc.Format = texture_desc->Format;
+    view_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DARRAY;
+    view_desc.Texture2DArray.MipLevels = texture_desc->MipLevels;
+    view_desc.Texture2DArray.ArraySize = texture_desc->ArraySize;
+    ID3D11Device_CreateShaderResourceView(s_dev, resource, &view_desc, &array);
+done:
+    if (texture) ID3D11Texture2D_Release(texture);
+    if (resource) ID3D11Resource_Release(resource);
+    return array;
+}
+
+static ID3D11ShaderResourceView *bc_reference(const NvD3DTexture *t, const TexLayout *layout)
+{
+    D3D11_SUBRESOURCE_DATA data[16 * 6];
+    uint32_t *pixels[16 * 6] = {0};
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *texture = NULL;
+    ID3D11ShaderResourceView *view = NULL;
+    int face, mip, count = 0, levels = host_levels(layout, t);
+    memset(data, 0, sizeof data);
+    for (face = 0; face < layout->faces; face++)
+        for (mip = 0; mip < levels; mip++) {
+            uint32_t width = t->width >> mip ? t->width >> mip : 1;
+            uint32_t height = t->height >> mip ? t->height >> mip : 1;
+            uint32_t x, y;
+            pixels[count] = malloc((size_t)width * height * 4);
+            if (!pixels[count]) goto done;
+            if (mip < layout->levels) {
+                const uint8_t *src = guest(t->addr) + face * layout->face_stride + layout->level_off[mip];
+                for (y = 0; y < height; y++)
+                    for (x = 0; x < width; x++)
+                        if (!d3d8_dxt_decode_texel(src, t->color, x, y, width, &pixels[count][y * width + x]))
+                            goto done;
+            } else {
+                uint32_t previous_width = t->width >> (mip - 1) ? t->width >> (mip - 1) : 1;
+                uint32_t previous_height = t->height >> (mip - 1) ? t->height >> (mip - 1) : 1;
+                halve_bgra(pixels[count - 1], previous_width, previous_height, pixels[count]);
+            }
+            data[count].pSysMem = pixels[count];
+            data[count].SysMemPitch = width * 4;
+            count++;
+        }
+    memset(&desc, 0, sizeof desc);
+    desc.Width = t->width; desc.Height = t->height;
+    desc.MipLevels = levels; desc.ArraySize = layout->faces;
+    desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_IMMUTABLE;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    desc.MiscFlags = t->cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+    if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &desc, data, &texture)))
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)texture, NULL, &view);
+done:
+    if (texture) ID3D11Texture2D_Release(texture);
+    for (count = 0; count < 16 * 6; count++) free(pixels[count]);
+    return view;
+}
+
+/* D3D11 spec 19.5.2 permits 1/255 + 3% of the endpoint span for BC1/2/3.
+ * Add the exact difference between its promoted/interpolated reference and
+ * our existing integer decoder, rather than using a guessed global epsilon.
+ * https://microsoft.github.io/DirectX-Specs/d3d/archive/D3D11_3_FunctionalSpec.htm#19.5.2 */
+static float bc_texel_tolerance(const uint8_t *src, unsigned format, unsigned width,
+                                 unsigned x, unsigned y, unsigned channel)
+{
+    unsigned block_bytes = d3d8_format_dxt_block_bytes(format);
+    const uint8_t *block = src + ((size_t)(y / 4) * ((width + 3) / 4) + x / 4) * block_bytes;
+    unsigned selector, texel = (y & 3) * 4 + (x & 3), expected;
+    float ideal, span;
+    d3d8_dxt_decode_texel(src, format, x, y, width, &expected);
+    if (channel < 3) {
+        const uint8_t *color = block + (block_bytes == 16 ? 8 : 0);
+        unsigned c0 = color[0] | (color[1] << 8), c1 = color[2] | (color[3] << 8);
+        unsigned bits = channel == 1 ? 6 : 5, shift = channel == 0 ? 11 : channel == 1 ? 5 : 0;
+        unsigned a = (c0 >> shift) & ((1u << bits) - 1), b = (c1 >> shift) & ((1u << bits) - 1);
+        unsigned ap = (a << (8 - bits)) | (a >> (2 * bits - 8));
+        unsigned bp = (b << (8 - bits)) | (b >> (2 * bits - 8));
+        unsigned indices = color[4] | (color[5] << 8) | (color[6] << 16) | ((unsigned)color[7] << 24);
+        selector = (indices >> (2 * texel)) & 3;
+        span = fmaxf(fabsf((float)ap - bp), fabsf((float)a - b) * 255 / ((1u << bits) - 1));
+        ideal = selector == 0 ? (float)ap : selector == 1 ? (float)bp :
+                (c0 > c1 || block_bytes == 16) ?
+                    (selector == 2 ? (2.0f * ap + bp) / 3 : (ap + 2.0f * bp) / 3) :
+                    selector == 2 ? (ap + bp) / 2.0f : 0;
+        expected = (expected >> (16 - channel * 8)) & 255;
+    } else {
+        expected >>= 24;
+        if (format != 0x0F) return 0.001f; /* BC1 one-bit and BC2 explicit alpha. */
+        {
+            uint64_t indices = 0;
+            unsigned i, a = block[0], b = block[1];
+            for (i = 0; i < 6; i++) indices |= (uint64_t)block[2 + i] << (8 * i);
+            selector = (unsigned)((indices >> (3 * texel)) & 7);
+            span = fabsf((float)a - b);
+            ideal = selector == 0 ? (float)a : selector == 1 ? (float)b :
+                    a > b ? ((8 - selector) * (float)a + (selector - 1) * (float)b) / 7 :
+                    selector < 6 ? ((6 - selector) * (float)a + (selector - 1) * (float)b) / 5 :
+                    selector == 6 ? 0 : 255;
+        }
+    }
+    /* The specification requires exact extreme values, regardless of span. */
+    if (ideal == 0 || ideal == 255) return 0.001f;
+    return 1.0f + 0.03f * span + fabsf(ideal - expected) + 0.001f;
+}
+
+static float bc_sample_tolerance(const NvD3DTexture *t, const TexLayout *layout,
+                                  const uint8_t *snapshot, unsigned face, unsigned mip,
+                                  unsigned x, unsigned y, unsigned channel, unsigned filter)
+{
+    unsigned width = layout->level_w[mip], height = layout->level_h[mip];
+    const uint8_t *src = snapshot + face * layout->face_stride + layout->level_off[mip];
+    if (!filter) return bc_texel_tolerance(src, t->color, width, x, y, channel);
+    /* The linear test's shifts are (+1/4,-1/4) texel, with clamp addressing. */
+    {
+        unsigned x1 = x + 1 < width ? x + 1 : x, y0 = y ? y - 1 : 0;
+        return 0.1875f * bc_texel_tolerance(src, t->color, width, x, y0, channel) +
+               0.0625f * bc_texel_tolerance(src, t->color, width, x1, y0, channel) +
+               0.5625f * bc_texel_tolerance(src, t->color, width, x, y, channel) +
+               0.1875f * bc_texel_tolerance(src, t->color, width, x1, y, channel);
+    }
+}
+
+static int bc_compare(ID3D11ShaderResourceView *compressed, ID3D11ShaderResourceView *decoded,
+                       int native, const NvD3DTexture *t, const TexLayout *layout,
+                       const uint8_t *snapshot)
+{
+    D3D11_TEXTURE2D_DESC a_desc, b_desc;
+    ID3D11ShaderResourceView *views[2] = { bc_array_view(compressed, &a_desc), bc_array_view(decoded, &b_desc) };
+    D3D11_BUFFER_DESC buffer_desc;
+    D3D11_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+    ID3D11Buffer *output = NULL, *staging = NULL;
+    ID3D11UnorderedAccessView *uav = NULL;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    unsigned face, mip, filter;
+    CHECK(views[0] && views[1]);
+    CHECK(a_desc.Width == b_desc.Width && a_desc.Height == b_desc.Height);
+    CHECK(a_desc.MipLevels == b_desc.MipLevels && a_desc.ArraySize == b_desc.ArraySize);
+    memset(&buffer_desc, 0, sizeof buffer_desc);
+    buffer_desc.ByteWidth = a_desc.Width * a_desc.Height * 8 * sizeof(float);
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_UNORDERED_ACCESS;
+    buffer_desc.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_STRUCTURED;
+    buffer_desc.StructureByteStride = 8 * sizeof(float);
+    CHECK(SUCCEEDED(ID3D11Device_CreateBuffer(s_dev, &buffer_desc, NULL, &output)));
+    memset(&uav_desc, 0, sizeof uav_desc);
+    uav_desc.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+    uav_desc.Buffer.NumElements = a_desc.Width * a_desc.Height;
+    CHECK(SUCCEEDED(ID3D11Device_CreateUnorderedAccessView(s_dev, (ID3D11Resource *)output, &uav_desc, &uav)));
+    buffer_desc.Usage = D3D11_USAGE_STAGING;
+    buffer_desc.BindFlags = buffer_desc.MiscFlags = buffer_desc.StructureByteStride = 0;
+    buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    CHECK(SUCCEEDED(ID3D11Device_CreateBuffer(s_dev, &buffer_desc, NULL, &staging)));
+    for (face = 0; face < a_desc.ArraySize; face++)
+        for (mip = 0; mip < a_desc.MipLevels; mip++)
+            for (filter = 0; filter < 2; filter++) {
+                struct { uint32_t width, height, mip, face; float shift[2], pad[2]; } params = {0};
+                ID3D11UnorderedAccessView *null_uav = NULL;
+                unsigned pixel, channel;
+                params.width = a_desc.Width >> mip ? a_desc.Width >> mip : 1;
+                params.height = a_desc.Height >> mip ? a_desc.Height >> mip : 1;
+                params.mip = mip; params.face = face;
+                params.shift[0] = filter ? 0.25f : 0;
+                params.shift[1] = filter ? -0.25f : 0;
+                upload_cb(bc_compare_constants, &params, sizeof params);
+                ID3D11DeviceContext_CSSetShader(s_ctx, bc_compare_shader, NULL, 0);
+                ID3D11DeviceContext_CSSetShaderResources(s_ctx, 0, 2, views);
+                ID3D11DeviceContext_CSSetSamplers(s_ctx, 0, 1, &bc_compare_sampler[filter]);
+                ID3D11DeviceContext_CSSetConstantBuffers(s_ctx, 0, 1, &bc_compare_constants);
+                ID3D11DeviceContext_CSSetUnorderedAccessViews(s_ctx, 0, 1, &uav, NULL);
+                ID3D11DeviceContext_Dispatch(s_ctx, (params.width + 7) / 8, (params.height + 7) / 8, 1);
+                ID3D11DeviceContext_CSSetUnorderedAccessViews(s_ctx, 0, 1, &null_uav, NULL);
+                ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging, (ID3D11Resource *)output);
+                CHECK(SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped)));
+                for (pixel = 0; pixel < params.width * params.height; pixel++)
+                    for (channel = 0; channel < 4; channel++) {
+                        const float *pair = (const float *)mapped.pData + pixel * 8;
+                        float error = fabsf(pair[channel] - pair[4 + channel]) * 255.0f;
+                        float tolerance = native ? bc_sample_tolerance(t, layout, snapshot, face, mip,
+                                pixel % params.width, pixel / params.width, channel, filter) : 0.001f;
+                        if (channel == 3) {
+                            if (error > bc_max_alpha_error) bc_max_alpha_error = error;
+                        } else if (error > bc_max_rgb_error) bc_max_rgb_error = error;
+                        if (error > tolerance) {
+                            fprintf(stderr, "BC mismatch format=%u face=%u mip=%u filter=%u pixel=%u channel=%u compressed=%.5f decoded=%.5f error=%.5f tolerance=%.5f\n",
+                                    a_desc.Format, face, mip, filter, pixel, channel,
+                                    pair[channel] * 255, pair[4 + channel] * 255, error, tolerance);
+                            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+                            CHECK(0);
+                        }
+                    }
+                ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, 0);
+            }
+    {
+        ID3D11ShaderResourceView *none[2] = {NULL, NULL};
+        ID3D11DeviceContext_CSSetShaderResources(s_ctx, 0, 2, none);
+        ID3D11DeviceContext_CSSetShader(s_ctx, NULL, NULL, 0);
+    }
+    ID3D11ShaderResourceView_Release(views[0]); ID3D11ShaderResourceView_Release(views[1]);
+    ID3D11UnorderedAccessView_Release(uav);
+    ID3D11Buffer_Release(output); ID3D11Buffer_Release(staging);
+    return 0;
+}
+
+static int test_native_bc(void)
+{
+    static const unsigned formats[] = {0x0C, 0x0E, 0x0F};
+    static const DXGI_FORMAT host_formats[] = {DXGI_FORMAT_BC1_UNORM, DXGI_FORMAT_BC2_UNORM, DXGI_FORMAT_BC3_UNORM};
+    static const struct { unsigned width, height, levels, cube, native; } cases[] = {
+        {8,8,4,0,1}, {16,8,5,0,1}, {12,20,5,0,1}, {4,4,3,1,1}, {8,8,4,1,1},
+        {8,8,2,0,0}, {8,8,2,1,0}, {3,8,4,0,0}, {2,2,2,0,0}, {4,4,1,0,1}
+    };
+    static const unsigned alignments[] = {0,1,3,7};
+    uint32_t state = 0x9A6F031Bu;
+    unsigned format, item, alignment, sequence = 0;
+    CHECK(bc_compare_init() == 0);
+    for (format = 0; format < 3; format++)
+        for (item = 0; item < sizeof cases / sizeof cases[0]; item++)
+            for (alignment = 0; alignment < sizeof alignments / sizeof alignments[0]; alignment++) {
+                NvD3DTexture texture = {0};
+                TexLayout layout;
+                ID3D11ShaderResourceView *view, *reference;
+                uint8_t *snapshot;
+                D3D11_SHADER_RESOURCE_VIEW_DESC view_desc;
+                D3D11_TEXTURE2D_DESC texture_desc;
+                ID3D11ShaderResourceView *array;
+                size_t count = s_tex_count, bytes = s_tex_bytes, expected_bytes = 0;
+                unsigned i, mip, width, height, levels;
+                texture.addr = 0x50000 + sequence++ * 4096 + alignments[alignment];
+                texture.color = formats[format];
+                texture.width = cases[item].width; texture.height = cases[item].height;
+                texture.levels = cases[item].levels; texture.cube = cases[item].cube;
+                texture.format = (texture.color << 8) | (texture.levels << 16);
+                CHECK(tex_layout(&texture, &layout));
+                CHECK(guest_ok(texture.addr, layout.total));
+                for (i = 0; i < layout.total; i++) ram[texture.addr + i] = (uint8_t)random_word(&state);
+                /* Guarantee exact extrema and BC1 transparent selector 3 in
+                 * every face/mip, rather than relying on randomized endpoints. */
+                {
+                    unsigned face, level;
+                    for (face = 0; face < (unsigned)layout.faces; face++)
+                        for (level = 0; level < (unsigned)layout.levels; level++) {
+                            uint8_t *block = ram + texture.addr + face * layout.face_stride + layout.level_off[level];
+                            uint8_t *color = block + (layout.bpp == 16 ? 8 : 0);
+                            color[0] = color[1] = 0; color[2] = color[3] = 255;
+                            color[4] = 0xE7; color[5] = color[6] = color[7] = 0xE4;
+                            if (texture.color == 0x0E) memset(block, 0xF0, 8);
+                            if (texture.color == 0x0F) {
+                                static const unsigned selectors[] = {0,1,6,7};
+                                uint64_t indices = 0;
+                                unsigned pixel;
+                                block[0] = 0; block[1] = 255;
+                                for (pixel = 0; pixel < 16; pixel++) indices |= (uint64_t)selectors[pixel & 3] << (3 * pixel);
+                                for (pixel = 0; pixel < 6; pixel++) block[2 + pixel] = (uint8_t)(indices >> (8 * pixel));
+                            }
+                        }
+                }
+                snapshot = malloc(layout.total);
+                CHECK(snapshot);
+                memcpy(snapshot, ram + texture.addr, layout.total);
+                nv2a_d3d_kick();
+                /* A failed native view must retry within the same kick. */
+                if (cases[item].native) {
+                    fail_srv = 1;
+                    CHECK(texture_get(&texture) == NULL && fail_srv == 0);
+                    CHECK(s_tex_count == count && s_tex_bytes == bytes);
+                }
+                view = texture_get(&texture);
+                CHECK(view);
+                CHECK(texture_get(&texture) == view);
+                array = bc_array_view(view, &texture_desc);
+                CHECK(array);
+                ID3D11ShaderResourceView_Release(array);
+                ID3D11ShaderResourceView_GetDesc(view, &view_desc);
+                CHECK(texture_desc.Format == (cases[item].native ? host_formats[format] : DXGI_FORMAT_B8G8R8A8_UNORM));
+                CHECK(view_desc.Format == texture_desc.Format);
+                CHECK(view_desc.ViewDimension == (texture.cube ? D3D11_SRV_DIMENSION_TEXTURECUBE : D3D11_SRV_DIMENSION_TEXTURE2D));
+                levels = host_levels(&layout, &texture);
+                CHECK(texture_desc.MipLevels == levels && texture_desc.ArraySize == layout.faces);
+                width = texture.width; height = texture.height;
+                for (mip = 0; mip < levels; mip++) {
+                    expected_bytes += cases[item].native ? (size_t)((width + 3) / 4) * ((height + 3) / 4) * layout.bpp * layout.faces
+                                                       : (size_t)width * height * 4 * layout.faces;
+                    if (width > 1) width /= 2;
+                    if (height > 1) height /= 2;
+                }
+                CHECK(s_tex_count == count + 1 && s_tex_bytes == bytes + expected_bytes);
+                reference = bc_reference(&texture, &layout);
+                CHECK(reference && bc_compare(view, reference, cases[item].native, &texture, &layout, snapshot) == 0);
+                if (cases[item].native) {
+                    for (i = 0; i < layout.total; i++) ram[texture.addr + i] ^= (uint8_t)(0x5B + i * 17);
+                    /* Cached draws in this kick retain the old upload. A new
+                     * kick must hash all bytes and refresh this same resource. */
+                    CHECK(texture_get(&texture) == view);
+                    CHECK(bc_compare(view, reference, 1, &texture, &layout, snapshot) == 0);
+                    ID3D11ShaderResourceView_Release(reference);
+                    nv2a_d3d_kick();
+                    CHECK(texture_get(&texture) == view);
+                    CHECK(s_tex_count == count + 1 && s_tex_bytes == bytes + expected_bytes);
+                    reference = bc_reference(&texture, &layout);
+                    memcpy(snapshot, ram + texture.addr, layout.total);
+                    CHECK(reference && bc_compare(view, reference, 1, &texture, &layout, snapshot) == 0);
+                }
+                ID3D11ShaderResourceView_Release(reference);
+                free(snapshot);
+            }
+    printf("PASS: BC1/2/3 GPU sampling, all mips/faces, filtering, alignment, bytes, fallback and epoch/retry; max RGB %.4f/255, alpha %.4f/255\n",
+           bc_max_rgb_error, bc_max_alpha_error);
+    return 0;
+}
+
+static volatile uint64_t bc_benchmark_hash;
+
+static int bc_benchmark_drain(ID3D11Query *done)
+{
+    DWORD start = GetTickCount();
+    HRESULT hr;
+    ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)done);
+    ID3D11DeviceContext_Flush(s_ctx);
+    do {
+        hr = ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)done, NULL, 0, 0);
+        CHECK(hr != S_FALSE || GetTickCount() - start < 5000);
+        if (hr == S_FALSE) SwitchToThread();
+    } while (hr == S_FALSE);
+    CHECK(SUCCEEDED(hr));
+    return 0;
+}
+
+/* Compare CPU hashing + update calls on already-created resources. The BGRA
+ * reference retains the pre-BC decoder/upload loop. GPU completion is drained
+ * after each sample, outside its timing, so this does not claim GPU/frame time. */
+static double bc_benchmark_upload(const NvD3DTexture *t, const TexLayout *layout,
+                                   ID3D11Texture2D *bgra, uint32_t *scratch,
+                                   unsigned repetitions, int native)
+{
+    LARGE_INTEGER frequency;
+    int64_t start, end;
+    unsigned i, mip;
+    QueryPerformanceFrequency(&frequency);
+    start = qpc();
+    for (i = 0; i < repetitions; i++) {
+        ram[t->addr]++;
+        if (native) {
+            nv2a_d3d_kick();
+            if (!texture_get(t)) return -1;
+        } else {
+            bc_benchmark_hash ^= hash_mem(guest(t->addr), layout->total);
+            for (mip = 0; mip < (unsigned)layout->levels; mip++) {
+                decode_level(t, layout, guest(t->addr) + layout->level_off[mip], mip, NULL, scratch);
+                ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)bgra, mip, NULL,
+                                                       scratch, layout->level_w[mip] * 4, 0);
+            }
+        }
+    }
+    end = qpc();
+    return (end - start) * 1000.0 / frequency.QuadPart / repetitions;
+}
+
+static int benchmark_native_bc(void)
+{
+    const unsigned formats[] = {0x0C,0x0E,0x0F};
+    D3D11_QUERY_DESC query_desc = {D3D11_QUERY_EVENT, 0};
+    ID3D11Query *done = NULL;
+    uint32_t state = 0xABF010CDu, *scratch = malloc(1024 * 1024 * 4);
+    unsigned item, sample, i, j;
+    CHECK(scratch);
+    CHECK(SUCCEEDED(ID3D11Device_CreateQuery(s_dev, &query_desc, &done)));
+    for (item = 0; item < 3; item++) {
+        NvD3DTexture texture = {0};
+        TexLayout layout;
+        ID3D11Texture2D *bgra;
+        double before[7], selected[7];
+        texture.addr = 0x20000 + item * 0x200000;
+        texture.color = formats[item];
+        texture.width = texture.height = 1024; texture.levels = 11;
+        texture.format = (texture.color << 8) | (texture.levels << 16);
+        CHECK(tex_layout(&texture, &layout));
+        for (i = 0; i < layout.total; i++) ram[texture.addr + i] = (uint8_t)random_word(&state);
+        CHECK(texture_get(&texture));
+        bgra = make_texture(1024, 1024, 11, 1, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_BIND_SHADER_RESOURCE, 0);
+        CHECK(bgra);
+        CHECK(bc_benchmark_upload(&texture, &layout, bgra, scratch, 1, 0) > 0);
+        CHECK(bc_benchmark_drain(done) == 0);
+        CHECK(bc_benchmark_upload(&texture, &layout, bgra, scratch, 1, 1) > 0);
+        CHECK(bc_benchmark_drain(done) == 0);
+        for (sample = 0; sample < 7; sample++) {
+            /* Alternate measurement order to reduce warm-up/clock bias. */
+            if (sample & 1) {
+                selected[sample] = bc_benchmark_upload(&texture, &layout, bgra, scratch, 8, 1);
+                CHECK(bc_benchmark_drain(done) == 0);
+                before[sample] = bc_benchmark_upload(&texture, &layout, bgra, scratch, 8, 0);
+            } else {
+                before[sample] = bc_benchmark_upload(&texture, &layout, bgra, scratch, 8, 0);
+                CHECK(bc_benchmark_drain(done) == 0);
+                selected[sample] = bc_benchmark_upload(&texture, &layout, bgra, scratch, 8, 1);
+            }
+            CHECK(bc_benchmark_drain(done) == 0);
+            CHECK(before[sample] > 0 && selected[sample] > 0);
+        }
+        for (i = 0; i < 7; i++)
+            for (j = i + 1; j < 7; j++) {
+                double value;
+                if (before[j] < before[i]) { value = before[i]; before[i] = before[j]; before[j] = value; }
+                if (selected[j] < selected[i]) { value = selected[i]; selected[i] = selected[j]; selected[j] = value; }
+            }
+        printf("UPLOAD DXT%u 1024x1024 full11-mip chain: BGRA %.3f ms, native %.3f ms CPU/update (%.2fx); bytes %llu -> %llu\n",
+               item == 0 ? 1 : item == 1 ? 3 : 5, before[3], selected[3], before[3] / selected[3],
+               (unsigned long long)5592404, (unsigned long long)layout.total);
+        ID3D11Texture2D_Release(bgra);
+    }
+    ID3D11Query_Release(done);
+    free(scratch);
+    return 0;
+}
diff --git a/tests/nv2a_textures/test_textures.c b/tests/nv2a_textures/test_textures.c
new file mode 100644
index 0000000..1a0814b
--- /dev/null
+++ b/tests/nv2a_textures/test_textures.c
@@ -0,0 +1,349 @@
+/* Drive the real cache and inspect its GPU pixels, including failed uploads. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_1.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fail_srv;
+static size_t fail_alloc_size;
+static int fail_alloc;
+static size_t pixel_allocations;
+
+static HRESULT create_srv(ID3D11Device *device, ID3D11Resource *resource,
+                          const D3D11_SHADER_RESOURCE_VIEW_DESC *desc,
+                          ID3D11ShaderResourceView **view)
+{
+    if (fail_srv) {
+        fail_srv--;
+        *view = NULL;
+        return E_OUTOFMEMORY;
+    }
+    return device->lpVtbl->CreateShaderResourceView(device, resource, desc, view);
+}
+
+static void *allocate_pixels(size_t bytes)
+{
+    pixel_allocations++;
+    if (fail_alloc && bytes == fail_alloc_size) {
+        fail_alloc--;
+        return NULL;
+    }
+    return malloc(bytes);
+}
+
+#undef ID3D11Device_CreateShaderResourceView
+#define ID3D11Device_CreateShaderResourceView create_srv
+#define malloc allocate_pixels
+#ifndef NV2A_TEXTURE_RENDERER
+#define NV2A_TEXTURE_RENDERER "../../src/video/nv2a_d3d11.c"
+#endif
+#include NV2A_TEXTURE_RENDERER
+#undef malloc
+
+static uint8_t *ram;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)ram; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { return NULL; }
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+static uint32_t read_mip(ID3D11ShaderResourceView *view, UINT mip)
+{
+    ID3D11Resource *resource = NULL;
+    ID3D11Texture2D *source = NULL, *staging = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    uint32_t pixel = 0xDEADBEEFu;
+    if (!view) return pixel;
+    ID3D11ShaderResourceView_GetResource(view, &resource);
+    if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D,
+                                            (void **)&source))) {
+        ID3D11Resource_Release(resource);
+        return pixel;
+    }
+    ID3D11Resource_Release(resource);
+    ID3D11Texture2D_GetDesc(source, &desc);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = desc.MiscFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &desc, NULL, &staging))) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)staging,
+                                       (ID3D11Resource *)source);
+        if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)staging, mip,
+                                             D3D11_MAP_READ, 0, &mapped))) {
+            memcpy(&pixel, mapped.pData, sizeof pixel);
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)staging, mip);
+        }
+        ID3D11Texture2D_Release(staging);
+    }
+    ID3D11Texture2D_Release(source);
+    return pixel;
+}
+
+static int test_srv_retry(void)
+{
+    NvD3DTexture texture = {0};
+    ID3D11ShaderResourceView *view;
+    size_t count = s_tex_count, bytes = s_tex_bytes;
+    unsigned i;
+    texture.addr = 0x20000;
+    texture.color = 0x12;
+    texture.format = 0x00011200;
+    texture.width = texture.height = 4;
+    texture.pitch = 16; texture.levels = 1;
+    for (i = 0; i < 16; i++) ((uint32_t *)(ram + texture.addr))[i] = 0xFF00FF00u;
+    fail_srv = 1;
+    CHECK(texture_get(&texture) == NULL);
+    CHECK(fail_srv == 0);
+    CHECK(s_tex_count == count && s_tex_bytes == bytes);
+    /* Retry in the same kick: the failed view must never become a cache hit. */
+    view = texture_get(&texture);
+    CHECK(view && read_mip(view, 0) == 0xFF00FF00u);
+    CHECK(texture_get(&texture) == view);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&texture) == view);
+    CHECK(s_tex_count == count + 1);
+    CHECK(s_tex_bytes == bytes + 16 * 4);
+    puts("PASS: failed texture SRV creation retries immediately without a poisoned cache entry");
+    return 0;
+}
+
+static int test_mip_retry(void)
+{
+    NvD3DTexture texture = {0};
+    ID3D11ShaderResourceView *view;
+    size_t count = s_tex_count, bytes = s_tex_bytes;
+    unsigned i;
+    texture.addr = 0x30000;
+    texture.color = 0x06;
+    texture.format = 0x03320600;
+    texture.width = texture.height = 8; texture.levels = 2;
+    for (i = 0; i < 64; i++) ((uint32_t *)(ram + texture.addr))[i] = 0xFFFF0000u;
+    for (i = 64; i < 80; i++) ((uint32_t *)(ram + texture.addr))[i] = 0xFF0000FFu;
+    /* Generated mips reuse the top-level scratch. An allocation failure must
+     * still leave the complete previous GPU image visible and retryable. */
+    free(s_up_pixels); s_up_pixels = NULL; s_up_cap = 0;
+    fail_alloc_size = 8 * 8 * 4;
+    fail_alloc = 1;
+    CHECK(texture_get(&texture) == NULL);
+    CHECK(fail_alloc == 0);
+    CHECK(s_tex_count == count && s_tex_bytes == bytes);
+    view = texture_get(&texture);
+    CHECK(view);
+    CHECK(read_mip(view, 0) == 0xFFFF0000u);
+    for (i = 1; i < 4; i++) CHECK(read_mip(view, i) == 0xFF0000FFu);
+    CHECK(s_tex_count == count + 1);
+    CHECK(s_tex_bytes == bytes + (64 + 16 + 4 + 1) * 4);
+    /* Also retry a failed update of an existing resource. */
+    for (i = 64; i < 80; i++) ((uint32_t *)(ram + texture.addr))[i] = 0xFF00FF00u;
+    nv2a_d3d_kick();
+    free(s_up_pixels); s_up_pixels = NULL; s_up_cap = 0;
+    fail_alloc = 1;
+    CHECK(texture_get(&texture) == view);
+    CHECK(fail_alloc == 0 && s_tex_count == count + 1);
+    for (i = 1; i < 4; i++) CHECK(read_mip(view, i) == 0xFF0000FFu);
+    CHECK(texture_get(&texture) == view);
+    for (i = 1; i < 4; i++) CHECK(read_mip(view, i) == 0xFF00FF00u);
+    puts("PASS: scratch allocation failure cannot publish incomplete mips and retries existing uploads");
+    return 0;
+}
+
+static int test_palette_identity(void)
+{
+    NvD3DTexture texture = {0};
+    ID3D11ShaderResourceView *short_view, *long_view;
+    texture.addr = 0x40000;
+    texture.color = 0x0B; texture.format = 0x02210B00;
+    texture.width = texture.height = 4; texture.levels = 1;
+    texture.palette = 0x41000; texture.palette_len = 32;
+    memset(ram + texture.addr, 7, 16);
+    ((uint32_t *)(ram + texture.palette))[7] = 0xFFFF0000u;
+    short_view = texture_get(&texture);
+    CHECK(short_view && read_mip(short_view, 0) == 0xFFFF0000u);
+    /* PALETTE_LENGTH is a separate register from FORMAT and may change
+     * between draws of a kick. Their validation/hash spans differ. */
+    texture.palette_len = 256;
+    long_view = texture_get(&texture);
+    CHECK(long_view && long_view != short_view);
+    CHECK(read_mip(long_view, 0) == 0xFFFF0000u);
+    texture.palette_len = 32;
+    CHECK(texture_get(&texture) == short_view);
+    puts("PASS: independently changed palette length cannot bypass cache validation");
+    return 0;
+}
+
+static uint32_t random_word(uint32_t *state)
+{
+    *state ^= *state << 13; *state ^= *state >> 17; *state ^= *state << 5;
+    return *state;
+}
+
+#include "native_bc_tests.h"
+#include "mip_generation_tests.h"
+#include "write_watch_tests.h"
+
+static int test_decode_equivalence(void)
+{
+    uint32_t state = 0x12345678u;
+    uint8_t *data = malloc(65536 + 64);
+    uint32_t *allocation = malloc(65536 + 16), *decoded;
+    const unsigned formats[] = { 0x06, 0x07, 0x0C, 0x0E, 0x0F };
+    const unsigned dimensions[] = { 1, 2, 3, 4, 5, 7, 8, 12, 16, 20, 64, 128 };
+    unsigned i, offset, format, width, height, w, h, x, y;
+    CHECK(data);
+    CHECK(allocation);
+    decoded = allocation + 1;
+    for (i = 0; i < 65536 + 64; i++) data[i] = (uint8_t)random_word(&state);
+    /* Validate complete rectangles, unaligned sources, short mips and both
+     * compressed alpha modes against independent per-texel addressing. */
+    for (format = 0; format < 5; format++)
+        for (width = 0; width < sizeof dimensions / sizeof dimensions[0]; width++)
+            for (height = 0; height < sizeof dimensions / sizeof dimensions[0]; height++)
+                for (offset = 0; offset < 8; offset++) {
+                    NvD3DTexture texture = {0};
+                    TexLayout layout;
+                    w = dimensions[width]; h = dimensions[height];
+                    if (format < 2 && ((w & (w - 1)) || (h & (h - 1)))) continue;
+                    texture.color = formats[format];
+                    texture.width = w; texture.height = h; texture.levels = 1;
+                    CHECK(tex_layout(&texture, &layout));
+                    decoded[-1] = decoded[w * h] = 0xDEADC0DEu;
+                    decode_level(&texture, &layout, data + offset, 0, NULL, decoded);
+                    CHECK(decoded[-1] == 0xDEADC0DEu && decoded[w * h] == 0xDEADC0DEu);
+                    for (y = 0; y < h; y++)
+                        for (x = 0; x < w; x++) {
+                            uint32_t expected;
+                            if (layout.kind == K_DXT)
+                                CHECK(d3d8_dxt_decode_texel(data + offset, texture.color,
+                                                           x, y, w, &expected));
+                            else {
+                                uint32_t address = swizzle_offset(x, y, w, h);
+                                expected = texel(texture.color, data + offset + address * 4, NULL);
+                            }
+                            CHECK(decoded[y * w + x] == expected);
+                        }
+        }
+    free(data);
+    free(allocation);
+    puts("PASS: tiled32-bit and DXT uploads match per-texel decoding across sizes, mips and alignments");
+    return 0;
+}
+
+/* Original row-by-row implementation retained only as a benchmark reference. */
+static void decode_before(const NvD3DTexture *t, const TexLayout *L, const uint8_t *src,
+                          int lv, const uint32_t *pal, uint32_t *out)
+{
+    uint32_t w = L->level_w[lv], h = L->level_h[lv], x, y;
+    if (L->kind == K_DXT) {
+        uint32_t bw = (w + 3) / 4, bh = (h + 3) / 4, bx, by, px[16];
+        for (by = 0; by < bh; by++)
+            for (bx = 0; bx < bw; bx++) {
+                d3d8_dxt_decode_block(src + ((size_t)by * bw + bx) * L->bpp, t->color, px);
+                for (y = 0; y < 4 && by * 4 + y < h; y++)
+                    for (x = 0; x < 4 && bx * 4 + x < w; x++)
+                        out[(size_t)(by * 4 + y) * w + bx * 4 + x] = px[y * 4 + x];
+            }
+    } else {
+        uint32_t mx, my, oy = 0;
+        xbox_swizzle_masks(w, h, &mx, &my);
+        for (y = 0; y < h; y++) {
+            uint32_t ox = 0, *dst = out + (size_t)y * w;
+            for (x = 0; x < w; x++) {
+                dst[x] = texel(t->color, src + (size_t)(oy + ox) * L->bpp, pal);
+                ox = (ox - mx) & mx;
+            }
+            oy = (oy - my) & my;
+        }
+    }
+}
+
+typedef void (*DecodeFunction)(const NvD3DTexture *, const TexLayout *, const uint8_t *,
+                               int, const uint32_t *, uint32_t *);
+static volatile uint32_t decode_sink;
+
+static __declspec(noinline) double time_decode(DecodeFunction function,
+    const NvD3DTexture *texture, const TexLayout *layout, uint8_t *data,
+    uint32_t *out, unsigned repetitions)
+{
+    LARGE_INTEGER frequency;
+    int64_t start, elapsed;
+    unsigned i;
+    QueryPerformanceFrequency(&frequency);
+    start = qpc();
+    for (i = 0; i < repetitions; i++) {
+        data[0]++;
+        function(texture, layout, data, 0, NULL, out);
+        decode_sink ^= out[i & 255];
+    }
+    elapsed = qpc() - start;
+    return elapsed / (double)frequency.QuadPart;
+}
+
+static int benchmark_decode(void)
+{
+    const unsigned formats[] = { 0x06, 0x07, 0x0C, 0x0E, 0x0F };
+    uint8_t *data = malloc(4 * 1024 * 1024 + 64);
+    uint32_t *out = malloc(4 * 1024 * 1024);
+    uint32_t state = 0x1A2B3C4Du;
+    unsigned i, sample, item, repetitions;
+    double scalar[7], optimized[7];
+    CHECK(data);
+    CHECK(out);
+    for (i = 0; i < 4 * 1024 * 1024 + 64; i++) data[i] = (uint8_t)random_word(&state);
+    for (item = 0; item < 5; item++) {
+        NvD3DTexture texture = {0};
+        TexLayout layout;
+        texture.color = formats[item];
+        texture.width = texture.height = 1024; texture.levels = 1;
+        CHECK(tex_layout(&texture, &layout));
+        repetitions = 8;
+        for (sample = 0; sample < 7; sample++) {
+            scalar[sample] = time_decode(decode_before, &texture, &layout, data + 1, out, repetitions);
+            optimized[sample] = time_decode(decode_level, &texture, &layout, data + 1, out, repetitions);
+        }
+        for (i = 0; i < 7; i++)
+            for (sample = i + 1; sample < 7; sample++) {
+                double t;
+                if (scalar[sample] < scalar[i]) { t = scalar[i]; scalar[i] = scalar[sample]; scalar[sample] = t; }
+                if (optimized[sample] < optimized[i]) { t = optimized[i]; optimized[i] = optimized[sample]; optimized[sample] = t; }
+            }
+        printf("DECODE format %02X 1024x1024: before %.3f ms, selected %.3f ms per upload (%.2fx)\n",
+               formats[item], scalar[3] * 1000 / repetitions, optimized[3] * 1000 / repetitions,
+               scalar[3] / optimized[3]);
+    }
+    free(data);
+    free(out);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    if (!strcmp(argv[1], "decode_equivalence")) return test_decode_equivalence();
+    if (!strcmp(argv[1], "benchmark_decode")) return benchmark_decode();
+    if (!strcmp(argv[1], "mip_inplace")) return test_mip_inplace();
+    if (!strcmp(argv[1], "benchmark_mip_cpu")) return benchmark_mip_cpu();
+    ram = calloc(1, (!strcmp(argv[1], "benchmark_native_bc") || !strcmp(argv[1], "benchmark_mip_upload")) ? 0x1000000 : 0x100000);
+    CHECK(ram);
+    _putenv_s("RECOMP_MSAA", "1");
+    _putenv_s("RECOMP_RENDER_SCALE", "1");
+    _putenv_s("RECOMP_PS_SPEC", "0");
+    _putenv_s("RECOMP_FPS_LIMIT", "0");
+    CHECK(nv2a_d3d_init());
+    if (!strcmp(argv[1], "srv_retry")) return test_srv_retry();
+    if (!strcmp(argv[1], "mip_retry")) return test_mip_retry();
+    if (!strcmp(argv[1], "palette_identity")) return test_palette_identity();
+    if (!strcmp(argv[1], "native_bc")) return test_native_bc();
+    if (!strcmp(argv[1], "mip_chain")) return test_mip_chain();
+    if (!strcmp(argv[1], "write_watch")) return test_write_watch();
+    if (!strcmp(argv[1], "benchmark_mip_upload")) return benchmark_mip_upload();
+    if (!strcmp(argv[1], "benchmark_native_bc")) return benchmark_native_bc();
+    CHECK(0);
+}
diff --git a/tests/nv2a_textures/test_trace_timing.c b/tests/nv2a_textures/test_trace_timing.c
new file mode 100644
index 0000000..d4e0830
--- /dev/null
+++ b/tests/nv2a_textures/test_trace_timing.c
@@ -0,0 +1,142 @@
+/* Exercise the real trace function without starting a renderer. The output
+ * sink advances a synthetic clock, reproducing pipe backpressure exactly. */
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11_1.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <string.h>
+
+static int64_t test_now;
+static ULONGLONG test_tick;
+static unsigned clock_reads, output_calls, flush_calls;
+static char output[8192];
+static size_t output_used;
+
+static BOOL WINAPI test_qpc(LARGE_INTEGER *value)
+{
+    ++clock_reads;
+    value->QuadPart = test_now;
+    return TRUE;
+}
+
+static BOOL WINAPI test_frequency(LARGE_INTEGER *value)
+{
+    value->QuadPart = 1000000;
+    return TRUE;
+}
+
+static ULONGLONG WINAPI test_ticks(void) { return test_tick; }
+
+static int test_print(FILE *stream, const char *format, ...)
+{
+    va_list args;
+    int written;
+    (void)stream;
+    va_start(args, format);
+    written = vsnprintf(output + output_used, sizeof output - output_used,
+                        format, args);
+    va_end(args);
+    if (written < 0 || (size_t)written >= sizeof output - output_used)
+        abort();
+    output_used += (size_t)written;
+    ++output_calls;
+    test_now += 100000; /* One hundred ms blocked writing to the pipe. */
+    return written;
+}
+
+static int test_flush(FILE *stream)
+{
+    (void)stream;
+    ++flush_calls;
+    test_now += 200000;
+    return 0;
+}
+
+#define QueryPerformanceCounter test_qpc
+#define QueryPerformanceFrequency test_frequency
+#define GetTickCount64 test_ticks
+#define fprintf test_print
+#define fflush test_flush
+#ifndef NV2A_TEXTURE_RENDERER
+#define NV2A_TEXTURE_RENDERER "../../src/video/nv2a_d3d11.c"
+#endif
+#include NV2A_TEXTURE_RENDERER
+#undef QueryPerformanceCounter
+#undef QueryPerformanceFrequency
+#undef GetTickCount64
+#undef fprintf
+#undef fflush
+
+ptrdiff_t xbox_GetMemoryOffset(void) { return 0; }
+HWND xbox_FramebufferWindowHandle(void) { return NULL; }
+int xbox_FramebufferScanSource(uint32_t *va, uint32_t *pitch) { return 0; }
+int xbox_FramebufferOverlay(XboxOverlay *ovl) { return 0; }
+void xbox_FramebufferNoteFlip(uint32_t draws) {}
+const uint32_t (*nv2a_vsh_program(uint32_t *start, uint32_t *version))[4] { return NULL; }
+const float (*nv2a_vsh_constants(uint32_t *version))[4] { return NULL; }
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "FAIL line %d: %s\n%s", __LINE__, #x, output); return 1; \
+} } while (0)
+
+static void clear_output(void)
+{
+    output[0] = 0;
+    output_used = 0;
+    output_calls = flush_calls = clock_reads = 0;
+}
+
+int main(void)
+{
+    NvD3DTexture texture = {0};
+    texture.addr = 0x20000;
+    texture.width = texture.height = 16;
+    _putenv_s("RECOMP_TEXTURE_STREAM_TRACE", "1");
+
+    /* Even the first enable message and its flush are outside the measured
+     * upload. Both really run, so a fast/no-op logging stub cannot pass. */
+    test_now = 2500;
+    test_tick = 1000;
+    texture_trace_event(&texture, "new_upload", 256, 1, 1, 0, 1, 1000);
+    CHECK(strstr(output, "[TEXTURE_TRACE] enabled"));
+    CHECK(strstr(output, "event=new_upload"));
+    CHECK(strstr(output, "duration_ms=1.500"));
+    CHECK(output_calls == 2 && flush_calls == 1 && clock_reads == 1);
+    CHECK(test_now == 402500);
+
+    /* Reproduce the observed once-per-second summary followed by an upload:
+     * writing/flushing that summary must not inflate this event's duration. */
+    clear_output();
+    test_now = 6000;
+    test_tick = 2000;
+    texture_trace_event(&texture, "content_refresh", 256, 1, 1, 1, 2, 3500);
+    CHECK(strstr(output, "[TEXTURE_TRACE_SUMMARY]"));
+    CHECK(strstr(output, "event=content_refresh"));
+    CHECK(strstr(output, "duration_ms=2.500"));
+    CHECK(output_calls == 2 && flush_calls == 1 && clock_reads == 1);
+    CHECK(test_now == 406000);
+
+    clear_output();
+    test_now = 9000;
+    texture_trace_event(&texture, "new_upload", 256, 1, 1, 0, 3, 5500);
+    CHECK(!strstr(output, "SUMMARY"));
+    CHECK(strstr(output, "duration_ms=3.500"));
+    CHECK(output_calls == 1 && !flush_calls && clock_reads == 1);
+    CHECK(test_now == 109000);
+
+    /* Invalid-layout diagnostics have no upload interval, and the normal
+     * disabled path reads no diagnostic clocks and emits nothing. */
+    clear_output();
+    texture_trace_event(&texture, "invalid_layout", 0, 0, 0, 0, 0, 0);
+    CHECK(strstr(output, "duration_ms=0.000") && !clock_reads);
+    clear_output();
+    s_tex_stream_trace = 0;
+    texture_trace_event(&texture, "new_upload", 256, 1, 1, 0, 1, 0);
+    CHECK(!clock_reads && !output_calls && !flush_calls && !output_used);
+    puts("PASS: upload durations exclude slow enable, summary, flush and event output");
+    return 0;
+}
diff --git a/tests/nv2a_textures/write_watch_tests.h b/tests/nv2a_textures/write_watch_tests.h
new file mode 100644
index 0000000..65c2c4a
--- /dev/null
+++ b/tests/nv2a_textures/write_watch_tests.h
@@ -0,0 +1,239 @@
+/* The renderer's use of a write watch, against a software watch over guest
+ * 0x50000..0x80000. watch_write stores bytes and does what the fault handler
+ * does; a plain store into ram is a writer the watch cannot see. */
+#define FW_BASE 0x50000u
+#define FW_PAGES 48u
+#define FW_ARMED 1u
+#define FW_PINNED 2u
+
+static uint64_t fw_clock, fw_stamp[FW_PAGES], fw_faults, fw_armed_pages;
+static uint8_t fw_flag[FW_PAGES];
+
+static int fw_span(uint32_t va, uint32_t bytes, unsigned *first, unsigned *last)
+{
+    if (!bytes || va < FW_BASE || (uint64_t)va - FW_BASE + bytes > (uint64_t)FW_PAGES * 4096u)
+        return 0;
+    *first = (va - FW_BASE) / 4096u;
+    *last = (va - FW_BASE + bytes - 1) / 4096u;
+    return 1;
+}
+
+static int fw_covers(uint32_t va, uint32_t bytes)
+{
+    unsigned a, b;
+    return fw_span(va, bytes, &a, &b);
+}
+
+static uint64_t fw_arm(const GwwRange *r, int n, int *complete)
+{
+    int i;
+    unsigned p, a, b;
+    *complete = 1;
+    for (i = 0; i < n; ++i) {
+        if (!fw_span(r[i].va, r[i].bytes, &a, &b)) { *complete = 0; continue; }
+        for (p = a; p <= b; ++p) {
+            if (fw_flag[p] & FW_PINNED) { *complete = 0; continue; }
+            if (!(fw_flag[p] & FW_ARMED)) { fw_flag[p] |= FW_ARMED; ++fw_armed_pages; }
+        }
+    }
+    return fw_clock;
+}
+
+static int fw_clean(const GwwRange *r, int n, uint64_t since)
+{
+    int i;
+    unsigned p, a, b;
+    for (i = 0; i < n; ++i) {
+        if (!fw_span(r[i].va, r[i].bytes, &a, &b)) return 0;
+        for (p = a; p <= b; ++p)
+            if (!(fw_flag[p] & FW_ARMED) || fw_stamp[p] > since) return 0;
+    }
+    return 1;
+}
+
+static void fw_stats(uint64_t *faults, uint64_t *pages)
+{
+    *faults = fw_faults;
+    *pages = fw_armed_pages;
+}
+
+static const GwwOps fw_ops = { fw_covers, fw_arm, fw_clean, fw_stats };
+
+static void watch_write(uint32_t va, const void *src, size_t n)
+{
+    unsigned p, a, b;
+    if (fw_span(va, (uint32_t)n, &a, &b))
+        for (p = a; p <= b; ++p) {
+            if (fw_flag[p] & FW_ARMED) { fw_flag[p] &= ~FW_ARMED; ++fw_faults; }
+            fw_stamp[p] = ++fw_clock;
+        }
+    memcpy(ram + va, src, n);
+}
+
+static void watch_fill(uint32_t va, uint32_t value, unsigned count)
+{
+    unsigned i;
+    for (i = 0; i < count; ++i) watch_write(va + i * 4, &value, 4);
+}
+
+static TexEntry *entry_at(uint32_t addr, int volume)
+{
+    int b;
+    TexEntry *e;
+    for (b = 0; b < TEX_BUCKETS; ++b)
+        for (e = s_tex_bucket[b]; e; e = e->next)
+            if (e->phys == phys(addr) && !e->volume == !volume) return e;
+    return NULL;
+}
+
+static NvD3DTexture argb4(uint32_t addr)
+{
+    NvD3DTexture t;
+    memset(&t, 0, sizeof t);
+    t.addr = addr; t.color = 0x12; t.format = 0x00011200;
+    t.width = t.height = 4; t.pitch = 16; t.levels = 1;
+    return t;
+}
+
+static int test_write_watch(void)
+{
+    NvD3DTexture a = argb4(FW_BASE), b = argb4(FW_BASE + 0x100), c, d = argb4(0x20000);
+    NvD3DTexture e = argb4(FW_BASE + 0x8000), v;
+    ID3D11ShaderResourceView *va, *vb, *vc, *vd, *ve, *vv;
+    uint64_t h;
+    uint32_t value;
+    unsigned i;
+    s_prof_on = 1;
+    nv2a_d3d_set_write_watch(&fw_ops);
+
+    /* Two textures on one page. The first check hashes and arms both. */
+    watch_fill(a.addr, 0xFF112233u, 16);
+    watch_fill(b.addr, 0xFF445566u, 16);
+    va = texture_get(&a); vb = texture_get(&b);
+    CHECK(va && vb && read_mip(va, 0) == 0xFF112233u && read_mip(vb, 0) == 0xFF445566u);
+    h = s_prof_tex_hashes;
+    CHECK(h == 2);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && texture_get(&b) == vb);
+    CHECK(s_prof_tex_hashes == h && s_prof_watch_clean == 2);     /* neither re-read */
+    /* A write to b dirties the page: both re-read, only b changes. */
+    watch_fill(b.addr, 0xFF778899u, 16);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && texture_get(&b) == vb);
+    CHECK(s_prof_tex_hashes == h + 2);
+    CHECK(read_mip(va, 0) == 0xFF112233u && read_mip(vb, 0) == 0xFF778899u);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && texture_get(&b) == vb && s_prof_tex_hashes == h + 2);
+    /* Same kick: no second check at all. */
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 2);
+    puts("PASS: unwritten textures skip the hash; a write re-reads every texture on its page");
+
+    /* A paletted texture whose palette lies on another page. */
+    memset(&c, 0, sizeof c);
+    c.addr = FW_BASE + 0x2000; c.color = 0x0B; c.format = 0x02210B00;
+    c.width = c.height = 4; c.levels = 1; c.palette = FW_BASE + 0x5000; c.palette_len = 32;
+    {
+        uint8_t index[16];
+        memset(index, 7, sizeof index);
+        watch_write(c.addr, index, sizeof index);
+    }
+    watch_fill(c.palette + 7 * 4, 0xFFFF0000u, 1);
+    vc = texture_get(&c);
+    CHECK(vc && read_mip(vc, 0) == 0xFFFF0000u);
+    nv2a_d3d_kick();
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&c) == vc && s_prof_tex_hashes == h);
+    watch_fill(c.palette + 7 * 4, 0xFF00FF00u, 1);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&c) == vc && s_prof_tex_hashes == h + 1);
+    CHECK(read_mip(vc, 0) == 0xFF00FF00u);
+    puts("PASS: a palette write is seen through the palette's own page");
+
+    /* Outside the watched window: hashed at every kick, as without a watch. */
+    for (i = 0; i < 16; ++i) ((uint32_t *)(ram + d.addr))[i] = 0xFF0000FFu;
+    vd = texture_get(&d);
+    CHECK(vd && read_mip(vd, 0) == 0xFF0000FFu);
+    nv2a_d3d_kick();
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&d) == vd && s_prof_tex_hashes == h + 1);
+    puts("PASS: textures outside the watched window are hashed at every kick");
+
+    /* A writer the watch cannot see: normal mode keeps the old upload (the
+     * danger VERIFY exists for); verify mode reads, uploads and reports. */
+    value = 0xFFABCDEFu;
+    for (i = 0; i < 16; ++i) memcpy(ram + a.addr + i * 4, &value, 4);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && read_mip(va, 0) == 0xFF112233u);
+    nv2a_d3d_kick();
+    s_watch_verify = 1;
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 1);
+    CHECK(read_mip(va, 0) == 0xFFABCDEFu && s_watch_missed == 1);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && s_watch_missed == 1);           /* re-armed, now consistent */
+    nv2a_d3d_kick();
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 1 && s_watch_missed == 1);
+    s_watch_verify = 0;
+    puts("PASS: verify mode hashes clean textures, uploads like no watch and reports the miss");
+
+    /* Written on WATCH_STOP consecutive checks: hashed every kick for a while. */
+    for (i = 0; i < WATCH_STOP; ++i) {
+        value = 0xFF000000u + i;
+        watch_fill(a.addr, value, 16);
+        nv2a_d3d_kick();
+        CHECK(texture_get(&a) == va && read_mip(va, 0) == value);
+    }
+    CHECK(entry_at(a.addr, 0)->watch_retry != 0 && !entry_at(a.addr, 0)->watch_ok);
+    for (i = 0; i < 3; ++i) {
+        nv2a_d3d_kick();
+        h = s_prof_tex_hashes;
+        CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 1);
+    }
+    s_epoch += WATCH_RETRY_KICKS;
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 1);     /* re-arms */
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 1);     /* clean again */
+    puts("PASS: an entry written on 8 checks in a row is hashed until its retry kick");
+
+    /* A page that cannot be armed (a kernel-mode write in progress). */
+    watch_fill(e.addr, 0xFF123456u, 16);
+    fw_flag[(e.addr - FW_BASE) / 4096u] |= FW_PINNED;
+    ve = texture_get(&e);
+    CHECK(ve && !entry_at(e.addr, 0)->watch_ok);
+    nv2a_d3d_kick();
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&e) == ve && s_prof_tex_hashes == h + 1);
+    fw_flag[(e.addr - FW_BASE) / 4096u] &= ~FW_PINNED;
+    nv2a_d3d_kick();
+    CHECK(texture_get(&e) == ve && s_prof_tex_hashes == h + 2 && entry_at(e.addr, 0)->watch_ok);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&e) == ve && s_prof_tex_hashes == h + 2);
+    puts("PASS: incompletely armed textures are hashed until every page arms");
+
+    /* Volume textures use the same stamps. */
+    memset(&v, 0, sizeof v);
+    v.addr = FW_BASE + 0x10000; v.color = 0x06; v.format = 0x00031600;
+    v.width = v.height = 4; v.depth = 2; v.levels = 1;
+    watch_fill(v.addr, 0xFF808080u, 32);
+    vv = texture_get(&v);
+    CHECK(vv);
+    nv2a_d3d_kick();
+    h = s_prof_watch_clean;
+    CHECK(texture_get(&v) == vv && s_prof_watch_clean == h + 1);
+    watch_fill(v.addr + 64, 0xFF101010u, 1);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&v) == vv && s_prof_watch_clean == h + 1 && entry_at(v.addr, 1)->watch_streak == 1);
+    puts("PASS: volume textures skip unwritten checks and re-read written ones");
+
+    /* No watch: every kick hashes, as before. */
+    nv2a_d3d_set_write_watch(NULL);
+    nv2a_d3d_kick();
+    h = s_prof_tex_hashes;
+    CHECK(texture_get(&a) == va && texture_get(&b) == vb && s_prof_tex_hashes == h + 2);
+    nv2a_d3d_kick();
+    CHECK(texture_get(&a) == va && s_prof_tex_hashes == h + 3);
+    puts("PASS: without a watch every kick hashes exactly as before");
+    return 0;
+}
