+    malformed = submitted_uv; malformed.enabled = 0; assert(!map_route_vertex(&malformed, 18));
+    malformed = submitted_uv; malformed.data = NULL; assert(!map_route_vertex(&malformed, 18));
+    tag_name(18,2);
