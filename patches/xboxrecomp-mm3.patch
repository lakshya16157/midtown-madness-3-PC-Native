 }
 
+/* The same filter, bit for bit, at a fraction of the cost (it was over half
+ * of the voice processor's time with MM3's 3D voices):
+ * - coefficients and delay step toward their targets once per sample as
+ *   above, but once a step changes nothing, every later one is the same no-op
+ *   (each value has reached a fixed point of its update), so the rest of the
+ *   frame skips them;
+ * - the delay line is read from a linear copy instead of wrapping every tap;
+ * - four consecutive output samples run in the four lanes of one SSE vector.
+ *   Each lane does that sample's own multiplies and adds in the original
+ *   order, so every output is the same float. A block whose samples differ in
+ *   delay is done one sample at a time, in that same order. */
+static inline uint32_t hrtf_float_bits(float value)
+{
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+static inline void hrtf_filter_process(HrtfFilter *f, float in[][2], float out[][2])
+{
+    /* Rows and targets carry a 32nd, zero coefficient so they load in fours;
+     * it steps 0 -> 0 and no tap reads it. */
+    enum { N = HRTF_SAMPLES_PER_FRAME, T = HRTF_NUM_TAPS, B = HRTF_BUFLEN, P = 32 };
+    /* rows[0]: coefficients before the frame; rows[n + 1]: after sample n's
+     * step. Rows past `last` equal rows[last]. */
+    float rows[N + 1][2][P];
+    float tar[2][P];
+    float itd[N + 1];
+    float hist[2][B + N];
+    int last = N;
+    const int pos = f->buf_pos;
+    const __m128 alpha = _mm_set1_ps(HRTF_PARAM_SMOOTH_ALPHA);
+
+    for (int ch = 0; ch < 2; ch++) {
+        memcpy(rows[0][ch], f->ch[ch].hrir_coeff_cur, T * sizeof(float));
+        memcpy(tar[ch], f->ch[ch].hrir_coeff_tar, T * sizeof(float));
+        rows[0][ch][T] = tar[ch][T] = 0.0f;
+    }
+    itd[0] = f->itd_cur;
+    for (int n = 1; n <= N; n++) {
+        /* cur + alpha * (tar - cur), four at a time: the same three float
+         * operations as hrtf_filter_smooth_param, so the same results. */
+        __m128i changed = _mm_setzero_si128();
+        for (int ch = 0; ch < 2; ch++)
+            for (int k = 0; k < P; k += 4) {
+                __m128 cur = _mm_loadu_ps(&rows[n - 1][ch][k]);
+                __m128 next = _mm_add_ps(cur, _mm_mul_ps(alpha, _mm_sub_ps(_mm_loadu_ps(&tar[ch][k]), cur)));
+                _mm_storeu_ps(&rows[n][ch][k], next);
+                changed = _mm_or_si128(changed, _mm_xor_si128(_mm_castps_si128(next), _mm_castps_si128(cur)));
+            }
+        itd[n] = hrtf_filter_smooth_param(itd[n - 1], f->itd_tar);
+        if (_mm_movemask_epi8(_mm_cmpeq_epi32(changed, _mm_setzero_si128())) == 0xFFFF &&
+            hrtf_float_bits(itd[n]) == hrtf_float_bits(itd[n - 1])) {
+            last = n;
+            break;
+        }
+    }
+    for (int n = last + 1; n <= N; n++) itd[n] = itd[last];
+    /* The delay indexes the history. One outside it (never from the clamped
+     * targets) keeps the original arithmetic, wrap and all. */
+    for (int n = 1; n <= N; n++)
+        if (!(itd[n] >= -(float)HRTF_MAX_DELAY_SAMPLES && itd[n] <= (float)HRTF_MAX_DELAY_SAMPLES)) {
+            hrtf_filter_process_reference(f, in, out);
+            return;
+        }
+
+    /* Oldest first, then this frame's input at B + n: all of it is read
+     * before the first output is written (in and out may be one array). */
+    for (int ch = 0; ch < 2; ch++) {
+        memcpy(hist[ch], f->ch[ch].buf + pos, (size_t)(B - pos) * sizeof(float));
+        memcpy(hist[ch] + (B - pos), f->ch[ch].buf, (size_t)pos * sizeof(float));
+        for (int n = 0; n < N; n++) hist[ch][B + n] = in[n][ch];
+    }
+
+    int steady = 1;
+    for (int n = 2; n <= N && steady; n++)
+        steady = hrtf_float_bits(itd[n]) == hrtf_float_bits(itd[1]);
+    if (steady) {
+        /* One delay for the whole frame (the usual case): every tap of every
+         * sample interpolates the same pair of history samples with the same
+         * weights, s = x[i] * (1 - frac) + x[i - 1] * frac, so do that once
+         * per position; then sixteen samples at a time, four in each of four
+         * independent sums. */
+        float y[2][B + N];
+        const float *src[2];
+        int delay[2];
+        __m128 shared[2][P];
+        for (int ch = 0; ch < 2; ch++) {
+            float d = itd[1] * (ch == 0 ? +1.0f : -1.0f);
+            if (d < 0.0f) d = 0.0f;
+            delay[ch] = (int)d;
+            float frac = d - delay[ch];
+            src[ch] = hist[ch];
+            if (frac > 0.0f) {
+                const float w0 = 1 - frac;
+                for (int i = 1; i < B + N; i++)
+                    y[ch][i] = hist[ch][i] * w0 + hist[ch][i - 1] * frac;
+                src[ch] = y[ch];
+            }
+            for (int k = 0; k < T; k++) shared[ch][k] = _mm_set1_ps(rows[last][ch][k]);
+        }
+        for (int ch = 0; ch < 2; ch++)
+            for (int g = 0; g < N; g += 16) {
+                __m128 own[4][P];
+                const __m128 *cv[4];
+                const float *x[4];
