+/* The title drives the pad's two motors with a 6-byte output report: id 0,
+ * length 6, then the left (heavy, low-frequency) and right (light,
+ * high-frequency) motor speeds as little-endian 16-bit values -- XAPI's
+ * XINPUT_FEEDBACK.Rumble. It arrives on the interrupt OUT endpoint, or as a
+ * SET_REPORT on the control pipe; ohci.c hands both here. The speeds go to
+ * host pad n as they are -- XInput's two motors are the same pair on the same
+ * scale, and Steam Input passes them on to a PlayStation pad -- and only when
+ * they change. Whatever is still running is stopped when the process exits.
+ * RECOMP_RUMBLE=0 keeps the host pads still; the title's own vibration option
+ * decides the rest. */
+static uint32_t s_rumble[USB_GAMEPAD_MAX];   /* left << 16 | right, as last sent */
+static int s_rumble_reports;
+
+static void rumble_stop_all(void)
+{
+    int pad;
