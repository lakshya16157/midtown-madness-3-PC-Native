+void *recomp_lookup(ULONG address) { (void)address; abort(); }
+void *recomp_lookup_manual(ULONG address) { (void)address; abort(); }
+
+#define OPTIONS (XBOX_FILE_NON_DIRECTORY_FILE | XBOX_FILE_NO_INTERMEDIATE_BUFFERING)
+#define ACCESS (XBOX_GENERIC_READ | XBOX_SYNCHRONIZE | XBOX_FILE_READ_ATTRIBUTES)
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line=%d error=%lu: %s\n", __LINE__, GetLastError(), #x); goto done; } } while (0)
+
+static NTSTATUS open_asset(const char *path, HANDLE root, ULONG access,
+    ULONG share, ULONG options, HANDLE *handle)
+{
+    XBOX_ANSI_STRING name = {0};
+    XBOX_OBJECT_ATTRIBUTES oa = {0};
+    XBOX_IO_STATUS_BLOCK ios = {0};
+    NTSTATUS status;
+    name.Buffer = (PCHAR)path;
+    name.Length = (USHORT)strlen(path);
+    name.MaximumLength = name.Length + 1;
+    oa.RootDirectory = root;
+    oa.ObjectName = &name;
+    *handle = NULL;
+    status = xbox_NtCreateFile(handle, access, &oa, &ios, NULL, 0x80,
+        share, XBOX_FILE_OPEN, options);
+    if (ios.Status != status || (status && ios.Information)) abort();
+    return status;
+}
+
+static ULONG mode(HANDLE handle)
+{
+    typedef NTSTATUS (NTAPI *query_fn)(HANDLE, PXBOX_IO_STATUS_BLOCK, PVOID, ULONG, ULONG);
+    query_fn query = (query_fn)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtQueryInformationFile");
+    XBOX_IO_STATUS_BLOCK ios = {0};
+    ULONG value = 0xFFFFFFFFu;
+    if (!query || query(handle, &ios, &value, sizeof value, 16) < 0) abort();
+    return value;
+}
+
+/* Only descend through directories created inside this freshly allocated
+ * private fixture. No game/save directory is ever passed to this function. */
+static void remove_fixture(const WCHAR *directory)
+{
+    WCHAR pattern[MAX_PATH], child[MAX_PATH];
+    WIN32_FIND_DATAW item;
+    HANDLE find;
+    swprintf_s(pattern, MAX_PATH, L"%s\\*", directory);
+    find = FindFirstFileW(pattern, &item);
+    if (find != INVALID_HANDLE_VALUE) {
+        do {
+            if (!wcscmp(item.cFileName, L".") || !wcscmp(item.cFileName, L"..")) continue;
+            swprintf_s(child, MAX_PATH, L"%s\\%s", directory, item.cFileName);
+            if (item.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) remove_fixture(child);
+            else DeleteFileW(child);
+        } while (FindNextFileW(find, &item));
+        FindClose(find);
+    }
+    RemoveDirectoryW(directory);
+}
+
+static int fixture(WCHAR *folder, char *utf8)
+{
+    WCHAR base[MAX_PATH];
+    if (!GetTempPathW(MAX_PATH, base) || !GetTempFileNameW(base, L"xfb", 0, folder) ||
+        !DeleteFileW(folder) || !CreateDirectoryW(folder, NULL)) return 0;
+    return WideCharToMultiByte(CP_UTF8, 0, folder, -1, utf8, MAX_PATH * 4, NULL, NULL) != 0;
+}
