diff --git a/src/input/input_bindings.h b/src/input/input_bindings.h
new file mode 100644
index 0000000..3ad9f2a
--- /dev/null
+++ b/src/input/input_bindings.h
@@ -0,0 +1,161 @@
+/* Input configuration shared by the native keyboard and controller paths.
+ * Parsing is transactional: malformed entries retain the complete previous
+ * map. Values are checked within their comma-delimited entry, never masked. */
+#ifndef XBOX_INPUT_BINDINGS_H
+#define XBOX_INPUT_BINDINGS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum {
+    XB_KEY_A, XB_KEY_B, XB_KEY_X, XB_KEY_Y, XB_KEY_WHITE, XB_KEY_BLACK,
+    XB_KEY_LT, XB_KEY_RT, XB_KEY_START, XB_KEY_BACK,
+    XB_KEY_UP, XB_KEY_DOWN, XB_KEY_LEFT, XB_KEY_RIGHT, XB_KEY_LS, XB_KEY_RS,
+    XB_KEY_LX_NEG, XB_KEY_LX_POS, XB_KEY_LY_NEG, XB_KEY_LY_POS,
+    XB_KEY_RX_NEG, XB_KEY_RX_POS, XB_KEY_RY_NEG, XB_KEY_RY_POS, XB_KEY_COUNT
+};
+enum {
+    XB_DRIVE_THROTTLE, XB_DRIVE_BRAKE, XB_DRIVE_LEFT, XB_DRIVE_RIGHT,
+    XB_DRIVE_HANDBRAKE, XB_DRIVE_GEAR_UP, XB_DRIVE_GEAR_DOWN,
+    XB_DRIVE_CAMERA, XB_DRIVE_COUNT
+};
+enum {
+    XB_PAD_A, XB_PAD_B, XB_PAD_X, XB_PAD_Y, XB_PAD_BLACK, XB_PAD_WHITE,
+    XB_PAD_START, XB_PAD_BACK, XB_PAD_LS, XB_PAD_RS,
+    XB_PAD_UP, XB_PAD_DOWN, XB_PAD_LEFT, XB_PAD_RIGHT, XB_PAD_LT, XB_PAD_RT,
+    XB_PAD_COUNT, XB_PAD_NONE = 255
+};
+
+static const char *const xb_key_names[XB_KEY_COUNT] = {
+    "A", "B", "X", "Y", "WHITE", "BLACK", "LT", "RT", "START", "BACK",
+    "UP", "DOWN", "LEFT", "RIGHT", "LS", "RS",
+    "LX-", "LX+", "LY-", "LY+", "RX-", "RX+", "RY-", "RY+"
+};
+static const char *const xb_drive_names[XB_DRIVE_COUNT] = {
+    "THROTTLE", "BRAKE", "LEFT", "RIGHT", "HANDBRAKE", "GEAR_UP",
+    "GEAR_DOWN", "CAMERA"
+};
+static const char *const xb_pad_names[XB_PAD_COUNT] = {
+    "A", "B", "X", "Y", "BLACK", "WHITE", "START", "BACK", "LS", "RS",
+    "UP", "DOWN", "LEFT", "RIGHT", "LT", "RT"
+};
+/* Source indices differ from Xbox target indices only at the shoulders. */
+static const char *const xb_pad_sources[XB_PAD_COUNT] = {
+    "A", "B", "X", "Y", "LB", "RB", "START", "BACK", "LS", "RS",
+    "UP", "DOWN", "LEFT", "RIGHT", "LT", "RT"
+};
+
+typedef struct XbInputBindings {
+    uint16_t keys[XB_KEY_COUNT];
+    uint16_t drive[XB_DRIVE_COUNT];
+    uint16_t pad[XB_PAD_COUNT];
+} XbInputBindings;
+
+static void xb_bindings_defaults(XbInputBindings *map)
+{
+    /* Numeric Win32 virtual keys keep parsing independent of Windows headers. */
+    static const uint16_t keys[XB_KEY_COUNT] = {
+        'Z', 'X', 'A', 'S', 'Q', 'E', '1', '3', 0x0d, 0x08,
+        0x26, 0x28, 0x25, 0x27, 0x10, 0x11,
+        0x64, 0x66, 0x62, 0x68, 'J', 'L', 'K', 'I'
+    };
+    static const uint16_t drive[XB_DRIVE_COUNT] = {
+        0x26, 0x28, 0x25, 0x27, 0x20, 'R', 'F', 'C'
+    };
+    memcpy(map->keys, keys, sizeof(keys));
+    memcpy(map->drive, drive, sizeof(drive));
+    for (unsigned i = 0; i < XB_PAD_COUNT; ++i) map->pad[i] = (uint16_t)i;
+    map->pad[XB_PAD_BLACK] = 5; /* Black <- RB; White <- LB. */
+    map->pad[XB_PAD_WHITE] = 4;
+}
+
+static int xb_binding_name(const char *begin, const char *end, const char *name)
+{
+    if ((size_t)(end - begin) != strlen(name)) return 0;
+    for (; begin != end; ++begin, ++name) {
+        unsigned char a = (unsigned char)*begin, b = (unsigned char)*name;
+        if (a >= 'a' && a <= 'z') a = (unsigned char)(a - 'a' + 'A');
+        if (b >= 'a' && b <= 'z') b = (unsigned char)(b - 'a' + 'A');
+        if (a != b) return 0;
+    }
+    return 1;
+}
+
+static void xb_binding_trim(const char **begin, const char **end)
+{
+    while (*begin != *end && (**begin == ' ' || **begin == '\t')) ++*begin;
+    while (*begin != *end && ((*end)[-1] == ' ' || (*end)[-1] == '\t')) --*end;
+}
+
+static int xb_binding_index(const char *begin, const char *end,
+                            const char *const *names, unsigned count)
+{
+    for (unsigned i = 0; i < count; ++i)
+        if (xb_binding_name(begin, end, names[i])) return (int)i;
+    return -1;
+}
+
+static int xb_binding_vk(const char *begin, const char *end, uint16_t *value)
+{
+    unsigned result = 0, digits = 0;
+    if (xb_binding_name(begin, end, "NONE")) { *value = 0; return 1; }
+    if (end - begin >= 2 && begin[0] == '0' && (begin[1] == 'x' || begin[1] == 'X'))
+        begin += 2;
+    for (; begin != end; ++begin) {
+        unsigned char c = (unsigned char)*begin;
+        unsigned digit;
+        if (c >= '0' && c <= '9') digit = c - '0';
+        else if (c >= 'a' && c <= 'f') digit = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') digit = c - 'A' + 10;
+        else return 0;
+        if (++digits > 2) return 0;
+        result = result * 16 + digit;
+    }
+    /* The framebuffer consumes F10/F11 for settings/fullscreen before its
+     * held-key table. Reject unusable bindings instead of silently saving them. */
+    if (!digits || result == 0x79 || result == 0x7a) return 0;
+    *value = (uint16_t)result;
+    return 1;
+}
+
+/* Duplicate target entries are ambiguous and rejected. Sharing a source key
+ * or button across different targets is intentional and remains supported. */
+static int xb_bindings_parse(const char *text, const char *const *names,
+                             unsigned count, uint16_t *destination, int pad)
+{
+    uint16_t pending[XB_KEY_COUNT];
+    uint32_t seen = 0;
+    if (!text || !*text) return 1;
+    if (count > XB_KEY_COUNT) return 0;
+    memcpy(pending, destination, count * sizeof(*pending));
+    const char *entry = text;
+    for (;;) {
+        const char *comma = strchr(entry, ',');
+        const char *end = comma ? comma : entry + strlen(entry);
+        const char *colon = memchr(entry, ':', (size_t)(end - entry));
+        if (!colon || memchr(colon + 1, ':', (size_t)(end - colon - 1))) return 0;
+        const char *name_begin = entry, *name_end = colon;
+        const char *value_begin = colon + 1, *value_end = end;
+        xb_binding_trim(&name_begin, &name_end);
+        xb_binding_trim(&value_begin, &value_end);
+        int index = xb_binding_index(name_begin, name_end, names, count);
+        if (index < 0 || (seen & (1u << index))) return 0;
+        seen |= 1u << index;
+        uint16_t value;
+        if (pad) {
+            int source = xb_binding_index(value_begin, value_end, xb_pad_sources, XB_PAD_COUNT);
+            if (xb_binding_name(value_begin, value_end, "NONE")) value = XB_PAD_NONE;
+            else if (source < 0) return 0;
+            else value = (uint16_t)source;
+        } else if (!xb_binding_vk(value_begin, value_end, &value)) return 0;
+        pending[index] = value;
+        if (!comma) break;
+        entry = comma + 1;
+        if (!*entry) return 0;
+    }
+    memcpy(destination, pending, count * sizeof(*pending));
+    return 1;
+}
+
+#endif
