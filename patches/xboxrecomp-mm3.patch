+static void check_pipeline(D3D11_PRIMITIVE_TOPOLOGY topology, ID3D11RasterizerState *rs,
+                           UINT count, const D3D11_RECT *rects, ID3D11BlendState *blend,
+                           const float factor[4], UINT mask, ID3D11DepthStencilState *depth,
+                           UINT stencil)
+{
+    ID3D11RasterizerState *actual_rs=NULL; ID3D11BlendState *actual_blend=NULL;
+    ID3D11DepthStencilState *actual_depth=NULL; D3D11_PRIMITIVE_TOPOLOGY actual_topology;
+    D3D11_RECT actual_rects[16]; UINT actual_count=16,actual_mask,actual_stencil;
+    float actual_factor[4];
+    ID3D11DeviceContext_IAGetPrimitiveTopology(s_ctx,&actual_topology);
+    ID3D11DeviceContext_RSGetState(s_ctx,&actual_rs);
+    ID3D11DeviceContext_RSGetScissorRects(s_ctx,&actual_count,actual_rects);
+    ID3D11DeviceContext_OMGetBlendState(s_ctx,&actual_blend,actual_factor,&actual_mask);
+    ID3D11DeviceContext_OMGetDepthStencilState(s_ctx,&actual_depth,&actual_stencil);
+    if(actual_topology!=topology || actual_rs!=rs || actual_blend!=blend || actual_depth!=depth)
+        fprintf(stderr,"pipeline actual/expected topology %u/%u rs %p/%p blend %p/%p depth %p/%p\n",
+                actual_topology,topology,actual_rs,rs,actual_blend,blend,actual_depth,depth);
+    CHECK(actual_topology==topology && actual_rs==rs && actual_blend==blend && actual_depth==depth);
+    if(actual_count!=count || (count && memcmp(actual_rects,rects,count*sizeof *rects)))
+        fprintf(stderr,"scissor actual/expected count %u/%u first {%ld,%ld,%ld,%ld}/{%ld,%ld,%ld,%ld}\n",
+                actual_count,count,actual_rects[0].left,actual_rects[0].top,actual_rects[0].right,actual_rects[0].bottom,
+                rects[0].left,rects[0].top,rects[0].right,rects[0].bottom);
+    CHECK(actual_count==count && (!count || !memcmp(actual_rects,rects,count*sizeof *rects)));
+    CHECK(actual_mask==mask && !memcmp(actual_factor,factor,sizeof actual_factor));
+    CHECK(actual_stencil==(stencil&255)); /* D3D11 stores the low eight stencil bits. */
+    if(actual_rs) ID3D11RasterizerState_Release(actual_rs);
+    if(actual_blend) ID3D11BlendState_Release(actual_blend);
+    if(actual_depth) ID3D11DepthStencilState_Release(actual_depth);
+}
