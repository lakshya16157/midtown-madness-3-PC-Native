+        if (s_rumble[pad]) {
+            XBOX_VIBRATION still = {0, 0};
+            s_rumble[pad] = 0;
+            xbox_InputSetState((DWORD)pad, &still);
+        }
+}
+
+int usb_gamepad_output(int pad, const uint8_t *data, int len)
+{
+    static int enabled = -1;
+    XBOX_VIBRATION v;
+    uint32_t value;
+    if (pad < 0 || pad >= USB_GAMEPAD_MAX || !data || len < 6 || data[0] != 0 || data[1] < 6)
