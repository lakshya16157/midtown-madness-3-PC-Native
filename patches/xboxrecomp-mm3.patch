+        CHECK(trace_clocks==6&&trace_frequencies==1);
+        CHECK(m->calls==2&&m->bytes==sizeof data*2&&m->failures==1);
+        CHECK(m->discard==2&&m->unmap_calls==1&&m->last_hr==S_OK);
