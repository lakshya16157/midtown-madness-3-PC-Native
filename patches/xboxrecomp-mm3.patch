+    char buffer[16384] = {0};
+    size_t used = 0;
+    bool cpu_valid;
+    uint64_t cycles = apu_dsp_trace_cpu_delta(e.cpu_begin, e.cpu_end, &cpu_valid);
+    unsigned valid = e.begin.valid | (e.posted.valid << 1) | (e.end.valid << 2);
+    bool fit = audio_dsp_trace_append(buffer, sizeof(buffer), &used,
+        "[AUDIO_DSP_TRACE] frequency=%lld thread=%lu begin_qpc=%lld posted_qpc=%lld end_qpc=%lld "
+        "producer_valid=%u producer_cycles=%llu producer_cycles_valid=%d generation=%u div=%u synchronous=%d "
+        "waits=%u jobs=%u suppressed=%u line=%u limit=%u",
+        (long long)t->frequency, (unsigned long)GetCurrentThreadId(),
+        (long long)e.begin.qpc, (long long)e.posted.qpc, (long long)e.end.qpc,
+        valid, (unsigned long long)cycles, cpu_valid, e.generation, e.div, e.synchronous,
+        e.wait_count, e.history_count, t->suppressed, t->reports, APU_DSP_TRACE_MAX_REPORTS);
+    for (unsigned i = 0; fit && i < e.wait_count; ++i) {
+        APUDSPTraceWait *w = &e.waits[i];
+        valid = w->begin.valid | (w->acquired.valid << 1) | (w->drained.valid << 2) |
+                (w->released.valid << 3) | (w->relocked.valid << 4);
+        fit = audio_dsp_trace_append(buffer, sizeof(buffer), &used,
+            " w%u=%u,%u,%u,%lld,%lld,%lld,%lld,%lld,%u", i, w->reason, w->depth, w->wakes,
+            (long long)w->begin.qpc, (long long)w->acquired.qpc, (long long)w->drained.qpc,
+            (long long)w->released.qpc, (long long)w->relocked.qpc, valid);
+    }
+    for (unsigned i = 0; fit && i < e.history_count; ++i) {
+        APUDSPTraceJob *j = &e.history[i];
+        valid = j->posted.valid | (j->enqueued.valid << 1) | (j->dequeued.valid << 2) |
+                (j->locked.valid << 3) | (j->serviced.valid << 4) | (j->completed.valid << 5);
+        cycles = apu_dsp_trace_cpu_delta(j->cpu_begin, j->cpu_end, &cpu_valid);
+        fit = audio_dsp_trace_append(buffer, sizeof(buffer), &used,
+            " j%u=%llu,%u,%u,%u,%u,%lld,%lld,%lld,%lld,%lld,%lld,%u,%llu,%u", i,
+            (unsigned long long)j->id, j->generation, j->div, j->depth,
+            (unsigned)j->synchronous | ((unsigned)j->executed << 1),
+            (long long)j->posted.qpc, (long long)j->enqueued.qpc, (long long)j->dequeued.qpc,
+            (long long)j->locked.qpc, (long long)j->serviced.qpc, (long long)j->completed.qpc,
+            valid, (unsigned long long)cycles, (unsigned)cpu_valid);
+    }
+    fprintf(stderr, "%s truncated=%d\n", buffer, !fit);
+    if (fenv_valid) fesetenv(&saved_fenv);
