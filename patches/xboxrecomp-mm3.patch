+/* One instruction, exactly as the hardware pairs its units. Returns its
+ * FINAL flag. Shared by full and position-only runs so both compute every
+ * value with the same operations in the same order. */
+static int vsh_step(const uint32_t *ins, const float in[NV2A_VSH_INPUTS][4],
+                    vec4 *temp, vec4 *opos, float outregs[13][4], int *a0)
