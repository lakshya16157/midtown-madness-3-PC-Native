diff --git a/tests/dsp/dsp_handoff_test.c b/tests/dsp/dsp_handoff_test.c
new file mode 100644
index 0000000..7b874fb
--- /dev/null
+++ b/tests/dsp/dsp_handoff_test.c
@@ -0,0 +1,202 @@
+/* Real condition waits with controlled publication/acquisition races. Test the
+ * production handoff helpers; only scheduling checkpoints are intercepted. */
+#include "../../src/nv2a/qemu_shim.h"
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "DSP handoff line %d: %s\n", __LINE__, #c); exit(1); } } while (0)
+typedef struct MCPXAPUState {
+    QemuMutex lock, dsp_lock;
+    QemuCond dsp_control_done_cond;
+    bool dsp_handoff_enabled;
+    volatile LONG dsp_control_pending;
+    volatile LONG dsp_control_completed;
+    volatile bool exiting;
+    unsigned generation;
+} MCPXAPUState;
+static MCPXAPUState state;
+static HANDLE worker_locked, start_checkpoint, allow_publish, published;
+static HANDLE allow_acquire, acquired, release_control, waiting, waiting_again;
+static HANDLE publish_next;
+static volatile LONG wait_calls, quanta, yields, late_check;
+static DWORD controller_tid;
+static bool reset_control, late_request;
+static unsigned flood_count, forced_epoch;
+
+static void checked_wait(HANDLE event)
+{ CHECK(WaitForSingleObject(event, 2000) == WAIT_OBJECT_0); }
+static void observed_lock(QemuMutex *mutex)
+{
+    if (mutex == &state.dsp_lock && GetCurrentThreadId() == controller_tid) {
+        CHECK(InterlockedCompareExchange(&state.dsp_control_pending, 0, 0) == 1);
+        SetEvent(published); /* Request is visible before mutex acquisition. */
+        checked_wait(allow_acquire);
+    }
+    qemu_mutex_lock(mutex);
+}
+static void observed_wait(QemuCond *condition, QemuMutex *mutex)
+{
+    CHECK(condition == &state.dsp_control_done_cond && mutex == &state.dsp_lock);
+    if (InterlockedIncrement(&wait_calls) >= 2) SetEvent(waiting_again);
+    SetEvent(waiting);
+    qemu_cond_wait(condition, mutex);
+    LONG completed = InterlockedCompareExchange(&state.dsp_control_completed, 0, 0);
+    if (flood_count && completed > (LONG)forced_epoch && completed < (LONG)flood_count) {
+        /* Still holding dsp_lock after the wait: force the next poll to be
+         * published before the worker checks the completed predicate again. */
+        forced_epoch = (unsigned)completed;
+        ResetEvent(published);
+        SetEvent(publish_next);
+        checked_wait(published);
+    }
+}
+static LONG observed_read(volatile LONG *value, LONG exchange, LONG comparand)
+{
+    LONG result = InterlockedCompareExchange(value, exchange, comparand);
+    if (value == &state.dsp_control_pending && !result && InterlockedExchange(&late_check, 0)) {
+        /* A request arrives immediately after the worker read zero. */
+        SetEvent(allow_publish);
+        checked_wait(published);
+    }
+    return result;
+}
+static void observed_sleep(DWORD ms)
+{ CHECK(ms == 0); InterlockedIncrement(&yields); Sleep(ms); }
+#define qemu_mutex_lock observed_lock
+#define qemu_cond_wait observed_wait
+#pragma push_macro("InterlockedCompareExchange")
+#undef InterlockedCompareExchange
+#define InterlockedCompareExchange observed_read
+#define Sleep observed_sleep
+#include "../../src/apu/apu_dsp_handoff.h"
+#undef Sleep
+#undef InterlockedCompareExchange
+#pragma pop_macro("InterlockedCompareExchange")
+#undef qemu_cond_wait
+#undef qemu_mutex_lock
+
+static DWORD WINAPI controller(void *unused)
+{
+    (void)unused;
+    controller_tid = GetCurrentThreadId();
+    checked_wait(allow_publish);
+    for (unsigned request = 0; request < (flood_count ? flood_count : 1u); ++request) {
+    if (request) checked_wait(publish_next);
+    qemu_mutex_lock(&state.lock);
+    apu_dsp_control_lock(&state);
+    SetEvent(acquired);
+    checked_wait(release_control);
+    if (flood_count) CHECK(quanta == (LONG)request);
+    if (reset_control) ++state.generation;
+    apu_dsp_control_unlock(&state);
+    qemu_mutex_unlock(&state.lock);
+    }
+    return 0;
+}
+static DWORD WINAPI worker(void *unused)
+{
+    (void)unused;
+    qemu_mutex_lock(&state.dsp_lock);
+    unsigned generation = state.generation;
+    SetEvent(worker_locked);
+    checked_wait(start_checkpoint);
+    for (unsigned step = 0; step < (flood_count ? flood_count : late_request ? 2u : 1u); ++step) {
+        apu_dsp_quantum_handoff(&state);
+        /* Same abort predicates as run_dsp_frame, before another quantum. */
+        if (generation != state.generation || state.exiting) break;
+        InterlockedIncrement(&quanta);
+    }
+    qemu_mutex_unlock(&state.dsp_lock);
+    return 0;
+}
+static void init(void)
+{
+    qemu_mutex_init(&state.lock);
+    qemu_mutex_init(&state.dsp_lock);
+    HANDLE *events[] = {&worker_locked, &start_checkpoint, &allow_publish, &published,
+        &allow_acquire, &acquired, &release_control, &waiting, &waiting_again};
+    for (unsigned i = 0; i < sizeof(events) / sizeof(events[0]); ++i) {
+        *events[i] = CreateEventA(NULL, TRUE, FALSE, NULL);
+        CHECK(*events[i]);
+    }
+    publish_next = CreateEventA(NULL, FALSE, FALSE, NULL); CHECK(publish_next);
+}
+static void cleanup(void)
+{
+    CHECK(!state.dsp_control_pending);
+    apu_dsp_handoff_destroy(&state);
+    qemu_mutex_destroy(&state.dsp_lock);
+    qemu_mutex_destroy(&state.lock);
+    HANDLE events[] = {worker_locked, start_checkpoint, allow_publish, published,
+        allow_acquire, acquired, release_control, waiting, waiting_again};
+    for (unsigned i = 0; i < sizeof(events) / sizeof(events[0]); ++i) CloseHandle(events[i]);
+    CloseHandle(publish_next);
+}
+int main(int argc, char **argv)
+{
+    CHECK(argc == 2);
+    init();
+    if (!strcmp(argv[1], "uncontended")) {
+        /* DefaultOFF keeps the original yield, with no pending publication. */
+        apu_dsp_handoff_init(&state, 0);
+        qemu_mutex_lock(&state.lock);
+        apu_dsp_control_lock(&state);
+        CHECK(!state.dsp_control_pending);
+        apu_dsp_control_unlock(&state);
+        qemu_mutex_unlock(&state.lock);
+        qemu_mutex_lock(&state.dsp_lock);
+        apu_dsp_quantum_handoff(&state);
+        qemu_mutex_unlock(&state.dsp_lock);
+        CHECK(yields == 1 && !wait_calls);
+        apu_dsp_handoff_destroy(&state);
+        apu_dsp_handoff_init(&state, 1);
+        qemu_mutex_lock(&state.dsp_lock);
+        for (unsigned i = 0; i < 100; ++i) apu_dsp_quantum_handoff(&state);
+        qemu_mutex_unlock(&state.dsp_lock);
+        CHECK(yields == 1 && !wait_calls);
+    } else {
+        bool shutdown = !strcmp(argv[1], "shutdown");
+        reset_control = !strcmp(argv[1], "reset");
+        late_request = !strcmp(argv[1], "late");
+        flood_count = !strcmp(argv[1], "flood") ? 32 : 0;
+        CHECK(shutdown || reset_control || late_request || flood_count || !strcmp(argv[1], "fairness"));
+        apu_dsp_handoff_init(&state, 1);
+        HANDLE work = CreateThread(NULL, 0, worker, NULL, 0, NULL);
+        HANDLE control = CreateThread(NULL, 0, controller, NULL, 0, NULL);
+        CHECK(work && control);
+        checked_wait(worker_locked);
+        if (late_request) InterlockedExchange(&late_check, 1);
+        else { SetEvent(allow_publish); checked_wait(published); }
+        SetEvent(start_checkpoint);
+        checked_wait(waiting);
+        CHECK(quanta == (late_request ? 1 : 0));
+        if (shutdown) {
+            state.exiting = true;
+            apu_dsp_handoff_shutdown_wake(&state);
+            checked_wait(work);
+            CHECK(!quanta); /* Explicit shutdown wake does not need controller progress. */
+        } else if (!flood_count) {
+            /* Wake without acknowledging the request. It must recheck and
+             * sleep again rather than execute another DSP quantum. */
+            qemu_mutex_lock(&state.dsp_lock);
+            qemu_cond_broadcast(&state.dsp_control_done_cond);
+            qemu_mutex_unlock(&state.dsp_lock);
+            checked_wait(waiting_again);
+            CHECK(quanta == (late_request ? 1 : 0));
+        }
+        SetEvent(allow_acquire);
+        checked_wait(acquired);
+        CHECK(quanta == (late_request ? 1 : 0));
+        SetEvent(release_control);
+        checked_wait(control);
+        checked_wait(work);
+        CHECK(quanta == (shutdown || reset_control ? 0 : flood_count ? (LONG)flood_count : late_request ? 2 : 1));
+        if (flood_count) CHECK(forced_epoch == flood_count - 1 && state.dsp_control_completed == (LONG)flood_count);
+        CHECK(!yields && state.generation == (reset_control ? 1u : 0u));
+        CloseHandle(control); CloseHandle(work);
+    }
+    cleanup();
+    printf("DSP handoff %s passed\n", argv[1]);
+    return 0;
+}
diff --git a/tests/dsp/dsp_interrupt_fastpath_test.c b/tests/dsp/dsp_interrupt_fastpath_test.c
new file mode 100644
index 0000000..f0adcc2
--- /dev/null
+++ b/tests/dsp/dsp_interrupt_fastpath_test.c
@@ -0,0 +1,59 @@
+/* Compare the instruction-boundary fast path with the unchanged full handler.
+ * Include the production source to exercise its private interrupt pipeline
+ * without exposing an extra runtime API or substituting an interrupt model. */
+#include "../../src/apu/dsp/interp/dsp_cpu.c"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "Interrupt fast-path check line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+int main(void)
+{
+    dsp_core_t *initial = calloc(1, sizeof *initial);
+    dsp_core_t *reference = malloc(sizeof *reference);
+    dsp_core_t *actual = malloc(sizeof *actual);
+    CHECK(initial && reference && actual);
+    dsp56k_reset_cpu(initial);
+    initial->pc = 0x100;
+    initial->interrupt_save_pc = 0x101;
+    initial->interrupt_instr_fetch = 8;
+    initial->interrupt_ipl_to_raise = 2;
+    initial->registers[DSP_REG_LC] = 3;
+    initial->registers[DSP_REG_LA] = 0x110;
+    /* Long-vector entry exercises stack and SR changes during the pipeline. */
+    initial->pram[8] = 0x0d0200;
+    initial->pram[9] = 0;
+
+    const unsigned pending_masks[] = {0, 1, 8, 15};
+    unsigned cases = 0;
+    for (unsigned state = DSP_INTERRUPT_NONE; state <= DSP_INTERRUPT_LONG; ++state)
+    for (unsigned pipeline = 0; pipeline <= 6; ++pipeline)
+    for (unsigned rep = 0; rep <= 2; ++rep)
+    for (unsigned flags = 0; flags < 8; ++flags)
+    for (unsigned compatibility = 0; compatibility < 2; ++compatibility)
+    for (unsigned mask = 0; mask < ARRAY_SIZE(pending_masks); ++mask) {
+        *reference = *initial;
+        reference->interrupt_state = (uint16_t)state;
+        reference->interrupt_pipeline_count = (uint16_t)pipeline;
+        reference->loop_rep = rep;
+        reference->is_stopped = (flags & 1) != 0;
+        reference->is_debugging = (flags & 2) != 0;
+        reference->is_waiting = (flags & 4) != 0;
+        reference->registers[DSP_REG_SR] =
+            (compatibility << DSP_SR_SC) | ((pipeline & 3) << DSP_SR_I0);
+        reference->interrupt_counter = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            reference->interrupt_is_pending[i] = (pending_masks[mask] >> i) & 1;
+            reference->interrupt_counter += reference->interrupt_is_pending[i];
+            reference->interrupt_ipl[i] = (int16_t)i;
+        }
+        *actual = *reference;
+        dsp_postexecute_interrupts(reference);
+        dsp_postexecute_interrupts_if_needed(actual);
+        CHECK(!memcmp(reference, actual, sizeof *actual));
+        ++cases;
+    }
+    printf("Interrupt fast path exact full-state equivalence passed: %u cases\n", cases);
+    free(initial); free(reference); free(actual);
+    return 0;
+}
diff --git a/tests/dsp/dsp_pcm_queue_test.c b/tests/dsp/dsp_pcm_queue_test.c
new file mode 100644
index 0000000..b379753
--- /dev/null
+++ b/tests/dsp/dsp_pcm_queue_test.c
@@ -0,0 +1,120 @@
+#include "apu_state.h"
+
+#define CHECK(condition) do { if (!(condition)) { \
+    fprintf(stderr, "PCM queue check failed at line %d: %s\n", __LINE__, #condition); \
+    exit(1); } } while (0)
+
+struct McpxApuDebug g_dbg;
+int dsp_test_fail_alloc;
+uint8_t *g_apu_ram_ptr;
+uint8_t *mcpx_apu_phys(uint64_t address)
+{
+    (void)address;
+    CHECK(0); /* Queue-only checks must not read or write guest memory. */
+    return NULL;
+}
+
+extern uint64_t dsp_test_pcm_allocations, dsp_test_pcm_copied, dsp_test_pcm_moved;
+void dsp_test_publish_pcm_frame(MCPXAPUState *d, const uint8_t *pcm);
+
+static void fill_frame(uint8_t *frame, unsigned sequence)
+{
+    for (unsigned i = 0; i < 1024; i++)
+        frame[i] = (uint8_t)(sequence * 17 + i * 23 + (sequence >> 8));
+}
+
+static void publish(MCPXAPUState *d, unsigned sequence)
+{
+    uint8_t frame[1024];
+    fill_frame(frame, sequence);
+    dsp_test_publish_pcm_frame(d, frame);
+}
+
+static void check_frame(MCPXAPUState *d, unsigned sequence)
+{
+    uint8_t frame[1024];
+    fill_frame(frame, sequence);
+    CHECK(!memcmp(d->monitor.frame_buf, frame, sizeof(frame)));
+}
+
+int main(void)
+{
+    MCPXAPUState *d = calloc(1, sizeof(*d));
+    CHECK(d);
+
+    /* Move the head, wrap at the old end, fail a growth, then grow the
+     * wrapped queue. Every retained frame must remain in its original order. */
+    for (unsigned i = 0; i < 5; i++) publish(d, i);
+    CHECK(d->monitor.ep_pcm_capacity == 4096);
+    for (unsigned i = 0; i < 3; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    for (unsigned i = 5; i < 8; i++) publish(d, i);
+    uint64_t dropped = d->monitor.ep_pcm_dropped_frames;
+    dsp_test_fail_alloc = 1;
+    publish(d, 99);
+    dsp_test_fail_alloc = 0;
+    CHECK(d->monitor.ep_pcm_capacity == 4096);
+    CHECK(d->monitor.ep_pcm_queued == 4096);
+    CHECK(d->monitor.ep_pcm_dropped_frames == dropped + 1);
+    publish(d, 8);
+    CHECK(d->monitor.ep_pcm_capacity == 8192);
+    for (unsigned i = 3; i < 9; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    CHECK(!d->monitor.ep_pcm_ready && !d->monitor.ep_pcm_queued);
+    CHECK(!d->monitor.ep_pcm_head);
+
+    /* Compare a stream of bursts, consumes and overflows to an independent
+     * FIFO model. The model stores sequence numbers rather than PCM offsets. */
+    unsigned model[65], count = 0;
+    uint32_t random = 0x762d81ab;
+    for (unsigned sequence = 0; sequence < 20000; sequence++) {
+        random = random * 1664525u + 1013904223u;
+        if ((random >> 28) < 5) {
+            if (count) {
+                check_frame(d, model[0]);
+                memmove(model, model + 1, --count * sizeof(*model));
+            }
+            mcpx_apu_dsp_pcm_consumed(d);
+        } else {
+            uint64_t drops_before = d->monitor.ep_pcm_dropped_frames;
+            publish(d, sequence);
+            if (count < 65) {
+                model[count++] = sequence;
+                CHECK(d->monitor.ep_pcm_dropped_frames == drops_before);
+            } else CHECK(d->monitor.ep_pcm_dropped_frames == drops_before + 1);
+        }
+        CHECK(d->monitor.ep_pcm_ready == (count != 0));
+        CHECK(d->monitor.ep_pcm_queued == (count ? count - 1 : 0) * 1024);
+        CHECK(d->monitor.ep_pcm_capacity <= 65536);
+        if (count) check_frame(d, model[0]);
+    }
+    while (count) {
+        check_frame(d, model[0]);
+        memmove(model, model + 1, --count * sizeof(*model));
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+
+    /* Consumption copies only the next frame even with a full backlog.
+     * Allocation growth from zero through 64 frames takes seven allocations. */
+    free(d->monitor.ep_pcm_queue);
+    memset(&d->monitor, 0, sizeof(d->monitor));
+    dsp_test_pcm_allocations = dsp_test_pcm_copied = dsp_test_pcm_moved = 0;
+    for (unsigned i = 0; i < 65; i++) publish(d, i);
+    CHECK(dsp_test_pcm_allocations == 7);
+    CHECK(d->monitor.ep_pcm_queued == 65536);
+    dsp_test_pcm_copied = dsp_test_pcm_moved = 0;
+    for (unsigned i = 0; i < 65; i++) {
+        check_frame(d, i);
+        mcpx_apu_dsp_pcm_consumed(d);
+    }
+    CHECK(dsp_test_pcm_copied == 65536 && !dsp_test_pcm_moved);
+    printf("PCM queue: ordered wrap/growth/OOM/bursts; 7 growth allocations, "
+           "65536 copied bytes and 0 shifted bytes for a 64-frame drain\n");
+    free(d->monitor.ep_pcm_queue);
+    free(d);
+    return 0;
+}
