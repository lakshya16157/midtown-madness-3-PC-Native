# Keep the two XDK voice-update instruction streams intact while routing only
# their ten known constant 32-bit APU accesses through the same MMIO backend.
function(mm3_apu_mmio_replace body_variable before after expected_count)
    set(body "${${body_variable}}")
    string(LENGTH "${body}" old_length)
    string(LENGTH "${before}" anchor_length)
    string(REPLACE "${before}" "" removed "${body}")
    string(LENGTH "${removed}" new_length)
    math(EXPR occurrences "(${old_length} - ${new_length}) / ${anchor_length}")
    if(NOT occurrences EQUAL expected_count)
        message(FATAL_ERROR "MM3 APU MMIO: expected ${expected_count} occurrences of ${before}, found ${occurrences}")
    endif()
    string(REPLACE "${before}" "${after}" body "${body}")
    set(${body_variable} "${body}" PARENT_SCOPE)
endfunction()

function(mm3_add_apu_mmio source_variable function_name)
    set(content "${${source_variable}}")
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    if(NOT owner_count EQUAL 1 OR owner_start LESS 0)
        message(FATAL_ERROR "MM3 APU MMIO: missing or duplicate ${function_name}")
    endif()
    string(SUBSTRING "${content}" ${owner_start} -1 tail)
    string(FIND "${tail}" "\n}" owner_end)
    if(owner_end LESS 0)
        message(FATAL_ERROR "MM3 APU MMIO: incomplete ${function_name}")
    endif()
    math(EXPR owner_length "${owner_end} + 2")
    string(SUBSTRING "${tail}" 0 ${owner_length} body)
    set(original_body "${body}")
    if(function_name STREQUAL "sub_0027DCDA")
        set(expected_sites 7)
        set(payload_call "RECOMP_ABI_CALL(0x0027CC4Fu, sub_0027CC4F)")
        set(poll_label "loc_0027DD09: ;")
        set(loop_label "loc_0027DD1F: ;")
    elseif(function_name STREQUAL "sub_0027DD72")
        set(expected_sites 3)
        set(payload_call "RECOMP_ABI_CALL(0x0027CE4Cu, sub_0027CE4C)")
        set(poll_label "loc_0027DDC3: ;")
        set(loop_label "loc_0027DDD9: ;")
    else()
        message(FATAL_ERROR "MM3 APU MMIO: unsupported ${function_name}")
    endif()
    string(REGEX MATCHALL "MEM32[(]-[0-9]+[)]" sites "${body}")
    list(LENGTH sites site_count)
    foreach(anchor "${payload_call}" "${poll_label}" "${loop_label}"
                   "RECOMP_ABI_CALL(0x002764D0u, sub_002764D0)"
                   "RECOMP_ABI_CALL(0x00276503u, sub_00276503)"
                   "esp += 4; return; /* ret */")
        string(FIND "${body}" "${anchor}" position)
        if(position LESS 0)
            message(FATAL_ERROR "MM3 APU MMIO: original ${function_name} call/loop/return changed")
        endif()
    endforeach()
    if(NOT site_count EQUAL expected_sites)
        message(FATAL_ERROR "MM3 APU MMIO: ${function_name} expected ${expected_sites} constant sites, found ${site_count}")
    endif()
    mm3_apu_mmio_replace(body "    edx = MEM32(-25034736);"
        "    edx = mm3_apu_mmio_read32(0xFE820010u);" 1)
    mm3_apu_mmio_replace(body "    MEM32(-25033992) = edx;"
        "    mm3_apu_mmio_write32(0xFE8202F8u, edx);" 1)
    if(function_name STREQUAL "sub_0027DCDA")
        mm3_apu_mmio_replace(body "    MEM32(-25033988) = 1;"
            "    mm3_apu_mmio_write32(0xFE8202FCu, 1);" 1)
        mm3_apu_mmio_replace(body "    MEM32(-25033888) = edx;"
            "    mm3_apu_mmio_write32(0xFE820360u, edx);" 1)
        mm3_apu_mmio_replace(body "    MEM32(-25033884) = edx;"
            "    mm3_apu_mmio_write32(0xFE820364u, edx);" 1)
        mm3_apu_mmio_replace(body "    MEM32(-25033880) = edx;"
            "    mm3_apu_mmio_write32(0xFE820368u, edx);" 1)
        mm3_apu_mmio_replace(body "    MEM32(-25033988) = 0;"
            "    mm3_apu_mmio_write32(0xFE8202FCu, 0);" 1)
    else()
        mm3_apu_mmio_replace(body "    MEM32(-25033860) = edx;"
            "    mm3_apu_mmio_write32(0xFE82037Cu, edx);" 1)
    endif()
    string(REPLACE "${original_body}" "${body}" content "${content}")
    string(FIND "${content}" "#include \"mm3_apu_mmio.h\"" declared)
    if(declared LESS 0)
        if(content MATCHES "\r\n")
            set(content "#include \"mm3_apu_mmio.h\"\r\n${content}")
        else()
            set(content "#include \"mm3_apu_mmio.h\"\n${content}")
        endif()
    endif()
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
