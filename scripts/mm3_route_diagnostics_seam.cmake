# Read-only host observations at exact native request publication/lifetime sites.
function(mm3_add_route_diagnostics source_variable function_name)
    set(content "${${source_variable}}")
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    if(NOT owner_count EQUAL 1 OR owner_start LESS 0)
        message(FATAL_ERROR "MM3 route diagnostics: missing or duplicate ${function_name}")
    endif()
    string(SUBSTRING "${content}" ${owner_start} -1 tail)
    string(FIND "${tail}" "\n}" owner_end)
    if(owner_end LESS 0)
        message(FATAL_ERROR "MM3 route diagnostics: incomplete ${function_name}")
    endif()
    math(EXPR owner_length "${owner_end} + 2")
    string(SUBSTRING "${tail}" 0 ${owner_length} body)
    set(blocks)
    set(replacements)
    if(function_name STREQUAL "sub_0024FA01")
        set(block [=[loc_0024FA73: ;
    MEM32(ecx + 0x40) = eax;]=])
        set(insert "    mm3_route_enqueue(edi, ecx, eax, MEM32(ebp + 0x14), ebp);")
    elseif(function_name STREQUAL "sub_0013AB27")
        set(block [=[    esi = ecx;
    ecx = MEM32(edi + 0x30);]=])
        set(insert "    mm3_route_consume(edi, esi, esp);")
    elseif(function_name STREQUAL "sub_0024F917")
        set(block [=[loc_0024F950: ;
    PUSH32(esp, edi);]=])
        set(insert "    mm3_route_lifetime(1, MEM32(ebp + 8), edi, MEM32(ebp + 0xC), ebp, 0, 0);")
    elseif(function_name STREQUAL "sub_0024F964")
        set(block [=[loc_0024F9AC: ;
    eax = MEM32(edi + 0x10);]=])
        set(insert "    mm3_route_lifetime(2, ebx, MEM32(ebp + -4), MEM32(ebp + 0xC), ebp, MEM32(ebp + -16), MEM32(ebp + -12));")
    else()
        message(FATAL_ERROR "MM3 route diagnostics: unsupported ${function_name}")
    endif()
    # Include the line ending so altered trailing text cannot satisfy an anchor.
    set(block "${block}\n")
    # Inject between the two checked lines, except publication follows its store.
    if(function_name STREQUAL "sub_0024FA01")
        set(fixed "${block}${insert}\n")
    else()
        string(FIND "${block}" "\n" split)
        math(EXPR after_split "${split} + 1")
        string(SUBSTRING "${block}" 0 ${split} first)
        string(SUBSTRING "${block}" ${after_split} -1 second)
        set(fixed "${first}\n${insert}\n${second}")
    endif()
    if(content MATCHES "\r\n")
        string(REPLACE "\n" "\r\n" block "${block}")
        string(REPLACE "\n" "\r\n" fixed "${fixed}")
    endif()
    string(FIND "${body}" "${block}" anchor)
    string(FIND "${body}" "mm3_route_" already)
    if(anchor LESS 0 OR NOT already LESS 0)
        message(FATAL_ERROR "MM3 route diagnostics: original ${function_name} anchor changed")
    endif()
    string(REPLACE "${block}" "${fixed}" transformed "${body}")
    if(function_name STREQUAL "sub_0024F964")
        set(block [=[loc_0024F9E9: ;
    PUSH32(esp, MEM32(ebp + -4));]=])
        set(fixed [=[loc_0024F9E9: ;
    mm3_route_lifetime(3, ebx, MEM32(ebp + -4), MEM32(ebp + 0xC), ebp, 0, 0);
    PUSH32(esp, MEM32(ebp + -4));]=])
        set(block "${block}\n")
        set(fixed "${fixed}\n")
        if(content MATCHES "\r\n")
            string(REPLACE "\n" "\r\n" block "${block}")
            string(REPLACE "\n" "\r\n" fixed "${fixed}")
        endif()
        string(FIND "${transformed}" "${block}" erase_anchor)
        if(erase_anchor LESS 0)
            message(FATAL_ERROR "MM3 route diagnostics: cancel erase anchor changed")
        endif()
        string(REPLACE "${block}" "${fixed}" transformed "${transformed}")
    endif()
    string(REPLACE "${body}" "${transformed}" content "${content}")
    string(FIND "${content}" "#include \"mm3_route_diagnostics.h\"" declared)
    if(declared LESS 0)
        if(content MATCHES "\r\n")
            set(content "#include \"mm3_route_diagnostics.h\"\r\n${content}")
        else()
            set(content "#include \"mm3_route_diagnostics.h\"\n${content}")
        endif()
    endif()
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
