# Apply speed zoom to the map's common world scale and checkpoint dimensions.
# Keep its base square fixed, rotate finalized city UVs instead, replace the
# circle border, and measure marker hide/clamp against the visible rectangle.
function(mm3_add_map_zoom source_variable function_name)
    set(content "${${source_variable}}")
    if(function_name STREQUAL "sub_00116535")
        string(REGEX MATCHALL "void sub_00116535[(]void[)]" owners "${content}")
        list(LENGTH owners owner_count)
        if(NOT owner_count EQUAL 1)
            message(FATAL_ERROR "MM3 map zoom: missing or duplicate city UV owner")
        endif()
        string(FIND "${content}" "void sub_00116535(void)" owner_start)
        string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
        string(FIND "${owner_tail}" "\nvoid " owner_end)
        if(owner_end LESS 0)
            set(body "${owner_tail}")
        else()
            string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
        endif()
        string(FIND "${body}" "mm3_map_square_begin(" already)
        if(NOT already LESS 0)
            message(FATAL_ERROR "MM3 map zoom: city UV owner already patched")
        endif()
        set(transformed "${body}")
        string(FIND "${content}" "\r\n" crlf)
        set(newline "\n")
        if(NOT crlf LESS 0)
            set(newline "\r\n")
        endif()
        set(original "    PUSH32(esp, ebp);${newline}    ebp = esp + -116;")
        set(replacement "    PUSH32(esp, ebp);${newline}    uint32_t mm3_square_map = mm3_map_square_begin(ecx, MEM32(esp + 8));${newline}    ebp = esp + -116;")
        string(FIND "${transformed}" "${original}" position)
        if(position LESS 0)
            message(FATAL_ERROR "MM3 map zoom: original city UV owner boundary changed")
        endif()
        string(LENGTH "${original}" length)
        math(EXPR after "${position} + ${length}")
        string(SUBSTRING "${transformed}" ${after} -1 tail)
        string(FIND "${tail}" "${original}" duplicate)
        if(NOT duplicate LESS 0)
            message(FATAL_ERROR "MM3 map zoom: duplicate city UV owner boundary")
        endif()
        string(REPLACE "${original}" "${replacement}" transformed "${transformed}")
        set(original "loc_00116580: ;${newline}    eax = MEM32(0x3C568C);")
        set(replacement "loc_00116580: ;${newline}    if (mm3_square_map) mm3_map_square_publish_window(MEMF(ebp + 0x4C), MEMF(ebp + 0x48));${newline}    eax = MEM32(0x3C568C);")
        string(FIND "${transformed}" "${original}" position)
        if(position LESS 0)
            message(FATAL_ERROR "MM3 map zoom: original city viewport boundary changed")
        endif()
        string(LENGTH "${original}" length)
        math(EXPR after "${position} + ${length}")
        string(SUBSTRING "${transformed}" ${after} -1 tail)
        string(FIND "${tail}" "${original}" duplicate)
        if(NOT duplicate LESS 0)
            message(FATAL_ERROR "MM3 map zoom: duplicate city viewport boundary")
        endif()
        string(REPLACE "${original}" "${replacement}" transformed "${transformed}")
        foreach(site 001169A2 00116A7F 00116B4A 00116BDE 00116C78 00116D0E 00116D9D 00116E2F 00116EBE)
            set(original "    PUSH32(esp, 0x${site}u); RECOMP_ABI_CALL(0x00069807u, sub_00069807); /* call 0x00069807 */")
            string(FIND "${transformed}" "${original}" position)
            if(position LESS 0)
                message(FATAL_ERROR "MM3 map zoom: original city UV vertex boundary ${site} changed")
            endif()
            string(LENGTH "${original}" length)
            math(EXPR after "${position} + ${length}")
            string(SUBSTRING "${transformed}" ${after} -1 tail)
            string(FIND "${tail}" "${original}" duplicate)
            if(NOT duplicate LESS 0)
                message(FATAL_ERROR "MM3 map zoom: duplicate city UV vertex boundary ${site}")
            endif()
            set(replacement "    if (mm3_square_map) mm3_map_square_city_uv(ebx, esp);${newline}${original}${newline}    if (mm3_square_map) mm3_map_square_tag_packed(esi);")
            string(REPLACE "${original}" "${replacement}" transformed "${transformed}")
        endforeach()
        string(REPLACE "${body}" "${transformed}" content "${content}")
        set(declarations "#include <stdint.h>${newline}extern uint32_t mm3_map_square_begin(uint32_t, uint32_t);${newline}extern void mm3_map_square_publish_window(float, float);${newline}extern void mm3_map_square_city_uv(uint32_t, uint32_t);${newline}extern void mm3_map_square_tag_packed(uint32_t);${newline}")
        set(${source_variable} "${declarations}${content}" PARENT_SCOPE)
        return()
    endif()
    set(reset_original [=[loc_0011CA25: ;
    PUSH32(esp, ebp);]=])
    set(reset_replacement [=[loc_0011CA25: ;
    mm3_map_zoom_reset(ecx);
    PUSH32(esp, ebp);]=])
    set(pool_original [=[loc_0011DCBF: ;
    MEM32(0x3C568C) = MEM32(0x3C568C) & 0;]=])
    set(pool_replacement [=[loc_0011DCBF: ;
    mm3_map_ui_capacity();
    MEM32(0x3C568C) = MEM32(0x3C568C) & 0;]=])
    set(update_original [=[loc_0011D1E8: ;
    PUSH32(esp, ebp);]=])
    set(update_replacement [=[loc_0011D1E8: ;
    mm3_map_zoom_update(ecx, MEMF(esp + 0x10));
    PUSH32(esp, ebp);]=])
    set(apply_original [=[loc_0011D8F6: ;
    PUSH32(esp, edi);]=])
    set(apply_replacement [=[loc_0011D8F6: ;
    mm3_map_zoom_apply(ebx, MEM32(ebp + -4));
    PUSH32(esp, edi);]=])
    set(checkpoint_original [=[loc_0011CC53: ;
    { double _t = fp_top(); fp_push(_t); } /* fld st(0) */]=])
    set(checkpoint_replacement [=[loc_0011CC53: ;
    fp_top() = RECOMP_FP_PC(fp_top() * mm3_map_zoom_checkpoint_scale(ebx, MEM32(ebp + 0x40)));
    { double _t = fp_top(); fp_push(_t); } /* fld st(0) */]=])
    set(square_original [=[    PUSH32(esp, 0x0011DB57u); RECOMP_ABI_CALL(0x000C6ADCu, sub_000C6ADC); /* call 0x000C6ADC */]=])
    set(square_replacement [=[    if (mm3_minimap_improved()) {
        mm3_map_square_geometry(eax, ecx, MEMF(esp));
        mm3_map_zoom_window(ebx, MEM32(eax));
        esp += 4; /* Inverse city-UV rotation consumes the native angle argument. */
    } else {
        PUSH32(esp, 0x0011DB57u); RECOMP_ABI_CALL(0x000C6ADCu, sub_000C6ADC); /* call 0x000C6ADC */
    }]=])
    set(border_original [=[    PUSH32(esp, 0x0011DBB1u); RECOMP_ABI_CALL(0x001C1585u, sub_001C1585); /* call 0x001C1585 */]=])
    set(border_replacement [=[    if (mm3_minimap_improved()) {
        esp += 8; /* Improved map has no MapCircle border. */
    } else {
        PUSH32(esp, 0x0011DBB1u); RECOMP_ABI_CALL(0x001C1585u, sub_001C1585); /* call 0x001C1585 */
    }]=])
    set(compass_original [=[loc_0011DBF1: ;
    fp_push(MEMF(ebx + 0x4C)); /* fld float */]=])
    set(compass_replacement [=[loc_0011DBF1: ;
    mm3_map_zoom_compass_geometry(ebx, ebp + -740);
    fp_push(MEMF(ebx + 0x4C)); /* fld float */]=])
    set(marker_original [=[    fp_st1() = RECOMP_FP_PC(fp_st1() + fp_top()); fp_pop(); /* faddp st(1) */
    fp_top() = RECOMP_FP_PC(sqrt(fp_top())); /* fsqrt */
    fp_st1() = fp_top(); fp_pop(); /* fstp st(1) */
    fp_push(MEMF(eax + 8)); /* fld float */]=])
    set(marker_replacement [=[    fp_st1() = RECOMP_FP_PC(fp_st1() + fp_top()); fp_pop(); /* faddp st(1) */
    fp_top() = RECOMP_FP_PC(mm3_map_square_marker_distance(ebx, eax, MEMF(ebp + 0x4C), MEMF(ebp + 0x3C)));
    fp_st1() = fp_top(); fp_pop(); /* fstp st(1) */
    fp_push(MEMF(eax + 8)); /* fld float */]=])
    string(FIND "${content}" "\r\n" crlf_position)
    if(crlf_position LESS 0)
        set(newline "\n")
    else()
        set(newline "\r\n")
        foreach(block reset pool update apply checkpoint square border compass marker)
            string(REPLACE "\n" "\r\n" ${block}_original "${${block}_original}")
            string(REPLACE "\n" "\r\n" ${block}_replacement "${${block}_replacement}")
        endforeach()
    endif()
    if(function_name STREQUAL "sub_0011CA25")
        set(block reset)
    elseif(function_name STREQUAL "sub_0011D1E8")
        set(block update)
    elseif(function_name STREQUAL "sub_0011D808")
        set(block apply)
    elseif(function_name STREQUAL "sub_0011CAE8")
        set(block checkpoint)
    elseif(function_name STREQUAL "sub_0011DCBF")
        set(block pool)
    else()
        message(FATAL_ERROR "MM3 map zoom: unsupported owner ${function_name}")
    endif()
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    if(NOT owner_count EQUAL 1 OR owner_start LESS 0)
        message(FATAL_ERROR "MM3 map zoom: missing or duplicate ${function_name}")
    endif()
    string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
    string(FIND "${owner_tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${owner_tail}")
    else()
        string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
    endif()
    string(FIND "${body}" "${${block}_original}" position)
    if(position LESS 0)
        message(FATAL_ERROR "MM3 map zoom: original ${block} boundary changed")
    endif()
    string(LENGTH "${${block}_original}" length)
    math(EXPR after "${position} + ${length}")
    string(SUBSTRING "${body}" ${after} -1 tail)
    string(FIND "${tail}" "${${block}_original}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "MM3 map zoom: duplicate ${block} boundary")
    endif()
    string(REPLACE "${${block}_original}" "${${block}_replacement}" transformed "${body}")
    if(function_name STREQUAL "sub_0011D808")
        set(square_blocks square border compass)
    elseif(function_name STREQUAL "sub_0011CAE8")
        set(square_blocks marker)
    else()
        set(square_blocks "")
    endif()
    if(square_blocks)
        foreach(square_block IN LISTS square_blocks)
            string(FIND "${transformed}" "${${square_block}_original}" square_position)
            if(square_position LESS 0)
                message(FATAL_ERROR "MM3 map zoom: original ${square_block} boundary changed")
            endif()
            string(LENGTH "${${square_block}_original}" square_length)
            math(EXPR square_after "${square_position} + ${square_length}")
            string(SUBSTRING "${transformed}" ${square_after} -1 square_tail)
            string(FIND "${square_tail}" "${${square_block}_original}" square_duplicate)
            if(NOT square_duplicate LESS 0)
                message(FATAL_ERROR "MM3 map zoom: duplicate ${square_block} boundary")
            endif()
            string(REPLACE "${${square_block}_original}" "${${square_block}_replacement}" transformed "${transformed}")
        endforeach()
    endif()
    string(REPLACE "${body}" "${transformed}" content "${content}")
    set(declarations "#include <stdint.h>${newline}extern int mm3_minimap_improved(void);${newline}extern void mm3_map_zoom_reset(uint32_t);${newline}extern void mm3_map_square_geometry(uint32_t, uint32_t, float);${newline}extern float mm3_map_square_marker_distance(uint32_t, uint32_t, float, float);${newline}extern void mm3_map_zoom_update(uint32_t, float);${newline}extern void mm3_map_zoom_apply(uint32_t, uint32_t);${newline}extern void mm3_map_zoom_window(uint32_t, uint32_t);${newline}extern float mm3_map_zoom_checkpoint_scale(uint32_t, uint32_t);${newline}")
    string(APPEND declarations "extern void mm3_map_zoom_compass_geometry(uint32_t, uint32_t);${newline}")
    string(APPEND declarations "extern void mm3_map_ui_capacity(void);${newline}")
    string(FIND "${content}" "extern void mm3_map_zoom_reset(" declared)
    if(declared LESS 0)
        set(content "${declarations}${content}")
    endif()
    set(${source_variable} "${content}" PARENT_SCOPE)
endfunction()
