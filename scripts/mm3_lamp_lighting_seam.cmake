# Keep native time/breakage/flicker gates and the packed source descriptor.
# Range/cone reads in both bounds and submission must use identical tuning.
function(mm3_add_lamp_lighting_seam source_variable function_name)
    set(content "${${source_variable}}")
    if(function_name MATCHES "^sub_000E10A5(_original)?$")
        set(source_register esi)
        set(range_count 3)
    elseif(function_name MATCHES "^sub_000E1F49(_original)?$")
        set(source_register ebx)
        set(range_count 4)
    elseif(function_name MATCHES "^sub_000E2385(_original)?$")
        set(source_register ebx)
        set(range_count 3)
    elseif(function_name MATCHES "^sub_000E247C(_original)?$")
        set(source_register ebx)
        set(range_count 2)
    else()
        message(FATAL_ERROR "MM3 source lights: unsupported owner ${function_name}")
    endif()
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    if(NOT owner_count EQUAL 1)
        message(FATAL_ERROR "MM3 source lights: missing/duplicate ${function_name}")
    endif()
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
    string(FIND "${owner_tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${owner_tail}")
    else()
        string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
    endif()
    set(range_read "fp_push(MEMF(${source_register} + 0x4F)); /* fld float */")
    string(REGEX MATCHALL "fp_push[(]MEMF[(]${source_register} \\+ 0x4F[)][)]" reads "${body}")
    list(LENGTH reads actual_range_count)
    string(REGEX MATCHALL "fp_top[(][)] = RECOMP_FP_PC[(]fp_top[(][)] \\* MEMF[(]0x386180[)][)]" cones "${body}")
    list(LENGTH cones cone_count)
    if(NOT actual_range_count EQUAL range_count OR NOT cone_count EQUAL 1)
        message(FATAL_ERROR "MM3 source lights: ${function_name} range/cone boundaries changed (${actual_range_count}/${range_count} ranges, ${cone_count}/1 cones)")
    endif()
    string(REPLACE "${range_read}" "fp_push(mm3_lamp_source_range(${source_register})); /* source-specific reach */" transformed "${body}")
    string(REPLACE "fp_top() = RECOMP_FP_PC(fp_top() * MEMF(0x386180)); /* fmul dword ptr [0x386180] */"
        "fp_top() = mm3_lamp_source_cone(${source_register}); /* wider authored cone */" transformed "${transformed}")
    string(REPLACE "${body}" "${transformed}" content "${content}")
    set(declaration "#include <stdint.h>\nextern float mm3_lamp_source_range(uint32_t);\nextern float mm3_lamp_source_cone(uint32_t);\n")
    set(${source_variable} "${declaration}${content}" PARENT_SCOPE)
endfunction()
