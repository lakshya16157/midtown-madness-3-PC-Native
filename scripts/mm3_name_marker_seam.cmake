# Mark each native opponent-marker entry only after its visibility flags have
# been selected. The definition is renamed before this transform in CMake.
function(mm3_add_name_marker_seam source_variable function_name)
    set(content "${${source_variable}}")
    if(NOT function_name MATCHES "^sub_001093BB(_original)?$")
        message(FATAL_ERROR "MM3 name markers: unsupported owner ${function_name}")
    endif()
    string(REGEX MATCHALL "void ${function_name}[(]void[)]" owners "${content}")
    list(LENGTH owners owner_count)
    if(NOT owner_count EQUAL 1)
        message(FATAL_ERROR "MM3 name markers: missing or duplicate ${function_name}")
    endif()
    string(FIND "${content}" "void ${function_name}(void)" owner_start)
    string(SUBSTRING "${content}" ${owner_start} -1 owner_tail)
    string(FIND "${owner_tail}" "\nvoid " owner_end)
    if(owner_end LESS 0)
        set(body "${owner_tail}")
    else()
        string(SUBSTRING "${owner_tail}" 0 ${owner_end} body)
    endif()
    set(original [=[loc_001093FF: ;
    _fa = (uint32_t)(MEM8(eax + 0x20))]=])
    set(replacement [=[loc_001093FF: ;
    mm3_name_marker_projected(MEM8(eax + 0x21));
    _fa = (uint32_t)(MEM8(eax + 0x20))]=])
    string(FIND "${content}" "\r\n" crlf)
    if(NOT crlf LESS 0)
        string(REPLACE "\n" "\r\n" original "${original}")
        string(REPLACE "\n" "\r\n" replacement "${replacement}")
    endif()
    string(FIND "${body}" "mm3_name_marker_projected(" already)
    string(FIND "${body}" "${original}" position)
    if(position LESS 0 OR NOT already LESS 0)
        message(FATAL_ERROR "MM3 name markers: entry boundary changed or already patched")
    endif()
    string(REGEX MATCHALL "loc_001093FF:" anchors "${body}")
    list(LENGTH anchors anchor_count)
    if(NOT anchor_count EQUAL 1)
        message(FATAL_ERROR "MM3 name markers: duplicate entry boundary")
    endif()
    string(REPLACE "${original}" "${replacement}" transformed "${body}")
    string(REPLACE "${body}" "${transformed}" content "${content}")
    set(declaration "#include <stdint.h>\nextern void mm3_name_marker_projected(uint32_t);\n")
    if(NOT crlf LESS 0)
        string(REPLACE "\n" "\r\n" declaration "${declaration}")
    endif()
    set(${source_variable} "${declaration}${content}" PARENT_SCOPE)
endfunction()
