// Resource 1 is also used by the runtime's framebuffer window class.
1 ICON "mm3.ico"

#include <windows.h>
#include "mm3_display_settings_ids.h"

IDD_DISPLAY_SETTINGS DIALOGEX 0, 0, 368, 397
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Display changes apply when you choose Apply or OK.", -1, 14, 12, 340, 13
    GROUPBOX "Display", -1, 10, 30, 348, 155
    LTEXT "Window resolution", -1, 22, 48, 103, 12
    COMBOBOX IDC_DISPLAY_RESOLUTION, 138, 45, 204, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Window mode", -1, 22, 72, 103, 12
    COMBOBOX IDC_DISPLAY_MODE, 138, 69, 204, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Fullscreen uses the monitor's resolution.", -1, 138, 87, 204, 12
    LTEXT "Maximum FPS (1-60)", -1, 22, 108, 103, 12
    COMBOBOX IDC_DISPLAY_FPS, 138, 105, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "VSync", IDC_DISPLAY_VSYNC, 223, 106, 118, 14, WS_TABSTOP
    LTEXT "Render quality", -1, 22, 134, 103, 12
    COMBOBOX IDC_DISPLAY_SCALE, 138, 131, 204, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show FPS in window title", IDC_DISPLAY_SHOW_FPS, 22, 159, 230, 14, WS_TABSTOP
    GROUPBOX "Graphics (restart required when changed)", -1, 10, 192, 348, 79
    LTEXT "Aspect ratio", -1, 22, 211, 76, 12
    COMBOBOX IDC_DISPLAY_ASPECT, 101, 208, 70, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Anti-aliasing", -1, 185, 211, 76, 12
    COMBOBOX IDC_DISPLAY_MSAA, 263, 208, 79, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Texture filtering", -1, 22, 239, 76, 12
    COMBOBOX IDC_DISPLAY_ANISO, 101, 236, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Draw distance", -1, 185, 239, 76, 12
    COMBOBOX IDC_DISPLAY_DISTANCE, 263, 236, 79, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "HUD (no restart required)", -1, 10, 278, 348, 48
    LTEXT "Minimap style", -1, 22, 299, 103, 12
    COMBOBOX IDC_DISPLAY_MINIMAP, 138, 296, 204, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_DISPLAY_STATUS, 14, 335, 338, 30
    PUSHBUTTON "Restore defaults", IDC_DISPLAY_DEFAULTS, 14, 372, 88, 16
    PUSHBUTTON "Apply", IDC_DISPLAY_APPLY, 178, 372, 54, 16
    DEFPUSHBUTTON "OK", IDOK, 238, 372, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 298, 372, 54, 16
END
