// Resource 1 is also used by the runtime's framebuffer window class.
1 ICON "mm3.ico"

#include <windows.h>
#include "mm3_display_settings_ids.h"

IDD_DISPLAY_SETTINGS DIALOGEX 0, 0, 368, 469
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Display changes apply when you choose Apply or OK.", -1, 14, 12, 340, 13
    AUTOCHECKBOX "Freeze opponents (works at once, until you untick it or quit the game)", IDC_DISPLAY_FREEZE_AI, 14, 30, 340, 14, WS_TABSTOP
    GROUPBOX "Display", -1, 10, 50, 348, 155
    LTEXT "Window resolution", -1, 22, 68, 103, 12
    COMBOBOX IDC_DISPLAY_RESOLUTION, 138, 65, 204, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Window mode", -1, 22, 92, 103, 12
    COMBOBOX IDC_DISPLAY_MODE, 138, 89, 204, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Fullscreen uses the monitor's resolution.", -1, 138, 107, 204, 12
    LTEXT "Maximum FPS (1-120)", -1, 22, 128, 103, 12
    COMBOBOX IDC_DISPLAY_FPS, 138, 125, 70, 100, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "VSync", IDC_DISPLAY_VSYNC, 223, 126, 118, 14, WS_TABSTOP
    LTEXT "Render quality", -1, 22, 154, 103, 12
    COMBOBOX IDC_DISPLAY_SCALE, 138, 151, 204, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show FPS in window title", IDC_DISPLAY_SHOW_FPS, 22, 179, 230, 14, WS_TABSTOP
    GROUPBOX "Graphics (restart required when changed)", -1, 10, 212, 348, 107
    LTEXT "Aspect ratio", -1, 22, 231, 76, 12
    COMBOBOX IDC_DISPLAY_ASPECT, 101, 228, 70, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Anti-aliasing", -1, 185, 231, 76, 12
    COMBOBOX IDC_DISPLAY_MSAA, 263, 228, 79, 95, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Texture filtering", -1, 22, 259, 76, 12
    COMBOBOX IDC_DISPLAY_ANISO, 101, 256, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Object detail", -1, 185, 259, 76, 12
    COMBOBOX IDC_DISPLAY_DISTANCE, 263, 256, 79, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Building view", -1, 22, 287, 76, 12
    COMBOBOX IDC_DISPLAY_VIEW_DISTANCE, 101, 284, 70, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "HUD and lighting (no restart required)", -1, 10, 326, 348, 72
    LTEXT "Minimap style", -1, 22, 347, 103, 12
    COMBOBOX IDC_DISPLAY_MINIMAP, 138, 344, 204, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Night brightness", -1, 22, 371, 103, 12
    COMBOBOX IDC_DISPLAY_NIGHT_LIGHT, 138, 368, 204, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_DISPLAY_STATUS, 14, 407, 338, 30
    PUSHBUTTON "Restore defaults", IDC_DISPLAY_DEFAULTS, 14, 444, 88, 16
    PUSHBUTTON "Apply", IDC_DISPLAY_APPLY, 178, 444, 54, 16
    DEFPUSHBUTTON "OK", IDOK, 238, 444, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 298, 444, 54, 16
END
